1095:     ∀ (θ : Nat → Option Tm) (d : Nat) (Δ' : MEnv),
1096:       (∀ v, v < d → Δ' v = Δ v) →
1097:       (∀ n, θ n = none → Δ' (n + d) = Δ (n + d)) →
1098:       (∀ n M Ψ A, θ n = some M → Δ (n + d) = some (Ψ, A) → HasTy MEnv.nil Ψ M A) →

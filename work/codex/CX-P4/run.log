446: /-- Renaming variables leaves the refs alone. -/
447: theorem usesRef_renameVar (n : Nat) : ∀ (t : Term) (ρ : Nat → Nat),
448:     Term.usesRef n (Term.renameVar ρ t) = Term.usesRef n t
449:   | .var _, _ | .nat _, _ | .bool _, _ | .bytes _, _ | .digest _, _ | .ref _, _
450:   | .refuse _ _, _ => rfl
451:   | .lam _ b, ρ => by simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n b]
452:   | .app f a, ρ => by simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n f, usesRef_renameVar n a]
453:   | .fix t, ρ => by simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n t]
454:   | .prim _ a b, ρ => by simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n a, usesRef_renameVar n b]
455:   | .record fs, ρ => by simp only [Term.renameVar, Term.usesRef, usesRefRow_renameVarRow n fs]
456:   | .get t _, ρ => by simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n t]
457:   | .extend t fs, ρ => by
458:     simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n t, usesRefRow_renameVarRow n fs]
459:   | .inj _ _ t, ρ => by simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n t]
460:   | .case t as, ρ => by
461:     simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n t, usesRefRow_renameVarArms n as]
462:   | .ite c a b, ρ => by
463:     simp only [Term.renameVar, Term.usesRef, usesRef_renameVar n c, usesRef_renameVar n a,
464:       usesRef_renameVar n b]
465: theorem usesRefRow_renameVarRow (n : Nat) : ∀ (fs : List (Label × Term)) (ρ : Nat → Nat),
466:     Term.usesRefRow n (Term.renameVarRow ρ fs) = Term.usesRefRow n fs
467:   | [], _ => rfl
468:   | (_, t) :: fs, ρ => by
469:     simp only [Term.renameVarRow, Term.usesRefRow, usesRef_renameVar n t, usesRefRow_renameVarRow n fs]
470: theorem usesRefRow_renameVarArms (n : Nat) : ∀ (as : List (Label × Term)) (ρ : Nat → Nat),
471:     Term.usesRefRow n (Term.renameVarArms ρ as) = Term.usesRefRow n as
472:   | [], _ => rfl
473:   | (_, t) :: as, ρ => by
474:     simp only [Term.renameVarArms, Term.usesRefRow, usesRef_renameVar n t, usesRefRow_renameVarArms n as]
475: end

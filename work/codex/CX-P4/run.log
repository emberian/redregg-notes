181: /-- Metavariable renaming distributes over ordinary substitution. -/
182: theorem mren_substFn (ρ : Nat → Nat) (f : Nat → Tm) :
183:     ∀ t : Tm, mren ρ (substFn f t) = substFn (fun i => mren ρ (f i)) (mren ρ t)
184:   | .var _ => rfl
185:   | .lam A t => by
186:     have h : (fun i => mren ρ (upS f i)) = upS (fun i => mren ρ (f i)) := by
198: theorem mrenL_substFnL (ρ : Nat → Nat) (f : Nat → Tm) :
199:     ∀ σ : List Tm, mrenL ρ (substFnL f σ) = substFnL (fun i => mren ρ (f i)) (mrenL ρ σ)
200:   | [] => rfl
201:   | t :: σ => by simp only [mrenL, substFnL, mren_substFn ρ f t, mrenL_substFnL ρ f σ]
202: end

28: /-! ## List forms -/
30: theorem renameL_eq (ρ : Nat → Nat) : ∀ σ : List Tm, renameL ρ σ = σ.map (rename ρ)
31:   | [] => rfl
32:   | t :: σ => by simp only [renameL, renameL_eq ρ σ, List.map_cons]
33: 
34: theorem mrenL_eq (ρ : Nat → Nat) : ∀ σ : List Tm, mrenL ρ σ = σ.map (mren ρ)
35:   | [] => rfl
36:   | t :: σ => by simp only [mrenL, mrenL_eq ρ σ, List.map_cons]
37: 
38: theorem substFnL_eq (f : Nat → Tm) : ∀ σ : List Tm, substFnL f σ = σ.map (substFn f)
39:   | [] => rfl
40:   | t :: σ => by simp only [substFnL, substFnL_eq f σ, List.map_cons]
41: 
42: theorem msubstL_eq (s : Tm) (u : Nat) : ∀ σ : List Tm, msubstL s u σ = σ.map (msubst s u)
43:   | [] => rfl
44:   | t :: σ => by simp only [msubstL, msubstL_eq s u σ, List.map_cons]
45: 
46: theorem usesL_of_getElem? (k : Nat) :
47:     ∀ (σ : List Tm) (i : Nat) (s : Tm), σ[i]? = some s → uses k s = true → usesL k σ = true
48:   | [], _, _, h, _ => by simp at h
49:   | t :: σ, 0, s, h, hu => by
50:     simp only [List.getElem?_cons_zero, Option.some.injEq] at h
51:     subst h; simp [usesL, hu]
52:   | t :: σ, i + 1, s, h, hu => by
53:     simp only [List.getElem?_cons_succ] at h
54:     simp [usesL, usesL_of_getElem? k σ i s h hu]
55: 
56: theorem usesL_true (k : Nat) :
57:     ∀ σ : List Tm, usesL k σ = true → ∃ (i : Nat) (s : Tm), σ[i]? = some s ∧ uses k s = true
58:   | [], h => by simp [usesL] at h
59:   | t :: σ, h => by
60:     simp only [usesL, Bool.or_eq_true] at h
61:     rcases h with h | h
62:     · exact ⟨0, t, rfl, h⟩
63:     · obtain ⟨i, s, hi, hs⟩ := usesL_true k σ h
66: /-! ## Renamings compose -/
68: theorem upR_upR (ρ ρ' : Nat → Nat) :
69:     (fun i => upR ρ (upR ρ' i)) = upR (fun i => ρ (ρ' i)) := by
72: theorem upR_id : upR (fun i => i) = (fun i => i) := by
76: theorem rename_rename (ρ ρ' : Nat → Nat) :
77:     ∀ t : Tm, rename ρ (rename ρ' t) = rename (fun i => ρ (ρ' i)) t
78:   | .var _ => rfl
79:   | .lam A t => by simp only [rename, rename_rename (upR ρ) (upR ρ') t, upR_upR]
80:   | .app t s => by simp only [rename, rename_rename ρ ρ' t, rename_rename ρ ρ' s]
81:   | .box _ _ => rfl
82:   | .letbox t s => by simp only [rename, rename_rename ρ ρ' t, rename_rename ρ ρ' s]
83:   | .mvar u σ => by simp only [rename, renameL_renameL ρ ρ' σ]
84: theorem renameL_renameL (ρ ρ' : Nat → Nat) :
85:     ∀ σ : List Tm, renameL ρ (renameL ρ' σ) = renameL (fun i => ρ (ρ' i)) σ
86:   | [] => rfl
87:   | t :: σ => by simp only [renameL, rename_rename ρ ρ' t, renameL_renameL ρ ρ' σ]
88: end

477: /-- Where a ref surviving `fillRefs σ` comes from: an unfilled ref of the term, or a ref of the
478: filling of one of its refs. -/
479: def FillOrigin (σ : Nat → Option Term) (n : Nat) (u : Nat → Bool) : Prop :=
482: theorem FillOrigin.mono {σ : Nat → Option Term} {n : Nat} {u u' : Nat → Bool}
483:     (hu : RefsSub u u') : FillOrigin σ n u → FillOrigin σ n u'
484:   | .inl ⟨h1, h2⟩ => .inl ⟨hu n h1, h2⟩
485:   | .inr ⟨m, M, h1, h2, h3⟩ => .inr ⟨m, M, hu m h1, h2, h3⟩
486: 
487: mutual
488: theorem usesRef_fillRefs (σ : Nat → Option Term) (n : Nat) : ∀ t : Term,
489:     Term.usesRef n (Term.fillRefs σ t) = true → FillOrigin σ n (fun m => Term.usesRef m t)
490:   | .ref i, h => by
491:     cases hs : σ i with
492:     | none =>
493:       simp only [Term.fillRefs, hs, Option.getD_none, Term.usesRef, beq_iff_eq] at h
494:       subst h; exact .inl ⟨by simp [Term.usesRef], hs⟩
495:     | some M =>
496:       simp only [Term.fillRefs, hs, Option.getD_some] at h
497:       exact .inr ⟨i, M, by simp [Term.usesRef], hs, h⟩
498:   | .var _, h | .nat _, h | .bool _, h | .bytes _, h | .digest _, h | .refuse _ _, h => by
499:     simp [Term.fillRefs, Term.usesRef] at h
500:   | .lam _ b, h => (usesRef_fillRefs σ n b (by simpa [Term.fillRefs, Term.usesRef] using h)).mono
501:       fun m hm => by simp [Term.usesRef, hm]
502:   | .fix b, h => (usesRef_fillRefs σ n b (by simpa [Term.fillRefs, Term.usesRef] using h)).mono
503:       fun m hm => by simp [Term.usesRef, hm]
504:   | .get b _, h => (usesRef_fillRefs σ n b (by simpa [Term.fillRefs, Term.usesRef] using h)).mono
505:       fun m hm => by simp [Term.usesRef, hm]
506:   | .inj _ _ b, h => (usesRef_fillRefs σ n b (by simpa [Term.fillRefs, Term.usesRef] using h)).mono
507:       fun m hm => by simp [Term.usesRef, hm]
508:   | .app f a, h => by
509:     simp only [Term.fillRefs, Term.usesRef, Bool.or_eq_true] at h
510:     rcases h with h | h
511:     · exact (usesRef_fillRefs σ n f h).mono fun m hm => by simp [Term.usesRef, hm]
512:     · exact (usesRef_fillRefs σ n a h).mono fun m hm => by simp [Term.usesRef, hm]
513:   | .prim _ a b, h => by
514:     simp only [Term.fillRefs, Term.usesRef, Bool.or_eq_true] at h
515:     rcases h with h | h
516:     · exact (usesRef_fillRefs σ n a h).mono fun m hm => by simp [Term.usesRef, hm]
517:     · exact (usesRef_fillRefs σ n b h).mono fun m hm => by simp [Term.usesRef, hm]
518:   | .record fs, h => (usesRefRow_fillRefsRow σ n fs (by simpa [Term.fillRefs, Term.usesRef] using h)).mono
519:       fun m hm => by simp [Term.usesRef, hm]
520:   | .extend t fs, h => by
521:     simp only [Term.fillRefs, Term.usesRef, Bool.or_eq_true] at h
522:     rcases h with h | h
523:     · exact (usesRef_fillRefs σ n t h).mono fun m hm => by simp [Term.usesRef, hm]
524:     · exact (usesRefRow_fillRefsRow σ n fs h).mono fun m hm => by simp [Term.usesRef, hm]
525:   | .case t fs, h => by
526:     simp only [Term.fillRefs, Term.usesRef, Bool.or_eq_true] at h
527:     rcases h with h | h
528:     · exact (usesRef_fillRefs σ n t h).mono fun m hm => by simp [Term.usesRef, hm]
529:     · exact (usesRefRow_fillRefsRow σ n fs h).mono fun m hm => by simp [Term.usesRef, hm]
530:   | .ite c a b, h => by
531:     simp only [Term.fillRefs, Term.usesRef, Bool.or_eq_true] at h
532:     rcases h with (h | h) | h
533:     · exact (usesRef_fillRefs σ n c h).mono fun m hm => by simp [Term.usesRef, hm]
534:     · exact (usesRef_fillRefs σ n a h).mono fun m hm => by simp [Term.usesRef, hm]
535:     · exact (usesRef_fillRefs σ n b h).mono fun m hm => by simp [Term.usesRef, hm]
536: theorem usesRefRow_fillRefsRow (σ : Nat → Option Term) (n : Nat) : ∀ fs : List (Label × Term),
537:     Term.usesRefRow n (Term.fillRefsRow σ fs) = true →
538:       FillOrigin σ n (fun m => Term.usesRefRow m fs)
539:   | [], h => by simp [Term.fillRefsRow, Term.usesRefRow] at h
540:   | (_, t) :: fs, h => by
541:     simp only [Term.fillRefsRow, Term.usesRefRow, Bool.or_eq_true] at h
542:     rcases h with h | h
543:     · exact (usesRef_fillRefs σ n t h).mono fun m hm => by simp [Term.usesRefRow, hm]
544:     · exact (usesRefRow_fillRefsRow σ n fs h).mono fun m hm => by simp [Term.usesRefRow, hm]
545: end

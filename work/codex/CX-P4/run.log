private def s6 : Except Refusal (W × Cl) :=
  Session.run [.propose 0 (cand (.lit 5) []), .propose 0 (cand (.add (.lit 2) (.lit 3)) []),
    .propose 0 (cand (.lit 7) []), .select 1 0 0] (w0, start tpl0 w0)

private def s6b : Except Refusal (W × Cl) := s6.bind fun st => Session.run [.select 1 0 1] st
private def s6c : Except Refusal (W × Cl) := s6.bind fun st => Session.run [.select 1 0 2] st

private def clOf : Except Refusal (W × Cl) → Cl
  | .ok st => st.2
  | .error _ => start tpl0 w0

/-- A consumer relying on the hole's VALUE, and one relying on its syntax (identity). -/
private def kVal (ok : Option Nat → Bool) : Consumer ToyCalc (Option Nat) := ⟨0, eval, ok⟩
private def kSyn : Consumer ToyCalc Tm := ⟨0, id, fun M => M == .lit 5⟩

/-- **Experiment 6.** Replacing `5` by `2 + 3` changes `σ` but not the exported value: EVERY
value consumer is unchanged (by `consumer_boundary`), while the syntax consumer breaks; replacing
it by `7` changes the value consumer. -/
theorem replace_filling_preserving_contract :
    (clOf s6).sigma 0 = some (.lit 5) ∧ (clOf s6b).sigma 0 = some (.add (.lit 2) (.lit 3)) ∧
    (∀ ok, (kVal ok).holds (clOf s6) = (kVal ok).holds (clOf s6b)) ∧
    kSyn.holds (clOf s6) = true ∧ kSyn.holds (clOf s6b) = false ∧
    (kVal fun v => v == some 5).holds (clOf s6c) = false := by
  refine ⟨by decide, by decide, fun ok => consumer_boundary _ (by simp only [kVal]; decide), by decide, by decide,
    by decide⟩

/-! ## Experiment 7: correct, but the cost guarantee is lost -/

private def s7 : Except Refusal (W × Cl) :=
  Session.run [.propose 0 (cand (.lit 3) [] 200), .propose 0 (cand (.lit 50) []),
    .propose 0 (cand (.lit 3) [])] (w0, start tpl0 w0)

/-- **Experiment 7.** A candidate whose guard holds but whose cost exceeds the budget is
`uncovered`: distinct from `verified` and from `conflict`, and not selectable. -/
theorem correct_but_cost_lost :
    obs s7 = some [[.uncovered 200 100, .conflict .guardFails, .verified]] ∧
    refusal (s7.bind fun st => Session.run [.select 1 0 0] st) =
      some (.notVerified (.uncovered 200 100)) ∧
    sel 0 (s7.bind fun st => Session.run [.select 1 0 2] st) = some (some 2) := by
  decide

/-! ## Experiment 8: re-apply an earlier filling -/

/-- `f1 = 5` under `A`, `f2 = 6` under `B`; `f1` selected; `A` withdrawn; the replacement `f2`
selected by the chooser after deselecting. -/
private def s8 : Except Refusal (W × Cl) :=
  Session.run [.propose 0 (cand (.lit 5) [tA]), .propose 0 (cand (.lit 6) [tB]), .select 1 0 0,
    .edit (.withdraw tA), .deselect 1 0, .select 1 0 1] (w0, start tpl0 w0)

private def s8back : Except Refusal (W × Cl) := s8.bind fun st => Session.run [.edit (.assert tA), .select 1 0 0] st

private def s8reissued : Except Refusal (W × Cl) :=
  s8.bind fun st => Session.run ((reissue 1 0 1).map Op.edit ++ [.select 1 0 0]) st

private def ncands : Except Refusal (W × Cl) → Option Nat
  | .ok st => some (st.2.slot 0).cands.length
  | .error _ => none

/-- **Experiment 8.** Candidates are retained across deselect; when `A` (the same immutable token)
is live again, the earlier filling is re-selected without re-proposal; when `A`'s id is re-issued
at a NEW version, the old candidate stays unusable. -/
theorem reapply_earlier_filling :
    outs (.withdraw tA) (Session.run [.propose 0 (cand (.lit 5) [tA]), .propose 0 (cand (.lit 6) [tB]),
      .select 1 0 0] (w0, start tpl0 w0)) = some [(1, 0, 1)] ∧
    sel 0 s8 = some (some 1) ∧ ncands s8 = some 2 ∧
    sel 0 s8back = some (some 0) ∧ ncands s8back = some 2 ∧
    refusal s8reissued = some (.notVerified (.suspended [tA])) := by
  decide

/-- The tooth of the token theorem: under a world keyed by id alone (versions ignored), the
re-issued id WOULD re-enable the old candidate. -/
private def unversioned (w : W) : W := { w with live := fun t => w.live ⟨t.id, 0⟩ || w.live ⟨t.id, 1⟩ }

theorem unversioned_reissue_reenables :
    judge hole0 (applyAll (reissue 1 0 1) w0) (cand (.lit 5) [tA]) ≠ .verified ∧
    judge hole0 (unversioned (applyAll (reissue 1 0 1) w0)) (cand (.lit 5) [tA]) = .verified :=
  ⟨reissued_support_unverified (by decide) (by decide), by decide⟩

/-! ## Strengthening: the proposal's obstruction, `a : A ⊢ a` with `a` withdrawn -/

/-- A hole with one hypothesis `x = 7` in its context, backed by token `H`. -/
private def holeH : Iface ToyCalc Nat :=
  { name := 0, ctx := ([7] : List Nat), ty := (), hyps := [(7, tH)], hyps_real := by decide,
    guard := fun _ _ => true, budget := 100, chooser := 1, acceptor := 2 }

private def tplH : Template ToyCalc Nat where
  Γ := ([7] : List Nat)
  T := ()
  P := Tm.hole 0
  Ω := [holeH]
  names := List.nodup_cons.2 ⟨by simp, List.nodup_nil⟩

private def wH : W := ⟨fun t => t == tH, 0⟩

/-- `g1 = x` (uses the hypothesis), `g2 = 3` (does not). -/
private def sH (i : Nat) : Except Refusal (W × Cl) :=
  Session.run [.propose 0 (cand (.var 7) []), .propose 0 (cand (.lit 3) []), .select 1 0 i]
    (wH, start tplH wH)

/-- Withdrawing `H` with `3` selected: the filling factors through the smaller context
(`strengthening`). With `x` selected: it loses its support (`suspended [H]`, no closed witness
of the hypothesis is invented) and `3` is offered as a replacement. -/
theorem withdraw_hypothesis_strengthens :
    outs (.withdraw tH) (sH 1) = some [(2, 0, 7)] ∧
    obs ((sH 1).bind fun st => Session.run [.edit (.withdraw tH)] st) =
      some [[.suspended [tH], .verified]] := by
  decide

theorem withdraw_used_hypothesis_obstructs :
    outs (.withdraw tH) (sH 0) = some [(1, 0, 1)] ∧
    sel 0 ((sH 0).bind fun st => Session.run [.edit (.withdraw tH)] st) = some (some 0) := by
  decide

/-! ## The tooth of derivability: an unchecked selection -/

/-- A closure that selects `x` in the empty context, bypassing `select`. -/
private def clBad : Cl :=
  { start tpl0 w0 with slot := fun _ => ⟨[cand (.var 9) []], some 0, false⟩ }

theorem unchecked_select_underivable :
    ¬ Derivable toyHasTy clBad ∧ ¬ WellFilled clBad ∧
    refusal (Session.run [.propose 0 (cand (.var 9) []), .select 1 0 0] (w0, start tpl0 w0)) =
      some (.notVerified (.conflict .illTyped)) := by
  refine ⟨by unfold Derivable toyHasTy; decide, fun h => ?_, by decide⟩
  obtain ⟨c, hc, hchk⟩ := h hole0 (List.mem_singleton.2 rfl) 0 rfl
  simp only [clBad, List.getElem?_cons_zero, Option.some.injEq] at hc
  subst hc
  revert hchk; decide

/-! ## Stability class -/

/-- A value-preserving rewrite: `5 ↦ 2 + 3`. -/
private def five : Tm → Tm := fun t => if t = .lit 5 then .add (.lit 2) (.lit 3) else t

theorem five_preserves_value : ∀ t, eval (five t) = eval t := by
  intro t
  unfold five
  split
  · rename_i h; subst h; rfl
  · rfl

private def isLit (_ : Nat) : Tm → Bool
  | .lit _ => true
  | _ => false

theorem valueBelow_valueGuard : ValueGuard (D := ToyCalc) eval valueBelow :=
  ⟨fun n v => match v with | some v => decide (v < n) | none => false, fun _ _ => rfl⟩

/-- The hole's value guard is stable under the value-preserving rewrite. -/
theorem value_guard_stable : StableUnder (D := ToyCalc) valueBelow five :=
  stability_class eval valueBelow_valueGuard five_preserves_value

/-- A guard that inspects syntax is NOT stable under the same rewrite, hence is not a value guard. -/
theorem syntactic_guard_not_stable :
    ¬ StableUnder (D := ToyCalc) isLit five ∧ ¬ ValueGuard (D := ToyCalc) eval isLit := by
  have h : ¬ StableUnder (D := ToyCalc) isLit five := fun h => by
    have := h 0 (.lit 5)
    revert this; decide
  exact ⟨h, fun hv => h (stability_class eval hv five_preserves_value)⟩

/-! ## Locality instance: an unrelated state update -/

/-- **Locality, instanced.** Withdrawing `K`, which no candidate of experiment 1 cites, leaves the
closure exactly as it was and reports nothing (the plan stays usable without being looked at). -/
theorem unrelated_withdraw_is_frame :
    (repair w0 (.withdraw tK) (clOf s1)).1 = clOf s1 ∧ (repair w0 (.withdraw tK) (clOf s1)).2.1 = [] ∧
      (repair w0 (.withdraw tK) (clOf s1)).2.2 = [] :=
  locality (t := tK) (Or.inl rfl) (by decide)

/-! ## The executed prefix, instanced -/

/-- `5` under `A` selected and ACCEPTED (executed); `6` under `B` retained. -/
private def s9 : Except Refusal (W × Cl) :=
  Session.run [.propose 0 (cand (.lit 5) [tA]), .propose 0 (cand (.lit 6) [tB]), .select 1 0 0,
    .accept 2 0] (w0, start tpl0 w0)

/-- After acceptance: re-selection is refused by name; the acceptance owes a settlement; a
withdrawal of the executed candidate's support does NOT re-plan (no replacement is offered even
though `6` is verified): the hole is suspended with `reconcile`, and the selection stands. Only the
acceptor accepts. -/
theorem executed_prefix_instance :
    refusal (s9.bind fun st => Session.run [.select 1 0 1] st) = some .accepted ∧
    phiS s9 = some [.settle 0 0] ∧
    outs (.withdraw tA) s9 = some [(4, 0, 0)] ∧
    obligations (.withdraw tA) s9 = some [.reconcile 0 0] ∧
    sel 0 (s9.bind fun st => Session.run [.edit (.withdraw tA)] st) = some (some 0) ∧
    refusal (Session.run [.propose 0 (cand (.lit 5) [tA]), .select 1 0 0, .accept 1 0]
      (w0, start tpl0 w0)) = some .notAcceptor := by
  decide

/-! ## Coherence and the repair log on an experiment state -/

theorem start_coherent (tpl : Template ToyCalc Nat) (w : W) : Coherent w (start tpl w) :=
  fromScratch_coherent w tpl _

/-- Experiment 1's state is coherent and well filled, by the session theorems (not by evaluation). -/
theorem s1_coherent : ∃ st, s1 = .ok st ∧ Coherent st.1 st.2 ∧ WellFilled st.2 := by
  cases h : s1 with
  | error r =>
    have hs : refusal s1 = none := by decide
    rw [h] at hs; cases hs
  | ok st =>
    refine ⟨st, rfl, ?_, ?_⟩
    · exact session_preserves_coherent _ (start_coherent tpl0 w0) h
    · exact session_preserves_wellFilled _ (fromScratch_wellFilled w0 tpl0 _) h

/-- The fixture templates type under their open interfaces. -/
theorem tpl0_typed : tpl0.Typed toyHasTy := by
  unfold Template.Typed toyHasTy; decide

theorem tplH_typed : tplH.Typed toyHasTy := by
  unfold Template.Typed toyHasTy; decide

/-- **Experiment 1's state is DERIVABLE**: the template with its selected filling types, by
`derivable_of_wellFilled` over the toy's laws, the template's typing and the session's
well-filledness (not by evaluating the typing). -/
theorem s1_derivable : ∃ st, s1 = .ok st ∧ Derivable toyHasTy st.2 := by
  obtain ⟨st, hs, -, hwf⟩ := s1_coherent
  refine ⟨st, hs, derivable_of_wellFilled toyLaws ?_ hwf⟩
  have := session_preserves_tpl _ hs
  rw [this]; exact tpl0_typed

/-- Withdrawing `A` in experiment 1 re-judges candidate 0 (it cites `A`) and NOT candidate 1. -/
theorem rejudged_only_touched : (repair w0 (.withdraw tA) (clOf s1)).2.2 = [(0, 0)] := by
  decide

end Nanodregg.Lang.Contextual.Toy
/-
# Lang.Contextual.Protocol — open protocols as typed families of continuations (lane PROTOCOL)

The object of the activities proposal's document 2: a protocol between parties is an OPEN object.
Its unspecified components are HOLES, each declared in a context `Ω` with an interface (where it
starts, what it must deliver, which reusable facts and which linear tokens it may use, which
obligations it may leave, who chooses its filling and which contract it must pass). Its
interactions with peers are `call op k` nodes whose continuation is a FAMILY indexed by the response
(`k : (r : Resp op) → Prot (next op r)`). A substitution is ONE filling per hole NAME, chosen before
anything is observed. Whether that separates a hole from an interaction depends on the NAMING, not
on the calculus: a template that puts the SAME name in every response branch gets one filling for
all of them (`Proofs.Contextual.Protocol.Coin.no_foresight`), but a template whose hole names
depend on the response (`call op fun r => hole (h r)`) gets a filling per response, which is
foresight (`response_indexed_names_have_foresight`; `foresight_iff_names_separate` is the exact
condition). Scope (one filling into every branch unchanged) is a naming discipline the author
keeps; the calculus does not enforce it. Its resources are tokens a `call` of a consuming operation
spends. The discipline is AFFINE: a token is spent at most once, and a token left unspent at `ret`
is allowed. Its executed prefix is a history (`Hist`), possibly ending in a call
whose reply was lost (`inflight`), and a re-substitution must leave every hole the history has
already entered alone (`Dispatched`).

The shape generalises minidregg's `Theory/IndexedProgram.lean` (restated in Lean core, law 11): its
`IxSignature`/`Program` gain a third constructor `hole`, its `Algebra` a hole case, its interpreter
a `stuck` outcome (doc 2 section 7: partiality visible in the result type). Nano's own free program
over effects (`Hosting.Resident.Prog`) is the instance with a trivial index and no holes
(`Proofs.Contextual.Protocol.nano_runs_iff`, `nano_interp_agrees`).

The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, A) ⊣ Φ` is `HasProt sp Ω Γ Q Φ Δ P`: `Γ` the reusable facts
(hypothetical: derivability is not current availability, `admits`), `Δ` the linear tokens (a bag:
`SubBag`), `Q` the result postcondition, `Φ` the obligations any completion may still owe (an upper
bound). Substitution is SINGLE-PASS: `subst σ` replaces each hole by its filling and does not
substitute into the filling, so a filling's own holes stay open under the same `σ`. Definitions only. The statements (`HasProt`, `Runs`, `Reach`, `Started`, `Dispatched`, `SubBag`,
`Fills`, `SubstOK`, ...) are in `Lang.Proofs.Contextual.ProtocolTyping`; the theorems are in
`Lang.Proofs.Contextual.Protocol` and `Lang.Proofs.Contextual.Negotiation`.
-/

namespace Nanodregg.Lang.Contextual.Protocol

/-! ## Signatures, the accounting of an operation, polarity -/

/-- An indexed signature (mini's `IxSignature`, restated): at index `i` the operations `Op i`; each
operation's response type; the response selects the next index. -/
structure Sig (Ix : Type) where
  Op : Ix → Type
  Resp : {i : Ix} → Op i → Type
  next : {i : Ix} → (op : Op i) → Resp op → Ix

/-- What one operation does to the accounts: the linear token it SPENDS (if any), the reusable
facts it REQUIRES (authority, evidence: used, never consumed), and the obligations its DISPATCH
establishes (established when the call leaves, whatever the reply). -/
structure Spec {Ix : Type} (S : Sig Ix) (Tok Fact Ob : Type) where
  consumes : {i : Ix} → S.Op i → Option Tok
  requires : {i : Ix} → S.Op i → List Fact
  establishes : {i : Ix} → S.Op i → List Ob

/-- Who chooses a hole's filling (and, reused, which side must accept it). -/
inductive Polarity
  | ours
  | theirs
deriving DecidableEq, Repr

/-! ## Open protocols -/

/-- The free open protocol over `S` with result family `A` and hole names `Hole`: return a result,
interact (`call`: one continuation per response, at the index the response selects), or leave a
named component unspecified (`hole h`, its interface in the context `Ω`, as a CMTT metavariable
refers to the meta-context). -/
inductive Prot {Ix : Type} (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) : Ix → Type where
  | ret {i : Ix} (a : A i) : Prot S Hole A i
  | call {i : Ix} (op : S.Op i) (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) :
      Prot S Hole A i
  | hole {i : Ix} (h : Hole i) : Prot S Hole A i

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- A hole's interface `u :: [Γ_u; Δ_u ⊢ Protocol(i, post)] ⊣ owes`, with its polarity and an
acceptance contract that every filling must pass (`Fills`). The start index is the hole name's
index. -/
structure Iface (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  /-- who chooses the filling -/
  pol : Polarity
  /-- the reusable facts a filling may require (`Γ_u`) -/
  ctx : List Fact
  /-- the tokens a filling may spend (`Δ_u`) -/
  need : List Tok
  /-- what every result a filling delivers satisfies -/
  post : (j : Ix) → A j → Prop
  /-- the obligations a filling may leave -/
  owes : List Ob
  /-- the acceptance contract on a filling -/
  accepts : Prot S Hole A i → Prop

/-- `Ω`: the declared interface of every unresolved component. -/
abbrev Ctx (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) :=
  (i : Ix) → Hole i → Option (Iface S Hole A Tok Fact Ob i)

/-- `σ`: a partial substitution, a filling for some holes (doc 2 section 9). -/
abbrev Subst (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) :=
  (i : Ix) → Hole i → Option (Prot S Hole A i)

/-- Typed substitution: every hole `σ` fills is replaced by its filling; nothing else moves. -/
def subst (σ : Subst S Hole A) : {i : Ix} → Prot S Hole A i → Prot S Hole A i
  | _, .ret a => .ret a
  | _, .call op k => .call op fun r => subst σ (k r)
  | i, .hole h => match σ i h with
    | some f => f
    | none => .hole h

/-- `σ` restricted to the holes `Ω` declares `ours`: a `theirs` hole is never filled. -/
def Subst.ours {Tok Fact Ob : Type} (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A) :
    Subst S Hole A := fun i h =>
  match Ω i h with
  | some I => if I.pol = .ours then σ i h else none
  | none => none

/-- `P[σ]` under `Ω`: fill the `ours` holes `σ` names. -/
def fill {Tok Fact Ob : Type} (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A)
    {i : Ix} (P : Prot S Hole A i) : Prot S Hole A i :=
  subst (σ.ours Ω) P

/-- The single substitution `[f/h]`. -/
def Subst.single [DecidableEq Ix] [∀ i, DecidableEq (Hole i)] {i : Ix} (h : Hole i)
    (f : Prot S Hole A i) : Subst S Hole A := fun j h' =>
  if hj : i = j then (by subst hj; exact if h' = h then some f else none) else none

/-- A signature whose response types are finite, listed. -/
structure Finite (S : Sig Ix) where
  resps : {i : Ix} → (op : S.Op i) → List (S.Resp op)
  complete : ∀ {i : Ix} (op : S.Op i) (r : S.Resp op), r ∈ resps op

/-- The holes of `P`, computed over a finite signature (`mem_holes_iff`: exactly `Occurs`). -/
def holes (fin : Finite S) : {i : Ix} → Prot S Hole A i → List (Σ j, Hole j)
  | _, .ret _ => []
  | _, .call op k => (fin.resps op).attach.flatMap fun r => holes fin (k r.1)
  | i, .hole h => [⟨i, h⟩]

/-! ## Linear tokens as a bag -/

/-! ## The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, Q) ⊣ Φ` -/

/-! ## Algebras, fold, fusion -/

/-- An algebra reads an open protocol into an indexed carrier; holes too. -/
structure Algebra (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (C : Ix → Type) where
  ret : {i : Ix} → A i → C i
  call : {i : Ix} → (op : S.Op i) → ((r : S.Resp op) → C (S.next op r)) → C i
  hole : {i : Ix} → Hole i → C i

/-- The fold. -/
def fold {C : Ix → Type} (alg : Algebra S Hole A C) : {i : Ix} → Prot S Hole A i → C i
  | _, .ret a => alg.ret a
  | _, .call op k => alg.call op fun r => fold alg (k r)
  | _, .hole h => alg.hole h

/-- Substitution as an algebra into protocols. -/
def substAlg (σ : Subst S Hole A) : Algebra S Hole A (Prot S Hole A) where
  ret := .ret
  call := .call
  hole := fun {i} h => match σ i h with
    | some f => f
    | none => .hole h

/-- Read a template under an environment: a filled hole is read as its filling's reading, an
unfilled one as the algebra's hole. -/
def underAlg {C : Ix → Type} (alg : Algebra S Hole A C) (σ : Subst S Hole A) :
    Algebra S Hole A C where
  ret := alg.ret
  call := alg.call
  hole := fun {i} h => match σ i h with
    | some f => fold alg f
    | none => alg.hole h

/-! ## Handlers, the interpreter, partial results -/

/-- A deterministic environment: one operation against an indexed state gives a response and a
state at the index the response selects (mini's `Handler`). -/
structure Handler (S : Sig Ix) (St : Ix → Type) where
  handle : {i : Ix} → (op : S.Op i) → St i → Σ r : S.Resp op, St (S.next op r)

/-- How an interpretation ends: a result, or STUCK at an unresolved hole (never a failure). -/
inductive Result (Hole : Ix → Type) (A : Ix → Type) (St : Ix → Type) where
  | done (j : Ix) (a : A j) (s : St j)
  | stuck (j : Ix) (h : Hole j) (s : St j)

/-- The handler as a state-transformer algebra. -/
def execAlgebra {St : Ix → Type} (H : Handler S St) :
    Algebra S Hole A (fun i => St i → Result Hole A St) where
  ret := fun {i} a s => .done i a s
  call := fun op k s => match H.handle op s with
    | ⟨r, s'⟩ => k r s'
  hole := fun {i} h s => .stuck i h s

/-- Run an open protocol against an environment. -/
def interpret {St : Ix → Type} (H : Handler S St) {i : Ix} (P : Prot S Hole A i) :
    St i → Result Hole A St :=
  fold (execAlgebra H) P

/-- Run a template with its holes bound by `σ` in the environment rather than in the syntax. -/
def interpretUnder {St : Ix → Type} (H : Handler S St) (σ : Subst S Hole A) {i : Ix}
    (P : Prot S Hole A i) : St i → Result Hole A St :=
  fold (underAlg (execAlgebra H) σ) P

/-- The recording environment: `H`, and each call appended to a trace with the response it had
(the shape of nano's `recorder`). -/
def record {St : Ix → Type} (H : Handler S St) : Handler S (fun i => St i × List (Σ i, Σ op : S.Op i, S.Resp op)) where
  handle := fun {i} op p => match H.handle op p.1 with
    | ⟨r, s'⟩ => ⟨r, (s', p.2 ++ [⟨i, op, r⟩])⟩

/-! ## History -/

/-- One performed interaction: the operation, at its index, with the response it had. -/
abbrev Entry (S : Sig Ix) := Σ i, Σ op : S.Op i, S.Resp op

/-- A history of performed interactions, in order. -/
abbrev Trace (S : Sig Ix) := List (Entry S)

/-- An accepted history: the answered interactions and, possibly, ONE dispatched call whose reply
has not arrived (lost or late: `uncertain`, a state, never a license to re-plan). -/
structure Hist (S : Sig Ix) where


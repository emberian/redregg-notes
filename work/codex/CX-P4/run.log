205: /-- Ordinary substitutions compose, for every pair of functions. -/
206: theorem substFn_substFn (g f : Nat → Tm) :
207:     ∀ t : Tm, substFn g (substFn f t) = substFn (fun i => substFn g (f i)) t
208:   | .var _ => rfl
209:   | .lam A t => by
210:     have h : (fun i => substFn (upS g) (upS f i)) = upS (fun i => substFn g (f i)) := by
222: theorem substFnL_substFnL (g f : Nat → Tm) :
223:     ∀ σ : List Tm, substFnL g (substFnL f σ) = substFnL (fun i => substFn g (f i)) σ
224:   | [] => rfl
225:   | t :: σ => by simp only [substFnL, substFn_substFn g f t, substFnL_substFnL g f σ]
226: end

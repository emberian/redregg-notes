deriving DecidableEq, Repr

/-- Phases: idle → reserved (deposit held) → done. -/
inductive Phase
  | idle
  | reserved
  | done
deriving DecidableEq, Repr

/-- The operations. `reserve` holds the buyer's deposit; `commit p` spends the one-use capability
on provider `p` (the provider's reply: delivered or not); `cancel` abandons and refunds. -/
inductive Op : Phase → Type
  | reserve : Op .idle
  | commit (p : Provider) : Op .reserved
  | cancel : Op .reserved

def respOf : {i : Phase} → Op i → Type
  | _, .reserve => Unit
  | _, .commit _ => Bool
  | _, .cancel => Unit

def sig : Sig Phase where
  Op := Op
  Resp := respOf
  next := fun
    | .reserve, _ => .reserved
    | .commit _, _ => .done
    | .cancel, _ => .done

/-- The single linear token: the capability. -/
inductive Tok
  | cap
deriving DecidableEq, Repr

/-- Reusable facts: a provider's authority; the deadline has not passed. -/
inductive Fact
  | auth (p : Provider)
  | beforeDeadline
deriving DecidableEq, Repr

/-- Obligations: the deposit is held; pay provider `p`; refund the deposit. -/
inductive Ob
  | holdDeposit
  | pay (p : Provider)
  | refund
deriving DecidableEq, Repr

def spec : Spec sig Tok Fact Ob where
  consumes := fun
    | .commit _ => some .cap
    | _ => none
  requires := fun
    | .commit p => [.auth p, .beforeDeadline]
    | _ => []
  establishes := fun
    | .reserve => [.holdDeposit]
    | .commit p => [.pay p]
    | .cancel => [.refund]

/-- One hole: which provider, chosen by us, after the reservation. -/
def HoleN : Phase → Type
  | .reserved => Unit
  | _ => Empty

/-- Results: whether the capability's service was delivered. -/
abbrev Res : Phase → Type := fun _ => Bool

abbrev P := Prot sig HoleN Res

instance : ∀ i, DecidableEq (HoleN i)
  | .idle => fun a => nomatch a
  | .reserved => fun () () => isTrue rfl
  | .done => fun a => nomatch a

/-- The open protocol: reserve, then the provider hole. -/
def template : P .idle := .call (S := sig) Op.reserve fun _ => .hole (i := Phase.reserved) ()

/-- A candidate: commit the capability on `p`; deliver its reply. -/
def plan (p : Provider) : P .reserved := .call (S := sig) (Op.commit p) fun ok => .ret ok

/-- The cancellation path. -/
def cancelPlan : P .reserved := .call (S := sig) Op.cancel fun _ => .ret false

/-- The hole's interface: ours, accepted by us, may use both providers' authority and the
deadline, may spend the capability, may owe payment to either provider or the refund. -/
def iface : Iface sig HoleN Res Tok Fact Ob .reserved where
  pol := .ours
  ctx := [.auth .p1, .auth .p2, .beforeDeadline]
  need := [.cap]
  post := fun _ _ => True
  owes := [.pay .p1, .pay .p2, .refund]
  accepts := fun _ => True

def Ω : Ctx sig HoleN Res Tok Fact Ob := fun
  | .reserved, () => some iface
  | .idle, h => nomatch h
  | .done, h => nomatch h

/-- Choose `f` for the provider hole. -/
def choose (f : P .reserved) : Subst sig HoleN Res := fun
  | .reserved, () => some f
  | .idle, h => nomatch h
  | .done, h => nomatch h

/-- The negotiation's responses, listed. -/
def finite : Finite sig where
  resps := fun
    | .reserve => [()]
    | .commit _ => [true, false]
    | .cancel => [()]
  complete := by
    intro i op r
    cases op with
    | reserve => cases r; simp
    | commit p => cases r <;> simp
    | cancel => cases r; simp

/-- The negotiation's hypotheses, tokens and obligation bound. -/
def Γ₀ : List Fact := [.auth .p1, .auth .p2, .beforeDeadline]
def Δ₀ : List Tok := [.cap]
def Φ₀ : List Ob := [.holdDeposit, .pay .p1, .pay .p2, .refund]

/-- The open object: the template with `f` chosen for the provider hole, history `H`. -/
def obj (f : P .reserved) (H : Hist sig) : Open sig HoleN Res Tok Fact Ob .idle where
  template := template
  Ω := Ω
  σ := choose f
  Γ := Γ₀
  Δ := Δ₀
  Q := fun _ _ => True
  Φ := Φ₀
  hist := H

/-- The reservation answered. -/
def reserved : Entry sig := ⟨.idle, Op.reserve, ()⟩

/-- Reserved; nothing dispatched yet. -/
def H₀ : Hist sig := ⟨[reserved], none⟩

/-- Reserved; the commitment to `p` dispatched and its reply LOST. -/
def lost (p : Provider) : Hist sig := ⟨[reserved], some ⟨.reserved, Op.commit p⟩⟩

/-- An environment: providers deliver iff `deliver`; the state counts calls. -/
def env (deliver : Bool) : Handler sig (fun _ => Nat) where
  handle := fun op n => match op with
    | .reserve => ⟨(), n + 1⟩
    | .commit _ => ⟨deliver, n + 1⟩
    | .cancel => ⟨(), n + 1⟩

/-- The world: a clock and a deadline, provider authority, the capability's nullifier (spent or
not), and an unrelated store. -/
structure World where
  now : Nat
  deadline : Nat
  auth : Provider → Bool
  capSpent : Bool
  other : Nat → Nat

/-- What the world says to admission. -/
def World.view (w : World) : View Tok Fact where
  holds := fun
    | .auth p => w.auth p
    | .beforeDeadline => decide (w.now < w.deadline)
  live := fun .cap => !w.capSpent

/-- The candidates, numbered, in the order the plan lists them. -/
def candidates : List (Nat × P .reserved) := [(1, plan .p1), (2, plan .p2), (3, cancelPlan)]

/-- The numbers of the candidates admissible in `w` now. -/
def available (w : World) : List Nat :=
  (candidates.filter fun c => admits spec w.view c.2).map Prod.fst

/-- The world on day 0: both providers authorised, deadline 10, capability unspent. -/
def w0 : World := ⟨0, 10, fun _ => true, false, fun _ => 0⟩

/-- Revoke a provider's authority. -/
def World.revoke (w : World) (p : Provider) : World :=
  { w with auth := fun q => if q = p then false else w.auth q }

/-- A commitment against the world: refused unless admissible, then the nullifier is spent. -/
def World.commit (w : World) {i : Phase} (op : Op i) : Option World :=
  if admitOp spec w.view (S := sig) op then
    some (match spec.consumes (S := sig) op with
      | some .cap => { w with capSpent := true }
      | none => w)
  else none

/-- The candidate fragments for selective repair: each candidate's admission, over the keys of
its first effect. -/
def frags : List (Frag Nat (Fact ⊕ Tok) Bool) :=
  [admitFrag spec 1 (S := sig) (Op.commit .p1), admitFrag spec 2 (S := sig) (Op.commit .p2),
    admitFrag spec 3 (S := sig) Op.cancel]

/-- A second representation of the capability token: its opening under the root of an epoch.
Openings from different epochs are different representations of the same capability. -/
inductive Tok'
  | capAt (epoch : Nat)
deriving DecidableEq, Repr

/-- The representation under epoch `E`. -/
def Tok.at (E : Nat) : Tok → Tok'
  | .cap => .capAt E

/-- The PARTIAL correspondence back: only an opening from the current epoch `E` names the token. -/
def Tok'.current (E : Nat) : Tok' → Option Tok
  | .capAt e => if e = E then some .cap else none

/-- The world's admission view over the new representation at current epoch `E`: an opening is
live only when it is from epoch `E` and the token it names is unspent. A stale opening is not. -/
def World.viewAt (w : World) (E : Nat) : View Tok' Fact where
  holds := w.view.holds
  live := fun t => match t.current E with
    | some t₀ => w.view.live t₀
    | none => false

/-- The world as a store of keys. -/
def World.store (w : World) : Fact ⊕ Tok → Bool
  | .inl f => w.view.holds f
  | .inr t => w.view.live t

/-! ### Internal once versus external once -/

/-- The external side of one commitment: how many times the network delivered the dispatched
request, whether the provider deduplicates by the request identity, and so how many times the
service was performed. -/
structure External where
  deliveries : Nat
  dedupe : Bool

def External.executions (e : External) : Nat :=
  if e.dedupe then min e.deliveries 1 else e.deliveries

/-- What the internal model records about one commitment: the nullifier spent and the reply
(`none`: lost). -/
structure Internal where
  capSpent : Bool
  reply : Option Bool

/-- The reply an answered entry carries, if it is a commitment. -/
def entryReply : Entry sig → Option Bool
  | ⟨_, op, r⟩ => match op, r with
    | .commit _, b => some b
    | .reserve, _ => none
    | .cancel, _ => none

/-- Is an in-flight call a commitment? -/
def inflightSpends : Option (Σ i, sig.Op i) → Bool
  | some ⟨_, .commit _⟩ => true
  | _ => false

/-- The internal record, READ OFF a history: the nullifier is spent when an answered or in-flight
call spent the capability; the reply is the answered commitment's. -/
def Internal.ofHist (H : Hist sig) : Internal where
  capSpent := (consumed spec H.answered).contains .cap || inflightSpends H.inflight
  reply := H.answered.findSome? entryReply

/-- Reserved, then the commitment to `p` answered with `b`. -/
def answeredH (p : Provider) (b : Bool) : Hist sig :=
  ⟨[reserved, ⟨.reserved, Op.commit p, b⟩], none⟩

/-- A filling with the same first call as `plan p` but a different continuation. -/
def planFlip (p : Provider) : P .reserved := .call (S := sig) (Op.commit p) fun ok => .ret (!ok)

end Negotiation

end Nanodregg.Lang.Contextual.Protocol
/-
# Lang.Proofs.Contextual.ProtocolTyping — the statements of the open-protocol theory (lane PROTOCOL)

The Prop-valued relations over `Lang.Contextual.Protocol`'s data: the judgment
`Ω;Γ;Δ ⊢ P : Protocol(i, Q) ⊣ Φ` (`HasProt`), linear tokens as a bag (`SubBag`), a filling that
satisfies an interface (`Fills`), an interface-respecting substitution (`SubstOK`), algebra
morphisms, complete paths (`Runs`), prefixes (`Reach`), histories (`Started`), entered holes
(`Dispatched`), the guard on a re-plan (`Open.Replan`), the well-formed open object (`Open.WF`),
sufficient supports (`Frag.ReadsOnly`), the completion space (`Conds.space`) and explicit matcher
assignments (`Assigns`). Theorems in `Lang.Proofs.Contextual.Protocol`.
-/
import Lang.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.Protocol

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- `h` occurs in `P` (on some response path). -/
inductive Occurs : {i : Ix} → Prot S Hole A i → (j : Ix) → Hole j → Prop
  | here {j : Ix} (h : Hole j) : Occurs (.hole h) j h
  | call {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {j : Ix} {h : Hole j} (r : S.Resp op) : Occurs (k r) j h → Occurs (.call op k) j h

/-- `Δ₁ ≤ Δ₂` as bags: no token occurs more often in `Δ₁`. -/
def SubBag {Tok : Type} [DecidableEq Tok] (Δ₁ Δ₂ : List Tok) : Prop :=
  ∀ t, Δ₁.count t ≤ Δ₂.count t

/-- `HasProt sp Ω Γ Q Φ Δ P`. A `call` requires its facts from `Γ`, records its obligations in `Φ`,
and, if it spends a token, takes it from `Δ`: every continuation is judged with that token gone
(LINEAR: a token is spent by at most one call on any path, `Proofs.hasProt_reach`). A hole is
judged by its declared interface: it must be ours, its context and tokens available here, its
results within `Q`, its obligations within `Φ`. -/
inductive HasProt {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob)
    (Ω : Ctx S Hole A Tok Fact Ob) (Γ : List Fact) (Q : (j : Ix) → A j → Prop) (Φ : List Ob) :
    List Tok → {i : Ix} → Prot S Hole A i → Prop
  | ret {Δ : List Tok} {i : Ix} (a : A i) : Q i a → HasProt sp Ω Γ Q Φ Δ (.ret a)
  | call {Δ : List Tok} {i : Ix} (op : S.Op i)
      (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) :
      sp.consumes op = none → (∀ f ∈ sp.requires op, f ∈ Γ) →
      (∀ o ∈ sp.establishes op, o ∈ Φ) →
      (∀ r, HasProt sp Ω Γ Q Φ Δ (k r)) → HasProt sp Ω Γ Q Φ Δ (.call op k)
  | spend {Δ : List Tok} {i : Ix} (op : S.Op i)
      (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) (t : Tok) :
      sp.consumes op = some t → t ∈ Δ → (∀ f ∈ sp.requires op, f ∈ Γ) →
      (∀ o ∈ sp.establishes op, o ∈ Φ) →
      (∀ r, HasProt sp Ω Γ Q Φ (Δ.erase t) (k r)) → HasProt sp Ω Γ Q Φ Δ (.call op k)
  | hole {Δ : List Tok} {i : Ix} (h : Hole i) (I : Iface S Hole A Tok Fact Ob i) :
      Ω i h = some I → I.pol = .ours → (∀ f ∈ I.ctx, f ∈ Γ) → SubBag I.need Δ →
      (∀ j a, I.post j a → Q j a) → (∀ o ∈ I.owes, o ∈ Φ) → HasProt sp Ω Γ Q Φ Δ (.hole h)

/-- A filling satisfies a hole's interface: judged in the hole's own context, tokens, result and
obligations, and passing the hole's acceptance contract. -/
def Fills {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob)
    (Ω : Ctx S Hole A Tok Fact Ob) {i : Ix} (I : Iface S Hole A Tok Fact Ob i)
    (f : Prot S Hole A i) : Prop :=
  HasProt sp Ω I.ctx I.post I.owes I.need f ∧ I.accepts f

/-- A substitution respects `Ω`: it fills only declared `ours` holes, each with a filling that
satisfies the hole's interface. -/
def SubstOK {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob)
    (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A) : Prop :=
  ∀ i h f, σ i h = some f → ∃ I, Ω i h = some I ∧ I.pol = .ours ∧ Fills sp Ω I f

/-- `φ` is an algebra morphism `src → dst` (carriers may differ). -/
structure AlgebraHom {C D : Ix → Type} (src : Algebra S Hole A C) (dst : Algebra S Hole A D)
    (φ : (i : Ix) → C i → D i) : Prop where
  ret : ∀ {i : Ix} (a : A i), φ i (src.ret a) = dst.ret a
  call : ∀ {i : Ix} (op : S.Op i) (k : (r : S.Resp op) → C (S.next op r)),
    φ i (src.call op k) = dst.call op (fun r => φ (S.next op r) (k r))
  hole : ∀ {i : Ix} (h : Hole i), φ i (src.hole h) = dst.hole h

/-- A complete path: the interactions performed, each with SOME response, and the result. -/
inductive Runs : {i : Ix} → Prot S Hole A i → Trace S → (j : Ix) → A j → Prop
  | ret {i : Ix} (a : A i) : Runs (.ret a) [] i a
  | call {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {tr : Trace S} {j : Ix} {a : A j} (r : S.Resp op) :
      Runs (k r) tr j a → Runs (.call op k) (⟨i, op, r⟩ :: tr) j a

/-- A performed prefix and the residual protocol it leaves. -/
inductive Reach : {i : Ix} → Prot S Hole A i → Trace S → (Σ j, Prot S Hole A j) → Prop
  | here {i : Ix} (P : Prot S Hole A i) : Reach P [] ⟨i, P⟩
  | call {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {tr : Trace S} {R : Σ j, Prot S Hole A j} (r : S.Resp op) :
      Reach (k r) tr R → Reach (.call op k) (⟨i, op, r⟩ :: tr) R

/-- `H` is a history of `P`: the answered part is a prefix, and the in-flight call (if any) is the
call the prefix's residual makes. -/
inductive Started : {i : Ix} → Prot S Hole A i → Hist S → Prop
  | settled {i : Ix} {P : Prot S Hole A i} {t : Trace S} {R : Σ j, Prot S Hole A j} :
      Reach P t R → Started P ⟨t, none⟩
  | uncertain {i : Ix} {P : Prot S Hole A i} {t : Trace S} {j : Ix} {op : S.Op j}
      {k : (r : S.Resp op) → Prot S Hole A (S.next op r)} :
      Reach P t ⟨j, .call op k⟩ → Started P ⟨t, some ⟨j, op⟩⟩

/-- The history has ENTERED hole `h` of the template: the template's prefix reached `h` and
something after it was performed or dispatched (the filling's first call left). -/
def Dispatched {i : Ix} (P : Prot S Hole A i) (H : Hist S) (j : Ix) (h : Hole j) : Prop :=
  ∃ t₁ t₂, H.answered = t₁ ++ t₂ ∧ Reach P t₁ ⟨j, .hole h⟩ ∧ (t₂ ≠ [] ∨ H.inflight.isSome = true)

/-- A well-formed open object: the template is judged, the substitution respects `Ω`, the
history is a history of the current protocol. -/
structure Open.WF {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob) {i : Ix}
    (O : Open S Hole A Tok Fact Ob i) : Prop where
  typed : HasProt sp O.Ω O.Γ O.Q O.Φ O.Δ O.template
  substOK : SubstOK sp O.Ω O.σ
  started : Started O.current O.hist

/-- The guard on a re-plan: the new substitution agrees with the old one on every hole the history
has entered (there is no unguarded re-plan in any theorem: each takes this as a hypothesis). -/
def Open.Replan {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i) (σ' : Subst S Hole A) : Prop :=
  ∀ j h, Dispatched O.template O.hist j h → σ'.ours O.Ω j h = O.σ.ours O.Ω j h

end

/-- The fragment's check reads only its support (the soundness of a declared dependency set:
sufficient, not minimal). -/
def Frag.ReadsOnly {Name Key V : Type} (f : Frag Name Key V) : Prop :=
  ∀ w₁ w₂ : Key → V, (∀ k ∈ f.support, w₁ k = w₂ k) → f.check w₁ = f.check w₂

/-- `C_w(P) = {θ | Typed θ ∧ Guards θ ∧ Authority θ ∧ Resources θ}`: the SAME `θ` for all four. -/
def Conds.space {Θ : Type} (c : Conds Θ) (θ : Θ) : Prop :=
  c.typed θ ∧ c.guards θ ∧ c.authority θ ∧ c.resources θ

/-- An explicit assignment: the `k`-th want takes the offer at index `picks[k]` of the original
offers; indices distinct and in range; each offer covers its want. -/
def Assigns (offers wants picks : List Nat) : Prop :=
  picks.length = wants.length ∧ picks.Nodup ∧
    ∀ k < wants.length, picks.getD k 0 < offers.length ∧
      wants.getD k 0 ≤ offers.getD (picks.getD k 0) 0

end Nanodregg.Lang.Contextual.Protocol
"""gates/size.py TREE [--write] — the size ratchet (law 12).

Two files, two roles:
  gates/ceilings.tsv  hand-edited, `metric<TAB>ceiling<TAB>why`: the bounds, and the only input;
  SIZE.md             generated (`--write`; scripts/commit writes it for every candidate and
                      refuses it as a PATH): every measured metric, its value, its ceiling.
Red on:
  - SIZE.md differing from the view generated for the tree;
  - a measured value above its ceiling;
  - a value above the PARENT TREE's measurement without `SIZE: <metric>: <why>` in the message;
  - a ceiling raised, or a ceiling row removed, against the parent's gates/ceilings.tsv without
    `SIZE-CEILING: <metric>: <why>`;
  - a malformed ceilings.tsv row.
A ceiling on a metric nothing measures prints `WARN unmeasured`, which scripts/standing.sh turns
into an INCOMPLETE verdict (a ceiling over nothing checks nothing). Metrics this script cannot
measure come from executables in gates/metrics/, each printing `<metric>\t<integer>` lines.
"""
import argparse
import os
import re
import subprocess
import sys

import tree

# The deployed Host exe (lakefile `lean_exe «host»`, HOST-17). When it is absent the closure row is
# not measured (WARN unmeasured: a ceiling over nothing checks nothing), never measured as 0.
HOST_EXE = "host"


# A file Emit/Rust.lean wrote starts with its stable marker (CODEC 23a1445), and is registered in
# gates/generated.tsv, whose rows `lake exe emit-rust --check` gates. The client/src ceilings bound
# hand-written Rust (CLIENT-1, ROOT 10-16), so it excludes generated files; `Rust lines (generated)`
# keeps their growth visible. Only a REGISTERED file with the header counts as generated: a
# hand-written file that copies the header is counted as hand-written AND shows in the ceiling-0 row
# `Rust files with an unregistered generated header`.
GENERATED = re.compile(r"^// GENERATED by emit-rust\b.* — do not edit$")


def registered(root: str) -> set[str]:
    p = os.path.join(root, "gates", "generated.tsv")
    if not os.path.isfile(p):
        return set()
    rows = (l.split("\t") for l in open(p, encoding="utf-8") if l.strip() and not l.startswith("#"))
    return {os.path.normpath(r[1].strip()) for r in rows if len(r) > 1}


def source_files(root: str, exts: tuple[str, ...]):
    """(path relative to root, line count) for each file below root ending in one of exts. Only
    directories BELOW root are skipped by name: a gate tree itself lives under `.git/`."""
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith(exts):
                with open(os.path.join(d, f), encoding="utf-8", errors="replace") as fh:
                    yield os.path.relpath(os.path.join(d, f), root), sum(1 for _ in fh)


def rust_files(root: str, sub: str = ""):
    """(path relative to root, line count, has the generated header) for each .rs under root/sub."""
    for d, dirs, files in os.walk(os.path.join(root, sub)):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith(".rs"):
                path = os.path.join(d, f)
                with open(path, encoding="utf-8", errors="replace") as fh:
                    lines = fh.readlines()
                header = bool(lines) and bool(GENERATED.match(lines[0].rstrip("\n")))
                yield os.path.normpath(os.path.relpath(path, root)), len(lines), header


def rust_lines(root: str) -> int:
    return sum(n for _, n, _ in rust_files(root))


# Constructor-count metrics (ROOT ruling 2026-10-16: PROTOCOL's rows are computed, never hand
# rows): metric -> [(module prefix, inductive name)]; a missing module counts 0.
CONSTRUCTORS = {
    "protocol operations": [("Protocol.Table", "Op")],
    "call kinds (Receive.Body constructors)": [("Kernel.Receive", "Body")],
    "command verbs (the one command language)": [("Protocol.Command", "Verb")],
    "refusal constructors": [("Kernel.World", "Reject"), ("Kernel.Receive", "Refusal")],
    "protocol status codes": [("Protocol.Table", "Status")],
    "protocol step codes": [("Protocol.Table", "Step")],
}


def list_len(t: tree.Tree, module: str, name: str) -> int | None:
    """Elements of `def NAME : List … := [a, b, …]` in MODULE (the conformance rows are
    `Protocol.Rows.rows`); None when the module or the definition is absent."""
    m = t.modules.get(module)
    hit = m and re.search(r"(?m)^def[ \t]+" + re.escape(name) + r"[ \t]*:[^=]*:=\s*\[([^\]]*)\]", m.code)
    if not hit:
        return None
    return len([x for x in hit.group(1).split(",") if x.strip()])


def constructors(t: tree.Tree, prefix: str, name: str) -> int:
    n = 0
    for m in t.modules.values():
        if m.is_proof or not (m.name == prefix or m.name.startswith(prefix + ".")):
            continue
        for hit in re.finditer(r"(?m)^[ \t]*(?:(?:private|protected)[ \t]+)?inductive[ \t]+" + re.escape(name) + r"\b", m.code):
            body = []
            for line in m.code[hit.end():].split("\n")[1:]:
                if line and not line[0].isspace() or re.match(r"\s*deriving\b", line):
                    break
                body.append(line)
            n += sum(len(re.findall(r"(?:^|\s)\|\s*[\w«]", l)) for l in body)
    return n


def measure(t: tree.Tree) -> dict[str, int]:
    mods = t.modules.values()
    out = {}
    host = t.exes.get(HOST_EXE)
    if host:
        out["Lean modules in the Host closure"] = len(t.closure([host]))
    out["Lean modules"] = len(t.modules)
    out["Lean proof-modules"] = sum(1 for m in mods if m.is_proof)
    for lib in sorted(set(m.lib for m in mods)):
        out[f"Lean lines ({lib})"] = sum(m.lines for m in mods if m.lib == lib)
    # Deployed = definitions that are not tooling; tooling (the sims, rows, journeys, census and
    # emitter: tree.Module.is_tooling) is informational, and closure C9 keeps it out of deployed
    # imports. Proof-modules are in neither.
    out["Lean lines (deployed)"] = sum(m.lines for m in mods if not m.is_proof and not m.is_tooling)
    out["Lean lines (tooling: Sim, Rows, Journey, Census, Emit, Ops, Bench)"] = sum(
        m.lines for m in mods if not m.is_proof and m.is_tooling)
    deps = t.dependents()
    found = foundations(t)
    out["foundation modules"] = len(found)
    out["max dependents of a non-foundation module"] = max(
        (len(v) for m, v in deps.items() if m not in found), default=0)
    out["theorems"] = sum(1 for m in mods for d in m.decls if d.kind in tree.THEOREM_KINDS)
    out["partial defs (deployed)"] = sum(1 for m in mods for d in m.decls if d.partial)
    out["sorry"] = sum(len(re.findall(r"\bsorry\b", m.code)) for m in mods)
    out["native (extern/implemented_by)"] = sum(
        len(re.findall(r"@\[[^\]]*\b(?:implemented_by|extern)\b", m.code)) for m in mods)
    out["C lines"] = sum(n for _, n in source_files(t.root, (".c", ".h")))
    out["Rust lines"] = rust_lines(t.root)
    gen = registered(t.root)
    rs = list(rust_files(t.root))
    # client/src, hand-written only, in three parts (ROOT 10-17): each binary is bounded alone, and
    # the library is EVERYTHING else under client/src, so a new file (or binary) cannot escape a row.
    hand = {p: n for p, n, h in rs
            if p.startswith(os.path.join("client", "src") + os.sep) and not (h and p in gen)}
    bins = {"Rust lines (nd)": os.path.join("client", "src", "bin", "nd.rs"),
            "Rust lines (nd-supervise)": os.path.join("client", "src", "bin", "nd-supervise.rs")}
    for metric, path in bins.items():
        out[metric] = hand.get(path, 0)
    out["Rust lines (client library)"] = sum(n for p, n in hand.items() if p not in bins.values())
    # attach/ is its own program (ROOT 10-17): the ssh forced-command endpoint, its own row.
    out["Rust lines (attach/src)"] = sum(
        n for p, n, h in rs if p.startswith(os.path.join("attach", "src") + os.sep) and not (h and p in gen))
    out["Rust lines (generated)"] = sum(n for p, n, h in rs if h and p in gen)
    out["Rust files with an unregistered generated header"] = sum(
        1 for p, _, h in rs if h and p not in gen)
    for metric, sources in CONSTRUCTORS.items():
        out[metric] = sum(constructors(t, p, n) for p, n in sources)
    rows = list_len(t, "Protocol.Rows", "rows")
    if rows is not None:
        out["conformance rows"] = rows
    mdir = os.path.join(t.root, "gates", "metrics")
    if os.path.isdir(mdir):
        for f in sorted(os.listdir(mdir)):
            p = os.path.join(mdir, f)
            if os.access(p, os.X_OK) and os.path.isfile(p):
                r = subprocess.run([p, t.root], capture_output=True, text=True, timeout=120)
                if r.returncode != 0:
                    raise SystemExit(f"size: gates/metrics/{f} failed: {r.stderr.strip()}")
                for line in r.stdout.splitlines():
                    k, v = line.split("\t")
                    out[k] = int(v)
    return out



  answered : Trace S
  inflight : Option (Σ i, S.Op i)

/-- The tokens a trace spends. -/
def consumed {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (t : Trace S) : List Tok :=
  t.filterMap fun e => sp.consumes e.2.1

/-- The obligations a trace established. -/
def established {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (t : Trace S) : List Ob :=
  t.flatMap fun e => sp.establishes e.2.1

/-- The obligations a history established: the answered calls' and the in-flight call's (its
obligation stands from dispatch, whatever happened to the reply). -/
def Hist.established {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (H : Hist S) : List Ob :=
  Protocol.established sp H.answered ++
    match H.inflight with
    | some ⟨_, op⟩ => sp.establishes op
    | none => []

/-! ## The first-class open object (doc 2 section 9) -/

/-- `(P, Ω, σ, Γ, Δ, Q, Φ, t)`: the retained TEMPLATE, its open interface, the current partial
substitution, the hypotheses and tokens, the result contract, the obligation bound, and the
accepted history. The template is kept apart from `σ`: that is what makes re-substitution possible. -/
structure Open (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  template : Prot S Hole A i
  Ω : Ctx S Hole A Tok Fact Ob
  σ : Subst S Hole A
  Γ : List Fact
  Δ : List Tok
  Q : (j : Ix) → A j → Prop
  Φ : List Ob
  hist : Hist S

/-- The object's current protocol `P[σ]`. -/
def Open.current {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i) :
    Prot S Hole A i :=
  fill O.Ω O.σ O.template

/-- Replace the object's partial substitution. Data only: the GUARD (no re-substitution of a hole
the history has entered) is the statement `Open.Replan` in `Lang.Proofs.Contextual.ProtocolTyping`,
a hypothesis of every theorem about a re-plan (`Open.resubst_wf`). -/
def Open.replan {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i)
    (σ' : Subst S Hole A) : Open S Hole A Tok Fact Ob i :=
  { O with σ := σ' }

/-! ## Admission: current evidence, separate from derivability -/

/-- The CURRENT admission evidence: which facts hold now, which tokens are unspent now. -/
structure View (Tok Fact : Type) where
  holds : Fact → Bool
  live : Tok → Bool

/-- One concrete effect is admissible now: its facts hold and its token is unspent. -/
def admitOp {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix}
    (op : S.Op i) : Bool :=
  (sp.requires op).all v.holds &&
    match sp.consumes op with
    | some t => v.live t
    | none => true

/-- The protocol's NEXT concrete effect is admissible now. A hole has no concrete effect to admit
(an unfinished plan describes a family of transitions; only a complete one is admitted). -/
def admits {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix} :
    Prot S Hole A i → Bool
  | .ret _ => true
  | .call op _ => admitOp sp v op
  | .hole _ => false

/-- Durable consumption: mark a token spent. -/
def View.spend {Tok Fact : Type} [DecidableEq Tok] (v : View Tok Fact) (t : Tok) : View Tok Fact :=
  { v with live := fun t' => if t' = t then false else v.live t' }

/-- Commit one effect: refused unless admissible now; on success its token is spent durably. -/
def commit {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob) (v : View Tok Fact)
    {i : Ix} (op : S.Op i) : Option (View Tok Fact) :=
  if admitOp sp v op then
    some (match sp.consumes op with
      | some t => v.spend t
      | none => v)
  else none

/-- The keys an effect's admission reads: its facts and its token. -/
def opSupport {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) {i : Ix} (op : S.Op i) :
    List (Fact ⊕ Tok) :=
  (sp.requires op).map Sum.inl ++ (match sp.consumes op with
    | some t => [Sum.inr t]
    | none => [])

/-- A change of token REPRESENTATION (an authenticated representation of an unchanged semantic
token, e.g. an opening refreshed because a root moved): the spec with every token renamed. -/
def Spec.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') (sp : Spec S Tok Fact Ob) :
    Spec S Tok' Fact Ob where
  consumes := fun op => (sp.consumes op).map e
  requires := sp.requires
  establishes := sp.establishes

/-- An interface with its tokens renamed. -/
def Iface.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') {i : Ix}
    (I : Iface S Hole A Tok Fact Ob i) : Iface S Hole A Tok' Fact Ob i :=
  { I with need := I.need.map e }

/-- A context with its tokens renamed. -/
def Ctx.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') (Ω : Ctx S Hole A Tok Fact Ob) :
    Ctx S Hole A Tok' Fact Ob := fun i h => (Ω i h).map (Iface.mapTok e)

/-- A view as a store of keys. -/
def View.ofStore {Tok Fact : Type} (w : Fact ⊕ Tok → Bool) : View Tok Fact :=
  ⟨fun f => w (.inl f), fun t => w (.inr t)⟩

end

/-! ## Selective repair over fragments (doc 2 section 9, family 3) -/

/-- A checked fragment: a name, the keys its check declares it reads (its support), the check. -/
structure Frag (Name Key V : Type) where
  name : Name
  support : List Key
  check : (Key → V) → Bool

/-- Is the fragment affected by a change of `changed`? -/
def Frag.affected {Name Key V : Type} [DecidableEq Key] (f : Frag Name Key V)
    (changed : List Key) : Bool :=
  f.support.any fun k => decide (k ∈ changed)

/-- Check everything again. -/
def fromScratch {Name Key V : Type} (fs : List (Frag Name Key V)) (w : Key → V) : List Bool :=
  fs.map fun f => f.check w

/-- Selective repair: re-check the affected fragments, reuse every other cached verdict. -/
def repair {Name Key V : Type} [DecidableEq Key] :
    List (Frag Name Key V) → List Bool → List Key → (Key → V) → List Bool
  | [], _, _, _ => []
  | f :: fs, [], ch, w => f.check w :: repair fs [] ch w
  | f :: fs, c :: cs, ch, w => (if f.affected ch then f.check w else c) :: repair fs cs ch w

/-- The names of the fragments that do not check. Each name stands for one residual obligation
(re-establish that fragment); the list is `Φ′` only in that sense. -/
def residual {Name Key V : Type} : List (Frag Name Key V) → List Bool → List Name
  | [], _ => []
  | f :: fs, [] => f.name :: residual fs []
  | f :: fs, b :: bs => (if b then [] else [f.name]) ++ residual fs bs

/-- One effect's admission as a checked fragment over the store of keys. -/
def admitFrag {Ix : Type} {S : Sig Ix} {Name Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob)
    (name : Name) {i : Ix} (op : S.Op i) : Frag Name (Fact ⊕ Tok) Bool where
  name := name
  support := opSupport sp op
  check := fun w => admitOp sp (View.ofStore w) op

/-! ## Shared parameters: the completion space (doc 2 section 4) -/

/-- The four conditions on ONE completion `θ`. -/
structure Conds (Θ : Type) where
  typed : Θ → Prop
  guards : Θ → Prop
  authority : Θ → Prop
  resources : Θ → Prop

/-! ## Search state versus logical status (the matcher, doc 2 section 4) -/

/-- Greedy first-fit: each want in order takes the FIRST remaining offer that covers it; the count
of wants satisfied. -/
def firstFit : List Nat → List Nat → Nat
  | _, [] => 0
  | offers, w :: ws =>
    match offers.findIdx? (fun o => decide (w ≤ o)) with
    | some n => firstFit (offers.eraseIdx n) ws + 1
    | none => firstFit offers ws

/-- Complete search: is there an assignment of distinct offers covering every want? -/
def coverAll : List Nat → List Nat → Bool
  | _, [] => true
  | offers, w :: ws =>
    (List.range offers.length).any fun n =>
      decide (w ≤ offers.getD n 0) && coverAll (offers.eraseIdx n) ws

/-- A SCALAR ILLUSTRATION of shared parameters (the price alone is `θ`): the buyer accepts a price
at most 5, the seller at least 7. The same separation over `Subst` of the negotiation template is
`Proofs.Contextual.Negotiation.separate_witnesses_over_substitutions`. -/
def priceConds : Conds Nat where
  typed := fun _ => True
  guards := fun x => x ≤ 5
  authority := fun x => 7 ≤ x
  resources := fun _ => True

/-! ## Example: the committed bit (doc 2 section 5) -/

namespace Coin

/-- Before and after the peer reveals its bit. -/
inductive Phase
  | waiting
  | revealed
deriving DecidableEq, Repr

/-- The only operation: receive the peer's bit; nothing is available afterwards. -/
inductive Op : Phase → Type
  | recv : Op .waiting

def sig : Sig Phase where
  Op := Op
  Resp := fun | .recv => Bool
  next := fun | .recv, _ => .revealed

/-- One hole name, at `revealed`: our answer, planned before the reveal. -/
def HoleN : Phase → Type
  | .waiting => Empty
  | .revealed => Unit

abbrev Res : Phase → Type := fun _ => Bool

abbrev P := Prot sig HoleN Res

/-- The peer answers `b`. -/
def env (b : Bool) : Handler sig (fun _ => Unit) where
  handle := fun | .recv, () => ⟨b, ()⟩

/-- We win against `b` when the run ends with result `b`; a run stuck at a hole loses. The hole
names `Hn` are a parameter so that templates with different naming disciplines can be compared. -/
def wins {Hn : Phase → Type} {i : Phase} (b : Bool) (p : Prot sig Hn Res i) (s : Unit) : Bool :=
  match interpret (env b) p s with
  | .done _ a _ => a == b
  | .stuck _ _ _ => false

/-- The OPEN plan: receive, then do whatever our hole says. Its filling is chosen once. -/
def planHole : P .waiting := .call (S := sig) Op.recv fun _ => .hole (i := Phase.revealed) ()

/-- The RESPONSE-DEPENDENT plan: the continuation is a family over the response. -/
def planCall : P .waiting := .call (S := sig) Op.recv fun b => .ret b

/-- A template whose hole name may depend on the peer's bit: `name b` is the hole in branch `b`.
Response-free naming is the case `name true = name false`. -/
def planNamed {Hn : Phase → Type} (name : Bool → Hn .revealed) : Prot sig Hn Res .waiting :=
  .call (S := sig) Op.recv fun b => .hole (i := Phase.revealed) (name b)

/-- One hole name per possible bit at `revealed`. -/
def HoleB : Phase → Type
  | .waiting => Empty
  | .revealed => Bool

/-- The filling "answer `c`". -/
def answer (c : Bool) : Subst sig HoleN Res := fun
  | .waiting, h => nomatch h
  | .revealed, () => some (.ret c)

/-- The hole's interface, with polarity `p` (no facts, tokens or obligations in this game). -/
def iface (p : Polarity) : Iface sig HoleN Res Unit Unit Unit .revealed where
  pol := p
  ctx := []
  need := []
  post := fun _ _ => True
  owes := []
  accepts := fun _ => True

/-- `Ω` declaring the answer hole with polarity `p`. -/
def ctxOf (p : Polarity) : Ctx sig HoleN Res Unit Unit Unit := fun
  | .waiting, h => nomatch h
  | .revealed, () => some (iface p)

end Coin

/-! ## The integration experiment: a one-use capability, two providers, a deadline, a cancel
(doc 3). Definitions here; the theorems in `Lang.Proofs.Contextual.Negotiation`. -/

namespace Negotiation

/-- Two candidate providers. -/
inductive Provider
  | p1
/-
# Lang.Contextual.NanoBridge — nano's free program over effects as an open protocol (lane PROTOCOL)

`Hosting.Resident.Prog` (`cmd | keep | forget | ask | say`, a continuation per result) is the
instance of `Lang.Contextual.Protocol.Prot` with a trivial index (`Unit`) and no holes (`Empty`):
`ofProg` embeds a program, `toEv` reads a performed interaction as nano's trace event, `oracleH` is
nano's oracle as a deterministic environment. Definitions only; the theorems (`nano_runs_iff`,
`nano_interp_agrees`, `nano_interp_runs`) are in `Lang.Proofs.Contextual.Protocol`.
-/
import Lang.Contextual.Protocol
import Hosting.Resident.Trace

namespace Nanodregg.Lang.Contextual.Protocol.Nano

open Nanodregg.Hosting Nanodregg.Hosting.Resident

/-- Nano's five effects as operation shapes. -/
inductive NOp
  | cmd (c : Cmd)
  | keep (r : Ring) (t : ByteArray)
  | forget
  | ask (r : Ring) (q : Broker.Ask)
  | say (s : String)

/-- Each effect's result type, as `Prog`'s continuations take it. -/
def NOp.Resp : NOp → Type
  | .cmd _ => Except String Reply
  | .keep _ _ => Bool
  | .forget => Bool
  | .ask _ _ => AskEnd
  | .say _ => Unit

/-- The trivially indexed signature of nano's effects. -/
def sig : Sig Unit where
  Op := fun _ => NOp
  Resp := fun op => NOp.Resp op
  next := fun _ _ => ()

/-- A nano program as an open protocol without holes. -/
def ofProg {α : Type} : Prog α → Prot sig (fun _ => Empty) (fun _ => α) ()
  | .done a => .ret a
  | .cmd c k => .call (S := sig) (NOp.cmd c) fun x => ofProg (k x)
  | .keep r t k => .call (S := sig) (NOp.keep r t) fun b => ofProg (k b)
  | .forget k => .call (S := sig) NOp.forget fun b => ofProg (k b)
  | .ask r q k => .call (S := sig) (NOp.ask r q) fun x => ofProg (k x)
  | .say s k => .call (S := sig) (NOp.say s) fun _ => ofProg k

/-- A performed interaction as nano's trace event. -/
def toEv : Entry sig → Ev
  | ⟨_, op, r⟩ => match op, r with
    | .cmd c, x => .cmd c x
    | .keep r t, b => .keep r t b
    | .forget, b => .forget b
    | .ask r q, x => .ask r q x
    | .say s, _ => .say s

/-- The oracle as a deterministic environment whose state is the call counter. -/
def oracleH (o : Oracle) : Handler sig (fun _ => Nat) where
  handle := fun op n => match op with
    | .cmd _ => ⟨o.cmd n, n + 1⟩
    | .keep _ _ => ⟨o.keep n, n + 1⟩
    | .forget => ⟨o.forget n, n + 1⟩
    | .ask _ _ => ⟨o.ask n, n + 1⟩
    | .say _ => ⟨(), n + 1⟩

end Nanodregg.Lang.Contextual.Protocol.Nano
## LANG-67 Open protocols as typed families of continuations: holes with polarity, linear tokens, obligations, the executed prefix, and the two-cell one-use-capability negotiation; nano's `interp_runs` re-derived as an instance (2026-10-22; ACTIVITIES-1; `redregg/work/ACTIVITIES-DESIGN-20261022.md` §9.4)
**Why.** Ember: "the GPT design discussed repair and open protocols, which seems like a natural way to express the sort of
smart-contract system this is." The proposal's doc 2: an open protocol as a typed, inspectable family of continuations
with explicit obligations for making a particular continuation executable; three kinds of openness (an unspecified
component, an interaction with an environment, an unfinished execution), polarity and causality, shared parameters,
the executed prefix; doc 3's first integration experiment.
**Decision.** `Lang/Contextual/Protocol.lean` (757 lines) + `Lang/Contextual/NanoBridge.lean` (66; the resident `Prog` read as a
protocol) and `Lang/Proofs/Contextual/{ProtocolTyping,Protocol,Negotiation}.lean` (132 + 961 + 474; the judgments
`HasProt`, `Started`, `Dispatched`, `Open.WF`, `Assigns`… in `ProtocolTyping`, a proof module, per the gate's def/proof split),
one `lang:`; no wire moves, no package re-ids, no re-genesis.
1. *The object.* An indexed signature `Sig {Op, Resp, next}` and the free protocol `Prot := ret | call op k | hole h`:
   a `call` branches over EVERY response (`k : (r : Resp op) → Prot (next op r)`, the interaction with an environment);
   a `hole` is an unspecified component named in an interface list Ω (polarity `ours | theirs`, acceptor, context, the
   tokens it needs, its result condition, the obligations it owes, an acceptance contract). A `Spec` says per operation
   what it consumes (a linear token), requires (reusable facts) and establishes (obligations). The judgment
   `Ω;Γ;Δ ⊢ P ⊣ Φ` is `HasProt sp Ω Γ Q Φ Δ P`: Δ a BAG of tokens, a `spend` removes one for every continuation; Φ an
   UPPER BOUND on what any path establishes (a call branches, so Φ cannot be an output). History `Hist` = the answered
   calls plus at most one call in flight; `Started`, `Dispatched` (the history has ENTERED a hole). The open object
   `Open` = template, Ω, σ, Γ, Δ, Q, Φ, history; `Open.replan` is a plain setter and `Open.Replan` (a statement) its guard:
   the theorems that re-plan take the guard as a hypothesis. Admission (`admits`) is SEPARATE from typing: it checks only the next effect against the current world,
   and a hole admits nothing.
2. *The four families, proved.* Contextual completion: `fill_preserves_hasProt`, `fill_skips_theirs`,
   `theirs_hole_untypable`, `HasProt.weaken`, `mem_holes_iff`. Interpretation of substitution: `fold_fusion`,
   `fold_subst`, `interpret_fill` (running P[σ] = running the template with σ in the environment), `interpret_record`
   (the recording run appends exactly a complete path, or exactly the prefix to the hole where it stopped). Selective
   repair: `locality`, `repair_agrees_from_scratch`, `repair_residual` (the leftover obligations named),
   `repair_reuses` (only the affected fragments are read). Admission and history: `hasProt_reach` (along any prefix,
   tokens spent stay within Δ, obligations within Φ, the remainder still judged), `at_most_once` (a token held once is
   spent at most once on every path; the discipline is AFFINE: `ret` accepts any leftover Δ), `resubst_preserves_started`/`Open.resubst_wf` (re-filling holes the history has
   not entered keeps the history and its obligations), `admits_local`, `commit_once`.
3. *Polarity and causality, proved.* `no_foresight`: for every peer bit some filling wins, but no single filling chosen
   before the reveal wins against every bit; `response_dependent_succeeds`: the same game as a `call` continuation wins
   against every bit; `theirs_never_planned`; `foresight_iff_names_separate` (∃θ∀b wins ↔ the hole's name differs across the response),
   `response_indexed_names_have_foresight`. So a hole is NOT an interaction when its NAME does not depend on the response: one filling then enters every response
   branch unchanged. The reader found the general claim FALSE: with response-indexed hole names (`HoleN .revealed := Bool`)
   θ(b) := ret b wins every bit (`response_indexed_names_have_foresight`), so the separation is a NAMING discipline the
   template must obey, stated as such, not a fact of the calculus.
4. *Shared parameters and search.* `separate_witnesses_insufficient` (buyer ≤ 5, seller ≥ 7: each satisfiable, no
   shared price; `witnesses_do_not_compose` general, `separate_witnesses_bounded` decided), `greedy_vs_logical`
   (first-fit scores 1 of 2; complete search finds [1,0]; by decide), `search_state_ne_logical_status` (scalar illustrations); and over the template itself
   `separate_witnesses_over_substitutions` (Θ := Subst over the Negotiation template in the world with p1 revoked: the
   buyer guard and admission each satisfiable, no completion satisfies all).
5. *The integration experiment* (`Negotiation.lean`): two parties, a one-use capability, alternative providers, a
   deadline, a cancellation path. (a) `unrelated_update_keeps_plan` (via `admits_local`), `unrelated_update_repair_reuses`;
   (b) `provider_revoked_unavailable` (available [1,2,3] → [2,3]; `plan p1` still derivable, not admissible; the template
   still judged; `revocation_repair` residual [1]); (c) `representation_change_transports` (epoch : Nat, a PARTIAL correspondence `Tok'.current`; `stale_opening_refused`: an
   opening at another epoch is refused);
   (d) `competing_commitments`, `replay_refused`, `internal_once_not_external_once` (one spent token is consistent
   with 0, 1 or 2 external executions), `exactly_once_needs_reply_and_dedupe`; `deadline_expires`,
   `cancel_path_refunds_obligation` (`commit_path_pays` the contrast); `lost_reply_keeps_obligation`,
   `lost_reply_blocks_replan` (an unguarded `replan` after dispatch fails `WF` and `Replan` refuses it, to the other provider
   and to the cancel path), `answered_blocks_replan` (the answered half), `guard_stricter_than_wf` (a filling with the same
   first call keeps WF but `Replan` refuses it: the guard is sufficient, and stricter than WF needs), `replan_before_dispatch`;
   `internal_once_not_external_once` and `exactly_once_needs_reply_and_dedupe` over `Internal.ofHist` of `lost p`, `H₀`,
   `answeredH p b` (the delivery model linked to the history).
6. *The nano bridge.* `Hosting.Resident.Prog` is the instance with a trivial index and no holes (`Nano.ofProg`, `toEv`):
   `nano_runs_iff` (nano's `Runs p es a` iff `ofProg p` has a `Runs` path reading as `es`), `nano_interp_agrees`
   (nano's `Prog.interp (recorder o)` = this `interpret` at the oracle environment), `nano_interp_runs` (HOSTING-37's
   `interp_runs`, RE-DERIVED from `interpret_record`). So the resident's proved continuation structure IS a protocol,
   and the protocol theory's statements apply to it.
**What formalizing corrected in the prose.** (1) Φ "the obligations for a particular completion" is not an output of
the judgment (a call branches over every response): Φ is an upper bound; and a call's obligation starts at DISPATCH,
not at the reply (the lost-reply case makes sense only so). (2) Polarity does not capture causality; SCOPE does, and scope is the
template's hole NAMING (response-independent names), which the theory must state and the reader made it state;
`theirs_hole_untypable`/`fill_skips_theirs` are this calculus's own rules (a `theirs` hole is a `call`), not findings;
"who must accept" is a contract predicate on the filling.
(3) "Replacing an unexecuted component preserves the history" needs ENTERED, not executed: not reached / reached but
re-plannable (`replan_before_dispatch`) / entered (a call performed or in flight), which cannot be re-planned, not even
to the cancel path (`lost_reply_blocks_replan`).
**Price.** No landed theorem gains a premise; no landed statement changes. New modules only. The bridge imports
`Hosting.Resident.Run` into a Lang def module (a cross-lib import of a deployed module; C9 allows it).
**Not in this landing, by name.** `fold_rel` (mini's logical-relation fold) not restated; `Consistent`/`External` are this
module's own delivery and deduplication model (the proposal gives none), so the external-once theorems hold relative to
it; multi-WRITER agreement over a hole stays out (charter item 3: the two parties are two members of one World).
**Alternatives.** (i) Holes carrying their interface in the node (refused: substitution would need casts; Ω by name, indexed
by `Ix`, needs none). (ii) Φ as an output of the judgment (refused: ill-defined under branching). (iii) A `theirs` hole as
a freely instantiable existential (refused by `no_foresight`: it would give the planner foresight no participant has).
**Critique.** (0) The gate's split moved "no unguarded re-plan" from the operation's TYPE (`resubst` took its guard as a
proof argument, which mentions the statement `Dispatched`, so a def module cannot hold it) to the theorems' hypotheses
(`Open.Replan`); `lost_reply_blocks_replan` is what keeps the guard load-bearing. (1) `Open.resubst_wf`'s history-equality conjunct is true by construction; the substance is the
well-formedness and the obligation bound. (2) `unrelated_update_keeps_plan`'s unrelated-store part is true by
construction (the world view never reads it); the revoke-p2 part exercises locality. (3) `holes` needs a finite listing of
each operation's responses. (4) The Coin and Negotiation instance definitions live in the def module (deployed lines).
(5) The external-once gap is a theorem of a delivery/deduplication model this module chose; the reader required it to be
linked to the history (`Internal.ofHist` from `consumed` and the answered entry, stated over `lost p` and `H₀`) or
labelled as the model's. (6) "Linear" is affine: `ret` accepts any Δ, so unused tokens are dropped; the once theorem is
at-most-once. (7) Substitution is single-pass: a filling's own holes are not filled by the same σ, so "replace an
unexecuted sub-component of an entered filling" is not expressible. (8) `Iface.acceptor` was a field nothing read (a
no-op the reader caught): DELETED; "who must accept" remains the `accepts` contract, exercised by no instance yet (named gap).
**Meta-critique.** The lane was briefed to re-cut mini's `IndexedProgram` and it did; the risk was a theory that only
restates mini. The test is the nano bridge: HOSTING-37's `interp_runs` is re-derived as an instance, so the theory says
something about code the kernel runs, which mini's `fold_fusion` never did.



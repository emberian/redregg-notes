1086: theorem msubstPL_eq (θ : Nat → Option Tm) (d : Nat) :
1087:     ∀ σ : List Tm, msubstPL θ d σ = σ.map (msubstP θ d)
1088:   | [] => rfl
1089:   | t :: σ => by simp only [msubstPL, msubstPL_eq θ d σ, List.map_cons]

107: /-! ## A renaming acts only through the variables a term uses -/
110: theorem renameVar_congr : ∀ (t : Term) (ρ ρ' : Nat → Nat),
111:     (∀ k, Term.usesVar k t = true → ρ k = ρ' k) → Term.renameVar ρ t = Term.renameVar ρ' t
112:   | .var i, ρ, ρ', h => by simp only [Term.renameVar, h i (by simp [Term.usesVar])]
113:   | .nat _, _, _, _ | .bool _, _, _, _ | .bytes _, _, _, _ | .digest _, _, _, _
114:   | .ref _, _, _, _ | .refuse _ _, _, _, _ => rfl
115:   | .lam _ b, ρ, ρ', h => by
116:     have h' : ∀ k, Term.usesVar k b = true → upR ρ k = upR ρ' k := by
151: theorem renameVarRow_congr : ∀ (fs : List (Label × Term)) (ρ ρ' : Nat → Nat),
152:     (∀ k, Term.usesVarRow k fs = true → ρ k = ρ' k) →
153:       Term.renameVarRow ρ fs = Term.renameVarRow ρ' fs
154:   | [], _, _, _ => rfl
155:   | (_, t) :: fs, ρ, ρ', h => by
156:     simp only [Term.renameVarRow,
157:       renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVarRow, hk]),
158:       renameVarRow_congr fs ρ ρ' fun k hk => h k (by simp [Term.usesVarRow, hk])]
159: theorem renameVarArms_congr : ∀ (as : List (Label × Term)) (ρ ρ' : Nat → Nat),
160:     (∀ k, Term.usesVarArms k as = true → ρ k = ρ' k) →
161:       Term.renameVarArms ρ as = Term.renameVarArms ρ' as
162:   | [], _, _, _ => rfl
163:   | (_, t) :: as, ρ, ρ', h => by
164:     have h' : ∀ k, Term.usesVar k t = true → upR ρ k = upR ρ' k := by
172: /-! ## Renaming moves occurrences only along the renaming -/
174: /-- Where an occurrence of `k` in a renamed term comes from. -/
175: def VarFrom (ρ : Nat → Nat) (k : Nat) (u : Nat → Bool) : Prop := ∃ j, u j = true ∧ ρ j = k
177: theorem VarFrom.mono {ρ : Nat → Nat} {k : Nat} {u u' : Nat → Bool}
178:     (hu : ∀ j, u j = true → u' j = true) : VarFrom ρ k u → VarFrom ρ k u'
179:   | ⟨j, hj, e⟩ => ⟨j, hu j hj, e⟩
180: 
181: mutual
182: theorem usesVar_renameVar : ∀ (t : Term) (ρ : Nat → Nat) (k : Nat),
183:     Term.usesVar k (Term.renameVar ρ t) = true → VarFrom ρ k (fun j => Term.usesVar j t)
184:   | .var i, ρ, k, h => ⟨i, by simp [Term.usesVar], by simpa [Term.renameVar, Term.usesVar] using h⟩
185:   | .nat _, _, _, h | .bool _, _, _, h | .bytes _, _, _, h | .digest _, _, _, h
186:   | .ref _, _, _, h | .refuse _ _, _, _, h => by simp [Term.renameVar, Term.usesVar] at h
187:   | .lam _ b, ρ, k, h => by
188:     obtain ⟨j, hj, e⟩ := usesVar_renameVar b (upR ρ) (k + 1) (by simpa [Term.renameVar, Term.usesVar] using h)
230: theorem usesVarRow_renameVarRow : ∀ (fs : List (Label × Term)) (ρ : Nat → Nat) (k : Nat),
231:     Term.usesVarRow k (Term.renameVarRow ρ fs) = true →
232:       VarFrom ρ k (fun j => Term.usesVarRow j fs)
233:   | [], _, _, h => by simp [Term.renameVarRow, Term.usesVarRow] at h
234:   | (_, t) :: fs, ρ, k, h => by
235:     simp only [Term.renameVarRow, Term.usesVarRow, Bool.or_eq_true] at h
236:     rcases h with h | h
237:     · exact (usesVar_renameVar t ρ k h).mono fun j hj => by simp [Term.usesVarRow, hj]
238:     · exact (usesVarRow_renameVarRow fs ρ k h).mono fun j hj => by simp [Term.usesVarRow, hj]
239: theorem usesVarArms_renameVarArms : ∀ (as : List (Label × Term)) (ρ : Nat → Nat) (k : Nat),
240:     Term.usesVarArms k (Term.renameVarArms ρ as) = true →
241:       VarFrom ρ k (fun j => Term.usesVarArms j as)
242:   | [], _, _, h => by simp [Term.renameVarArms, Term.usesVarArms] at h
243:   | (_, t) :: as, ρ, k, h => by
244:     simp only [Term.renameVarArms, Term.usesVarArms, Bool.or_eq_true] at h
245:     rcases h with h | h
246:     · obtain ⟨j, hj, e⟩ := usesVar_renameVar t (upR ρ) (k + 1) h
253: /-- **Weakening at `x` never uses `x`.** -/
254: theorem usesVar_shiftAt (x : Nat) (t : Term) : Term.usesVar x (Term.renameVar (liftIdx x) t) = false := by
262: /-- **The factorisation `t ≡ t₀[π]` at any position.** -/
263: theorem Term.shiftAt_unshiftAt {x : Nat} {t : Term} (hu : Term.usesVar x t = false) :
264:     Term.renameVar (liftIdx x) (Term.renameVar (lowerIdx x) t) = t := by
276: /-! ## Typing under renaming -/
278: theorem upR_lookup {Γ Γ' : List Lang.Ty} (A : Lang.Ty) (ρ : Nat → Nat) (u : Nat → Bool)
279:     (hρ : ∀ i B, u (i + 1) = true → Γ[i]? = some B → Γ'[ρ i]? = some B) :
280:     ∀ i B, u i = true → (A :: Γ)[i]? = some B → (A :: Γ')[upR ρ i]? = some B
281:   | 0, _, _, hB => by simpa [upR] using hB
282:   | i + 1, B, hu, hB => by simpa [upR] using hρ i B hu (by simpa using hB)

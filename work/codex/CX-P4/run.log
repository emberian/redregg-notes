279: /-! ## List substitutions -/
281: theorem ofList_nil : ofList [] = Tm.var := by funext i; rfl
283: theorem subst_nil (t : Tm) : subst [] t = t := by
286: theorem ofList_getElem? : ∀ (σ : List Tm) (i : Nat) (s : Tm), σ[i]? = some s → ofList σ i = s
287:   | [], _, _, h => by simp at h
288:   | t :: _, 0, s, h => by simpa [ofList] using h
289:   | _ :: σ, i + 1, s, h => by simpa [ofList] using ofList_getElem? σ i s (by simpa using h)

90: mutual
91: theorem rename_id : ∀ t : Tm, rename (fun i => i) t = t
92:   | .var _ => rfl
93:   | .lam A t => by simp only [rename, upR_id, rename_id t]
94:   | .app t s => by simp only [rename, rename_id t, rename_id s]
95:   | .box _ _ => rfl
96:   | .letbox t s => by simp only [rename, rename_id t, rename_id s]
97:   | .mvar u σ => by simp only [rename, renameL_id σ]
98: theorem renameL_id : ∀ σ : List Tm, renameL (fun i => i) σ = σ
99:   | [] => rfl
100:   | t :: σ => by simp only [renameL, rename_id t, renameL_id σ]
101: end

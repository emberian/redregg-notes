246: mutual
247: /-- A substitution acts only through the variables a term uses. -/
248: theorem substFn_congr :
249:     ∀ (t : Tm) (f g : Nat → Tm), (∀ k, uses k t = true → f k = g k) → substFn f t = substFn g t
250:   | .var i, f, g, h => h i (by simp [uses])
251:   | .lam A t, f, g, h => by
252:     have h' : ∀ k, uses k t = true → upS f k = upS g k := by
269: theorem substFnL_congr :
270:     ∀ (σ : List Tm) (f g : Nat → Tm), (∀ k, usesL k σ = true → f k = g k) →
271:       substFnL f σ = substFnL g σ
272:   | [], _, _, _ => rfl
273:   | t :: σ, f, g, h => by
274:     simp only [substFnL,
275:       substFn_congr t f g (fun k hk => h k (by simp [usesL, hk])),
276:       substFnL_congr σ f g (fun k hk => h k (by simp [usesL, hk]))]
277: end

291: theorem ofList_comp (τ : List Tm) :
292:     ∀ (σ : List Tm) (i : Nat), ofList (comp τ σ) i = substFn (ofList τ) (ofList σ i)
293:   | [], _ => rfl
294:   | _ :: _, 0 => rfl
295:   | _ :: σ, i + 1 => ofList_comp τ σ i

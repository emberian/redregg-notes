285: /-- **Renaming**, restricted to the variables the term uses. -/
286: theorem hasType_renameVar {Δ : List Lang.Ty} : ∀ {Γ : List Lang.Ty} {t : Term} {T : Lang.Ty},
287:     HasType Δ Γ t T → ∀ (Γ' : List Lang.Ty) (ρ : Nat → Nat),
288:       (∀ i B, Term.usesVar i t = true → Γ[i]? = some B → Γ'[ρ i]? = some B) →
289:       HasType Δ Γ' (Term.renameVar ρ t) T
290:   | _, _, _, .var h, _, _, hρ => .var (hρ _ _ (by simp [Term.usesVar]) h)
291:   | _, _, _, .lam (A := A) (b := b) hw hb, Γ', ρ, hρ =>
329: theorem renameVarFields_typed {Δ : List Lang.Ty} : ∀ {Γ : List Lang.Ty}
330:     {fs : List (Label × Term)} {r : List (Label × Lang.Ty)},
331:     FieldsTy Δ Γ fs r → ∀ (Γ' : List Lang.Ty) (ρ : Nat → Nat),
332:       (∀ i B, Term.usesVarRow i fs = true → Γ[i]? = some B → Γ'[ρ i]? = some B) →
333:       FieldsTy Δ Γ' (Term.renameVarRow ρ fs) r
334:   | _, _, _, .nil, _, _, _ => .nil
335:   | _, _, _, .cons h hs, Γ', ρ, hρ =>
336:     .cons (hasType_renameVar h Γ' ρ fun i B hu hB => hρ i B (by simp [Term.usesVarRow, hu]) hB)
337:       (renameVarFields_typed hs Γ' ρ fun i B hu hB => hρ i B (by simp [Term.usesVarRow, hu]) hB)
338: theorem renameVarArms_typed {Δ : List Lang.Ty} : ∀ {Γ : List Lang.Ty}
339:     {as : List (Label × Term)} {r : List (Label × Lang.Ty)} {B : Lang.Ty},
340:     ArmsTy Δ Γ as r B → ∀ (Γ' : List Lang.Ty) (ρ : Nat → Nat),
341:       (∀ i C, Term.usesVarArms i as = true → Γ[i]? = some C → Γ'[ρ i]? = some C) →
342:       ArmsTy Δ Γ' (Term.renameVarArms ρ as) r B
343:   | _, _, _, _, .one (A := A) (b := b) h, Γ', ρ, hρ =>
358: /-- **Strengthening at any position.** -/
359: theorem hasType_unshiftAt {Δ Γ : List Lang.Ty} {t : Term} {T : Lang.Ty} {x : Nat}
360:     (h : HasType Δ Γ t T) (hu : Term.usesVar x t = false) :
361:     HasType Δ (Γ.eraseIdx x) (Term.renameVar (lowerIdx x) t) T := by
370: /-- A closed term is typed under every library and every context. -/
371: theorem hasType_closed_lift {M : Term} {A : Lang.Ty} (h : HasType [] [] M A)
372:     (Δ' Γ : List Lang.Ty) : HasType Δ' Γ M A := by
378: /-! ## Holes: the `ref`s a term uses -/
380: /-- `t` uses ref `n` only if `t`'s sub-term-or-row does; the shape every compound case lifts. -/
381: abbrev RefsSub (s t : Nat → Bool) : Prop := ∀ n, s n = true → t n = true
384: /-- A typed term's refs are declared in its library. -/
385: theorem hasType_usesRef {Δ : List Lang.Ty} : ∀ {Γ : List Lang.Ty} {t : Term} {T : Lang.Ty},
386:     HasType Δ Γ t T → ∀ n, Term.usesRef n t = true → (Δ[n]?).isSome = true
387:   | _, _, _, .ref h, n, hn => by
388:     simp only [Term.usesRef, beq_iff_eq] at hn; subst hn; simp [h]
389:   | _, _, _, .var _, _, hn | _, _, _, .nat _, _, hn | _, _, _, .bool, _, hn
390:   | _, _, _, .bytes _, _, hn | _, _, _, .digest _, _, hn | _, _, _, .refuse _ _, _, hn => by
391:     simp [Term.usesRef] at hn
392:   | _, _, _, .lam _ h, n, hn => hasType_usesRef h n (by simpa [Term.usesRef] using hn)
393:   | _, _, _, .fix h, n, hn => hasType_usesRef h n (by simpa [Term.usesRef] using hn)
394:   | _, _, _, .get h _, n, hn => hasType_usesRef h n (by simpa [Term.usesRef] using hn)
395:   | _, _, _, .inj _ _ h, n, hn => hasType_usesRef h n (by simpa [Term.usesRef] using hn)
396:   | _, _, _, .app h1 h2, n, hn => by
397:     simp only [Term.usesRef, Bool.or_eq_true] at hn
398:     rcases hn with hn | hn
399:     · exact hasType_usesRef h1 n hn
400:     · exact hasType_usesRef h2 n hn
401:   | _, _, _, .prim h1 h2, n, hn => by
402:     simp only [Term.usesRef, Bool.or_eq_true] at hn
403:     rcases hn with hn | hn
404:     · exact hasType_usesRef h1 n hn
405:     · exact hasType_usesRef h2 n hn
406:   | _, _, _, .record _ h, n, hn => fieldsTy_usesRef h n (by simpa [Term.usesRef] using hn)
407:   | _, _, _, .extend h _ hfs, n, hn => by
408:     simp only [Term.usesRef, Bool.or_eq_true] at hn
409:     rcases hn with hn | hn
410:     · exact hasType_usesRef h n hn
411:     · exact fieldsTy_usesRef hfs n hn
412:   | _, _, _, .case h ha, n, hn => by
413:     simp only [Term.usesRef, Bool.or_eq_true] at hn
414:     rcases hn with hn | hn
415:     · exact hasType_usesRef h n hn
416:     · exact armsTy_usesRef ha n hn
417:   | _, _, _, .ite h1 h2 h3, n, hn => by
418:     simp only [Term.usesRef, Bool.or_eq_true] at hn
419:     rcases hn with (hn | hn) | hn
420:     · exact hasType_usesRef h1 n hn
421:     · exact hasType_usesRef h2 n hn
422:     · exact hasType_usesRef h3 n hn
423: theorem fieldsTy_usesRef {Δ : List Lang.Ty} : ∀ {Γ : List Lang.Ty}
424:     {fs : List (Label × Term)} {r : List (Label × Lang.Ty)},
425:     FieldsTy Δ Γ fs r → ∀ n, Term.usesRefRow n fs = true → (Δ[n]?).isSome = true
426:   | _, _, _, .nil, _, hn => by simp [Term.usesRefRow] at hn
427:   | _, _, _, .cons h hs, n, hn => by
428:     simp only [Term.usesRefRow, Bool.or_eq_true] at hn
429:     rcases hn with hn | hn
430:     · exact hasType_usesRef h n hn
431:     · exact fieldsTy_usesRef hs n hn
432: theorem armsTy_usesRef {Δ : List Lang.Ty} : ∀ {Γ : List Lang.Ty}
433:     {as : List (Label × Term)} {r : List (Label × Lang.Ty)} {B : Lang.Ty},
434:     ArmsTy Δ Γ as r B → ∀ n, Term.usesRefRow n as = true → (Δ[n]?).isSome = true
435:   | _, _, _, _, .one h, n, hn => by
436:     simp only [Term.usesRefRow, Bool.or_eq_true, Bool.false_eq_true, or_false] at hn
437:     exact hasType_usesRef h n hn
438:   | _, _, _, _, .cons h ha _, n, hn => by
439:     simp only [Term.usesRefRow, Bool.or_eq_true] at hn
440:     rcases hn with hn | hn
441:     · exact hasType_usesRef h n hn
442:     · exact armsTy_usesRef ha n hn
443: end

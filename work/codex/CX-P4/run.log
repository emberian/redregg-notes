118: mutual
119: /-- Metavariable renaming and ordinary renaming commute. -/
120: theorem mren_rename (ρ ρ' : Nat → Nat) :
121:     ∀ t : Tm, mren ρ (rename ρ' t) = rename ρ' (mren ρ t)
122:   | .var _ => rfl
123:   | .lam A t => by simp only [mren, rename, mren_rename ρ (upR ρ') t]
124:   | .app t s => by simp only [mren, rename, mren_rename ρ ρ' t, mren_rename ρ ρ' s]
125:   | .box _ _ => rfl
126:   | .letbox t s => by
127:     simp only [mren, rename, mren_rename ρ ρ' t, mren_rename (upR ρ) ρ' s]
128:   | .mvar u σ => by simp only [mren, rename, mrenL_renameL ρ ρ' σ]
129: theorem mrenL_renameL (ρ ρ' : Nat → Nat) :
130:     ∀ σ : List Tm, mrenL ρ (renameL ρ' σ) = renameL ρ' (mrenL ρ σ)
131:   | [] => rfl
132:   | t :: σ => by simp only [mrenL, renameL, mren_rename ρ ρ' t, mrenL_renameL ρ ρ' σ]
133: end

31: /-! ## Row shapes -/
33: theorem renameVarRow_ascending (ρ : Nat → Nat) :
34:     ∀ fs : List (Label × Term), Row.ascending (Term.renameVarRow ρ fs) = Row.ascending fs
35:   | [] => rfl
36:   | [_] => rfl
37:   | (a, s) :: (b, t) :: rest => by
38:       have ih := renameVarRow_ascending ρ ((b, t) :: rest)
42: theorem fillRefsRow_ascending (σ : Nat → Option Term) :
43:     ∀ fs : List (Label × Term), Row.ascending (Term.fillRefsRow σ fs) = Row.ascending fs
44:   | [] => rfl
45:   | [_] => rfl
46:   | (a, s) :: (b, t) :: rest => by
47:       have ih := fillRefsRow_ascending σ ((b, t) :: rest)
51: /-! ## Renaming composes -/
54: theorem renameVar_renameVar (ρ ρ' : Nat → Nat) : ∀ t : Term,
55:     Term.renameVar ρ (Term.renameVar ρ' t) = Term.renameVar (fun i => ρ (ρ' i)) t
56:   | .var _ | .nat _ | .bool _ | .bytes _ | .digest _ | .ref _ | .refuse _ _ => rfl
57:   | .lam _ b => by simp only [Term.renameVar, renameVar_renameVar (upR ρ) (upR ρ') b, upR_upR]
58:   | .app f a => by
59:     simp only [Term.renameVar, renameVar_renameVar ρ ρ' f, renameVar_renameVar ρ ρ' a]
60:   | .fix t => by simp only [Term.renameVar, renameVar_renameVar ρ ρ' t]
61:   | .prim _ a b => by
62:     simp only [Term.renameVar, renameVar_renameVar ρ ρ' a, renameVar_renameVar ρ ρ' b]
63:   | .record fs => by simp only [Term.renameVar, renameVarRow_renameVarRow ρ ρ' fs]
64:   | .get t _ => by simp only [Term.renameVar, renameVar_renameVar ρ ρ' t]
65:   | .extend t fs => by
66:     simp only [Term.renameVar, renameVar_renameVar ρ ρ' t, renameVarRow_renameVarRow ρ ρ' fs]
67:   | .inj _ _ t => by simp only [Term.renameVar, renameVar_renameVar ρ ρ' t]
68:   | .case t as => by
69:     simp only [Term.renameVar, renameVar_renameVar ρ ρ' t, renameVarArms_renameVarArms ρ ρ' as]
70:   | .ite c a b => by
71:     simp only [Term.renameVar, renameVar_renameVar ρ ρ' c, renameVar_renameVar ρ ρ' a,
72:       renameVar_renameVar ρ ρ' b]
73: theorem renameVarRow_renameVarRow (ρ ρ' : Nat → Nat) : ∀ fs : List (Label × Term),
74:     Term.renameVarRow ρ (Term.renameVarRow ρ' fs) = Term.renameVarRow (fun i => ρ (ρ' i)) fs
75:   | [] => rfl
76:   | (_, t) :: fs => by
77:     simp only [Term.renameVarRow, renameVar_renameVar ρ ρ' t, renameVarRow_renameVarRow ρ ρ' fs]
78: theorem renameVarArms_renameVarArms (ρ ρ' : Nat → Nat) : ∀ as : List (Label × Term),
79:     Term.renameVarArms ρ (Term.renameVarArms ρ' as) = Term.renameVarArms (fun i => ρ (ρ' i)) as
80:   | [] => rfl
81:   | (_, t) :: as => by
82:     simp only [Term.renameVarArms, renameVar_renameVar (upR ρ) (upR ρ') t, upR_upR,
83:       renameVarArms_renameVarArms ρ ρ' as]
84: end
85: 
86: mutual
87: theorem renameVar_id : ∀ t : Term, Term.renameVar (fun i => i) t = t
88:   | .var _ | .nat _ | .bool _ | .bytes _ | .digest _ | .ref _ | .refuse _ _ => rfl
89:   | .lam _ b => by simp only [Term.renameVar, upR_id, renameVar_id b]
90:   | .app f a => by simp only [Term.renameVar, renameVar_id f, renameVar_id a]
91:   | .fix t => by simp only [Term.renameVar, renameVar_id t]
92:   | .prim _ a b => by simp only [Term.renameVar, renameVar_id a, renameVar_id b]
93:   | .record fs => by simp only [Term.renameVar, renameVarRow_id fs]
94:   | .get t _ => by simp only [Term.renameVar, renameVar_id t]
95:   | .extend t fs => by simp only [Term.renameVar, renameVar_id t, renameVarRow_id fs]
96:   | .inj _ _ t => by simp only [Term.renameVar, renameVar_id t]
97:   | .case t as => by simp only [Term.renameVar, renameVar_id t, renameVarArms_id as]
98:   | .ite c a b => by simp only [Term.renameVar, renameVar_id c, renameVar_id a, renameVar_id b]
99: theorem renameVarRow_id : ∀ fs : List (Label × Term), Term.renameVarRow (fun i => i) fs = fs
100:   | [] => rfl
101:   | (_, t) :: fs => by simp only [Term.renameVarRow, renameVar_id t, renameVarRow_id fs]
102: theorem renameVarArms_id : ∀ as : List (Label × Term), Term.renameVarArms (fun i => i) as = as
103:   | [] => rfl
104:   | (_, t) :: as => by simp only [Term.renameVarArms, upR_id, renameVar_id t, renameVarArms_id as]
105: end

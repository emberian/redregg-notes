297: /-- **Composition.** `comp τ σ` is the composite of the two list substitutions, for every
298: term (no scoping premise: a list denotes itself followed by the shifted identity). -/
299: theorem subst_comp (τ σ : List Tm) (t : Tm) : subst τ (subst σ t) = subst (comp τ σ) t := by
303: /-! ## Typing: renaming, weakening, modal weakening -/
305: /-- **Renaming**, restricted to the variables the term uses: a renaming that preserves the type
306: of every USED variable preserves typing. -/
307: theorem hasTy_rename {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A) :
308:     ∀ (Γ' : Ctx) (ρ : Nat → Nat),
309:       (∀ i B, uses i t = true → Γ[i]? = some B → Γ'[ρ i]? = some B) →
310:       HasTy Δ Γ' (rename ρ t) A := by
347: /-- **Weakening** by one ordinary hypothesis (the new variable is index 0). -/
348: theorem hasTy_weaken {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A) (B : Ty) :
349:     HasTy Δ (B :: Γ) (rename Nat.succ t) A :=
352: /-- Weakening at the outer end of the context needs no renaming. -/
353: theorem hasTy_weaken_append {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A)
354:     (Γ'' : Ctx) : HasTy Δ (Γ ++ Γ'') t A := by
360: /-- **Metavariable renaming** preserves typing when it preserves every declaration. -/
361: theorem hasTy_mren {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A) :
362:     ∀ (Δ' : MEnv) (ρ : Nat → Nat), (∀ v P, Δ v = some P → Δ' (ρ v) = some P) →
363:       HasTy Δ' Γ (mren ρ t) A := by
389: /-- **Modal weakening** by one metavariable declaration (the new one is index 0). -/
390: theorem hasTy_mweaken {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A)
391:     (P : Ctx × Ty) : HasTy (MEnv.cons P Δ) Γ (mshift t) A :=
394: /-! ## Typing: substitution -/
396: /-- **Substitution** by a function: a substitution typing every variable of `Γ` in `Γ'`. -/
397: theorem hasTy_substFn {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A) :
398:     ∀ (Γ' : Ctx) (f : Nat → Tm), (∀ i B, Γ[i]? = some B → HasTy Δ Γ' (f i) B) →
399:       HasTy Δ Γ' (substFn f t) A := by
430: /-- **The substitution lemma**: `Δ; Γ' ⊢ σ : Γ` and `Δ; Γ ⊢ t : A` give `Δ; Γ' ⊢ [σ]t : A`. -/
431: theorem subst_lemma {Δ : MEnv} {Γ Γ' : Ctx} {σ : List Tm} {t : Tm} {A : Ty}
432:     (hσ : HasSubst Δ Γ' σ Γ) (ht : HasTy Δ Γ t A) : HasTy Δ Γ' (subst σ t) A := by
440: theorem shiftSub_length : ∀ (k n : Nat), (shiftSub k n).length = n
441:   | _, 0 => rfl
442:   | k, n + 1 => by simp [shiftSub, shiftSub_length (k + 1) n]
443: 
444: theorem shiftSub_getElem? :
445:     ∀ (k n i : Nat) (s : Tm), (shiftSub k n)[i]? = some s → i < n ∧ s = .var (k + i)
446:   | _, 0, _, _, h => by simp [shiftSub] at h
447:   | k, n + 1, 0, s, h => by simp [shiftSub] at h; exact ⟨by omega, by simp [h]⟩
448:   | k, n + 1, i + 1, s, h => by
449:     simp only [shiftSub, List.getElem?_cons_succ] at h
450:     obtain ⟨hi, hs⟩ := shiftSub_getElem? (k + 1) n i s h
453: theorem ofList_shiftSub :
454:     ∀ (k n j : Nat), j < n → ofList (shiftSub k n) j = .var (k + j)
455:   | _, 0, _, h => absurd h (Nat.not_lt_zero _)
456:   | k, n + 1, 0, _ => rfl
457:   | k, n + 1, j + 1, h => by
458:     show ofList (shiftSub (k + 1) n) j = _
459:     rw [ofList_shiftSub (k + 1) n j (by omega)]; congr 1; omega
460: 
461: /-- The shifted identity `[var |Γ₀|, …]` is a substitution from `Γ₀ ++ Γ` for `Γ`. -/
462: theorem hasSubst_shiftSub (Δ : MEnv) (Γ₀ Γ : Ctx) :
463:     HasSubst Δ (Γ₀ ++ Γ) (shiftSub Γ₀.length Γ.length) Γ := by
469: /-- **The identity substitution** is well typed: `Δ; Γ ⊢ id : Γ`. -/
470: theorem hasSubst_id (Δ : MEnv) (Γ : Ctx) : HasSubst Δ Γ (idSub Γ.length) Γ :=
473: /-- The projection `π` is well typed: `Δ; Γ', A ⊢ π : Γ'`. -/
474: theorem hasSubst_proj (Δ : MEnv) (A : Ty) (Γ' : Ctx) :
475:     HasSubst Δ (A :: Γ') (proj Γ'.length) Γ' :=
478: /-! ## Typing: metavariable substitution -/
480: theorem MEnv.cons_insert (Q P : Ctx × Ty) (k : Nat) (Δ : MEnv) :
481:     MEnv.cons Q (MEnv.insert k P Δ) = MEnv.insert (k + 1) P (MEnv.cons Q Δ) := by
494: theorem MEnv.cons_eq_insert (P : Ctx × Ty) (Δ : MEnv) : MEnv.cons P Δ = MEnv.insert 0 P Δ := by
497: /-- Metavariable substitution at any depth: the declaration `(Ψ, A)` sits at index `k` of the
498: environment, and `s : A` under `Ψ` in the environment with it removed. -/
499: theorem hasTy_msubst_gen {Δ : MEnv} {Γ : Ctx} {t : Tm} {B : Ty} (h : HasTy Δ Γ t B) :
500:     ∀ (k : Nat) (Δ₀ : MEnv) (Ψ : Ctx) (A : Ty) (s : Tm), Δ = MEnv.insert k (Ψ, A) Δ₀ →
501:       HasTy Δ₀ Ψ s A → HasTy Δ₀ Γ (msubst s k t) B := by
540: /-- **The metavariable substitution lemma**: `Δ; Ψ ⊢ s : A` and `Δ, u::(Ψ ⊢ A); Γ ⊢ t : B`
541: give `Δ; Γ ⊢ ⟦Ψ.s/u⟧t : B`. -/
542: theorem msubst_lemma {Δ : MEnv} {Γ Ψ : Ctx} {s t : Tm} {A B : Ty}
543:     (hs : HasTy Δ Ψ s A) (ht : HasTy (MEnv.cons (Ψ, A) Δ) Γ t B) : HasTy Δ Γ (msubst s 0 t) B :=
546: /-! ## Scoping and strengthening -/
548: /-- A typed term uses only variables of its context. -/
549: theorem hasTy_uses_lt {Δ : MEnv} {Γ : Ctx} {t : Tm} {A : Ty} (h : HasTy Δ Γ t A) :
550:     ∀ k, uses k t = true → k < Γ.length := by
577: /-- **Strengthening, as a factorisation through the projection.** A term typed under `Γ', A`
578: that never uses the variable of `A` is the projection `π : Γ', A ⊢ π : Γ'` applied to a term
579: typed under `Γ'`: a conditional derivation survives the loss of a hypothesis it did not use. -/
580: theorem strengthen {Δ : MEnv} {Γ' : Ctx} {A B : Ty} {t : Tm}
581:     (h : HasTy Δ (A :: Γ') t B) (hu : uses 0 t = false) :
582:     ∃ t₀, HasTy Δ Γ' t₀ B ∧ t = subst (proj Γ'.length) t₀ := by
599: /-! ## Building substitutions -/
601: theorem hasSubst_nil (Δ : MEnv) (Γ : Ctx) : HasSubst Δ Γ [] [] :=
604: theorem hasSubst_cons {Δ : MEnv} {Γ Ψ : Ctx} {s : Tm} {σ : List Tm} {A : Ty}
605:     (hs : HasTy Δ Γ s A) (hσ : HasSubst Δ Γ σ Ψ) : HasSubst Δ Γ (s :: σ) (A :: Ψ) := by
615: /-! ## Teeth: the box closes its body over `Ψ` alone -/
617: /-- **A box cannot capture the ambient context.** A box whose body is a variable pointing past
618: `Ψ` has no type, whatever the ambient `Γ` holds at that index. -/
619: theorem box_cannot_capture {Δ : MEnv} {Γ Ψ : Ctx} {k : Nat} (hk : Ψ.length ≤ k) (T : Ty) :
620:     ¬ HasTy Δ Γ (.box Ψ (.var k)) T := by
627: /-- **The ambient context is irrelevant to a box**: a box typed under one ambient context is typed
628: under every other. The general fact behind `box_cannot_capture`. -/
629: theorem box_ambient_free {Δ : MEnv} {Γ Γ' Ψ : Ctx} {t : Tm} {T : Ty}
630:     (h : HasTy Δ Γ (.box Ψ t) T) : HasTy Δ Γ' (.box Ψ t) T := by
634: /-- The concrete refutation: `x : base ⊢ box [] x` is ill typed at every type, though `x` itself
635: is typed at `base` in the same context, and the same body is typed once `Ψ` declares it. -/
636: theorem box_cannot_capture_toy :
637:     (∀ T, ¬ HasTy MEnv.nil [.base] (.box [] (.var 0)) T) ∧
638:       HasTy MEnv.nil [.base] (.var 0) .base ∧
639:       HasTy MEnv.nil [.base] (.box [.base] (.var 0)) (.box [.base] .base) :=
642: /-! ## Teeth: inspection is blocked at a metavariable (Layered MTT §5.2) -/
644: /-- An ordinary substitution never unblocks a metavariable occurrence: whatever `f` substitutes

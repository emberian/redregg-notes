547: /-! ## Filling preserves typing -/
550: /-- **Filling the declared refs preserves typing**: the library `Δ` gives every declared ref
551: its declared type `τ`; a filled ref is replaced by a filling of that type; an unfilled one keeps
552: its type in `Δ'`. -/
553: theorem fillRefs_typed {Δ Δ' : List Lang.Ty}
554:     (τ : Nat → Option Lang.Ty) (σ : Nat → Option Term)
555:     (hΔ : ∀ n A, τ n = some A → Δ[n]? = some A)
556:     (hσ : ∀ n M A, σ n = some M → τ n = some A → ∀ Γ : List Lang.Ty, HasType Δ' Γ M A)
557:     (hΔ' : ∀ n A, σ n = none → τ n = some A → Δ'[n]? = some A) : ∀ {Γ : List Lang.Ty} {t : Term} {T : Lang.Ty}, HasType Δ Γ t T →
558:     (∀ n, Term.usesRef n t = true → (τ n).isSome = true) →
559:       HasType Δ' Γ (Term.fillRefs σ t) T
560:   | Γ, _, _, .ref (i := i) h, hR => by
606: theorem fillRefsFields_typed {Δ Δ' : List Lang.Ty}
607:     (τ : Nat → Option Lang.Ty) (σ : Nat → Option Term)
608:     (hΔ : ∀ n A, τ n = some A → Δ[n]? = some A)
609:     (hσ : ∀ n M A, σ n = some M → τ n = some A → ∀ Γ : List Lang.Ty, HasType Δ' Γ M A)
610:     (hΔ' : ∀ n A, σ n = none → τ n = some A → Δ'[n]? = some A) : ∀ {Γ : List Lang.Ty} {fs : List (Label × Term)}
611:     {r : List (Label × Lang.Ty)}, FieldsTy Δ Γ fs r →
612:     (∀ n, Term.usesRefRow n fs = true → (τ n).isSome = true) →
613:       FieldsTy Δ' Γ (Term.fillRefsRow σ fs) r
614:   | _, _, _, .nil, _ => .nil
615:   | _, _, _, .cons h hs, hR =>
616:     .cons (fillRefs_typed τ σ hΔ hσ hΔ' h fun n hn => hR n (by simp [Term.usesRefRow, hn]))
617:       (fillRefsFields_typed τ σ hΔ hσ hΔ' hs fun n hn => hR n (by simp [Term.usesRefRow, hn]))
618: theorem fillRefsArms_typed {Δ Δ' : List Lang.Ty}
619:     (τ : Nat → Option Lang.Ty) (σ : Nat → Option Term)
620:     (hΔ : ∀ n A, τ n = some A → Δ[n]? = some A)
621:     (hσ : ∀ n M A, σ n = some M → τ n = some A → ∀ Γ : List Lang.Ty, HasType Δ' Γ M A)
622:     (hΔ' : ∀ n A, σ n = none → τ n = some A → Δ'[n]? = some A) : ∀ {Γ : List Lang.Ty} {as : List (Label × Term)}
623:     {r : List (Label × Lang.Ty)} {B : Lang.Ty}, ArmsTy Δ Γ as r B →
624:     (∀ n, Term.usesRefRow n as = true → (τ n).isSome = true) →
625:       ArmsTy Δ' Γ (Term.fillRefsRow σ as) r B
626:   | _, _, _, _, .one h, hR =>
627:     .one (fillRefs_typed τ σ hΔ hσ hΔ' h fun n hn => hR n (by simp [Term.usesRefRow, hn]))
628:   | _, _, _, _, .cons (b := b) (arms := a :: as) h ha _, hR =>
638: /-! ## The holes' declarations -/
640: theorem tyOf_some {Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)} {n : Nat} {A : Lang.Ty}
641:     (h : tyOf Ω n = some A) : ∃ d ∈ Ω, d.name = n ∧ d.ty = A := by
647: /-- Removing declarations of OTHER names (or none of name `n`) leaves `n`'s type alone. -/
648: theorem tyOf_filter (p : HoleDecl (List Lang.Ty) Lang.Ty → Bool) (n : Nat) :
649:     ∀ Ω : List (HoleDecl (List Lang.Ty) Lang.Ty), (∀ d ∈ Ω, d.name = n → p d = true) →
650:       tyOf (Ω.filter p) n = tyOf Ω n
651:   | [], _ => rfl
652:   | d :: Ω, h => by
653:     have ih := tyOf_filter p n Ω fun d' hd' => h d' (List.mem_cons_of_mem _ hd')
664: theorem lt_holeBound : ∀ {Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)} {d : HoleDecl (List Lang.Ty) Lang.Ty},
665:     d ∈ Ω → d.name < holeBound Ω
666:   | d' :: Ω, d, h => by
667:     simp only [holeBound, List.foldr_cons] at *
668:     rcases List.mem_cons.1 h with rfl | h
669:     · omega
670:     · have := lt_holeBound h; simp only [holeBound] at this; omega
672: theorem ΔOf_getElem? {Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)} {n : Nat} {A : Lang.Ty}
673:     (h : tyOf Ω n = some A) : (ΔOf Ω)[n]? = some A := by
678: theorem ΔOf_nil : ΔOf [] = [] := rfl
680: /-! ## The typing judgment of the instance -/
682: /-- Every `ref` the term uses is a declared hole. -/
683: def RefsDeclared (Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)) (t : Term) : Prop :=
686: /-- `Ω; Γ ⊢ t : T` for `Lang.Term`: every hole's context empty (a `ref` is a closed package
687: reference: it has no local context to substitute), every ref declared, and `t` typed by
688: `Lang.HasType` with the holes as the package types. -/
689: def LangHasTy (Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)) (Γ : List Lang.Ty) (t : Term)
690:     (T : Lang.Ty) : Prop :=
693: /-- A term typed in the empty meta-context uses no ref. -/
694: theorem refsDeclared_nil {t : Term} (h : RefsDeclared [] t) (n : Nat) : Term.usesRef n t = false := by
699: theorem langHasTy_nil_iff {Γ : List Lang.Ty} {t : Term} {T : Lang.Ty} :
700:     LangHasTy [] Γ t T ↔ HasType [] Γ t T := by
708: /-! ## The laws -/
710: /-- **The deployed term language is a lawful `Calculus`** (with closed holes). -/
711: theorem langLaws : CalculusLaws langData LangHasTy where
748: /-! ## The reach: a Lang template's holes have no hypotheses -/
750: /-- **The boundary of the closed-hole fragment.** Every hole of a template typed by `LangHasTy`
751: has the empty context (the definition's first conjunct: a Lang `ref` is a closed package reference),
752: so no hole has a token-backed hypothesis (`Iface.hyps_real` asks each hypothesis to be a real
753: variable of the hole's context). Three closure paths are therefore EMPTY on every Lang template:
754: the `strengthening` outcome (`repairSelected`'s `D.uses` branch), the alternative-by-hypothesis
755: outcome, and hypothesis-derived supports (`effSupports`' second summand). They are exercised only
756: by the CMTT instance (`cmttLaws`). -/
757: theorem langTemplate_no_hyps {E : Type} (tpl : Template langData E)
758:     (h : Template.Typed tpl LangHasTy) : ∀ I ∈ tpl.Ω, I.hyps = [] := by
767: /-! ## Toys -/
769: /-- The instance's strengthening is the real one: `t ≡ t₀[π]` with `t₀ ≠ t`. -/
770: theorem lang_strengthen_toy :
771:     langData.strengthen 1 (.app (.var 0) (.var 2)) = (.app (.var 0) (.var 1) : Term) ∧
772:       langData.weaken 1 (langData.strengthen 1 (.app (.var 0) (.var 2))) =
773:         (.app (.var 0) (.var 2) : Term) :=
776: /-- The hole `0 :: [· ⊢ nat → nat]`. -/
777: private def natHole : HoleDecl (List Lang.Ty) Lang.Ty := ⟨0, [], .fn .nat .nat⟩
779: /-- The template `(ref 0) 3`. -/
780: private def natTemplate : Term := .app (.ref 0) (.nat 3)
782: /-- The filling `ref 0 := λx. x`. -/
783: private def natFill : Nat → Option Term := fun n => if n = 0 then some (.lam .nat (.var 0)) else none
785: /-- The template is typed WITH the hole and NOT without it; filled, it computes to `(λx.x) 3` and
786: is typed with the hole gone, through `langLaws.msubst_lemma`. -/
787: theorem lang_template_toy :
788:     LangHasTy [natHole] [] natTemplate .nat ∧
789:       ¬ LangHasTy [] [] natTemplate .nat ∧
790:       langData.msubst natFill natTemplate = .app (.lam .nat (.var 0)) (.nat 3) ∧
791:       LangHasTy [] [] (langData.msubst natFill natTemplate) .nat := by


/-
# nanodregg — the one build (owner: BUILD-GATES; every layer adds its own `lean_lib`).

The file is a table, not a program: gates/tree.py reads it with a strict grammar and refuses any
top-level form it does not know (closure C0). The forms are
  * `package nanodregg where leanOptions := …` — warnings are errors, no auto-bound implicits;
  * `@[default_target] lean_lib X where globs := #[.submodules `X]` — one per layer directory,
    every file in X/ built, no umbrella module, no orphan (C1);
  * `@[default_target] lean_exe «name» where root := `M` — M holds only `main` (C7);
  * `extern_lib «ndhost»` — every Host/c/*.c, cc -Wall -Wextra -Werror, into libndhost.a. The only
    C in the tree; built from source, never a prebuilt object (ROOT ruling 2026-10-16).
No packages: Lean core and Std only (decisions/gates.md GATES-1). A bare `lake build` builds
every target, so it can never succeed by building nothing.
-/
import Lake
open Lake DSL System

package nanodregg where
  leanOptions := #[⟨`autoImplicit, false⟩, ⟨`relaxedAutoImplicit, false⟩, ⟨`warningAsError, true⟩]

-- The axiom census command (Census.Axioms): build tooling, the only place `import Lean` is
-- allowed; nothing outside Census may import it (gates/closure.py C2, C5).
@[default_target] lean_lib Census where
  globs := #[.submodules `Census]

@[default_target] lean_lib Kernel where
  globs := #[.submodules `Kernel]

@[default_target] lean_lib Protocol where
  globs := #[.submodules `Protocol]

@[default_target] lean_lib Host where
  globs := #[.submodules `Host]

@[default_target] lean_lib Lang where
  globs := #[.submodules `Lang]

@[default_target] lean_lib Codec where
  globs := #[.submodules `Codec]

@[default_target] lean_lib Hosting where
  globs := #[.submodules `Hosting]

-- LEDGER: packages over the ledger receivers (the escrow), their proofs and their journey.
@[default_target] lean_lib Ledger where
  globs := #[.submodules `Ledger]

-- HOSTING's grain lifecycle through KERNEL's receivers, with its plants (standing's sim stage).
@[default_target] lean_exe «hosting-sim» where
  root := `Hosting.Sim.Main

-- HOSTING's controller: follows one Store (Host.Tail), writes Hosting.Wire actions to grain-launch.
@[default_target] lean_exe «hosting-controller» where
  root := `Hosting.Main

-- One Lean-planned launch for launcher/tests/isolation.rs (a stand-in controller without a Store).
@[default_target] lean_exe «hosting-drive» where
  root := `Hosting.DriveMain

-- HOSTING's provider-key broker decider: keybroker's child, every ask decided by Hosting.Broker.
@[default_target] lean_exe «hosting-broker» where
  root := `Hosting.BrokerMain

-- nd-members' decider (HOSTING-33): the World's resident grains, nothing else (no clock, no key slots).
@[default_target] lean_exe «hosting-residents» where
  root := `Hosting.ResidentsMain

-- THE BAR's hosted Hermes (HOSTING-27): a resident grain's program; answers its bell through its
-- member socket with what keybroker answers on its broker socket.
@[default_target] lean_exe «resident» where
  root := `Hosting.Resident.Main


-- The Rust copy of the protocol table (client/src/generated.rs). Imports Protocol; nothing imports it.
@[default_target] lean_lib Emit where
  globs := #[.submodules `Emit]

@[default_target] lean_exe «emit-rust» where
  root := `Emit.Main

-- The Rust copy of HOSTING frames (launcher/src/generated.rs). Imports Hosting.Wire; nothing imports it.
@[default_target] lean_exe «emit-hosting» where
  root := `Emit.HostingMain

-- The Rust copy of the broker frames (launcher/src/broker_generated.rs). Imports Hosting.BrokerWire.
@[default_target] lean_exe «emit-broker» where
  root := `Emit.BrokerMain

-- The provider leaf-key pins keybroker ships with (deploy/tls/pins, HOSTING-28). Imports Hosting.Pins.
@[default_target] lean_exe «emit-pins» where
  root := `Emit.PinsMain

-- The codec vectors (gates/codec-vectors.tsv, CODEC-28): a change of meaning under the same tag is red.
@[default_target] lean_exe «codec-vectors» where
  root := `Emit.VectorsMain

-- KERNEL's seeded simulation: `kernel-sim SEED…` (or `--seeds N`), ends `ALL PASS` (standing.sh).
@[default_target] lean_exe «kernel-sim» where
  root := `Kernel.Sim.Main

-- LEDGER's escrow through KERNEL's receivers, with its plants (standing's sim stage); --write-text
-- rewrites world/escrow/Escrow.
@[default_target] lean_exe «ledger-sim» where
  root := `Ledger.Sim.Main

-- LANG's first law end to end: install → create → invoke through KERNEL's receivers.
@[default_target] lean_exe «lang-journey» where
  root := `Lang.Journey.Main

-- LANG's resident check: `ob FORM` reads, checks, prints bytes and id, evaluates, runs a law;
-- no admission (Lang.Resident).
@[default_target] lean_exe «ob» where
  root := `Lang.Resident.Main

-- PROTOCOL's conformance rows: `rows [NAME…]` (rows/run, standing's rows stage), ends `ALL PASS`.
@[default_target] lean_exe «rows» where
  root := `Protocol.Rows.Main

-- Host/c/*.c: the Store's physical IO (Host.File's externs) and a Unix socket's client end (Host.Sock's). Sorted, so the archive is reproducible.
extern_lib «ndhost» pkg := do
  let dir := pkg.dir / "Host" / "c"
  let srcs := (← dir.readDir).filter (·.path.extension == some "c") |>.map (·.path)
    |>.qsort (·.toString < ·.toString)
  let leanInc := (← getLeanIncludeDir).toString
  let objs ← srcs.mapM fun src => do
    let o := pkg.buildDir / "c" / ((src.withExtension "o").fileName.getD "x.o")
    buildO o (← inputTextFile src) #["-I", leanInc] #["-fPIC", "-O2", "-Wall", "-Wextra", "-Werror"]
      "cc" getLeanTrace
  buildStaticLib (pkg.staticLibDir / nameToStaticLib "ndhost") objs

-- The Host's loop end to end over the in-memory disk, with the crash plants (standing: seeds 1 2 3).
@[default_target] lean_exe «host-sim» where
  root := `Host.Sim.Main

-- The deployed Host: `host genesis|serve|follow STORE …` (Host.Cli); the client runs the binary.
@[default_target] lean_exe «host» where
  root := `Host.Main

-- PERF: tools over a real Store the deployed host wrote (tooling; nothing imports Bench).
@[default_target] lean_lib Bench where
  globs := #[.submodules `Bench]

-- THE BAR's work at deployed parameters: `bench-count STORE SCRATCH [--harness-control]` (PERF-3; scripts/bar.sh runs it).
@[default_target] lean_exe «bench-count» where
  root := `Bench.CountMain

-- THE BAR's reopen at the tailMax worst cut, one sized bench row per tail shape:
-- `bench-worstcut-<shape> SCRATCH [--harness-control]` (PERF-5, PERF-12; the shared harness is Bench.WorstCut).
@[default_target] lean_exe «bench-worstcut-writes» where
  root := `Bench.WorstCutWritesMain

@[default_target] lean_exe «bench-worstcut-births» where
  root := `Bench.WorstCutBirthsMain

@[default_target] lean_exe «bench-worstcut-retires» where
  root := `Bench.WorstCutRetiresMain

@[default_target] lean_exe «bench-worstcut-rows» where
  root := `Bench.WorstCutRowsMain

-- THE BAR's reopen at the worst World, the reader's bound: `bench-worstworld SCRATCH synthetic N | honest [STATE_BYTES]` (PERF-8).
@[default_target] lean_exe «bench-worstworld» where
  root := `Bench.WorstWorldMain

-- OPS: renderers and drivers over the real `host` (nothing imports Ops).
@[default_target] lean_lib Ops where
  globs := #[.submodules `Ops]

-- The service-manager units and EXITS.md, rendered from Host.Status and Protocol.SupervisorExit: `emit-units [--check] deploy/units`.
@[default_target] lean_exe «emit-units» where
  root := `Ops.Main

-- Backup/restore plants against the real `host`: `store-plants HOST_EXE DIR`, ends `ALL PASS`.
@[default_target] lean_exe «store-plants» where
  root := `Ops.PlantsMain

-- The live harness's calls (deploy/live/): `live-calls DIR N`, the test founder's genesis args and N payloads.
@[default_target] lean_exe «live-calls» where
  root := `Ops.LiveCallsMain

-- The loop over a real Store directory (Host.Store + Host/c/file.c): lock, torn-file truncation.
@[default_target] lean_exe «host-file-sim» where
  root := `Host.Sim.FileMain

-- Host.Sock's contracts (Host/c/sock.c), driven by launcher/tests/sock.rs, which holds the peer.
@[default_target] lean_exe «host-sock-probe» where
  root := `Host.Sim.SockMain
"""gates/check.py TREE [--base-waste F] [--message F] [--changed F]
[--base-tree DIR] — every source gate, one line each, exit 1 if any is red. The build and the census are scripts/pre-push's."""
import argparse
import os
import re
import sys

import closure
import owners
import rebase
import refusals
import runs
import size
import tcb
import tree
import vectors
import waste

ap = argparse.ArgumentParser()
ap.add_argument("root")
ap.add_argument("--base-waste")
ap.add_argument("--base-tree", help="the parent tree: size rises are measured against it, and a\n                closure/refusal red the parent already had is reported as PRE-EXISTING, not red")
ap.add_argument("--message")
ap.add_argument("--owners-from", help="tree whose gates/OWNERS judges ownership (the parent)")
ap.add_argument("--changed", help="file listing the paths the commit changes (enables the owners gate)")
a, _unknown = ap.parse_known_args()  # a parent's check.py must accept a child's new flags
t = tree.read(a.root)
msg = open(a.message, encoding="utf-8").read() if a.message else ""


def has_lakefile(d):
    return any(os.path.exists(os.path.join(d, f)) for f in ("lakefile.lean", "lakefile.toml"))


def read(p):
    return open(p, encoding="utf-8").read() if p and os.path.exists(p) else None


changed = open(a.changed, encoding="utf-8").read().split() if a.changed else None


MARKER = re.compile(r"^(<{7}|>{7})(?: |$)")


def conflict_markers(root: str) -> list[str]:
    """A merge-conflict marker line (`<<<<<<< ours`, `>>>>>>> theirs`) in any file of the judged
    tree: an unresolved merge that a lane's own `git apply --3way` or `checkout -m` left in a file it
    then committed whole (4c327a7, 10-17, two decisions appended to decisions/host.md). The `=======`
    middle line is not matched: it is also a Markdown heading underline."""
    red = []
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            path = os.path.join(d, f)
            try:
                with open(path, encoding="utf-8") as fh:
                    for n, line in enumerate(fh, 1):
                        if MARKER.match(line):
                            red.append(f"{os.path.relpath(path, root)}:{n}: conflict marker {line.rstrip()[:40]!r}")
            except (UnicodeDecodeError, OSError):
                continue  # not text
    return red


def case_collisions(root: str) -> list[str]:
    """Two paths (files or directories) that differ only in case are ONE path on a case-insensitive
    disk (the Mac reader's APFS): `ops/RUNBOOK.md` silently became `Ops/RUNBOOK.md` inside the
    Lean library on 10-17 (OPS). Red by name."""
    seen: dict[str, set[str]] = {}
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        rel = os.path.relpath(d, root)
        for x in dirs + files:
            path = os.path.normpath(os.path.join(rel, x))
            seen.setdefault(path.lower(), set()).add(path)
    return [f"{' and '.join(sorted(v))} differ only in case: one path on a case-insensitive disk"
            for v in seen.values() if len(v) > 1]


results = {
    "closure": closure.check(t),
    "refusals": refusals.check(t),
    "size": size.check(t, msg, tree.read(a.base_tree) if a.base_tree and has_lakefile(a.base_tree) else None),
    "paths": case_collisions(t.root) + conflict_markers(t.root),
    "runs": runs.check(t),
    "rebase": rebase.check(t.root),
    "tcb": tcb.check(t.root),
    "vectors": vectors.check(t.root, a.base_tree if a.base_tree and has_lakefile(a.base_tree) else None),
    "waste": waste.check(read(os.path.join(t.root, "gates", "waste.tsv")) or "", read(a.base_waste), msg),
}
if changed is not None:
    src = a.owners_from if a.owners_from and os.path.exists(os.path.join(a.owners_from, "gates", "OWNERS")) else t.root
    results["owners"] = owners.check(src, changed, msg)
# Targets: a lib or exe the parent's lakefile declared and the candidate's does not is red by
# name, unless the message says `LAKE-DROP: <name>: <why>` (the toml -> lean switch must carry
# every target across).
if a.base_tree and has_lakefile(a.base_tree):
    bl = tree.lakefile(a.base_tree)
    before = {x["name"] for k in ("lean_lib", "lean_exe") for x in bl[k]}
    after = {x["name"] for k in ("lean_lib", "lean_exe") for x in t.lake[k]}
    results["targets"] = [f"lakefile dropped target {n}; needs 'LAKE-DROP: {n}: <why>'"
                          for n in sorted(before - after)
                          if not re.search(r"(?m)^LAKE-DROP:\s*" + re.escape(n) + r"\s*:\s*\S", msg)]
# A commit is refused for the reds it introduces. Reds its parent already had are printed (they
# are some layer's to fix forward, and scripts/standing.sh counts every one) but do not block an
# unrelated commit: otherwise one layer's red stops all six.
old = set()
if a.base_tree and has_lakefile(a.base_tree):
    bt = tree.read(a.base_tree)
    old = {re.sub(r":\d+", ":", r) for r in closure.check(bt) + refusals.check(bt)}
red = False
for gate, reds in results.items():
    new = []
    for r in reds:
        if gate in ("closure", "refusals") and re.sub(r":\d+", ":", r) in old:
            print(f"  {gate}: PRE-EXISTING {r}")
        else:
            print(f"  {gate}: {r}")
            new.append(r)
    print(f"{gate}: {'RED' if new else 'ok'}")
    red |= bool(new)
for w in size.WARN:
    print(f"WARN {w}")
sys.exit(1 if red else 0)
"""gates/closure.py TREE — the module-graph gate. Red on:

  C0 a lakefile.lean form tree.lakefile does not know, or a package without
     autoImplicit = false, relaxedAutoImplicit = false, warningAsError = true;
  C1 a .lean file outside a declared lib (a lib is `[[lean_lib]] name = X, globs = ["X.+"]`
     and owns exactly the directory X/), or a lib that is not rooted that way;
  C2 an import that is neither a tree module nor Init/Std (Lean only from Census);
  C3 a def-module exporting a theorem, or a proof-module (a `Proofs` path component)
     exporting a definition whose type is not `Prop`; private helpers are allowed on either
     side; statements (a declaration whose result type is Prop: `structure Checked … : Prop`,
     `inductive HasType : … → Prop`, `def P : X → Prop`) live in proof-modules, and a
     def-module exporting one is red;
  C4 a def-module importing a proof-module;
  C5 a module outside Census importing Census;
  C6 a lean_exe root that is a proof-module or not a tree module;
  C7 a lean_exe root that declares anything but `main` (logic lives in a lib module, which the
     census sees; the census skips exe roots, so two exes' `main`s never meet);
  C8 a C source outside an extern_lib's <Lib>/c directory, or an extern_lib directory that is
     not <Lib>/c of a declared lib.
  C9 a deployed def-module (neither a proof-module nor tooling, tree.Module.is_tooling)
     importing a tooling module: the size ratchet's deployed count excludes tooling, so deployed
     code may not depend on it.
  C10 a module outside Ops importing an Ops module: Ops is a renderer and driver over the
     Host/Protocol/Client tables, never an "ops utilities" hub (ROOT 10-17, OPS's request).
"""
import os
import sys

import tree


OPTIONS = ("⟨`autoImplicit, false⟩", "⟨`relaxedAutoImplicit, false⟩", "⟨`warningAsError, true⟩")


def check(t: tree.Tree) -> list[str]:
    red = [f"C0 lakefile.lean: {e}" for e in t.lake.get("errors", [])]
    for o in OPTIONS:
        if o not in t.lake.get("options", ""):
            red.append(f"C0 lakefile.lean: package leanOptions must contain {o}")
    libs = {}
    for lib in t.lake.get("lean_lib", []):
        name = lib["name"]
        if lib.get("globs") != [f"{name}.+"] or "roots" in lib:
            red.append(f"C1 lib {name}: must be rooted by globs = [\"{name}.+\"] and nothing else")
        libs[name] = lib
    for m in t.modules.values():
        if "." not in m.name:
            red.append(f"C1 {m.path}: a top-level module is an umbrella hub; put it in a layer directory")
        elif m.lib not in libs:
            red.append(f"C1 {m.path}: directory {m.lib}/ is not a declared lean_lib in lakefile.lean")
    for m in t.modules.values():
        for i in m.imports:
            root = i.split(".")[0]
            if i in t.modules:
                target = t.modules[i]
                if not m.is_proof and target.is_proof:
                    red.append(f"C4 {m.name} (def-module) imports proof-module {i}")
                if not m.is_proof and not m.is_tooling and target.is_tooling:
                    red.append(f"C9 {m.name} (deployed) imports tooling module {i}")
                if target.lib == "Ops" and m.lib != "Ops":
                    red.append(f"C10 {m.name} imports {i}: Ops renders and drives the other layers' tables, nothing depends on it")
                if target.lib == "Census" and m.lib != "Census":
                    red.append(f"C5 {m.name} imports {i}: Census is build tooling, never a dependency")
            elif root in ("Init", "Std"):
                pass
            elif root == "Lean" and m.lib == "Census":
                pass
            else:
                red.append(f"C2 {m.name} imports {i}: not a tree module and not Init/Std")
        for d in m.decls:
            if d.private or d.kind in ("example", "axiom"):
                continue  # example/axiom are refusals.py's
            if m.is_proof and d.kind in tree.DEF_KINDS and not d.is_prop:
                red.append(f"C3 {m.path}:{d.line} proof-module exports {d.kind} {d.name}")
            if not m.is_proof and d.kind in tree.DEF_KINDS and d.is_prop:
                red.append(f"C3 {m.path}:{d.line} def-module exports statement {d.kind} {d.name} (its type is "
                           f"Prop); statements belong in a Proofs module")
            if not m.is_proof and d.kind in tree.THEOREM_KINDS:
                red.append(f"C3 {m.path}:{d.line} def-module exports theorem {d.name}; "
                           f"move it to a Proofs module or make it private")
    for exe, root in t.exes.items():
        if root not in t.modules:
            red.append(f"C6 lean_exe {exe}: root {root} is not a tree module")
        elif t.modules[root].is_proof:
            red.append(f"C6 lean_exe {exe}: root {root} is a proof-module")
        else:
            others = [f"{d.kind} {d.name}" for d in t.modules[root].decls if not (d.kind == "def" and d.name == "main")]
            if others or not any(d.name == "main" for d in t.modules[root].decls):
                red.append(f"C7 lean_exe {exe}: root {root} must declare only `main` "
                           f"(found: {', '.join(others) or 'no main'})")
    cdirs = set()
    for ext in t.lake.get("extern_lib", []):
        for d in ext["cdirs"]:
            if d.split("/")[0] not in libs or d != d.split("/")[0] + "/c":
                red.append(f"C8 extern_lib {ext['name']}: {d} is not <Lib>/c of a declared lib")
            cdirs.add(d)
    for d, dirs, files in os.walk(t.root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith((".c", ".h", ".cc", ".cpp", ".m")):
                rel = os.path.relpath(os.path.join(d, f), t.root)
                if os.path.dirname(rel) not in cdirs:
                    red.append(f"C8 {rel}: C source outside every extern_lib directory")
    return red


if __name__ == "__main__":
    red = check(tree.read(sys.argv[1] if len(sys.argv) > 1 else "."))
    for r in red:
        print(r)
    print(f"closure: {'RED' if red else 'ok'} ({len(red)})")
    sys.exit(1 if red else 0)


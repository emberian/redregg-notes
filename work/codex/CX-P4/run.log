135: /-! ## Substitution meets renaming -/
138: theorem substFn_rename (f : Nat → Tm) (ρ : Nat → Nat) :
139:     ∀ t : Tm, substFn f (rename ρ t) = substFn (fun i => f (ρ i)) t
140:   | .var _ => rfl
141:   | .lam A t => by
142:     have h : (fun i => upS f (upR ρ i)) = upS (fun i => f (ρ i)) := by
150: theorem substFnL_renameL (f : Nat → Tm) (ρ : Nat → Nat) :
151:     ∀ σ : List Tm, substFnL f (renameL ρ σ) = substFnL (fun i => f (ρ i)) σ
152:   | [] => rfl
153:   | t :: σ => by simp only [renameL, substFnL, substFn_rename f ρ t, substFnL_renameL f ρ σ]
154: end

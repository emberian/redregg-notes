104: theorem mren_mren (ρ ρ' : Nat → Nat) :
105:     ∀ t : Tm, mren ρ (mren ρ' t) = mren (fun i => ρ (ρ' i)) t
106:   | .var _ => rfl
107:   | .lam A t => by simp only [mren, mren_mren ρ ρ' t]
108:   | .app t s => by simp only [mren, mren_mren ρ ρ' t, mren_mren ρ ρ' s]
109:   | .box Ψ t => by simp only [mren, mren_mren ρ ρ' t]
110:   | .letbox t s => by simp only [mren, mren_mren ρ ρ' t, mren_mren (upR ρ) (upR ρ') s, upR_upR]
111:   | .mvar u σ => by simp only [mren, mrenL_mrenL ρ ρ' σ]
112: theorem mrenL_mrenL (ρ ρ' : Nat → Nat) :
113:     ∀ σ : List Tm, mrenL ρ (mrenL ρ' σ) = mrenL (fun i => ρ (ρ' i)) σ
114:   | [] => rfl
115:   | t :: σ => by simp only [mrenL, mren_mren ρ ρ' t, mrenL_mrenL ρ ρ' σ]
116: end

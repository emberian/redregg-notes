966: theorem inferL_complete {Δ : MEnv} {Γ : Ctx} :
967:     ∀ (σ : List Tm) (Ψ : List Ty), σ.length = Ψ.length →
968:       (∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → infer Δ Γ s = some C) →
969:       inferL Δ Γ σ = some Ψ
970:   | [], [], _, _ => rfl
971:   | [], _ :: _, h, _ => by simp at h
972:   | _ :: _, [], h, _ => by simp at h
973:   | t :: σ, C :: Ψ, h, hp => by
974:     have h0 := hp 0 t C rfl rfl

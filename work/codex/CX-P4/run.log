420: /-- Decide equality of rows (record fields, case arms). -/
421: def Term.decEqRow : (fs gs : List (Label × Term)) → Decidable (fs = gs)
422:   | [], [] => isTrue rfl
423:   | (l, t) :: fs, (m, s) :: gs =>
424:     match _root_.decEq l m with
425:     | isFalse h0 => isFalse (by intro e; injection e with e0 e1; injection e0 with e0 e2; exact h0 e0)
426:     | isTrue h0 =>
427:       match Term.decEq t s with
428:       | isFalse h1 => isFalse (by intro e; injection e with e0 e1; injection e0 with e0 e2; exact h1 e2)
429:       | isTrue h1 =>
430:         match Term.decEqRow fs gs with
431:         | isFalse h2 => isFalse (by intro e; injection e with e0 e1; exact h2 e1)
432:         | isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
433:   | [], _ :: _ | _ :: _, [] => isFalse (by intro e; cases e)
434: end
435: 
436: instance Term.instDecEq : DecidableEq Term := Term.decEq
438: /-! ## Variables: renaming and occurrence -/
441: /-- Rename the free variables (`lam` and every `case` arm bind one more). -/
442: def Term.renameVar (ρ : Nat → Nat) : Term → Term
443:   | .var i => .var (ρ i)
444:   | .lam a b => .lam a (Term.renameVar (upR ρ) b)
445:   | .app f a => .app (Term.renameVar ρ f) (Term.renameVar ρ a)
446:   | .fix t => .fix (Term.renameVar ρ t)
447:   | .nat n => .nat n
448:   | .bool b => .bool b
449:   | .bytes s => .bytes s
450:   | .digest s => .digest s
451:   | .prim p a b => .prim p (Term.renameVar ρ a) (Term.renameVar ρ b)
452:   | .record fs => .record (Term.renameVarRow ρ fs)
453:   | .get t ℓ => .get (Term.renameVar ρ t) ℓ
454:   | .extend t fs => .extend (Term.renameVar ρ t) (Term.renameVarRow ρ fs)
455:   | .inj a ℓ t => .inj a ℓ (Term.renameVar ρ t)
456:   | .case t arms => .case (Term.renameVar ρ t) (Term.renameVarArms ρ arms)
457:   | .ite c a b => .ite (Term.renameVar ρ c) (Term.renameVar ρ a) (Term.renameVar ρ b)
458:   | .ref i => .ref i
459:   | .refuse T w => .refuse T w
460: /-- Fields bind nothing. -/
461: def Term.renameVarRow (ρ : Nat → Nat) : List (Label × Term) → List (Label × Term)
462:   | [] => []
463:   | (ℓ, t) :: fs => (ℓ, Term.renameVar ρ t) :: Term.renameVarRow ρ fs
464: /-- Every arm binds its payload at index 0. -/
465: def Term.renameVarArms (ρ : Nat → Nat) : List (Label × Term) → List (Label × Term)
466:   | [] => []
467:   | (ℓ, t) :: as => (ℓ, Term.renameVar (upR ρ) t) :: Term.renameVarArms ρ as
468: end
469: 
470: mutual
471: /-- Does the term use the free variable `k`? -/
472: def Term.usesVar (k : Nat) : Term → Bool
473:   | .var i => i == k
474:   | .lam _ b => Term.usesVar (k + 1) b
475:   | .app f a => Term.usesVar k f || Term.usesVar k a
476:   | .fix t => Term.usesVar k t
477:   | .nat _ | .bool _ | .bytes _ | .digest _ | .ref _ | .refuse _ _ => false
478:   | .prim _ a b => Term.usesVar k a || Term.usesVar k b
479:   | .record fs => Term.usesVarRow k fs
480:   | .get t _ => Term.usesVar k t
481:   | .extend t fs => Term.usesVar k t || Term.usesVarRow k fs
482:   | .inj _ _ t => Term.usesVar k t
483:   | .case t arms => Term.usesVar k t || Term.usesVarArms k arms
484:   | .ite c a b => Term.usesVar k c || Term.usesVar k a || Term.usesVar k b
485: def Term.usesVarRow (k : Nat) : List (Label × Term) → Bool
486:   | [] => false
487:   | (_, t) :: fs => Term.usesVar k t || Term.usesVarRow k fs
488: def Term.usesVarArms (k : Nat) : List (Label × Term) → Bool
489:   | [] => false
490:   | (_, t) :: as => Term.usesVar (k + 1) t || Term.usesVarArms k as
491: end
492: 
493: /-! ## Holes: the `ref`s -/
496: /-- Does the term use the hole (`ref`) `n`? -/
497: def Term.usesRef (n : Nat) : Term → Bool
498:   | .ref i => i == n
499:   | .var _ | .nat _ | .bool _ | .bytes _ | .digest _ | .refuse _ _ => false
500:   | .lam _ b | .fix b | .get b _ | .inj _ _ b => Term.usesRef n b
501:   | .app f a | .prim _ f a => Term.usesRef n f || Term.usesRef n a
502:   | .record fs => Term.usesRefRow n fs
503:   | .extend t fs | .case t fs => Term.usesRef n t || Term.usesRefRow n fs
504:   | .ite c a b => Term.usesRef n c || Term.usesRef n a || Term.usesRef n b
505: def Term.usesRefRow (n : Nat) : List (Label × Term) → Bool
506:   | [] => false
507:   | (_, t) :: fs => Term.usesRef n t || Term.usesRefRow n fs
508: end
509: 
510: mutual
511: /-- Fill the holes: `ref n` becomes `σ n` where that is given. Fillings are closed terms, so
512: nothing is shifted under binders. -/
513: def Term.fillRefs (σ : Nat → Option Term) : Term → Term
514:   | .var i => .var i
515:   | .lam a b => .lam a (Term.fillRefs σ b)
516:   | .app f a => .app (Term.fillRefs σ f) (Term.fillRefs σ a)
517:   | .fix t => .fix (Term.fillRefs σ t)
518:   | .nat n => .nat n
519:   | .bool b => .bool b
520:   | .bytes s => .bytes s
521:   | .digest s => .digest s
522:   | .prim p a b => .prim p (Term.fillRefs σ a) (Term.fillRefs σ b)
523:   | .record fs => .record (Term.fillRefsRow σ fs)
524:   | .get t ℓ => .get (Term.fillRefs σ t) ℓ
525:   | .extend t fs => .extend (Term.fillRefs σ t) (Term.fillRefsRow σ fs)
526:   | .inj a ℓ t => .inj a ℓ (Term.fillRefs σ t)
527:   | .case t arms => .case (Term.fillRefs σ t) (Term.fillRefsRow σ arms)
528:   | .ite c a b => .ite (Term.fillRefs σ c) (Term.fillRefs σ a) (Term.fillRefs σ b)
529:   | .ref n => (σ n).getD (.ref n)
530:   | .refuse T w => .refuse T w
531: def Term.fillRefsRow (σ : Nat → Option Term) : List (Label × Term) → List (Label × Term)
532:   | [] => []
533:   | (ℓ, t) :: fs => (ℓ, Term.fillRefs σ t) :: Term.fillRefsRow σ fs
534: end

899: theorem infer_sound :
900:     ∀ (t : Tm) (Δ : MEnv) (Γ : Ctx) (A : Ty), infer Δ Γ t = some A → HasTy Δ Γ t A
901:   | .var _, _, _, _, h => .var h
902:   | .lam B t, Δ, Γ, A, h => by

904:     obtain ⟨C, hC, rfl⟩ := h
950: theorem inferL_sound :
951:     ∀ (σ : List Tm) (Δ : MEnv) (Γ : Ctx) (Ψ : List Ty), inferL Δ Γ σ = some Ψ → HasSubst Δ Γ σ Ψ
952:   | [], Δ, Γ, Ψ, h => by
953:     simp only [inferL, Option.some.injEq] at h; subst h; exact hasSubst_nil Δ Γ
954:   | t :: σ, Δ, Γ, Ψ, h => by
955:     cases ht : infer Δ Γ t with
956:     | none => simp [inferL, ht] at h
957:     | some A =>
958:       cases hl : inferL Δ Γ σ with
959:       | none => simp [inferL, ht, hl] at h
960:       | some As =>
961:         simp only [inferL, ht, hl, Option.some.injEq] at h
962:         subst h
963:         exact hasSubst_cons (infer_sound t _ _ _ ht) (inferL_sound σ _ _ _ hl)
964: end

import Lang.Proofs.Contextual.History
import Lang.Proofs.Contextual.Stability

namespace Nanodregg.Lang.Contextual.Toy

open Nanodregg.Lang.Contextual

/-! ## The toy calculus -/

private inductive Tm where
  | lit (n : Nat)
  | var (x : Nat)
  | hole (u : Nat)
  | add (a b : Tm)
deriving DecidableEq, Repr

private abbrev Decl := HoleDecl (List Nat) Unit

/-- Scoping: variables in the context, holes declared with a context inside it. -/
private def wf (Ω : List Decl) (Γ : List Nat) : Tm → Bool
  | .lit _ => true
  | .var x => Γ.contains x
  | .hole u => Ω.any fun d => d.name == u && d.ctx.all Γ.contains
  | .add a b => wf Ω Γ a && wf Ω Γ b

private def msubst (σ : Nat → Option Tm) : Tm → Tm
  | .lit n => .lit n
  | .var x => .var x
  | .hole u => (σ u).getD (.hole u)
  | .add a b => .add (msubst σ a) (msubst σ b)

private def vars : Tm → List Nat
  | .lit _ => []
  | .var x => [x]
  | .hole _ => []
  | .add a b => vars a ++ vars b

private def eval : Tm → Option Nat
  | .lit n => some n
  | .var _ => none
  | .hole _ => none
  | .add a b => match eval a, eval b with
    | some x, some y => some (x + y)
    | _, _ => none

theorem wf_closed_mono {Ω : List Decl} {Ψ Γ : List Nat} (hsub : ∀ x ∈ Ψ, x ∈ Γ) :
    ∀ M, wf [] Ψ M = true → wf Ω Γ M = true
  | .lit _, _ => rfl
  | .var x, h => by
    simp only [wf, List.contains_iff_mem] at h ⊢
    exact hsub x h
  | .hole _, h => by simp [wf] at h
  | .add a b, h => by
    simp only [wf, Bool.and_eq_true] at h ⊢
    exact ⟨wf_closed_mono hsub a h.1, wf_closed_mono hsub b h.2⟩

theorem msubst_lemma {Ω : List Decl} {Γ : List Nat} (σ : Nat → Option Tm)
    (hσ : ∀ d ∈ Ω, ∀ M, σ d.name = some M → wf [] d.ctx M = true) :
    ∀ P, wf Ω Γ P = true → wf (Ω.filter fun d => (σ d.name).isNone) Γ (msubst σ P) = true
  | .lit _, _ => rfl
  | .var _, h => h
  | .hole u, h => by
    simp only [wf, List.any_eq_true, Bool.and_eq_true, beq_iff_eq, List.all_eq_true,
      List.contains_iff_mem] at h
    obtain ⟨d, hd, rfl, hctx⟩ := h
    cases hs : σ d.name with
    | some M =>
      simp only [msubst, hs, Option.getD_some]
      exact wf_closed_mono hctx M (hσ d hd M hs)
    | none =>
      simp only [msubst, hs, Option.getD_none, wf, List.any_eq_true, List.mem_filter,
        Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.contains_iff_mem]
      exact ⟨d, ⟨hd, by simp [hs]⟩, rfl, hctx⟩
  | .add a b, h => by
    simp only [wf, Bool.and_eq_true, msubst] at h ⊢
    exact ⟨msubst_lemma σ hσ a h.1, msubst_lemma σ hσ b h.2⟩

theorem strengthen_lemma {Ψ : List Nat} {x : Nat} :
    ∀ M, wf [] Ψ M = true → (vars M).contains x = false → wf [] (Ψ.filter (· != x)) M = true
  | .lit _, _, _ => rfl
  | .var y, h, hx => by
    simp only [wf, List.contains_iff_mem, vars, List.contains_cons, List.contains_nil,
      Bool.or_false, beq_eq_false_iff_ne] at h hx ⊢
    simp only [List.mem_filter, bne_iff_ne]
    exact ⟨h, fun he => hx (he ▸ rfl)⟩
  | .hole _, h, _ => by simp [wf] at h
  | .add a b, h, hx => by
    simp only [wf, Bool.and_eq_true, vars, List.contains_append, Bool.or_eq_false_iff] at h hx ⊢
    exact ⟨strengthen_lemma a h.1 hx.1, strengthen_lemma b h.2 hx.2⟩

theorem wf_vars {Ψ : List Nat} : ∀ M, wf [] Ψ M = true → ∀ y ∈ vars M, y ∈ Ψ
  | .lit _, _, _, hy => by simp [vars] at hy
  | .var x, h, y, hy => by
    simp only [vars, List.mem_singleton] at hy; subst hy
    simpa [wf] using h
  | .hole _, h, _, _ => by simp [wf] at h
  | .add a b, h, y, hy => by
    simp only [wf, Bool.and_eq_true] at h
    simp only [vars, List.mem_append] at hy
    rcases hy with hy | hy
    · exact wf_vars a h.1 y hy
    · exact wf_vars b h.2 y hy

theorem weaken_avoids {Ψ : List Nat} {x : Nat} :
    ∀ M, wf [] (Ψ.filter (· != x)) M = true → (vars M).contains x = false := by
  intro M h
  cases hc : (vars M).contains x
  · rfl
  · have := wf_vars M h x (by simpa using hc)
    simp at this

/-- The toy's data. Named variables: strengthening is the identity on syntax (`π = id`). -/
private abbrev ToyCalc : CalculusData where
  Ty := Unit
  Ctx := List Nat
  Tm := Tm
  tmEq := inferInstance
  msubst := msubst
  check Ψ M _ := wf [] Ψ M
  uses M x := (vars M).contains x
  drop Ψ x := Ψ.filter (· != x)
  strengthen _ M := M
  weaken _ M := M
  var := Tm.var
  lookup Ψ x := if x ∈ Ψ then some () else none

/-- The toy's typing: scoping. -/
def toyHasTy (Ω : List Decl) (Γ : List Nat) (M : Tm) (_ : Unit) : Prop := wf Ω Γ M = true

/-- The toy satisfies every law. -/
theorem toyLaws : CalculusLaws ToyCalc toyHasTy where
  msubst_lemma σ h hσ := msubst_lemma σ hσ _ h
  check_sound h := h
  check_complete h := h
  strengthen_lemma h hx := strengthen_lemma _ h hx
  strengthen_factor _ := rfl
  weaken_avoids h := weaken_avoids _ h
  hasTy_var {Ψ x _} h := by
    show (Ψ.contains x) = true
    by_cases hx : x ∈ Ψ
    · simpa using hx
    · simp [ToyCalc, hx] at h
  uses_var := by intro x; show [x].contains x = true; simp

/-! ## Fixtures: one hole `0 :: [· ⊢ ()]` in the template `0 + 1`, guard "value below n" -/

private abbrev W := World Nat
private abbrev Cl := Closure ToyCalc Nat

private def tA : Token := ⟨1, 0⟩
private def tB : Token := ⟨2, 0⟩
private def tC : Token := ⟨3, 0⟩
private def tK : Token := ⟨4, 0⟩
private def tH : Token := ⟨5, 0⟩

/-- The hole's guard: the filling has a value, below the environment's bound `n`. -/
private def valueBelow (n : Nat) (M : Tm) : Bool :=
  match eval M with
  | some v => decide (v < n)
  | none => false

private def hole0 : Iface ToyCalc Nat :=
  { name := 0, ctx := ([] : List Nat), ty := (), hyps := [], hyps_real := by simp,
    guard := valueBelow, budget := 100, chooser := 1, acceptor := 2 }

private def tpl0 : Template ToyCalc Nat where
  Γ := ([] : List Nat)
  T := ()
  P := Tm.add (.hole 0) (.lit 1)
  Ω := [hole0]
  names := List.nodup_cons.2 ⟨by simp, List.nodup_nil⟩

/-- Tokens A, B, C, K live; bound 10. -/
private def w0 : W := ⟨fun t => t == tA || t == tB || t == tC || t == tK, 10⟩

private def cand (M : Tm) (sup : List Token) (cost : Nat := 1) : Candidate ToyCalc :=
  { filling := M, supports := sup, blockers := [], cost := cost, by_ := 3, status := .verified }

private def start (tpl : Template ToyCalc Nat) (w : W) : Cl := fromScratch w tpl fun _ => []

/-! ## Observation helpers (Bool/Option views, so sessions decide) -/

private def obs : Except Refusal (W × Cl) → Option (List (List Status))
  | .ok st => some (observe st.2)
  | .error _ => none

private def sel (u : Nat) : Except Refusal (W × Cl) → Option (Option Nat)
  | .ok st => some (st.2.slot u).selected
  | .error _ => none

private def refusal : Except Refusal (W × Cl) → Option Refusal
  | .ok _ => none
  | .error r => some r

/-- An outcome's shape: (kind, hole, index or hypothesis). -/
private def code : Outcome ToyCalc → Nat × Nat × Nat
  | .kept u => (0, u, 0)
  | .replacement u j _ => (1, u, j)
  | .strengthening u x _ => (2, u, x)
  | .alternative u j => (3, u, j)
  | .suspended u _ => (4, u, 0)

private def outs (e : Edit Nat) : Except Refusal (W × Cl) → Option (List (Nat × Nat × Nat))
  | .ok st => some ((repair st.1 e st.2).2.1.map code)
  | .error _ => none

/- Guarded contextual closure: Stability. Moved without statement changes from Closure. -/
import Lang.Proofs.Contextual.Judge

namespace Nanodregg.Lang.Contextual

variable {D : CalculusData} {E : Type}
  {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}


/-! ## Stability class -/

/-- **A guard is a value guard iff its verdict is invariant under every value-preserving
replacement of the filling.** -/
theorem valueGuard_iff {V : Type} (value : D.Tm → V) (g : E → D.Tm → Bool) :
    ValueGuard value g ↔ ∀ e t t', value t = value t' → g e t = g e t' := by
  constructor
  · rintro ⟨g', hg⟩ e t t' hv
    rw [hg, hg, hv]
  · intro h
    refine ⟨fun e v => @dite _ (∃ t, value t = v) (Classical.propDecidable _)
      (fun hv => g e (Classical.choose hv)) (fun _ => false), ?_⟩
    intro e t
    have hex : ∃ t', value t' = value t := ⟨t, rfl⟩
    simp only [dif_pos hex]
    exact h e t _ (Classical.choose_spec hex).symm

/-- **Stability class** (Hu–Pientka–Schöpp: which substitutions is a result stable under). A
value guard's verdict is stable under every term map that preserves the value. -/
theorem stability_class {V : Type} (value : D.Tm → V) {g : E → D.Tm → Bool}
    (hg : ValueGuard value g) {s : D.Tm → D.Tm} (hs : ∀ t, value (s t) = value t) :
    StableUnder g s :=
  fun e t => (valueGuard_iff value g).1 hg e (s t) t (hs t)

/-- A value guard's hole judges a filling and its value-preserving image alike, provided the
checker and supports agree (the guard is the only place the filling's VALUE is read). -/
theorem judge_stable {V : Type} (value : D.Tm → V) {I : Iface D E} (hg : ValueGuard value I.guard)
    {w : World E} {c c' : Candidate D} (hv : value c'.filling = value c.filling)
    (hchk : D.check I.ctx c'.filling I.ty = D.check I.ctx c.filling I.ty)
    (hb : c'.blockers = c.blockers) (hsup : effSupports I c' = effSupports I c)
    (hcost : c'.cost = c.cost) : judge I w c' = judge I w c := by
  have hgd : I.guard w.env c'.filling = I.guard w.env c.filling :=
    (valueGuard_iff value I.guard).1 hg _ _ _ hv
  unfold judge
  rw [hchk, hgd, hb, hsup, hcost]

/-! ## Grounding: least fixpoint -/

theorem lfpIter_sound {R : List Rule} {F : Nat → Bool} :
    ∀ (n x : Nat), lfpIter R F n x = true → Derives R F x
  | 0, x, h => .fact h
  | n + 1, x, h => by
    simp only [lfpIter, Bool.or_eq_true, List.any_eq_true, Bool.and_eq_true, beq_iff_eq,
      List.all_eq_true] at h
    rcases h with h | ⟨r, hr, hx, hb⟩
    · exact lfpIter_sound n x h
    · subst hx
      exact .rule hr fun y hy => lfpIter_sound n y (hb y hy)

/-- **Grounding is well-founded.** With no live fact and every rule needing a premise, nothing is
derivable, however the rules cycle. -/
theorem no_facts_no_derivation {R : List Rule} {F : Nat → Bool} (hF : ∀ x, F x = false)
    (hR : ∀ r ∈ R, r.body ≠ []) {x : Nat} : ¬ Derives R F x := by
  intro h
  induction h with
  | fact hx => rw [hF] at hx; cases hx
  | @rule r hr _ ih =>
    obtain ⟨y, hy⟩ := List.exists_mem_of_ne_nil _ (hR r hr)
    exact ih y hy

/-! ## Grounding: unfounded sets -/

/-- **Unfounded sets are not grounded.** A set `S` of atoms with no live fact, every rule for an
atom of `S` needing some atom of `S`, contains no derivable atom, however other facts and rules
stand (the least-fixpoint reading; `no_facts_no_derivation` is its empty-world special case). -/
theorem unfounded_not_derivable {R : List Rule} {F : Nat → Bool} {S : Nat → Prop}
    (hF : ∀ x, S x → F x = false) (hR : ∀ r ∈ R, S r.head → ∃ y ∈ r.body, S y) {x : Nat}
    (hx : S x) : ¬ Derives R F x := by
  intro h
  induction h with
  | fact hf => rw [hF _ hx] at hf; cases hf
  | @rule r hr _ ih =>
    obtain ⟨y, hy, hS⟩ := hR r hr hx
    exact ih y hy hS


end Nanodregg.Lang.Contextual
/-
# Lang.Proofs.Contextual.Typing — the judgments of `Lang.Contextual.Core` (lane CMTT-CORE)

`HasTy Δ Γ t A` is CMTT's typing judgment; `HasSubst Δ Γ σ Ψ` (`σ : Ψ` under `Δ; Γ`) its pointwise
lift, inlined into the `mvar` rule so the judgment is one inductive (`HasTy.mvar'` is the textbook
rule); `Step` is weak-head reduction. Statements, hence a proof module (gate C3).
-/
import Lang.Contextual.Core

namespace Nanodregg.Lang.Contextual

/-! ## Typing -/

/-- `HasTy Δ Γ t A`: CMTT's typing judgment, `Δ; Γ ⊢ t : A`. -/
inductive HasTy : MEnv → Ctx → Tm → Ty → Prop
  | var {Δ : MEnv} {Γ : Ctx} {i : Nat} {A : Ty} :
      Γ[i]? = some A → HasTy Δ Γ (.var i) A
  | lam {Δ : MEnv} {Γ : Ctx} {A B : Ty} {t : Tm} :
      HasTy Δ (A :: Γ) t B → HasTy Δ Γ (.lam A t) (.arr A B)
  | app {Δ : MEnv} {Γ : Ctx} {A B : Ty} {t s : Tm} :
      HasTy Δ Γ t (.arr A B) → HasTy Δ Γ s A → HasTy Δ Γ (.app t s) B
  /-- The body is typed under `Ψ` ONLY; the ambient `Γ` is not available. -/
  | box {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {t : Tm} :
      HasTy Δ Ψ t A → HasTy Δ Γ (.box Ψ t) (.box Ψ A)
  | letbox {Δ : MEnv} {Γ Ψ : Ctx} {A B : Ty} {t s : Tm} :
      HasTy Δ Γ t (.box Ψ A) → HasTy (MEnv.cons (Ψ, A) Δ) Γ s B → HasTy Δ Γ (.letbox t s) B
  /-- `u :: (Ψ ⊢ A) ∈ Δ` and `σ : Ψ` (the premises of `HasSubst`, inlined). -/
  | mvar {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {u : Nat} {σ : List Tm} :
      Δ u = some (Ψ, A) → σ.length = Ψ.length →
      (∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → HasTy Δ Γ s C) →
      HasTy Δ Γ (.mvar u σ) A

/-- `HasSubst Δ Γ σ Ψ`: `Δ; Γ ⊢ σ : Ψ`, pointwise. -/
def HasSubst (Δ : MEnv) (Γ : Ctx) (σ : List Tm) (Ψ : Ctx) : Prop :=
  σ.length = Ψ.length ∧
    ∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → HasTy Δ Γ s C

/-- The `mvar` rule in its textbook form: `u :: (Ψ ⊢ A) ∈ Δ` and `Δ; Γ ⊢ σ : Ψ`. -/
theorem HasTy.mvar' {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {u : Nat} {σ : List Tm}
    (hu : Δ u = some (Ψ, A)) (hσ : HasSubst Δ Γ σ Ψ) : HasTy Δ Γ (.mvar u σ) A :=
  .mvar hu hσ.1 hσ.2

/-! ## Reduction -/

/-- Weak-head small-step reduction: β, the contextual β (`letbox (box Ψ t) s ↦ ⟦Ψ.t/u⟧s`), and
congruence in the function position of `app` and the scrutinee of `letbox`. Nothing reduces under
`lam` or inside `box` (a box body is closed over its own `Ψ` and is a value). -/
inductive Step : Tm → Tm → Prop
  | beta {A : Ty} {t s : Tm} : Step (.app (.lam A t) s) (subst [s] t)
  | letboxBox {Ψ : Ctx} {t s : Tm} : Step (.letbox (.box Ψ t) s) (msubst t 0 s)
  | appL {t t' s : Tm} : Step t t' → Step (.app t s) (.app t' s)
  | letboxL {t t' s : Tm} : Step t t' → Step (.letbox t s) (.letbox t' s)

end Nanodregg.Lang.Contextual
/-
# Lang.Proofs.Contextual.CoreInstance — the laws of CMTT as a `Calculus` (lane CMTT-CORE)

`cmttLaws : CalculusLaws cmttData (fun Ω => HasTy (holeEnv Ω))`: every theorem
`Lang.Proofs.Contextual.Closure` proves over all lawful calculi holds of CMTT. Law by law:

| law | Core |
|---|---|
| `msubst_lemma` | `hasTy_msubstP` + `holeEnv_filter` + `holeEnv_some` |
| `check_sound`, `check_complete` | `check_sound`, `check_complete` |
| `strengthen_lemma` | `hasTy_unshiftAt` |
| `strengthen_factor` | `shiftAt_unshiftAt` |
| `weaken_avoids` | `uses_shiftAt` (holds without the typing premise) |
| `hasTy_var` | `HasTy.var` |
| `uses_var` | `uses` on `var` |
-/
import Lang.Contextual.CoreCalculus
import Lang.Proofs.Contextual.Typing
import Lang.Proofs.Contextual.Core
import Lang.Proofs.Contextual.ClosureStatements

namespace Nanodregg.Lang.Contextual

theorem holeEnv_nil : holeEnv [] = MEnv.nil := rfl

/-- Removing declarations of OTHER names (or none of name `n`) leaves `n`'s lookup alone. -/
theorem holeEnv_filter (p : HoleDecl Ctx Ty → Bool) (n : Nat) :
    ∀ Ω : List (HoleDecl Ctx Ty), (∀ d ∈ Ω, d.name = n → p d = true) →
      holeEnv (Ω.filter p) n = holeEnv Ω n
  | [], _ => rfl
  | d :: Ω, h => by
    have ih := holeEnv_filter p n Ω fun d' hd' => h d' (List.mem_cons_of_mem _ hd')
    by_cases hn : d.name = n
    · have hp := h d List.mem_cons_self hn
      simp only [holeEnv, List.filter_cons_of_pos hp, List.find?_cons, hn, beq_self_eq_true]
    · have hb : (d.name == n) = false := by simp [hn]
      by_cases hp : p d = true
      · simp only [holeEnv, List.filter_cons_of_pos hp, List.find?_cons, hb] at ih ⊢
        exact ih
      · simp only [holeEnv, List.filter_cons_of_neg hp, List.find?_cons, hb] at ih ⊢
        exact ih

theorem holeEnv_some {Ω : List (HoleDecl Ctx Ty)} {n : Nat} {Ψ : Ctx} {A : Ty}
    (h : holeEnv Ω n = some (Ψ, A)) : ∃ d ∈ Ω, d.name = n ∧ d.ctx = Ψ ∧ d.ty = A := by
  unfold holeEnv at h
  simp only [Option.map_eq_some_iff, Prod.mk.injEq] at h
  obtain ⟨d, hd, hc, ht⟩ := h
  exact ⟨d, List.mem_of_find?_eq_some hd, by simpa using List.find?_some hd, hc, ht⟩

/-- **CMTT is a lawful `Calculus`.** -/
theorem cmttLaws : CalculusLaws cmttData (fun Ω => HasTy (holeEnv Ω)) where
  msubst_lemma := by
    intro Ω Γ P T θ hP hθ
    refine hasTy_msubstP hP θ 0 _ (fun v hv => absurd hv (Nat.not_lt_zero v)) ?_ ?_
    · intro n hn
      exact holeEnv_filter _ n Ω fun d _ hd => by rw [hd, hn]; rfl
    · intro n M Ψ A hn hv
      obtain ⟨d, hd, hname, hctx, hty⟩ := holeEnv_some hv
      have := hθ d hd M (by rw [hname]; exact hn)
      rw [hctx, hty] at this
      exact this
  check_sound := check_sound
  check_complete := check_complete
  strengthen_lemma := hasTy_unshiftAt
  strengthen_factor := shiftAt_unshiftAt
  weaken_avoids := fun {_ M _ x} _ => uses_shiftAt x M
  hasTy_var := HasTy.var
  uses_var := by intro x; simp [cmttData, uses]

/-! ## Toy: a template with one hole, filled -/

/-- The hole `0 :: [r : base ⊢ base]` (a continuation awaiting a response `r`). -/
private def bellHole : HoleDecl Ctx Ty := ⟨0, [.base], .base⟩

/-- The template `λx. u₀[x]`: resume the hole at the argument. -/
private def bellTemplate : Tm := .lam .base (.mvar 0 [.var 0])

/-- The filling `u₀ := r.(λy.y) r`. -/
private def bellFill : Nat → Option Tm :=
  fun n => if n = 0 then some (.app (.lam .base (.var 0)) (.var 0)) else none

/-- The template is typed WITH the hole and NOT without it; filled, it computes to
`λx. (λy.y) x` and is typed with the hole gone, through `cmttLaws.msubst_lemma`. -/
theorem bell_template_toy :
    HasTy (holeEnv [bellHole]) [] bellTemplate (.arr .base .base) ∧
      ¬ HasTy (holeEnv []) [] bellTemplate (.arr .base .base) ∧
      cmttData.msubst bellFill bellTemplate = .lam .base (.app (.lam .base (.var 0)) (.var 0)) ∧
      HasTy (holeEnv []) [] (cmttData.msubst bellFill bellTemplate) (.arr .base .base) := by
  have hT : HasTy (holeEnv [bellHole]) [] bellTemplate (.arr .base .base) :=
    HasTy.lam (HasTy.mvar' rfl (hasSubst_cons (.var rfl) (hasSubst_nil _ _)))
  refine ⟨hT, ?_, rfl, ?_⟩
  · intro h
    cases h with
    | lam hb => cases hb with | mvar hu _ _ => cases hu
  · have := cmttLaws.msubst_lemma (Ω := [bellHole]) (Γ := []) (P := bellTemplate)
      (T := .arr .base .base) bellFill hT
      (fun d hd M hM => by
        simp only [List.mem_singleton] at hd
        subst hd
        simp only [bellHole, bellFill, if_true] at hM
        injection hM with hM
        subst hM
        show HasTy (holeEnv []) [.base] _ .base
        exact HasTy.app (HasTy.lam (HasTy.var rfl)) (HasTy.var rfl))
    simpa [bellHole, bellFill] using this

/-- The instance's strengthening is the real one: `t ≡ t₀[π]` with `t₀ ≠ t`. -/
theorem cmtt_strengthen_toy :
    cmttData.strengthen 1 (.app (.var 0) (.var 2)) = (.app (.var 0) (.var 1) : Tm) ∧
      cmttData.weaken 1 (cmttData.strengthen 1 (.app (.var 0) (.var 2))) =
        (.app (.var 0) (.var 2) : Tm) :=
  ⟨rfl, rfl⟩

end Nanodregg.Lang.Contextual

codex
Composition will retain intermediate obligations even if a later edit resolves them. I’m also separating transport evidence from selection: a checked correspondence can justify a new filling, while the destination guard, supports, budget, and chooser still govern its use.

exec
/bin/zsh -lc "ssh -n hbox 'python3 -c '\\''from pathlib import Path
p=Path('\\''\\'\\'''\\''/tank/dregg-build/nanodregg/wt/CX-P4/Lang/Contextual/RepairObjects.lean'\\''\\'\\'''\\'')
p.write_text(\"/- First-class repair objects. P4; a demonstration Mini can take.\\nThe indexed data lives here; correctness and equivalence laws live in Proofs.\\nThe old five outcomes embed unchanged; transport adds the sixth case. -/\\nimport Lang.Contextual.Closure\\n\\nnamespace Nanodregg.Lang.Contextual.RepairObjects\\n\\nvariable {D : CalculusData} {E : Type}\\n\\n/-- An edit path with its source and destination in the type. -/\\ninductive Change (E : Type) : World E → World E → Type where\\n  | stay (w : World E) : Change E w w\\n  | edit (w : World E) (e : Edit E) : Change E w (e.apply w)\\n  | then {w v z : World E} : Change E w v → Change E v z → Change E w z\\n\\n/-- World-indexed state; coherence is a separate law, not an unchecked field. -/\\nstructure State (D : CalculusData) {E : Type} (w : World E) where\\n  closure : Closure D E\\n\\n/-- A resumable residual retains the template, all alternatives, history and world. -/\\nstructure Residual (D : CalculusData) (E : Type) where\\n  world : World E\\n  closure : Closure D E\\n  outcomes : List (Outcome D)\\n\\n/-- Include obligations from every suspended alternative, not only the selected one. -/\\ndef Residual.obligations (r : Residual D E) : List Obligation :=\\n  (r.closure.Φ ++ r.outcomes.flatMap (fun\\n    | .suspended _ obligations => obligations\\n    | _ => [])).eraseDups\\n\\nstructure Result (D : CalculusData) {E : Type} (w : World E) where\\n  state : State D w\\n  /-- Ordered checkpoints: composition never discards intermediate obligations. -/\\n  residuals : List (Residual D E)\\n  inspected : List (Nat × Nat)\\n\\n/-- A repair is a value, abstractable over its indexed edit; arbitrary values need Sound. -/\\nstructure Repair (D : CalculusData) {E : Type} {w v : World E} (e : Change E w v) where\\n  run : State D w → Result D v\\n\\ndef Repair.identity (w : World E) : Repair D (.stay w) :=\\n  ⟨fun s => ⟨s, [], []⟩⟩\\n\\ndef Repair.atomic (w : World E) (e : Edit E) : Repair D (.edit w e) :=\\n  ⟨fun s =>\\n    let r := repair w e s.closure\\n    ⟨⟨r.1⟩, [⟨e.apply w, r.1, r.2.1⟩], r.2.2⟩⟩\\n\\ndef Repair.compose {w v z : World E} {e : Change E w v} {f : Change E v z}\\n    (r : Repair D e) (s : Repair D f) : Repair D (.then e f) :=\\n  ⟨fun st =>\\n    let a := r.run st\\n    let b := s.run a.state\\n    { b with residuals := a.residuals ++ b.residuals,\\n             inspected := a.inspected ++ b.inspected }⟩\\n\\n/-- Interpret a first-class edit path using the landed incremental repair. -/\\ndef Repair.ofChange {w v : World E} : (e : Change E w v) → Repair D e\\n  | .stay w => .identity w\\n  | .edit w e => .atomic w e\\n  | .then e f => (.ofChange e).compose (.ofChange f)\\n\\n/-- Resume the retained state through another edit, using the same incremental machinery. -/\\ndef Residual.resume (r : Residual D E) (e : Edit E) : Result D (e.apply r.world) :=\\n  (Repair.atomic r.world e).run ⟨r.closure⟩\\n\\n/-- From-scratch semantics, at any world, of the retained problem and candidates. -/\\ndef analyze (w : World E) (cl : Closure D E) : List (List Status) :=\\n  observe (fromScratch w cl.tpl fun u => (cl.slot u).cands)\\n\\n/-- Cost and intent are selection preferences. The existing budget remains a hard check. -/\\nstructure Policy (D : CalculusData) where\\n  eligible : Candidate D → Bool\\n  cost : Candidate D → Nat\\n\\ndef Policy.cheapest : Policy D := ⟨fun _ => true, Candidate.cost⟩\\n\\n/-- Minimum policy cost among CURRENTLY verified eligible candidates. Leftmost wins ties. -/\\ndef choose (policy : Policy D) (I : Iface D E) (w : World E) :\\n    List (Candidate D) → Nat → Option (Candidate D × Nat)\\n  | [], _ => none\\n  | c :: cs, n =>\\n    let rest := choose policy I w cs (n + 1)\\n    if policy.eligible c && isVerified (judge I w c) then\\n      match rest with\\n      | none => some (c, n)\\n      | some (d, j) => if policy.cost c ≤ policy.cost d then some (c, n) else some (d, j)\\n    else rest\\n\\ninductive SelectionRefusal where\\n  | base (reason : Refusal)\\n  | noEligibleCandidate\\n\\n/-- Selection delegates authority, history and the fresh final judgment to the landed select. -/\\ndef select (policy : Policy D) (w : World E) (p : Party) (u : Nat) (cl : Closure D E) :\\n    Except SelectionRefusal (Closure D E × Nat) :=\\n  match cl.find u with\\n  | none => .error (.base .unknownHole)\\n  | some I =>\\n    match choose policy I w (cl.slot u).cands 0 with\\n    | none => .error .noEligibleCandidate\\n    | some (_, i) =>\\n      match Nanodregg.Lang.Contextual.select w p u i cl with\\n      | .error reason => .error (.base reason)\\n      | .ok cl'\\''\\'\\'''\\'' => .ok (cl'\\''\\'\\'''\\'', i)\\n\\n/-- A correspondence is data. The registry'\\''\\'\\'''\\''s Sound law certifies an equivalence on\\nchecker-accepted fillings, including both inverses, not just a one-way replacement. -/\\nstructure Correspondence (D : CalculusData) (E : Type) where\\n  source : Iface D E\\n  target : Iface D E\\n  forward : D.Tm → D.Tm\\n  backward : D.Tm → D.Tm\\n\\n/-- Certificate identifiers resolve only through the supplied checked registry.\\nIts Sound predicate is in the proof module, just as CalculusData uses CalculusLaws. -/\\nabbrev Registry (D : CalculusData) (E : Type) := Nat → Option (Correspondence D E)\\n\\n/-- Transport retains the original term and the certificate, so it is distinguishable\\nfrom an unrelated replacement even when their destination terms coincide. -/\\nstructure TransportEvidence (D : CalculusData) (E : Type) where\\n  certificate : Nat\\n  correspondence : Correspondence D E\\n  original : Candidate D\\n  image : Candidate D\\n\\n/-- Six semantic outcomes: the existing five, plus checked representation transport. -/\\ninductive Outcome (D : CalculusData) (E : Type) where\\n  | existing (outcome : Nanodregg.Lang.Contextual.Outcome D)\\n  | transported (evidence : TransportEvidence D E)\\n\\ninductive OutcomeKind where\\n  | kept | replacement | strengthening | alternative | suspended | transported\\nderiving DecidableEq, Repr\\n\\ndef Outcome.kind : Outcome D E → OutcomeKind\\n  | .existing (.kept _) => .kept\\n  | .existing (.replacement _ _ _) => .replacement\\n  | .existing (.strengthening _ _ _) => .strengthening\\n  | .existing (.alternative _ _) => .alternative\\n  | .existing (.suspended _ _) => .suspended\\n  | .transported _ => .transported\\n\\ninductive TransportRefusal where\\n  | unknownCertificate\\n  | sourceIllTyped\\n  | destination (status : Status)\\nderiving DecidableEq, Repr\\n\\n/-- No source hypothesis dependency is silently dropped by a representation change.\\nThe destination contributes its own hypothesis dependencies when judged. -/\\ndef Correspondence.image (q : Correspondence D E) (c : Candidate D) (cost : Nat) : Candidate D :=\\n  { c with filling := q.forward c.filling, supports := effSupports q.source c,\\n           cost := cost }\\n\\n/-- Offer a transported filling; never mutate a template or bypass chooser/accepted history.\\nEquivalence is checked by certificate lookup (Registry.Sound); destination admission is fresh.\\nThe caller supplies the proposed new cost, which is checked against the target'\\''\\'\\'''\\''s hard budget. -/\\ndef transport (registry : Registry D E) (certificate : Nat) (w : World E)\\n    (c : Candidate D) (cost : Nat) : Except TransportRefusal (Outcome D E) :=\\n  match registry certificate with\\n  | none => .error .unknownCertificate\\n  | some q =>\\n    if D.check q.source.ctx c.filling q.source.ty = false then .error .sourceIllTyped\\n    else\\n      let d := q.image c cost\\n      let st := judge q.target w d\\n      if st = .verified then\\n        .ok (.transported ⟨certificate, q, c, { d with status := st }⟩)\\n      else .error (.destination st)\\n\\nend Nanodregg.Lang.Contextual.RepairObjects\\n\")'\\'''" in /Users/ember/dev/redregg/work/codex/CX-P4

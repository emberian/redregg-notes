229: /-- The identity function substitution is the identity. -/
230: theorem substFn_var : ∀ t : Tm, substFn Tm.var t = t
231:   | .var _ => rfl
232:   | .lam A t => by
233:     have h : upS Tm.var = Tm.var := by funext i; cases i <;> rfl
241: theorem substFnL_var : ∀ σ : List Tm, substFnL Tm.var σ = σ
242:   | [] => rfl
243:   | t :: σ => by simp only [substFnL, substFn_var t, substFnL_var σ]
244: end

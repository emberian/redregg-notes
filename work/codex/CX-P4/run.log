157: theorem rename_substFn (ρ : Nat → Nat) (f : Nat → Tm) :
158:     ∀ t : Tm, rename ρ (substFn f t) = substFn (fun i => rename ρ (f i)) t
159:   | .var _ => rfl
160:   | .lam A t => by
161:     have h : (fun i => rename (upR ρ) (upS f i)) = upS (fun i => rename ρ (f i)) := by
174: theorem renameL_substFnL (ρ : Nat → Nat) (f : Nat → Tm) :
175:     ∀ σ : List Tm, renameL ρ (substFnL f σ) = substFnL (fun i => rename ρ (f i)) σ
176:   | [] => rfl
177:   | t :: σ => by simp only [renameL, substFnL, rename_substFn ρ f t, renameL_substFnL ρ f σ]
178: end

/- P9: finite dual-literal provenance, retaining environmental conditions.
Grädel–Tannen (2024), Def4 p9, §6 pp19–20; de Kleer (1986), pp144–145.
Candidates are Doyle (1979) IN/OUT justifications, not ATMS labels. The computed
polynomial is a label; its Boolean image forgets multiplicity, not conditions. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.P9

variable {D : CalculusData} {E : Type}

/-- Grädel–Tannen §6 pp19–20: keep the verdict's input until specialization.
The budget is a literal too, even though Iface fixes it across world edits. -/
inductive EnvLit (D : CalculusData) where
  | guard (filling : D.Tm)
  | budget (cost : Nat)
deriving DecidableEq

def EnvLit.eval (I : Iface D E) (env : E) : EnvLit D → Bool
  | .guard t => I.guard env t
  | .budget cost => decide (cost ≤ I.budget)

/-- Dual token literals plus unevaluated environmental literals (Grädel–Tannen p9, p19). -/
structure Monomial (D : CalculusData) where
  supports : List Token
  blockers : List Token
  envLits : List (EnvLit D)
deriving DecidableEq

def Monomial.envOK (I : Iface D E) (env : E) (m : Monomial D) : Bool :=
  m.envLits.all (EnvLit.eval I env)

def Monomial.eval (I : Iface D E) (w : World E) (m : Monomial D) : Bool :=
  m.envOK I w.env && m.supports.all w.live && m.blockers.all (fun t => !w.live t)

/-- A Candidate is Doyle (1979), an IN/OUT justification, not an ATMS label.
This translation produces one label environment (de Kleer 1986, pp144–145). -/
def monomial (I : Iface D E) (c : Candidate D) : Monomial D :=
  ⟨effSupports I c, c.blockers, [.guard c.filling, .budget c.cost]⟩

/-- Grädel–Tannen §6 p19: no environment argument, hence no erased guard branch.
Only the immutable typing problem is specialized. -/
def provenance (I : Iface D E) (cs : List (Candidate D)) : List (Monomial D) :=
  (cs.filter fun c => D.check I.ctx c.filling I.ty).map (monomial I)

/-- The original token polynomial recovered by evaluating precisely envLits (Prop15 p20). -/
def specialize (I : Iface D E) (env : E) (ms : List (Monomial D)) :
    List (List Token × List Token) :=
  (ms.filter (Monomial.envOK I env)).map fun m => (m.supports, m.blockers)

/-- p·p̄ = 0: a product containing both polarities contributes nothing (Def4 p9). -/
def Monomial.consistent (m : Monomial D) : Bool :=
  m.supports.all fun t => !decide (t ∈ m.blockers)

/-- de Kleer pp144–145: inclusion of ALL literals, including environmental obligations. -/
def Monomial.subsumes (a b : Monomial D) : Bool :=
  a.supports.all (fun t => decide (t ∈ b.supports)) &&
  a.blockers.all (fun t => decide (t ∈ b.blockers)) &&
  a.envLits.all (fun l => decide (l ∈ b.envLits))

/-- Absorption a + ab = a in PosBool[X,X̄], retaining a representative of equal products.
de Kleer p145: no surviving label environment strictly contains another. -/
def minimal : List (Monomial D) → List (Monomial D)
  | [] => []
  | m :: ms =>
    let rest := minimal ms
    if rest.any (fun n => n.subsumes m) then rest
    else m :: rest.filter (fun n => !m.subsumes n)

/-- A complete label: erase complementary products, then absorb supersets. -/
def label (I : Iface D E) (cs : List (Candidate D)) : List (Monomial D) :=
  minimal ((provenance I cs).filter Monomial.consistent)

end Nanodregg.Lang.Contextual.P9
/- P9: all-environment bridge and the ATMS label discipline. -/
import Lang.Contextual.Provenance
import Lang.Proofs.Contextual.Judge

namespace Nanodregg.Lang.Contextual.P9

variable {D : CalculusData} {E : Type}

/-- Grädel–Tannen p19: evaluating deferred literals is the original candidate test. -/
theorem monomial_verified {I : Iface D E} {w : World E} {c : Candidate D} :
    judge I w c = .verified ↔
      D.check I.ctx c.filling I.ty = true ∧ (monomial I c).eval I w = true := by
  simp [judge_verified_iff, Monomial.eval, Monomial.envOK, monomial,
    EnvLit.eval, List.all_eq_true, and_assoc, and_comm, and_left_comm]

/-- Grädel–Tannen §6 pp19–20: the SAME retained polynomial works for EVERY world/environment.
This new namespace preserves the landed fixed-environment theorem and its name. -/
theorem provenance_iff {I : Iface D E} {w : World E} {cs : List (Candidate D)} :
    (∃ c ∈ cs, judge I w c = .verified) ↔
      ∃ m ∈ provenance I cs, m.eval I w = true := by
  simp only [provenance, List.mem_map, List.mem_filter]
  constructor
  · rintro ⟨c, hc, hv⟩
    obtain ⟨ht, he⟩ := monomial_verified.mp hv
    exact ⟨monomial I c, ⟨c, ⟨hc, ht⟩, rfl⟩, he⟩
  · rintro ⟨m, ⟨c, ⟨hc, ht⟩, rfl⟩, he⟩
    exact ⟨c, hc, monomial_verified.mpr ⟨ht, he⟩⟩

/-- Grädel–Tannen Prop15 p20: specializing retained env literals recovers the old polynomial,
including its order and multiplicity, not merely an implication of validity. -/
theorem specialize_eq (I : Iface D E) (env : E) (cs : List (Candidate D)) :
    specialize I env (provenance I cs) =
      Nanodregg.Lang.Contextual.provenance I env cs := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    cases ht : D.check I.ctx c.filling I.ty <;>
    cases hg : I.guard env c.filling <;>
    by_cases hb : c.cost ≤ I.budget <;>
      simp [provenance, specialize, Nanodregg.Lang.Contextual.provenance,
        monomial, Monomial.envOK, EnvLit.eval, ht, hg, hb] at ih ⊢ <;> exact ih

/-- Grädel–Tannen Prop15 p20, over the actual Edit.apply: no recomputation of provenance is needed. -/
theorem provenance_update (I : Iface D E) (w : World E) (e : Edit E)
    (cs : List (Candidate D)) :
    Nanodregg.Lang.Contextual.provenance I (e.apply w).env cs =
      specialize I (e.apply w).env (provenance I cs) :=
  (specialize_eq I (e.apply w).env cs).symm

/-- Grädel–Tannen Def4 p9: complementary token literals cannot both evaluate to true. -/
theorem monomial_complementary_dead {I : Iface D E} {w : World E} {m : Monomial D}
    {t : Token} (hp : t ∈ m.supports) (hn : t ∈ m.blockers) :
    m.eval I w = false := by
  cases h : m.eval I w
  · rfl
  · simp [Monomial.eval, List.all_eq_true] at h
    have a := h.1.2 t hp
    have b := h.2 t hn
    rw [a] at b
    cases b

/-- Grädel–Tannen Def4 p9, applied to Doyle IN/OUT justifications:
a complementary candidate is never verified, regardless of world or environment. -/
theorem provenance_complementary_dead {I : Iface D E} {w : World E} {c : Candidate D}
    {t : Token} (hp : t ∈ effSupports I c) (hn : t ∈ c.blockers) :
    judge I w c ≠ .verified := by
  intro hv
  have he := (monomial_verified.mp hv).2
  rw [monomial_complementary_dead hp hn] at he
  cases he

/-- de Kleer pp144–145 / Grädel–Tannen Def4 p9: every successful product is consistent. -/
theorem eval_consistent {I : Iface D E} {w : World E} {m : Monomial D}
    (h : m.eval I w = true) : m.consistent = true := by
  simp [Monomial.consistent, List.all_eq_true]
  intro t ht hn
  have hf := monomial_complementary_dead (I := I) (w := w) ht hn
  rw [h] at hf
  cases hf

/-- de Kleer p145: the executable subsumption test is literal-set inclusion. -/
theorem subsumes_iff {a b : Monomial D} :
    a.subsumes b = true ↔
    (∀ t ∈ a.supports, t ∈ b.supports) ∧
    (∀ t ∈ a.blockers, t ∈ b.blockers) ∧
    (∀ l ∈ a.envLits, l ∈ b.envLits) := by
  simp [Monomial.subsumes, List.all_eq_true, Bool.and_eq_true, and_assoc]

/-- de Kleer p145: subsumption composes by literal inclusion. -/
theorem subsumes_trans {a b c : Monomial D}
    (hab : a.subsumes b = true) (hbc : b.subsumes c = true) : a.subsumes c = true := by
  obtain ⟨ap, an, ae⟩ := subsumes_iff.mp hab
  obtain ⟨bp, bn, be⟩ := subsumes_iff.mp hbc
  exact subsumes_iff.mpr ⟨fun t ht => bp t (ap t ht), fun t ht => bn t (an t ht),
    fun l hl => be l (ae l hl)⟩

/-- de Kleer p145: a smaller product holds wherever the larger product holds. -/
theorem subsumes_eval {a b : Monomial D} {I : Iface D E} {w : World E}
    (hab : a.subsumes b = true) (hb : b.eval I w = true) : a.eval I w = true := by
  obtain ⟨hp, hn, he⟩ := subsumes_iff.mp hab
  simp only [Monomial.eval, Monomial.envOK, Bool.and_eq_true, List.all_eq_true] at hb ⊢
  exact ⟨⟨fun l hl => hb.1.1 l (he l hl), fun t ht => hb.1.2 t (hp t ht)⟩,
    fun t ht => hb.2 t (hn t ht)⟩

/-- de Kleer p145: absorption keeps original products, not invented explanations. -/
theorem minimal_subset {ms : List (Monomial D)} {m : Monomial D}
    (hm : m ∈ minimal ms) : m ∈ ms := by
  induction ms with
  | nil => simp [minimal] at hm
  | cons a ms ih =>
    simp only [minimal] at hm
    split at hm
    · exact List.mem_cons_of_mem a (ih hm)
    · rcases List.mem_cons.mp hm with rfl | hm
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem a (ih (List.mem_filter.mp hm).1)

/-- de Kleer p145: absorption preserves and covers every successful environment. -/
theorem minimal_eval (ms : List (Monomial D)) (I : Iface D E) (w : World E) :
    (∃ m ∈ minimal ms, m.eval I w = true) ↔ ∃ m ∈ ms, m.eval I w = true := by
  constructor
  · rintro ⟨m, hm, he⟩
    exact ⟨m, minimal_subset hm, he⟩
  · induction ms with
    | nil => simp
    | cons a ms ih =>
      rintro ⟨m, hm, he⟩
      simp only [minimal]
      split
      · rename_i h
        rcases List.mem_cons.mp hm with rfl | hm
        · obtain ⟨n, hn, hna⟩ := List.any_eq_true.mp h
          exact ⟨n, hn, subsumes_eval hna he⟩
        · exact ih ⟨m, hm, he⟩
      · rcases List.mem_cons.mp hm with rfl | hm
        · exact ⟨m, List.mem_cons_self, he⟩
        · obtain ⟨n, hn, hne⟩ := ih ⟨m, hm, he⟩
          cases ha : a.subsumes n with
          | false => exact ⟨n, by simp [hn, ha], hne⟩
          | true => exact ⟨a, List.mem_cons_self, subsumes_eval ha hne⟩

/-- de Kleer p145: every original environment contains a surviving label environment. -/
theorem minimal_covers (ms : List (Monomial D)) {m : Monomial D} (hm : m ∈ ms) :
    ∃ n ∈ minimal ms, n.subsumes m = true := by
  induction ms with
  | nil => simp at hm
  | cons a ms ih =>
    simp only [minimal]
    split
    · rename_i h
      rcases List.mem_cons.mp hm with rfl | hm
      · exact List.any_eq_true.mp h
      · exact ih hm
    · rcases List.mem_cons.mp hm with rfl | hm
      · exact ⟨m, List.mem_cons_self, subsumes_iff.mpr
          ⟨fun _ h => h, fun _ h => h, fun _ h => h⟩⟩
      · obtain ⟨n, hn, hnm⟩ := ih hm
        cases han : a.subsumes n with
        | false => exact ⟨n, by simp [hn, han], hnm⟩
        | true => exact ⟨a, List.mem_cons_self, subsumes_trans han hnm⟩

/-- de Kleer p145: no retained environment is a strict superset of another.
Equal literal sets may have different list orders; the Boolean image identifies them. -/
theorem provenance_minimal (ms : List (Monomial D)) :
    ∀ a ∈ minimal ms, ∀ b ∈ minimal ms,
      a.subsumes b = true → b.subsumes a = true := by
  induction ms with
  | nil => simp [minimal]
  | cons m ms ih =>
    simp only [minimal]
    split
    · exact ih
    · rename_i h
      intro a ha b hb hab
      rcases List.mem_cons.mp ha with rfl | ha <;>
      rcases List.mem_cons.mp hb with rfl | hb
      · exact hab
      · have hf := (List.mem_filter.mp hb).2
        simp [hab] at hf
      · have ha' := (List.mem_filter.mp ha).1
        have ht : (minimal ms).any (fun n => n.subsumes b) = true :=
          List.any_eq_true.mpr ⟨a, ha', hab⟩
        exact False.elim (h ht)
      · exact ih a (List.mem_filter.mp ha).1 b (List.mem_filter.mp hb).1 hab

/-- de Kleer pp144–145: sound, complete, consistent, absorbed labels retain the
all-environment provenance bridge (Grädel–Tannen pp19–20). -/
theorem label_iff {I : Iface D E} {w : World E} {cs : List (Candidate D)} :
    (∃ c ∈ cs, judge I w c = .verified) ↔ ∃ m ∈ label I cs, m.eval I w = true := by
  rw [provenance_iff, label, minimal_eval]
  constructor
  · rintro ⟨m, hm, he⟩
    exact ⟨m, List.mem_filter.mpr ⟨hm, eval_consistent he⟩, he⟩
  · rintro ⟨m, hm, he⟩
    exact ⟨m, (List.mem_filter.mp hm).1, he⟩

end Nanodregg.Lang.Contextual.P9
/- P9's first tooth: fixed-environment provenance loses a future answer. -/
import Lang.Proofs.Contextual.Judge
import Lang.Contextual.CoreCalculus

namespace Nanodregg.Lang.Contextual.P9

private def toothIface : Iface cmttData Bool :=
  ⟨0, [], .arr .base .base, [], by simp, fun env _ => env, 10, 1, 2⟩
private def toothCandidate : Candidate cmttData :=
  ⟨.lam .base (.var 0), [], [], 1, 3, .verified⟩
private def toothWorld : World Bool := ⟨fun _ => false, false⟩

/-- Grädel–Tannen (2024), §6 p19: specializing too early erases future answers.
The actual guard edit verifies a candidate absent from the old polynomial. -/
theorem provenance_env_specialized :
    Nanodregg.Lang.Contextual.provenance toothIface toothWorld.env [toothCandidate] = [] ∧
    judge toothIface ((Edit.setEnv true).apply toothWorld) toothCandidate = .verified := by
  decide

end Nanodregg.Lang.Contextual.P9

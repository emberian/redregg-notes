/- P9: a closure carrying a recorded nogood database (de Kleer 1986, pp144–145).
This append-only extension does not change the landed Closure or its theorems.
The checked operations below consume the database; erasing toClosure loses this policy. -/
import Lang.Contextual.ProvenanceRepairs
import Lang.Contextual.P5

namespace Nanodregg.Lang.Contextual.P9

variable {D : CalculusData} {E : Type}

/-- de Kleer pp144–145: an ATMS label is consistent relative to recorded nogoods.
The base closure still carries the single retained template, candidates, and history. -/
structure RecordedClosure (D : CalculusData) (E : Type) extends Closure D E where
  nogoods : List (List Token)

/-- The first recorded inconsistent subset of the EFFECTIVE support, including used hypotheses.
No liveness test: a missing member does not turn an inconsistent justification into a repair. -/
def findNogood (ngs : List (List Token)) (supports : List Token) : Option (List Token) :=
  ngs.find? fun ng => ng.all (fun t => decide (t ∈ supports))

/-- Checked verdict plus its recorded evidence. A nogood uses the existing named guard conflict:
it is an additional admissibility condition, never a new assumption of falsity. -/
structure NogoodJudgment where
  status : Status
  nogood : Option (List Token)
deriving DecidableEq, Repr

/-- de Kleer pp144–145: consistency is tested before missing supports.
The original judge is still the sole checker of typing, guard, blockers and budget. -/
def judgeRecorded (cl : RecordedClosure D E) (I : Iface D E) (w : World E)
    (c : Candidate D) : NogoodJudgment :=
  match findNogood cl.nogoods (effSupports I c) with
  | some ng => ⟨.conflict .guardFails, some ng⟩
  | none => ⟨judge I w c, none⟩

/-- Retained alternatives consistent with recorded nogoods, used for both labels and repairs. -/
def eligibleCandidates (cl : RecordedClosure D E) (I : Iface D E)
    (cs : List (Candidate D)) : List (Candidate D) :=
  cs.filter fun c => (findNogood cl.nogoods (effSupports I c)).isNone

/-- de Kleer p145: provenance is built only from consistent justifications, retaining env literals. -/
def recordedLabel (cl : RecordedClosure D E) (I : Iface D E) (cs : List (Candidate D)) :=
  label I (eligibleCandidates cl I cs)

/-- Prop16 p23, under the same recorded consistency policy as selection. -/
def recordedRepairPlans (cl : RecordedClosure D E) (I : Iface D E) (w : World E)
    (cs : List (Candidate D)) :=
  repairPlans I w (eligibleCandidates cl I cs)

/-- de Kleer p145: a recorded inconsistent candidate is refuted in this policy at every world.
Other failure statuses stay open; failed search is not a refutation of the hole. -/
def classifyRecorded (cl : RecordedClosure D E) (I : Iface D E) (w : World E)
    (c : Candidate D) : P5.LogicalStatus (Candidate D) (List Token) P5.Need P5.Limit :=
  match (judgeRecorded cl I w c).nogood with
  | some ng => .refuted ng
  | none =>
    if (judgeRecorded cl I w c).status = .verified then .witnessed c
    else .open .admission []

/-- The recorded policy reaches selection: reject inconsistent support before delegating
authority, accepted-history and current-world checks to the original select. -/
def selectRecorded (cl : RecordedClosure D E) (w : World E) (p : Party) (u i : Nat) :
    Except Refusal (RecordedClosure D E) :=
  match cl.toClosure.find u with
  | none => .error .unknownHole
  | some I =>
    match (cl.slot u).cands[i]? with
    | none => .error .noCandidate
    | some c =>
      match findNogood cl.nogoods (effSupports I c) with
      | some _ => .error (.notVerified (.conflict .guardFails))
      | none =>
        (Nanodregg.Lang.Contextual.select w p u i cl.toClosure).map
          fun base => { toClosure := base, nogoods := cl.nogoods }

end Nanodregg.Lang.Contextual.P9
/- Recorded nogoods: consistency, provenance, repairs, refutations and selection. -/
import Lang.Contextual.Nogoods
import Lang.Proofs.Contextual.ProvenanceRepairs

namespace Nanodregg.Lang.Contextual.P9

variable {D : CalculusData} {E : Type}

/-- de Kleer pp144–145: a returned conflict core is actually recorded and contained in the support. -/
theorem findNogood_sound {ngs : List (List Token)} {supports ng : List Token}
    (h : findNogood ngs supports = some ng) :
    ng ∈ ngs ∧ ∀ t ∈ ng, t ∈ supports := by
  exact ⟨List.mem_of_find?_eq_some h, by
    simpa [List.all_eq_true] using (List.find?_some h)⟩

/-- de Kleer pp144–145: every recorded inconsistent support is found; empty nogoods count too. -/
theorem findNogood_complete {ngs : List (List Token)} {supports ng : List Token}
    (hm : ng ∈ ngs) (hs : ∀ t ∈ ng, t ∈ supports) :
    ∃ core, findNogood ngs supports = some core := by
  cases hf : findNogood ngs supports with
  | some core => exact ⟨core, rfl⟩
  | none =>
    have hn := List.find?_eq_none.mp hf ng hm
    have ht : (ng.all fun t => decide (t ∈ supports)) = true := by
      simpa [List.all_eq_true] using hs
    rw [ht] at hn
    exact False.elim (hn rfl)

/-- de Kleer p145: a support containing a nogood is a conflict with a recorded core,
even if every support is missing; it is never merely suspended. -/
theorem judge_respects_nogoods {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {c : Candidate D} {ng : List Token}
    (hm : ng ∈ cl.nogoods) (hs : ∀ t ∈ ng, t ∈ effSupports I c) :
    ∃ core, judgeRecorded cl I w c = ⟨.conflict .guardFails, some core⟩ ∧
      core ∈ cl.nogoods ∧ ∀ t ∈ core, t ∈ effSupports I c := by
  obtain ⟨core, hc⟩ := findNogood_complete hm hs
  exact ⟨core, by simp [judgeRecorded, hc], findNogood_sound hc⟩

/-- de Kleer p145: recorded inconsistency never masquerades as missing support. -/
theorem nogood_never_suspended {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {c : Candidate D} {ng : List Token} (hm : ng ∈ cl.nogoods)
    (hs : ∀ t ∈ ng, t ∈ effSupports I c) (missing : List Token) :
    (judgeRecorded cl I w c).status ≠ .suspended missing := by
  obtain ⟨core, hc, _⟩ := judge_respects_nogoods (w := w) hm hs
  simp [hc]

/-- de Kleer p145: successful judgment means original verification AND no recorded inconsistent subset. -/
theorem judgeRecorded_verified {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {c : Candidate D} :
    (judgeRecorded cl I w c).status = .verified ↔
      findNogood cl.nogoods (effSupports I c) = none ∧ judge I w c = .verified := by
  cases h : findNogood cl.nogoods (effSupports I c) <;> simp [judgeRecorded, h]

/-- de Kleer pp144–145 / Grädel–Tannen p19: the complete all-env label under recorded consistency. -/
theorem recordedLabel_iff {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {cs : List (Candidate D)} :
    (∃ c ∈ cs, (judgeRecorded cl I w c).status = .verified) ↔
      ∃ m ∈ recordedLabel cl I cs, m.eval I w = true := by
  rw [recordedLabel, ← label_iff]
  simp only [eligibleCandidates, List.mem_filter, judgeRecorded_verified]
  constructor
  · rintro ⟨c, hc, hn, hv⟩
    exact ⟨c, ⟨hc, by simp [hn]⟩, hv⟩
  · rintro ⟨c, ⟨hc, hn⟩, hv⟩
    exact ⟨c, hc, by simpa using hn, hv⟩

/-- Grädel–Tannen Prop16 p23: computed repairs survive the SAME nogood-aware judge. -/
theorem recordedRepairs_sound {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {cs : List (Candidate D)} {ts : List Token}
    (h : ts ∈ recordedRepairPlans cl I w cs) :
    ∃ c ∈ cs, (judgeRecorded cl I (applyAll (tokenEdits w ts) w) c).status = .verified := by
  obtain ⟨c, hc, hv⟩ := repairPlans_sound h
  obtain ⟨hc, hn⟩ := List.mem_filter.mp hc
  exact ⟨c, hc, judgeRecorded_verified.mpr ⟨by simpa using hn, hv⟩⟩

/-- de Kleer p145: P5's refuted value is justified by a retained nogood, and
rules out this candidate in EVERY world. It is relative to the recorded database,
not a proof that arbitrary token propositions logically imply False. -/
theorem recorded_refuted {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {c : Candidate D} {ng : List Token}
    (h : classifyRecorded cl I w c = .refuted ng) :
    ng ∈ cl.nogoods ∧ (∀ t ∈ ng, t ∈ effSupports I c) ∧
      ∀ v : World E, (judgeRecorded cl I v c).status ≠ .verified := by
  unfold classifyRecorded judgeRecorded at h
  cases hf : findNogood cl.nogoods (effSupports I c) with
  | none =>
    simp only [hf] at h
    split at h <;> cases h
  | some core =>
    simp only [hf] at h
    cases h
    obtain ⟨hm, hs⟩ := findNogood_sound hf
    exact ⟨hm, hs, fun v => by simp [judgeRecorded, hf]⟩

/-- de Kleer p145: the closure policy has an operational consumer; a recorded nogood
prevents selection even when the original judge would verify the candidate. -/
theorem select_respects_nogoods {cl : RecordedClosure D E} {I : Iface D E}
    {w : World E} {c : Candidate D} {u i : Nat} {ng : List Token}
    (hI : cl.toClosure.find u = some I) (hc : (cl.slot u).cands[i]? = some c)
    (hm : ng ∈ cl.nogoods) (hs : ∀ t ∈ ng, t ∈ effSupports I c) (p : Party) :
    selectRecorded cl w p u i = .error (.notVerified (.conflict .guardFails)) := by
  obtain ⟨core, hn⟩ := findNogood_complete hm hs
  simp [selectRecorded, hI, hc, hn]

end Nanodregg.Lang.Contextual.P9
/- P9 teeth on the actual CMTT checker; no bespoke calculus laws. -/
import Lang.Proofs.Contextual.Nogoods
import Lang.Proofs.Contextual.ProvenanceTeeth

namespace Nanodregg.Lang.Contextual.P9.Experiments

private def a : Token := ⟨1, 0⟩
private def b : Token := ⟨2, 0⟩
private def c : Token := ⟨3, 0⟩
private def I : Iface cmttData Bool :=
  ⟨0, [], .arr .base .base, [], by simp, fun env _ => env, 3, 1, 2⟩
private def cand (ss bs : List Token) (cost : Nat := 1) : Candidate cmttData :=
  ⟨.lam .base (.var 0), ss, bs, cost, 3, .verified⟩
private def cs : List (Candidate cmttData) :=
  [cand [a] [b], cand [c] [], cand [a, c] [b], cand [a] [a], cand [] [] 4]
private def w : World Bool := ⟨fun t => t == b, true⟩
private def tpl : Template cmttData Bool :=
  ⟨[], .arr .base .base, .mvar 0 [], [I], by simp [I]⟩
private def cl : RecordedClosure cmttData Bool :=
  { toClosure := fromScratch w tpl fun _ => cs, nogoods := [[a]] }

/-- Grädel–Tannen p19: all five candidates retain their environmental literals,
including a currently impossible budget; specializing a guard edit resurrects the branch. -/
theorem environment_literals_retained :
    (provenance I cs).length = 5 ∧
    (specialize I false (provenance I cs)) = [] ∧
    (specialize I true (provenance I cs)).length = 4 := by decide

/-- Grädel–Tannen Prop16 p23: two alternatives, one insertion plus one deletion or
one insertion; contradictory, over-budget and strictly larger plans are absent. -/
theorem computed_minimal_repairs :
    repairPlans I w cs = [[a, b], [c]] := by decide

/-- Grädel–Tannen Prop16 p23: both computed alternatives execute to verification
via the actual primitive edit interpreter; all unedited blockers stay meaningful. -/
theorem computed_repairs_execute :
    judge I (applyAll (tokenEdits w [a, b]) w) (cand [a] [b]) = .verified ∧
    judge I (applyAll (tokenEdits w [c]) w) (cand [c] []) = .verified ∧
    judge I (applyAll (tokenEdits w [a]) w) (cand [a] [b]) = .pruned [b] := by decide

/-- Grädel–Tannen §6 p19 / Prop16 p23: token-only repairs cannot invent a guard or
buy a larger budget. In particular a guard-failing residual has no token plan. -/
theorem token_repairs_respect_environment :
    repairPlans I ⟨w.live, false⟩ cs = [] ∧
    repairPlans I w [cand [] [] 4] = [] := by decide

/-- de Kleer p145: absorption removes a genuinely larger explanation, and the
complementary product is dead before any world is chosen (Grädel–Tannen Def4 p9). -/
theorem absorption_and_complements :
    label I [cand [a] [b], cand [a, c] [b], cand [a] [a]] =
      [monomial I (cand [a] [b])] := by decide

/-- de Kleer pp144–145: a missing support in a recorded nogood is a conflict, with
its recorded core; the original candidate judge would merely suspend. -/
theorem nogood_beats_missing :
    judge I ⟨fun _ => false, true⟩ (cand [a] []) = .suspended [a] ∧
    judgeRecorded cl I ⟨fun _ => false, true⟩ (cand [a] []) =
      ⟨.conflict .guardFails, some [a]⟩ := by decide

/-- de Kleer pp144–145 / Prop16 p23: the nogood database changes the computed
repair alternatives, and supplies the exact evidence of P5's refuted constructor. -/
theorem recorded_repairs_and_refutation :
    recordedRepairPlans cl I w cs = [[c]] ∧
    classifyRecorded cl I w (cand [a] []) = .refuted [a] ∧
    classifyRecorded cl I w (cand [c] []) = .open .admission [] := by exact ⟨by decide, rfl, rfl⟩

/-- de Kleer p145: recording the empty nogood makes every support inconsistent,
while a database containing an unrelated token must not exclude it. -/
theorem nogood_matching :
    findNogood [[]] [] = some [] ∧
    findNogood [[b]] [a] = none := by decide

/-- de Kleer p145: recorded consistency reaches a real selection consumer even
after the ordinary candidate judge verifies the repaired candidate. -/
theorem recorded_selection_refused :
    (Nanodregg.Lang.Contextual.select (applyAll (tokenEdits w [a, b]) w)
      1 0 0 cl.toClosure).isOk = true ∧
    (selectRecorded cl (applyAll (tokenEdits w [a, b]) w) 1 0 0).isOk = false := by decide

/-- de Kleer p145: effective supports include used context hypotheses, not only
the candidate's explicit IN list (Doyle's justification). -/
theorem nogood_checks_hypotheses :
    let J : Iface cmttData Bool :=
      ⟨0, [.base], .base, [(0, a)], by decide, fun _ _ => true, 3, 1, 2⟩
    let d : Candidate cmttData := ⟨.var 0, [], [], 1, 3, .verified⟩
    judgeRecorded cl J w d = ⟨.conflict .guardFails, some [a]⟩ := by decide

/-- Prop16 p23: a P4 residual is consumed directly, retaining its actual problem;
an unknown hole is not confused with an empty repair set. -/
theorem residual_computes_repairs :
    residualRepairPlans (⟨w, cl.toClosure, []⟩ : RepairObjects.Residual cmttData Bool) 0 =
      some [[a, b], [c]] ∧
    residualRepairPlans (⟨w, cl.toClosure, []⟩ : RepairObjects.Residual cmttData Bool) 9 =
      none := by decide

/-- Grädel–Tannen p19: typing alone is immutable and may be prefiltered;
ill-typed terms never enter the symbolic polynomial or repair enumeration. -/
theorem typing_stays_checked :
    provenance I [{ cand [] [] with filling := .var 0 }] = [] ∧
    repairPlans I w [{ cand [] [] with filling := .var 0 }] = [] := by decide

/-- de Kleer p145: absorption must compare negative and environmental literals
as well as positive supports; equal supports alone do not justify absorption. -/
theorem absorption_reads_all_literals :
    minimal [monomial I (cand [a] []), monomial I (cand [a] [b])] =
      [monomial I (cand [a] [])] ∧
    minimal [monomial I (cand [a] [] 4), monomial I (cand [a] [] 1)] =
      [monomial I (cand [a] [] 4), monomial I (cand [a] [] 1)] ∧
    findNogood [[a, b]] [a] = none := by decide

end Nanodregg.Lang.Contextual.P9.Experiments

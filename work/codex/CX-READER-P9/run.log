import os, pathlib, subprocess, sys
root=pathlib.Path('/tank/dregg-build/nanodregg/wt/CX-P9')
logs=pathlib.Path('/tank/dregg-build/nanodregg/logs')
(logs/'CX-P9-plants.pid').write_text(str(os.getpid())+'\n')
os.chdir(root)
env=dict(os.environ, SWARM_MEM_MAX='6G', LEAN_NUM_THREADS='2', CARGO_TARGET_DIR=str(root/'target'))
probe=(root/'Lang/Proofs/Contextual/ProvenanceExperiments.lean').read_text()
probe=probe.replace('import Lang.Proofs.Contextual.Nogoods','import Lang.Contextual.Nogoods')
probe=probe.replace('import Lang.Proofs.Contextual.ProvenanceTeeth','import Lang.Contextual.CoreCalculus')
(logs/'CX-P9-probe.lean').write_text(probe)
def run(name,args):
    with (logs/f'CX-P9-{name}.log').open('w') as f:
        rc=subprocess.run(['swarm-build']+args,env=env,stdout=f,stderr=subprocess.STDOUT).returncode
    print(name, rc, flush=True)
    return rc
P='Lang/Contextual/Provenance.lean'
R='Lang/Contextual/ProvenanceRepairs.lean'
N='Lang/Contextual/Nogoods.lean'
cases=[
('guard',P,'| .guard t => I.guard env t','| .guard t => let _ := I.guard env t; true'),
('budget',P,'| .budget cost => decide (cost ≤ I.budget)','| .budget cost => let _ := cost; true'),
('typing',P,'cs.filter fun c => D.check I.ctx c.filling I.ty','cs.filter fun c => let _ := D.check I.ctx c.filling I.ty; true'),
('complements',P,'m.supports.all fun t => !decide (t ∈ m.blockers)','m.supports.all fun _ => true'),
('absorption',P,'''    let rest := minimal ms
    if rest.any (fun n => n.subsumes m) then rest
    else m :: rest.filter (fun n => !m.subsumes n)''','    m :: minimal ms'),
('positive-subsumption',P,'a.supports.all (fun t => decide (t ∈ b.supports))','a.supports.all (fun _ => true)'),
('negative-subsumption',P,'a.blockers.all (fun t => decide (t ∈ b.blockers))','a.blockers.all (fun _ => true)'),
('env-subsumption',P,'a.envLits.all (fun l => decide (l ∈ b.envLits))','a.envLits.all (fun _ => true)'),
('edit-polarity',R,'if w.live t then .withdraw t else .assert t','if w.live t then .assert t else .withdraw t'),
('missing-edits',R,'m.supports.filter fun t => !w.live t','m.supports.filter fun t => w.live t'),
('repair-env',R,'m.envOK I env && m.consistent','(let _ := m.envOK I env; true) && m.consistent'),
('repair-consistency',R,'m.envOK I env && m.consistent','m.envOK I env && (let _ := m.consistent; true)'),
('nogood-bypass',N,'ngs.find? fun ng => ng.all (fun t => decide (t ∈ supports))','ngs.find? fun ng => let _ := ng.all (fun t => decide (t ∈ supports)); false'),
('nogood-partial',N,'ngs.find? fun ng => ng.all (fun t => decide (t ∈ supports))','ngs.find? fun ng => ng.any (fun t => decide (t ∈ supports))'),
('hypothesis-support',N,'match findNogood cl.nogoods (effSupports I c) with','match findNogood cl.nogoods c.supports with'),
('refutation',N,'| some ng => .refuted ng','| some ng => let _ := ng; .open .admission []'),
('selection',N,'| some _ => .error (.notVerified (.conflict .guardFails))', '''| some _ =>
        (Nanodregg.Lang.Contextual.select w p u i cl.toClosure).map
          fun base => { toClosure := base, nogoods := cl.nogoods }''')
]
if run('plant-control-build',['lake','build','Lang.Contextual.Nogoods','Lang.Contextual.CoreCalculus']): sys.exit(1)
if run('plant-control',['lake','env','lean','-DmaxHeartbeats=200000',str(logs/'CX-P9-probe.lean')]): sys.exit(1)
for name,path,old,new in cases:
    p=root/path
    original=p.read_text()
    assert old in original, name
    (logs/f'CX-P9-{name}-original.txt').write_text(original)
    (logs/f'CX-P9-{name}-mutation.txt').write_text(old+'\nBECOMES\n'+new+'\n')
    try:
        p.write_text(original.replace(old,new,1))
        if run('plant-'+name+'-build',['lake','build','Lang.Contextual.Nogoods']):
            sys.exit('mutant failed to build: '+name)
        rc=run('plant-'+name,['lake','env','lean','-DmaxHeartbeats=200000',str(logs/'CX-P9-probe.lean')])
        if rc == 0: sys.exit('plant unexpectedly green: '+name)
    finally:
        p.write_text(original)
if run('plant-restored-build',['lake','build','Lang.Proofs.Contextual.ProvenanceExperiments']): sys.exit(1)
if run('plant-restored',['lake','env','lean','-DmaxHeartbeats=200000',str(logs/'CX-P9-probe.lean')]): sys.exit(1)
print('ALL 17 MUTANTS RED; RESTORED GREEN',flush=True)
scripts/commit: unknown flag --help
#!/usr/bin/env bash
# scripts/commit — THE way to commit to nanodregg main (ROOT ruling 2026-10-16, after five
# stale-index incidents in one day: a commit built from a private or shared index read before
# someone else's commit silently reverted their files).
#
#   scripts/commit (-m MSG | -F FILE) [--cross-layer REASON] [--no-build REASON] [--reverts C]... PATH...
#
#  1. reads the CURRENT main into a private GIT_INDEX_FILE (never the shared index);
#  2. adds exactly PATH... as the lander's FIRST attempt recorded them (gates/rebase.py snapshot: the
#     worktree's HEAD copy as the base, the working copy; a directory means every file under it, a
#     deleted file is recorded as deleted), each merged 3-way with main's copy (GATES-20b); a path
#     that would revert a commit of main's last 300 is refused `stale path: P` unless named by
#     --reverts C (C's layer named in a CROSS-LAYER line when it is another layer's);
#  3. writes SIZE.md, a purely generated view, for that candidate (gates/size.py --write). SIZE.md
#     is refused as a PATH: ceilings are edited in gates/ceilings.tsv;
#  4. refuses if the candidate differs from main anywhere outside PATH... and SIZE.md;
#  5. judges the candidate (GATES-22, Ember 10-21: converge periodically, do not judge every landing).
#     FAST, the default (gates/fast.py mode): scripts/pre-push --fast — ownership (the subject prefix
#     `kernel:` … names the layer, gates/OWNERS; --cross-layer records `CROSS-LAYER: REASON`), every
#     source gate (the parent's too), `lake build` of only the targets the change reaches, `cargo check`
#     + `cargo fmt --check` of only the packages it reaches; minutes. The census, the rows, the benches,
#     the waste measurements, the generated files and clippy judge it at the next CONVERGENCE
#     (scripts/converge, every 3 h while landings happen), which names the commits a red row read.
#     FULL, for a flag day (`kernel!:`) or a change of the judge's code (gates/*.py, scripts/): the
#     whole scripts/pre-push (every target, the census, the selected rows, waste, generated files, the
#     Rust workspace with clippy), judged by main's code (--no-build records `NO-BUILD: REASON` and
#     skips build + census);
#  6. commit-tree on main + compare-and-swap `update-ref refs/heads/main NEW BASE`: if main moved
#     while you were being judged, nothing is written and steps 1-6 re-run. FAST: a plain re-base and
#     retry (FAST_RETRIES, 12 attempts), no queue ticket; it lets a FULL lander displaced twice land
#     first (gates/land.py --fast; a full judge is ~40 min and would otherwise never win the race).

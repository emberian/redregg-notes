rows/run
import Protocol.Rows.Run

def main (args : List String) : IO UInt32 := Nanodregg.Protocol.Rows.main args

/-- Run a member row in a task, polling it under the row's deadline. -/
def runMembers {D : Type} [Ord D] [DecidableEq D] (R : Params D) (m : Option Mutation) (ls : List Line)
    (times : Option Nat) : IO (Except String Loopback.Result) := do
  let t ← IO.asTask (prio := .dedicated) (Loopback.run R m ls times)
  let rec poll : Nat → IO Bool
    | 0 => pure false
    | n + 1 => do
        if ← IO.hasFinished t then pure true else IO.sleep pollMs; poll n
  if !(← poll (rowDeadlineMs / pollMs.toNat)) then
    return .error s!"past its {rowDeadlineMs} ms deadline"
  match ← IO.wait t with
  | .ok r => pure (.ok r)
  | .error e => pure (.error (toString e))

def p99 (ns : List Nat) : Nat :=
  let a := (ns.toArray.qsort (· < ·))
  a.getD ((a.size * 99) / 100) 0 |>.min (a.back?.getD 0)

/-- The machine's load, beside every timing it judges (memory: measure on a quiet machine). -/
def load : IO String := do
  try
    let o ← IO.Process.output { cmd := "sysctl", args := #["-n", "vm.loadavg"] }
    if o.exitCode = 0 then return o.stdout.trimAscii.toString
    return (← IO.FS.readFile "/proc/loadavg").trimAscii.toString
  catch _ => return "unknown"

/-- `a ÷ b` with three decimals, rounded (`b = 0` prints `a`: no division hidden). -/
def ratio (a b : Nat) : String :=
  if b = 0 then toString a else
  let m := (a * 1000 + b / 2) / b
  let frac := toString (m % 1000)
  s!"{m / 1000}.{"".pushn '0' (3 - frac.length)}{frac}"

/-- The plants' ratios on THE BAR's workload, stated: a plant is a tooth only while it bites by
exactly this much (both above the waste.tsv ceiling 1.546). -/
def plantAppStated : String := "1.885"
def plantExtractStated : String := "2.154"

/-- THE BAR's deterministic per-unit counts (PROTOCOL-53), each a numerator and its unit of work:
frames sent on either socket and the writer's steps, per write command run (every `.cmd` line but
`read`, each repetition counted); the segment bytes the measured reopens read, per byte past the
newest base they had to read. What bench-count measures on THE BAR's own Store (trie hashes per
required hash, verifies per step) is not counted here: a second instrument of one quantity. -/
def rowbarCounts (r : Row) (res : Loopback.Result) : Except String (List (String × Nat × Nat)) := do
  let writes := res.times.toList.foldl (fun n t => match r.lines[t.line]? with
    | some { act := .cmd (v :: _), .. } => if v = "read" then n else n + t.ns.length
    | _ => n) 0
  if writes = 0 then throw "bar: no write command ran (a ratio over nothing)"
  let (read, need) := res.reopenReads.foldl (fun (a, b) (x, y, _) => (a + x, b + y)) (0, 0)
  if need = 0 then throw "bar: no reopen with bytes past a base was measured (a ratio over nothing)"
  pure [("frames-per-write", res.frames, writes), ("steps-per-write", res.steps, writes),
    ("reopen-bytes-per-byte-past-base", read, need)]

/-- Each rowbar plant's ratio on THE BAR's workload, stated: a tooth only while it bites by exactly
this much, above the honest ratio. -/
def rowbarStated : List (Mutation × String × String) :=
  [(.twiceEach, "frames-per-write", "21.871"), (.twiceEach, "steps-per-write", "1.977"),
   (.staleBase, "reopen-bytes-per-byte-past-base", "5.259")]

/-- THE BAR under each rowbar plant: its counts must move to their stated values, above the honest
ones, and the mutation must have happened (`staleBase`: a measured reopen was handed an older base). -/
def rowbarPlants {D : Type} [Ord D] [DecidableEq D] (R : Params D) (r : Row) (ls : List Line)
    (times : Option Nat) (honest : List (String × Nat × Nat)) : IO (Option String) := do
  for m in [Mutation.twiceEach, .staleBase] do
    let p ← match ← runMembers R (some m) ls times with
      | .error e => return some s!"bar: plant {repr m}: {e}"
      | .ok p => pure p
    if m = .staleBase && !p.reopenReads.any (·.2.2) then
      return some s!"bar: plant {repr m} did not happen: no measured reopen was handed an older base"
    let counts ← match rowbarCounts r p with
      | .error e => return some s!"bar: plant {repr m}: {e}"
      | .ok c => pure c
    for (pm, metric, stated) in rowbarStated do
      if pm ≠ m then continue
      let some (_, n, d) := counts.find? (·.1 = metric) | return some s!"bar: plant {repr m}: no {metric}"
      let some (_, hn, hd) := honest.find? (·.1 = metric) | return some s!"bar: no honest {metric}"
      IO.println s!"PLANT {repr m} {metric} {ratio n d}"
      if ratio n d ≠ stated then return some s!"bar: plant {repr m} {metric} MOVED {ratio n d}≠{stated}"
      if n * hd ≤ hn * d then
        return some s!"bar: plant {repr m} {metric} BLIND: {ratio n d} is not above {ratio hn hd}"
  return none

/-- Nanoseconds as milliseconds with three decimals. -/
def ms (ns : Nat) : String :=
  let f := toString ((ns / 1000) % 1000)
  s!"{ns / 1000000}.{"".pushn '0' (3 - f.length)}{f}"

/-- The row's liveness timings (`LIVE`: toy parameters, in process; never THE BAR, which is
`scripts/bar.sh` over real processes) and its WASTE lines; an error if the invokes went unmeasured (a WASTE line
over no calls would read as zero cost and pass the ratchet: a fail-open). -/
def barLines (r : Row) (res : Loopback.Result) : IO (Option String) := do
  let timed := res.times.toList.filter fun t => (r.lines[t.line]?.bind (·.withinMs)).isSome
  let writes := (timed.filter fun t => match r.lines[t.line]? with
    | some { act := .cmd _, .. } => true | _ => false).flatMap (·.ns)
  IO.println s!"LIVE write-n {writes.length}"
  IO.println s!"LIVE write-p99-ms {ms (p99 writes)}"
  for ns in res.reopenNs do
    IO.println s!"LIVE reopen-ms {ms ns}"
  IO.println s!"LIVE load {← load}"
  -- the deterministic measures (pinned in gates/waste.tsv): over the invokes, the machine ticks
  -- per step the program requires (the size of its reference derivation, LANG's `requiredOf`) and
  -- the packages loaded and re-checked per call. Sums over sums, never a mean of ratios.
  if let some e := res.invokes.toList.findSome? fun | .error e => some e | .ok _ => none then
    return some s!"bar: an invoke's required count failed: {e}"
  let ms := res.invokes.toList.filterMap fun | .ok m => some m | .error _ => none
  let n := ms.length
  let ticks := ms.foldl (· + ·.ticks) 0
  let required := ms.foldl (· + ·.required) 0
  let planted := ms.foldl (· + ·.planted) 0
  if n = 0 then return some "bar: no invoke was measured"
  if required = 0 then return some "bar: the invokes required no steps (a ratio over nothing)"
  match rowbarCounts r res with
  | .error e => return some e
  | .ok cs => for (metric, n, d) in cs do IO.println s!"WASTE rowbar {metric} {ratio n d}"
  IO.println s!"WASTE invoke ticks-per-required-step {ratio ticks required}"
  IO.println s!"WASTE invoke packages-checked-per-call {ratio (ms.foldl (· + ·.pkgs) 0) n}"
  -- the ratio's teeth, each at its STATED value (a plant whose waste shrank is red, MOVED) and above
  -- the honest ratio (BLIND): two needless transitions per application (waste-app), and extraction
  -- run twice on the same value (waste-extract, cv 01a14abb-aa73)
  let extracted := ms.foldl (· + ·.extracted) 0
  for (name, total, stated) in [("waste-app", planted, plantAppStated),
      ("waste-extract", extracted, plantExtractStated)] do
    IO.println s!"PLANT {name} ticks-per-required-step {ratio total required}"
    if ratio total required ≠ stated then
      return some s!"bar: plant {name} MOVED {ratio total required}≠{stated}"
    if total * 1000 / required ≤ ticks * 1000 / required then
      return some s!"bar: plant {name} BLIND: {ratio total required} is not above {ratio ticks required}"
  return none

/-- Drive one row under the parameters `R`. `measures`: print THE BAR row's LIVE and WASTE lines
(the toy run's; the deployed run prints none, so a WASTE measure is collected once). -/
def drive {D : Type} [Ord D] [DecidableEq D] (R : Params D) (r : Row) (times : Option Nat)
    (control : Bool := false) (measures : Bool := true) : IO Ran :=
  if let some why := r.blockedOn then pure (.pending s!"blocked on {why}") else
  let R := match r.pageBudget with | some b => { R with pageBudget := b } | none => R
  match r.drive with
  | .exe name args _ => runExe name args
  | .members ls => do
      match ← runMembers R none ls times with
      | .error e => pure (.broken e)
      | .ok res =>
          IO.println s!"COST {r.name} frames {res.frames} steps {res.steps}"
          if r.name = "bar" && measures then
            if let some e ← barLines r res then return .broken e
            match rowbarCounts r res with
            | .error e => return .broken e
            | .ok cs => if let some e ← rowbarPlants R r ls times cs then return .broken e
          let t := String.intercalate "\n" res.log.toList
          match judge r res.observed, r.plant with
          | .pass, .caught m line got =>
              match ← runMembers R (some m) ls times with
              | .error e => pure (.broken s!"plant {repr m}: {e}")
              | .ok pr =>
                  -- `--harness-control` (GATES-15): the plant is read at a line the row does not
                  -- have, a plant line that never fires; the runner must call it BLIND
                  let line := if control then r.lines.length else line
                  if caught r pr.observed line got then pure (.observed res.observed t)
                  else pure (.broken s!"plant {repr m} BLIND: line {line} expected to get {got.text}, \
                    outcomes {repr pr.observed.outcomes}{if control then " (harness-control)" else ""}")
          | _, _ => pure (.observed res.observed t)

/-- The last lines of a transcript, indented, for a failing row. -/
def tail (t : String) : String :=
  let ls := (t.splitOn "\n").filter (· ≠ "")
  String.intercalate "\n" ((ls.drop (ls.length - 40)).map ("  | " ++ ·))

/-- Run the rows; the exit code is the runner's verdict. -/
def runAll {D : Type} [Ord D] [DecidableEq D] (R : Params D) (selected : List Row) (times : Option Nat)
    (verbose : Bool) (control : Bool := false) (measures : Bool := true) : IO UInt32 := do
  let mut failed := 0
      | .declined =>
          match reply.bind Command.hostReply with
          | some (_, p) =>
              if (← get).sys.settleDecline then
                -- the plant: the Host's decline taken as final, the attempt settled refused
                settle name call .refused
                pure (.ok (ended .refused s!"refused {(staleCode : Nat)}"))
              else pure (.ok (ended .declined (Command.hostName p)))
          | none => pure (.error "noReply")
      | .contradicted =>
          let f := match last with | some (_, s) => s.name | none => ""
          pure (.ok (ended .contradicted s!"{(host.getD .lost).name} {f}"))
      | .open => pure (.ok (ended .open ""))
      | .uncertain =>
          let st ← get
          pure (.ok (ByteArray.mk #[Attempt.Action.uncertain.code] ++ (if st.sys.dropHint then ByteArray.empty else st.hint)))
      | .badReply => pure (.ok (ended .badReply ""))
termination_by fuel => (depth, 0, fuel + 1)
end

/-! ## The operator's and the attempt store's acts -/

def nowNs : IO Nat := IO.monoNanosNow

/-- Stop the loop, open the Store cold (its base and the tail after it), start the loop on what it
opened to. The reopen's wall time is THE BAR's `reopen-ms`. With `sealFirst`, the stopped writer is
sealed between the stop and the reopen by the deployed act, `Host.sealNow` over the in-memory
Store's checkpoint: what `host seal STORE` does over the files (HOST-43), so the rows seal only as
an operator can. -/
def restart (sealFirst : Bool) : M D Expect := do
  let st ← get
  match ← st.host.stop with
  | .error e => pure (.refused s!"writerFailed {e}")
  | .ok (.eof, r0) =>
      if sealFirst && !st.sys.sealIgnored then
        match ← Host.sealNow (Writer.checkpoint st.sys.writer st.mem) (Writer.mark st.sys.writer) r0 with
        | .error f => return .refused f.name
        | .ok _ => pure ()
      let d ← st.mem.disk.get
      let bs ← st.mem.bases.get
      -- the plant: the open handed the genesis base, the newest one ignored
      let base := if st.sys.staleBase then (bs.history[0]?.map (·.1)).getD bs.file else bs.file
      let t0 ← nowNs
      match Writer.reopenCounted st.sys.writer bs.headers bs.index base d.synced with
      | (.error f, _) => pure (.refused f)
      | (.ok r, n) =>
          let t1 ← nowNs
          st.mem.disk.set { synced := d.synced.extract 0 r.pos.offset }
          let h ← Writer.start st.sys.writer st.mem r
          let ns := if sealFirst then [] else [t1 - t0]
          let rd := if sealFirst then [] else [(n.tail, d.synced.size - r0.sealed.offset, base != bs.file)]
          modify fun st => { st with host := h, reopenNs := st.reopenNs ++ ns,
                                     reopenReads := st.reopenReads ++ rd }
          pure .ok
  | .ok (exit, _) => pure (.refused s!"writer{exit.name}")

/-- Open a copy of the Store whose base file has the byte at `off` flipped. -/
def reopenFlipped (off : Nat) : M D Expect := do
  let st ← get
  let d ← st.mem.disk.get
  let bs ← st.mem.bases.get
  match Writer.reopen st.sys.writer bs.headers bs.index (Host.Sim.flipByte bs.file off) d.synced with
  | .error f => pure (.refused f)
  | .ok _ => pure .ok

def retry (name : String) : M D Expect := do
  match (← actor name).last with
  | none => pure (.refused "noAttempt")
  | some call =>
      -- a probe of a call the attempt store already settled: ONE lookup of the same bytes, so a
      -- journal that forgot it answers `absent` here (reopen's plant), instead of the attempt
      -- decision resending it (which a forgotten journal would admit twice)
      match ← ask .lookup call with
      | none => pure (.refused "writerStopped")
      | some res => pure (statusOutcome res)

/-! ## A row -/

/-- A SECOND writer, from a genesis of the same name, allowance and founders as the rows' writer, and
the same nonce (`sameNonce`, or under the `nonceRepeats` plant: a restore of the same World) or
another one (another World). -/
`Envelope.check`; `forgetSpent` judges a submit on the World with its spent set forgotten (and
keeps the World that reaches); `admitsRecorded` commits a recorded call. -/
def machine (P : Params D) : Machine (World D) (Kernel.Step D) Frame D where
  note := World.roots P.X.env
  handle w f :=
    if !P.gateLog && f.op = Op.log.code then
      match Envelope.ofBytes P.X f.payload with
      | some e => .defer (.log e.start)
      | none => Host.handle P.X w f
    else if P.ignoreNotBefore && f.op = Op.log.code then
      match Envelope.ofBytes P.X f.payload with
      | some e => match Envelope.check P.X w e with
        | .error .notYet => .defer (.log e.start)
        | _ => Host.handle P.X w f
      | none => Host.handle P.X w f
    else if P.forgetSpent && f.op = Op.submit.code then Host.handle P.X (unspend P.X.env w) f
    else match (if P.admitsRecorded then admitRecorded P.X w f else none) with
    | some a => a
    | none =>
    match Host.handle P.X w f with
      | .reply c p =>
        if P.unstatedExpiry && (expiredHeight? p).isSome then .reply c "expired".toUTF8
        else if P.forgottenRefused && c = Status.uncertain.code && p = "forgotten".toUTF8 then
          .reply Status.refused.code p
        else .reply c p
      | a => a
  ok := Status.ok.code

/-- The Store in memory: the segment and the base file. -/
structure Mem where
  disk : IO.Ref Host.Sim.Disk
  bases : IO.Ref Host.Sim.Bases

/-- HOST's in-memory checkpoint (its entries tagged for the Store of the World it seals, HOST-33). -/
def checkpoint (P : Params D) (m : Mem) : Checkpoint (World D) :=
  Host.Sim.memCheckpoint m.disk m.bases P.R.keys (cadence P) P.R.world (mark P)
    (fun w => P.X.env.bytes (World.genesisChain P.X.env w.origin))

/-- HOST's pager (`Host.Page.build` + `Host.Page.bytes`) over the in-memory segment's synced bytes
and `index.log` (`Host.Page.entryAt`): what `Host.Deployed.pager` does over the files. -/
def pager (P : Params D) (m : Mem) (r : Resident (World D)) : Deferred → IO (UInt8 × ByteArray)
  | .read start => do
    if !P.forgeBase then Host.Sim.memBasePage Page.budget m.bases r start else
    -- the World bytes follow the base frame's 4-byte length; flip one in the middle
    let file := Host.Sim.flipByte (← m.bases.get).file (4 + r.sealed.bytes / 2)
    match Id.run (Page.basePage Page.budget (fun off len => pure (file.extract off (off + len))) r.sealed start) with
    | .ok b => pure (Status.ok.code, b)
    | .error f => pure (Status.refused.code, f.name.toUTF8)
  | .log start => do
  let seg := (← m.disk.get).synced
  let idx := (← m.bases.get).index
  let X := P.X
  match Id.run (Page.build X.env P.R.dc X.digestOf P.R.keys.segment (cadence P).recordBytesMax
      P.R.pageBudget (fun off len => pure (seg.extract off (off + len)))
      (Page.entryAt (P.R.keys.forStore (X.env.bytes (World.genesisChain X.env r.world.origin)))
        (fun off len => pure (idx.extract off (off + len))) r.sealed.index.count r.index)
      (r.sealed.index.count + r.index.size) r.pos.offset
      (r.world.steps, X.env.bytes r.world.chain) start) with
  | .error f => pure (Status.refused.code, f.name.toUTF8)
  | .ok a =>
    -- `lieTip` hides the log after the page, so a base after the page too (a consistent lie)
    let baseSteps := if P.lieBase then r.world.steps
      else if P.lieTip then min r.sealed.steps a.steps else r.sealed.steps
    match Page.bytes a (if P.lieTip then a.steps else r.world.steps) r.world.height baseSteps r.sealed.digest with
    | .ok b => pure (Status.ok.code, b)
    | .error f => pure (Status.refused.code, f.name.toUTF8)

/-- A Store as genesis leaves it (HOST's `memGenesis`: the origin frame, the base after it), and
the loop's state the one open gives over it. -/
def genesisStore (P : Params D) (g : World D) : IO (Except String (Mem × Resident (World D))) := do
  match Host.Sim.memGenesis P.R.keys (cadence P) P.R.world (mark P)
      (fun w => P.X.env.bytes (World.genesisChain P.X.env w.origin))
      (Record.step P.R.dc (World.step P.X.env) (World.roots P.X.env)) g with
  | .error f => return .error f.name
  | .ok (d, b, r) => return .ok (⟨← IO.mkRef d, ← IO.mkRef b⟩, r)

/-- What one open read of the Store besides the base file it is handed: `index.log` bytes and
segment-file bytes, the base's own file's checkpoint header counted among them (HOST-64; THE BAR's
`rowbar reopen-…` numerators, PROTOCOL-53). -/
structure Reads where
  index : Nat := 0
  tail : Nat := 0

/-- The one open over the in-memory Store, HOST's `openWith` with the writer's fold, its reads
counted: the same generic open run in a reader monad that adds each read's bytes. -/
def reopenCounted (P : Params D) (headers : Array (Nat × ByteArray)) (index base seg : ByteArray) :
    Except String (Resident (World D)) × Reads :=
  let hdr := Host.Sim.headerOf headers base
  let (o, n) := (openWith (m := StateM Reads) P.R.keys (cadence P) P.R.world (mark P)
      (fun w => P.X.env.bytes (World.genesisChain P.X.env w.origin))
      (Record.step P.R.dc (World.step P.X.env) (World.roots P.X.env))
      base hdr seg.size index.size
      (fun off len => do
        let b := index.extract off (off + len)
        modify fun r => { r with index := r.index + b.size }
        pure (.ok b))
      fun off len => do
        let b := seg.extract off (off + len)
        modify fun r => { r with tail := r.tail + b.size }
        pure (.ok b)).run { tail := hdr.size }
  match o with
  | .error f => (.error f.name, n)
  | .ok o =>
      let w := if P.forgetJournal then { o.opened.world with journal := .empty } else o.opened.world
      (.ok { world := w, pos := o.pos, sealed := o.sealed, index := o.index }, n)

/-- The one open over the in-memory Store (`reopenCounted`, its counts dropped). -/
def reopen (P : Params D) (headers : Array (Nat × ByteArray)) (index base seg : ByteArray) :
    Except String (Resident (World D)) :=
  (reopenCounted P headers index base seg).1

/-- A loop running on its own thread. -/
structure Running (D : Type) [Ord D] where
  reqs : Std.CloseableChannel.Sync Frame
  reps : Std.CloseableChannel.Sync Host.Reply
  task : Task (Except IO.Error (Exit × Resident (World D)))

def start (P : Params D) (m : Mem) (r : Resident (World D)) : IO (Running D) := do
  let reqs ← Std.CloseableChannel.Sync.new
  let reps ← Std.CloseableChannel.Sync.new
  let port := channelPort reqs (← IO.mkRef none) fun r => do discard <| (reps.send r).toBaseIO


def RunCalls (digestOf : ByteArray → Option D) (state : Slots) (method : Nat) (args : ByteArray) (self : D)
    (calls : List (Body D)) (s : Slots) : Prop :=
  ∃ (amount : Nat) (arb asset ben dep nk : ByteArray) (p : Label) (a : D),
    readState digestOf (recordRow escrow.state) state = .ok (stateOf amount arb asset ben dep nk p) ∧
    digestOf asset = some a ∧
    ((method = deposit ∧
        readState digestOf (recordRow escrow.state) s = .ok (stateOf amount arb asset ben dep nk "held") ∧
        ∃ (gb : ByteArray) (gd d : D),
        Wire.decodeData depositArg args = .ok (.record [("grant", .digest gb)]) ∧ digestOf gb = some gd ∧
        digestOf dep = some d ∧ calls = [.transfer (.of d a) (.of self a) amount (some gd) (some nk)]) ∨
     (method = refund ∧
        readState digestOf (recordRow escrow.state) s = .ok (stateOf amount arb asset ben dep nk "refunded") ∧
        ∃ d : D, digestOf dep = some d ∧
        calls = [.transfer (.of self a) (.of d a) amount none (some payoutKey)]) ∨
     (method = release ∧
        readState digestOf (recordRow escrow.state) s = .ok (stateOf amount arb asset ben dep nk "released") ∧
        ∃ b : D, digestOf ben = some b ∧
        calls = [.transfer (.of self a) (.of b a) amount none (some payoutKey)]))

/-- **The escrow's calls are what the receiver's run returns.** A successful `runMeasured` of the
def NoRef : Term → Prop
  | .ref _ => False
  | .hole _ σ => NoRefList σ
  | .var _ | .nat _ | .bool _ | .bytes _ | .digest _ | .refuse _ _ => True
  | .lam _ b => NoRef b
  | .app f a => NoRef f ∧ NoRef a
  | .fix t => NoRef t
  | .prim _ a b => NoRef a ∧ NoRef b
  | .record fs => NoRefRow fs
  | .get t _ => NoRef t
  | .extend t fs => NoRef t ∧ NoRefRow fs
  | .inj _ _ t => NoRef t
  | .case t fs => NoRef t ∧ NoRefRow fs
  | .ite c a b => NoRef c ∧ NoRef a ∧ NoRef b

def NoRefList : List Term → Prop
  | [] => True
  | t :: ts => NoRef t ∧ NoRefList ts

def NoRefRow : List (Label × Term) → Prop
  | [] => True
  | (_, t) :: fs => NoRef t ∧ NoRefRow fs
end

mutual
theorem relocate_noRef (f : Nat → Nat) : ∀ t : Term, NoRef t → t.relocate f = t
  simp [Row.find?] at hf; subst hf; exact hb

/-! ## The laws -/

/-- Law `t` ADMITS `o → n` under request `rq`: its body means `ok` with the request, new and old
states bound above some closure environment. `runLaw_admits` (a closed term, as a test runs it)
and `runLaw_ref_admits` (a package field, as the receiver runs it) produce exactly this. -/
def Admits (lib : List Term) (t : Term) (rq n o : Data) : Prop :=
  ∃ cenv w, BigStep lib (rq.toVal :: n.toVal :: o.toVal :: cenv) (lawBody t) (.ok (.inj "ok" w))

/-- `bounded S f max`: in every admitted birth, adoption, write and invoke, the NEW value of `f` is a
natural at most `max` (so the law cannot be added over a state that already breaks it). -/
theorem bounded_spec {S : Ty} {f : Label} {max : Nat} {rq n o occ : Data}
    (h : Admits lib (bounded S f max) rq n o)
    (ho : rq.field "occasion" = some occ)
    (hc : IsChange occ ∨ (∃ x, occ = .inj "birth" x) ∨ ∃ x, occ = .inj "adopt" x) :
    ∃ m, n.field f = some (.nat m) ∧ m ≤ max := by
  obtain ⟨cenv, w, hb⟩ := h
  if digestsOk digestOf (p.body.digestLits ++ p.holes.flatMap
      (fun h => h.guard.digestLits ++ h.code.flatMap (fun c => c.body.digestLits)))
  then .ok () else .error (.program "notDigest")

/-- A residual hole is a typed refusal when no row view is available (install
and law checking). Ordinary fields still evaluate; no selected code is guessed. -/
def unresolvedBody (p : Package) : Except String Term :=
  if p.holes.isEmpty then .ok p.body
  else Contextual.Term.fillBounded Wire.nodeMax 1
    (fun n => ((holeSignature p.holes).find? (fun d => d.name == n)).map
      (fun d => .refuse d.ty "holeUnresolved".toUTF8)) p.body

/-- Shared live admission. The package retained in Loaded is the original ROM;
only the transient machine library receives an instantiated body. -/
def admitContextual (prepare : List Ty → Package → Except String Term)
    (idb : ByteArray) (p : Package) (acc : Loaded) (gis : List Nat) :
    Except (Refusal D) (Loaded × Nat) :=
  if p.holes.isEmpty then admitPackage digestOf idb p acc gis
  else match ifacesAt acc.pkgs gis with
  | none => .error (.program "closure")
  | some ifs =>
    | .error f => throw (deny s!"{ℓ}: {faultText f}")

def judgeOne (look : Pinned D) (law : D) (old new : Slots) (r : Req D) : Except (Refusal D) Unit :=
  judgeOneWith bytesOf digestOf (load digestOf) look law old new r

def judgeContextual (look : Pinned D) (pkg : Option D) (laws : List D) (old new : Slots) (r : Req D) :
    Except (Refusal D) Unit := do
  if let some p := pkg then
    judgeOneWith bytesOf digestOf (loadContextual digestOf) look p old new r
  for l in laws do
    judgeOneWith bytesOf digestOf (loadContextual digestOf) look l old new r

def judge (look : Pinned D) (pkg : Option D) (laws : List D) (old new : Slots) (r : Req D) :
    Except (Refusal D) Unit := do
  if let some p := pkg then judgeOne bytesOf digestOf look p old new r
  for l in laws do judgeOne bytesOf digestOf look l old new r

/-- Method `method` of package `p`: its label, its argument type and its call slots (the one
resolution: the run and the resident readers below all ask here). -/
def resolveMethod (p : Package) (method : Nat) : Except (Refusal D) (Label × Sig) := do
  let some ℓ := p.methods[method]? | throw (.program s!"no method {method}")
def program (bytesOf : D → ByteArray) (digestOf : ByteArray → Option D) : Program D where
  checkInstall := checkInstallContextual digestOf
  judge := judgeContextual bytesOf digestOf
  -- the slots, the calls the method makes as the object, and the ticks it used (LEDGER-8 (e))
  run := fun look rv pkg state method args r budget =>
    (runMeasuredLive bytesOf digestOf look rv pkg state method args r budget).map fun x =>
      (x.1, x.2.1, x.2.2.1, x.2.2.2.1)
  rels := relsOf bytesOf


/-
# Spec.Proofs.Durable2 — §5 DURABILITY, the follower's Store and the resident's volume

**D2, `Durable.follower`.** Every step of follow's command machine (`S.follow`, what `host follow`
answers a `resume` frame with) that persists steps persists a rooted run of the system's own kernel
from follow's World to the World it moves to: each step taken by `S.step` in order, beside the roots
digest of the World it reached, ending at follow's next World. No premise. `follow_answer_persists`
says the frame handler (`Host.Follow.answer`) persists nothing else: a frame persists either no step
or exactly what the machine's step persists.
Not stated (owed): "appended before sent". In `Host.Follow.loop` the `.steps ts` arm runs
`Host.append` (the record, `fsync`ed) before `port.send`, but the loop is `IO` over `Store`/`Port`
records of `IO` actions, so no theorem can speak of their order today; it becomes statable when the
loop is an interpreter over effect records (§11.4, as `Hosting.Resident.Prog` already is). The
`.adopt w'` clause (the adopted World is a `Start`) is A1's (`OneHistory.member`, under
`keyFaithful`), not repeated here.

**D3, `Durable.resident S`** (over the field `S.keep`). The resident's kept answer survives every crash intact or as it
was: a keep stopped after ANY prefix of its steps comes back, in every crash outcome, with the old
kept text or the new one; a completed keep comes back with exactly the new text; the restart's
resume (`durableResumeVia keep`, the deployed `resumeOps`) comes back with exactly what the start
read. Premises of the prefix clause, each an invariant the volume keeps (`Hosting.Proofs.ResidentVolume`,
`fresh_*`, `live_*`, `stable_*`), each true of the empty volume: `Stable` (the kept name and its
file durable), `Fresh` (every inode named is allocated), `Live` (the live entry is remembered); the
resume clause excludes an unreadable entry (the start stops `volume` before resuming it). Over the
contract `Resident.Volume`; that the filesystem meets it is the operator's.
-/
import Spec.Sim.Durable2
import Spec.Proofs.Floor
import Protocol.Proofs.Command
import Host.Follow
import Kernel.Proofs.RootedFold
import Hosting.Proofs.ResidentVolume

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec
open Nanodregg.Hosting.Resident Nanodregg.Hosting.Proofs.ResidentVolume

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## D2: the follower's Store -/

/-- **D2.** What a step of follow's machine persists is a rooted run of the system's kernel from
follow's World to its next one. -/
def Durable.follower (S : System D) : Prop :=
  ∀ (me : Command.Self D) (f f' : Command.Follow D) (kb res : ByteArray) (ts : List (Step D × D))
    (r : Command.Reply), S.follow me f kb res = (f', .steps ts, r) →
    Rooted S.step (World.roots S.X.env) f.world ts f'.world

/-- The system's step is the kernel's, for a system whose `admit`/`refuse` are the kernel's. -/
theorem system_step_eq (S : System D) (ha : S.admit = World.admit S.X.env)
    (hr : S.refuse = World.refuse S.X.env) : S.step = World.step S.X.env := by
  funext w s
  cases s <;> simp [System.step, World.step, ha, hr]

/-- **D2 of the deployed system**: `step_persists_admitted` (PROTOCOL). -/
theorem top_durable_follower (d : ByteArray → ByteArray) : Durable.follower (deployed d) := by
  intro me f f' kb res ts r h
  rw [system_step_eq _ rfl rfl]
  dsimp only [deployed] at h
  exact Command.step_persists_admitted h

/-- What `host follow`'s frame handler persists: no step, or exactly what the machine's step
persists (a `resume` frame); a `command` frame, a hang-up and every refusal persist nothing. -/
theorem follow_answer_persists {X : Ctx D} {dc : Codec.Stream D} {B : Thin.Base (World D)}
    {me : Command.Self D} {fs fs' : Command.Follow D} {fr : Host.Frame} {ts : List (Step D × D)}
    {st : UInt8} {pl : ByteArray}
    (h : Host.Follow.answer X dc B me fs fr = (fs', .steps ts, st, pl)) :
    ts = [] ∨ ∃ kb res r, Command.step X dc B me fs kb res = (fs', .steps ts, r) := by
  unfold Host.Follow.answer at h
  repeat' split at h
  all_goals (try simp only [Prod.mk.injEq] at h)
  all_goals first
    | exact .inl (Command.Persist.steps.inj h.2.1).symm
    | exact .inl (Command.Persist.steps.inj h.2.1)
    | (obtain ⟨rfl, rfl, -⟩ := h; exact .inr ⟨_, _, _, ‹_›⟩)
    | (split at h <;> (try simp only [Prod.mk.injEq] at h) <;> first
        | exact .inl (Command.Persist.steps.inj h.2.1).symm
        | exact .inl (Command.Persist.steps.inj h.2.1)
        | (obtain ⟨rfl, rfl, -⟩ := h; exact .inr ⟨_, _, _, ‹_›⟩))

/-- **FLOOR (D2).** The claim refuses the follower that takes the World it is told: it persists no
step, yet moves its World (one more Turn than it has steps), which no empty run reaches. -/
theorem floor_durable_follower (d : ByteArray → ByteArray) : ¬ Durable.follower (trustingFollower d) := by
  intro h
  have hr := h ⟨oneDigest, oneDigest, oneDigest, 0⟩ ⟨wGenesis, none, none⟩ _ .empty .empty [] _ rfl
  have he : told wGenesis = wGenesis := hr
  have hh := congrArg World.height he
  have hg : wGenesis.height = wGenesis.steps := by
    unfold wGenesis
    simp [genesisWorld, World.genesis]
  simp only [told] at hh
  omega

/-! ## D3: the resident's volume -/

/-- **D3.** A keep is atomic across a crash after any prefix of its steps, durable once complete,
and the resume over it reads back what the start read. -/
def Durable.resident {D : Type} [Ord D] [DecidableEq D] (S : System D) : Prop :=
  (∀ (v : Vol) (w : Where) (s : String), Stable v w.kept → Fresh v → Live v →
    ∀ (n : Nat) (v' : Vol), Crash (v.applyAll ((S.keep w s).take n)) v' →
      v'.read w.kept = v.read w.kept ∨ v'.read w.kept = some (some s)) ∧
  (∀ (v : Vol) (w : Where) (s : String) (v' : Vol), Crash (v.applyAll (S.keep w s)) v' →
    v'.read w.kept = some (some s)) ∧
  (∀ (v : Vol) (w : Where), v.read w.kept ≠ some none → ∀ v' : Vol,
    Crash (v.applyAll (durableResumeVia S.keep w (v.read w.kept))) v' → v'.read w.kept = v.read w.kept)

/-- The resume over the deployed keep is the deployed resume. -/
theorem durableResumeVia_keepOps (w : Where) (r : Option (Option String)) :
    durableResumeVia keepOps w r = resumeOps w r := by
  rcases r with _ | _ | _ <;> rfl

/-- **D3 of the deployed resident**: `keep_atomic`, `keep_durable`, `resume_durable`. -/
theorem top_durable_resident (d : ByteArray → ByteArray) : Durable.resident (deployed d) :=
  ⟨fun v w s hs hf hl n v' hc => keep_atomic v w s hs hf hl n v' hc,
   fun v w s v' hc => keep_durable v w s v' hc,
   fun v w hu v' hc => by
     change Crash (v.applyAll (durableResumeVia keepOps w (v.read w.kept))) v' at hc
     rw [durableResumeVia_keepOps] at hc
     exact resume_durable v w hu v' hc⟩

/-- The empty volume holds every name durably. -/
theorem stable_empty (p : System.FilePath) : Stable Vol.empty p :=
  ⟨rfl, fun _ h => by simp [Vol.empty] at h⟩

/-- **FLOOR (D3).** The claim refuses the in-place keep: from the empty volume, a crash after its
fourth step (`in_place_loses_both`) leaves the kept name unreadable, neither nothing nor the text. -/
theorem floor_durable_resident (d : ByteArray → ByteArray) :
    ¬ Durable.resident { deployed d with keep := inPlaceKeep } := by
  intro h
  obtain ⟨v', hc, hr⟩ := in_place_loses_both Vol.empty durableWhere "a" fresh_empty live_empty
  have := h.1 Vol.empty durableWhere "a" (stable_empty _) fresh_empty live_empty 4 v' hc
  rw [hr] at this
  simp [Vol.read, Vol.empty] at this

end Nanodregg.Spec
/-
# Spec.Proofs.Receipt — §7, the receipt clause: the writer cannot misstate a call in a receipt

**The claim** (`ReceiptTruth`): on every World the system's kernel folds from a genesis World, a
receipt the system's receipt check (`S.receiptCheck`; deployed: `Protocol.Receipt.check`) answers
against that World's own head (its height and roots) tells the truth about that World: `committed h td`
is the journal's entry at the id, `refused h code m` is the World's recorded refusal, and `absent`
is neither a journal entry nor a recorded refusal; each up to a collision among a list fixed by the
receipt and the World. So whoever relays the receipt (the writer included) cannot turn a committed
call into `absent` or `refused`, nor move its entry.

**Premises.** Only the fold from a genesis World: it supplies the trie invariants the lemmas need
(`JournalCanon`, journal heights fitting a u64, `RefusalsOk`), so none is a parameter. The head is
the member's OWN World's: a receipt checked against a head another World holds is §9 (`Foreign`).

Top: `top_receiptTruth` (`check_committed`, `check_refused_sound`, `check_absent`,
`check_absent_unrefused`; `Protocol/Proofs/Receipt.lean`). Floor: `floor_receiptTruth` refuses
`receiptBeliever` (the check that believes the receipt's stated answer). Inhabited:
`inhabited_receiptTruth` (the deployed check answers `committed` for the run's call on the World
the run reaches).
-/
import Spec.Proofs.Floor
import Spec.Sim.Receipt
import Protocol.Proofs.Receipt
import Kernel.Proofs.RootedDeployed

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-- **§7, receipts. A receipt checked against a folded World's own head tells the truth about it.** -/
def ReceiptTruth (S : System D) : Prop :=
  ∀ {name nonce : ByteArray} {a : Nat} {fs : List (ByteArray × D)} {auth : Authority}
    {l : List (Step D)} {w : World D},
    S.fold (genesisWorld S.X name nonce a fs auth) l = .ok w →
    ∀ {txId : D} {nb : Nat} {r : Receipt.Receipt D},
      (∀ {h : Nat} {td : D}, S.receiptCheck w.height (w.roots S.X.env) txId nb r = .ok (.committed h td) →
        w.journalAt S.X.env txId = some (h, td) ∨
          CollidesAmong S.X.env.hash ([rootsPre S.X.env r.root r.jroot r.rroot r.rowsroot, w.rootsPre S.X.env] ++
            inclPres (journalSpec S.X.env) (journalPre S.X.env) txId (h, td) r.jpath w.journal)) ∧
      (∀ {h code : Nat} {m : D}, S.receiptCheck w.height (w.roots S.X.env) txId nb r = .ok (.refused h code m) →
        w.refusalAt S.X.env (.tx txId) = some (.refused h code m) ∨
          CollidesAmong S.X.env.hash ([rootsPre S.X.env r.root r.jroot r.rroot r.rowsroot, w.rootsPre S.X.env] ++
            inclPres (refusalSpec S.X.env) (refusalPre S.X.env) (.refusal (.tx txId)) (.refused h code m) r.rpath
              w.refusals)) ∧
      (S.receiptCheck w.height (w.roots S.X.env) txId nb r = .ok .absent →
        (w.journalAt S.X.env txId = none ∨
          CollidesAmong S.X.env.hash ([rootsPre S.X.env r.root r.jroot r.rroot r.rowsroot, w.rootsPre S.X.env] ++
            readPres (journalSpec S.X.env) txId r.jpath w.journal)) ∧
        (w.refusalAt S.X.env (.tx txId) = none ∨
          CollidesAmong S.X.env.hash ([rootsPre S.X.env r.root r.jroot r.rroot r.rowsroot, w.rootsPre S.X.env] ++
            readPres (refusalSpec S.X.env) (.refusal (.tx txId)) r.rpath w.refusals)))

/-- **§7, receipts, of the deployed system.** -/
theorem top_receiptTruth (d : ByteArray → ByteArray) : ReceiptTruth (deployed d) := by
  intro name nonce a fs auth l w hA txId nb r
  rw [fold_eq_world _ rfl rfl] at hA
  have hjo := fold_journalOk (genesisWorld_journalOk Host.Deployed.X name nonce a fs auth) hA
  have hfit := Receipt.reached_journal_fits hA
  have h0 : (genesisWorld Host.Deployed.X name nonce a fs auth).RefusalsOk Host.Deployed.X.env :=
    refusalsOk_of_empty (by simp [genesisWorld, World.genesis])
  have hro := fold_refusalsOk h0 hA
  refine ⟨fun hk => Receipt.check_committed deployed_lawful (by decide) hjo.1 hfit hk,
    fun hk => Receipt.check_refused_sound deployed_lawful hro hk, fun hk => ⟨?_, ?_⟩⟩
  · exact (Receipt.check_absent deployed_lawful (by decide) hjo.1 hk).2
  · exact Receipt.check_absent_unrefused deployed_lawful hro hk

/-- No two of the floor's listed inputs collide: the forged receipt's roots, the genesis World's,
and the journal path's inclusion inputs for the stated entry. -/
theorem receipt_forged_free :
    collisionFree Xd.env.hash
      ([rootsPre Xd.env receiptForged.root receiptForged.jroot receiptForged.rroot receiptForged.rowsroot,
        wGenesis.rootsPre Xd.env] ++
        inclPres (journalSpec Xd.env) (journalPre Xd.env) wTx (1, oneDigest) receiptForged.jpath wGenesis.journal) =
      true := by
  native_decide

/-- The believing check believes a receipt at the head's own roots, whatever it states. -/
theorem receiptBelieve_stating (H nb : Nat) (w : World Digest) (t : Digest) (a : Receipt.Answer Digest) :
    receiptBelieve H (w.roots Xd.env) t nb (receiptStating w t a) = .ok a := by
  simp [receiptBelieve, receiptStating, World.roots_eq]

theorem receiptBeliever_check (d : ByteArray → ByteArray) : (receiptBeliever d).receiptCheck = receiptBelieve := rfl

theorem deployed_receiptCheck (d : ByteArray → ByteArray) :
    (deployed d).receiptCheck = Receipt.check Host.Deployed.X.env := rfl

/-- **FLOOR (§7, receipts).** The claim refuses the check that believes the receipt: at the genesis
World (empty log), a receipt at its roots stating the run's call committed is believed, though the
genesis World journals nothing and the listed inputs are collision-free. -/
theorem floor_receiptTruth (d : ByteArray → ByteArray) : ¬ ReceiptTruth (receiptBeliever d) := by
  intro h
  have hk : (receiptBeliever d).receiptCheck wGenesis.height (wGenesis.roots Xd.env) wTx 0 receiptForged =
      .ok (.committed 1 oneDigest) := by
    rw [receiptBeliever_check]
    exact receiptBelieve_stating _ _ wGenesis wTx _
  have hc := receipt_forged_free
  rcases (h (name := "spec".toUTF8) (nonce := "spec-0".toUTF8) (a := 100000000)
      (fs := [(wKey, nextKeyDigest Xd wNext)]) (auth := Authority.none) (l := []) (w := wGenesis) rfl).1
      (h := 1) (td := oneDigest) hk
    with hj | col
  · have hj' : wGenesis.journalAt Xd.env wTx = some (1, oneDigest) := hj
    rw [wGenesis, Foreign.genesisWorld_journalAt] at hj'
    cases hj'
  · exact not_collides hc col

theorem receiptOkThen_eq {ε : Type} {r : Except ε (World Digest)} {k : World Digest → Bool}
    (h : receiptOkThen r k = true) : ∃ w, r = .ok w ∧ k w = true := by
  cases r with
  | ok w => exact ⟨w, rfl, h⟩
  | error e => cases h

theorem receiptCommittedB_eq {a : Except Receipt.Refusal (Receipt.Answer Digest)}
    (h : receiptCommittedB a = true) : ∃ hh td, a = .ok (.committed hh td) := by
  unfold receiptCommittedB at h
  split at h
  · exact ⟨_, _, rfl⟩
  · cases h

/-- **The receipt run**: THE re-deriver accepts the run's log from genesis, and the deployed check
answers the reached World's own receipt for the run's call `committed` against that World's head. -/
theorem receipt_run :
    receiptOkThen (rederiveLog Xd wGenesis wLog) (fun w =>
      receiptCommittedB (Receipt.check Xd.env w.height (w.roots Xd.env) wTx 0 (Receipt.build Xd.env w wTx))) =
      true := by
  native_decide

/-- **INHABITED (§7, receipts).** The claim's committed case is reached by the deployed check: on a
World an audited fold from genesis reaches (`audited_deployed`: the fold and `Honest`), a receipt the
check answers `committed`. -/
theorem inhabited_receiptTruth (d : ByteArray → ByteArray) :
    ∃ (name nonce : ByteArray) (a : Nat) (fs : List (ByteArray × Digest)) (auth : Authority)
      (l : List (Step Digest)) (w : World Digest) (txId : Digest) (nb : Nat) (r : Receipt.Receipt Digest)
      (h : Nat) (td : Digest),
      World.fold Xd.env (genesisWorld Xd name nonce a fs auth) l = .ok w ∧
        Honest Xd (genesisWorld Xd name nonce a fs auth) l ∧
        (deployed d).receiptCheck w.height (w.roots Xd.env) txId nb r = .ok (.committed h td) := by
  obtain ⟨w, hw, hk⟩ := receiptOkThen_eq receipt_run
  obtain ⟨h, td, hc⟩ := receiptCommittedB_eq hk
  have hfh := rederiveLog_sound hw
  rw [deployed_receiptCheck]
  revert hfh hc
  generalize Receipt.build Xd.env w wTx = r
  generalize wTx = txId
  generalize wLog = l
  intro hc hfh
  unfold wGenesis at hfh
  exact ⟨_, _, _, _, _, l, w, txId, 0, r, h, td, hfh.1, hfh.2, hc⟩

end Nanodregg.Spec
/-
# Spec.Proofs.Foreign — §9 RECEIPTS BETWEEN WORLDS

**The claim** (`Foreign`): a receipt the system's receipt check (`S.rc`, the check the deployed
program's laws read: `deployed_program_reads`) shows against a head cell holding the roots of a
fold of A from A's genesis names the call it shows, and that call was admitted in that fold (a Turn
of the log with that id, at the height shown, with the turn digest shown), or the hash collides
among an explicit list fixed by the receipt and the fold (the receipt's root inputs, the fold's,
and the journal path's inclusion inputs).

**Premises.** The fold and the check's acceptance fix what the receipt is about. `HeadOf` (the held
head's roots are the fold's) is NAMED and UNDISCHARGEABLE today (PROTOCOL E-3): heads are posted by
grantees, unsigned by A's writer, with no consistency proof between two posts; `inhabited_foreign`
shows it satisfiable. The decoded receipt `r` and turn digest `td` fix the collision list; the
deployed check supplies both (`check_committed_of`).

**Owed** (TOPLEVEL-SPEC §9): A's writer signs step-indexed heads and the head law demands a chain
link from the held head to the new one; `HeadOf` then reduces to "A's writer signs at most one head
per step count", and the conclusion gains "or A's writer equivocated".

Top: `top_foreign` (`Protocol.Proofs.Foreign.foreign_receipt_sound` at `deployed_lawful`). Floor:
`floor_foreign` refuses `acceptingHead` (the check that accepts any head). Inhabited:
`inhabited_foreign` (the deployed check shows a committed receipt against a head of an audited fold).
-/
import Spec.Proofs.Floor
import Spec.Sim.Foreign
import Kernel.Proofs.RootedDeployed

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## The claim -/

/-- **The held head is the head of `wA`** (the undischarged premise, PROTOCOL E-3): if `cell` is a
head object holding an `at` head, its roots decode to `wA`'s roots digest. -/
def HeadOf (S : System D) (cell : Cell) (wA : World D) : Prop :=
  ∀ w c₀ h₀ rootsB s₀, Lang.headView (fun b => (S.dc.decode b).toOption)
      (S.X.env.bytes (Protocol.Foreign.headPackageId S.X.env)) cell = some (.at w c₀ h₀ rootsB s₀) →
    (S.dc.decode rootsB).toOption = some (wA.roots S.X.env)

/-- **§9. A committed receipt is an admission of the World it is a receipt of.** Whatever log `l`
the system's kernel folds from a genesis World of A to `wA`: a receipt `rb` that the receipt check
`S.rc` shows (`s`) against a head cell holding `wA`'s roots (`HeadOf`, the named premise) names the
transaction the check shows, and that transaction was admitted in `l` (a Turn of `l` with that id,
admitted after a prefix folding to `v`, at height `v.height + 1`, with the turn digest shown), or
the hash collides among the receipt's root inputs, `wA`'s, and the journal path's inclusion inputs
(an explicit list, fixed by the receipt and `wA`). -/
def Foreign (S : System D) : Prop :=
  ∀ {name nonce : ByteArray} {a : Nat} {fs : List (ByteArray × D)} {auth : Authority}
    {l : List (Step D)} {wA : World D},
    S.fold (genesisWorld S.X name nonce a fs auth) l = .ok wA →
    ∀ {cell : Cell} {rb : ByteArray} {s : Lang.Seen}, S.rc cell rb = .ok s → HeadOf S cell wA →
    ∀ {r : Receipt.Receipt D} {td : D}, Receipt.ofBytes S.X.env S.dc rb = some r →
      s.turn = S.X.env.bytes td →
      s.tx = S.X.env.bytes r.txId ∧
        ((∃ l₁ t l₂ v v', l = l₁ ++ Step.turn t :: l₂ ∧
            S.fold (genesisWorld S.X name nonce a fs auth) l₁ = .ok v ∧ S.admit v t = .ok v' ∧
            t.txId = r.txId ∧ s.height = v.height + 1 ∧ td = turnDigest S.X.env t) ∨
          CollidesAmong S.X.env.hash ([rootsPre S.X.env r.root r.jroot r.rroot r.rowsroot, wA.rootsPre S.X.env] ++
            inclPres (journalSpec S.X.env) (journalPre S.X.env) r.txId (s.height, td) r.jpath wA.journal))

/-! ## The bridge: the check the claim varies is the one the deployed program reads -/

theorem deployed_program_reads (d : ByteArray → ByteArray) :
    (deployed d).X = Codec.Deployed.ctx
      (Lang.program Digest.bytes Digest.ofBytes? (deployed d).rc) := rfl

/-! ## The top theorem -/

/-- **§9 of the deployed system**: `foreign_receipt_sound` at the deployed `Env` (`deployed_lawful`). -/
theorem top_foreign (d : ByteArray → ByteArray) :
    Foreign (deployed d) := by
  intro name nonce a fs auth l wA hA cell rb s hk hr r td hrb htd
  rw [fold_eq_world _ rfl rfl] at hA
  obtain ⟨htx, h⟩ := Protocol.Foreign.foreign_receipt_sound (X := Host.Deployed.X) deployed_lawful
    (by decide) hA hk hr hrb htd
  refine ⟨htx, ?_⟩
  rcases h with ⟨l₁, t, l₂, v, v', hl, hv, hadm, htx', hh, htd'⟩ | col
  · exact .inl ⟨l₁, t, l₂, v, v', hl, (fold_eq_world (deployed d) rfl rfl _ _).trans hv, hadm, htx', hh, htd'⟩
  · exact .inr col

/-! ## The floor: a check that accepts any head -/

omit [Ord D] [DecidableEq D] in
theorem headView_kind0 (dO : ByteArray → Option D) (pkg : ByteArray) (sl : Slots) :
    Lang.headView dO pkg ⟨0, .rom, sl⟩ = none := by
  simp [Lang.headView, kindObject]

/-- **The receipt decodes**, names the run's call, and no two of the claim's listed inputs collide
at the genesis World with the shown entry `(1, oneDigest)`. -/
theorem run_accept_all :
    (match Receipt.ofBytes Xd.env Codec.Deployed.digestCodec rbAny with
     | some r => decide (r.txId = wTx) &&
        collisionFree Xd.env.hash ([rootsPre Xd.env r.root r.jroot r.rroot r.rowsroot, wGenesis.rootsPre Xd.env] ++
          inclPres (journalSpec Xd.env) (journalPre Xd.env) r.txId (1, oneDigest) r.jpath wGenesis.journal)
     | none => false) = true := by
  native_decide

/-- **FLOOR (§9).** The claim refuses the check that accepts any head: at A's genesis World and the
empty log (no admission exists), a cell that is no head (so `HeadOf` holds), and decoding receipt
bytes naming the call the check shows, the claim's conclusion would need a collision among the
listed inputs, and they are collision-free. -/
theorem floor_foreign (d : ByteArray → ByteArray) : ¬ Foreign (acceptingHead d) := by
  intro h
  have hr := run_accept_all
  cases hro : Receipt.ofBytes Xd.env Codec.Deployed.digestCodec rbAny with
  | none => rw [hro] at hr; cases hr
  | some r =>
    rw [hro] at hr
    dsimp only at hr
    simp only [Bool.and_eq_true] at hr
    obtain ⟨htx, hc⟩ := hr
    have htx' : r.txId = wTx := of_decide_eq_true htx
    have hhead : HeadOf (acceptingHead d) plainCell wGenesis := by
      intro w c₀ h₀ rootsB s₀ hv
      have hv' := hv.symm.trans (headView_kind0 _ _ [])
      cases hv'
    obtain ⟨-, hadm | col⟩ := h (name := "spec".toUTF8) (nonce := "spec-0".toUTF8) (a := 100000000)
      (fs := [(wKey, nextKeyDigest Xd wNext)]) (auth := Authority.none) (l := []) (wA := wGenesis)
      rfl (cell := plainCell) (rb := rbAny) (s := seenAny) rfl hhead (td := oneDigest) hro rfl
    · obtain ⟨l₁, t, l₂, -, -, hl, -⟩ := hadm
      simp at hl
    · exact not_collides hc col

/-! ## Inhabited: the deployed check shows a committed receipt against a head of the fold -/

/-- **The foreign run**: THE re-deriver accepts the run's log from genesis (non-empty); the deployed
check shows that World's receipt for the run's call against the head cell of that World; and the
head cell's held roots decode to that World's roots. -/
theorem run_foreign :
    (match rederiveLog Xd wGenesis wLog with
     | .ok w => !wLog.isEmpty &&
        (match Protocol.Foreign.check Xd.env Codec.Deployed.digestCodec (headCellOf w) (rbOf w) with
         | .ok _ => true | .error _ => false) &&
        (match Lang.headView (fun b => (Codec.Deployed.digestCodec.decode b).toOption)
            (Xd.env.bytes (Protocol.Foreign.headPackageId Xd.env)) (headCellOf w) with
         | some (.at _ _ _ rootsB _) =>
            decide ((Codec.Deployed.digestCodec.decode rootsB).toOption = some (w.roots Xd.env))
         | _ => false)
     | .error _ => false) = true := by
  native_decide

/-- **INHABITED (§9).** Every premise of the claim at the deployed check is reached by a deployed
run: a non-empty log the kernel folds from a genesis World, a head cell holding the fold's roots
(`HeadOf`), and receipt bytes the deployed check shows `committed` against it. -/
theorem inhabited_foreign (d : ByteArray → ByteArray) :
    ∃ (name nonce : ByteArray) (a : Nat) (fs : List (ByteArray × Digest)) (auth : Authority)
      (l : List (Step Digest)) (wA : World Digest) (cell : Cell) (rb : ByteArray) (s : Lang.Seen)
      (r : Receipt.Receipt Digest) (td : Digest),
      (deployed d).fold (genesisWorld (deployed d).X name nonce a fs auth) l = .ok wA ∧ l ≠ [] ∧
        (deployed d).rc cell rb = .ok s ∧
        HeadOf (deployed d) cell wA ∧ Receipt.ofBytes Xd.env Codec.Deployed.digestCodec rb = some r ∧
        s.turn = Xd.env.bytes td := by
  have hr := run_foreign
  cases hw : rederiveLog Xd wGenesis wLog with
  | error e => rw [hw] at hr; cases hr
  | ok w =>
    rw [hw] at hr
    dsimp only at hr
    simp only [Bool.and_eq_true] at hr
    obtain ⟨⟨hne, hk⟩, hv⟩ := hr
    have hfh := rederiveLog_sound hw
    cases hc : Protocol.Foreign.check Xd.env Codec.Deployed.digestCodec (headCellOf w) (rbOf w) with
    | error e => rw [hc] at hk; cases hk
    | ok s =>
      cases hh : Lang.headView (fun b => (Codec.Deployed.digestCodec.decode b).toOption)
          (Xd.env.bytes (Protocol.Foreign.headPackageId Xd.env)) (headCellOf w) with
      | none => rw [hh] at hv; cases hv
      | some hv₀ =>
        cases hv₀ with
        | forked _ => rw [hh] at hv; cases hv
        | «at» w₀ c₀ h₀ rB s₀ =>
          rw [hh] at hv
          dsimp only at hv
          have hro := of_decide_eq_true hv
          obtain ⟨-, -, -, -, -, -, r, td, -, -, hrb, -, htd, -⟩ := Protocol.Foreign.check_committed_of hc
          have hhead : HeadOf (deployed d) (headCellOf w) w := by
            intro w₁ c₁ h₁ rB₁ s₁ hv₁
            have hv₁' : Lang.headView (fun b => (Codec.Deployed.digestCodec.decode b).toOption)
                (Xd.env.bytes (Protocol.Foreign.headPackageId Xd.env)) (headCellOf w) =
                some (.at w₁ c₁ h₁ rB₁ s₁) := hv₁
            rw [hh] at hv₁'
            simp only [Option.some.injEq, Lang.HeadView.at.injEq] at hv₁'
            obtain ⟨-, -, -, rfl, -⟩ := hv₁'
            exact hro
          have hne' : wLog ≠ [] := by
            intro he; rw [he] at hne; cases hne
          revert hfh hc hhead hrb htd hne'
          generalize headCellOf w = cell
          generalize rbOf w = rb
          generalize wLog = l
          intro hfh hc hrb htd hhead hne'
          have hf := hfh.1
          unfold wGenesis at hf
          exact ⟨_, _, _, _, _, l, w, cell, rb, s, r, td,
            (fold_eq_world (deployed d) rfl rfl _ _).trans hf, hne', hc, hhead, hrb, htd⟩

end Nanodregg.Spec


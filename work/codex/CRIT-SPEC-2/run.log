/-
# Spec.Proofs.Member — A1 of the deployed system: the member's World is an audited fold from a start

`step_world_start`: one frame of the command machine leaves follow's World as it was, moves it by
`absorbPage` (every event re-derived), or adopts a base `Thin.accept` took under the pin of an
invitation signed by the key the CONTINUATION names, for the member's own World. (A sharpening of
`Protocol.Proofs.FollowHead.step_world`, whose third arm says only `atGenesis`.) Under a relay whose
`adopt` continuations name the trusted key (`keyFaithful`), that base is a `Start`; every other move
is an audited fold (`Host.absorb_sound`), and folds compose (`fold_append`, `honest_append`).
-/
import Spec.Proofs.Bridge
import Protocol.Proofs.FollowHead
import Protocol.Proofs.Thin
import Host.Proofs.Refine
import Codec.Proofs.Deployed

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-- **What one frame does to follow's World**, with the adopt arm's evidence. -/
theorem step_world_start {X : Ctx D} {dc : Codec.Stream D} {B : Thin.Base (World D)}
    {me : Command.Self D} {f f' : Command.Follow D} {p : Command.Persist D} {kb res : ByteArray}
    {r : Command.Reply} (h : Command.step X dc B me f kb res = (f', p, r)) :
    f'.world = f.world ∨
      (∃ (evs : List ByteArray) (steps : Nat) (chain : ByteArray) (base : Nat)
          (ts : List (Kernel.Step D × D)) (wb : Option (World D)),
        Command.absorbPage X f.world evs steps chain base = .ok (f'.world, ts, wb)) ∨
      (∃ (st : Command.State) (inv key : ByteArray) (i : Invite.Invitation D)
          (dl : Option Thin.Download) (page : Thin.Page),
        Command.State.ofBytes kb = some st ∧
        Command.parse X.digestOf st.argv = .ok (Command.Cmd.adopt inv key) ∧
        Command.adoptPin X me inv key = .ok i ∧ Thin.accept B i.pin dl page = .ok (.done f'.world) ∧
        f'.world.origin = me.world) := by
  unfold Command.step at h
  repeat' split at h
  all_goals (try simp only [Prod.mk.injEq] at h)
  all_goals (repeat' split at h)
  all_goals (try simp only [Prod.mk.injEq] at h)
  all_goals (try (obtain ⟨rfl, -, -⟩ := h))
  all_goals first
    | exact .inl rfl
    | exact .inr (.inl ⟨_, _, _, _, _, _, Command.absorbSync_ok ‹_›⟩)
    | skip
  all_goals (try (cases ‹_ = Command.Cmd.adopt _ _›))
  all_goals
    have hst := ‹Command.State.ofBytes kb = some _›
    have hp := ‹Command.parse _ _ = Except.ok (Command.Cmd.adopt _ _)›
    have hpin := ‹Command.adoptPin _ _ _ _ = Except.ok _›
    have hacc := ‹Thin.accept _ _ _ _ = Except.ok (Thin.Progress.done _)›
    have ho := ‹¬ _ ≠ me.world›
    rw [hst] at hp
    exact .inr (.inr ⟨_, _, _, _, _, _, hst, hp, hpin, hacc, by simpa using ho⟩)


private abbrev Xd : Ctx Digest := Host.Deployed.X

/-- The deployed World codec is canonical (`Thin.accept_done`'s premise). -/
theorem world_canonical (b : ByteArray) (v : World Digest)
    (h : Host.Deployed.world.decode b = .ok v) : Host.Deployed.world.bytes v = b :=
  (Codec.Deployed.eq_bytes_of_world_decode (w := v) h).symm

/-- An absorbed run of events is an audited fold (the deployed call codec is canonical). -/
theorem absorb_audited {w w' : World Digest} {acc ts : Array (Kernel.Step Digest × Digest)}
    {evs : List ByteArray} (h : Command.absorb Xd w acc evs = .ok (w', ts)) :
    ∃ l, World.fold Xd.env w l = .ok w' ∧ Honest Xd w l := by
  obtain ⟨ps, -, hr, hh, -⟩ := Host.absorb_sound (fun _ _ hd => (Codec.Deployed.eq_callBytes_of_decodeCall _ hd).2.symm) h
  exact ⟨_, RootedFold.fold hr, hh⟩

/-- **One frame of the deployed follower, under a key-faithful relay**: follow's World moves by an
audited fold, or it is replaced by a start (an adopted base pinned by the trusted sponsor). -/
theorem moves_deployed {d : ByteArray → ByteArray} {me : Command.Self Digest} {trusted : ByteArray}
    {w w' : World Digest} (hm : Moves (deployed d) (keyFaithful (deployed d)) me trusted w w') :
    (∃ l, World.fold Xd.env w l = .ok w' ∧ Honest Xd w l) ∨ Start (deployed d) me trusted w' := by
  obtain ⟨f, f', kb, res, p, r, hk, rfl, hs, rfl⟩ := hm
  have hs' : Command.step Xd Codec.Deployed.digestCodec (deployed d).B me f kb res = (f', p, r) := hs
  rcases step_world_start hs' with he | ⟨evs, steps, chain, base, ts, wb, ha⟩ |
      ⟨st, inv, key, i, dl, page, hst, hp, hpin, hacc, ho⟩
  · exact .inl ⟨[], by rw [he]; rfl, trivial⟩
  · obtain ⟨wb', tb, ts', h₁, h₂, -⟩ := Command.absorbPage_ok ha
    obtain ⟨l₁, f₁, hh₁⟩ := absorb_audited h₁
    obtain ⟨l₂, f₂, hh₂⟩ := absorb_audited h₂
    exact .inl ⟨l₁ ++ l₂, fold_append.mpr ⟨_, f₁, f₂⟩, honest_append hh₁ f₁ hh₂⟩
  · obtain rfl := hk st inv key hst hp
    obtain ⟨hd, hn⟩ := Thin.accept_done world_canonical hacc
    exact .inr (.pinned hpin hd hn ho)

/-- **A1 of the deployed system, under a key-faithful relay.** -/
theorem top_oneHistory_member (d : ByteArray → ByteArray) :
    OneHistory.member (deployed d) (keyFaithful (deployed d)) := by
  intro me trusted w₀ w hs hr
  induction hr with
  | refl => exact ⟨_, [], hs, audited_deployed.mpr ⟨rfl, trivial⟩⟩
  | tail _ hm ih =>
    obtain ⟨w₁, l, hs₁, ha⟩ := ih
    rw [audited_deployed] at ha
    rcases moves_deployed hm with ⟨l', hf', hh'⟩ | hs'
    · exact ⟨w₁, l ++ l', hs₁, audited_deployed.mpr
        ⟨fold_append.mpr ⟨_, ha.1, hf'⟩, honest_append ha.2 ha.1 hh'⟩⟩
    · exact ⟨_, [], hs', audited_deployed.mpr ⟨rfl, trivial⟩⟩

end Nanodregg.Spec
/-
# Spec.Proofs.Deployed — the claims, of the deployed system

`theorem top_* : Claim (deployed d)` for each claim of `Spec.Proofs.Claims` whose proof is a
composition of lemmas the tree already proves. The proofs are untrusted; what is trusted is the
statement in `Claims` and its floor in `Floor`.
-/
import Spec.Proofs.Bridge
import Kernel.Proofs.Value
import Kernel.Proofs.ObjectHead
import Kernel.Proofs.RootedDeployed
import Codec.Proofs.Digest
import Protocol.Proofs.Settle
import Protocol.Proofs.Command
import Protocol.Proofs.Behind
import Protocol.Proofs.Envelope

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

/-- **B2 of the deployed system**: `fold_value`, `fold_floors`. -/
theorem top_integrity_value (d : ByteArray → ByteArray) : Integrity.value (deployed d) := by
  intro w w' l hc hf dd
  rw [fold_eq_world _ rfl rfl] at hf
  exact ⟨fold_value dd hc hf, fun hd => fold_floors hc hf hd⟩

/-- **A2 of the deployed system**: `fold_reaches_host` at the deployed `Env` (`deployed_lawful`). -/
theorem top_oneHistory_pair (d : ByteArray → ByteArray) : OneHistory.pair (deployed d) := by
  intro g wf wg lf lg hf hg hs hc
  rw [fold_eq_world _ rfl rfl] at hf hg
  exact fold_reaches_host deployed_lawful hg hf hs hc

/-- **B3 of the deployed system, for `NoRef` laws**: `object_history_of_honest`,
`fold_package_fixed`, `object_history_chain` (stated for every history) at the deployed program
(`deployed_ctx_lawful`). -/
theorem top_integrity_law (d : ByteArray → ByteArray) : Integrity.law (deployed d) := by
  intro obj law p fs ℓ t hb hℓ hfind hlaw hnr w w' l ha hcan cell hl hk
  rw [audited_deployed] at ha
  obtain ⟨tr, htr⟩ := object_history_of_honest ha.1 ha.2 hcan hl hk
  obtain ⟨cell', hl', -, -, hpk⟩ := fold_package_fixed ha.1 ha.2 hl hk
  exact ⟨⟨tr, htr⟩, ⟨cell', hl', hpk⟩, fun tr' htr' hin _ ho =>
    object_history_chain (deployed_ctx_lawful _) rfl hb hℓ hfind hlaw hnr htr' hin hl ho⟩

/-- **C(ii) of the deployed system, submit-class**: `step_settled_ok`, `settle_committed`. -/
theorem top_consent_okCommitted (d : ByteArray → ByteArray) : Consent.okCommitted (deployed d) := by
  intro me f f' kb res o e p argv acc hst h
  obtain ⟨cb, c, hh, td, hl, hd, hs⟩ := Command.step_settled_ok hst h
  exact ⟨cb, c, hh, td, hl, hd, Settle.settle_committed hs⟩

/-- **C(iii) of the deployed system**: a settlement other than `refused stale` is the receipt's
verdict with no staleness read, which `settle_final_never_admits` makes final. -/
theorem top_consent_final (d : ByteArray → ByteArray) : Consent.final (deployed d) := by
  intro me w w' c l hrc hjc hv hf out
  rw [fold_eq_world _ rfl rfl] at hf
  refine Settle.settle_final_never_admits hrc hjc ?_ hf out
  change Settle.ofReceipt _ (Command.staleBehind (deployed d).X me w c) _ _
      (Receipt.build (deployed d).X.env w (txIdOf (deployed d).X c)).answer = _ ∨
    ∃ code, code ≠ staleCode ∧ Settle.ofReceipt _ (Command.staleBehind (deployed d).X me w c) _ _
      (Receipt.build (deployed d).X.env w (txIdOf (deployed d).X c)).answer = _ at hv
  generalize Command.staleBehind (deployed d).X me w c = b at hv
  generalize (Receipt.build (deployed d).X.env w (txIdOf (deployed d).X c)).answer = a at hv ⊢
  cases a <;> simp only [Settle.ofReceipt] at hv ⊢ <;> (repeat' split at hv) <;> (repeat' split) <;>
    simp_all

/-- **G2 of the deployed system**: both of `handle`'s `defer` arms sit under `Envelope.check`, whose
acceptance is the live grant chain, the current key and the verifying signature (`Envelope.check_ok_iff`). -/
theorem top_shown (d : ByteArray → ByteArray) : Shown.onlyFollowers (deployed d) := by
  intro w f dd h
  suffices hs : ∃ e, Envelope.ofBytes Host.Deployed.X f.payload = some e ∧
      Envelope.check Host.Deployed.X w e = .ok () by
    obtain ⟨e, he, hc⟩ := hs
    obtain ⟨-, -, hk, hv, hm, -, -⟩ := (Envelope.check_ok_iff Host.Deployed.X w e).mp hc
    exact ⟨e, he, hc, hm, hk, hv⟩
  change Host.handle Host.Deployed.X w f = .defer dd at h
  unfold Host.handle at h
  repeat' split at h
  all_goals first
    | (cases h; done)
    | exact ⟨_, ‹_›, ‹_›⟩
    | (simp at h)

/-- **C(ii), cancel, of the deployed system**: `cancel_ok_settled` (PROTOCOL-71). -/
theorem top_consent_cancelOk (d : ByteArray → ByteArray) : Consent.cancelOk (deployed d) :=
  fun _ _ _ _ _ _ _ _ _ _ hst hcmd h => Command.cancel_ok_settled hst hcmd h

/-- **C(iii), stale, of the deployed system**: a `refused stale` settlement is either the receipt's
recorded refusal (final by `settle_final_never_admits`) or follow's own `staleBehind`
(`staleBehind_final`, at the deployed `Env`). -/
theorem top_consent_staleFinal (d : ByteArray → ByteArray) : Consent.staleFinal (deployed d) := by
  intro me w₀ w w' l₁ l₂ key cmd rs b u c hfit hrc hok hrs hplan hcu hrfc hjc h₁ h₂ hv
  rw [fold_eq_world _ rfl rfl] at h₁ h₂
  change Settle.ofReceipt (journalForgets w.height c.unsigned.notBefore)
    (Command.staleBehind Host.Deployed.X me w c) w.height c.unsigned.validUntil
    (Receipt.build Host.Deployed.X.env w (txIdOf Host.Deployed.X c)).answer = .refused staleCode at hv
  cases hb : Command.staleBehind Host.Deployed.X me w c with
  | true => exact Command.staleBehind_final deployed_lawful hfit hrc hok hrs hplan hcu h₁ h₂ hb
  | false =>
    rw [hb] at hv
    exact .inl fun out => Settle.settle_final_never_admits hrfc hjc (.inr ⟨_, hv⟩) h₂ out

end Nanodregg.Spec


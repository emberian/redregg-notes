/-
# Host.Loop — the resident loop of `host serve`

    serve fuel:
      batch  ← one frame (blocking), then what is already queued (≤ batchMax frames, ≤ batchBytesMax)
      (w', out) := admitBatch w batch                    -- pure (Host.Batch)
      if out.staged ≠ ∅: append one Log frame of the batch record; sync
         failure → every reply of the batch is `uncertain`; stop (`Exit.uncertain`)
      send out.replies
      serve (fuel - 1)

Group commit with no timer (HOST-3): while one sync runs, requests queue in the channel and become
the next batch. Replies leave only after the sync, so no reply reports a state a crash can take
back. A failed append or sync is never retried (HOST-4: after a failed fsync the kernel may have
dropped the dirty pages); the supervisor restarts the Host and `recover` decides what is on disk.

A round of `serve` runs `fuel` batches and returns `Exit.fuel`; `restarts` (the resident's one
fuel-and-restart loop, LAW 4 as amended) then reopens the Store from disk IN PROCESS, asserts the
reopened state is the state the loop held (`reopenDiverged` otherwise), and serves the next round
on the same port. So reopen runs routinely and no connection notices (D4). The loop holds no frame
between batches: a frame that does not fit a batch goes back into the port (`Port.unread`), so a
round can end at any batch boundary without dropping one (`Host.Proofs.Loop.drainM_conserves`).

The physical store is a record of two IO actions (`Store`), so the simulation and the crash plants
drive this same loop over an in-memory disk (`Host.MemStore`), and `host serve` over the file.
-/
import Host.Batch
import Host.Base
import Host.Wire
import Protocol.Table
import Std.Sync.Channel

namespace Nanodregg.Host

open Nanodregg.Codec (Digest)

/-- The physical segment, as the loop sees it. -/
structure Store where
  /-- write all of these bytes at the end of the segment -/
  append : ByteArray → IO Unit
  /-- make every appended byte durable (`F_FULLFSYNC` / `fdatasync`) -/
  sync : IO Unit

/-- Where requests come from and replies go. -/
structure Port where
  /-- block for the next frame; `none` once the stream has stopped -/
  recv : IO (Option Frame)
  /-- a frame already queued, without blocking -/
  poll : IO (Option Frame)
  /-- put a frame back at the front: the next `recv` or `poll` returns it. Called only right after
  a `poll` returned it, so the port holds at most one frame put back. -/
  unread : Frame → IO Unit
  send : Reply → IO Unit
  /-- stop accepting frames; the ones already queued stay readable by `poll` -/
  close : IO Unit

structure Limits where
  batchMax : Nat
  batchBytesMax : Nat

/-- Why `serve` returned (law 7: each by name, `Exit.name`). -/
inductive Exit where
  /-- the request stream ended -/
  | eof
  /-- the batch budget of this round is spent; `restarts` reopens and continues -/
  | fuel
  /-- an append or sync failed: the batch's replies were `uncertain`; restart and recover -/
  | uncertain (detail : String)
  /-- a seal failed; every reply already sent is durable in the segment; restart and recover -/
  | sealFailed (fault : SealFault)
  /-- a batch the recorder refuses (more Turns than one record holds, `bytes = none`) or whose
  record is over `Cadence.recordBytesMax` bytes: the batch was not appended and its replies were
  `uncertain`. At the deployed cadence the byte arm never fires on steps `World.step` took
  (`Host.Deployed.recorder_encode_size_le`, HOST-47); it stays as the refusal of anything else. -/
  | recordTooLarge (turns : Nat) (bytes : Option Nat)
  /-- a fuel restart's reopen refused (the refusal's name) -/
  | reopenFailed (name : String)
  /-- the reopened Store is not the state the loop held: a defect in the open or the append path -/
  | reopenDiverged
  /-- the resident's restart budget is spent (unreachable before the port's own lifetime bound) -/
  | lifetime
  /-- the request stream stopped other than at a frame boundary, or at the reader's lifetime -/
  | stream (stop : Stop)
  deriving Repr

def Exit.name : Exit → String
  | .eof => "eof"
  | .fuel => "fuel"
  | .uncertain _ => "uncertain"
  | .sealFailed _ => "sealFailed"
  | .recordTooLarge _ _ => "recordTooLarge"
  | .reopenFailed _ => "reopenFailed"
  | .reopenDiverged => "reopenDiverged"
  | .lifetime => "lifetime"
  | .stream _ => "stream"

/-- How the loop seals a base: `write w seg entries index` appends `entries` (the index entries
since the last base, never the whole index: HOST-30) to the index file after the `index.count`
entries there, syncs them, then writes the base of `w`, which is the segment prefix
`[0, seg.offset)` chained to `seg.tag`, counting the entries up to the last appended, durably; it
returns the World's encoded size, the digest of its bytes and what the new base names of the
index (HOST-33). With `async`
(`host serve`) it runs in a dedicated Task over the immutable `w`, off the loop; without it (the
simulation) it runs inline, so a seeded run seals at the same points every time. -/
structure Checkpoint (W : Type) where
  /-- returns the World's encoded size, the digest of its bytes (`Keys.worldDigest`) and the
  entry count and last tag the new base names -/
  write : W → Position → Array Entry → IndexAt → IO (Except SealFault (Nat × ByteArray × IndexAt))
  /-- start the segment file the seal of `w` at `pos` will name, after `count` index entries
  (HOST-64: every base sits at the start of its own file); when the newest file starts there
  already, it is reused only if its header passes `headerFault` at that place, else `positionUnfit` -/
  rotate : W → Position → Nat → IO (Except SealFault Unit)
  async : Bool
  /-- Received-base adoption, atomically selecting a fresh physical identity. -/
  adopt : W → W → Position → IO (Except SealFault (Nat × ByteArray × IndexAt)) :=
    fun _ _ pos => pure (.error (.positionUnfit pos.offset))

/-- How the loop writes a batch record and indexes it: the record of the staged entries (each step
with the roots digest after it, HOST-29, KERNEL-47) given the World after them, and the log
position of a World: its step count and chain (`Env.bytes`). The position is steps, not height: a
recorded refusal is a step at an unchanged height. -/
structure Recorder (W T : Type) where
  /-- the batch record of the staged pairs, or `none` when they are more than one record may hold -/
  encode : W → Array T → Option ByteArray
  mark : W → Nat × ByteArray

/-- A seal in flight: the offset it seals at, the sealed World's step count and chain, the index
entries its base will name, and its Task. -/
structure Pending where
  offset : Nat
  steps : Nat
  chain : ByteArray
  indexCount : Nat
  task : Task (Except IO.Error (Except SealFault (Nat × ByteArray × IndexAt)))

/-- Everything the resident loop holds. -/
structure Resident (W : Type) where
  world : W
  pos : Position
  sealed : Sealed
  /-- one entry per record AFTER the newest durable base, in order: entries
  `sealed.index.count, sealed.index.count + 1, …` of the index. The base's own are on disk in
  the index file; the loop never holds them (HOST-33: RAM O(tail), not O(records)) -/
  index : Array Entry
  pending : Option Pending := none

/-- A frame of `n` bytes appended at `pos` keeps the tail after the newest durable base within
`tailMax` (HOST-14 condition 4). `commitBatch` cannot be called without a proof of it. -/
def withinTail (c : Cadence) (sealed : Sealed) (pos n : Nat) : Bool :=
  decide (pos + n - sealed.offset ≤ c.tailMax sealed.bytes)

/-- Take the queued frames after `first`: at most `limits.batchMax` frames and, past the first,
`limits.batchBytesMax` payload bytes. A frame that does not fit is put back (`unread`), so the
caller holds nothing but the batch. Generic in the monad so its conservation is a theorem over a
list model of the port (`Host.Proofs.Loop.drainM_conserves`); the loop runs it in `IO`. -/
def drainM {m : Type → Type} [Monad m] (poll : m (Option Frame)) (unread : Frame → m Unit)
    (limits : Limits) (first : Frame) : m (Array Frame) :=
  go limits.batchMax #[first] first.payload.size
where
  go : Nat → Array Frame → Nat → m (Array Frame)
    | 0, acc, _ => pure acc
    | fuel + 1, acc, bytes => do
      if limits.batchMax ≤ acc.size then return acc
      match ← poll with
      | none => return acc
      | some f =>
        if limits.batchBytesMax < bytes + f.payload.size then
          unread f
          return acc
        go fuel (acc.push f) (bytes + f.payload.size)

def drain (port : Port) (limits : Limits) (first : Frame) : IO (Array Frame) :=
  drainM port.poll port.unread limits first

variable {W T R : Type}

/-- The replies of a batch whose append did not complete: all `uncertain`. -/
def uncertainAll (replies : Array Reply) : Array Reply :=
  replies.map fun r => { r with status := Protocol.Status.uncertain.code, payload := ByteArray.empty }

/-- Append one batch record as one Log frame and make it durable. Only within the tail bound. -/
def commitBatch (c : Cadence) (sealed : Sealed) (store : Store) (s : Log.Sealer) (pos : Position)
    (record : ByteArray) (_within : withinTail c sealed pos.offset (frameSize record) = true) :
    IO (Except String Position) := do
  try
    store.append (Log.frame s pos.tag.bytes record)
    store.sync
    return .ok ⟨pos.offset + frameSize record, tagDigest s (pos.tag.bytes ++ record)⟩
  catch e => return .error (toString e)

/-- The entries a seal writes: every entry the loop holds (those after the newest base), as a
fresh Array. The Task is handed this and never the loop's own index, so no `push` on the loop
shares an array with a Task (a shared push copies the whole array, on the request path, law 5;
HOST-30). -/
def sealEntries (index : Array Entry) : Array Entry :=
  index.extract 0 index.size

/-- Start sealing `w` at `pos` in a dedicated Task, after the newest base `sealed`, in a segment file
started at `pos` (`Checkpoint.rotate`). -/
def spawnSeal (ck : Checkpoint W) (mark : W → Nat × ByteArray) (w : W) (pos : Position)
    (sealed : Sealed) (index : Array Entry) : IO Pending := do
  let (h, chain) := mark w
  let fresh := sealEntries index
  let count := sealed.index.count + index.size
  -- the file the base will name starts here, before the seal runs: a refused rotation is the
  -- seal's refusal, by name (`settle`), and nothing was appended to a file that does not exist
  if let .error f ← ck.rotate w pos count then
    return ⟨pos.offset, h, chain, count, .pure (.ok (.error f))⟩
  if ck.async then
    return ⟨pos.offset, h, chain, count, ← IO.asTask (ck.write w pos fresh sealed.index) .dedicated⟩
  else
    return ⟨pos.offset, h, chain, count, .pure (.ok (← ck.write w pos fresh sealed.index))⟩

/-- Wait for a seal; the base it made is the newest durable one. -/
def settle (p : Pending) : IO (Except SealFault Sealed) := do
  match ← IO.wait p.task with
  | .error e => return .error (.io (toString e))
  | .ok (.error f) => return .error f
  | .ok (.ok (bytes, digest, index)) =>
    -- the pair assertion (HOST-50): the base counts exactly the entries the loop handed the seal,
    -- so `Resident.install` drops exactly those (`Host.install_total`'s premise)
    if index.count ≠ p.indexCount then
      return .error (.io s!"seal returned index count {index.count}, handed {p.indexCount}")
    return .ok ⟨p.offset, bytes, p.steps, p.chain, digest, index⟩

/-- Take up a settled base: it is the newest durable one, and the entries it counts leave the
loop's memory (they are on disk), so the loop holds only the entries after it. O(entries held)
once per seal. -/
def Resident.install (r : Resident W) (sealed : Sealed) : Resident W :=
  { r with sealed, pending := none,
           index := r.index.extract (sealed.index.count - r.sealed.index.count) r.index.size }

/-- A finished seal is taken up without waiting. -/
def reap (r : Resident W) : IO (Except SealFault (Resident W)) := do
  match r.pending with
  | none => return .ok r
  | some p =>
    if ← IO.hasFinished p.task then
      match ← settle p with
      | .ok sealed => return .ok (r.install sealed)
/-
# Kernel.Proofs.Logic.History — a World's history around one object, lifted once to every law (KERNEL-28, Q3)

`Lang.Proofs.Chain` lifts ONE law's admitted steps to a history (`Std.Chain`, its schemes). This
module is the kernel's half: what the World does around one object is a chain of steps each law in
force admitted, for every body kind, proved once.

* `ObjectStep X obj w w' e`: one step of the World from `w` to `w'`, as `obj` sees it. Steps that
  leave `obj` alone record nothing (`e = none`): a recorded refusal (`refusal`), an admitted turn
  that touches it nowhere and does not bear it (`other`, any turn), a call-derived turn whose
  footprint does not hold it (`frame`, by `CallFoot`), a call-derived turn that pins it, keeps it,
  and neither writes it, changes its laws, nor dispatched any invoke of it (`keep`). So a step that
  invoked the object is never filed as one that left it alone, even when its run kept the state:
  an invoke's own effect is a touch of the object (`other`, `frame` exclude it) and `keep` says
  "no invoke" outright; a history counts every invoke it holds. Steps that judge it record what the judge saw (`e = some (look, pkg,
  laws, req, old, new, calls)`): the signed `write` of it (over a canonical cell), the signed `law`
  of it (the `relaw` judgement, over the unchanged state), the signed `invoke` of it, and an invoke
  of it NESTED in another call's tree (`Dispatched`; the order laws are its route's price).
* `ObjectHistory X obj w w' tr`: the Kleene star; `tr` is the judged steps, in order.
* `object_step_none`, `object_step_some`: a step that records nothing keeps `obj`'s entry; a
  judged step's `old` is the live state, the laws in force passed `old → new` (`write_judged`,
  `law_judged`, `invoke_next_judged`, `invoke_tree_slots`), and the next live state reads `new` at
  every key (`write_next_slots`, `law_next_slots`, `invoke_next_slots`, `invoke_tree_slots`).
* `object_history_of_honest`: THE TOTALITY at the log: an honest folded log from a canonical World
  (`CellsCanon`, from genesis by `genesis_cellsCanon`/`fold_cellsCanon`) is an `ObjectHistory` of
  every object live at its start (`object_turn_cases` per turn: no receiver but write, law and
  invoke writes an object). For an object born inside the log, split the log at its birth (the
  object must be live at the history's start).
* `object_history_chain`: THE LIFT: for a `NoRef` law `t` (field `ℓ` of the package `p` that the law
  id reads as in every judged step's view) in force at every judged step, the history projects to
  `Std.Chain (Std.Step [] t)` from the object's state, step for step (`judgeOne_admits_relib`; a
  `relaw` keeps the state, so each step is a `Step`, not only an `Admits`).

The polarity (PROOF-ENGINEERING Q3): wp over the fold (a step is "if it committed then"), sp over
the law (`Std.Admits` stays existential; a faulting law has no derivation, so no step).
Teeth (`Kernel.Proofs.Logic.HistoryWitness`): `object_history_chain_witnessed` (every premise of
the lift holds together, through `Lang.program`, on a signed invoke whose run moves the state, with
the counter's `NoRef` law in force); `write_history_witnessed` (a write step, at a data object);
`object_history_needs_inForce` (on that write history, whose step no law judged, a law that admits
nothing has no chain: drop the in-force premise and the conclusion is false); the steps' own: `write_needs_canon` (`write`'s canonicity),
`law_slots_need_bound`, `effect_at_object_needs_kind` (the totality), `effectsPinned_unlawful_ord`
(`nested`'s order laws). `object_history_runs`: each judged step's calls are its run's;
`object_history_start`: a history with a judged step starts at a live object whose state reads.
-/
import Kernel.Proofs.WriteNext
import Kernel.Proofs.InvokeTree
import Kernel.Proofs.Logic.Triple
import Lang.Proofs.Chain
import Lang.Proofs.Extract
import Lang.Proofs.Invoke
import Lang.Proofs.LawReceiver

namespace Nanodregg.Kernel.Receive

open Nanodregg.Kernel

variable {D : Type} [Ord D] [DecidableEq D]

/-- **One step of the World around `obj`.** `none`: the step leaves `obj` alone; `some (look, pkg,
laws, req, old, new, calls)`: the step judged `obj`'s state `old → new` under `req`, in the view
`look`, by the package `pkg` (an invoke's) and the laws `laws` (the cell's), and returned `calls`
(an invoke's; `[]` for a write or a law). -/
inductive ObjectStep (X : Ctx D) (obj : D) :
    World D → World D → Option (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D)) → Prop
  | refusal {w w' : World D} {r : Refused D} : World.refuse X.env w r = .ok w' → ObjectStep X obj w w' none
  | other {w w' : World D} {t : Turn D} :
      World.admit X.env w t = .ok w' → (∀ x ∈ t.touches, x.cell ≠ obj) → obj ∉ createdIds t →
      ObjectStep X obj w w' none
  | keep {w w' : World D} {c : Call D} {t : Turn D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' →
      (∀ x ∈ t.touches, x.cell = obj → x.act = .keep) → obj ∉ createdIds t →
      (∀ edits via, c.unsigned.body ≠ .write obj edits via) → (∀ laws via, c.unsigned.body ≠ .law obj laws via) →
      (∀ n wk actor method args budget via, ¬ Dispatched X w c n wk actor (.invoke obj method args budget via)) →
      ObjectStep X obj w w' none
  | frame {w w' : World D} {c : Call D} {t : Turn D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' → ¬ CallFoot X c w (.cell obj) →
      ObjectStep X obj w w' none
  | write {w w' : World D} {c : Call D} {t : Turn D} {edits : List (Nat × Option ByteArray)} {via : Option D}
      {cell : Cell} {principal : D} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' → c.unsigned.body = .write obj edits via →
      w.live X.env obj = some cell → Slots.ascending cell.slots = true →
      ownerAuthority X (pinned X.env w c.unsigned.pins) c.unsigned.member obj cell .mutate via = .ok principal →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, none, laws,
        reqOf c.unsigned obj principal .write, stateOf cell, applyEdits (stateOf cell) edits, []))
  | law {w w' : World D} {c : Call D} {t : Turn D} {laws' : List D} {via : Option D}
      {cell : Cell} {principal : D} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' → c.unsigned.body = .law obj laws' via →
      w.live X.env obj = some cell →
      ownerAuthority X (pinned X.env w c.unsigned.pins) c.unsigned.member obj cell .mutate via = .ok principal →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, none, laws,
        reqOf c.unsigned obj principal (.relaw laws'), stateOf cell, stateOf cell, []))
  | invoke {w w' : World D} {c : Call D} {t : Turn D} {method : Nat} {args : ByteArray} {budget : Nat}
      {via : Option D} {cell : Cell} {p : D} {r : Req D} {s : Slots} {calls : List (Body D)}
      {rows : List (RowSlot D × RowAct)} {used : Nat} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' →
      c.unsigned.body = .invoke obj method args budget via →
      invokeRun X (pinned X.env w c.unsigned.pins) c c.unsigned.member obj method via = .ok (cell, p, r) →
      X.program.run (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) p (stateOf cell)
        method args r (min budget (poolOf c.unsigned.body)) = .ok (s, calls, rows, used) →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, some p, laws, r, stateOf cell, s, calls))
  | nested [Std.TransOrd D] [Std.LawfulEqOrd D] {w w' : World D} {c : Call D} {t : Turn D} {n : Nat}
      {wk : Walk D} {actor : D} {method : Nat} {args : ByteArray} {budget : Nat}
      {via : Option D} {cell : Cell} {p : D} {r : Req D} {s : Slots} {calls : List (Body D)}
      {rows : List (RowSlot D × RowAct)} {used : Nat} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' →
      Dispatched X w c n wk actor (.invoke obj method args budget via) →
      invokeRun X (pinned X.env w c.unsigned.pins) c actor obj method via = .ok (cell, p, r) →
      X.program.run (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) p (stateOf cell)
        method args r (min budget wk.pool) = .ok (s, calls, rows, used) →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, some p, laws, r, stateOf cell, s, calls))

/-- **A history of the World around `obj`**, from `w` to `w'`: the judged steps, in order. -/
inductive ObjectHistory (X : Ctx D) (obj : D) :
    World D → World D → List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D)) → Prop
  | nil (w : World D) : ObjectHistory X obj w w []
  | cons {w w₁ w' : World D} {e : Option (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))}
      {rest : List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))} :
      ObjectStep X obj w w₁ e → ObjectHistory X obj w₁ w' rest → ObjectHistory X obj w w' (e.toList ++ rest)

/-! ## One step -/

/-- **A step that records nothing keeps the object's entry**, live or not. -/
theorem object_step_none {X : Ctx D} {obj : D} {w w' : World D} (h : ObjectStep X obj w w' none) :
    w'.live X.env obj = w.live X.env obj := by
  cases h with
  | refusal hr => exact refuse_live hr obj
  | other ha hk hc =>
      have he := admit_frame ha (fun x hx hxc => absurd hxc (hk x hx)) hc
      unfold World.live; rw [he]
  | keep _ ha hk hc _ _ _ =>
      have he := admit_frame ha hk hc
      unfold World.live; rw [he]
  | frame hc ha hf =>
      have he := call_frame hc ha (.cell obj) hf
      unfold World.live World.entry
      rw [he]

omit [Ord D] in
private theorem invokeRun_occasion {X : Ctx D} {look : Pinned D} {c : Call D} {actor obj : D} {method : Nat}
    {via : Option D} {cell : Cell} {p : D} {r : Req D}
    (h : invokeRun X look c actor obj method via = .ok (cell, p, r)) : r.occasion = .invoke method := by
  unfold invokeRun at h
  simp only [except_bind_ok] at h
  obtain ⟨cell', -, pkg, -, p', -, pr, -, h⟩ := h
  simp only [pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at h
  rw [← h.2.2]; rfl

/-- **A judged step.** Its `old` is the object's live state; the laws in force (the package's and the
cell's) admitted `old → new` under its request, in its view; a law change or adoption keeps the
state; an invoke's package ran `old → new` on the method its request names, returning its calls (a
write or a law returns none); the object is live after it, with a state that reads `new` at every
key. -/
theorem object_step_some {X : Ctx D} {obj : D} {w w' : World D} {look : Pinned D} {pkg : Option D}
    {laws : List D} {r : Req D} {old new : Slots} {calls : List (Body D)}
    (h : ObjectStep X obj w w' (some (look, pkg, laws, r, old, new, calls)))
    {cell : Cell} (hl : w.live X.env obj = some cell) :


    ((match checkGenesis Xd "spec".toUTF8 "spec-0".toUTF8 100000000 [(wKey, nextKeyDigest Xd wNext)]
        Authority.none with | .ok () => true | .error _ => false) &&
      (match submit Xd wGenesis ⟨sU, Ed25519.sign (wSeed "f0") (Xd.callMessage sU)⟩ with
        | .ok _ => true | .error _ => false) &&
      collisionFree Xd.env.hash (Command.behindPres Xd.env wGenesis wGenesis sU)) = true := by
  native_decide

/-- **FLOOR (C(iii), stale).** The claim refuses a settlement that calls `refused stale` a call the
writer then admits: the founder's planned call, at the genesis World, on the empty extension. -/
/-
# Kernel.Proofs.RootedFold — a rooted run (HOST-29)

* `Rooted.snoc` — a rooted run extended by one accepted step, noted with the state after it, is a
  rooted run (what the Host's batch machine does per step: an admitted Turn or a recorded refusal);
* `RootedFold.fold` — a rooted fold IS a fold of its steps: the roots digests are stated by the
  definition, and stripping them leaves `World.fold`;
* `RootedFold.chain` — the chain a rooted fold reaches is `chainOf` over its (step, roots digest)
  pairs: the stated digests are exactly what a reader needs to advance the chain without admitting.
-/
import Kernel.Proofs.Refuse

namespace Nanodregg.Kernel

section
variable {D : Type} [Ord D] [DecidableEq D]

/-- A run of steps, each paired with a note of the state right after it, from `w` to `w'`: every
step is accepted and every note is the one the run reached (HOST-29). A Store's batch record is a
`RootedFold`: its steps with the roots digest after each; so are the loop's staged batch and the Turns follow
absorbs. Generic so the Host's batch machine states the same fact over its own parameters. -/
def Rooted {W T R N : Type} (admit : W → T → Except R W) (note : W → N) : W → List (T × N) → W → Prop
  | w, [], w' => w' = w
  | w, (t, n) :: rest, w' => ∃ w₁, admit w t = .ok w₁ ∧ n = note w₁ ∧ Rooted admit note w₁ rest w'

/-- `Rooted` over the kernel's transition and roots: steps taken in order, each with the roots digest
(`World.roots`) of the World after it. -/
abbrev World.RootedFold (E : Env D) : World D → List (Step D × D) → World D → Prop :=
  Rooted (World.step E) (World.roots E)

end

theorem Rooted.snoc {W T R N : Type} {admit : W → T → Except R W} {note : W → N} :
    ∀ {w w₁ w' : W} {l : List (T × N)} {t : T}, Rooted admit note w l w₁ → admit w₁ t = .ok w' →
      Rooted admit note w (l ++ [(t, note w')]) w'
  | w, w₁, w', [], t, h, ha => by
      simp only [Rooted] at h; subst h
      exact ⟨w', ha, rfl, rfl⟩
  | w, w₁, w', (s, n) :: rest, t, h, ha => by
      obtain ⟨w₂, h2, hn, hr⟩ := h
      exact ⟨w₂, h2, hn, Rooted.snoc hr ha⟩

variable {D : Type} [Ord D] [DecidableEq D]

theorem RootedFold.fold {E : Env D} : ∀ {w w' : World D} {l : List (Step D × D)},
    World.RootedFold E w l w' → World.fold E w (l.map Prod.fst) = .ok w'
  | w, w', [], h => by simp only [World.RootedFold, Rooted] at h; subst h; rfl
  | w, w', (t, r) :: rest, h => by
      obtain ⟨w₁, ha, -, hr⟩ := h
      simp only [List.map_cons, World.fold, ha, RootedFold.fold hr]

theorem RootedFold.chain {E : Env D} : ∀ {w w' : World D} {l : List (Step D × D)},
    World.RootedFold E w l w' → w'.chain = chainOf E w.chain l
  | w, w', [], h => by simp only [World.RootedFold, Rooted] at h; subst h; rfl
  | w, w', (t, r) :: rest, h => by
      obtain ⟨w₁, ha, hr0, hr⟩ := h
      rw [RootedFold.chain hr, step_chain ha, ← hr0]
      rfl

end Nanodregg.Kernel
/-
# Spec.Proofs.Bridge — a System whose kernel is the deployed kernel folds and decides as it does

A `System` whose `admit`/`refuse` are `World.admit`/`World.refuse` folds exactly as `World.fold`;
one whose `receive`/`recordedBy` are also the kernel's decides exactly as `Receive.Honest`. So
every theorem stated over `World.fold … ∧ Honest …` is a theorem about `Audited` for `deployed`
and for every trivial system that swaps a field other than these four.
-/
import Spec.Proofs.Claims

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive

variable {D : Type} [Ord D] [DecidableEq D]

theorem fold_eq_world (S : System D) (ha : S.admit = World.admit S.X.env)
    (hr : S.refuse = World.refuse S.X.env) :
    ∀ (w : World D) (l : List (Step D)), S.fold w l = World.fold S.X.env w l
  | _, [] => rfl
  | w, s :: rest => by
    have hs : S.step w s = World.step S.X.env w s := by
      cases s <;> simp [System.step, World.step, ha, hr]
    rw [System.fold, World.fold, hs]
    cases World.step S.X.env w s with
    | error r => rfl
    | ok w' =>
      simp only
      rw [fold_eq_world S ha hr w' rest]
      cases World.fold S.X.env w' rest <;> rfl

theorem decided_iff_honest (S : System D) (hrc : S.receive = receive S.X)
    (hrb : S.recordedBy = recordedBy S.X) (ha : S.admit = World.admit S.X.env)
    (hr : S.refuse = World.refuse S.X.env) :
    ∀ (w : World D) (l : List (Step D)), Decided S w l ↔ Honest S.X w l
  | _, [] => by simp [Decided, Honest]
  | w, .turn t :: rest => by
    simp only [Decided, Honest, hrc, ha]
    exact exists_congr fun c => and_congr Iff.rfl (and_congr Iff.rfl
      (forall_congr' fun w' => imp_congr Iff.rfl (decided_iff_honest S hrc hrb ha hr w' rest)))
  | w, .refusal r :: rest => by
    simp only [Decided, Honest, hrb, hr]
    exact exists_congr fun c => exists_congr fun v => exists_congr fun w₁ => and_congr Iff.rfl
      (and_congr Iff.rfl
        (forall_congr' fun w' => imp_congr Iff.rfl (decided_iff_honest S hrc hrb ha hr w' rest)))

/-- **Audited is the kernel's audit**, for a system whose four kernel fields are the kernel's. -/
theorem audited_iff (S : System D) (hrc : S.receive = receive S.X)
    (hrb : S.recordedBy = recordedBy S.X) (ha : S.admit = World.admit S.X.env)
    (hr : S.refuse = World.refuse S.X.env) {w w' : World D} {l : List (Step D)} :
    Audited S w l w' ↔ World.fold S.X.env w l = .ok w' ∧ Honest S.X w l := by
  rw [Audited, fold_eq_world S ha hr, decided_iff_honest S hrc hrb ha hr]

theorem audited_deployed {d : ByteArray → ByteArray} {w w' : World Codec.Digest}
    {l : List (Step Codec.Digest)} :
    Audited (deployed d) w l w' ↔
      World.fold Host.Deployed.X.env w l = .ok w' ∧ Honest Host.Deployed.X w l :=
  audited_iff (deployed d) rfl rfl rfl rfl

end Nanodregg.Spec


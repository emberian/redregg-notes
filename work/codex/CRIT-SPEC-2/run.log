/-
# Spec.Proofs.Durable — §5 DURABILITY, the writer's reopen half

**Claim (`Durable.reopen`).** Whatever base file, checkpoint header, index file and segment bytes
the writer's open (`S.reopen`) reads, if it opens, the World it returns is the fold under the
system's kernel (`S.fold`), from the `Kept` World of the base it read, of EXACTLY the records on
disk: every record `Log.recover` verifies in the segment from the base's offset, in order (the
completeness clause), whose encoding is literally the segment's bytes from the base's offset to the
open's position, and which decode under `S.dc` to the steps folded; and that World is `Kept`. No
premise beyond the open succeeding.

The claim is at `System Digest` only: `Host.Deployed.Kept` is the deployed instance's invariant (its
fields read `Host.Deployed.X.env`), and nothing generic over `D` states it.

Why the completeness clause: `host_reopen_folds`' statement alone (`Durable.reopenSound`) holds of
the open that returns the base's World at the base's position on every Store (zero records, the
empty prefix): `amnesiac_reopenSound`. Recovery's records are what refuse it (`floor_durable_reopen`).

Owed (not carried): the reopen is a FOLD, not an audited one: `Honest` is not carried across a
crash (`foldStep` does not re-judge its own records, and no theorem ties a record appended to what
`admitBatch` staged); and the acknowledged-reply half (every `ok`/recorded `refused` names a step on
disk) and the audited half need §11.4's interpreter of `serve` over `Store`/`Port`.
-/
import Spec.Sim.Durable
import Spec.Proofs.Bridge
import Host.Proofs.Refine
import Host.Proofs.Backup
import Host.Proofs.Open
import Host.Proofs.Log

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

/-- **D1, the writer's reopen.** An open that succeeds returns the fold, under `S`'s kernel, from
the `Kept` World of the base it read, of exactly the records on disk past that base (all those
`Log.recover` verifies there, and their encoding is the bytes up to the open's position), decoded
by `S`'s record codec; and that World is `Kept`. -/
def Durable.reopen (S : System Digest) : Prop :=
  ∀ (keys : Host.Keys) (file H I seg : ByteArray) (o : Host.Opening (World Digest)),
    S.reopen keys file H I seg = .ok o →
    ∃ (b : Host.Base (World Digest)) (n : Nat) (d : ByteArray) (rs : List ByteArray)
      (pss : List (List (Step Digest × Digest))),
      Host.Base.read keys Host.Deployed.c S.B.world file = .ok (b, n, d) ∧ Host.Deployed.Kept b.world ∧
      (Host.Log.recover keys.segment Host.Deployed.c.recordBytesMax b.tag.bytes
        (seg.extract b.offset seg.size)).records = rs ∧
      (seg.extract b.offset seg.size).extract 0 (o.pos.offset - b.offset) =
        Host.Log.encodeAll keys.segment b.tag.bytes rs ∧
      rs.mapM (Host.Record.codec S.dc).decode = .ok pss ∧
      S.fold b.world (pss.flatMap (·.map Prod.fst)) = .ok o.opened.world ∧
      Host.Deployed.Kept o.opened.world

/-- The soundness half alone (`host_reopen_folds`' statement: the World a fold of the records up to
the open's position). Not a claim: `amnesiac_reopenSound` is why `Durable.reopen` says more. -/
def Durable.reopenSound (S : System Digest) : Prop :=
  ∀ (keys : Host.Keys) (file H I seg : ByteArray) (o : Host.Opening (World Digest)),
    S.reopen keys file H I seg = .ok o →
    ∃ (b : Host.Base (World Digest)) (n : Nat) (d : ByteArray) (rs : List ByteArray)
      (pss : List (List (Step Digest × Digest))),
      Host.Base.read keys Host.Deployed.c S.B.world file = .ok (b, n, d) ∧ Host.Deployed.Kept b.world ∧
      (seg.extract b.offset seg.size).extract 0 (o.pos.offset - b.offset) =
        Host.Log.encodeAll keys.segment b.tag.bytes rs ∧
      rs.mapM (Host.Record.codec S.dc).decode = .ok pss ∧
      S.fold b.world (pss.flatMap (·.map Prod.fst)) = .ok o.opened.world ∧
      Host.Deployed.Kept o.opened.world

/-! ## The deployed open -/

/-- The deployed system's reopen is `Host.openWith` at the deployed instance, over bytes. -/
theorem deployed_reopen_eq (d : ByteArray → ByteArray) (keys : Host.Keys) (file H I seg : ByteArray) :
    (deployed d).reopen keys file H I seg = Id.run (Host.openWith keys Host.Deployed.c Host.Deployed.world Host.Deployed.recorder.mark
      Host.Deployed.originChain Host.Deployed.foldStep file H seg.size I.size (Host.segReader I)
      (Host.segReader seg)) := by
  dsimp only [deployed]

/-- The amnesiac system's reopen is `amnesiacOpen`. -/
theorem amnesiac_reopen_eq (d : ByteArray → ByteArray) (keys : Host.Keys) (file H I seg : ByteArray) :
    (amnesiac d).reopen keys file H I seg = amnesiacOpen keys file H I seg := by
  dsimp only [amnesiac]

/-- What `openLog` folds is every record `Log.recover` reads, and it ends where recovery ends. -/
theorem openLog_recover {W F : Type} {s : Host.Log.Sealer} {recordMax : Nat} {step : W → ByteArray → Except F W}
    {w₀ : W} {initial log : ByteArray} {o : Host.Opened W}
    (h : Host.openLog s recordMax step w₀ initial log = .ok o) :
    (Host.Log.recover s recordMax initial log).records.foldlM step w₀ = .ok o.world ∧
      o.validLen = (Host.Log.recover s recordMax initial log).validLen := by
  unfold Host.openLog at h
  generalize Host.Log.recover s recordMax initial log = rv at h ⊢
  simp only at h
  split at h
  · cases h
  · split at h
    · rename_i w hw
      cases h
      exact ⟨(Host.foldRecords_ok step rv.records w₀ w 0).mp hw, rfl⟩
    · cases h

/-- A run of deployed reopen steps over records is the fold of the steps those records decode to
(`Host.Proofs.Refine`'s private `foldlM_foldStep_folds`, restated). -/
theorem foldStep_folds :
    ∀ {w w' : World Digest} {rs : List ByteArray}, rs.foldlM Host.Deployed.foldStep w = .ok w' →
      ∃ pss : List (List (Step Digest × Digest)),
        rs.mapM (Host.Record.codec Codec.Deployed.digestCodec).decode = .ok pss ∧
        World.fold Host.Deployed.X.env w (pss.flatMap (·.map Prod.fst)) = .ok w'
  | w, w', [], h => by
    simp only [List.foldlM_nil, pure, Except.pure, Except.ok.injEq] at h
    subst h
    exact ⟨[], rfl, rfl⟩
  | w, w', r :: rs, h => by
    simp only [List.foldlM_cons, bind, Except.bind] at h
    split at h
    · cases h
    · rename_i w₁ h₁
      obtain ⟨ps, hd, hr⟩ := Host.Record.step_rooted h₁
      obtain ⟨pss, h₂, hf⟩ := foldStep_folds h
      refine ⟨ps :: pss, by simp [List.mapM_cons, hd, h₂, bind, Except.bind, pure, Except.pure], ?_⟩
      simp only [List.flatMap_cons]
      exact fold_append.mpr ⟨w₁, RootedFold.fold hr, hf⟩

/-- **D1 of the deployed system**: `host_reopen_folds` (base `Kept`, opened `Kept`),
`openWith_seg_ok` (the open is `openLog` over the segment past the base), `openLog_recover` and
`encodeAll_recover` (it folds every record recovery reads, and ends where recovery ends). -/
theorem top_durable_reopen (d : ByteArray → ByteArray) : Durable.reopen (deployed d) := by
  intro keys file H I seg o h
  have h' := h
  rw [deployed_reopen_eq] at h'
  obtain ⟨b, n, dd, -, -, hb, hk, -, -, -, hk'⟩ := Host.Deployed.host_reopen_folds h'
  obtain ⟨b', _, _, _, op, _, hb', _, _, _, _, _, _, _, _, _, hop, _, ho⟩ :=
    Host.openWith_seg_ok keys Host.Deployed.c Host.Deployed.world Host.Deployed.recorder.mark
      Host.Deployed.originChain Host.Deployed.foldStep file H I seg h'
  rw [hb] at hb'
  cases hb'
  obtain ⟨hf, hvl⟩ := openLog_recover hop
  obtain ⟨pss, hd, hfold⟩ := foldStep_folds (Host.indexed_foldlM_fst _ _ _ _ _ _ hf)
  obtain ⟨he, -⟩ := Host.Log.encodeAll_recover keys.segment Host.Deployed.c.recordBytesMax b.tag.bytes
    (seg.extract b.offset seg.size)
  subst ho
  refine ⟨b, n, dd, _, pss, hb, hk, rfl, ?_, hd, ?_, hk'⟩
  · show (seg.extract b.offset seg.size).extract 0 (b.offset + op.validLen - b.offset) = _
    rw [Nat.add_sub_cancel_left, hvl]
    exact he
  · rw [fold_eq_world _ rfl rfl]
    exact hfold

/-! ## The floor: the open that forgets the segment -/

/-- What the amnesiac open returns, where the deployed open and the base read succeed. -/
theorem amnesiac_ok {d d' : ByteArray → ByteArray} {keys : Host.Keys} {file H I seg : ByteArray}
    {o₀ : Host.Opening (World Digest)} {b : Host.Base (World Digest)} {n : Nat} {dd : ByteArray}
    (ho : (deployed d').reopen keys file H I seg = .ok o₀)
/-
# Spec.Proofs.Cap — B2's grant cap: a grant moves at most what it had left

TOPLEVEL-SPEC §3.2. **The claim** (`Integrity.grantCap`): along an audited log, for the log's own
chain of the system's steps (`System.Steps`), the transfers dispatched through a live grant sum to
at most what its transfer ledger had left at the start, and the credit lines extended through it to
at most what its credit ledger had left. A move is read off the call the step's event decodes to
(`MovesThrough`/`CreditsThrough`: the signed Body, or a call an object's run returned at any depth,
the walk of the call's own program), never off the system's `receive`, so a floor may swap it.

**Premises**, each needed:
* `Audited S w l w'`: the log is folded and every step is the system's own decision.
* `CellsCanon` and `LedgerContiguous` at the start: canonicity, true of every World a follower
  reaches (`genesis_cellsCanon`, `genesis_ledgerContiguous`, `honest_ledgerContiguous`). Without
  `LedgerContiguous` the bound fails (`Ledger.Proofs.GrantCapTooth.grant_cap_needs_contiguous`: a
  grant whose ledger has a gap moves 20 under a cap of 10).
* `g` live, a grant, and its ledger reading `left`: what is bounded.

**Top** `top_integrity_grantCap`: `grant_moves_le_cap`, `grant_credits_le_cap`
(`Ledger/Proofs/GrantCap.lean`) through `audited_deployed`; the system's chain is the lemma's
(`chain_eq`: the kernel's step is a function). **Floors** `floor_integrity_grantCap`,
`floor_integrity_grantCap_credit`: the capless kernel (`Spec.Sim.Cap.capless`), one per half: the
founder grants itself a cap of 10 on its well and moves (extends) 10 through it twice; both derive
and admit, and 20 > 10. **Inhabited** `inhabited_integrity_grantCap`: under the deployed kernel one
move of 10 through that grant admits, so the premise is reached with a positive amount.

Owed: nothing for the deployed system. The nested case of a move reads the kernel's walk of the
call's tree, so for a system with another `receive` only the moves that walk would dispatch are
counted (the floors need only the signed Body).
-/
import Spec.Proofs.Bridge
import Spec.Sim.Cap
import Ledger.Proofs.GrantCap
import Codec.Proofs.Digest

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec
open Nanodregg.Ledger.Proofs (GrantStep MovesThrough CreditsThrough grant_moves_le_cap grant_credits_le_cap)

section
variable {D : Type} [Ord D] [DecidableEq D]

/-- One step of a log under the system's kernel, as a `Std.Chain` relation (`R rq n o`: from `o`,
step `rq` reaches `n`). -/
def System.Steps (S : System D) (s : Step D) (n o : World D) : Prop := S.step o s = .ok n

/-- **B2. Grant cap.** Along an audited log from a World whose cells are canonical and whose
grants' ledgers are contiguous, with `g` a live grant: for the log's own chain of steps, any choice
of one amount per step, each 0 or the amount of a transfer the step dispatched through `g`, sums to
at most what `g`'s transfer ledger had left at the start; and likewise credit lines on its credit
ledger. -/
def Integrity.grantCap (S : System D) : Prop :=
  ∀ {g : D} {w w' : World D} {l : List (Step D)} {cell : Cell},
    Audited S w l w' → CellsCanon S.X.env w → LedgerContiguous S.X.env w →
    w.live S.X.env g = some cell → cell.kind = kindGrant →
    ∀ {steps : List (Step D × World D)}, steps.map Prod.fst = l → Lang.Std.Chain S.Steps w steps →
      (∀ {i left : Nat}, ledgerLeft transferBase g cell = .ok (i, left) →
        ∀ amt : World D × Step D × World D → Nat,
          (∀ x ∈ (w :: steps.map Prod.snd).zip steps, amt x = 0 ∨ MovesThrough S.X g x.1 x.2.1 (amt x)) →
          (((w :: steps.map Prod.snd).zip steps).map amt).sum ≤ left) ∧
      (∀ {i left : Nat}, ledgerLeft creditBase g cell = .ok (i, left) →
        ∀ amt : World D × Step D × World D → Nat,
          (∀ x ∈ (w :: steps.map Prod.snd).zip steps, amt x = 0 ∨ CreditsThrough S.X g x.1 x.2.1 (amt x)) →
          (((w :: steps.map Prod.snd).zip steps).map amt).sum ≤ left)

end

/-- Two chains over one list of requests, the first's relation inside the second's and the second
functional, are one chain. -/
theorem chain_eq {Q St : Type} {R R' : Q → St → St → Prop} (hR : ∀ q n o, R q n o → R' q n o)
    (hfun : ∀ q n n' o, R' q n o → R' q n' o → n = n') :
    ∀ {o : St} {s₁ s₂ : List (Q × St)}, Lang.Std.Chain R o s₁ → Lang.Std.Chain R' o s₂ →
      s₁.map Prod.fst = s₂.map Prod.fst → s₁ = s₂
  | _, [], [], _, _, _ => rfl
  | _, [], _ :: _, _, _, h => by simp at h
  | _, _ :: _, [], _, _, h => by simp at h
  | o, (q, n) :: r₁, (q', n') :: r₂, h₁, h₂, hm => by
      cases h₁ with
      | cons hs₁ hc₁ =>
      cases h₂ with
      | cons hs₂ hc₂ =>
      simp only [List.map_cons, List.cons.injEq] at hm
      obtain ⟨rfl, hm⟩ := hm
      have := hfun q n n' o (hR _ _ _ hs₁) hs₂
      subst this
      rw [chain_eq hR hfun hc₁ hc₂ hm]

theorem deployed_step (d : ByteArray → ByteArray) (o : World Digest) (s : Step Digest) :
    (deployed d).step o s = World.step Xd.env o s := by
  cases s <;> rfl

/-- **B2's grant cap, of the deployed system**: `grant_moves_le_cap`, `grant_credits_le_cap`. -/
theorem top_integrity_grantCap (d : ByteArray → ByteArray) : Integrity.grantCap (deployed d) := by
  intro g w w' l cell ha hcan hlc hl hk steps hmap hc
  rw [audited_deployed] at ha
  have hst : ∀ {steps' : List (Step Digest × World Digest)}, steps'.map Prod.fst = l →
      Lang.Std.Chain (GrantStep Xd g) w steps' → steps' = steps := fun hm' hc' =>
    chain_eq (R' := (deployed d).Steps)
      (fun q n o h => show (deployed d).step o q = .ok n from (deployed_step d o q).trans h.1.1)
      (fun _ _ _ _ h₁ h₂ => Except.ok.inj (h₁.symm.trans h₂)) hc' hc (hm'.trans hmap.symm)
  refine ⟨fun hleft amt hamt => ?_, fun hleft amt hamt => ?_⟩
  · obtain ⟨steps', hm', hc', hb⟩ := grant_moves_le_cap hcan hlc hl hk hleft ha.1 ha.2
    rw [hst hm' hc'] at hb
    exact hb amt hamt
  · obtain ⟨steps', hm', hc', hb⟩ := grant_credits_le_cap hcan hlc hl hk hleft ha.1 ha.2
    rw [hst hm' hc'] at hb
    exact hb amt hamt

/-! ## The floor: the kernel without the cap (`Spec.Sim.Cap.capless`) -/

theorem okThen_eq {ε α : Type} {r : Except ε α} {k : α → Bool} (h : okThen r k = true) :
    ∃ a, r = .ok a ∧ k a = true := by
  cases r with
  | error e => cases h
  | ok a => exact ⟨a, rfl, h⟩

theorem someThen_eq {α : Type} {r : Option α} {k : α → Bool} (h : someThen r k = true) :
    ∃ a, r = some a ∧ k a = true := by
  cases r with
  | none => cases h
  | some a => exact ⟨a, rfl, h⟩

/-- **The capless run**: THE re-deriver accepts issue, account and grant from genesis; the grant is
live with 10 left on its transfer ledger; the capless kernel derives and the kernel admits two moves
of 10 through it, each Turn's event decoding to its call. -/
theorem run_capless :
    okThen (rederiveLog Xd wGenesis gLog) (fun w₃ =>
      someThen (w₃.live Xd.env gId) (fun cell => decide (cell.kind = kindGrant) &&
        okThen (ledgerLeft transferBase gId cell) (fun p => decide (p.2 = 10))) &&
      okThen (caplessReceive w₃ gMove1) (fun t₁ => decide (Xd.decodeCall t₁.event = some gMove1) &&
        okThen (World.admit Xd.env w₃ t₁) (fun w₄ =>
          okThen (caplessReceive w₄ gMove2) (fun t₂ => decide (Xd.decodeCall t₂.event = some gMove2) &&
            okThen (World.admit Xd.env w₄ t₂) (fun _ => true))))) = true := by
  native_decide

/-- **The capless credit run**: as `run_capless`, with a grant of `credit 10` and two credit lines
of 10 through it. -/
theorem run_capless_credit :
    okThen (rederiveLog Xd wGenesis cLog) (fun w₃ =>
      someThen (w₃.live Xd.env cId) (fun cell => decide (cell.kind = kindGrant) &&
        okThen (ledgerLeft creditBase cId cell) (fun p => decide (p.2 = 10))) &&
      okThen (caplessReceive w₃ cLine1) (fun t₁ => decide (Xd.decodeCall t₁.event = some cLine1) &&
        okThen (World.admit Xd.env w₃ t₁) (fun w₄ =>
          okThen (caplessReceive w₄ cLine2) (fun t₂ => decide (Xd.decodeCall t₂.event = some cLine2) &&
            okThen (World.admit Xd.env w₄ t₂) (fun _ => true))))) = true := by
  native_decide

theorem cLine1_body : cLine1.unsigned.body = .credit vWell (.of wMember vWell) 10 (some cId) := rfl

theorem cLine2_body : cLine2.unsigned.body = .credit vWell (.of wMember vWell) 10 (some cId) := rfl

theorem gMove1_body : gMove1.unsigned.body = .transfer (.well vWell) (.of wMember vWell) 10 (some gId) none :=
  rfl

/-
# Spec.Proofs.AuthKernel — where every effect of a signed call's walk comes from, by receiver

A kernel lemma proved under Spec for B1 (`Spec.Proofs.Auth`), stated over the kernel's own
definitions only so that KERNEL can move it down beside `Kernel.Proofs.InvokeTree` (it generalises
that module's private `dispatched_effects`/`dispatch_other`, which record only "read as a kind other
than an object's", to what each receiver wrote and on whose authority).

* `effect_prov`: every effect of the signed call's walk is an effect of ONE receiver the walk
  dispatched (`Dispatched`), whose body is the signed one (with the signer as actor) or callable, or
  is the own state write of a dispatched invoke at the object it invoked.
* `node_effect`: one receiver's effect, by the kind it read the cell as: an object (`write`, `law`);
  a member (the signed `rotate` of the signer's own cell, to the key whose digest the cell
  precommitted); a grant (its issuer's retirement, or one append to a counted ledger by an actor
  holding it, `granteeHolds`); an account (a transfer leg or a credit leg, under the source's or the
  well's owner authority, `AccountMove`).
* `changed_effect`: a derived and admitted Turn that changes a live cell carries an effect there,
  the one its touch acts with.
-/
import Kernel.Proofs.InvokeTree
import Kernel.Proofs.LedgerNext
import Kernel.Proofs.Ledger

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## The vocabulary -/

/-- `actor` exercises `owner`'s authority over `obj` for `right`: it is the owner, acting with no
grant, or it holds a grant chain from `via`, every link pinned, live, aimed at `obj` and carrying
`right`, whose root issuer is `owner` (`Chain`). -/
def Exercises (X : Ctx D) (look : Pinned D) (obj : D) (right : Right) (via : Option D) (actor owner : D) :
    Prop :=
  via = none ∧ actor = owner ∨ ∃ g, via = some g ∧ Chain X look obj right true g actor owner

/-- A receiver `b`, run as `a`, moves the account `id`: it is a transfer and `id` is its source or
its destination, under the source owner's `transfer` authority; or a credit line and `id` is the
well or the credited account, under the well owner's `credit` authority. -/
def AccountMove (X : Ctx D) (look : Pinned D) (a : D) (b : Body D) (id : D) : Prop :=
  (∃ srcR dstR amount via once scell owner, b = .transfer srcR dstR amount via once ∧
      (id = srcR.resolve X ∨ id = dstR.resolve X) ∧ readKind look (srcR.resolve X) kindAccount = .ok scell ∧
      slotDigest X (srcR.resolve X) scell slotOwner = .ok owner ∧
      Exercises X look (srcR.resolve X) (.transfer 0) via a owner) ∨
  (∃ well acctR amount via wcell owner, b = .credit well acctR amount via ∧
      (id = well ∨ id = acctR.resolve X) ∧ readKind look well kindAccount = .ok wcell ∧
      slotDigest X well wcell slotOwner = .ok owner ∧ Exercises X look well (.credit 0) via a owner)

/-- **One receiver's effect `e`** (receiver `b`, run as `a`, on the view `look`), by the kind it read
the cell as: an object; the signer's own member cell under its `rotate` to the precommitted key; a
grant retired by its issuer or appended by an actor holding it; an account moved (`AccountMove`). -/
def NodeEffect (X : Ctx D) (look : Pinned D) (c : Call D) (a : D) (b : Body D) (e : D × Act) : Prop :=
  (∃ cl, readKind look e.1 kindObject = .ok cl) ∨
  (∃ key next m, b = .rotate key next ∧ e.1 = c.unsigned.member ∧ readKind look e.1 kindMember = .ok m ∧
      c.unsigned.key = key ∧ slotDigest X e.1 m slotNext = .ok (nextKeyDigest X key)) ∨
  (∃ cl, readKind look e.1 kindGrant = .ok cl ∧
      (e.2 = .retire ∧ slotDigest X e.1 cl grantIssuer = .ok a ∨
        LedgerSpend e.1 cl e.2 ∧ granteeHolds X look e.1 cl a true = .ok ())) ∨
  (∃ cl, readKind look e.1 kindAccount = .ok cl ∧ AccountMove X look a b e.1)

/-- **Where an effect of `c`'s walk on `w` comes from**: a receiver the walk dispatched (the signed
body as the signer, or a callable body), and either that receiver, if not an invoke, derived it, or
it is the own write of a dispatched invoke at the object the invoke ran on. -/
def Prov (X : Ctx D) (w : World D) (c : Call D) (e : D × Act) : Prop :=
  ∃ n wk a b, Dispatched X w c n wk a b ∧ (b = c.unsigned.body ∧ a = c.unsigned.member ∨ b.callable = true) ∧
    ((∃ r, b.isInvoke = false ∧ dispatch X (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) c
        (tree X (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) c n) wk a b = .ok r ∧
        e ∈ r.1.effects) ∨
     ∃ obj method args budget via cell p rq, b = .invoke obj method args budget via ∧ e.1 = obj ∧
       invokeRun X (pinned X.env w c.unsigned.pins) c a obj method via = .ok (cell, p, rq))


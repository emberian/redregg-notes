/-
# Spec.Proofs.Fork — A2′ FORK CONSISTENCY over the member's follower step

SUNDR's fork consistency at the deployed act (PROTOCOL-75: self-heads through the writer). A member
posts its own head `(steps, chain)` into a `Std.head` object of its World (`nd sync --post`); every
follow that absorbs a page carrying such a post walks the page against it (`Head.forkedSelfPost`).
The claim: whenever one frame of follow absorbs a page carrying a post of the head of ANOTHER fold
of the same start, at a position the page walks, either follow's log up to that position IS the
other fold's log (or two of the inputs the two folds' chains compare collide, an explicit list), or
the frame ends `refused forkedPost` and the page names a post whose position follow's own fold
passed with another chain. A writer that forks two members cannot show either a page that joins
the forks without the member saying so by name.

Premises (each a hypothesis of the claim, named):
* the two folds from one start `g` (`l₀` to follow's World, `lg` to the poster's): what makes the
  conclusion a statement about TWO members' histories (`fold_head_binds`);
* `f.world.steps < wg.steps`: a post at or behind follow's position is compared by the follow LOOP
  against its own Store (`Host.Follow.behindOr`, HOST-79), which is not a `System` field;
* `wg.steps ≤ f'.world.steps`: a post naming a step past the page's end is compared by NOBODY today
  (not the walk, not `behindOr`, and never again, since `selfPosts` reads only the cells a page
  touched), although an honest post always sits at an index past its own step count, so such a
  post is itself evidence of a fork or a forgery: cv task 01a17ac1-5204. Deleting this premise is
  that task's strengthening.

The refusal disjunct carries its evidence (the post and the fold that passed it with another
chain) because the reply cannot: `Command.refused` drops the step and poster, and a writer
refusal named `forkedPost` (`Refusal.host`) prints the same bytes (cv task 01a17ac1-5233).

The other arm, `nd sync --to STEPS:CHAIN` (PROTOCOL-74: the member BEHIND catches up to another's
stated head), is `ForkConsistent.sync` below, with its own floor (`syncBlind`) and inhabited run.
-/
import Spec.Proofs.Floor
import Spec.Sim.Fork
import Protocol.Proofs.Head
import Protocol.Proofs.Command
import Protocol.Proofs.PostOr
import Kernel.Proofs.RootedDeployed

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## The claim -/

/-- **A2′. Fork consistency of the member's follower.** One frame of follow that persists the
steps `ts` of a page, from a World `f.world` that is a fold of `l₀` from a start `g`: for every
self-head post the page carries (`Head.selfPosts`) that names the head of a World `wg`, a fold of
`lg` from the same `g`, at a step count the page walks (`f.world.steps < wg.steps ≤ f'.world.steps`):
follow's log up to that step count (the page's prefix of `wg.steps - f.world.steps` steps, fixed by
the premises) is `lg`, or two of the inputs the two folds' chains compare
collide; or the frame ends `refused forkedPost` and the page carries a post at a position follow's
own fold passed with another chain (the refusal is never free). -/
def ForkConsistent (S : System D) : Prop :=
  ∀ (me : Command.Self D) (f f' : Command.Follow D) (kb res : ByteArray)
    (ts : List (Step D × D)) (r : Command.Reply),
    S.follow me f kb res = (f', .steps ts, r) →
    ∀ {g wg : World D} {l₀ lg : List (Step D)} {m : Option D},
      S.fold g l₀ = .ok f.world → S.fold g lg = .ok wg →
      (wg.steps, S.X.env.bytes wg.chain, m) ∈ Head.selfPosts S.X f'.world ts →
      f.world.steps < wg.steps → wg.steps ≤ f'.world.steps →
      (l₀ ++ (ts.take (wg.steps - f.world.steps)).map Prod.fst = lg ∨
          CollidesAmong S.X.env.hash
            (foldPres S.X.env g (l₀ ++ (ts.take (wg.steps - f.world.steps)).map Prod.fst) ++
              foldPres S.X.env g lg)) ∨
      (∃ s c m', (s, c, m') ∈ Head.selfPosts S.X f'.world ts ∧
          (∃ pre post v, ts = pre ++ post ∧ S.fold f.world (pre.map Prod.fst) = .ok v ∧
            v.steps = s ∧ S.X.env.bytes v.chain ≠ c) ∧
          r = Command.refused (D := D) (.forkedPost s m'))

/-! ## The step lemma -/

/-- **What a frame that persists steps did**: nothing (no steps), or it absorbed a page
(`absorbSync`) whose steps are the ones persisted, follow's World is the page's end, and the reply
is `postOr`'s verdict on the page's self-head posts. (A sharpening of
`Protocol.Proofs.FollowHead.step_world`'s page arm with the reply.) -/
theorem step_steps {X : Ctx D} {dc : Codec.Stream D} {B : Thin.Base (World D)}
    {me : Command.Self D} {f f' : Command.Follow D} {kb res : ByteArray} {p : Command.Persist D}
    {ts : List (Step D × D)} {r : Command.Reply}
    (h : Command.step X dc B me f kb res = (f', p, r)) (hp : p = .steps ts) :
    (ts = [] ∧ f'.world = f.world) ∨ ∃ (cmd : Command.Cmd D) (evs : List ByteArray) (steps : Nat)
      (chain : ByteArray) (base : Nat) (wb : Option (World D)) (r₀ : Command.Reply),
      Command.absorbSync X me cmd f.world evs steps chain base = .ok (f'.world, ts, wb) ∧
      r = Command.postOr X f.world ts f'.world r₀ ∧
      ∃ st, Command.State.ofBytes kb = some st ∧ Command.parse X.digestOf st.argv = .ok cmd := by
  unfold Command.step at h
  cases hst : Command.State.ofBytes kb with
  | none =>
    rw [hst] at h
    dsimp only at h
    simp only [Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl⟩ := h
    simp only [Command.Persist.steps.injEq] at hp
    exact .inl ⟨hp.symm, rfl⟩
  | some st =>
    rw [hst] at h
    simp only [Option.map_some, Option.getD_some] at h
    cases hpa : Command.parse X.digestOf st.argv with
    | error r =>
      rw [hpa] at h
      dsimp only at h
      simp only [Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      simp only [Command.Persist.steps.injEq] at hp
      exact .inl ⟨hp.symm, rfl⟩
    | ok cmd =>
      rw [hpa] at h
      dsimp only at h
      repeat' split at h
      all_goals (try simp only [Prod.mk.injEq] at h)
      all_goals (repeat' split at h)
      all_goals (try simp only [Prod.mk.injEq] at h)
      all_goals (obtain ⟨rfl, rfl, rfl⟩ := h)
      all_goals (try simp only [Command.Persist.steps.injEq, reduceCtorEq] at hp)
      all_goals first
        | exact .inl ⟨hp.symm, rfl⟩
        | (subst hp; exact .inr ⟨_, _, _, _, _, _, _, ‹_›, rfl, st, rfl, hpa⟩)

omit [Ord D] [DecidableEq D] in
/-- The walk reaches every step count strictly after its start and no later than its end. -/
theorem anchorCheck_reached {E : Env D} {steps : Nat} {chain : ByteArray} :
    ∀ {s : Nat} {c : D} {ts : List (Step D × D)}, s < steps → steps ≤ s + ts.length →
      Head.anchorCheck E steps chain s c ts ≠ .unreached
  | _, _, [], h₁, h₂ => by simp only [List.length_nil] at h₂; omega
  | s, c, (t, r) :: rest, h₁, h₂ => by
      simp only [Head.anchorCheck]
      split
      · split <;> simp
      · rename_i hs
        simp only [List.length_cons] at h₂
        exact anchorCheck_reached (by omega) (by omega)

/-! ## The top theorem -/

/-- **A2′ of the deployed system**: `step_steps`, then `forkedSelfPost_none` (every post the page
walks is on follow's fold: `fold_head_binds` binds it to the other fold) or `forkedSelfPost_forked`
(the refusal names a post follow's own fold passed with another chain). -/
theorem top_forkConsistent (d : ByteArray → ByteArray) : ForkConsistent (deployed d) := by
  intro me f f' kb res ts r h g wg l₀ lg m h₀ hg hmem hlo hhi
  rw [fold_eq_world _ rfl rfl] at h₀ hg
  have h' : Command.step Host.Deployed.X Codec.Deployed.digestCodec (deployed d).B me f kb res =
      (f', .steps ts, r) := h
  rcases step_steps h' rfl with ⟨rfl, -⟩ | ⟨cmd, evs, steps, chain, base, wb, r₀, ha, hr, -⟩
  · simp [Head.selfPosts] at hmem
  · have hrf := Command.absorbPage_admits (Command.absorbSync_ok ha)
    have hlen : f'.world.steps = f.world.steps + ts.length := by
      rw [fold_steps (RootedFold.fold hrf), List.length_map]
    cases hfs : Head.forkedSelfPost Host.Deployed.X f.world ts f'.world with
    | none =>
      rcases Head.forkedSelfPost_none hrf hfs _ _ _ hmem with hu | ⟨pre, post, v, hts, hv, hvs, hvc⟩
      · exact absurd hu (anchorCheck_reached hlo (by omega))
      · have hfull : World.fold Host.Deployed.X.env g (l₀ ++ pre.map Prod.fst) = .ok v :=
          fold_append.mpr ⟨_, h₀, hv⟩
        have hpl : f.world.steps + pre.length = wg.steps := by
          rw [← hvs, fold_steps hv, List.length_map]
        have hpre : pre = ts.take (wg.steps - f.world.steps) := by
          rw [hts, List.take_left' (by omega)]
        subst hpre
        exact .inl (fold_head_binds deployed_lawful hfull hg hvs (deployed_lawful.bytes_inj hvc))
    | some sm =>
      obtain ⟨s, m'⟩ := sm
      obtain ⟨c, hc, pre, post, v, hts, hv, hvs, hvc⟩ := Head.forkedSelfPost_forked hrf hfs
      refine .inr ⟨s, c, m', hc, ⟨pre, post, v, hts, ?_, hvs, hvc⟩, ?_⟩
      · rw [fold_eq_world _ rfl rfl]; exact hv
      · rw [hr]; unfold Command.postOr; rw [hfs]

/-! ## The floor and the inhabited case (the trivial system and the run: `Spec.Sim.Fork`) -/

theorem refused_forkedPost (s : Nat) (m : Option Digest) :
    Command.refused (D := Digest) (.forkedPost s m) =
      .done CommandExit.refused.code.toUInt8 .empty forkedPostErr := rfl

theorem unforked_ne (r : Command.Reply) (s : Nat) (m : Option Digest) :
    unforked r ≠ Command.refused (D := Digest) (.forkedPost s m) := by
  rw [refused_forkedPost]
  cases r with
  | done e o err =>
    simp only [unforked]
    split
    · simp only [ne_eq, Command.Reply.done.injEq, not_and]
      intro h; exact absurd h (by decide)
    · rename_i hne
      simp only [ne_eq, Command.Reply.done.injEq, not_and]
      intro _ _ h; exact hne h
  | _ => simp [unforked]

theorem stepsOf_eq {p : Command.Persist Digest} (h : (stepsOf p).isSome = true) :
    p = .steps ((stepsOf p).getD []) := by
  cases p with
  | steps ts => rfl
  | adopt _ => simp [stepsOf] at h

/-- **The joining run**: follow, at genesis, absorbs fork A's page: it persists the page's steps,
which carry a post of fork B's head at step 1, a step the page walks; fork A's first step is not
fork B's, no two of the two prefixes' link inputs collide; and the deployed follower ends the
frame `refused forkedPost`. Fork B folds. -/
theorem run_forkedPost :
    (match World.fold Xd.env wGenesis wLog with
     | .ok wB =>
        match (deployed storeDigest).follow sMe ⟨wGenesis, none, none⟩ kKb kPage with
        | (f', p, r) =>
            (stepsOf p).isSome &&
              (Head.selfPosts Xd f'.world ((stepsOf p).getD [])).any
                (fun q => decide (q = (wB.steps, Xd.env.bytes wB.chain, some wMember))) &&
              decide (wB.steps = wGenesis.steps + 1) && decide (wB.steps ≤ f'.world.steps) &&
              decide ((((stepsOf p).getD []).take 1).map Prod.fst ≠ wLog) &&
              collisionFree Xd.env.hash
                (foldPres Xd.env wGenesis ((((stepsOf p).getD []).take 1).map Prod.fst) ++
                  foldPres Xd.env wGenesis wLog) &&
              forkedPostDone r
     | .error _ => false) = true := by
  native_decide

/-- The run, unpacked: a frame of the deployed follower from a World `g`, a fold of `g` to `w`,
and the facts the floor and the inhabited case read. -/
theorem run_unpacked :
    ∃ (g : World Digest) (lg : List (Step Digest)) (mm : Digest) (me : Command.Self Digest)
      (kb res : ByteArray) (f' : Command.Follow Digest) (p : Command.Persist Digest)
      (ts : List (Step Digest × Digest)) (r : Command.Reply) (w : World Digest),
      (deployed storeDigest).follow me ⟨g, none, none⟩ kb res = (f', p, r) ∧ p = .steps ts ∧
      World.fold Xd.env g lg = .ok w ∧
      (w.steps, Xd.env.bytes w.chain, some mm) ∈ Head.selfPosts Xd f'.world ts ∧
      w.steps = g.steps + 1 ∧ w.steps ≤ f'.world.steps ∧
      (ts.take 1).map Prod.fst ≠ lg ∧
      ¬ CollidesAmong Xd.env.hash (foldPres Xd.env g ((ts.take 1).map Prod.fst) ++ foldPres Xd.env g lg) ∧
      forkedPostDone r = true := by
  have hr := run_forkedPost
  revert hr
  generalize wGenesis = g
  generalize wLog = lg
  generalize wMember = mm
  generalize sMe = me
  generalize kKb = kb
  generalize kPage = res
  intro hr
  cases hgf : World.fold Xd.env g lg with
  | error e => rw [hgf] at hr; cases hr
  | ok w =>
    rw [hgf] at hr
    cases hR : (deployed storeDigest).follow me ⟨g, none, none⟩ kb res with
    | mk f' rest =>
      obtain ⟨p, r⟩ := rest
      rw [hR] at hr
      dsimp only at hr
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hr
      obtain ⟨⟨⟨⟨⟨⟨hsome, hmem⟩, hs1⟩, hs2⟩, hne⟩, hcf⟩, hfp⟩ := hr
      obtain ⟨x, hx, hxe⟩ := List.any_eq_true.mp hmem
      simp only [decide_eq_true_eq] at hxe
      subst hxe
      exact ⟨g, lg, mm, me, kb, res, f', p, _, r, w, hR, stepsOf_eq hsome, hgf, hx, hs1, hs2, hne,
        not_collides hcf, hfp⟩

/-- **FLOOR (A2′).** The claim refuses the post-blind follower: on the joining run it persists a
page carrying fork B's head at a step it walks, follow's log up to there is not fork B's and no
listed input collides, and it does not end `refused forkedPost`. -/
theorem floor_forkConsistent : ¬ ForkConsistent (postBlind storeDigest) := by
  intro h
  obtain ⟨g, lg, mm, me, kb, res, f', p, ts, r, w, hR, rfl, hgf, hmem, hs1, hs2, hne, hcol, -⟩ := run_unpacked
  have ht : (postBlind storeDigest).follow me ⟨g, none, none⟩ kb res = (f', .steps ts, unforked r) := by
    show (((deployed storeDigest).follow me ⟨g, none, none⟩ kb res).1,
      ((deployed storeDigest).follow me ⟨g, none, none⟩ kb res).2.1,
      unforked ((deployed storeDigest).follow me ⟨g, none, none⟩ kb res).2.2) = _
    rw [hR]
  have hg : (postBlind storeDigest).fold g lg = .ok w := by
    rw [fold_eq_world _ rfl rfl]; exact hgf
  rcases h me ⟨g, none, none⟩ f' kb res ts (unforked r) ht (l₀ := []) rfl hg hmem (by simp only; omega) hs2 with
    (heq | hc) | ⟨s, c, m', -, -, hrr⟩
  · have hk : w.steps - g.steps = 1 := by omega
    simp only [hk, List.nil_append] at heq
/-
# Spec.Proofs.Agree — A1′: an honest writer's page moves follow to the writer's World

TOPLEVEL-SPEC §2.2 (completeness; the writer–follower agreement). **The claim**
(`Agree.pageAbsorbs`): from a World whose rows are canonical, whatever batch the system's writer
admits (its machine over `S.handle`, the World's roots as each step's note), the system's follower
(`S.follow`, one frame of the member's command machine) at the log phase of a command without an
anchor, standing at that World and handed the writer's `log` page of exactly what the batch staged
(its events, the writer's World after the batch as the page's end and tip), moves to the World the
writer keeps. Stated at the step `host follow` runs, so a follower that does not take honest pages
is refused.

**Premises**, each needed:
* the call codec canonical (`decodeCall b = some c → callBytes c = b`): what makes a logged event
  decode to the call the writer judged (deployed: `Codec.Deployed.eq_callBytes_of_decodeCall`).
* `w.RowsCanon`: the one invariant `absorbStep` re-derivation reads (every `Kept` World has it).
* the batch staged at most `pageStepsMax` steps: a page holds no more (a longer batch is served
  over several pages; this claim is about one page).
* the follower's frame: its World is `w`, its continuation is a log phase (2) of a command other
  than `init` (whose phase 2 is custody's) and without a `sync --to`/`--check` anchor (whose
  fork walk is A2′'s), the reply is an `ok` holding that page.

**Top** `top_agree_pageAbsorbs`: `host_run_folds`, `Machine.staged_rooted`/`machine_commits` and
`honest_page_absorbed` (`Host/Proofs/Refine.lean`) give `absorbPage` of the page; `step_page_world`
(here, over `Command.step`'s log arm) lifts it to the step. **Floor** `floor_agree_pageAbsorbs`: the
deaf follower (`Spec.Sim.Agree.deafFollower`), on the founder's rotate batch. **Inhabited**
`inhabited_agree_pageAbsorbs`: the deployed follower moves on that page, to a World one step on.

**Owed (the gap)**: the page is stated as what the batch staged. That the deployed pager
(`Host.Page.kept` over the durable records) serves exactly those events and that end is IO and not
proved here (`Host/Proofs/Refine.lean`'s header: no theorem ties the segment's bytes to what
`admitBatch` staged).
-/
import Spec.Proofs.Cap
import Spec.Sim.Agree
import Host.Proofs.Refine
import Protocol.Proofs.Command

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

section
variable {D : Type} [Ord D] [DecidableEq D]

/-- **A1′. An honest writer's page absorbs.** -/
def Agree.pageAbsorbs (S : System D) : Prop :=
  (∀ b c, S.X.decodeCall b = some c → S.X.callBytes c = b) →
  ∀ {w : World D} {qs : List (Host.Request Host.Frame)}, w.RowsCanon S.X.env →
    let r := ({ note := World.roots S.X.env, handle := S.handle, ok := Status.ok.code } :
      Host.Machine (World D) (Step D) Host.Frame D).admitBatch w qs
    r.2.staged.size ≤ Bounds.pageStepsMax →
    ∀ {me : Command.Self D} {f : Command.Follow D} {kb result p a sb pb ub tb : ByteArray}
      {st : Command.State} {cmd : Command.Cmd D} {pg : Command.LogPage} {pages : Nat},
      f.world = w → Command.State.ofBytes kb = some st → Command.parse S.X.digestOf st.argv = .ok cmd →
      st.phase = 2 → st.acc = [a, sb, pb, ub, tb] → Text.ofU64 pb = some pages →
      (∀ s, cmd ≠ .init s) → Command.syncAnchor S.X me cmd = none →
      Command.hostReply result = some (.ok, p) → Command.logPage p = some pg →
      pg.events = r.2.staged.toList.map (Host.Page.stepEvent ∘ Prod.fst) → pg.steps = r.1.steps →
      pg.chain = S.X.env.bytes r.1.chain → pg.tipSteps = r.1.steps →
      (S.follow me f kb result).1.world = r.1

theorem absorbSync_none {X : Ctx D} {me : Command.Self D} {cmd : Command.Cmd D} {w : World D}
    {evs : List ByteArray} {steps base : Nat} {chain : ByteArray} (h : Command.syncAnchor X me cmd = none) :
    Command.absorbSync X me cmd w evs steps chain base = Command.absorbPage X w evs steps chain base := by
  unfold Command.absorbSync
  rw [h]
  cases Command.absorbPage X w evs steps chain base <;> rfl

/-- **The log arm of follow's step**: at a log phase of a command other than `init`, an `ok` reply
holding a page whose stated end is its tip, absorbed by `absorbSync` to `w'`, moves follow to `w'`. -/
theorem step_page_world {X : Ctx D} {dc : Codec.Stream D} {B : Thin.Base (World D)} {me : Command.Self D}
    {f : Command.Follow D} {kb result p a sb pb ub tb : ByteArray} {st : Command.State} {cmd : Command.Cmd D}
    {pg : Command.LogPage} {pages : Nat} {w' : World D} {ts : List (Step D × D)} {wb : Option (World D)}
    (hk : Command.State.ofBytes kb = some st) (hp : Command.parse X.digestOf st.argv = .ok cmd)
    (hph : st.phase = 2) (hacc : st.acc = [a, sb, pb, ub, tb]) (hi : ∀ s, cmd ≠ .init s)
    (hr : Command.hostReply result = some (.ok, p)) (hpg : Command.logPage p = some pg)
    (hpages : Text.ofU64 pb = some pages) (htip : ¬ pg.steps < pg.tipSteps)
    (hs : Command.absorbSync X me cmd f.world pg.events pg.steps pg.chain pg.baseSteps = .ok (w', ts, wb)) :
    (Command.step X dc B me f kb result).1.world = w' := by
  obtain ⟨argv, phase, acc⟩ := st
  simp only at hph hacc hp
  subst hph hacc
  have hcp : Command.custodyPhase false 2 = false := by decide
  have hsr : Command.stepResult (D := D) false 2 result = .ok result := by
    simp only [Command.stepResult, hcp, Bool.false_eq_true, ↓reduceIte]
  have hne : (pg.events.isEmpty && decide (pg.steps < pg.tipSteps)) = false := by simp [htip]
  unfold Command.step
  simp only [hk, Option.map_some, Option.getD_some, hp]
  cases cmd
  case init s => exact absurd rfl (hi s)
  all_goals
    simp only [hsr, hr, hpg, hpages, hne, hs, Bool.false_eq_true, ↓reduceIte]
    repeat' split
    all_goals first | rfl | simp_all

/-- **What a batch stages, as one page, `absorbPage` takes to the World the writer keeps**, wherever
the page's stated base cuts it (`host_run_folds`, `staged_rooted`, `honest_page_absorbed`). -/
theorem batch_page_absorbed (X : Ctx D) (hX : ∀ b c, X.decodeCall b = some c → X.callBytes c = b)
    {w : World D} (hcr : w.RowsCanon X.env) (qs : List (Host.Request Host.Frame))
    (hn : ((Host.machine X).admitBatch w qs).2.staged.size ≤ Bounds.pageStepsMax) (base : Nat) :
    ∃ wb?, Command.absorbPage X w
      (((Host.machine X).admitBatch w qs).2.staged.toList.map (Host.Page.stepEvent ∘ Prod.fst))
      ((Host.machine X).admitBatch w qs).1.steps (X.env.bytes ((Host.machine X).admitBatch w qs).1.chain) base =
        .ok (((Host.machine X).admitBatch w qs).1, ((Host.machine X).admitBatch w qs).2.staged.toList, wb?) := by
  obtain ⟨l, -, -, hh, hs⟩ := Host.host_run_folds X hX qs w {}
  have hs' : ((Host.machine X).admitBatch w qs).2.staged.toList.map Prod.fst = l := by
    simpa using hs
  have hr := (Host.machine X).staged_rooted (Host.machine_commits X) w qs
  rw [← hs'] at hh
  exact Host.honest_page_absorbed base hcr hr hh (by simpa using hn)

end

/-- **A1′ of the deployed system.** -/
theorem top_agree_pageAbsorbs (d : ByteArray → ByteArray) : Agree.pageAbsorbs (deployed d) := by
  intro hX w qs hcr r hn me f kb result p a sb pb ub tb st cmd pg pages hw hk hp hph hacc hpages hi hsa hr
    hpg hev hst hch htip
  have hX' : ∀ b c, Xd.decodeCall b = some c → Xd.callBytes c = b := hX
  have hcr' : w.RowsCanon Xd.env := hcr
  have hn' : ((Host.machine Xd).admitBatch w qs).2.staged.size ≤ Bounds.pageStepsMax := hn
  have hp' : Command.parse Xd.digestOf st.argv = .ok cmd := hp
  have hsa' : Command.syncAnchor Xd me cmd = none := hsa
  have hev' : pg.events = ((Host.machine Xd).admitBatch w qs).2.staged.toList.map (Host.Page.stepEvent ∘ Prod.fst) := hev
  have hst' : pg.steps = ((Host.machine Xd).admitBatch w qs).1.steps := hst
  have hch' : pg.chain = Xd.env.bytes ((Host.machine Xd).admitBatch w qs).1.chain := hch
  have htip' : pg.tipSteps = ((Host.machine Xd).admitBatch w qs).1.steps := htip
  obtain ⟨wb, hab⟩ := batch_page_absorbed Xd hX' hcr' qs hn' pg.baseSteps
  have hs : Command.absorbSync Xd me cmd f.world pg.events pg.steps pg.chain pg.baseSteps =
      .ok (((Host.machine Xd).admitBatch w qs).1, ((Host.machine Xd).admitBatch w qs).2.staged.toList, wb) := by
    rw [absorbSync_none hsa', hw, hev', hst', hch']
    exact hab
  exact step_page_world hk hp' hph hacc hi hr hpg hpages (by omega) hs

/-! ## The run: the founder's rotate, one batch, one page -/

/-- **The batch-and-page run**: the deployed writer's batch of one `submit` (the founder's rotate)
stages a step (at most a page of them) and moves the World; the continuation is a plain `sync` at its
log phase; the reply is an `ok` holding a page whose events are the staged ones and whose end and tip
are the writer's World. -/

exec
/bin/zsh -lc "ssh -n hbox 'cd /tank/dregg-build/nanodregg/main && git show origin/main:Spec/Proofs/Fork.lean | sed -n \"295,425p\" && git show origin/main:Spec/Proofs/Auth.lean | head -n 240 && git show origin/main:Spec/Proofs/Escrow.lean | head -n 115'" in /Users/ember/dev/redregg/work/codex/CRIT-SPEC-2
 succeeded in 429ms:
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hfp
    rfl
  | _ => simp [forkedPostDone] at hfp

/-! ## A2′, the `sync --to` arm (PROTOCOL-74) -/

/-- **A2′ (sync). A member that catches up TO another member's stated head holds that member's
history up to it.** A frame of `sync --to STEPS:CHAIN` (the continuation's argv parses so) that
persists the page steps `ts` and moves follow's World from below the anchor's step count to it or
past it, where follow's World is a fold of `l₀` from `g` and the anchor is the head of a World `wg`
folded by `lg` from the same `g`: follow's log up to the anchor (the page's prefix of
`steps - f.world.steps` steps, fixed by the premises) is `lg`, or two of the listed inputs collide.
A page that would carry follow past the anchor on another chain is refused (`forkedWorld`, nothing
kept) or does not reach the position on this frame; either way the World stays below it, outside
the premise. -/
def ForkConsistent.sync (S : System D) : Prop :=
  ∀ (me : Command.Self D) (f f' : Command.Follow D) (kb res : ByteArray)
    (ts : List (Step D × D)) (r : Command.Reply) (st : Command.State) (steps : Nat) (chain : ByteArray),
    Command.State.ofBytes kb = some st →
    Command.parse S.X.digestOf st.argv = .ok (.sync (.to steps chain)) →
    S.follow me f kb res = (f', .steps ts, r) →
    ∀ {g wg : World D} {l₀ lg : List (Step D)},
      S.fold g l₀ = .ok f.world → S.fold g lg = .ok wg →
      wg.steps = steps → S.X.env.bytes wg.chain = chain →
      f.world.steps < steps → steps ≤ f'.world.steps →
      l₀ ++ (ts.take (steps - f.world.steps)).map Prod.fst = lg ∨
        CollidesAmong S.X.env.hash
          (foldPres S.X.env g (l₀ ++ (ts.take (steps - f.world.steps)).map Prod.fst) ++
            foldPres S.X.env g lg)

/-- What `absorbSync` accepted under `sync --to`: the walk did not find the anchor forked. -/
theorem absorbSync_to {X : Ctx D} {me : Command.Self D} {w w' : World D} {evs : List ByteArray}
    {s n b : Nat} {c ch : ByteArray} {ts : List (Step D × D)} {wb : Option (World D)}
    (h : Command.absorbSync X me (.sync (.to s c)) w evs n ch b = .ok (w', ts, wb)) :
    Head.anchorCheck X.env s c w.steps w.chain ts ≠ .forked := by
  unfold Command.absorbSync at h
  split at h
  · cases h
  · simp only [Command.syncAnchor] at h
    split at h
    · cases h
    · rename_i hne
      simp only [Except.ok.injEq, Prod.mk.injEq] at h
      obtain ⟨-, rfl, -⟩ := h
      exact hne

/-- **A2′ (sync) of the deployed system**: `step_steps` (the frame absorbed a page under the
continuation's own command), `absorbSync_to` (the walk was not `forked`), `anchorCheck_reached`
(nor `unreached`), so `shared`: `anchorCheck_shared`, then `anchor_binds`. -/
theorem top_forkConsistent_sync (d : ByteArray → ByteArray) : ForkConsistent.sync (deployed d) := by
  intro me f f' kb res ts r st steps chain hst hpa h g wg l₀ lg h₀ hg hws hwc hlo hhi
  rw [fold_eq_world _ rfl rfl] at h₀ hg
  have h' : Command.step Host.Deployed.X Codec.Deployed.digestCodec (deployed d).B me f kb res =
      (f', .steps ts, r) := h
  rcases step_steps h' rfl with ⟨-, hw⟩ | ⟨cmd, evs, n, ch, base, wb, r₀, ha, -, st', hst', hpa'⟩
  · rw [hw] at hhi; omega
  · rw [hst] at hst'
    obtain rfl := Option.some.inj hst'
    have hpa₀ : Command.parse Host.Deployed.X.digestOf st.argv = .ok (.sync (.to steps chain)) := hpa
    rw [hpa₀] at hpa'
    obtain rfl := (Except.ok.inj hpa').symm
    have hrf := Command.absorbPage_admits (Command.absorbSync_ok ha)
    have hlen : f'.world.steps = f.world.steps + ts.length := by
      rw [fold_steps (RootedFold.fold hrf), List.length_map]
    have hnf := absorbSync_to ha
    have hnu := anchorCheck_reached (E := Host.Deployed.X.env) (chain := chain) (c := f.world.chain)
      (ts := ts) hlo (by omega)
    cases hk : Head.anchorCheck Host.Deployed.X.env steps chain f.world.steps f.world.chain ts with
    | forked => exact absurd hk hnf
    | unreached => exact absurd hk hnu
    | shared =>
      obtain ⟨pre, post, hts, hl, hc⟩ := Head.anchorCheck_shared hk
      have hpre : pre = ts.take (steps - f.world.steps) := by
        rw [hts, List.take_left' (by omega)]
      rw [hts] at hrf
      have hb := Head.anchor_binds deployed_lawful h₀ hrf (hl.trans hws.symm)
        (hc.trans hwc.symm) hg
      rw [← hpre]
      exact hb

theorem toAnchor_eq {e : Except Command.ParseRefusal (Command.Cmd Digest)} {s : Nat} {c : ByteArray}
    (h : toAnchor e = some (s, c)) : e = .ok (.sync (.to s c)) := by
  unfold toAnchor at h
  split at h
  · simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    rfl
  · cases h

/-- The sync runs' facts, read back (generic in the system and the inputs). -/
theorem syncRunOk_sound {S : System Digest} {me : Command.Self Digest} {g : World Digest}
    {kb res : ByteArray} {lg : List (Step Digest)} (h : syncRunOk S me g kb res lg = true) :
    ∃ st wg f' ts r, Command.State.ofBytes kb = some st ∧
      Command.parse Xd.digestOf st.argv = .ok (.sync (.to wg.steps (Xd.env.bytes wg.chain))) ∧
      World.fold Xd.env g lg = .ok wg ∧ S.follow me ⟨g, none, none⟩ kb res = (f', .steps ts, r) ∧
      wg.steps = g.steps + 1 ∧ wg.steps ≤ f'.world.steps := by
  unfold syncRunOk at h
  cases hgf : World.fold Xd.env g lg with
  | error e => rw [hgf] at h; cases h
  | ok wg =>
    rw [hgf] at h
    cases hs : Command.State.ofBytes kb with
    | none => rw [hs] at h; simp at h
    | some st =>
      cases hR : S.follow me ⟨g, none, none⟩ kb res with
      | mk f' rest =>
        obtain ⟨p, r⟩ := rest
        rw [hs, hR] at h
        simp only [Bool.and_eq_true, decide_eq_true_eq] at h
        obtain ⟨ha, ⟨hsome, hs1⟩, hs2⟩ := h
        exact ⟨st, wg, f', _, r, rfl, toAnchor_eq ha, rfl, by rw [← stepsOf_eq hsome], hs1, hs2⟩

theorem syncRunJoins_sound {S : System Digest} {me : Command.Self Digest} {g : World Digest}
    {kb res : ByteArray} {lg : List (Step Digest)} {f' : Command.Follow Digest}
    {ts : List (Step Digest × Digest)} {r : Command.Reply}
    (h : syncRunJoins S me g kb res lg = true) (hR : S.follow me ⟨g, none, none⟩ kb res = (f', .steps ts, r)) :
    (ts.take 1).map Prod.fst ≠ lg ∧
      ¬ CollidesAmong Xd.env.hash (foldPres Xd.env g ((ts.take 1).map Prod.fst) ++ foldPres Xd.env g lg) := by
  unfold syncRunJoins at h
  rw [hR] at h
  simp only [stepsOf, Option.getD_some, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1, not_collides h.2⟩

/-- **The sync runs**: the post-blind-to-anchors follower, told `sync --to` fork B's head at step 1,
walks the joining page past it (its first step is not fork B's, no listed input collides); the
deployed follower, told `sync --to` fork A's own head at step 1, walks the same page past it. -/
theorem run_syncBlind :
    (syncRunOk (syncBlind storeDigest) sMe wGenesis kToKb kPage wLog &&
      syncRunJoins (syncBlind storeDigest) sMe wGenesis kToKb kPage wLog) = true := by
  native_decide

/-
# Spec.Proofs.Auth — B1, authority confinement (TOPLEVEL-SPEC §3.1), for every cell

seL4's integrity (Sewell et al. 2011) in the kernel's terms. **The claim** (`Integrity.authority`):
along an audited log from a World whose cells are canonical, every step that changes a cell live at
the World it is taken from is a Turn the system derived from the signed call its event decodes to,
and that call was entitled to the change (`Authorized`, at the World it was derived against):

* an object: its owner's `write`/`law` (directly, or through a grant chain rooted at the owner
  carrying `mutate`), or an invoke the call's walk dispatched whose actor exercises the owner's
  `invoke method` authority;
* a member: only the signer's own `rotate`, to the key whose digest the cell precommitted, signed by
  that key;
* a grant: its retirement by its issuer, or ONE append to one counted ledger by an actor holding it;
* a value account: a transfer leg or a credit leg, under the source owner's `transfer` (or the well
  owner's `credit`) authority, exercised by the dispatched actor;
* a ROM cell (a package, the authority cell): never.

A refusal changes no cell. A cell born inside the log is covered from its birth on (the claim
quantifies over every step, at the cell live at that step's World); the birth itself is not a
change of a live cell.

**Premises.** `Audited` (each step is the system's own decision: without it a step has no call to be
authorized); `CellsCanon` at the start (the `write` arm reads its cell's slots in canonical order;
genesis has it, `genesis_cellsCanon`, and every admitted Turn keeps it). Both hold of the deployed
system.

**Lemmas.** `Spec.Proofs.AuthKernel` (a kernel lemma proved here, for KERNEL to move down:
`effect_prov`, `node_effect`, `changed_effect`), `object_turn_cases`, `write_next_slots`,
`law_next_slots`, `invoke_tree_slots`, `admit_rom`, `admit_retired`, `admit_written`.

**Floor.** `openKernel` (`Spec.Sim.Auth`): `write` without the owner check. Founder 1 of a two-founder
genesis writes founder 0's object; it derives, admits, and changes the cell, and no arm holds.

**Owed.** The arms name the authority at the receiver the walk dispatched; for a nested receiver
(an object's run) that actor is the calling object, whose own invoke is in turn authorized (its
`objectInvoke` step). A claim that chains every nested actor back to the signer is not stated here.
-/
import Spec.Proofs.AuthKernel
import Spec.Proofs.Bridge
import Spec.Sim.Auth
import Kernel.Proofs.Logic.History
import Kernel.Proofs.Frame
import Kernel.Proofs.Rederive
import Codec.Proofs.Digest

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## The claim -/

/-- **A step of a log, at the World it is taken from**: `StepAt S w l v s v'` says the system's
kernel, folding `l` from `w`, reaches `v`, takes step `s` there and reaches `v'`. -/
inductive StepAt (S : System D) : World D → List (Step D) → World D → Step D → World D → Prop
  | here {w w' : World D} {s : Step D} {rest : List (Step D)} :
      S.step w s = .ok w' → StepAt S w (s :: rest) w s w'
  | later {w w₁ v v' : World D} {s s' : Step D} {rest : List (Step D)} :
      S.step w s = .ok w₁ → StepAt S w₁ rest v s' v' → StepAt S w (s :: rest) v s' v'

/-- **What the signed call `c`, derived against `w`, was entitled to do to cell `id`** (live as `cell`
at `w`; `after` its entry once the Turn is admitted). One arm per change the kernel may make; a ROM
cell has none. Authority is read through the call's pins (`pinned`), at the receiver the call's walk
dispatched (`Dispatched`: the signed body as the signer, or a nested receiver as the object whose run
returned it). -/
inductive Authorized (X : Ctx D) (w : World D) (c : Call D) (id : D) (cell : Cell) : Option Cell → Prop
  | objectWrite {after : Option Cell} {edits : List (Nat × Option ByteArray)} {via : Option D} {owner : D} :
      cell.kind = kindObject → c.unsigned.body = .write id edits via →
      slotDigest X id cell slotOwner = .ok owner →
      Exercises X (pinned X.env w c.unsigned.pins) id .mutate via c.unsigned.member owner →
      Authorized X w c id cell after
  | objectLaw {after : Option Cell} {laws : List D} {via : Option D} {owner : D} :
      cell.kind = kindObject → c.unsigned.body = .law id laws via →
      slotDigest X id cell slotOwner = .ok owner →
      Exercises X (pinned X.env w c.unsigned.pins) id .mutate via c.unsigned.member owner →
      Authorized X w c id cell after
  | objectInvoke {after : Option Cell} {n : Nat} {wk : Walk D} {actor : D} {method : Nat} {args : ByteArray}
      {budget : Nat} {via : Option D} {owner : D} :
      cell.kind = kindObject → Dispatched X w c n wk actor (.invoke id method args budget via) →
      slotDigest X id cell slotOwner = .ok owner →
      Exercises X (pinned X.env w c.unsigned.pins) id (.invoke method) via actor owner →
      Authorized X w c id cell after
  | member {after : Option Cell} {key : ByteArray} {next : D} :
      cell.kind = kindMember → c.unsigned.body = .rotate key next → id = c.unsigned.member →
      c.unsigned.key = key → slotDigest X id cell slotNext = .ok (nextKeyDigest X key) →
      X.verify key (X.callMessage c.unsigned) c.signature = true →
      Authorized X w c id cell after
  | grantRetired {n : Nat} {wk : Walk D} {actor : D} {b : Body D} :
      cell.kind = kindGrant → Dispatched X w c n wk actor b →
      slotDigest X id cell grantIssuer = .ok actor → Authorized X w c id cell none
  | grantSpent {n : Nat} {wk : Walk D} {actor : D} {b : Body D} {base i left u : Nat} :
      cell.kind = kindGrant → Dispatched X w c n wk actor b →
      granteeHolds X (pinned X.env w c.unsigned.pins) id cell actor true = .ok () →
      LedgerBase base → ledgerLeft base id cell = .ok (i, left) → 0 < u → u ≤ left → i ≤ ledgerSpendsMax →
      Authorized X w c id cell (some { cell with slots := cell.slots.set (base + i) (countBytes (left - u)) })
  | account {after : Option Cell} {n : Nat} {wk : Walk D} {actor : D} {b : Body D} :
      cell.kind = kindAccount → Dispatched X w c n wk actor b →
      AccountMove X (pinned X.env w c.unsigned.pins) actor b id → Authorized X w c id cell after

/-- **B1. Authority confinement.** Along an audited log from a World whose cells are canonical,
every step that changes a cell live at the World it is taken from is a Turn, derived by the
system's `receive` from the signed call its event decodes to, and that call was entitled to the
change (`Authorized`, at the World it was derived against). A refusal never changes a cell. -/
def Integrity.authority (S : System D) : Prop :=
  ∀ {w w' : World D} {l : List (Step D)}, Audited S w l w' → CellsCanon S.X.env w →
    ∀ {v v' : World D} {s : Step D}, StepAt S w l v s v' →
    ∀ {id : D} {cell : Cell}, v.live S.X.env id = some cell → v'.live S.X.env id ≠ some cell →
      ∃ t c, s = .turn t ∧ S.X.decodeCall t.event = some c ∧ S.receive v c = .ok t ∧
        Authorized S.X v c id cell (v'.live S.X.env id)

/-! ## The kernel's step -/

/-- **One derived and admitted Turn changes a live cell only as the call was entitled to.** A ROM
cell is kept (`admit_rom`); an object by `object_turn_cases` and the owner check each of its
receivers passed; any other cell carries an effect of the walk (`changed_effect`) that one
dispatched receiver derived (`effect_prov`), whose kind and authority `node_effect` names. -/
theorem step_authorized [Std.TransOrd D] [Std.LawfulEqOrd D] {X : Ctx D} {w w' : World D} {c : Call D}
    {t : Turn D} {id : D} {cell : Cell}
    (hc : receive X w c = .ok t) (ha : World.admit X.env w t = .ok w') (hcan : CellsCanon X.env w)
    (hl : w.live X.env id = some cell) (hne : w'.live X.env id ≠ some cell) :
    Authorized X w c id cell (w'.live X.env id) := by
  by_cases hrom : cell.discipline = .rom
  · exact absurd (admit_rom ha hl hrom) hne
  by_cases hk : cell.kind = kindObject
  · rcases object_turn_cases hc ha hl hk with ⟨hkeep, hnc, hnw, hnl, hni⟩ | ⟨edits, via, hb⟩ |
        ⟨laws', via, hb⟩ | ⟨n, wk, a, method, args, budget, via, hd⟩
    · exact absurd ((object_step_none (.keep hc ha hkeep hnc hnw hnl hni)).trans hl) hne
    · obtain ⟨principal, laws, -, hau, -⟩ := write_next_slots hc ha hb hl (hcan _ _ hl)
      obtain ⟨owner, ho, hx⟩ := ownerAuthority_exercises hau
      exact .objectWrite hk hb ho hx
    · obtain ⟨principal, laws, -, hau, -⟩ := law_next_slots hc ha hb hl
      obtain ⟨owner, ho, hx⟩ := ownerAuthority_exercises hau
      exact .objectLaw hk hb ho hx
    · obtain ⟨cell₀, p, r, s, calls, rows, used, laws, hr, -⟩ := invoke_tree_slots hc ha hd
      have hl₀ := invokeRun_live hr
      rw [hl] at hl₀
      cases hl₀
      obtain ⟨principal, hau⟩ := invokeRun_authority hr
      obtain ⟨owner, ho, hx⟩ := ownerAuthority_exercises hau
      exact .objectInvoke hk hd ho hx
  obtain ⟨R, e, hR, he, heid, x, hx, hxc, hxa⟩ := changed_effect hc ha hl hne
  obtain ⟨n, wk, a, b, hd, hroot, hprov⟩ := effect_prov hR he
  have hnode : NodeEffect X (pinned X.env w c.unsigned.pins) c a b e := by
    rcases hprov with ⟨r, hi, hr, her⟩ | ⟨obj, method, args, budget, via, cl, p, rq, -, he1, hir⟩
    · exact node_effect hi hr e her
    · exact .inl ⟨cl, he1 ▸ invokeRun_readKind hir⟩
  obtain ⟨eid, eact⟩ := e
  simp only at heid hxa
  subst heid
  rcases hnode with ⟨cl, hko⟩ | ⟨key, next, m, hb, hm, hkm, hkey, hslot⟩ | ⟨cl, hkg, hret | ⟨hsp, hh⟩⟩ |
      ⟨cl, hka, hmove⟩
  · exact absurd (readKind_live hko hl).2 hk
  · obtain ⟨rfl, hkind⟩ := readKind_live hkm hl
    have hb' : c.unsigned.body = .rotate key next := by
      rcases hroot with ⟨hb0, -⟩ | hcall
      · exact hb0.symm.trans hb
      · rw [hb] at hcall; simp [Body.callable] at hcall
    obtain ⟨-, hw⟩ := receive_ok_with hc
    obtain ⟨hv, -⟩ := receiveWith_sealed hw
    rw [hkey] at hv
    exact .member hkind hb' hm hkey hslot hv
  · obtain ⟨rfl, hkind⟩ := readKind_live hkg hl
    have hnone := admit_retired ha hx (hxa.trans hret.1)
    rw [hxc] at hnone
    rw [hnone]
    exact .grantRetired hkind hd hret.2
  · obtain ⟨rfl, hkind⟩ := readKind_live hkg hl
    obtain ⟨base, i, left, u, hbase, hll, hu0, hu, hi, hw⟩ := hsp
    obtain ⟨cell1, post, hc1, hp, hl'⟩ := admit_written ha hx (hxa.trans hw)
    rw [hxc] at hc1 hl'
    rw [hl] at hc1
    cases hc1
    rw [hl', postWrite_eq hp]
    exact .grantSpent hkind hd hh hbase hll hu0 hu hi
  · obtain ⟨rfl, hkind⟩ := readKind_live hka hl
    exact .account hkind hd hmove

/-- **B1 of every system whose kernel is the kernel**: each step of the audited log is a refusal
(which keeps every cell, `refuse_live`) or the kernel's derived and admitted Turn
(`step_authorized`); canonicity is carried along (`admit_cellsCanon`). -/
theorem authority_of_kernel [Std.TransOrd D] [Std.LawfulEqOrd D] (S : System D)
    (hrc : S.receive = receive S.X) (ha : S.admit = World.admit S.X.env)
    (hr : S.refuse = World.refuse S.X.env) : Integrity.authority S := by
  intro w w' l hau hcan v v' s hst
  have hd := hau.2
  clear hau
  revert hd hcan
  induction hst with
  | @here w₀ w₁ s₀ rest hs =>
      intro hcan hd id cell hl hne
      cases s₀ with
      | refusal r =>
          simp only [System.step, hr] at hs
          exact absurd ((refuse_live hs id).trans hl) hne
      | turn t =>
          simp only [System.step, ha] at hs
          obtain ⟨c, hdc, hc, -⟩ := hd
          refine ⟨t, c, rfl, hdc, hc, ?_⟩
          rw [hrc] at hc
          exact step_authorized hc hs hcan hl hne
  | @later w₀ w₁ v₀ v₁ s₀ s₁ rest hs _ ih =>
      intro hcan hd
      cases s₀ with
      | refusal r =>
          simp only [System.step] at hs
          obtain ⟨-, -, -, -, -, hnext⟩ := hd
          have hs' : World.refuse S.X.env w₀ r = .ok w₁ := hr ▸ hs
          intro id cell
          exact @ih (fun id cl hl => hcan id cl ((refuse_live hs' id).symm.trans hl)) (hnext _ hs) id cell
      | turn t =>
          simp only [System.step] at hs
          obtain ⟨-, -, -, hnext⟩ := hd
          have hs' : World.admit S.X.env w₀ t = .ok w₁ := ha ▸ hs
          intro id cell
          exact @ih (admit_cellsCanon hcan hs') (hnext _ hs) id cell

/-- **B1 of the deployed system.** -/
theorem top_integrity_authority (d : ByteArray → ByteArray) : Integrity.authority (deployed d) :=
  authority_of_kernel (deployed d) rfl rfl rfl

/-! ## The floor: the kernel whose `write` checks no owner -/

/-- A dispatched invoke is the signed body or below a signed invoke. -/
theorem dispatched_signed {X : Ctx D} {w : World D} {c : Call D} {n : Nat} {wk : Walk D} {a : D} {b : Body D}
    (h : Dispatched X w c n wk a b) :
    b = c.unsigned.body ∨ ∃ o m args budget via, c.unsigned.body = .invoke o m args budget via := by
  induction h with
  | root => exact .inl rfl
  | call _ _ _ _ _ _ _ ih =>
      rcases ih with h | h
      · exact .inr ⟨_, _, _, _, _, h.symm⟩
      · exact .inr h

/-- **The open write**: the create re-derives from the two-founder genesis; the deployed kernel
refuses founder 1's write of the object; the open kernel derives it (its event decodes to it) and
the kernel admits it; the object is live as an object, its cell changes, and its owner slot reads a
member other than the signer. -/
theorem run_open_write :
/-
# Spec.Proofs.Escrow — B2's one-party escrow: it pays out at most once

**`Integrity.escrow S`** (over the field `S.escrow`) (TOPLEVEL-SPEC §3.2): along any `ObjectHistory` of one object at the
system's `Ctx` (every step of the World as the object sees it: its signed and nested invokes, writes,
law changes, every other turn and recorded refusal) whose every judged step reads the object's
package as `E`, at most one call the invokes return is a payout (a transfer with no grant,
`isPayoutCall`). `E` is the component the claim varies: LEDGER's escrow (`Ledger.Escrow.escrow`,
`world/escrow/Escrow`) at `deployed`. Owed: a `System` field `escrow : Lang.Package` (deployed
`Ledger.Escrow.escrow`); the claim then reads `S.escrow`.

Premises, each needed: the `Ctx` is lawful (digests read back) and its program is the language over
its own codec and receipt check (`S.rc`); both hold of `deployed` (`deployed_ctx_lawful`, `rfl`).
The history and the package reading are the claim's subject, not assumptions.

* `top_integrity_escrow`: `Ledger.Proofs.escrow_invokes_one_payout`.
* `floor_integrity_escrow`: the claim refuses `esLazy` (no law on its invokes, and its refund spending
  `"refund"` rather than the shared `"payout"`): at the deployed `Ctx`, from the World a founder's
  install, issue, create, deposit and top-up stage, a release and then a refund are each derived and
  admitted, and the two-step history pays out twice. Either guard alone holds the bound (measured on
  the same run: the law alone refuses the refund `lawDenied`, the shared key alone `spent`), so the
  lazy escrow must drop both: the claim is about the package, and the kernel's once nullifier is the
  package's second line, not the kernel's own promise.
* `inhabited_escrow`: under the deployed escrow the same run's release is an admitted invoke step
  whose history pays out once: the bound is reached.

The history is built step by step from the computed run (`esStep_sound`: an `EsStep` whose Boolean
facts hold IS an `ObjectStep.invoke`), so the run's history is not an existential: its entries, and
the calls `payoutCalls` counts, are the run's.
-/
import Spec.Sim.Escrow
import Ledger.Proofs.EscrowInvokes
import Kernel.Proofs.RootedDeployed

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec
open Nanodregg.Lang
open Nanodregg.Ledger.Escrow

/-! ## The claim -/

section
variable {D : Type} [Ord D] [DecidableEq D]

/-- **B2, one-party escrow. It pays out at most once.** At a lawful `Ctx` running the language over
its own codec and the system's receipt check, along any history of one object whose every judged step
reads its package as `S.escrow`, at most one returned call is a payout. -/
def Integrity.escrow (S : System D) : Prop :=
  S.X.Lawful → S.X.program = Lang.program S.X.env.bytes S.X.digestOf S.rc →
    ∀ {obj pkg : D} {w w' : World D}
      {tr : List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))},
      ObjectHistory S.X obj w w' tr → (∀ e ∈ tr, e.2.1 = some pkg ∧ readPackage e.1 pkg = .ok S.escrow) →
      payoutCalls (tr.map fun e => e.2.2.2.2.2.2) ≤ 1

end

/-! ## The top theorem -/

/-- **TOP (B2, one-party escrow).** The deployed system with LEDGER's escrow
(`Ledger.Proofs.escrow_invokes_one_payout`). -/
theorem top_integrity_escrow (d : ByteArray → ByteArray) : Integrity.escrow (deployed d) := by
  intro hX hprog obj pkg w w' tr h hpkg
  exact Ledger.Proofs.escrow_invokes_one_payout hX hprog h hpkg

/-! ## A computed step is an object step -/

theorem esOk_eq {ε α : Type} {e : Except ε α} (d : α) (h : esOk e = true) : e = .ok (esGet e d) := by
  cases e with
  | ok a => rfl
  | error _ => cases h

/-- **A computed invoke step whose facts hold is an `ObjectStep.invoke`** of the run's object, from
the World it was signed on to the World its Turn leaves, with its entry `esEntry`, which names the
run's package and reads it as `P`. -/
theorem esStep_sound {P : Package} {r : EsRun} {w : World Digest} {i method : Nat}
    (h : esStepOk P r method (esStep r w i method) = true) :
    ObjectStep Xd r.obj w (esStep r w i method).w' (some (esEntry (esStep r w i method))) ∧
    (esEntry (esStep r w i method)).2.1 = some r.pkg ∧
    readPackage (esEntry (esStep r w i method)).1 r.pkg = .ok P := by
  generalize hs : esStep r w i method = s at h ⊢
  have hw : s.w = w := by rw [← hs]; rfl
  have ht : s.t = esGet (receive Xd s.w s.c) tMint := by rw [← hs]; rfl
  have hw' : s.w' = esGet (World.admit Xd.env s.w s.t) s.w := by rw [← hs]; rfl
  have hir : s.ir = esGet (invokeRun Xd (pinned Xd.env s.w s.c.unsigned.pins) s.c s.c.unsigned.member r.obj method none)
      (mintCell, r.pkg, reqOf s.c.unsigned r.obj r.obj .birth) := by rw [← hs]; rfl
  have hrun : s.run = esGet (Xd.program.run (pinned Xd.env s.w s.c.unsigned.pins) (rowView Xd.env s.w s.c.unsigned) s.ir.2.1
      (stateOf s.ir.1) method (noArgs.getD .empty) s.ir.2.2 (min 100000 (poolOf s.c.unsigned.body))) ([], [], [], 0) := by
    rw [← hs]; rfl
  have hl : s.laws = esGet (lawsOf Xd r.obj s.ir.1) [] := by rw [← hs]; rfl
  clear hs
  subst hw

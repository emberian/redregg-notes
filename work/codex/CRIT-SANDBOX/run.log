   183	/// Make the socket directory `d` with permission bits `perm` from mkdir alone: no chmod follows.
   184	/// A resident's socket directory is 02710 with its group from a setgid parent (HOSTING-17: SOCKDIR
   185	/// and MEMBER), and the uid making it (`nd`) is not in that group by design. Linux clears S_ISGID
   186	/// on a chmod by a caller outside the file's group (no CAP_FSETID), so a mkdir-then-chmod lands at
   187	/// 0710 and the directory's own check refused it: keybroker ended `sockDir … Mode(456)` on the
   188	/// first two-uid run (HOSTING-40). mkdir inherits S_ISGID and the group from the parent; its mode is
   189	/// masked by the process umask, so under a umask that removes a bit of `perm` (a unit's `UMask=0077`
   190	/// removes group search) the caller's `check_shared_dir` refuses the result by name, and the
   191	/// unit's UMask line is the fix, never a chmod here.
   192	pub fn make_dir(d: &std::path::Path, perm: u32) -> std::io::Result<()> {
   193	    use std::os::unix::fs::DirBuilderExt;
   194	    std::fs::DirBuilder::new().mode(perm & 0o777).create(d)
   195	}


   489	/// What the child does to itself between fork and exec. Only system calls on what the parent
   490	/// built: no allocation, no lock (the parent may have other threads, frozen mid-allocation).
   491	struct Step {
   492	    parent: rustix::process::Pid,
   493	    ruleset: Option<RulesetCreated>,
   494	    /// This launch's copy, so the step can write its pid over `SELF`.
   495	    filters: [BpfProgram; 2],
   496	    connector: Option<OwnedFd>,
   497	}
   498	
   499	impl Step {
   500	    fn run(&mut self) -> io::Result<()> {
   501	        use rustix::process::{Signal, getppid, set_parent_process_death_signal, setsid};
   502	        setsid()?;
   503	        set_parent_process_death_signal(Some(Signal::KILL))?;
   504	        // The parent died between the fork and the line above: the signal will never come.
   505	        if getppid() != Some(self.parent) {
   506	            return Err(io::Error::other("parent died"));
   507	        }
   508	        if let Some(c) = &self.connector {
   509	            rustix::io::fcntl_setfd(c, rustix::io::FdFlags::empty())?;
   510	        }
   511	        let rs = self
   512	            .ruleset
   513	            .take()
   514	            .ok_or_else(|| io::Error::other("ruleset spent"))?;
   515	        let st = rs
   516	            .restrict_self()
   517	            .map_err(|_| io::Error::other("landlock"))?;
   518	        if st.ruleset == RulesetStatus::NotEnforced || !st.no_new_privs {
   519	            return Err(io::Error::other("landlock not enforced"));
   520	        }
   521	        let me = rustix::process::getpid().as_raw_nonzero().get() as u32;
   522	        for ins in self.filters.iter_mut().flatten() {
   523	            if u64::from(ins.k) == SELF {
   524	                ins.k = me;
   525	            }
   526	        }
   527	        for f in &self.filters {
   528	            seccompiler::apply_filter(f).map_err(|_| io::Error::other("seccomp"))?;
   529	        }
   530	        Ok(())
   531	    }
   532	}
   533	
   534	/// The command that runs `r.program` confining itself first.
   535	pub(crate) fn command(r: &Resolved) -> Result<Command, ConfineError> {
   536	    let filters = filters()?;
   537	    let ruleset = ruleset(r)?;
   538	    let mut c = Command::new(&r.program);
   539	    c.env_clear();
   540	    let connector = if r.connect.is_empty() {
   541	        None
   542	    } else {
   543	        let (ours, theirs) = rustix::net::socketpair(
   544	            AddressFamily::UNIX,
   545	            SocketType::SEQPACKET,
   546	            SocketFlags::CLOEXEC,
   547	            None,
   548	        )
   549	        .map_err(|e| ConfineError::Connector(e.into()))?;
   550	        // Never 0..=2: the child's stdio is set up over those numbers before the step runs.
   551	        let theirs = rustix::io::fcntl_dupfd_cloexec(&theirs, 3)
   552	            .map_err(|e| ConfineError::Connector(e.into()))?;
   553	        c.env(CONNECTOR_ENV, theirs.as_raw_fd().to_string());
   554	        let grants: Vec<(Vec<Vec<u8>>, PathBuf)> = r
   555	            .connect
   556	            .iter()
   557	            .map(|(given, sock)| {
   558	                let names = vec![
   559	                    given.as_os_str().as_bytes().to_vec(),
   560	                    sock.as_os_str().as_bytes().to_vec(),
   561	                ];
   562	                (names, sock.clone())
   563	            })
   564	            .collect();
   565	        std::thread::Builder::new()
   566	            .name("nd-connector".into())
   567	            .spawn(move || serve(&ours, &grants))
   568	            .map_err(ConfineError::Connector)?;
   569	        Some(theirs)
   570	    };
   571	    let mut step = Step {
   572	        parent: rustix::process::getpid(),
   573	        ruleset: Some(ruleset),
   574	        filters: filters.clone(),
   575	        connector,
   576	    };
   577	    // SAFETY: `Step::run` makes only system calls on values built before the fork (the ruleset's
   578	    // descriptor, the BPF programs, the connector descriptor) and allocates nothing on its success
   579	    // path, which is what a child of a multi-threaded parent may do before `execve`.
   580	    #[allow(unsafe_code)]
   581	    unsafe {
   582	        c.pre_exec(move || step.run());
   583	    }
   584	    Ok(c)
   585	}

   587	/// The connector's parent side: answer each ask until every copy of the child's end is closed
   588	/// (the child ended, or the command was dropped unspawned).
   589	fn serve(ours: &OwnedFd, grants: &[(Vec<Vec<u8>>, PathBuf)]) {
   590	    let mut ask = [0u8; ASK_MAX + 1];
   591	    loop {
   592	        let n = match rustix::net::recv(ours, &mut ask, RecvFlags::empty()) {
   593	            Ok((0, _)) | Err(_) => return,
   594	            Ok((n, _)) => n,
   595	        };
   596	        let asked = &ask[..n.min(ask.len())];
   597	        let granted = grants
   598	            .iter()
   599	            .find(|(names, _)| names.iter().any(|g| g.as_slice() == asked));
   600	        let dialed = match granted {
   601	            Some((_, sock)) if n <= ASK_MAX => dial(sock),
   602	            _ => Err(rustix::io::Errno::ACCESS),
   603	        };
   604	        let (code, fd) = match &dialed {
   605	            Ok(fd) => (0u32, Some(fd.as_fd())),
   606	            Err(e) => (e.raw_os_error() as u32, None),
   607	        };
   608	        let fds = fd.as_slice();
   609	        let mut space = [MaybeUninit::uninit(); rustix::cmsg_space!(ScmRights(1))];
   610	        let mut control = SendAncillaryBuffer::new(&mut space);
   611	        if !fds.is_empty() {
   612	            control.push(SendAncillaryMessage::ScmRights(fds));
   613	        }
   614	        let bytes = code.to_le_bytes();
   615	        if rustix::net::sendmsg(
   616	            ours,
   617	            &[IoSlice::new(&bytes)],
   618	            &mut control,
   619	            SendFlags::empty(),
   620	        )
   621	        .is_err()
   622	        {
   623	            return;
   624	        }
   625	    }
   626	}
   627	
   628	/// One non-blocking connect, as `nd_unix_connect` makes it: a full backlog is `EAGAIN` at once.
   629	fn dial(sock: &Path) -> rustix::io::Result<OwnedFd> {
   630	    let fd = rustix::net::socket_with(
   631	        AddressFamily::UNIX,
   632	        SocketType::STREAM,
   633	        SocketFlags::CLOEXEC | SocketFlags::NONBLOCK,
   634	        None,
   635	    )?;
   636	    rustix::net::connect(&fd, &SocketAddrUnix::new(sock)?)?;
   637	    Ok(fd)
   638	}
   639	
   640	/// The child's side of the connector: the socket at `path`, if the launcher's policy grants it.
   641	pub(crate) fn ask(connector: &OwnedFd, path: &Path) -> io::Result<OwnedFd> {
   642	    let p = path.as_os_str().as_bytes();
   643	    if p.len() > ASK_MAX {
   644	        return Err(io::Error::from_raw_os_error(libc::ENAMETOOLONG));
   645	    }
   646	    rustix::net::send(connector, p, SendFlags::empty())?;
   647	    let mut code = [0u8; 4];
   648	    let mut space = [MaybeUninit::uninit(); rustix::cmsg_space!(ScmRights(1))];
   649	    let mut control = RecvAncillaryBuffer::new(&mut space);
   650	    let got = rustix::net::recvmsg(
   651	        connector,
   652	        &mut [IoSliceMut::new(&mut code)],
   653	        &mut control,
   654	        RecvFlags::CMSG_CLOEXEC,
   655	    )?;
   656	    let mut fd = None;
   657	    for m in control.drain() {
   658	        if let RecvAncillaryMessage::ScmRights(mut fds) = m {
   659	            fd = fd.or(fds.next());
   660	        }
   661	    }
   662	    if got.bytes != 4 {
   663	        return Err(io::Error::new(
   664	            io::ErrorKind::UnexpectedEof,
   665	            "connector closed",
   666	        ));
   667	    }
   668	    match (u32::from_le_bytes(code), fd) {
   669	        (0, Some(fd)) => Ok(fd),
   670	        (0, None) => Err(io::Error::other("connector sent no socket")),
   671	        (e, _) => Err(io::Error::from_raw_os_error(e as i32)),
   672	    }
   673	}


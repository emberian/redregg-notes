    72	    };
    73	    if write_frame(&mut s, &a).is_err() {
    74	        return "denied write".into();
    75	    }
    76	    let f = match read_frame(&mut s) {
    77	        Ok(f) => f,
    78	        Err(e) => return format!("denied read {e:?}"),
    79	    };

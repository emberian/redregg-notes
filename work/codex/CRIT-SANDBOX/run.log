   116	/// The interpreters the kernel opens to run `program`: its `#!` interpreter (and that one's), its
   117	/// ELF `PT_INTERP` loader. Each must be executable in the child as the program itself is.
   118	fn interpreters(program: &Path) -> Vec<PathBuf> {
   119	    let mut out = Vec::new();
   120	    let mut at = program.to_path_buf();
   121	    for _ in 0..3 {
   122	        let next = match interpreter(&at) {
   123	            Some(p) => p,
   124	            None => break,
   125	        };
   126	        let Ok(next) = next.canonicalize() else { break };
   127	        if out.contains(&next) {
   128	            break;
   129	        }
   130	        out.push(next.clone());
   131	        at = next;
   132	    }
   133	    out
   134	}

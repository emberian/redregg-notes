    43	fn errno(e: &std::io::Error) -> String {
    44	    let name = match e.kind() {
    45	        ErrorKind::PermissionDenied => "EACCES/EPERM".to_string(),
    46	        ErrorKind::NotFound => "ENOENT".to_string(),
    47	        ErrorKind::ReadOnlyFilesystem => "EROFS".to_string(),

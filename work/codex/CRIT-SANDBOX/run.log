    46	    /// itself). The program must lie under (or be) a `read` or `exec` entry, after canonicalizing:
    47	    /// a symlinked program does not widen the policy to its target (`ProgramOutside`).
    48	    pub exec: Vec<PathBuf>,
    49	    /// Paths that must lie outside everything above (the member's workspace). Each must exist.
    50	    pub hidden: Vec<PathBuf>,
    51	    /// Unix sockets the child may connect to, at most [`CONNECT_MAX`] (HOSTING-17 §5). Each is
    52	    /// checked before launch; Linux exposes its parent directory (which must hold that socket and
    53	    /// nothing else: the socket's owner keeps it so), macOS allows connecting to that path alone.
    54	    pub connect: Vec<PathBuf>,
    55	}
    56	
    57	impl Policy {
    58	    /// The list a launcher flag names (`--read`, `--write`, `--exec`, `--hide`, `--connect`): the one
    59	    /// reading of a policy's flag words, nd-supervise's argv and `nd --join`'s spawner (CLIENT-26).
    60	    pub fn list(&mut self, flag: &std::ffi::OsStr) -> Option<&mut Vec<PathBuf>> {
    61	        Some(match flag.to_str()? {
    62	            "--read" => &mut self.read,
    63	            "--write" => &mut self.write,
    64	            "--exec" => &mut self.exec,
    65	            "--hide" => &mut self.hidden,
    66	            "--connect" => &mut self.connect,
    67	            _ => return None,
    68	        })
    69	    }
    70	}

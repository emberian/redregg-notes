   180	/// The ruleset of one launch, every rule holding an `O_PATH` descriptor opened now.
   181	fn ruleset(r: &Resolved) -> Result<RulesetCreated, ConfineError> {
   182	    let mut rules: Vec<(PathBuf, Rights)> = Vec::new();
   183	    for p in FLOOR {
   184	        if Path::new(p).exists() {
   185	            rules.push((p.into(), read_access));
   186	        }
   187	    }

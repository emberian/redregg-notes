   449	/// The stand-in for the child's own pid in the allow-list: above every pid (`pid_max` is at most
   450	/// 2^22), and no other instruction of the program compares with it.
   451	const SELF: u64 = 0x7EAD_BEEF;
   452	
   453	/// The two seccomp programs, built once per process: the `ENOSYS` answers (`clone3`, `io_uring`),
   454	/// then the allow-list (everything else `EPERM`).
   455	fn filters() -> Result<&'static [BpfProgram; 2], ConfineError> {
   456	    static F: OnceLock<Option<[BpfProgram; 2]>> = OnceLock::new();
   457	    let built = F.get_or_init(|| {
   458	        let arch = std::env::consts::ARCH.try_into().ok()?;
   459	        let nosys: BTreeMap<i64, Vec<SeccompRule>> = [
   460	            libc::SYS_clone3,
   461	            libc::SYS_io_uring_setup,
   462	            libc::SYS_io_uring_enter,
   463	            libc::SYS_io_uring_register,
   464	        ]
   465	        .into_iter()
   466	        .map(|n| (n, Vec::new()))
   467	        .collect();
   468	        let nosys = SeccompFilter::new(
   469	            nosys,
   470	            SeccompAction::Allow,
   471	            SeccompAction::Errno(libc::ENOSYS as u32),
   472	            arch,
   473	        )
   474	        .ok()?;
   475	        let allow = SeccompFilter::new(
   476	            syscall_rules().into_iter().collect(),
   477	            SeccompAction::Errno(libc::EPERM as u32),
   478	            SeccompAction::Allow,
   479	            arch,
   480	        )
   481	        .ok()?;
   482	        Some([nosys.try_into().ok()?, allow.try_into().ok()?])
   483	    });
   484	    built
   485	        .as_ref()
   486	        .ok_or(ConfineError::MechanismMissing("seccomp"))
   487	}

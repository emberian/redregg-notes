    81	        .create(true)
    82	        .append(true)
    83	        .open(recv)
    84	        .and_then(|mut r| r.write_all(&f));
    85	    if kept.is_err() {
    86	        return "denied recv".into();
    87	    }
    88	    match Answer::decode(&f) {
    89	        Ok(Answer::Reply { text }) => format!("ok reply {}", String::from_utf8_lossy(&text)),
    90	        Ok(Answer::Status { status }) => format!("ok status {status}"),
    91	        Ok(Answer::Refused { broker_refusal }) => format!("ok refused {}", broker_refusal.name()),
    92	        Err(e) => format!("denied decode {e:?}"),
    93	    }
    94	}

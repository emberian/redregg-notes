    72	/// Why a child was not launched.
    73	#[derive(Debug)]
    74	pub enum ConfineError {
    75	    /// This platform has no confinement mechanism nanodregg trusts.
    76	    Unsupported,
    77	    /// The mechanism is absent: `sandbox-exec` not at its fixed path (macOS); a kernel without
    78	    /// Landlock ABI 3, or a seccomp program that cannot be built for this architecture (Linux).
    79	    MechanismMissing(&'static str),
    80	    /// The connector of a child with `connect` entries could not be made (Linux).
    81	    Connector(io::Error),
    82	    /// A path cannot be named safely to the mechanism (not UTF-8, or a quote or backslash).
    83	    UnnameablePath(PathBuf),
    84	    /// A policy path does not exist (allowing or hiding nothing would pass silently).
    85	    PathMissing(PathBuf, io::Error),
    86	    /// The program is not an absolute path (a search of `PATH` would choose it).
    87	    ProgramNotAbsolute(PathBuf),
    88	    /// The program's canonical path is under no `read` or `exec` entry (a link pointing out).
    89	    ProgramOutside {
    90	        /// The program as given.
    91	        program: PathBuf,
    92	        /// Where it resolves.
    93	        canonical: PathBuf,
    94	    },
    95	    /// More than [`CONNECT_MAX`] connect entries.
    96	    ConnectTooMany(usize),
    97	    /// A connect entry is a symbolic link.
    98	    ConnectLink(PathBuf),
    99	    /// A connect entry is not a unix socket.
   100	    ConnectNotSocket(PathBuf),
   101	    /// A connect socket is neither the euid's nor in the egid's group.
   102	    ConnectOwner {
   103	        /// The socket.
   104	        path: PathBuf,
   105	        /// Its owner.
   106	        uid: u32,
   107	        /// Its group.
   108	        gid: u32,
   109	    },
   110	    /// A connect socket's mode is not exactly 0600 (the euid's) or 0660 (another uid's, our group).
   111	    ConnectMode {
   112	        /// The socket.
   113	        path: PathBuf,
   114	        /// Its mode.
   115	        mode: u32,
   116	    },
   117	    /// A directory above a connect socket is not owned by root, the euid or the socket's owner, or
   118	    /// another can write it.
   119	    ConnectDir(PathBuf),
   120	    /// An allowed path (or the floor) covers a hidden path or lies inside one (CLIENT-8).
   121	    Exposed {
   122	        /// The hidden path.
   123	        hidden: PathBuf,
   124	        /// The allowed path that reaches it.
   125	        allowed: PathBuf,
   126	    },
   127	}
   128	
   129	impl std::fmt::Display for ConfineError {
   130	    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
   131	        match self {
   132	            Self::Unsupported => write!(f, "confine: no confinement on this platform"),
   133	            Self::MechanismMissing(p) => write!(f, "confine: {p} is missing"),
   134	            Self::Connector(e) => write!(f, "confine: connector: {e}"),
   135	            Self::UnnameablePath(p) => write!(f, "confine: cannot name {}", p.display()),
   136	            Self::PathMissing(p, e) => write!(f, "confine: {}: {e}", p.display()),
   137	            Self::ProgramOutside { program, canonical } => write!(
   138	                f,
   139	                "confine: program {} resolves to {}, outside every read and exec path",
   140	                program.display(),
   141	                canonical.display()
   142	            ),
   143	            Self::ProgramNotAbsolute(p) => {
   144	                write!(f, "confine: program {} is not absolute", p.display())
   145	            }
   146	            Self::ConnectTooMany(n) => {
   147	                write!(f, "confine: {n} connect entries (at most {CONNECT_MAX})")
   148	            }
   149	            Self::ConnectLink(p) => write!(f, "confine: connect {} is a link", p.display()),
   150	            Self::ConnectNotSocket(p) => {
   151	                write!(f, "confine: connect {} is not a socket", p.display())
   152	            }
   153	            Self::ConnectOwner { path, uid, gid } => {
   154	                write!(f, "confine: connect {} is {uid}:{gid}", path.display())
   155	            }
   156	            Self::ConnectMode { path, mode } => {
   157	                write!(f, "confine: connect {} has mode {mode:o}", path.display())
   158	            }
   159	            Self::ConnectDir(p) => write!(
   160	                f,
   161	                "confine: connect: directory {} is not trusted",
   162	                p.display()
   163	            ),
   164	            Self::Exposed { hidden, allowed } => write!(
   165	                f,
   166	                "confine: exposed: {} reaches hidden {}",
   167	                allowed.display(),
   168	                hidden.display()
   169	            ),
   170	        }
   171	    }
   172	}

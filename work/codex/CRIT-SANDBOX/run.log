    96	/// One command through a member socket: `ok <exit> <text>`, the reply's stdout when the exit is
    97	/// OK, else its stderr, newlines as `|`.
    98	fn nd(rest: &str) -> String {
    99	    let mut words = rest.split(' ');
   100	    let Some(sock) = words.next() else {
   101	        return "bad-nd".into();
   102	    };
   103	    let argv: Vec<Vec<u8>> = words.map(|w| w.as_bytes().to_vec()).collect();
   104	    let mut s = match nanodregg_sandbox::connect_unix(Path::new(sock)).and_then(|s| {
   105	        s.set_read_timeout(Some(table::REPLY))?;
   106	        Ok(s)
   107	    }) {
   108	        Ok(s) => s,
   109	        Err(e) => return errno(&e),
   110	    };
   111	    let Ok(c) = (Command { argv }).encode() else {
   112	        return "bad-nd".into();
   113	    };
   114	    if frame::write(&mut s, table::LIMITS, follow_op::COMMAND, &c).is_err() {
   115	        return "denied write".into();
   116	    }
   117	    let f = match frame::read(&mut s, table::LIMITS) {
   118	        Ok(f) if f.op == status::OK => f,
   119	        Ok(f) => return format!("denied op {}", f.op),
   120	        Err(e) => return format!("denied read {e:?}"),
   121	    };
   122	    match CommandReply::decode(&f.payload) {
   123	        Ok(r) => {
   124	            let text = if r.exit == command_exit::OK {
   125	                r.stdout
   126	            } else {
   127	                r.stderr
   128	            };

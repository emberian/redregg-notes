   130	            format!("ok {} {text}", r.exit)
   131	        }
   132	        Err(e) => format!("denied decode {e:?}"),
   133	    }
   134	}
   135	
   136	fn wait(path: &str) -> String {
   137	    let deadline = Instant::now() + WAIT;
   138	    while Instant::now() < deadline {
   139	        if Path::new(path).exists() {
   140	            return "ok".into();
   141	        }
   142	        std::thread::sleep(Duration::from_millis(50));
   143	    }
   144	    "denied timeout".into()
   145	}
   146	
   147	fn attempt(op: &str, path: &str, recv: &Path) -> String {
   148	    let r = match op {
   149	        "read" => std::fs::File::open(path).and_then(|mut f| {
   150	            let mut b = Vec::new();
   151	            f.read_to_end(&mut b).map(|_| ())
   152	        }),
   153	        "write" => std::fs::write(path, b"probe"),
   154	        "connect" => nanodregg_sandbox::connect_unix(Path::new(path)).map(|_| ()),
   155	        "ask" => return ask(path, recv),
   156	        "wait" => return wait(path),
   157	        "nd" => return nd(path),
   158	        "list" => match std::fs::read_dir(path) {
   159	            Ok(rd) => {
   160	                let mut names: Vec<String> = rd
   161	                    .filter_map(|e| e.ok())
   162	                    .map(|e| e.file_name().to_string_lossy().into_owned())
   163	                    .collect();
   164	                names.sort();
   165	                return format!("ok {}", names.join(","));
   166	            }
   167	            Err(e) => Err(e),
   168	        },
   169	        _ => return "bad-op".into(),
   170	    };
   171	    match r {
   172	        Ok(()) => "ok".into(),
   173	        Err(e) => errno(&e),
   174	    }
   175	}
   176	
   177	fn main() -> ExitCode {
   178	    let args: Vec<PathBuf> = std::env::args_os().map(PathBuf::from).collect();
   179	    let (pkg, vol) = match args.as_slice() {
   180	        [_, flag, ws, ..] if flag.as_os_str() == "--stdio" => (ws.clone(), ws.clone()),
   181	        [me, ..] => {
   182	            let (Some(pkg), Some(grain)) = (me.parent(), me.parent().and_then(Path::parent)) else {
   183	                return ExitCode::from(2);
   184	            };
   185	            (pkg.to_path_buf(), grain.join("vol"))
   186	        }
   187	        [] => return ExitCode::from(2),
   188	    };
   189	    let Ok(targets) = std::fs::read_to_string(pkg.join("probe.targets")) else {
   190	        return ExitCode::from(2);
   191	    };
   192	    let recv = vol.join("probe.recv");
   193	    let Ok(mut out) = std::fs::OpenOptions::new()
   194	        .create(true)
   195	        .append(true)
   196	        .open(vol.join("probe.out"))
   197	    else {
   198	        return ExitCode::from(3);
   199	    };
   200	    for line in targets.lines() {
   201	        let mut f = line.splitn(3, ' ');
   202	        if let (Some(name), Some(op), Some(path)) = (f.next(), f.next(), f.next()) {
   203	            let v = attempt(op, path, &recv);
   204	            if writeln!(out, "{name} {v}")
   205	                .and_then(|()| out.flush())
   206	                .is_err()
   207	            {
   208	                return ExitCode::from(3);
   209	            }
   210	        }
   211	    }
   212	    ExitCode::SUCCESS
   213	}

    54	fn ask(path: &str, recv: &Path) -> String {
    55	    let s = nanodregg_sandbox::connect_unix(Path::new(path)).and_then(|s| {
    56	        s.set_read_timeout(Some(ASK))?;
    57	        Ok(s)
    58	    });
    59	    let mut s = match s {
    60	        Ok(s) => s,
    61	        Err(e) => return errno(&e),
    62	    };
    63	    let Ok(a) = (Ask::Ask {
    64	        model: b"claude-m".to_vec(),
    65	        max_tokens: 10,
    66	        system: vec![],
    67	        roles: vec![0],
    68	        texts: vec![b"hello".to_vec()],
    69	    })

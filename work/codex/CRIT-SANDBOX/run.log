   136	/// One interpreter of `path`: the first word of a `#!` line, or a 64-bit little-endian ELF's
   137	/// `PT_INTERP`. Unreadable or anything else: none (the kernel then refuses the exec on its own).
   138	fn interpreter(path: &Path) -> Option<PathBuf> {
   139	    let mut head = Vec::new();
   140	    std::fs::File::open(path)
   141	        .ok()?
   142	        .take(4096)
   143	        .read_to_end(&mut head)
   144	        .ok()?;
   145	    if let Some(line) = head.strip_prefix(b"#!") {
   146	        let line = line.split(|b| *b == b'\n').next()?;
   147	        let word = line
   148	            .split(|b| *b == b' ' || *b == b'\t')
   149	            .find(|w| !w.is_empty())?;
   150	        return Some(PathBuf::from(OsString::from_vec(word.to_vec())));
   151	    }
   152	    if head.get(..6)? != b"\x7fELF\x02\x01" {
   153	        return None;
   154	    }
   155	    let u16_at = |o: usize| Some(u16::from_le_bytes(head.get(o..o + 2)?.try_into().ok()?));
   156	    let u64_at = |b: &[u8], o: usize| Some(u64::from_le_bytes(b.get(o..o + 8)?.try_into().ok()?));
   157	    let phoff = usize::try_from(u64_at(&head, 0x20)?).ok()?;
   158	    let (entsize, count) = (usize::from(u16_at(0x36)?), usize::from(u16_at(0x38)?));
   159	    let mut f = std::fs::File::open(path).ok()?;
   160	    let mut table = vec![0u8; entsize.checked_mul(count)?];
   161	    std::io::Seek::seek(&mut f, std::io::SeekFrom::Start(phoff as u64)).ok()?;
   162	    f.read_exact(&mut table).ok()?;
   163	    for ph in table.chunks(entsize) {
   164	        // PT_INTERP = 3: p_offset at 8, p_filesz at 32.
   165	        if u32::from_le_bytes(ph.get(..4)?.try_into().ok()?) == 3 {
   166	            let (off, len) = (u64_at(ph, 8)?, usize::try_from(u64_at(ph, 32)?).ok()?);
   167	            let mut name = vec![0u8; len.min(4096)];
   168	            std::io::Seek::seek(&mut f, std::io::SeekFrom::Start(off)).ok()?;
   169	            f.read_exact(&mut name).ok()?;
   170	            let name = name.split(|b| *b == 0).next()?;
   171	            return Some(PathBuf::from(OsString::from_vec(name.to_vec())));
   172	        }
   173	    }
   174	    None
   175	}

    21	use std::ffi::{OsStr, OsString};
    22	use std::os::unix::ffi::OsStrExt;
    23	use std::path::{Path, PathBuf};
    24	
    25	use generated::wire::LaunchFailure;
    26	use nanodregg_sandbox::{ConfineError, Policy};
    27	
    28	pub use nanodregg_sandbox::say;
    29	
    30	/// A plan path (the joined, Lean-checked bytes) under the operator's hosting root.
    31	pub fn under(root: &Path, rel: &[u8]) -> PathBuf {
    32	    root.join(OsStr::from_bytes(rel))
    33	}
    34	
    35	/// The paths of one launch frame, as Lean planned them (relative, joined, clean).
    36	pub struct PlanPaths<'a> {
    37	    /// read, under the hosting root
    38	    pub read: &'a [Vec<u8>],
    39	    /// read and write, under the hosting root
    40	    pub write: &'a [Vec<u8>],
    41	    /// executable, under the hosting root
    42	    pub exec: &'a [Vec<u8>],
    43	    /// sockets, under the BROKER root (HOSTING-17 §6)
    44	    pub broker: &'a [Vec<u8>],
    45	    /// sockets, under the MEMBER root (HOSTING-20, HOSTING-25)
    46	    pub member: &'a [Vec<u8>],
    47	    /// hidden, under the hosting root
    48	    pub hidden: &'a [Vec<u8>],
    49	}
    50	
    51	/// The operator's three roots a launch frame's paths are joined onto.
    52	pub struct Roots<'a> {
    53	    /// the hosting root: read, write, exec, hidden and the program
    54	    pub root: &'a Path,
    55	    /// the broker root (keybroker's SOCKDIR): the `broker` sockets
    56	    pub broker: &'a Path,
    57	    /// the member root: the `member` sockets
    58	    pub member: &'a Path,
    59	}
    60	
    61	/// The `sandbox::Policy` of a launch frame: every path joined onto the hosting root, except the two
    62	/// socket lists, each joined onto its own root (`connect` = the broker sockets, then the member
    63	/// sockets). Nothing is added, dropped or reordered: the plan is Lean's.
    64	pub fn policy(r: &Roots<'_>, p: &PlanPaths<'_>) -> Policy {
    65	    let all = |base: &Path, ps: &[Vec<u8>]| ps.iter().map(|q| under(base, q)).collect::<Vec<_>>();
    66	    let mut connect = all(r.broker, p.broker);
    67	    connect.extend(all(r.member, p.member));
    68	    Policy {
    69	        read: all(r.root, p.read),
    70	        write: all(r.root, p.write),
    71	        exec: all(r.root, p.exec),
    72	        hidden: all(r.root, p.hidden),
    73	        connect,
    74	    }
    75	}
    76	
    77	/// HOSTING-17 §8, HOSTING-25: the hosting, broker and member roots are pairwise disjoint trees, so
    78	/// no file grant under one root names a socket of another, compared after canonicalizing.
    79	pub fn roots_disjoint(r: &Roots<'_>) -> bool {
    80	    pairwise_apart(&[r.root, r.broker, r.member])
    81	}
    82	
    83	/// No path of `ps` lies under (or is) another: the roots are pairwise disjoint trees. The one
    84	/// comparison grain-launch's and nd-members' root checks share (HOSTING-32); callers canonicalize.
    85	pub fn pairwise_apart(ps: &[&Path]) -> bool {
    86	    ps.iter().enumerate().all(|(i, a)| {
    87	        ps[i + 1..]
    88	            .iter()
    89	            .all(|b| !(a.starts_with(b) || b.starts_with(a)))
    90	    })
    91	}
    92	
    93	/// The first path of a launch frame that is not the launched grain's own, or `None`: the program,
    94	/// read, write and exec paths must lie under `worlds/<label>/grains/<grain>/`, and each socket of
    95	/// either root must be `<grain>/<name>` (one name, no further component). Lean's launches never break
    96	/// this (`Hosting.Proofs.reconcile_launch_named`); a frame that does is a defect in the controller,
    97	/// and another grain's socket is another grain's identity, so grain-launch ends `foreignPath`
    98	/// instead of resolving it (HOSTING-25). Hidden paths are exempt: they name what the grain must
    99	/// not see.
   100	pub fn foreign_path<'a>(
   101	    label: &[u8],
   102	    grain: &[u8],
   103	    program: &'a [u8],
   104	    p: &PlanPaths<'a>,
   105	) -> Option<&'a [u8]> {
   106	    let own = [b"worlds/".as_slice(), label, b"/grains/", grain, b"/"].concat();
   107	    let under_own = |e: &[u8]| e.len() > own.len() && e.starts_with(&own);
   108	    let own_socket = |e: &[u8]| {
   109	        e.len() > grain.len() + 1
   110	            && e.starts_with(grain)
   111	            && e[grain.len()] == b'/'
   112	            && !e[grain.len() + 1..].contains(&b'/')
   113	    };
   114	    std::iter::once(program)
   115	        .chain(
   116	            p.read
   117	                .iter()
   118	                .chain(p.write)
   119	                .chain(p.exec)
   120	                .map(Vec::as_slice),
   121	        )
   122	        .find(|e| !under_own(e))
   123	        .or_else(|| {
   124	            p.broker
   125	                .iter()
   126	                .chain(p.member)
   127	                .map(Vec::as_slice)
   128	                .find(|e| !own_socket(e))
   129	        })
   130	}
   131	
   132	/// A grain name is one clean directory-name component of the label bytes (Lean's `labelOk`, which
   133	/// `plan` checks: `Codec.Path.clean` and `labelByte`, both emitted). The launcher names PID files by it, so it asserts the
   134	/// premise where the bytes enter rather than trusting it.
   135	pub fn grain_name_ok(g: &[u8]) -> bool {
   136	    !g.is_empty()
   137	        && generated::wire::path_clean(g)
   138	        && g.iter().all(|b| generated::LABEL_BYTES.contains(b))
   139	}
   140	
   141	/// Why the sandbox refused, as the wire names it (`Hosting.LaunchFailure`). Exhaustive: a new
   142	/// `ConfineError` case does not compile here until Lean names it.
   143	pub fn failure_of(e: &ConfineError) -> LaunchFailure {
   144	    match e {
   145	        ConfineError::Unsupported => LaunchFailure::Unsupported,
   146	        ConfineError::MechanismMissing(_) => LaunchFailure::MechanismMissing,
   147	        ConfineError::UnnameablePath(_) => LaunchFailure::UnnameablePath,
   148	        ConfineError::PathMissing(..) => LaunchFailure::PathMissing,
   149	        ConfineError::ProgramNotAbsolute(_) => LaunchFailure::ProgramNotAbsolute,
   150	        ConfineError::ProgramOutside { .. } => LaunchFailure::ProgramOutside,
   151	        ConfineError::Exposed { .. } => LaunchFailure::Exposed,
   152	        ConfineError::ConnectTooMany(_) => LaunchFailure::ConnectTooMany,
   153	        ConfineError::ConnectLink(_) => LaunchFailure::ConnectLink,
   154	        ConfineError::ConnectNotSocket(_) => LaunchFailure::ConnectNotSocket,
   155	        ConfineError::ConnectOwner { .. } => LaunchFailure::ConnectOwner,
   156	        ConfineError::ConnectMode { .. } => LaunchFailure::ConnectMode,
   157	        ConfineError::ConnectDir(_) => LaunchFailure::ConnectDir,
   158	        ConfineError::Connector(_) => LaunchFailure::SpawnFailed,
   159	    }
   160	}
   161	
   162	/// A grain's argv (HOSTING-27): its launch frame's paths joined exactly as [`policy`] joins them, in
   163	/// `Plan` order: the program, then for each of read, write, exec, broker and member its count and its
   164	/// paths. Hidden paths are not passed (they name what the grain must not see). The sandbox clears the
   165	/// environment and a confined grain has no /proc, so argv is how it learns where it is. The resident
   166	/// (`Hosting.Resident.place`) accepts only its own plan joined onto three roots, so a field passed
   167	/// out of order here is refused there by name (`argvNotPlan`).
   168	pub fn plan_argv(r: &Roots<'_>, program: &[u8], p: &PlanPaths<'_>) -> Vec<OsString> {
   169	    let mut v = vec![under(r.root, program).into_os_string()];
   170	    for (base, ps) in [
   171	        (r.root, p.read),
   172	        (r.root, p.write),
   173	        (r.root, p.exec),
   174	        (r.broker, p.broker),
   175	        (r.member, p.member),
   176	    ] {
   177	        v.push(ps.len().to_string().into());
   178	        v.extend(ps.iter().map(|q| under(base, q).into_os_string()));
   179	    }
   180	    v
   181	}

/-
# Lang.Contextual.CoreCalculus — CMTT's data as a `CalculusData` (lane CMTT-CORE)

The data half of CMTT as an instance of CLOSURE's abstract calculus (`Lang.Contextual.Closure`);
the laws are `Lang.Proofs.Contextual.CoreInstance.cmttLaws`, over the typing judgment
`fun Ω => HasTy (holeEnv Ω)`. A template's holes are the FREE metavariables of a Core term: the
hole named `n` is `mvar (n + d)` under `d` `letbox`es.
-/
import Lang.Contextual.Core
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

/-- The modal environment of a hole list: the hole named `n` is the first declaration named `n`. -/
def holeEnv (Ω : List (HoleDecl Ctx Ty)) : MEnv := fun n =>
  (Ω.find? fun d => d.name == n).map fun d => (d.ctx, d.ty)

/-- CMTT's data: hand-written decidable equality, hole filling `msubstP θ 0`, the exact checker,
free-variable occurrence, context deletion, strengthening/weakening at a position, variables. -/
def cmttData : CalculusData where
  Ty := Ty
  Ctx := Ctx
  Tm := Tm
  tmEq := Tm.decEq
  msubst θ t := msubstP θ 0 t
  check := check
  uses t x := uses x t
  drop Γ x := Γ.eraseIdx x
  strengthen x t := unshiftAt x t
  weaken x t := shiftAt x t
  var := Tm.var
  lookup Γ x := Γ[x]?

end Nanodregg.Lang.Contextual
/-
# Lang.Proofs.Contextual.Typing — the judgments of `Lang.Contextual.Core` (lane CMTT-CORE)

`HasTy Δ Γ t A` is CMTT's typing judgment; `HasSubst Δ Γ σ Ψ` (`σ : Ψ` under `Δ; Γ`) its pointwise
lift, inlined into the `mvar` rule so the judgment is one inductive (`HasTy.mvar'` is the textbook
rule); `Step` is weak-head reduction. Statements, hence a proof module (gate C3).
-/
import Lang.Contextual.Core

namespace Nanodregg.Lang.Contextual

/-! ## Typing -/

/-- `HasTy Δ Γ t A`: CMTT's typing judgment, `Δ; Γ ⊢ t : A`. -/
inductive HasTy : MEnv → Ctx → Tm → Ty → Prop
  | var {Δ : MEnv} {Γ : Ctx} {i : Nat} {A : Ty} :
      Γ[i]? = some A → HasTy Δ Γ (.var i) A
  | lam {Δ : MEnv} {Γ : Ctx} {A B : Ty} {t : Tm} :
      HasTy Δ (A :: Γ) t B → HasTy Δ Γ (.lam A t) (.arr A B)
  | app {Δ : MEnv} {Γ : Ctx} {A B : Ty} {t s : Tm} :
      HasTy Δ Γ t (.arr A B) → HasTy Δ Γ s A → HasTy Δ Γ (.app t s) B
  /-- The body is typed under `Ψ` ONLY; the ambient `Γ` is not available. -/
  | box {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {t : Tm} :
      HasTy Δ Ψ t A → HasTy Δ Γ (.box Ψ t) (.box Ψ A)
  | letbox {Δ : MEnv} {Γ Ψ : Ctx} {A B : Ty} {t s : Tm} :
      HasTy Δ Γ t (.box Ψ A) → HasTy (MEnv.cons (Ψ, A) Δ) Γ s B → HasTy Δ Γ (.letbox t s) B
  /-- `u :: (Ψ ⊢ A) ∈ Δ` and `σ : Ψ` (the premises of `HasSubst`, inlined). -/
  | mvar {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {u : Nat} {σ : List Tm} :
      Δ u = some (Ψ, A) → σ.length = Ψ.length →
      (∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → HasTy Δ Γ s C) →
      HasTy Δ Γ (.mvar u σ) A

/-- `HasSubst Δ Γ σ Ψ`: `Δ; Γ ⊢ σ : Ψ`, pointwise. -/
def HasSubst (Δ : MEnv) (Γ : Ctx) (σ : List Tm) (Ψ : Ctx) : Prop :=
  σ.length = Ψ.length ∧
    ∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → HasTy Δ Γ s C

/-- The `mvar` rule in its textbook form: `u :: (Ψ ⊢ A) ∈ Δ` and `Δ; Γ ⊢ σ : Ψ`. -/
theorem HasTy.mvar' {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {u : Nat} {σ : List Tm}
    (hu : Δ u = some (Ψ, A)) (hσ : HasSubst Δ Γ σ Ψ) : HasTy Δ Γ (.mvar u σ) A :=
  .mvar hu hσ.1 hσ.2

/-! ## Reduction -/

/-- Weak-head small-step reduction: β, the contextual β (`letbox (box Ψ t) s ↦ ⟦Ψ.t/u⟧s`), and
congruence in the function position of `app` and the scrutinee of `letbox`. Nothing reduces under
`lam` or inside `box` (a box body is closed over its own `Ψ` and is a value). -/
inductive Step : Tm → Tm → Prop
  | beta {A : Ty} {t s : Tm} : Step (.app (.lam A t) s) (subst [s] t)
  | letboxBox {Ψ : Ctx} {t s : Tm} : Step (.letbox (.box Ψ t) s) (msubst t 0 s)
  | appL {t t' s : Tm} : Step t t' → Step (.app t s) (.app t' s)
  | letboxL {t t' s : Tm} : Step t t' → Step (.letbox t s) (.letbox t' s)

end Nanodregg.Lang.Contextual
/-
# Lang.Proofs.Contextual.CoreInstance — the laws of CMTT as a `Calculus` (lane CMTT-CORE)

`cmttLaws : CalculusLaws cmttData (fun Ω => HasTy (holeEnv Ω))`: every theorem
`Lang.Proofs.Contextual.Closure` proves over all lawful calculi holds of CMTT. Law by law:

| law | Core |
|---|---|
| `msubst_lemma` | `hasTy_msubstP` + `holeEnv_filter` + `holeEnv_some` |
| `check_sound`, `check_complete` | `check_sound`, `check_complete` |
| `strengthen_lemma` | `hasTy_unshiftAt` |
| `strengthen_factor` | `shiftAt_unshiftAt` |
| `weaken_avoids` | `uses_shiftAt` (holds without the typing premise) |
| `hasTy_var` | `HasTy.var` |
| `uses_var` | `uses` on `var` |
-/
import Lang.Contextual.CoreCalculus
import Lang.Proofs.Contextual.Typing
import Lang.Proofs.Contextual.Core
import Lang.Proofs.Contextual.ClosureStatements

namespace Nanodregg.Lang.Contextual

theorem holeEnv_nil : holeEnv [] = MEnv.nil := rfl

/-- Removing declarations of OTHER names (or none of name `n`) leaves `n`'s lookup alone. -/
theorem holeEnv_filter (p : HoleDecl Ctx Ty → Bool) (n : Nat) :
    ∀ Ω : List (HoleDecl Ctx Ty), (∀ d ∈ Ω, d.name = n → p d = true) →
      holeEnv (Ω.filter p) n = holeEnv Ω n
  | [], _ => rfl
  | d :: Ω, h => by
    have ih := holeEnv_filter p n Ω fun d' hd' => h d' (List.mem_cons_of_mem _ hd')
    by_cases hn : d.name = n
    · have hp := h d List.mem_cons_self hn
      simp only [holeEnv, List.filter_cons_of_pos hp, List.find?_cons, hn, beq_self_eq_true]
    · have hb : (d.name == n) = false := by simp [hn]
      by_cases hp : p d = true
      · simp only [holeEnv, List.filter_cons_of_pos hp, List.find?_cons, hb] at ih ⊢
        exact ih
      · simp only [holeEnv, List.filter_cons_of_neg hp, List.find?_cons, hb] at ih ⊢
        exact ih

theorem holeEnv_some {Ω : List (HoleDecl Ctx Ty)} {n : Nat} {Ψ : Ctx} {A : Ty}
    (h : holeEnv Ω n = some (Ψ, A)) : ∃ d ∈ Ω, d.name = n ∧ d.ctx = Ψ ∧ d.ty = A := by
  unfold holeEnv at h
  simp only [Option.map_eq_some_iff, Prod.mk.injEq] at h
  obtain ⟨d, hd, hc, ht⟩ := h
  exact ⟨d, List.mem_of_find?_eq_some hd, by simpa using List.find?_some hd, hc, ht⟩

/-- **CMTT is a lawful `Calculus`.** -/
theorem cmttLaws : CalculusLaws cmttData (fun Ω => HasTy (holeEnv Ω)) where
  msubst_lemma := by
    intro Ω Γ P T θ hP hθ
    refine hasTy_msubstP hP θ 0 _ (fun v hv => absurd hv (Nat.not_lt_zero v)) ?_ ?_
    · intro n hn
      exact holeEnv_filter _ n Ω fun d _ hd => by rw [hd, hn]; rfl
    · intro n M Ψ A hn hv
      obtain ⟨d, hd, hname, hctx, hty⟩ := holeEnv_some hv
      have := hθ d hd M (by rw [hname]; exact hn)
      rw [hctx, hty] at this
      exact this
  check_sound := check_sound
  check_complete := check_complete
  strengthen_lemma := hasTy_unshiftAt
  strengthen_factor := shiftAt_unshiftAt
  weaken_avoids := fun {_ M _ x} _ => uses_shiftAt x M
  hasTy_var := HasTy.var
  uses_var := by intro x; simp [cmttData, uses]

/-! ## Toy: a template with one hole, filled -/

/-- The hole `0 :: [r : base ⊢ base]` (a continuation awaiting a response `r`). -/
private def bellHole : HoleDecl Ctx Ty := ⟨0, [.base], .base⟩

/-- The template `λx. u₀[x]`: resume the hole at the argument. -/
private def bellTemplate : Tm := .lam .base (.mvar 0 [.var 0])

/-- The filling `u₀ := r.(λy.y) r`. -/
private def bellFill : Nat → Option Tm :=
  fun n => if n = 0 then some (.app (.lam .base (.var 0)) (.var 0)) else none

/-- The template is typed WITH the hole and NOT without it; filled, it computes to
`λx. (λy.y) x` and is typed with the hole gone, through `cmttLaws.msubst_lemma`. -/
theorem bell_template_toy :
    HasTy (holeEnv [bellHole]) [] bellTemplate (.arr .base .base) ∧
      ¬ HasTy (holeEnv []) [] bellTemplate (.arr .base .base) ∧
      cmttData.msubst bellFill bellTemplate = .lam .base (.app (.lam .base (.var 0)) (.var 0)) ∧
      HasTy (holeEnv []) [] (cmttData.msubst bellFill bellTemplate) (.arr .base .base) := by
  have hT : HasTy (holeEnv [bellHole]) [] bellTemplate (.arr .base .base) :=
    HasTy.lam (HasTy.mvar' rfl (hasSubst_cons (.var rfl) (hasSubst_nil _ _)))
  refine ⟨hT, ?_, rfl, ?_⟩
  · intro h
    cases h with
    | lam hb => cases hb with | mvar hu _ _ => cases hu
  · have := cmttLaws.msubst_lemma (Ω := [bellHole]) (Γ := []) (P := bellTemplate)
      (T := .arr .base .base) bellFill hT
      (fun d hd M hM => by
        simp only [List.mem_singleton] at hd
        subst hd
        simp only [bellHole, bellFill, if_true] at hM
        injection hM with hM
        subst hM
        show HasTy (holeEnv []) [.base] _ .base
        exact HasTy.app (HasTy.lam (HasTy.var rfl)) (HasTy.var rfl))
    simpa [bellHole, bellFill] using this

/-- The instance's strengthening is the real one: `t ≡ t₀[π]` with `t₀ ≠ t`. -/
theorem cmtt_strengthen_toy :
    cmttData.strengthen 1 (.app (.var 0) (.var 2)) = (.app (.var 0) (.var 1) : Tm) ∧
      cmttData.weaken 1 (cmttData.strengthen 1 (.app (.var 0) (.var 2))) =
        (.app (.var 0) (.var 2) : Tm) :=
  ⟨rfl, rfl⟩

end Nanodregg.Lang.Contextual
/-
# Lang.Contextual.Core — contextual modal type theory, simply typed (lane CMTT-CORE)

The simply-typed fragment of Nanevski–Pfenning–Pientka, *Contextual Modal Type Theory* (TOCL
2008), with explicit simultaneous substitutions, de Bruijn indices for both kinds of variable.

* `Ty`: `base`, `arr A B`, and the contextual type `box Ψ A` (`[Ψ ⊢ A]`).
* `Ctx := List Ty` (ordinary variables; index 0 is the most recent binding) and the modal
  environment `MEnv := Nat → Option (Ctx × Ty)` (`Δ u = some (Ψ, A)` declares `u :: (Ψ ⊢ A)`;
  index 0 is the most recent `letbox`; the free metavariables of a template — its holes — are
  the indices past the bound ones, so a hole's NAME is its index at depth 0).
* `Tm`: `var i`, `lam A t`, `app t s`, `box Ψ t` (closes `t` over `Ψ`: `t`'s ordinary variables
  are `Ψ`'s and nothing else), `letbox t s` (binds one metavariable in `s`), and `mvar u σ`, the
  occurrence `u[σ]` carrying a simultaneous substitution `σ` for `u`'s local context.

Ordinary substitution is defined once over functions (`substFn f`, the instantiation of every
variable `i` by `f i`); a list `σ` denotes the function `ofList σ`, which is `σ` on its first
`σ.length` indices and the identity shifted down by `σ.length` after them (so `subst [s] t` is
β's `t[s/0]`, and `comp τ σ = σ.map (subst τ) ++ τ` is the composition exactly). `box` is opaque
to ordinary substitution and renaming: its body has no ordinary free variable of the ambient
context to rename. Metavariable renaming `mren` and metavariable substitution `msubst` go
inside `box`.

The judgments (`HasTy`, `HasSubst`, `Step`) are statements, so they live in the proof module
`Lang.Proofs.Contextual.Typing` (gate C3); this module is data only.
-/

namespace Nanodregg.Lang.Contextual

/-- Simple types with the contextual box `[Ψ ⊢ A]`. -/
inductive Ty
  | base
  | arr (dom cod : Ty)
  | box (ctx : List Ty) (ty : Ty)
  deriving Repr

/-- Ordinary contexts: index 0 is the most recently bound variable. -/
abbrev Ctx := List Ty

/-- Modal environments: `Δ u = some (Ψ, A)` is the declaration `u :: (Ψ ⊢ A)`. A function rather
than a list, so a PARTIAL metavariable substitution (`msubstP`) removes the filled declarations
and leaves every other one at its index: a list has no gaps. -/
abbrev MEnv := Nat → Option (Ctx × Ty)

/-- The empty modal environment. -/
def MEnv.nil : MEnv := fun _ => none

/-- Bind one more metavariable, at index 0 (what `letbox` does). -/
def MEnv.cons (P : Ctx × Ty) (Δ : MEnv) : MEnv
  | 0 => some P
  | v + 1 => Δ v

/-- Declare `P` at index `k`, moving the declarations at `k` and above up by one. -/
def MEnv.insert (k : Nat) (P : Ctx × Ty) (Δ : MEnv) : MEnv := fun v =>
  if v < k then Δ v else if v = k then some P else Δ (v - 1)

inductive Tm
  | var (i : Nat)
  | lam (dom : Ty) (body : Tm)
  | app (fn arg : Tm)
  /-- `box Ψ t`: the body is typed under `Ψ` alone. -/
  | box (ctx : Ctx) (body : Tm)
  /-- `letbox t s`: `t : [Ψ ⊢ A]`, and `s` sees one more metavariable, at index 0. -/
  | letbox (scrut body : Tm)
  /-- `mvar u σ`: the occurrence `u[σ]`, `σ` a substitution for `u`'s local context. -/
  | mvar (u : Nat) (σ : List Tm)
  deriving Repr

/-! ## Renaming of ordinary variables -/

/-- A renaming under one more ordinary binder. -/
def upR (ρ : Nat → Nat) : Nat → Nat
  | 0 => 0
  | i + 1 => ρ i + 1

mutual
/-- Rename the ordinary free variables of a term (not inside `box`: a box body is closed over the
ambient context). -/
def rename (ρ : Nat → Nat) : Tm → Tm
  | .var i => .var (ρ i)
/-! ## The typing judgment of the instance -/

/-- Every `ref` the term uses is a declared hole. -/
def RefsDeclared (Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)) (t : Term) : Prop :=
  ∀ n, Term.usesRef n t = true → (tyOf Ω n).isSome = true

/-- `Ω; Γ ⊢ t : T` for `Lang.Term`: every hole's context empty (a `ref` is a closed package
reference: it has no local context to substitute), every ref declared, and `t` typed by
`Lang.HasType` with the holes as the package types. -/
def LangHasTy (Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)) (Γ : List Lang.Ty) (t : Term)
    (T : Lang.Ty) : Prop :=
  (∀ d ∈ Ω, d.ctx = []) ∧ RefsDeclared Ω t ∧ HasType (ΔOf Ω) Γ t T

/-- A term typed in the empty meta-context uses no ref. -/
theorem refsDeclared_nil {t : Term} (h : RefsDeclared [] t) (n : Nat) : Term.usesRef n t = false := by
  cases hn : Term.usesRef n t with
  | false => rfl
  | true => have := h n hn; simp [tyOf] at this

theorem langHasTy_nil_iff {Γ : List Lang.Ty} {t : Term} {T : Lang.Ty} :
    LangHasTy [] Γ t T ↔ HasType [] Γ t T := by
  constructor
  · exact fun h => h.2.2
  · intro h
    refine ⟨fun d hd => by simp at hd, fun n hn => ?_, h⟩
    have := hasType_usesRef h n hn
    simp at this

/-! ## The laws -/

/-- **The deployed term language is a lawful `Calculus`** (with closed holes). -/
theorem langLaws : CalculusLaws langData LangHasTy where
  msubst_lemma := by
    intro Ω Γ P T σ hP hfill
    obtain ⟨hcl, hR, hT⟩ := hP
    have hτf : ∀ n, σ n = none →
        tyOf (Ω.filter fun d => (σ d.name).isNone) n = tyOf Ω n := fun n hn =>
      tyOf_filter _ n Ω fun d _ hd => by rw [hd, hn]; rfl
    have hM : ∀ n M A, σ n = some M → tyOf Ω n = some A → LangHasTy [] [] M A := by
      intro n M A hs ht
      obtain ⟨d, hd, hn, hA⟩ := tyOf_some ht
      have := hfill d hd M (by rw [hn]; exact hs)
      rw [hcl d hd, hA] at this
      exact this
    refine ⟨fun d hd => hcl d (List.mem_filter.1 hd).1, ?_, ?_⟩
    · intro n hn
      rcases usesRef_fillRefs σ n P hn with ⟨h1, h2⟩ | ⟨m, M, h1, h2, h3⟩
      · exact (congrArg Option.isSome (hτf n h2)).trans (hR n h1)
      · obtain ⟨A, hA⟩ := Option.isSome_iff_exists.1 (hR m h1)
        have := refsDeclared_nil (hM m M A h2 hA).2.1 n
        rw [h3] at this; cases this
    · exact fillRefs_typed (tyOf Ω) σ (fun n A h => ΔOf_getElem? h)
        (fun n M A hs ht Γ' => hasType_closed_lift (hM n M A hs ht).2.2 _ Γ')
        (fun n A hs ht => ΔOf_getElem? ((hτf n hs).trans ht)) hT hR
  check_sound := by
    intro Ψ M A h
    exact langHasTy_nil_iff.2 (Lang.infer_sound (of_decide_eq_true h))
  check_complete := by
    intro Ψ M A h
    exact decide_eq_true (Lang.infer_complete (langHasTy_nil_iff.1 h))
  strengthen_lemma := by
    intro Ψ M A x h hu
    exact langHasTy_nil_iff.2 (hasType_unshiftAt (langHasTy_nil_iff.1 h) hu)
  strengthen_factor := Term.shiftAt_unshiftAt
  weaken_avoids := fun {_ M _ x} _ => usesVar_shiftAt x M
  hasTy_var := fun h => langHasTy_nil_iff.2 (.var h)
  uses_var := by intro x; simp [langData, Term.usesVar]

/-! ## The reach: a Lang template's holes have no hypotheses -/

/-- **The boundary of the closed-hole fragment.** Every hole of a template typed by `LangHasTy`
has the empty context (the definition's first conjunct: a Lang `ref` is a closed package reference),
so no hole has a token-backed hypothesis (`Iface.hyps_real` asks each hypothesis to be a real
variable of the hole's context). Three closure paths are therefore EMPTY on every Lang template:
the `strengthening` outcome (`repairSelected`'s `D.uses` branch), the alternative-by-hypothesis
outcome, and hypothesis-derived supports (`effSupports`' second summand). They are exercised only
by the CMTT instance (`cmttLaws`). -/
theorem langTemplate_no_hyps {E : Type} (tpl : Template langData E)
    (h : Template.Typed tpl LangHasTy) : ∀ I ∈ tpl.Ω, I.hyps = [] := by
  intro I hI
  have hc : I.ctx = [] := h.1 I.decl (List.mem_map.2 ⟨I, hI, rfl⟩)
  apply List.eq_nil_iff_forall_not_mem.2
  intro x hx
  have := I.hyps_real x hx
  rw [hc] at this
  simp [langData] at this

/-! ## Toys -/

/-- The instance's strengthening is the real one: `t ≡ t₀[π]` with `t₀ ≠ t`. -/
theorem lang_strengthen_toy :
    langData.strengthen 1 (.app (.var 0) (.var 2)) = (.app (.var 0) (.var 1) : Term) ∧
      langData.weaken 1 (langData.strengthen 1 (.app (.var 0) (.var 2))) =
        (.app (.var 0) (.var 2) : Term) :=
  ⟨rfl, rfl⟩

/-- The hole `0 :: [· ⊢ nat → nat]`. -/
private def natHole : HoleDecl (List Lang.Ty) Lang.Ty := ⟨0, [], .fn .nat .nat⟩

/-- The template `(ref 0) 3`. -/
private def natTemplate : Term := .app (.ref 0) (.nat 3)

/-- The filling `ref 0 := λx. x`. -/
private def natFill : Nat → Option Term := fun n => if n = 0 then some (.lam .nat (.var 0)) else none

/-- The template is typed WITH the hole and NOT without it; filled, it computes to `(λx.x) 3` and
is typed with the hole gone, through `langLaws.msubst_lemma`. -/
theorem lang_template_toy :
    LangHasTy [natHole] [] natTemplate .nat ∧
      ¬ LangHasTy [] [] natTemplate .nat ∧
      langData.msubst natFill natTemplate = .app (.lam .nat (.var 0)) (.nat 3) ∧
      LangHasTy [] [] (langData.msubst natFill natTemplate) .nat := by
  have hT : LangHasTy [natHole] [] natTemplate .nat := by
    refine ⟨fun d hd => by simp [natHole] at hd; subst hd; rfl, fun n hn => ?_, ?_⟩
    · simp [natTemplate, Term.usesRef] at hn
      subst hn; rfl
    · exact .app (.ref rfl) (.nat (by decide))

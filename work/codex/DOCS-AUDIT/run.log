import Codec.Raw
import Codec.Varint
import Kernel.World
import Kernel.Receive.Call

/-!
# Codec.Kernel — the canonical bytes of KERNEL's values

One codec per kernel type, built from the one Stream family. Each is generic in the digest's own
codec `dc : Stream D` (the deployed 32-byte digest, or a simulation's toy digest). Kernel types carry
plain `Nat`, `List` and `ByteArray` with bounds checked in `World.admit`. So each codec is lawful on
the values within those bounds (`Codec.Proofs.Kernel`): every admitted Turn has exactly one spelling,
and every decoded value is within bounds.

Layouts (all integers little-endian, every count a u32, every byte string `u32 len ‖ bytes`):
* `Op`: tag 0 ‖ key u32 ‖ value, or tag 1 ‖ key u32.
* `Cell`: kind u32 ‖ discipline u8 ‖ slots (count ‖ (key u32 ‖ value)*).
* `Act`: tag 0 (keep), tag 1 ‖ ops, or tag 2 (retire). `Touch`: cell ‖ seen ‖ act.
* `Turn`: txId ‖ notBefore u64 ‖ validUntil u64 ‖ touches ‖ creates (id ‖ cell each, D5) ‖ nullifiers ‖ charge u64 ‖
  event ‖ rows ‖ ranges.
* Rows (KERNEL-46/48): `RowSlot` as `rowKeyBytes` (parent ‖ rel u8 ‖ kind u8 [‖ u8 len ‖ key]); `RowLeaf` on
  the World wire with its version and floor as u64 varints (`rowLeaf`, KERNEL-54), and as `rowLeafBytes`, the
  row pin's preimage, with both as u64 (`rowLeafHashed`); `RowAct`: a tag ‖ its fields; `RowTouch`: slot ‖ option seen ‖ act; `RangeRead`: parent ‖ rel u8 ‖
  u8 len ‖ prefix ‖ most u64 ‖ seen.
* `Call`: unsigned ‖ signature. `Unsigned`: member ‖ key ‖ notBefore ‖ validUntil ‖ pins ‖ maxCharge ‖
  body. `Body`: a tag (its constructor's index) ‖ its fields.
-/

namespace Nanodregg.Codec.Kernel

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Codec.Stream

variable {D : Type}

/-! ## Bounds of the wire (KERNEL's bounds where they exist) -/

/-- A list or byte string inside a signed call: the call is one event, so nothing in it exceeds
`Bounds.eventBytesMax`. -/
def callMax : Nat := Bounds.eventBytesMax

/-! ## Cells -/

def discipline : Stream Discipline :=
  refine "kernel/discipline" u8
    (fun t => if t = 0 then some .rom else if t = 1 then some .appendOnly else if t = 2 then some .ram
      else if t = 3 then some .value else none)
    (fun | .rom => 0 | .appendOnly => 1 | .ram => 2 | .value => 3)

abbrev OpF : Fin 2 → Type
  | 0 => Nat × ByteArray
  | 1 => Nat

def opWire : (s : Fin 2) → Stream (OpF s)
  | 0 => product nat32 (rawBytes Bounds.valueBytesMax)
  | 1 => nat32

def op : Stream Op :=
  refine "kernel/op" (choice 2 opWire)
    (fun | ⟨0, (k, v)⟩ => some (.set k v) | ⟨1, k⟩ => some (.erase k))
    (fun | .set k v => ⟨0, (k, v)⟩ | .erase k => ⟨1, k⟩)

def slots : Stream Slots :=
  rawList Bounds.slotsPerCellMax (product nat32 (rawBytes Bounds.valueBytesMax))

def cell : Stream Cell :=
  refine "kernel/cell" (product nat32 (product discipline slots))
    (fun (k, d, s) => some ⟨k, d, s⟩) (fun c => (c.kind, c.discipline, c.slots))

/-! ## Touches -/

abbrev ActF : Fin 3 → Type
  | 0 => Unit
  | 1 => List Op
  | 2 => Unit

def actWire : (s : Fin 3) → Stream (ActF s)
  | 0 => unit
  | 1 => rawList Bounds.opsPerWriteMax op
  | 2 => unit

def act : Stream Act :=
  refine "kernel/act" (choice 3 actWire)
    (fun | ⟨0, ()⟩ => some .keep | ⟨1, ops⟩ => some (.write ops) | ⟨2, ()⟩ => some .retire)
    (fun | .keep => ⟨0, ()⟩ | .write ops => ⟨1, ops⟩ | .retire => ⟨2, ()⟩)

def touch (dc : Stream D) : Stream (Touch D) :=
  refine "kernel/touch" (product dc (product dc act))
    (fun (c, s, a) => some ⟨c, s, a⟩) (fun x => (x.cell, x.seen, x.act))

/-! ## Rows (KERNEL-46/48): keys and leaves spelled as the kernel spells them

`rowKey` writes exactly `rowKeyBytes` and `rowLeafHashed` exactly `rowLeafBytes`
(`Codec.Proofs.Rows.rowKeyBytes_eq`, `rowLeafBytes_eq`), so the bytes a rows trie routes and hashes
by are the bytes of a lawful codec: each is injective on its domain and reads back. The World wire
writes a leaf as `rowLeaf`, the same fields with KERNEL-54's version and floor as u64 varints: the
import Codec.Refusal
import Codec.Digest

/-! # Stream — the one codec family

A `Stream α` writes a value by appending its bytes to a buffer and reads one
value at an offset of a `ByteArray`, returning the offset after it. It never
copies its input to decode, never forms a `List UInt8`, and never re-encodes to
check itself: canonicity (`Codec.Stream.Lawful`, in `Codec.StreamLaws`) is a
theorem about each combinator, proved once.

Every codec carries its `Shape`. A tag is the hash of a label and a shape
(`Codec.Tag`), so a codec whose structure changes gets a new tag without anyone
editing a literal.

Integers are fixed width, little-endian. Lengths and counts are `u32` and every
variable-size value carries its bound in its type (`Bytes max`, `Bounded max α`):
a value past its bound cannot be built, so it cannot be written, and a length
past the bound is refused by name before anything is read. -/

namespace Nanodregg.Codec

/-- The structure of a codec, as data. -/
inductive Shape where
  | unit
  | u8
  | u32
  | u64
  /-- LEB128, shortest form, below 2^32 (`Codec.Varint`). -/
  | varint
  | digest
  | bytes (max : Nat)
  | option (s : Shape)
  | product (a b : Shape)
  | sum (a b : Shape)
  | array (max : Nat) (s : Shape)
  /-- A refinement: same bytes as `s`, fewer accepted values. The shape cannot see inside its
  functions: what pins them is the refinement's lawfulness theorem (`Census.Refines`) and its codec
  vectors (`gates/codec-vectors.tsv`), and a change of meaning under the same bytes changes `name`
  (CODEC-28). -/
  | refine (name : String) (s : Shape)
  | framed (tag : Digest) (s : Shape)
  /-- One tag byte, then the shape that tag selects. -/
  | tagged (cases : List (UInt8 × Shape))
  /-- `Codec.Tree`: nodes of a tag, a payload of at most `max` bytes, at most `max` children, nested at
  most `depth` levels. -/
  | tree (max depth : Nat)
  /-- One byte from an enumerated set. -/
  | oneOf (codes : Array UInt8)
  /-- `s`, whose whole encoding is at most `limit` bytes. -/
  | within (limit : Nat) (s : Shape)
  /-- A byte string of at most `max` bytes behind a ONE-byte length (`Codec.Raw.bytes8`, `max < 256`): a
  rows key's bytes, a range prefix (KERNEL-46's `rowKeyBytes`). -/
  | bytes8 (max : Nat)
  /-- Two bytes, little-endian (`Codec.Raw.nat16`): a trie node's branching bit on a proof's path
  (KERNEL-49). -/
  | u16
  /-- Eight bytes, BIG-endian (`Stream.u64be`): a Lang datum's natural, so a relation key's bytes compare as its
  numbers (LANG-57). -/
  | u64be
/-
# Hosting.Resident.Run — `resident`: THE BAR's hosted Hermes (HOSTING-27, HOSTING-31)

    resident <the plan's paths, as grain-launch passes them>

A resident grain's program (`pkg/resident`), confined by grain-launch like any grain. It can see its
package (read), its volume (read and write), its own broker socket and its own member socket, and
nothing else. Its argv must be its plan (`Args.place`), or it ends `argvNotPlan` before reading
anything. It reads `pkg/resident.conf`, ONE Lang data value at `Bell.confTy`. Then, every
`tickMs`, for at most `lifetimeTicks` ticks:
1. Until it has the bell's shape, it describes the bell (`read OBJ ?` → `Shape.read`); a package
   that is not the Bell ends it `bellShape notBell` (HOSTING-45).
2. It reads every pending ring in ONE read (`read OBJ pending K`, K = `pending`'s declared limit →
   `Ring.readAll`), lowest first.
3. It acts on `decideTick`:
   - idle: forget a kept answer whose ring is no longer pending;
   - ask (the lowest pending ring, when no kept ring is pending): first keep the intent
     (`(unanswered restart)`) for the ring, keyed by its `(notBefore, ringer)` and its text, then
     one ask on the broker socket; the answer text replaces the intent in `vol/kept-<bell>` before
     the bell sees it (every keep is synced, renamed, directory-synced and read back);
   - answer (the kept ring, still pending): invoke `answer (notBefore, ringText, ringer, text)`
     with the ring's text and the kept answer. The client pins `pending[k]` and `rings[k]` itself
     (`derivePins`); the resident names no pin.
4. The bell taking the answer forgets it. A refusal is judged by the bell's rows: if the ring is
   no longer pending (answered already: the `rings` guard refuses `rung: answered`), the answer is
   forgotten; if it is still pending, the resident ends `answerRefused NAME` (`program` for a
   method's check such as `notResident`, `grantRight` for a grant without the right). The kept
   text stays, so a restart answers again but never asks again.
A transport failure on either socket, and every member reply that did not settle (a describe or read
that did not answer `ok`; an answer that came back neither `ok` nor `refused`: `uncertain`, `behind`,
`declined`, `client`, `open`, `hostContradicted`, `pageIo`; a refusal whose re-read failed), is logged
and retried at the next tick: a not-sent ask costs nothing, a spent one is never repeated. Retries
are bounded: `retriesMax` ticks in a row that ended on one, and the resident ends `retryExhausted`
naming the last (HOSTING-48, `Proofs.ResidentRun.no_refusal_repeats_forever`); any tick that
settles starts the count again. Every line on stderr starts `resident: `.

The tick is a tree of effects (`Prog`, HOSTING-36): `tickP` builds it, `Prog.interp` performs it one
node at a time (HOSTING-37: `interp_runs`). The order above is a theorem over every path of that tree, for every reply the
sockets and the volume could give (`Proofs.ResidentRun.tick_order`, `tick_counts`): at most one
describe, first, and only without a shape; one read; at most one ask, right after the intent was
kept for its ring; at most one invoke, of the kept answer (no ask on that path) or of this tick's
answer right after it replaced the intent.

Limits, named: a ring is its key `(notBefore, ringer)` and its text. Keys are unique among the
bell's rows, but a ringer may re-use its own key once the ring is answered AND retired, by
backdating within the kernel's window; if that happens while the old answer is still kept (its
delivery unsettled) and with the same text, the new ring is answered with the kept text, never
asked twice. A ring that lands below the kept one waits for it (`decide_kept_first`): the queue
order the resident keeps is "lowest first, the ring already asked about before any other", and a
ringer's backdate by up to windowMax heights is the order's slack the resident trusts. A late
landing of an unsettled answer cannot take a re-rung ring at the same key with another text: the
answer carries the ring's text and the `rings` guard refuses it unless that is the ring's own
(`rung: text`, LANG-59); with the same text it is the same-text case above.
`answerRefused` stops the whole queue, not one ring: a restart re-delivers the kept ring first and
stops again until the operator acts. That is right for every refusal known to reach it (the
resident is not the bell's, the grant lacks `invoke:0`, `answers` is full until the owner
retires), each of which refuses every ring alike; a refusal that singled out one ring would block
the rest behind it, and would need a refused marker to skip it. A ring RETIRED between the read and the
answer (LANG-76: anyone may abandon an unanswered ring past its patience) is not one: its answer is
refused, the re-read no longer lists it, and the answer is forgotten and the queue goes on
(`Proofs.ResidentRun.deliver_gone_continues`; resident_bell Q7 runs it). K = `pending`'s limit is complete:
the kernel holds at most `limit` rows (`relationFull`), and a range read past K is refused, never
truncated, so a missed ring would be a failed read (logged, retried), never a silent gap. A not-sent ask whose intent cannot be
forgotten ends `volume`, and the restart answers that ring `(unanswered restart)` without having
asked: one wasted answer, no meter charge.

What still stands between this process and a real model is the operator's, not code: the provider's
leaf SPKI pin in the deployed PINS file (shipped empty, so every real call is refused `pinMismatch`
before a request byte, HOSTING-28), and a provider key in keybroker's key file (Ember's act). Until
both are in place, it answers every ring `(refused pinMismatch)` or `(refused keyMissing)`.
-/
import Hosting.Resident.Args
import Hosting.Resident.Bell
import Hosting.Resident.Sockets
import Protocol.Command.Exit
import Host.File

namespace Nanodregg.Hosting.Resident

/-- How the resident ends, by name. A grain's exit code is the controller's to count, never a
verdict (any exit counts toward `crashLoop`); each code names one case on stderr. -/
inductive Exit
  /-- argv is not this resident's plan joined onto three roots (`Args.place`) -/
  | argvNotPlan
  /-- `pkg/resident.conf` is absent, unreadable, or larger than `confBytesMax` -/
/-
# Kernel.World — the World, its one transition `World.step`, and `fold`

`World.admit` IS the receive path (law 1): the Host commits exactly what it returns. A log is a
list of steps (KERNEL-47): an admitted Turn, or a recorded refusal (`World.refuse`, KERNEL-44: an
authenticated, in-window refusal, charged to its member's window budget, final for its transaction
id). `World.step` is the one transition of a log; the follower and a reopening Host fold the log
with it, and nothing else changes a World.

The kernel is generic over the digest `D` and the hash (`Env`) so that theorems can state a
hash collision as an explicit disjunct, and the simulation can run toy parameters through the
same `admit`. There is one deployed `Env` (CODEC's digest and hash).

Order of the checks `checkWith` makes (each refuses by name, nothing is written before all pass):
bounds → window (an expired retry is `outsideWindow`, whether or not its entry was pruned:
KERNEL-33) → journal (an exact retry inside its window is `replayed`) → shape → touches
(ONE lookup per touched cell: its cell pin (`stale`), then its write or retirement, and a written
value cell's decoding and floor) → value (born value cells, then every denomination's balance and
floor sums: LEDGER-2) → nullifiers → rows remain (a retired parent holds no row) → ranges (each range
read's relation, width, length and listing pin (`stale`)) → rows (each row touch in order, a pinned
row's pin (`stale`) among its checks, then a retired parent's heads) → charge → created ids → the
step counter. On the Host's path `Receive.submit` has already compared every pin before deriving the
Turn (KERNEL-66, `checkPins`), so there a `stale` from admission is not reached; a log's Turn (the
follower's fold) meets these three comparisons here.
-/
import Kernel.Check
import Kernel.Turn
import Kernel.Value
import Kernel.Trie
import Codec.Raw

namespace Nanodregg.Kernel

/-- The hash and the canonical encodings the kernel digests. CODEC supplies the deployed one. -/
structure Env (D : Type) where
  /-- the hash under a domain (deployed: cSHAKE256 with the domain as customization string,
  CODEC-7), so domains are separated by the hash, not by byte prefixes -/
  hash : (domain : String) → ByteArray → D
  /-- the digest's canonical bytes (32 for the deployed digest) -/
  bytes : D → ByteArray
  turnBytes : Turn D → ByteArray
  cellBytes : Cell → ByteArray

/-- A cell id's slot in the World: a live cell with its version, or the tombstone of a retired one.
The version (KERNEL-54) counts the cell's writes: 0 at its birth, one more per write (`touchCheck`),
refused past `Bounds.counterLimit` by name (`overBound .version`). A pin names it, so a pin observed on
the fold and stale now is BEHIND for ever: no World the fold reaches holds it again, up to a collision
on the pin inputs (`stale_behind_forever`). A pin naming a FUTURE version (AHEAD) is stale now and may
match later: it is not final.
A tomb carries none: it is terminal (an id is never reborn, `checkCreates`; nothing removes an entry). -/
inductive Entry
  | live (cell : Cell) (ver : Nat)
  | tomb
  deriving DecidableEq



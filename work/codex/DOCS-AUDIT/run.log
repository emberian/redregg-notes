13: /// `Broker.Bounds.answerMsMax`: one decider answer's deadline.
14: pub const ANSWER: Duration = Duration::from_millis(ANSWER_MS_MAX as u64);
15: 
16: /// A Lean decider's two pipes, as both its consumers hold them. Every question is one exchange: its
17: /// frames written and one verdict read under ONE deadline, `within` (`ANSWER`) from the first byte
18: /// (CLIENT-39, A18: a decider that is alive and silent wedged keybroker and nd-members for good). A
19: /// decider that misses it, or whose bytes do not decode, is LOST: a late or half-read verdict would
20: /// put the next answer out of step, so nothing is read from it again and every later exchange is
21: /// `None`. Its consumer then ends by the decider's own end or `deciderLost`, by name.
22: pub struct Decider {
23:     din: ChildStdin,
24:     dout: ChildStdout,
25:     within: Duration,
26:     lost: bool,
27: }
28: 
29: impl Decider {
30:     /// The pipes of a decider whose every answer is due `within` of its question.
31:     pub fn new(din: ChildStdin, dout: ChildStdout, within: Duration) -> Self {
32:         Self {
33:             din,
34:             dout,
35:             within,
36:             lost: false,
37:         }
38:     }
39: 
40:     /// Write `frames` and read the one verdict they ask for, within the deadline; `None` (and lost
41:     /// for good) past it or on bytes that are no verdict.
42:     pub fn exchange(&mut self, frames: &[&[u8]]) -> Option<Verdict> {
43:         if self.lost {
44:             return None;
45:         }
46:         let until = Instant::now() + self.within;
47:         let (din, dout) = (&self.din, &self.dout);
48:         let got = (|| {
49:             let mut w = Deadline::until(din, until);
50:             for f in frames {
51:                 write_frame(&mut w, f).ok()?;
52:             }
53:             Verdict::decode(&read_frame(&mut Deadline::until(dout, until)).ok()?).ok()
54:         })();
55:         self.lost = got.is_none();
56:         got
57:     }
58: 
59:     /// Whether a past exchange lost it.
60:     pub fn lost(&self) -> bool {
61:         self.lost
62:     }
63: }
64: 
65: /// The socket names the decider answers to `residents` (`Controller.dirOf` of each resident grain
66: /// the World holds), or `None` when it cannot be reached, is lost, or answers anything else.
67: pub fn ask(d: &mut Decider, at_ms: u64) -> Option<Vec<Vec<u8>>> {
68:     let req = Request::Residents { at_ms }.encode().ok()?;
69:     match d.exchange(&[&req])? {

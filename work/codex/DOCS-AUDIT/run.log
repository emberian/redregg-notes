decreasing_by omega

/-- Read the rest of a varint of at most `width` bytes, below `limit`, at `i`, having read `k` bytes worth
`acc` so far. -/
def getVarint (width limit : Nat) (b : ByteArray) (start : Nat) :
    (fuel : Nat) → (i k acc : Nat) → Except Refusal (Nat × Nat)
  | 0, _, _, _ => .error (.pastBound start width (width + 1))
  | fuel + 1, i, k, acc =>
    if h : i < b.size then
      let x := b[i].toNat
      if x < 128 then
        if x = 0 ∧ k > 0 then .error (.rejected start "varint/overlong")
        else
          let v := acc + x * 128 ^ k
          if v < limit then .ok (v, i + 1) else .error (.pastBound start (limit - 1) v)
      else getVarint width limit b start fuel (i + 1) (k + 1) (acc + (x - 128) * 128 ^ k)
    else .error (.truncated i 1)

/-- The number of bytes `putVarint n` appends. -/
def varintSize (n : Nat) : Nat :=
  if n < 128 then 1 else 1 + varintSize (n / 128)
termination_by n
def kidsBytes (d : Nat) (cs : List Tree) : ByteArray :=
  cs.foldl (fun out c => putD d c out) ByteArray.empty

mutual
/-- Read one tree nested at most `d` levels at offset `i`. The result carries its `fits` proof. -/
def getD (max limit : Nat) (b : ByteArray) : (d : Nat) → Nat → Except Refusal (Fitting max d × Nat)
  | 0, i => .error (.tooDeep i limit)
  | d + 1, i =>
    match Stream.u8.get b i with
    | .error e => .error e
    | .ok (tag, j) =>
      match Stream.varint.get b j with
      | .error e => .error e
      | .ok (n, k) =>
        if hn : n ≤ max then
          if h : k + n ≤ b.size then
            match Stream.varint.get b (k + n) with
            | .error e => .error e
            | .ok (m, l) =>
              if m ≤ max then
                match getKids max limit b d m l #[] with
                | .ok (cs, r) =>
                  if hl : cs.size ≤ max then
                    .ok (⟨node tag (b.extract k (k + n)) (cs.toList.map Subtype.val), by
                      simp only [fits, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true]
                      refine ⟨⟨by simp [ByteArray.size_extract]; omega, by simpa using hl⟩, ?_⟩
                      intro c hc
                      obtain ⟨x, _, rfl⟩ := List.mem_map.mp hc
                      exact x.2⟩, r)
                  else .error (.pastBound l max cs.size)
                | .error e => .error e
              else .error (.pastBound (k + n) max m)
          else .error (.truncated k n)
        else .error (.pastBound j max n)
termination_by d _ => (d, 0)

/-- Read `n` sibling trees, each nested at most `d` levels. -/
def getKids (max limit : Nat) (b : ByteArray) (d : Nat) :
    Nat → Nat → Array (Fitting max d) → Except Refusal (Array (Fitting max d) × Nat)


1: //! `nd ARG…` — one member command. The workspace is `$ND_WORKSPACE` (`seed`, `follow.sock`,
2: //! `host.sock`, `attempts/`). Every argument goes to `host follow` unread; `nd` performs the steps
3: //! follow returns and prints what follow says to print. The local verbs are custody, not protocol
4: //! (CLIENT-13): `nd --init` creates a member's keys, the next secret in `$ND_HOLDING` (a 0700
5: //! directory on removable media or under another account); `nd --init-hosted` creates a hosted
6: //! resident's one-record keys; `nd --init-observer` an observe-only follower driver's record,
7: //! which signs read envelopes only (CLIENT-22): a joined `--init-hosted` record sealed by
8: //! `nd --seal-observer` (a one-way rename); `nd --keys` prints custody's public keys (`key HEX`, `next HEX`)
9: //! for the operator's `host genesis`. `$ND_HOLDING` is read again only to rotate. `nd --join`: [`join`].
10: //! `nd --stdio WORKSPACE FOLLOW_SOCK HOST_SOCK` serves a hosted resident's commands on stdin
11: //! (nd-supervise's child, CLIENT-24: only STDIO_VERBS, no rotation). `$ND_FOLLOW_SOCK` / `$ND_HOST_SOCK` name the two sockets when they are not the workspace's
12: //! (HOSTING-17 §7: nd, as nd, drives the nd-hosted follower through its socket in /run/nd-follow).
13: 
14: use std::ffi::OsString;
15: use std::io::Write;
16: use std::os::unix::ffi::OsStringExt;
17: use std::path::PathBuf;
18: use std::process::ExitCode;
19: 
20: use nanodregg_client::custody::Custody;
21: use nanodregg_client::generated::{FOLLOW_SOCK, HOST_SOCK};
22: use nanodregg_client::sockets::{FollowSocket, HostSocket};
23: use nanodregg_client::table;
24: use nanodregg_client::{join, run, stdio};
25: 
26: fn main() -> ExitCode {
27:     match go() {
28:         Ok(code) => ExitCode::from(code),
29:         Err(e) => {
30:             nanodregg_sandbox::say("nd", &e);
31:             // nd's own failure is its own class, never follow's `uncertain` (PROTOCOL-7).
32:             ExitCode::from(nanodregg_client::generated::command_exit::CLIENT)
33:         }
34:     }
35: }
36: 
37: fn go() -> Result<u8, String> {
38:     let argv: Vec<OsString> = std::env::args_os().skip(1).collect();
39:     if let Some(served) = stdio::from_argv(&argv) {
40:         return served;
41:     }
42:     let ws = PathBuf::from(std::env::var_os("ND_WORKSPACE").ok_or("ND_WORKSPACE is not set")?);
43:     let holding = std::env::var_os("ND_HOLDING").map(PathBuf::from);
44:     if argv.len() == 1
45:         && (argv[0] == "--init" || argv[0] == "--init-hosted" || argv[0] == "--init-observer")
46:     {
47:         nd_dir(&ws.join("attempts"))?;
48:         let made = match holding {
49:             _ if argv[0] == "--init-hosted" => Custody::create_same_record(&ws),
50:             _ if argv[0] == "--init-observer" => Custody::create_observer(&ws),
51:             Some(h) => Custody::create_separate(&ws, &h),
52:             None => return Err("nd --init: ND_HOLDING is not set (CLIENT-13)".into()),
53:         };
54:         made.map_err(|e| e.to_string())?;
55:         return Ok(0);
56:     }
57:     if argv.len() == 1 && argv[0] == "--seal-observer" {
58:         Custody::seal_observer(&ws).map_err(|e| e.to_string())?;
59:         return Ok(0);
60:     }
61:     let custody = Custody::open(&ws, holding.clone()).map_err(|e| e.to_string())?;
62:     if let Some(done) = join::from_argv(&ws, holding.as_deref(), &custody, &argv) {
63:         return done;
64:     }
65:     if argv.len() == 1 && argv[0] == "--keys" {
66:         let hex = |b: &[u8]| b.iter().map(|x| format!("{x:02x}")).collect::<String>();
67:         let key = custody.public_key().map_err(|e| e.to_string())?;
68:         let next = custody.next_public_key().map_err(|e| e.to_string())?;
69:         println!("key {}\nnext {}", hex(&key), hex(&next));
70:         return Ok(0);


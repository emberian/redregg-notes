13: /// Why a frame could not be read or written (the pipe framing: `u32le len ‖ payload`,
14: /// `1 <= len <= FRAME_MAX`).
15: #[derive(Debug)]
16: pub enum FrameError {
17:     /// The stream ended at a frame boundary.
18:     End,
19:     /// The stream ended inside a frame.
20:     Torn,
21:     /// A frame of length 0.
22:     Empty,
23:     /// A frame longer than `FRAME_MAX`.
24:     TooLong {
25:         len: usize,
26:     },
27:     Io(std::io::Error),
28: }
29: 
30: /// Fill `buf` from `r`; the number of bytes read before the end of the stream.
31: fn read_full(r: &mut impl std::io::Read, buf: &mut [u8]) -> Result<usize, FrameError> {
32:     let mut n = 0;
33:     while n < buf.len() {
34:         match r.read(&mut buf[n..]) {
35:             Ok(0) => return Ok(n),
36:             Ok(k) => n += k,
37:             Err(e) if e.kind() == std::io::ErrorKind::Interrupted => {}
38:             Err(e) => return Err(FrameError::Io(e)),
39:         }
40:     }
41:     Ok(n)
42: }
43: 
44: /// Read one frame's payload.
45: pub fn read_frame(r: &mut impl std::io::Read) -> Result<Vec<u8>, FrameError> {
46:     let mut len = [0u8; 4];
47:     match read_full(r, &mut len)? {
48:         0 => return Err(FrameError::End),
49:         4 => {}
50:         _ => return Err(FrameError::Torn),
51:     }
52:     let len = u32::from_le_bytes(len) as usize;
53:     if len == 0 {
54:         return Err(FrameError::Empty);
55:     }
56:     if len > FRAME_MAX as usize {
57:         return Err(FrameError::TooLong { len });
58:     }
59:     let mut payload = vec![0u8; len];
60:     if read_full(r, &mut payload)? != len {
61:         return Err(FrameError::Torn);
62:     }
63:     Ok(payload)
64: }
65: 
66: /// Write one frame.
67: pub fn write_frame(w: &mut impl std::io::Write, payload: &[u8]) -> Result<(), FrameError> {
68:     if payload.is_empty() {
69:         return Err(FrameError::Empty);
70:     }


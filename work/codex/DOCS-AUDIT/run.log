49:             Some(a) if (a == "--group" && group.is_none()) || (a == "--peer" && peer.is_none()) => {
50:                 let n = argv.next().ok_or(USAGE)?;
51:                 let n: u32 = n.to_str().and_then(|n| n.parse().ok()).ok_or(USAGE)?;
52:                 *if a == "--group" {
53:                     &mut group
54:                 } else {
55:                     &mut peer
56:                 } = Some(n);
57:                 continue;
58:             }
59:             Some(a) => policy.list(&a).ok_or(USAGE)?,
60:             None => return Err(USAGE.into()),
61:         };
62:         list.push(PathBuf::from(argv.next().ok_or(USAGE)?));
63:     }
64:     if policy.hidden.is_empty() {
65:         return Err(
66:             "nd-supervise: refusing to start a child with nothing hidden (CLIENT-8)".into(),
67:         );
68:     }
69:     if peer.is_some() && group.is_none() {
70:         return Err("nd-supervise: --peer needs --group (the peer is (uid, gid))".into());


1: //! One frame: a `u32` little-endian body length, then the body, which is one operation byte
2: //! followed by the payload. The body length counts the operation byte, so it is at least 1.
3: //!
4: //! The bound is the codec table's `frameBytesMax`, passed in as [`Limits`]. A length past the
5: //! bound is refused before any allocation; a stream that ends inside a frame is `Truncated`,
6: //! never a short frame. Time is bounded per REPLY, not per syscall, by [`Deadline`].
7: //!
8: //! The layout is Lean's (CLIENT-40): a frame is `Protocol.socketFrame` (`Stream.bytesOf`), its
9: //! length prefix `FRAME_LEN_BYTES` wide, its body read by `Protocol.bodyParts?`; the child wire's
10: //! body is `Host.Wire.decodeBody`'s `u32le conn ‖ byte ‖ payload` ([`child_parts`]). Each refusal
11: //! renders as Lean's verdict on the same bytes (`client/tests/vectors.rs`, the codec vectors'
12: //! `wire/frame` and `wire/child` rows).
13: 
14: use std::io::{self, ErrorKind, Read, Write};
15: use std::os::fd::AsFd;
16: use std::time::{Duration, Instant};
17: 
18: use rustix::event::{PollFd, PollFlags, Timespec, poll};
19: 
20: use crate::generated as g;
21: 
22: /// Reads and writes on `s` that fail `TimedOut` once `until` has passed, however the bytes trickle
23: /// (CLIENT-39, A18: a bound per reply; a per-syscall timeout let a peer sending one byte per 119 s
24: /// hold a 262 144-byte frame open for a year). Each call first polls for at most what is left. A
25: /// write moves at most `PIPE_BUF` bytes, which a ready pipe or socket takes without blocking. One
26: /// mechanism for every peer of ours: a socket, a decider's pipe, an upstream TCP stream.
27: pub struct Deadline<'a, S: AsFd> {
28:     s: &'a S,
29:     until: Instant,
30: }
31: 
32: impl<'a, S: AsFd> Deadline<'a, S> {
33:     /// A deadline `within` from now.
34:     pub fn within(s: &'a S, within: Duration) -> Self {
35:         Self::until(s, Instant::now() + within)
36:     }
37:     /// A deadline at `until`.
38:     pub fn until(s: &'a S, until: Instant) -> Self {
39:         Self { s, until }
40:     }
41:     fn ready(&self, flags: PollFlags) -> io::Result<()> {
42:         let left = self.until.saturating_duration_since(Instant::now());
43:         let timeout =
44:             Timespec::try_from(left).map_err(|_| io::Error::from(ErrorKind::InvalidInput))?;
45:         if left.is_zero() {
46:             return Err(ErrorKind::TimedOut.into());
47:         }
48:         match poll(&mut [PollFd::new(self.s, flags)], Some(&timeout)) {
49:             Ok(0) => Err(ErrorKind::TimedOut.into()),
50:             Ok(_) => Ok(()),
51:             Err(e) => Err(e.into()),
52:         }
53:     }
54: }
55: 
56: impl<S: AsFd> Read for Deadline<'_, S> {
57:     fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
58:         self.ready(PollFlags::IN)?;
59:         Ok(rustix::io::read(self.s, buf)?)
60:     }
61: }
62: 
63: impl<S: AsFd> Write for Deadline<'_, S> {
64:     fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
65:         self.ready(PollFlags::OUT)?;
66:         let n = buf.len().min(rustix::pipe::PIPE_BUF);
67:         Ok(rustix::io::write(self.s, &buf[..n])?)
68:     }
69:     fn flush(&mut self) -> io::Result<()> {
70:         Ok(())

### client/src/fsx.rs
1: //! Durable files. Every workspace write goes through here, and a crash leaves each file either
2: //! absent or complete-and-durable: its bytes are written whole and synced in `.NAME.tmp` (mode 0600,
3: //! `O_EXCL`), and only then given its name, by a hard link for `create_once` (which, unlike a
4: //! rename, refuses an existing name) or a rename for `replace`; the directory is synced. A `.NAME.tmp`
5: //! is fsx's own residue of a crash, incomplete by construction: the next write of NAME removes it,
6: //! and a reader of the directory passes over it ([`is_residue`]). Custody files are read by
7: //! `nanodregg_sandbox::custody`, the one read every key holder shares.
8: 
9: use std::fs::{self, File, OpenOptions};
10: use std::io::{self, Write};
11: use std::os::unix::fs::OpenOptionsExt;
12: use std::path::Path;
13: 
14: pub(crate) use nanodregg_sandbox::custody::PRIVATE;
15: 
16: /// Create `dir/name` holding exactly `bytes`, or nothing: `AlreadyExists` if it is there, and a
17: /// crash at any instant leaves it absent or complete (CLIENT-39, A18: written in place, a crash right
18: /// after the create left an empty `rotation` that refused every later command).
19: pub(crate) fn create_once(dir: &Path, name: &str, bytes: &[u8]) -> io::Result<()> {
20:     let tmp = staged(dir, name, bytes)?;
21:     let linked = fs::hard_link(&tmp, dir.join(name));
22:     fs::remove_file(&tmp)?;
23:     linked?;
24:     sync_dir(dir)
25: }
26: 
27: /// Replace `dir/name` by a file holding exactly `bytes`, atomically: a reader (or a crash) sees
28: /// the old file or the new one, never a mix.
29: pub(crate) fn replace(dir: &Path, name: &str, bytes: &[u8]) -> io::Result<()> {
30:     let tmp = staged(dir, name, bytes)?;
31:     fs::rename(&tmp, dir.join(name))?;
32:     sync_dir(dir)
33: }
34: 
35: /// `dir/.name.tmp` holding exactly `bytes`, synced; a leftover from a crash is removed first.
36: fn staged(dir: &Path, name: &str, bytes: &[u8]) -> io::Result<std::path::PathBuf> {
37:     let tmp = dir.join(format!(".{name}.tmp"));
38:     match fs::remove_file(&tmp) {
39:         Err(e) if e.kind() != io::ErrorKind::NotFound => return Err(e),
40:         _ => {}
41:     }
42:     write_new(&tmp, bytes)?;
43:     Ok(tmp)
44: }
45: 
46: /// Whether a directory entry is fsx's crash residue (`.NAME.tmp`), never a file of any layout.
47: pub(crate) fn is_residue(name: &str) -> bool {
48:     name.starts_with('.') && name.ends_with(".tmp")
49: }
50: 
51: /// Rename `dir/from` over `dir/to`, durably.
52: pub(crate) fn rename(dir: &Path, from: &str, to: &str) -> io::Result<()> {
53:     fs::rename(dir.join(from), dir.join(to))?;
54:     sync_dir(dir)
55: }
56: 
57: /// Remove `dir/name`, durably; absent is fine.
58: pub(crate) fn remove(dir: &Path, name: &str) -> io::Result<()> {
59:     match fs::remove_file(dir.join(name)) {
60:         Err(e) if e.kind() != io::ErrorKind::NotFound => Err(e),
61:         _ => sync_dir(dir),
62:     }
63: }
64: 
65: fn write_new(path: &Path, bytes: &[u8]) -> io::Result<()> {
66:     let mut file = OpenOptions::new()
67:         .write(true)
68:         .create_new(true)
69:         .mode(PRIVATE)
70:         .open(path)?;


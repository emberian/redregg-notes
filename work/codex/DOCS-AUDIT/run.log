### client/src/attempt.rs
1: //! The life of one signed call, frozen on disk so a crash cannot change what was sent.
2: //!
3: //! An attempt is a directory. `call` holds the exact signed bytes and is written once, after
4: //! `argv` (the command it was signed for, as the generated `Command` encodes it) and `cont`
5: //! (follow's continuation at the submit step), so a directory with `call` is complete. Before
6: //! each send a marker `sent.<n>` is written. The settlement is one file, `settled`, holding the
7: //! three lines the member's OWN follow printed for `receipt CALL` (PROTOCOL-46): the receipt, the
8: //! head it was checked against, and the `settle` verdict. Never the Host's reply: the Host's status
9: //! byte only steers the loop (when to look up, when to resend the same bytes). The state is which
10: //! files exist; any other file refuses to load:
11: //!
12: //! | files (beside `argv`, `cont`) | state                 |
13: //! |-------------------------------|-----------------------|
14: //! | `call`                        | [`State::Signed`]     |
15: //! | `call`, `sent.*`              | [`State::Uncertain`]  |
16: //! | `call`, `sent.*`, `settled`   | [`State::Settled`]    |
17: //! | no `call` (a crashed freeze)  | none: never sent      |
18: //!
19: //! WHAT to do next is `Protocol.Attempt.next`, emitted as [`crate::generated::attempt::next`];
20: //! this module performs the action it names and keeps the files. A Host's claimed final (`ok`,
21: //! `refused`) is `confirm`ed, and a lookup's `absent` with no send left is `probe`d, both by the
22: //! member's follow; only its `committed` or `refused` writes `settled`. Every other end (declined,
23: //! open, contradicted, uncertain, badReply) leaves the attempt open on disk, and the next run of the
24: //! SAME argv continues it ([`Attempt::open_for`], CLIENT-37): it drives the frozen call from where
25: //! the disk says it stands and hands follow the attempt's own continuation, so the command's end is
26: //! that call's, and no second call is signed beside it. Which verdict a `settle` line names is the
27: //! generated `settle_seen`, not this crate.
28: 
29: use std::fs;
30: use std::io;
31: use std::path::{Path, PathBuf};
32: 
33: use crate::fsx;
34: use crate::generated::HINT_BYTES_MAX;
35: use crate::generated::attempt::{self as table, Action, Request, Seen};
36: 
37: const CALL: &str = "call";
38: const ARGV: &str = "argv";
39: const CONT: &str = "cont";
40: const SETTLED: &str = "settled";
41: const SENT_PREFIX: &str = "sent.";
42: 
43: /// Follow's answer to `receipt CALL`: exactly the three lines `receipt HEX`, `head STEPS HEIGHT
44: /// ROOTS`, `settle VERDICT`, the verdict named by the generated `settle_seen` (its first word).
45: #[derive(Clone, Debug, PartialEq, Eq)]
46: pub struct Receipt {
47:     /// `settle_seen` of the verdict.
48:     pub seen: Seen,
49:     /// The settle line after `settle ` (`committed H TD`, `refused CODE`, `expired`, `open`,
50:     /// `forgotten`): what follow is handed at the submit step, unread here.
51:     pub verdict: String,
52:     /// The three lines, verbatim: what `settled` holds.
53:     pub lines: Vec<u8>,
54: }
55: 
56: impl Receipt {
57:     /// Read follow's stdout; `None` unless it is exactly the three lines and the table names the
58:     /// verdict.
59:     pub fn read(stdout: &[u8]) -> Option<Self> {
60:         let text = std::str::from_utf8(stdout).ok()?;
61:         let lines: Vec<&str> = text.strip_suffix('\n')?.split('\n').collect();
62:         let [receipt, head, settle] = lines[..] else {
63:             return None;
64:         };
65:         fn word<'s>(line: &'s str, w: &str) -> Option<&'s str> {
66:             line.strip_prefix(w)?.strip_prefix(' ')
67:         }
68:         word(receipt, table::RECEIPT_WORD)?;
69:         word(head, table::HEAD_WORD)?;
70:         let verdict = word(settle, table::SETTLE_WORD)?;

### client/src/custody.rs
1: //! Custody of one member's keys (CLIENT-13, ruled by Ember 2026-10-16): the CURRENT key signs every
2: //! call; the precommitted NEXT key signs the `rotate` that makes it current (KERNEL-6) and, once that
3: //! rotate is signed and armed, read envelopes until the rotation settles (CLIENT-27). The
4: //! next key is fresh OS randomness born at precommit, never derivable from the current one, held
5: //! where a theft of the workspace does not reach it:
6: //! - [`Separate`] (a member): `ws/seed` (current secret), `ws/next.pub` (next PUBLIC key), and the
7: //!   next secret in `HOLDING/next` (`HOLDING/pending` mid-rotation), on removable media or under
8: //!   another account, needed only to rotate.
9: //! - [`SameRecord`] (a hosted resident, which has no offline): `ws/keys = current ‖ next
10: //!   [‖ pending]`, replaced atomically; a thief of it has both keys, so for it the `rotate` row
11: //!   holds only against a leak of the current key alone.
12: //!
13: //! Every custody file is read under the custody checks and written durably (`fsx`). Custody signs
14: //! the bytes it is handed (what is signed is follow's decision) and advances ONLY on its own
15: //! settlement of the rotate call (`settle`), never on a follow verb; each advance step is guarded by
16: //! the rotation's public keys, so a crash anywhere is finished by the next `settle`.
17: 

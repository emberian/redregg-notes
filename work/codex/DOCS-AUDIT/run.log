/-
# Lang.Journey.Claims — §LK: a claim's certifying shape, checked as install will check it (LANG-83, L1)

The checker `Term.guardedBy` run as a function on laws over `Owned`'s state `{owner, total}` with the
invariant `le100 = λ s. s.total ≤ 100`: L1 of DESIGN-PCC §8. L2 carries claims in the package and
refuses at install through the receivers.

* LK1 a hand-written law in certifying shape (every `ok` under `app le100 new`) checks, and so does
  `Std.keeps S le100`.
* LK2 a law whose `write` arm admits without the test does not check (an unguarded `ok`).
* LK3 a law that returns a verdict it read from its state is not in shape (nothing but a literal `inj`
  may be an `ok`).
* LK4 the journey's own `bounded` tests `new.total ≤ 100` INLINE, not as `app le100 new`: not in shape
  until the renaming lemma lands (DESIGN-PCC §3.4); it is the row that measures that gap.
-/
import Lang.Journey
import Lang.Claim

namespace Nanodregg.Lang.Journey

open Nanodregg.Kernel

/-- `total ≤ 100`, as a closed invariant of type `fn S bool`. -/
def le100 : Term := .lam S (.prim .le (.get (.var 0) "total") (.nat 100))

/-- `bounded` in certifying shape: refused unless `le100 new`. -/
def boundedKeeps : Term := law3 (.ite (.app le100 (.var 1)) ok (refused "over 100"))

/-- Under `case req.occasion`: var 3 = old, var 2 = new, var 1 = req, var 0 = the payload. The
`write` arm admits without the test. -/
def leaky : Term :=
  let test := Term.ite (.app le100 (.var 2)) ok (refused "over 100")
  .lam S (.lam S (.lam reqTy (.case (.get (.var 0) "occasion")
    [("adopt", test), ("birth", test), ("invoke", test), ("relaw", ok), ("write", ok)])))

/-- A law that returns whatever verdict its new state holds at `flag`. -/
def readsVerdict : Term := law3 (.get (.var 1) "flag")

def claimSession : Run :=
  let X := ctxWith langProgram
  let r : Run := { st := { rng := ⟨1⟩, host := World.genesis X.env 0 0, members := [] } }
  let chk (t : Term) : Bool := Term.guardedBy le100 1 0 (Std.lawBody t)
  let r := note r s!"LK1 a law in certifying shape checks: {chk boundedKeeps}; Std.keeps S le100 checks: {chk (Std.keeps S le100)}"
    (chk boundedKeeps && chk (Std.keeps S le100))
  let r := note r s!"LK2 a law whose write arm admits without the test does not check: {chk leaky}" (!chk leaky)
  let r := note r s!"LK3 a law that returns a verdict read from its state is not in shape: {chk readsVerdict}" (!chk readsVerdict)
  let r := note r s!"LK4 the journey's bounded (inline test) is not in shape yet (DESIGN-PCC §3.4): {chk bounded}" (!chk bounded)
  r

initialize register { name := "claims", run := pure claimSession }

end Nanodregg.Lang.Journey
/-
# Lang.Journey.OfferEscrow — §LE: `Std.offer` with a value leg through the real receivers (PROT-8)

`E := offerEscrowPackage ["price"] ["buyer", "seller"]`, installed by A. A's object X and B's
object Y, both of `E`. A issues denomination α and B issues β; each mints 20 to its own account. A
posts X's offer 0 (buyer, price [5,10], leg 5 α, payTo A) and B posts Y's offer 0 (seller, [8,12],
leg 7 β, payTo B) and offer 1 (seller, [11,12], leg 1 β); each post moves its leg from the poster's
account into the offering object's through the poster's grant of `transfer` to the object. B
invites X (`[invoke take]` on Y); A invokes `X.fuse`, which pays X's leg to B, retracts X's offer,
logs, and invokes `Y.take` on the judged deal (LANG-77), which pays Y's leg to A, retracts and logs.
Every row is a call through `Receive.submit` with `Lang.program`, read back from the World it
leaves: offer rows by `storyRow`, balances by the value cells. LE2–LE5 are judged on the World
before LE1.
-/
import Lang.Journey.Offer
import Lang.StdOfferEscrow

namespace Nanodregg.Lang.Journey

open Nanodregg.Kernel Nanodregg.Kernel.Receive

def lvBalance (w : World D) (id : D) : Option Int :=
  (w.live Sim.env id).bind fun c => (c.slots.get Value.balanceKey).bind Value.balanceOf

/-- `post {give {amount, asset}, grant, n, payTo, role, terms, want {amount, asset}}` with the one term
`price` in `[lo, hi]`: the offer gives `amount` of `asset` and asks at least `wamount` of `wasset`. -/
def lvPostArg (n : Nat) (role : Label) (lo hi amount : Nat) (asset grant payTo : D) (wamount : Nat) (wasset : D) :
    Option ByteArray :=
  Wire.encodeData (Std.escrowPostArg ["price"] ["buyer", "seller"])
    (.record [("give", .record [("amount", .nat amount), ("asset", .digest (Sim.dc.bytes asset))]),
      ("grant", .digest (Sim.dc.bytes grant)), ("n", .nat n), ("payTo", .digest (Sim.dc.bytes payTo)),
      ("role", .inj role (.record [])),
      ("terms", .record [("price", .record [("hi", .nat hi), ("lo", .nat lo)])]),
      ("want", .record [("amount", .nat wamount), ("asset", .digest (Sim.dc.bytes wasset))])])

def lvRows (r0 : Run) (a b : Sim.Member) : Run := Id.run do
  let prog := langProgram
  let X := ctxWith prog
  let mut r := r0
  let P ← match Std.offerEscrowPackage ["price"] ["buyer", "seller"] with
    | .ok p => pure p
    | .error e => return note r s!"LE0 offerEscrowPackage refused: {e.name}" false
  let some od := P.rels.lookup "offer" | return note r "LE0 E has no offer relation" false
  let some sd := P.rels.lookup "session" | return note r "LE0 E has no session relation" false
  let some pb := Wire.encodePackage P | return note r "LE0 E has no bytes" false
  let (r1, v1, t1) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id]) (.install pb))
  let some pkg := t1.bind fun t => (createdIds t).head? | return note r1 s!"LE0 install E: {v1}" false
  r := r1
  let signed (r : Run) (m : Sim.Member) (ids : List D) (body : Body D) : Call D :=
    Sim.signed r.st m m.key (Sim.S.pinsFor r.st.host (m.id :: ids)) body
  let mk (r : Run) (m : Sim.Member) (ids : List D) (body : Body D) : Run × String × Option D :=
    let (r', v, t) := go prog r (signed r m ids body)
    (r', v, t.bind fun t => (createdIds t).head?)
  let (rt1, vx, X?) := mk r a [pkg] (.create (some pkg) [] [])
  r := rt1
  let (rt3, vy, Y?) := mk r b [pkg] (.create (some pkg) [] [])
  r := rt3
  let (rt4, vα, α?) := mk r a [] (.issue 100)
  r := rt4
  let (rt5, vβ, β?) := mk r b [] (.issue 100)
/-
# Lang.Journey.Head — §HD/§RC: `Std.head` and the `(receipt)` column through the real receivers (E5)

Two Worlds of the Sim: A, whose founder commits one call, and B, whose founder installs
`Std.headPackage` and the deployed acceptor (`client/tests/fixtures/foreign/Accept.ob`, the one the
Rust rows X1–X5 run). Every row is a call through `Receive.submit` (`receive` then `World.admit`)
with `Lang.program` as the kernel's `Program`, instantiated with the deployed receipt check
(`Protocol.Foreign.check`) at the Sim's parameters, as `Host.Deployed.X` instantiates it at the
deployed ones. A row passes only when its verdict is the expected one.

* HD0 B installs `Std.head` (its id is `Protocol.Foreign.headPackageId`), creates a head object
  holding A's head at `{height 10, steps 20}`, and posts an honest advance `{height 11, steps 21}`
  (each with a chain, DESIGN-TRUST T2).
* HD1 `otherWorld`: `Std.head`'s methods never write `world`, so a change of it is reached through a
  DATA object judged by the head law (`create none [Std.head]`): a write of its `world` is refused
  by the law; HD1c the write of an honest advance to the same object is admitted.
* HD2 `staleHead` (a post below the held step count), HD3 `forkedHead` (a post at the held step
  count with other roots; HD3b with the held roots and another CHAIN), HD4 `badHead` (a higher step count at a lower height), HD5 `badFork` (a
  fork naming the held roots as the other's), each judged on the World after HD0; HD5c the honest
  fork is admitted and the head reads back forked; HD6 a post to the forked head is refused
  `forkedHead` (frozen).
* RC0 B trusts a head object holding A's real head; `accept` with A's receipt of its committed call
  is admitted, and the acceptance row is keyed by A's transaction id at the committed height.
* RC1 `headDead`: the trusted key names a RETIRED cell (B's revoked grant: no Body retires an object
  in nano, so a dead anchor is a retired cell of another kind), read through the caller's pins.
* RC2 `notCommitted`: the receipt of a call A never committed (it shows `absent`).
* RC3 `notCommitted`, the refused arm: the receipt of a call A's Host refused and RECORDED
  (`Receive.judge`; it shows `refused`, `Protocol.Foreign.refused_receipt_notCommitted`: the column
  refuses it, and it is A's recorded refusal).
* TL0–TL3 (DESIGN-OBS §2.3: an outside fact as a judged input; the fact is A's HEIGHT): B installs
  `client/tests/fixtures/foreign/Timelock.ob`, creates a lock with `deadline` = the height A committed
  its call at, trusts HA; `release` with A's receipt is admitted and `released` reads back true (TL0);
  a lock with `deadline` one past it refuses `early` on the same receipt (TL1); a second `release` of
  the released lock is `lawDenied` (`timelock: settled`, TL2); `distrust` then `release` is `untrusted`
  (TL3). The receipt proves ADMISSION at a height, never content; no wall time is claimed.
-/
import Lang.Journey
import Lang.StdHead
import Protocol.Foreign

namespace Nanodregg.Lang.Journey

open Nanodregg.Kernel Nanodregg.Kernel.Receive

/-- `Lang.program` with the deployed receipt check at the Sim's parameters. -/
def headProgram : Program D :=
  Lang.program Sim.dc.bytes Sim.digestOf (Protocol.Foreign.check Sim.env Sim.dc)

/-- The deployed acceptor's source, read by `lang-journey` from the repository root. -/
def acceptSourcePath : System.FilePath := "client" / "tests" / "fixtures" / "foreign" / "Accept.ob"

/-- The timelock's source (TL0–TL3), read by `lang-journey` from the repository root. -/
def timelockSourcePath : System.FilePath := "client" / "tests" / "fixtures" / "foreign" / "Timelock.ob"

/-- The timelock's state type (`Timelock.ob`: `(state (rec (deadline nat) (released bool)))`). -/
def timelockStateTy : Ty := .record [("deadline", .nat), ("released", .bool)]

/-- The lock's `released` slot, read back from its cell (state slot 1). -/
def releasedOf (w : World D) (obj : D) : Option Bool :=
  match (w.live Sim.env obj).bind (fun c => c.slots.get (stateBase + 1)) with
  | some b => match Wire.decodeData .bool b with
    | .ok (.bool v) => some v
    | _ => none
  | none => none



31: /// The one way nd starts `host`: the member follower's policy in the flag words its unit renders
32: /// (`--write STORE --exec HOST --hide …`), read by the `Policy::list` nd-supervise reads them with,
33: /// launched by `nanodregg_sandbox::command`. `host join` and init's one-shot follower share it.
34: pub fn confined(host: &Path, store: &Path, hide: &[&Path], args: &[&OsStr]) -> io::Result<Command> {
35:     let mut p = Policy::default();
36:     let words = [("--write", store), ("--exec", host)];
37:     for (flag, path) in words.into_iter().chain(hide.iter().map(|h| ("--hide", *h))) {
38:         if let Some(list) = p.list(OsStr::new(flag)) {
39:             list.push(path.to_path_buf());
40:         }
41:     }
42:     nanodregg_sandbox::command(&p, host.as_os_str(), args).map_err(io::Error::other)
43: }

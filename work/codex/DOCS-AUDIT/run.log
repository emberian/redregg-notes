28: /// One request and its reply within ONE `reply` (`replyMsMax`) from the first byte sent to the last
29: /// byte read, however the peer trickles (CLIENT-39); past it the error is `timeout` by name (the
30: /// step loop then treats a frozen call as lost: uncertain, settled by lookup).
31: fn exchange(s: &UnixStream, reply: Duration, op: u8, payload: &[u8]) -> io::Result<(u8, Vec<u8>)> {
32:     let timeout = |e: io::Error| match e.kind() {
33:         io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut => {
34:             io::Error::new(io::ErrorKind::TimedOut, "timeout (replyMsMax)")
35:         }
36:         _ => e,
37:     };
38:     let mut d = Deadline::within(s, reply);
39:     frame::write(&mut d, LIMITS, op, payload)
40:         .map_err(io_err)
41:         .map_err(timeout)?;
42:     let f = frame::read(&mut d, LIMITS)
43:         .map_err(io_err)
44:         .map_err(timeout)?;
45:     Ok((f.op, f.payload))
46: }

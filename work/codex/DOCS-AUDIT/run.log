45: /// A kept file, read back under the chain rule (0600, owner, every parent trusted).
46: fn kept_file(ws: &Path, name: &str) -> Result<OsString, String> {
47:     let b = read_private(&ws.join(name), 1..=ARGV_BYTES_MAX as usize);
48:     Ok(OsString::from_vec(
49:         b.map_err(|r| format!("{name}: {r:?}"))?.to_vec(),
50:     ))
51: }
52: 
53: /// The sponsor's key file: hex, one optional newline, under the chain rule.
54: fn key_file(path: &OsStr) -> Result<OsString, String> {
55:     let mut b = read_public(Path::new(path), 64..=65).map_err(|r| format!("key file: {r:?}"))?;
56:     if b.last() == Some(&b'\n') {
57:         b.pop();
58:     }
59:     Ok(OsString::from_vec(b))
60: }
61: 
62: /// Bare `nd invite` and `nd adopt KEY_FILE` from the kept files; any other argv unchanged.
63: pub fn kept(ws: &Path, argv: Vec<OsString>) -> Result<Vec<OsString>, String> {
64:     Ok(match argv.as_slice() {
65:         [v] if v == "invite" => vec![v.clone(), kept_file(ws, INPUT)?],
66:         [v, key] if v == "adopt" => vec![v.clone(), kept_file(ws, INVITATION)?, key_file(key)?],
67:         _ => argv,
68:     })
69: }

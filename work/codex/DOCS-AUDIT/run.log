/// One frozen call.
#[derive(Debug)]
pub struct Attempt {
    dir: PathBuf,
    call: Vec<u8>,
    cont: Vec<u8>,
}

impl Attempt {
    /// Freeze `call` into the new directory `dir` (its parent must exist; `dir` must not), with
    /// the command it was signed for (`argv`, the generated `Command` encoding) and follow's
    /// continuation at the submit step (`cont`). `call` is written last: a crash before it leaves
    /// a directory [`Attempt::open_for`] passes over, since nothing of it was ever sent.
    pub fn freeze(dir: &Path, call: &[u8], argv: &[u8], cont: &[u8]) -> Result<Self, AttemptError> {
        fs::create_dir(dir).map_err(|e| match e.kind() {
            io::ErrorKind::AlreadyExists => AttemptError::AlreadyFrozen,
            _ => AttemptError::Io(e),
        })?;
        if let Some(parent) = dir.parent() {
            fsx::sync_dir(parent)?;
        }
        fsx::create_once(dir, ARGV, argv)?;
        fsx::create_once(dir, CONT, cont)?;
        fsx::create_once(dir, CALL, call)?;
        Ok(Self {
            dir: dir.to_path_buf(),
            call: call.to_vec(),
            cont: cont.to_vec(),
        })
    }

    /// The newest attempt under `attempts` frozen for `argv` (the generated `Command` encoding)
    /// that is not settled: what the next run of the same command continues (CLIENT-37). A
    /// directory without `call` is a crashed freeze, never sent, and is passed over; one with
    /// `call` but no `argv` (an older layout) refuses to load.
    pub fn open_for(
        attempts: &Path,
        argv: &[u8],
    ) -> Result<Option<(u64, Self, State)>, AttemptError> {
        let mut ns = Vec::new();
        for entry in fs::read_dir(attempts)? {
            if let Some(n) = entry?
                .file_name()
                .to_str()
                .and_then(|s| s.parse::<u64>().ok())
            {
                ns.push(n);
            }
        }
        ns.sort_unstable_by(|a, b| b.cmp(a));
        for n in ns {
            let dir = attempts.join(n.to_string());
            if !dir.join(CALL).exists() || dir.join(SETTLED).exists() {
                continue;
            }
            let frozen_for = fs::read(dir.join(ARGV)).map_err(|e| match e.kind() {
                io::ErrorKind::NotFound => AttemptError::Inconsistent,
                _ => AttemptError::Io(e),
            })?;
            if frozen_for != argv {
                continue;
            }
            let (attempt, state) = Self::load(&dir)?;
            return Ok(Some((n, attempt, state)));
        }
        Ok(None)
    }

    /// Reopen the attempt in `dir` and read its state from the files present; a settlement is
    /// re-read through [`Receipt::read`] and must be a final verdict.
    pub fn load(dir: &Path) -> Result<(Self, State), AttemptError> {
        let call = fs::read(dir.join(CALL)).map_err(|e| match e.kind() {
            io::ErrorKind::NotFound => AttemptError::NotAnAttempt,
            _ => AttemptError::Io(e),
        })?;
        let cont = fs::read(dir.join(CONT)).map_err(|e| match e.kind() {
            io::ErrorKind::NotFound => AttemptError::Inconsistent,
            _ => AttemptError::Io(e),
        })?;
        let (sends, settled) = scan(dir)?;
        let state = match (sends, settled) {
            (0, true) => return Err(AttemptError::Inconsistent),
            (0, false) => State::Signed,
            (sends, false) => State::Uncertain { sends },
            (_, true) => {
                let receipt = Receipt::read(&fs::read(dir.join(SETTLED))?)
                    .ok_or(AttemptError::Inconsistent)?;
                let committed = final_of(&receipt).ok_or(AttemptError::Inconsistent)?;
                State::Settled { committed, receipt }
            }
        };
        Ok((
            Self {
                dir: dir.to_path_buf(),
                call,
                cont,
            },
            state,
        ))
    }

    /// The frozen signed bytes.
    pub fn call(&self) -> &[u8] {
        &self.call
    }

    /// Follow's continuation at the submit step: what follow is resumed with, with this attempt's
    /// end, by whichever run ends it.
    pub fn cont(&self) -> &[u8] {
        &self.cont
    }

    /// Advance from `state`, performing what `Attempt.next` names, until it names an end. Each
    /// request goes through `exchange`: `submit` / `lookup` to the Host, `confirm` / `probe` as
    /// follow's `receipt CALL`. A run makes at most `2 · sends_max` Host and `sends_max + 1` follow
    /// requests (KERNEL-54: an absent lookup is probed before a resend); the loop takes one more.
    pub fn drive<E: From<AttemptError>>(
        &self,
        state: State,
        sends_max: u32,
        mut exchange: impl FnMut(Request, &[u8]) -> Result<Reply, E>,
    ) -> Result<State, E> {
        let (mut sends, mut last) = match state {
            State::Settled { .. } => return Ok(state),
            State::Signed => (0, None),
            // Reloaded after a send: its reply is lost to this run.
            State::Uncertain { sends } | State::Open { sends, .. } => {
                (sends, Some((Request::Submit, Seen::Lost)))
            }
        };
        // The Host's last payload (a declined refusal's name), follow's last unsettled words, the
        // Host's last claim, follow's last receipt.
        let (mut hinted, mut why, mut claimed) = (Vec::new(), Vec::new(), None);
        let mut receipt = None::<Receipt>;
        for _ in 0..=3 * u64::from(sends_max) + 1 {
            let request = match table::next(sends < sends_max, last) {
                end @ (Action::Committed | Action::Refused) => {
                    let r = receipt.take().ok_or(AttemptError::Inconsistent)?;
                    return Ok(self.settle(end == Action::Committed, r)?);
                }
                Action::Submit => {
                    // The marker is durable before a byte leaves: a crash from here on loads as
                    // uncertain.
                    fsx::create_once(&self.dir, &format!("{SENT_PREFIX}{sends}"), &[])
                        .map_err(AttemptError::Io)?;
                    sends += 1;
                    Request::Submit
                }
                Action::Lookup => Request::Lookup,
                Action::Confirm => Request::Confirm,
                Action::Probe => Request::Probe,
                end => {
                    let payload = match (end, &receipt) {
                        (Action::Declined, _) => hinted,
                        (Action::Contradicted, Some(r)) => {
                            let host = claimed.map_or("", Seen::name);
                            format!("{host} {}", r.seen.name()).into_bytes()
                        }
                        (Action::Uncertain, _) => why,
                        _ => Vec::new(),
                    };
                    return Ok(State::Open {
                        sends,
                        end,
                        payload,
                    });
                }
            };
            let reply = exchange(request, &self.call)?;
            last = Some((request, reply.seen()));
            match reply {
                Reply::Host(seen, payload) => {
                    if matches!(seen, Seen::Committed | Seen::Refused) {
                        claimed = Some(seen);
                    }
                    hinted = payload;
                }
                Reply::Follow(r) => receipt = Some(r),
                // the last within HINT_BYTES_MAX: a longer one is no hint, never a cut one
                Reply::Lost(w) if !w.is_empty() && w.len() <= HINT_BYTES_MAX as usize => why = w,
                Reply::Lost(_) => {}
            }
        }
        Ok(State::Open {
            sends,
            end: Action::Uncertain,
            payload: why,
        })
    }

    /// Write `settled` from follow's receipt (the table names committed or refused only after a
    /// `confirm` / `probe` whose verdict was that).
    fn settle(&self, committed: bool, receipt: Receipt) -> Result<State, AttemptError> {
        fsx::create_once(&self.dir, SETTLED, &receipt.lines)?;
        Ok(State::Settled { committed, receipt })
    }
}

/// `(sends, settled)`: the markers must be exactly `sent.0 .. sent.(n-1)`, and no file but
/// `call`, `argv`, `cont`, the markers and `settled` may be present (an older layout refuses to
/// load).
fn scan(dir: &Path) -> Result<(u32, bool), AttemptError> {
    let (mut seen, mut settled) = (Vec::new(), false);
    for entry in fs::read_dir(dir)? {
        let name = entry?.file_name();
        let name = name.to_str().ok_or(AttemptError::Inconsistent)?;
        if fsx::is_residue(name) {
            continue;
        }
        if let Some(n) = name.strip_prefix(SENT_PREFIX) {
            seen.push(n.parse::<u32>().map_err(|_| AttemptError::Inconsistent)?);
        } else if name == SETTLED {
            settled = true;
        } else if name != CALL && name != ARGV && name != CONT {
            return Err(AttemptError::Inconsistent);
        }
    }
    seen.sort_unstable();
    let count = u32::try_from(seen.len()).map_err(|_| AttemptError::Inconsistent)?;
    if seen.iter().zip(0u32..).any(|(&n, i)| n != i) {
        return Err(AttemptError::Inconsistent);
    }
    Ok((count, settled))
}
pub fn read_body(r: &mut impl Read, max: u32) -> Result<Vec<u8>, FrameError> {
    let mut header = [0u8; HEADER];
    match fill(r, &mut header)? {
        0 => return Err(FrameError::Closed),
        HEADER => {}
        got => {
            return Err(FrameError::Truncated {
                offset: 0,
                wanted: HEADER,
                got,
            });
        }
    }
    let len = u32::from_le_bytes(header);
    let past = FrameError::PastBound {
        len: u64::from(len),
        max,
    };
    if len == 0 {
        return Err(FrameError::Empty);
    }
    if len > max {
        return Err(past);
    }
    let len = usize::try_from(len).map_err(|_| past)?;
    let mut body = vec![0u8; len];
    let got = fill(r, &mut body)?;
    if got != len {
        return Err(FrameError::Truncated {
            offset: HEADER,
            wanted: len,
            got,
        });
    }
    Ok(body)
}

/// The frame of one body made of `parts`, refusing a body past `max` (or empty): the one place a
/// length prefix is written.
pub fn custody(ws: &Path) -> Result<Custody, crate::custody::CustodyError> {
    Ok(Custody::open(ws, None)?.refusing_rotation())
}

/// One request's reply, against `surface` (`STDIO_VERBS` when served; a plant widens it to show the
/// custody fence holds behind it).
pub fn answer(
    op: u8,
    payload: &[u8],
    at: &Place,
    custody: &Custody,
    surface: &[&str],
) -> CommandReply {
    let argv = match (op, Command::decode(payload)) {
        (follow_op::COMMAND, Ok(c)) => c.argv,
        _ => return refused(StdioRefusal::Undecodable, ""),
    };
    let verb = argv
        .first()
        .map(|v| String::from_utf8_lossy(v).into_owned());
    match verb {
        Some(v) if surface.contains(&v.as_str()) => {}
        v => return refused(StdioRefusal::NotOnSurface, &v.unwrap_or_default()),
    }
    let ran = FollowSocket::connect(at.follow, table::REPLY)
        .map_err(|e| format!("follow.sock: {e}"))
        .and_then(|mut f| {
            let mut h = HostSocket::connect(at.host, table::REPLY)
                .map_err(|e| format!("host.sock: {e}"))?;
            run::run(&argv, &mut f, &mut h, custody, at.attempts, table::RUN)
                .map_err(|e| e.to_string())
        });
    match ran {
        Ok((exit, stdout, stderr)) => CommandReply {
            exit,
            stdout,
            stderr,
        },
        Err(e) => CommandReply {
            exit: command_exit::CLIENT,
            stdout: Vec::new(),
            stderr: format!("nd: {e}\n").into_bytes(),
        },
    }
}

/// Serve the mux's child wire until stdin closes: `u32le conn ‖ op ‖ payload` in, `u32le conn ‖
/// status ‖ payload` out; a hang-up frame is skipped. Requests are answered in order.
pub fn run(
    argv: &[Vec<u8>],
    follow: &mut impl Follow,
    host: &mut impl Host,
    custody: &Custody,
    attempts: &Path,
    t: Table,
) -> Result<Done, RunError> {
    let key = argv_key(argv)?;
    let open = Attempt::open_for(attempts, &key)?;
    if let Some(ended) = reconcile(
        custody,
        attempts,
        open.as_ref().map(|o| o.0),
        follow,
        host,
        &t,
    )? {
        return Ok(ended);
    }
    let fresh = Some(Fresh {
        attempts,
        argv: &key,
    });
    let first = match open {
        Some((n, attempt, state)) => {
            let armed = custody.armed().map_err(RunError::Custody)?.map(|(a, _)| a) == Some(n);
            let outcome = finish(&attempt, state, armed, follow, host, custody, &t)?;
            let dead = outcome.status == Action::Refused.code();
            match follow
                .resume(attempt.cont(), &outcome)
                .map_err(RunError::Follow)?
            {
                // follow's own World holds the frozen call refused or expired (step 4 checked the
                // claim, `ownSettle`): nothing of it can land, so the command is planned afresh
                // (CLIENT-37 amended: a `declined stale` re-run after a sync plans anew)
                Step::Done { exit, .. } if dead && exit == t.exit_refused => {
                    follow.command(argv).map_err(RunError::Follow)?
                }
                step => step,
            }
        }
        None => follow.command(argv).map_err(RunError::Follow)?,
    };
    steps(first, follow, host, custody, fresh, &t)
}
fn ask_once(sh: &Shared, resident: &[u8], ask: &[u8]) -> Option<Answer> {
    let req = Request::Decide {
        resident: resident.to_vec(),
        at_ms: now_ms(),
    }
    .encode()
    .ok()?;
    let verdict = sh.decider.lock().ok()?.exchange(&[&req, ask])?;
    Some(match verdict {
        Verdict::Refuse { broker_refusal } => refused(broker_refusal),
        // a residents answer to a decide is the decider out of turn: the connection closes
        Verdict::Residents { .. } => return None,
        Verdict::Grant {
            key_slot,
            host,
            target,
            headers,
            key_header,
            body,
            ..
        } => {
            let Some(key) = sh.keys.get(&key_slot) else {
                return Some(refused(BrokerRefusal::KeyMissing));
            };
            let req = Call {
                host: &host,
                target: &target,
                headers: &headers,
                key_header: &key_header,
                body: &body,
            };
            match call(sh, &req, key) {
                Err(why) => refused(why),
                Ok(resp) if contains(&resp, key) => refused(BrokerRefusal::KeyEchoed),
                Ok(resp) => match split_response(&resp) {
                    Some((status, body)) => return reply(sh, status, body, key),
                    None => refused(BrokerRefusal::UpstreamFailed),
                },
            }
        }
        // a reply or status verdict to a decide is the decider out of turn: the connection closes
        Verdict::Reply { .. } | Verdict::Status { .. } => return None,
    })
}

/// The upstream's answer, read by the decider (`reply`): the reply text Lean read from a 200 body,
/// the status of any other, or a refusal. A text holding the key is withheld (`keyEchoed`). `None`
/// when the decider cannot be reached or answers out of turn.
fn reply(sh: &Shared, status: u32, body: &[u8], key: &[u8]) -> Option<Answer> {
    let req = Request::Reply {
        status,
        body: body.to_vec(),
    }
    .encode()
    .ok()?;
    let verdict = sh.decider.lock().ok()?.exchange(&[&req])?;
    Some(match verdict {
        Verdict::Reply { text } if contains(&text, key) => refused(BrokerRefusal::KeyEchoed),
        Verdict::Reply { text } => Answer::Reply { text },
        Verdict::Status { status } => Answer::Status { status },
        Verdict::Refuse { broker_refusal } => refused(broker_refusal),
        Verdict::Grant { .. } | Verdict::Residents { .. } => return None,
    })
}

fn call(sh: &Shared, r: &Call<'_>, key: &[u8]) -> Result<Vec<u8>, BrokerRefusal> {
    let name = std::str::from_utf8(r.host)
        .ok()
        .and_then(|h| ServerName::try_from(h.to_owned()).ok())
        .ok_or(BrokerRefusal::TlsHostname)?;
    let failed = |_: std::io::Error| BrokerRefusal::UpstreamFailed;
    let addr = sh
        .upstream
        .to_socket_addrs()
        .map_err(failed)?
        .next()
        .ok_or(BrokerRefusal::UpstreamFailed)?;
    let until = Instant::now() + UPSTREAM_TIMEOUT;
    let t = TcpStream::connect_timeout(&addr, UPSTREAM_TIMEOUT).map_err(failed)?;
    let mut io = nanodregg_client::frame::Deadline::until(&t, until);
    let mut conn = ClientConnection::new(Arc::clone(&sh.tls), name).map_err(|e| tls_refusal(&e))?;
    while conn.is_handshaking() {
        conn.complete_io(&mut io).map_err(|e| io_refusal(&e))?;
    }
    // the verified leaf's key must be one the operator pinned for Lean's host (HOSTING-28)
    let pinned = sh.pins.get(r.host).map(Vec::as_slice).unwrap_or(&[]);
    match leaf_pin(&conn) {
        Some(p) if pinned.contains(&p) => {}
        _ => return Err(BrokerRefusal::PinMismatch),
    }
    let mut s = StreamOwned::new(conn, io);
    let mut req = Zeroizing::new(Vec::with_capacity(r.body.len() + 512));
    req.extend_from_slice(b"POST ");
    req.extend_from_slice(r.target);
    req.extend_from_slice(b" HTTP/1.0\r\nHost: ");
    req.extend_from_slice(r.host);
    req.extend_from_slice(b"\r\n");
    req.extend_from_slice(r.headers);
    req.extend_from_slice(r.key_header);
    req.extend_from_slice(b": ");
    req.extend_from_slice(key);
    req.extend_from_slice(format!("\r\nContent-Length: {}\r\n\r\n", r.body.len()).as_bytes());
    req.extend_from_slice(r.body);
    s.write_all(&req).map_err(|e| io_refusal(&e))?;
    s.flush().map_err(|e| io_refusal(&e))?;
    let mut resp = Vec::new();
    let n = (&mut s)
        .take(RESPONSE_MAX as u64 + 1)
        .read_to_end(&mut resp)
        .map_err(|e| match e.kind() {
            ErrorKind::UnexpectedEof => BrokerRefusal::TlsProtocol,
            _ => io_refusal(&e),
        })?;
    if n > RESPONSE_MAX {
        return Err(BrokerRefusal::UpstreamFailed);
    }
    Ok(resp)
}


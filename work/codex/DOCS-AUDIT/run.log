40: const WAIT: Duration = Duration::from_secs(120);
41: /// The longest an `ask` waits for its answer.
42: const ASK: Duration = Duration::from_secs(60);
43: 
44: fn errno(e: &std::io::Error) -> String {
45:     let name = match e.kind() {
46:         ErrorKind::PermissionDenied => "EACCES/EPERM".to_string(),
47:         ErrorKind::NotFound => "ENOENT".to_string(),
48:         ErrorKind::ReadOnlyFilesystem => "EROFS".to_string(),
49:         ErrorKind::ConnectionRefused => "ECONNREFUSED".to_string(),
50:         k => format!("{k:?}"),
51:     };
52:     format!("denied {name}")
53: }
54: 
55: fn ask(path: &str, recv: &Path) -> String {
56:     let s = UnixStream::connect(path).and_then(|s| {
57:         s.set_read_timeout(Some(ASK))?;
58:         Ok(s)
59:     });
60:     let mut s = match s {
61:         Ok(s) => s,
62:         Err(e) => return errno(&e),
63:     };
64:     let Ok(a) = (Ask::Ask {
65:         model: b"claude-m".to_vec(),
66:         max_tokens: 10,
67:         system: vec![],
68:         roles: vec![0],
69:         texts: vec![b"hello".to_vec()],
70:     })


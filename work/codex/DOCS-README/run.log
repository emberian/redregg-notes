/-
# Lang.Package — a package: a checked core term with its interface, state type, methods and laws

A package is what `install` puts in a ROM cell (DECISIONS LANG-5, LANG-9): its imports (the ids of
installed packages; `ref i` in the body is the `i`-th), its object STATE type, its INTERFACE type
(the type of `body`), and which interface fields are METHODS (`State → Args → Req → State`) and
which are LAWS (`State → State → Req → Verdict`). `checkWith ifaces p` is the whole install check,
given the imports' interfaces; the package's id is KERNEL's `romIdOf` of its cell, so it commits to
the import ids and through them to the whole closure.
-/
import Lang.Wire
import Lang.Check
import Lang.HoleWire

namespace Nanodregg.Lang

/-- A relation an object of the package holds (LANG-49, LANG-44 as ruled): keyed, bounded rows
under the object, in the World's rows trie. A relation is a PLACE, never a value: no term has a
relation type, so no method holds a whole relation (law 5). Its key is fixed-width data, its
fields in DECLARED order (the key's bytes are the fields' data encodings in that order, so a
range's prefix is the first fields; the method sees the key as a record, labels ascending). -/
structure RelDecl where
  key : List (Label × Ty)
  val : Ty
  /-- at most this many rows (`relationFull`, kernel-checked on the current head) -/
  limit : Nat
  /-- the nat field of `val` the head sums (`relationCapped` past `cap`); none: no sum column -/
  sum : Option Label
  cap : Nat
  /-- rows may be retracted; `false`: insert-only by declaration (`retractForbidden`) -/
  retract : Bool
  /-- an interface field judging each edit, `fn S (fn reqTy (fn editTy verdictTy))` -/
  guard : Option Label
  deriving Inhabited, DecidableEq

structure Package where
  /-- ids of installed packages, as the digest bytes the kernel uses -/
  imports : List ByteArray
  state : Ty
  iface : Ty
  body : Term
  methods : List Label
  laws : List Label
  /-- its relations, labels ascending; relation `i` is the `i`-th (LANG-49) -/
  rels : List (Label × RelDecl) := []
  /-- what the package says of itself, one line (LANG-60): `Bounds.docOk` bytes, printed as `(doc "…")`
  and on `read OBJ ?`'s `doc` line; never run, never judged -/
  doc : ByteArray := .empty
  /-- Live contextual declarations and candidate syntax committed by the ROM id. -/
  holes : List HoleROM := []
  deriving Inhabited, DecidableEq

/-- Which act is judged (KERNEL's `Occasion`): a birth (the seed is `old = new`), a write, a law
replacement by the listed law ids (their digest bytes concatenated in order; the state is unchanged),
or an invoke of method `i`. A law cases on it; the checker requires one arm per label, so a law
written with `case` has no default arm. -/
def occasionTy : Ty :=
  .sum [("adopt", .bytes), ("birth", .record []), ("invoke", .nat), ("relaw", .bytes), ("write", .record [])]

/-- What a law and a method see of the call: the signing member, whose authority it uses, the
object judged or run on (`self`: a method names its own accounts by it, LANG-25), the call's
signed window (the Turn lands at a height in `[notBefore, validUntil]`, KERNEL-10), and the act
being judged. -/
def reqTy : Ty :=
  .record [("agent", .digest), ("notBefore", .nat), ("occasion", occasionTy), ("principal", .digest),
    ("self", .digest), ("validUntil", .nat)]

/-- A law's verdict: `ok`, or `refused` with the author's reason. -/
def verdictTy : Ty := .sum [("ok", .record []), ("refused", .bytes)]

def lawTy (S : Ty) : Ty := .fn S (.fn S (.fn reqTy verdictTy))

/-! ## Calls: what a method asks the kernel to do as the object (LANG-23, LANG-33)

The core has no lists, so a method returns its calls in a row of option SLOTS `c0 … c(k-1)`,
`k ≤ Kernel.Bounds.callsMax`. Each slot's type names the kinds of call it may carry: options over
a sub-sum of `callTy`, every arm at exactly its `callTy` type. `callTy` has one arm per kind an
object may exercise (KERNEL's `Body.callable`: account, credit, grant, install, invoke, transfer), its fields
the `Body` constructor's: a digest is `digest`, an `Option` is `optTy`, an `AcctRef` is
`acctRefTy`, a grant's rights the fixed-arity `rightsTy`. So a method's type says how many calls
it may make and of which kinds, and costs bytes only for those: a method that makes none has
`calls : rec {}`. `Lang.Call` reads the kernel's `Body` back out of such data. -/

/-- An optional `T`. -/
def optTy (T : Ty) : Ty := .sum [("none", .record []), ("some", T)]

/-- How a call names a value account (KERNEL's `AcctRef`): a well by its denomination, any other
account by its owner and denomination. -/
def acctRefTy : Ty := .sum [("of", .record [("asset", .digest), ("owner", .digest)]), ("well", .digest)]

/-- A right a granted call carries (KERNEL's `Right`). -/
def rightTy : Ty := .sum [("credit", .nat), ("enroll", .nat), ("invoke", .nat), ("mutate", .record []),
  ("observe", .record []), ("transfer", .nat)]

/-- The rights one granted call may carry. KERNEL's `Right` has six constructors, but a grant carries
/- Live contextual preparation: ROM code, authenticated rows, one evaluator. -/
import Lang.Package
import Lang.HoleBudget
import Lang.Eval
import Lang.Wire.Data
import Kernel.Receive.Call
import Lang.Rel

namespace Nanodregg.Lang
open Nanodregg.Kernel Nanodregg.Kernel.Receive

/-- Why live contextual preparation refuses: one constructor per refusal (law 7). `wire` is the one printer;
its text is what the kernel's `Refusal.program` and a blocked hole's `.refuse` carry.

A refusal about a justification NAMES THE JUSTIFICATION (DESIGN-CTX §2.3, the why-not half of CONTEXTUAL
INTEGRITY): the row the caller did not pin (`unpinnedRow`: its relation and key), every cell support the caller
did not pin (`unpinned`), every support whose row moved or whose cell is not live (`derivationMoved`,
`supportDead`), the hypothesis position AND its pin (`supportMoved`). The lists are never empty when thrown
(each is the filter of a failed `all`); a client re-plans from them without guessing. -/
inductive HoleRefusal where
  | type (hole : Nat)
  | context (hole : Nat)
  | candidates (hole : Nat)
  | guardType (hole : Nat)
  | candidateType (hole code : Nat)
  | package (e : CheckError)
  | signatureBound
  | duplicate
  | bodyType (e : TypeErr)
  /-- a row of the hole object the caller did not pin: the selection row, a row support of a hypothesis, the
  guard pin's row (absent and unpinned differ: `holeRow`) -/
  | unpinnedRow (rel : Nat) (key : ByteArray)
  /-- the cell supports of the selected candidate (or the one cell pin of a hypothesis or the guard) the caller
  did not pin -/
  | unpinned (pins : List SupportPin)
  /-- a hypothesis the selected code USES whose pin does not hold: the position and the pin -/
  | supportMoved (hole position : Nat) (pin : SupportPin)
  | guardBlocked (hole : Nat)
  | guardFault (hole : Nat)
  | selectionAbsent (hole : Nat)
  | selectionType (hole : Nat)
  | selectionIndex (hole : Nat)
  /-- the selected candidate's row supports that are not at their ROM version -/
  | derivationMoved (hole : Nat) (pins : List SupportPin)
  /-- the selected candidate's cell supports that are not live in the caller's pinned view (E1) -/
  | supportDead (hole : Nat) (pins : List SupportPin)
  | expansion (b : ExpansionBound)
  | provenance
  | instanceRecheck
  | instanceType (e : TypeErr)
  deriving DecidableEq

/-- Signature validation checks every candidate at exactly its declared context,
including candidates not currently selected. A candidate cannot introduce another hole. -/
def HoleROM.check (Δ : List Ty) (h : HoleROM) : Except HoleRefusal Unit := do
  unless h.ctx.all Ty.wf && h.ty.wf do throw (.type h.name)
  unless h.hypotheses.length = h.ctx.length do throw (.context h.name)
  unless h.code.length ≤ Bounds.holeCandidatesMax do throw (.candidates h.name)
  match inferE [] [.bool] h.guard (Ω := []) with
  | .ok .bool => pure ()
  | _ => throw (.guardType h.name)
  for (c, i) in h.code.zipIdx do
    match inferE Δ h.ctx c.body (Ω := []) with
    | .ok T => unless T = h.ty do throw (.candidateType h.name i)
    | .error _ => throw (.candidateType h.name i)

def Package.checkContextual (Δ : List Ty) (p : Package) : Except HoleRefusal Unit := do
  match p.checkShape with | .error e => throw (.package e) | .ok () => pure ()
  match p.checkFields with | .error e => throw (.package e) | .ok () => pure ()
  unless p.holes.length ≤ Bounds.holeSignatureMax do throw .signatureBound
  unless (p.holes.map (·.name)).eraseDups.length = p.holes.length do throw .duplicate
  for h in p.holes do h.check Δ
  match checkE Δ p.body p.iface (Ω := holeSignature p.holes) with
  | .error e => throw (.bodyType e)
  | .ok () => pure ()

/-- The row must occur in the authenticated point view; absent and unpinned differ.
No ambient store is read by this module. -/
def holeRow {D : Type} (rv : RowView D) (self : D) (rel : Nat) (key : ByteArray) :
    Except HoleRefusal (Option RowLeaf) :=
  match (rv.points self rel).find? (fun p => decide (p.1 = key)) with
  | none => .error (.unpinnedRow rel key)
  | some (_, leaf) => .ok leaf

/-- The cell `g` is live in the caller's pinned view AND `law` is among its laws in force: the law
slots an object cell holds at `lawBase ≤ k < stateBase` (`Kernel.Receive.lawSlotsOf`'s range), each
the digest bytes of a law package (DESIGN-CTX §2.5a). A tombstone, an absence and an unpinned cell
are `false`, as `cellLive`. -/
def cellGoverned {D : Type} (look : Pinned D) (g : D) (law : ByteArray) : Bool :=
  match look g with
  | .ok (some c) => c.slots.any fun p => decide (lawBase ≤ p.1 ∧ p.1 < stateBase) && p.2 == law
  | _ => false

/-- The cell `g` is live AND runs package `pkg`: its `slotPackage` holds `pkg`'s digest bytes. -/
def cellRuns {D : Type} (look : Pinned D) (g : D) (pkg : ByteArray) : Bool :=
  match look g with
  | .ok (some c) => c.slots.get slotPackage == some pkg
  | _ => false

/-- Whether a ROM pin holds: a row support at exactly its version; a cell support live; a contract
support live and governed by its law / running its package. -/
def supportLive {D : Type} (digestOf : ByteArray → Option D) (look : Pinned D) (rv : RowView D)
    (self : D) : SupportPin → Bool
  | .row rel key ver =>
    match holeRow rv self rel key with
    | .ok (some (.row _ _ v)) => v == ver
    | _ => false
  | .cell id => (digestOf id).any (cellLive look)
  | .cellLaw id law => (digestOf id).any fun g => cellGoverned look g law
  | .cellPackage id pkg => (digestOf id).any fun g => cellRuns look g pkg
/-
# Lang.Claim — a claim a package makes of itself, and the checker of its certifying shape (LANG-83)

A claim is a sentence in a small fixed language that a package carries in its identity and the
kernel refuses to install unless the package's own term bears it: proof-carrying code (Necula 1997)
in the one form nano's install check already has. The type check is such a checker (the claim is
the interface type, the proof is the term, `checkE` decides it in one pass, `Lang.Proofs.Check` is
its soundness); a claim extends the sentences that check the same way. The proof is the term's
SHAPE, the checker is a one-pass function beside `checkE` (unmetered, O(|term|), bounded by the
wire), and its soundness is one Lean theorem, `Lang.Proofs.Claim.guardedBy_sound`. No nano term
ever checks a proof; the kernel does, once, at install, as it types the term.

`keeps inv law`: every state an object of the package holds satisfies the interface field
`inv : fn S bool`, because the law `law` refuses every birth, adoption, write and invoke whose new
state fails it. Its proof is the law's control structure: every `ok` leaf of the law's body is
dominated by the true branch of `ite (app inv new) _ _` (`Term.guardedBy`), the `relaw` arm of a
`case` on `req.occasion` excepted, because the kernel judges a law change over the unchanged state
(`Kernel.Receive.law`; `Lang.Proofs.Chain.LawKeeps`). The `adopt` arm is NOT excepted: an adoption
is a base case like a birth (the incoming law judges the state it is adopted over, KERNEL-27), so a
law in shape refuses to be adopted over a state that fails its invariant.

The checker is sound by construction and incomplete by design: the only former it lets MEAN
`inj "ok" _` is a literal `inj` leaf, so a law that returns a verdict it read from its state, or
through a helper lambda, is not in certifying shape, and its claim is refused by name; the author
writes the law in shape (`Std.keeps` emits one), as a certifying compiler emits checkable code. The
compared `inv` is the closed literal term of the interface field, so no index shifting is needed:
`app inv (var k)` is syntactic equality with `k` the index of `new` at that depth.
Design: `redregg/work/promo/DESIGN-PCC.md`.
-/
import Lang.Subst

namespace Nanodregg.Lang

/-- A claim a package makes of itself, checked at install (LANG-83). -/
inductive Claim
  /-- every state an object of the package holds satisfies the interface field `inv : fn S bool`:
  the law `law` refuses every birth, adoption, write and invoke whose new state fails it -/
  | keeps (inv law : Label)
  deriving DecidableEq, Repr, Inhabited

mutual
/-- Every `ok` leaf of `t` is dominated by the true branch of `ite (app I (var k)) _ _`, or sits in
the `relaw` arm of a `case` on `get (var r) "occasion"`; `k` is the index of `new` and `r` of `req`
at the current depth (`1` and `0` under a law's three binders). Only a literal `inj` leaf may be an
`ok`; every other former is refused, so the walk is sound by construction. -/
def Term.guardedBy (I : Term) : (k r : Nat) → Term → Bool
  | k, r, .ite c a b => (c == .app I (.var k) || Term.guardedBy I k r a) && Term.guardedBy I k r b
  | k, r, .case s arms => Term.guardedArms I (k + 1) (r + 1) (s == .get (.var r) "occasion") arms
  | _, _, .inj _ ℓ _ => ℓ != "ok"
  | _, _, .refuse _ _ => true
  | _, _, _ => false

/-- Each arm's body is guarded, or (`occ`: the case is on the occasion) the arm is `relaw`. -/
def Term.guardedArms (I : Term) (k r : Nat) (occ : Bool) : List (Label × Term) → Bool
  | [] => true
  | (ℓ, body) :: arms =>
      ((occ && ℓ == "relaw") || Term.guardedBy I k r body) && Term.guardedArms I k r occ arms
end

end Nanodregg.Lang
/-
# Kernel.Receive.Authority — whose authority a call exercises on a cell

Ownership (the cell's owner slot) or a grant chain that reaches the owner: the one rule every
receiver that changes a cell it does not bear uses (`Derive`'s writes, `Ledger`'s transfers).
-/
import Kernel.Receive.Call

namespace Nanodregg.Kernel.Receive

open Nanodregg.Kernel

variable {D : Type} [Ord D] [DecidableEq D]

/-- Build slots in canonical order whatever order the pairs come in. -/
def slotsOf (ps : List (Nat × ByteArray)) : Slots := ps.foldl (fun s p => s.set p.1 p.2) []

/-- Whether the link `g` (its cell `cell`) is held by `agent`: its grantee is `agent`, or — when
`pub`, i.e. for the FIRST link only, held by the signer — its grantee is the World and `agent` is
an enrolled member, its member cell pinned and live (KERNEL-26: a public grant). Anything else is
`noGrant g`. A public grant is USED by any member, never re-delegated: a parent link is held by
its child's issuer exactly, the same rule `checkParent` applies when the child is made. -/
def granteeHolds (X : Ctx D) (look : Pinned D) (g : D) (cell : Cell) (agent : D) (pub : Bool) :
    Except (Refusal D) Unit := do
  let grantee ← slotDigest X g cell grantGrantee
  if grantee = agent then pure ()
  else if pub ∧ grantee = worldId X then (readKind look agent kindMember).map fun _ => ()
  else .error (.noGrant g)

/-- The principal a grant chain exercises for `agent`, walking at most `fuel` links: each link
pinned, live, aimed at `obj`, held by the next agent (`pub`: the first link may be a public
grant), carrying `right`. -/
def walk (X : Ctx D) (look : Pinned D) (obj : D) (right : Right) :
    Bool → Nat → D → D → Except (Refusal D) D
  | _, 0, _, _ => .error .grantTooDeep
  | pub, fuel + 1, g, agent => do
      let cell ← readKind look g kindGrant
      let target ← slotDigest X g cell grantTarget
      req (target = obj) (.grantTarget g)
      granteeHolds X look g cell agent pub
      req (cell.slots.get (rightKey right)).isSome (.grantRight g)
      let issuer ← slotDigest X g cell grantIssuer
      match cell.slots.get grantParent with
      | none => .ok issuer
      | some pb => match X.digestOf pb with
        | none => .error (.malformedCell g grantParent)
        | some parent => walk X look obj right false fuel parent issuer

/-- Whose authority an actor exercises on `obj`: its own, or the root issuer of its grant. -/
def principalOf (X : Ctx D) (look : Pinned D) (actor : D) (obj : D) (right : Right) :
    Option D → Except (Refusal D) D
  | none => .ok actor
  | some g => walk X look obj right true grantDepthMax g actor

/-- Ownership authority (observe, mutate): the principal must be the object's owner. -/
def ownerAuthority (X : Ctx D) (look : Pinned D) (actor : D) (obj : D) (cell : Cell)
    (right : Right) (via : Option D) : Except (Refusal D) D := do
  let owner ← slotDigest X obj cell slotOwner
  let principal ← principalOf X look actor obj right via
  req (principal = owner) (.noGrant obj)
  pure principal

/-! ## Counted rights: one ledger mechanism (KERNEL-16's enrolment, KERNEL-60's transfer and credit) -/

/-- The ledger of a grant's counted right whose first slot is `base`: its next index and what is
left (its last entry). `grantRight` when the grant carries no such right. -/
def ledgerLeft (base : Nat) (g : D) (cell : Cell) : Except (Refusal D) (Nat × Nat) :=
  let led := cell.slots.filter fun p => base ≤ p.1 && p.1 ≤ base + ledgerSpendsMax
  match led.getLast? with
  | none => .error (.grantRight g)
  | some (k, v) => match countOf v with
    | some n => .ok (led.length, n)
    | none => .error (.malformedCell g k)

/-- Spend `units` of grant `g`'s counted right at `base` (refused `short` past what is left, and
past the ledger's last slot: a spend is never written where `ledgerLeft` does not read): the write
appending what is left to its ledger, or no effect for nothing. -/
def spendAt (base : Nat) (g : D) (cell : Cell) (units : Nat) (short : Refusal D) :
    Except (Refusal D) (Option (D × Act)) := do
  let (i, left) ← ledgerLeft base g cell
  req (units ≤ left) short
  if units = 0 then pure none else do
    req (decide (i ≤ ledgerSpendsMax)) short
    pure (some (g, .write [.set (base + i) (countBytes (left - units))]))

/-
# Protocol.Foreign — a receipt from another World, checked against a head this World holds (E5)

`check E dc` is the deployed `Lang.ReceiptCheck` (`Host.Deployed.X` passes it to `Lang.program`): the
point's cell must be an object of `Std.headPackage` (`Lang.headView`, else `notHead`) holding an
`at` head (a `forked` one checks nothing: `forkedHead`; the head's chain is for comparing folds,
PROTOCOL-75, and the check ignores it); the receipt's bytes must decode
(`badReceipt`); `Receipt.check` against the head's height and roots must answer `committed`
(`headMismatch` / `pathMismatch` / `forgotten` by the check's own names; `refused` and `absent`
are `notCommitted`: acting on them needs the call's window, which the receipt does not carry).
The column then shows the committed height, turn digest and transaction id.

What it means is `Proofs.Foreign.foreign_receipt_sound`: under the named premise that the held head
is the head of a fold of A from A's genesis (head freshness: B holds A head, not THE head), the
transaction was admitted in that fold at that height, or the hash collides among a listed set.
-/
import Protocol.Receipt
import Lang.StdHead

namespace Nanodregg.Protocol.Foreign

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-- `Std.headPackage`'s canonical bytes (empty if it had none, which `headPackage_encodes` refutes). -/
def headPackageBytes : ByteArray := (Lang.Wire.encodePackage Lang.Std.headPackage).getD .empty

/-- The deployed id of `Std.headPackage`: its package cell's content digest (`install`, KERNEL-3). -/
def headPackageId (E : Env D) : D :=
  romIdOf E { kind := kindPackage, discipline := .rom, slots := [(0, headPackageBytes)] }

/-- THE deployed receipt check. -/
def check (E : Env D) (dc : Stream D) : Lang.ReceiptCheck := fun cell rb =>
  let digestOf (b : ByteArray) : Option D := (dc.decode b).toOption
  match Lang.headView digestOf (E.bytes (headPackageId E)) cell with
  | none => .error "notHead"
  | some (.forked _) => .error "forkedHead"
  | some (.at _ _ height rootsB _) =>
    match digestOf rootsB, Receipt.ofBytes E dc rb with
    | none, _ => .error "notHead"
    | _, none => .error "badReceipt"
    | some roots, some r =>
      match Receipt.check E height roots r.txId 0 r with
      | .ok (.committed h td) => .ok ⟨h, E.bytes td, E.bytes r.txId⟩
      | .ok _ => .error "notCommitted"
      | .error e => .error e.name

end Nanodregg.Protocol.Foreign
/-
# Ledger.Escrow — the escrow package, generated in Lean (decisions/ledger.md LEDGER-6, LEDGER-10)

A depositor's `amount` of `asset` held by an escrow OBJECT `e` until the arbiter or a party
settles it: paid to the beneficiary (`release`) or back to the depositor (`refund`), once.

State `{amount : nat, arbiter, asset, beneficiary, depositor : digest, nonce : bytes, phase}`;
`phase` is a sum of empty records over `held | open | refunded | released`. `nonce` is the deposit's
once key (LEDGER-11: a digest has no bytes in the core, so `self` can no longer be the key). The terms are fixed at birth by the
creator (the object's owner, KERNEL's slot 1, who grants the parties `invoke`, KERNEL-25) and
carried unchanged by every method.

The funds sit in `accountId e asset` (LEDGER-6 (a)), named by reference: `of {owner = req.self,
asset}` (LEDGER-7, LANG-25). Anyone opens it, before the deposit, with a top-level
`account asset e`. Methods, in `pkgOf`'s sorted order (the `n` of `invoke` and `Right.invoke n`):

* 0 `deposit {grant}`: `open → held`, and ONE call: `transfer (of depositor asset) (of self
  asset) amount (via := some grant) (once := some nonce)`. `grant` is the depositor's grant to `e`
  of `transfer amount` on its own account (KERNEL-60, LEDGER-16): the kernel spends the transfer from
  the grant's cap, so what the deposit moves is bounded by the grant, not by this text; the transfer is in the same
  tree as the phase change, so `held` is reached exactly when the funds moved.
* 1 `refund {}`: `held → refunded`, `transfer (of self asset) (of depositor asset) amount none
  (once := some "payout")`.
* 2 `release {}`: `held → released`, `transfer (of self asset) (of beneficiary asset) amount none
  (once := some "payout")`.

Both payouts spend ONE nullifier, `onceNullifier (accountId e asset) "payout"`, so the kernel pays
at most once in the escrow's life whichever way (`Kernel.Proofs.Ledger.transfer_once`); the law
`escrow` refuses by NAME before that (`Ledger.Proofs.Escrow`):

* birth and adoption: the phase is `open`, else `notOpen`;
* a write or a law change: `frozen` (KERNEL refuses both for a programmed object first);
* an invoke: from `released`/`refunded` `settled`; method 0 needs `open` (`notOpen`) and the
  depositor signing (`notParty`); 1 needs `held` (`notHeld`) and the beneficiary or the arbiter;
  2 needs `held` and the depositor or the arbiter; the new phase must be the method's target
  (`badPhase`); any other index `noMethod`.

The law sees `agent`, the signing member (`Req.agent`), so a party acting through the owner's grant
is checked by its own key: the law narrows KERNEL's authority, it does not replace it.
-/
import Lang.Std
import Lang.Wire.Data
import Kernel.Receive.Call

namespace Nanodregg.Ledger.Escrow

open Nanodregg.Lang
open Nanodregg.Lang.Std (At guard allOf anyOf notT refusedT okT natT)

/-! ## Types -/

/-- The phases, in canonical (label) order. -/
def phaseLabels : List Label := ["held", "open", "refunded", "released"]

def phaseTy : Ty := Std.stateTy phaseLabels

def stateTy : Ty :=
  .record [("amount", .nat), ("arbiter", .digest), ("asset", .digest), ("beneficiary", .digest),
    ("depositor", .digest), ("nonce", .bytes), ("phase", phaseTy)]

def unit : Ty := .record []

/-- `deposit`'s argument: the depositor's grant to the escrow object. -/
def depositArg : Ty := .record [("grant", .digest)]

/-- Every method's one call slot: a transfer, nothing else. -/
def T : Ty := callOf ["transfer"]

/-- The once key both payouts spend. -/
def payoutKey : ByteArray := "payout".toUTF8

/-! ## Method terms (under a method's binders: state `var 2`, argument `var 1`, request `var 0`) -/

def st (f : Label) : Term := .get (.var 2) f
def rq (f : Label) : Term := .get (.var 0) f

def someB (t : Term) : Term := .inj (optTy .bytes) "some" t

/-- An optional digest (a call's `via`). -/
def someD (t : Term) : Term := .inj (optTy .digest) "some" t
def noneD : Term := .inj (optTy .digest) "none" (.record [])

/-- The account of `owner` in the escrow's denomination. -/
def ofT (owner : Term) : Term := .inj acctRefTy "of" (.record [("asset", st "asset"), ("owner", owner)])



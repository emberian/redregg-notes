/-
# Host.Deployed — the one deployed instance of the Host's parameters

The kernel, the loop, the Store and the page builder are generic. This module fixes them for
`host`: CODEC's deployed `Ctx` (`Codec.Digest`, cSHAKE256, the kernel codecs, Ed25519) with LANG's
`Program`, CODEC's batch record over the 32-byte digest, the deployed `Cadence`, and the KMAC
sealers under the Store key. Writer and follower both reopen their own records with `World.fold`
(`foldStep`, HOST-22): a follower audits at follow time (`Protocol.Command.step`), never at reopen.
-/
import Host.Store
import Host.Keys
import Host.Page
import Host.Serve
import Codec.Deployed
import Lang.Program
import Protocol.Foreign

namespace Nanodregg.Host.Deployed

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Codec

abbrev D := Digest

/-- The deployed program: LANG over the deployed codec, its receipt reads checked by PROTOCOL's
`Foreign.check` (E5) against the head objects they name. -/
def X : Ctx D := Codec.Deployed.ctx
  (Lang.program Digest.bytes Digest.ofBytes? (Protocol.Foreign.check Codec.Deployed.env Codec.Deployed.digestCodec))

def c : Cadence := Cadence.deployed

def world : Stream (World D) := Codec.Deployed.world

/-- The deployed shape stamp (D2): the tags of the deployed base and batch record codecs. -/
def shapes : Digest := Base.shapeStamp world (Record.codec Codec.Deployed.digestCodec)

def recorder : Recorder (World D) (Step D × D) where
  encode _ staged := Record.encode Codec.Deployed.digestCodec staged
  mark := Record.mark X.env

/-- The genesis chain of a World's origin (KERNEL's `World.genesisChain`), as `mark` writes a
chain: what the origin frame of its Store holds, checked at every open (HOST-25). -/
def originChain (w : World D) : ByteArray := (World.genesisChain X.env w.origin).bytes

/-- The writer's reopen: its own records, each step taken (`World.step`: a Turn admitted, a refusal
recorded) and its stated roots digest checked (`Record.runRooted`, HOST-29). -/
def foldStep : World D → ByteArray → Except (Record.Fault (Reject D)) (World D) :=
  Record.step Codec.Deployed.digestCodec (World.step X.env) (World.roots X.env)

/-- A tail's step (`Host.Tail`, HOSTING-7): the writer's reopen step, with each record's
(step, roots) pairs. -/
def tailStep : World D → ByteArray → Except (Record.Fault (Reject D)) (World D × List (Step D × D)) :=
  Record.stepTurns Codec.Deployed.digestCodec (World.step X.env) (World.roots X.env)


/-- The loop's batch bounds: a record's Turns, and a megabyte of request payload. -/
def limits : Limits := ⟨recordTurnsMax, 1 <<< 20⟩

/-- A `log` page from `start` over the files a base keeps (HOST-64): `Page.kept` at the deployed
instance, the index read through `Page.entryAt` (the base's entries on disk, the loop's since). -/
def keptWith {m : Type → Type} [Monad m] (budget : Nat) (keys : Keys) (k0 : Nat)
    (read readIndex : Nat → Nat → m ByteArray) (r : Resident (World D)) (start : Nat) : m (Except Page.Fault Page.Acc) :=
  Page.kept X.env Codec.Deployed.digestCodec X.digestOf keys.segment c.recordBytesMax budget k0 read
    (Page.entryAt (keys.forStore (originChain r.world)) readIndex r.sealed.index.count r.index)
    (r.sealed.index.count + r.index.size) r.pos.offset (recorder.mark r.world) start

def pageKept {m : Type → Type} [Monad m] (keys : Keys) (k0 : Nat) (read readIndex : Nat → Nat → m ByteArray)
    (r : Resident (World D)) (start : Nat) : m (Except Page.Fault Page.Acc) :=
  keptWith Page.budget keys k0 read readIndex r start

/-- The chain after step `h ≤ r.world.steps`, from the files a base keeps: the same walk with no
room for events (budget 0), so the page holds no event and its chain is the chain AT step `h`
(`checkpointed` below the kept files). `host check --anchor` and follow's behind posts (T2b') read it. -/
def chainKept {m : Type → Type} [Monad m] (keys : Keys) (k0 : Nat) (read readIndex : Nat → Nat → m ByteArray)
    (r : Resident (World D)) (h : Nat) : m (Except Page.Fault ByteArray) := do
  return (← keptWith 0 keys k0 read readIndex r h).map (·.chain)
import Codec.Kernel
import Codec.World
import Codec.Hash
import Codec.Ed25519

/-!
# Codec.Deployed — the one deployed `Env` and `Ctx`

The kernel is generic in its digest and hash. This module fixes them for deployment: digests are
`Codec.Digest` (32 bytes), the hash is cSHAKE256 with the domain as customization (`Hash.digest`),
turns, cells and calls are encoded by `Codec.Kernel`, and signatures are checked by RFC 8032
Ed25519 (`Ed25519.verify`). LANG supplies the `Program`. The facts the kernel's theorems take as
premises are proved for this instance in `Codec.Proofs.Deployed`.
-/

namespace Nanodregg.Codec.Deployed

open Nanodregg.Kernel Nanodregg.Kernel.Receive

/-- The deployed digest's codec: its 32 bytes. -/
abbrev digestCodec : Stream Digest := Stream.digest

def env : Env Digest where
  hash := Hash.digest
  bytes := Digest.bytes
  turnBytes := Nanodregg.Codec.Kernel.turnBytes digestCodec
  cellBytes := Nanodregg.Codec.Kernel.cellBytes

def ctx (program : Program Digest) : Ctx Digest where
  env := env
  unsignedBytes := Nanodregg.Codec.Kernel.unsignedBytes digestCodec
  callBytes := Nanodregg.Codec.Kernel.callBytes digestCodec
  decodeCall := Nanodregg.Codec.Kernel.decodeCall digestCodec
  digestOf := Digest.ofBytes?
  verify := Ed25519.verify
  program := program

/-- The checkpoint's codec. -/
def world : Stream (World Digest) := Nanodregg.Codec.Kernel.world env digestCodec

end Nanodregg.Codec.Deployed
/-
# Lang.StdGen — a generator: a package whose method installs a package (DESIGN-META, LANG-86)

A GENERATOR is an ordinary package with a method whose calls row holds one `install` slot
(`installSlot`, the `install` arm of `callTy`, KERNEL-75): the method computes package bytes and
returns `install b`; the kernel's tree derives that call as the object, runs `checkInstall` on `b`
exactly as it does for a member's `install`, and bears the ROM cell `romIdOf b`. "Install a generated
package" is then a nested call of a Turn, re-derived by every follower, and the Turn is the receipt
of the generation: its journal row names the generator object and the argument, and the package
cell's id is the content digest of what the method returned.

This module holds rung 0 of the design (DESIGN-META §1.3): the CONSTANT generator `generatorOf b`,
whose `generate` returns `install b` for a fixed `b`. `headGenerator` is `Std.headPackage` as an
installed object: its one method installs exactly `headPackageBytes`, so the cell a generation bears
is `Protocol.Foreign.headPackageId` (`Lang.Journey.Gen` GN1 checks the two ids equal). What the
generator's run returns is `generate_run_sound` (`Lang.Proofs.StdGen`).

Rung 1 (LANG-87): the TEMPLATE generator. `boundedGenerator r f` takes `generate {max : nat}` and
installs `boundedPackage r f max` — a record state `r` under the law `bounded` (`f ≤ max`) with a
`set` method — for the `max` of its argument: its method is `Lang.Quote.quotePackage` over the
template `boundedPackageWith r f (var 4)`, whose one free variable is the bound at the law
clause's depth, written at run time by the `u64be` payload writer from `get arg "max"`.
`generate_bounded_sound` (`Lang.Proofs.StdGen`): the run returns `install` of exactly
`encodePackage (boundedPackage r f max)` — the nano generator IS the Lean generator at the
receipt's argument, byte for byte, so the law's theorem `bounded_spec` is about what the kernel
checked and installed.
-/
import Lang.StdHead
import Lang.Quote

namespace Nanodregg.Lang.Std

/-- The one call slot of a generator: `install`. -/
def installSlot : Ty := callOf ["install"]

/-- A generator keeps nothing. -/
def genStateTy : Ty := .record []

/-- `some (install b)` in the generator's slot. -/
def installT (b : ByteArray) : Term :=
  someCallT installSlot (.inj installSlot "install" (.record [("pkg", .bytes b)]))

/-- `generate`: `λ rows state arg req. {calls = {c0 = some (install b)}, edits = {}, state = state}`
(the state at `var 2`, as `methodOf` binds it); its type is `methodTy genStateTy (rec {}) [installSlot]`. -/
def generateMethod (b : ByteArray) : Term :=
  .lam (.record []) (.lam genStateTy (.lam (.record []) (.lam reqTy
    (resultT (callsT [installT b]) (.var 2)))))

/-- The constant generator of the package bytes `b`: one method, `generate` (index 0), no laws. -/
def generatorOf (b : ByteArray) (doc : String) : Package :=
  { pkgOf genStateTy [] [("generate", .record [], [installSlot], generateMethod b)] with doc := doc.toUTF8 }

/-- The bytes `Std.headPackage` installs as (`Protocol.Foreign.headPackageBytes` is this value, and
`headPackageId` its cell's id). -/
def headPackageBytes : ByteArray := (Wire.encodePackage headPackage).getD .empty

/-- `Std.head` as an installed object: the generator whose one method installs `headPackage`. -/
def headGenerator : Package :=
  generatorOf headPackageBytes
    "installs Std.head (a foreign World's head, keyed by steps, E5): the cell it bears is headPackageId"

/-! ## Rung 1: a template generator (LANG-87) -/

/-- `some (install {pkg = t})` in the generator's slot, the package bytes a term. -/
def installOf (t : Term) : Term :=
  someCallT installSlot (.inj installSlot "install" (.record [("pkg", t)]))

/-- `set`: `λ rows state arg req. {calls = {}, edits = {}, state = arg}`, the state record `r`'s
fields copied from the argument (`r` in canonical order, as a record type is). -/
def setMethod (r : List (Label × Ty)) : Term :=
  .lam (.record []) (.lam (.record r) (.lam (.record r) (.lam reqTy
    (resultT (callsT []) (.record (r.map fun (ℓ, _) => (ℓ, .get (.var 1) ℓ)))))))

/-- The template of `boundedPackage`: state `rec r`, the law `bounded` (field `f` at most `maxT`,
a term at the law clause's depth), the method `set`; rows in canonical order (`bounded` < `set`). -/
/-
# Hosting.Resident.Bell — what the resident decides, as pure functions (HOSTING-27, HOSTING-31)

The resident serves ONE bell (`world/resident/Bell.ob`, LANG-58: a queue of rings) through its
member socket:
- It reads the bell's description once (`read OBJ ?`, PROTOCOL-44). Its `core` line, the package
  cell's bytes, must decode to the Bell (`bellCore`: `Lang.Bell.shapeOk`, HOSTING-45), or the
  resident ends `bellShape notBell` before any read or ask: the object the config names is the
  program the theorems speak of. From it come the index of the
  method labelled `answer`, whose argument must be `answerArgTy`, and the relation `pending`, whose
  key must be `(notBefore nat) (agent digest)` and whose value holds the captured `ask` plan. No index,
  bound or relation layout is written into the program; the read's K is `pending`'s declared limit.
- Each tick it makes ONE read, `read OBJ pending K` (PROTOCOL-51's range read): every unanswered
  ring, one `Lang.Print.data` line per row, read with `Lang.Read.readData` at the relation's row
  type (`Lang.rowTy`). The range read refuses past K and never truncates, so with K the declared
  limit the lines are ALL the pending rings (`Protocol.Proofs.Command.rangeLines_reads`), in
  ascending key order, which is ring order (`Lang.Proofs.KeyOrder.range_keys_ascend_read`).
- It answers the lowest pending ring: `invoke OBJ <answer> ARG`, ARG `Lang.Print.data` of
  `(record (notBefore N) (ringText X) (ringer #H) (text T) (to A))`, X the ring's text and A its
  optional AIM (HOSTING-53: `(none)`, or `(some (record (cand #C) (method M) (target #O) (via #G)))`) as
  the pending row holds them. The bell (LANG-59) upserts `rings[k]` to an `answered (some (ask T))`
  with immutable `captured (ask (record (text X) (to A)))` and retracts `pending[k]`; its `rings`
  guard refuses the upsert unless the ring is unanswered and the capture echoed is the ring's own
  (`rung: answered`, `rung: text`), so exactly-once is a check on the row as it is, and an aim cannot
  be dropped or altered by the resident. For an aimed ring the bell's `answer` also makes ONE nested
  call, the forward of T to the aim's target (`Lang.Proofs.Bell.answer_run`): answered is delivered,
  in the same Turn. The resident neither reads nor pins the target: the aim it echoes is judged by
  the guard, the forward by the kernel's authority on the Bell object's grant (`via`).

Everything it reads and writes is Lang's one reader and one printer. It holds no copy of either.

**Exactly one ask per ring** (each ask costs the meter). A ring is its key `(notBefore, ringer)`
and its text. An ask is SPENT once its frame has been sent in full. From then on the ring's answer
text is decided, whatever comes back: the reply's text, or a short text naming what came instead.
That text is kept in the resident's volume, with the ring, until the ring leaves `pending`, so
neither a failed invoke nor a restart asks again. A ring that arrives BELOW the kept one (a ringer
may backdate its notBefore by up to the kernel's window) waits until the kept ring is delivered: the
kept ring is answered first wherever it stands, and only then is the lowest asked about
(`Proofs.Resident.decide_*`, over `decideTick`).
-/
import Lang.Read
import Lang.Print
import Lang.Bell
import Protocol.Command.Text
import Hosting.BrokerWire

namespace Nanodregg.Hosting.Resident

open Nanodregg.Lang

/-! ## The config: `pkg/resident.conf`, one Lang data value -/

/-- The config's type. The operator writes one value of it beside the program:
`(record (bell #HEX) (grant #HEX) (maxTokens N) (model "NAME") (system "TEXT"))`, where `grant` is
the operator's grant to the resident's member that `invoke` names (`--via`). -/
def confTy : Ty :=
  .record [("bell", .digest), ("grant", .digest), ("maxTokens", .nat), ("model", .bytes), ("system", .bytes)]

/-- The largest config file read. -/
def confBytesMax : Nat := 65536

structure Conf where
  /-- the bell object's id (32 bytes) -/
  bell : ByteArray
  /-- the grant the answer is invoked through (32 bytes) -/
  grant : ByteArray
  maxTokens : Nat
  model : ByteArray
  system : ByteArray

/-- The config from its text; `none` names `confMalformed`. -/
def Conf.read (text : String) : Option Conf :=
  match Read.readData confTy text with
  | .ok (.record [("bell", .digest b), ("grant", .digest g), ("maxTokens", .nat n), ("model", .bytes m),
      ("system", .bytes s)]) =>
    if b.size = 32 ∧ g.size = 32 then some ⟨b, g, n, m, s⟩ else none
  | _ => none

/-! ## The description -/

/-
# Spec.Proofs.Claims — what nanodregg is FOR, as predicates on a `System`

The top-level statements (redregg/work/promo/TOPLEVEL-SPEC.md §2–§8), each a `Prop` over the
record of deployed entry points (`Spec.System`). `Spec.Proofs.Floor` refutes each one on a trivial
system and inhabits it with a deployed run; that is the tree's whole vacuity obligation: a lemma
under a top theorem carries meaning only through the claim it proves, whatever its own shape.
`Spec.Proofs.Deployed` proves `Claim (deployed d)` where the composition exists.

Premises that are true of the deployed system only under an assumption the system does not yet
discharge are PARAMETERS of the claim, named (a relay, a restriction to `NoRef` laws), never hidden
in a definition. Removing one is a strengthening the checker sees.

This module lives under `Proofs` because a claim is a statement (closure C3); it defines no
function.
-/
import Spec.System
import Kernel.Proofs.Rederive
import Kernel.Proofs.Fold
import Kernel.Proofs.Cells
import Kernel.Proofs.Logic.History
import Kernel.Proofs.WriteNext
import Lang.Proofs.Chain
import Lang.Proofs.Receiver
import Protocol.Proofs.Behind

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## The vocabulary -/

/-- Every step of the log is the system's own decision of its own event on the World before it: a
Turn is what `receive` derives from the call its event decodes to, a refusal is what `recordedBy`
records for it. (`Receive.Honest`, with the kernel a parameter.) -/
def Decided (S : System D) : World D → List (Step D) → Prop
  | _, [] => True
  | w, .turn t :: rest => ∃ c, S.X.decodeCall t.event = some c ∧ S.receive w c = .ok t ∧
      ∀ w', S.admit w t = .ok w' → Decided S w' rest
  | w, .refusal r :: rest => ∃ c v w₁, S.X.decodeCall r.event = some c ∧
      S.recordedBy w c r = .recorded v r w₁ ∧ ∀ w', S.refuse w r = .ok w' → Decided S w' rest

/-- An audited log: it folds under the system's kernel to `w'`, and every step is the kernel's
own decision. -/
def Audited (S : System D) (w : World D) (l : List (Step D)) (w' : World D) : Prop :=
  S.fold w l = .ok w' ∧ Decided S w l

/-- A World a member's follower may start from: a genesis World (built by the kernel from the
signed inputs), or a base whose bytes hash to the pin of an invitation that the sponsor key the
member trusts signed, for the member's own World (thin consent: the history before the pin is the
sponsor's word, PROTOCOL-14). -/
inductive Start (S : System D) (me : Command.Self D) (trusted : ByteArray) : World D → Prop
  | genesis (name nonce : ByteArray) (allowance : Nat) (founders : List (ByteArray × D))
      (auth : Authority) : Start S me trusted (genesisWorld S.X name nonce allowance founders auth)
  | pinned {inv : ByteArray} {i : Invite.Invitation D} {w : World D} :
      Command.adoptPin S.X me inv trusted = .ok i →
      S.B.digest (S.B.world.bytes w) = i.pin.digest → S.B.stepsOf w = i.pin.steps →
      w.origin = me.world → Start S me trusted w
#!/usr/bin/env bash
# scripts/standing.sh [--here] [REV] — the standing verdict of one commit (default HEAD), on a
# laptop. Refused unless this checkout is at main (--here: judge with this checkout's scripts).
#
#   tip -> gates -> full build -> census -> generated files -> the Rust workspace -> runs -> waste -> one line:
#   STANDING <sha> gates=… build=… census=… generated=… cargo=… runs=… waste=… unmeasured=N … carried=N daily=N => GREEN|RED|INCOMPLETE
#   and a time line, `stages: gates=Ns build=Ns census=Ns generated=Ns cargo=Ns runs=Ns waste=Ns total=Ns`, by this
#   script's clock (also <sha12>.times); runs.py prints each row's own `  time ROW: N s` (GATES-20g). Times are
#   REPORTED, never gated.
# THE CARRY (GATES-20l; Ember 10-21 via ROOT: a docs-only delta converges in minutes): what the delta since the last
# run cannot reach is not run again, and nothing is carried for more than a day (ND_DAILY seconds, default 86400):
#   build   carried when the build inputs (every .lean, .c and .h, lakefile.lean, lean-toolchain, lake-manifest.json,
#           as git blob ids) are byte-identical to those of the last build that read ok in this directory (its .lake
#           is that build's product): `build=ok(carried SHA: inputs byte-identical)`;
#   census  the same over the build inputs and every path under gates/ (the census reads the allow tables there);
#   rows    gates/runs.py --reuse/--record/--daily: a row whose traced key is byte-identical to its last ok run's.
# Everything else (the gates, the generated files, the Rust workspace, the waste ceilings) runs every time.
# It is THE CONVERGENCE (GATES-22): scripts/converge runs it on main every 3 h while landings happen, and every
# check a FAST landing does not run is here: the census, the generated files, the whole Rust workspace (cargo
# check, clippy -D warnings, rustfmt; per landing since GATES-22 only check + fmt of the reached packages), every
# row (the benches included) and the waste ceilings.
#
# GREEN only when every stage's value is exactly `ok` and no ceiling is unmeasured; any RED stage
# makes the line RED; anything else (ABSENT, INCOMPLETE, KILLED(load)) is INCOMPLETE: a gate that
# cannot run is not a pass. The line is also appended to <git-common-dir>/nanodregg-standing/verdicts.log.
#   runs:  gates/runs.py over every lean_exe gates/runs.tsv classifies as a verdict (sims, journeys,
#          rows, plants), with the arguments the table gives (kernel-sim --seeds 64: its
#          planted-refusal coverage gate judges only >= 16 seeds). ok / INCOMPLETE(first pending
#          run: a row with no driver) / UNJUDGED(first killed or twice-timed-out run) / RED(first red run).
#   build: GATES-24 (cv 01a16f6d): ok, RED only for a build that FINISHED and failed (lake's exit 1 with an `error:`
#          line), and ABSENT(killed: …) for one that did not finish (its scope OOM-killed, lake ended by a signal, no
#          error line): gates/converge.py build reads lake's output, its exit and its scope's journal. A completed
#          build's memory peak goes to nanodregg-standing/build-peaks.log (scripts/converge's memory floor).
#   waste: the `WASTE <op> <metric> <ratio>` lines the runs print, against gates/waste.tsv
#          (gates/waste.py --measured --runs-out): a pinned row above its ceiling is RED; a pinned row nothing
#          measured is RED when a row that measures it ran ok, ABSENT (`waste-absent …`) when that row did not run
#          to an ok verdict; no row ran (the build did not finish) or no measurement and no row: ABSENT (INCOMPLETE)
set -uo pipefail
. "$(dirname "$0")/gate-lib.sh"
here=0
[ "${1:-}" = --here ] && { here=1; shift; }
rev=${1:-HEAD}
# These scripts and gates are the checkout's own: a checkout behind main judges with old gates.
# Run from a checkout at main, or say --here to judge with this checkout's scripts on purpose.
if [ $here = 0 ] && [ "$(git -C "$repo" rev-parse HEAD)" != "$(git -C "$repo" rev-parse refs/heads/main)" ]; then
  echo "standing: REFUSED — this checkout is at $(git -C "$repo" rev-parse --short HEAD), main is $(git -C "$repo" rev-parse --short refs/heads/main): git checkout --detach main, or pass --here" >&2
  exit 2
fi
sha=$(git -C "$repo" rev-parse "$rev") || exit 2
# A parentless commit has nothing to be judged against (the ratchets compare with the parent).
if ! base=$(git -C "$repo" rev-parse -q --verify "$sha^^{tree}"); then
  echo "STANDING ${sha:0:12} => REFUSED(noParent)"; exit 1
fi
G=$common/nanodregg-standing
lock nanodregg-standing || exit 2
export CARGO_TARGET_DIR=$G/cargo-target
materialize "$sha^{tree}" "$G/tree" || exit 2
materialize "$base" "$G/base" || exit 2
T=$G/tree
log=$G/${sha:0:12}.log
: > "$log"
run() { "$@" >> "$log" 2>&1 && echo ok || echo RED; }
# scoped TOOL CMD…: a build (TOOL lake or cargo) under the build wrapper, read by gates/converge.py build (GATES-24):
# ok, RED (it finished and failed), ABSENT(killed: …) (its scope OOM-killed, a signal, no failure line). The command
# writes its cgroup (the swarm-build scope) before it starts, so the scope's journal can say how it ended.
scoped() {
  local tool=$1 rc v; shift
  rm -f "$G/build.cgroup"
  # shellcheck disable=SC2016
  wrapped sh -c 'cat /proc/self/cgroup > "$0" 2>/dev/null; exec "$@"' "$G/build.cgroup" "$@" > "$G/build.out" 2>&1

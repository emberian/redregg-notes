exec
/bin/zsh -lc "ssh -n hbox 'cd /tank/dregg-build/nanodregg/main && sed -n \"1,95p\" Lang/Package.lean && sed -n \"1,110p\" Lang/LiveHoles.lean && sed -n \"1,90p\" Lang/Claim.lean && sed -n \"1,85p\" Kernel/Receive/Authority.lean && sed -n \"1,105p\" Protocol/Foreign.lean && sed -n \"1,85p\" Ledger/Escrow.lean' " in /Users/ember/dev/redregg/work/codex/DOCS-README

def holeCoverageOutcome (s0 s1 blocker : Bool) : Except Fault Val :=
  (Contextual.Trace.collect
    (fun r : Bool × String => Fault.refused r.2.toUTF8)
    (fun r : Bool × String => if r.1 then some () else none)

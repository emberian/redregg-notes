/-- The premise is satisfiable: the same knot extracts, to `g = 1`. -/
theorem extract_knot_ok : ∃ f, (Machine.mk []).extract (.record [("a", .nat), ("g", .nat)]) 100
    (.knot knotBody []) = .ok (.record [("a", .nat 1), ("g", .nat 1)], f) :=

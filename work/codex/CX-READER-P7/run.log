/- Closed packages keep their exact admission and execution under live deployment. -/
import Lang.Proofs.Contextual.LiveHoles

namespace Nanodregg.Lang
open Nanodregg.Kernel Nanodregg.Kernel.Receive

/-- The closed admission already excludes every contextual signature. -/
theorem admitPackage_closed {D : Type} {digestOf : ByteArray → Option D}
    {idb : ByteArray} {p : Package} {acc L : Loaded} {gis : List Nat} {g : Nat}
    (h : admitPackage digestOf idb p acc gis = .ok (L, g)) :
    p.holes = [] ∧ L.pkgs = acc.pkgs ++ [p] := by
  unfold admitPackage at h
  repeat' split at h
  all_goals first | (cases h; done) | skip
  simp only [Except.ok.injEq, Prod.mk.injEq] at h
  obtain ⟨rfl, rfl⟩ := h
  exact ⟨(checkWith_closed ‹_›).1, rfl⟩

theorem admitContextual_closed {D : Type} (digestOf : ByteArray → Option D)
    (prepare : List Ty → Package → Except String Term)
    (idb : ByteArray) (p : Package) (acc : Loaded) (gis : List Nat)
    (hc : p.holes = []) :
    admitContextual digestOf prepare idb p acc gis = admitPackage digestOf idb p acc gis := by
  simp only [admitContextual, hc, List.isEmpty_nil, if_true]

section
variable {D : Type} (digestOf : ByteArray → Option D) (look : Pinned D)
  (prepare : List Ty → Package → Except String Term)

mutual
/-- A successfully loaded closed closure is admitted identically by live loading.
The closure property is derived from admission, never added to the old load contract. -/
theorem load_closed_live (fuel : Nat) (idb : ByteArray) (acc : Loaded) {L : Loaded} {g : Nat}
    (ha : ∀ p ∈ acc.pkgs, p.holes = [])
    (h : load digestOf look fuel idb acc = .ok (L, g)) :
    loadUsing digestOf (admitContextual digestOf prepare) look fuel idb acc = .ok (L, g) ∧
      ∀ p ∈ L.pkgs, p.holes = [] := by
  change loadUsing digestOf (admitPackage digestOf) look fuel idb acc = _ at h
  unfold loadUsing at h ⊢
  split at h
  · rename_i i hi
    cases h
    exact ⟨rfl, ha⟩
  · rename_i hi
    split at h
    · cases h
    · rename_i fuel
      split at h
      · cases h
      · rename_i id hid
        split at h
        · cases h
        · rename_i p hp
          split at h
          · cases h
          · rename_i acc' gis hall
            obtain ⟨hall', hc⟩ := loadAll_closed_live fuel p.imports acc ha hall
            simp only [hall']
            obtain ⟨hpc, hext⟩ := admitPackage_closed h
            refine ⟨?_, ?_⟩
            · rw [admitContextual_closed digestOf prepare _ _ _ _ hpc]; exact h
            · rw [hext]
              intro q hq
              rcases List.mem_append.mp hq with hq | hq
              · exact hc q hq
              · obtain rfl := List.mem_singleton.mp hq
                exact hpc
termination_by (fuel, 0)

theorem loadAll_closed_live (fuel : Nat) (ds : List ByteArray) (acc : Loaded)
    {L : Loaded} {gs : List Nat}
    (ha : ∀ p ∈ acc.pkgs, p.holes = [])
    (h : loadAll digestOf look fuel ds acc = .ok (L, gs)) :
    loadAllUsing digestOf (admitContextual digestOf prepare) look fuel ds acc = .ok (L, gs) ∧
      ∀ p ∈ L.pkgs, p.holes = [] := by
  change loadAllUsing digestOf (admitPackage digestOf) look fuel ds acc = _ at h
  unfold loadAllUsing at h ⊢
  split at h
  · cases h; exact ⟨rfl, ha⟩
  · rename_i d ds
    split at h
    · cases h
    · rename_i acc1 g1 h1
      obtain ⟨h1', hc1⟩ := load_closed_live fuel d acc ha h1
      simp only [h1']
      split at h
      · cases h
      · rename_i acc2 gs2 h2
        obtain ⟨h2', hc2⟩ := loadAll_closed_live fuel ds acc1 hc1 h2
        simp only [h2']
        cases h; exact ⟨rfl, hc2⟩
termination_by (fuel, ds.length + 1)
end
end

theorem Loaded.preparationCost_closed (L : Loaded) (hc : ∀ p ∈ L.pkgs, p.holes = []) :
    L.preparationCost = 0 := by
  unfold Loaded.preparationCost
  have hm : L.pkgs.map Package.preparationCost = L.pkgs.map (fun _ => 0) := by
    apply List.map_congr_left
    intro p hp
    simp [Package.preparationCost, hc p hp]
  rw [hm]
  have hz : ∀ (ps : List Package) (n : Nat),
      ((ps.map (fun _ => 0)).foldl (· + ·) n) = n := by
    intro ps n
    induction ps generalizing n with
    | nil => rfl
    | cons p ps ih => simpa using ih n
  exact hz _ 0

/-- Closed admission implies the same live library, with zero preparation charge. -/
theorem loadLive_of_load {D : Type} {digestOf : ByteArray → Option D}
    (rv : RowView D) (self : D) {look : Pinned D} {fuel : Nat} {idb : ByteArray}
    {L : Loaded} {g : Nat}
    (h : load digestOf look fuel idb ⟨[], [], []⟩ = .ok (L, g)) :
    loadLive digestOf rv self look fuel idb ⟨[], [], []⟩ = .ok (L, g) ∧
      L.preparationCost = 0 := by
  obtain ⟨hl, hc⟩ := load_closed_live digestOf look
    (fun Δ p => (instantiateHoles rv self Δ p).map (·.body)) fuel idb _ (by simp) h
  exact ⟨hl, Loaded.preparationCost_closed L hc⟩

/-- Every successful closed setup is byte-for-byte the setup used by live deployment. -/
theorem runSetupLive_of_runSetup {D : Type}
    {bytesOf : D → ByteArray} {digestOf : ByteArray → Option D}
    {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat}
    {args : ByteArray} {r : Req D} {S : RunSetup}
    (h : runSetup bytesOf digestOf look rv pkg state method args r = .ok S) :
    runSetupLive bytesOf digestOf look rv pkg state method args r = .ok S := by
  unfold runSetup runSetupWith at h
  unfold runSetupLive runSetupWith
  simp only [bind, Except.bind, pure, Except.pure] at h ⊢
  split at h
  · rename_i hreq
    rw [if_pos hreq]
    split at h
    · cases h
    · rename_i L g hl
      obtain ⟨hlive, hcost⟩ := loadLive_of_load rv r.self hl
      rw [hlive]
      simp only [hcost]
      exact h
  · cases h

/-- Same result, refusal, calls, edits and ticks for every budget after a closed setup. -/
theorem runMeasuredLive_closed {D : Type}
    {bytesOf : D → ByteArray} {digestOf : ByteArray → Option D}
    {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat}
    {args : ByteArray} {r : Req D} {S : RunSetup}
    (h : runSetup bytesOf digestOf look rv pkg state method args r = .ok S) (budget : Nat) :
    runMeasuredLive bytesOf digestOf look rv pkg state method args r budget =
      runMeasured bytesOf digestOf look rv pkg state method args r budget := by
  simp only [runMeasuredLive, runMeasured, runMeasuredWith,
    runSetupLive_of_runSetup h, h, bind, Except.bind]

/-- The actual deployed Program.run preserves the entire closed result, including ticks. -/
theorem program_run_closed {D : Type}
    {bytesOf : D → ByteArray} {digestOf : ByteArray → Option D}
    {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat}
    {args : ByteArray} {r : Req D} {S : RunSetup}
    (h : runSetup bytesOf digestOf look rv pkg state method args r = .ok S) (budget : Nat) :
    (program bytesOf digestOf).run look rv pkg state method args r budget =
      (runMeasured bytesOf digestOf look rv pkg state method args r budget).map
        (fun x => (x.1, x.2.1, x.2.2.1, x.2.2.2.1)) := by
  change (runMeasuredLive bytesOf digestOf look rv pkg state method args r budget).map _ = _
  rw [runMeasuredLive_closed h]

/-- Empty-signature install uses the closed check exactly, including refusals. -/
theorem checkInstallContextual_closed {D : Type} (digestOf : ByteArray → Option D)
    (look : Pinned D) (b : ByteArray) {p : Package}
    (hd : Wire.decodePackage b = .ok p) (hc : p.holes = []) :
    checkInstallContextual digestOf look b = checkInstall digestOf look b := by
  simp [checkInstallContextual, hd, hc, bind, Except.bind, pure, Except.pure]
  cases checkInstall digestOf look b <;> rfl

/-- Law execution is identical once a closed closure loads, for any request or states. -/
theorem judgeOneContextual_closed {D : Type} (bytesOf : D → ByteArray)
    (digestOf : ByteArray → Option D) (look : Pinned D) (law : D)
    (old new : Slots) (r : Req D) {L : Loaded} {g : Nat}
    (h : load digestOf look closureDepthMax (bytesOf law) ⟨[], [], []⟩ = .ok (L, g)) :
    judgeOneWith bytesOf digestOf (loadContextual digestOf) look law old new r =
      judgeOne bytesOf digestOf look law old new r := by
  have hl := (load_closed_live digestOf look (fun _ => unresolvedBody)
    closureDepthMax (bytesOf law) ⟨[], [], []⟩ (by simp) h).1
  change loadContextual digestOf look closureDepthMax (bytesOf law) ⟨[], [], []⟩ = .ok (L, g) at hl
  simp only [judgeOne, judgeOneWith, hl, h]

end Nanodregg.Lang
/-
# Lang.Program — the language as KERNEL's `Receive.Program`: install check, laws, methods

`program bytesOf digestOf` instantiates `Kernel.Receive.Program D`. Every read goes through the
caller's `Pinned` view (so `receive_congr` covers LANG's reads): a package and every package in its
closure must be pinned, or the receiver refuses `unpinned`.

* `checkInstall` decodes the package (canonical bytes or a named decode refusal), loads its imports'
  closure exactly as a run does (each import pinned, decoded and RE-CHECKED, depth one below the
  package's own load), and runs `Package.checkWith` over those interfaces (LANG-35).
* `run` loads the closure (each package once, depth ≤ `closureDepthMax`, bodies relocated to the
  closure's indices), decodes the state at the package's state type and the arguments at the
  method's argument type, runs `method state args req` under the call's tick budget and extracts
  its result (`resultTy` at the method's call slots: the calls, then the new state) under what is left of it; the calls are
  KERNEL `Body`s by `Lang.callsOf`.
* `judge` runs every law in force — the package's own, then each extra law package's — on
  `old → new`, each under `lawTicks`, each reading the slots at ITS state type (LANG-11). `refused r`
  is `lawDenied law (label ++ ": " ++ r)`; running out of ticks is `lawDenied law (label ++ ": exhausted")`.
-/
import Kernel.Receive.Call
import Lang.Law
import Lang.Wire.Data
import Lang.Read
import Lang.Call
import Lang.Rel
import Lang.LiveHoles

namespace Nanodregg.Lang

open Nanodregg.Kernel
open Nanodregg.Kernel.Receive

/-- How deep a closure's import graph may be. -/
def closureDepthMax : Nat := 8
/-- The longest reason a law may give, in bytes. -/
def reasonMax : Nat := Bounds.reasonMax

variable {D : Type} [DecidableEq D]

/-- A loaded closure: package ids in `lib` order, the relocated bodies, the packages. -/
structure Loaded where
  ids : List ByteArray
  lib : List Term
  pkgs : List Package

/-- The interfaces of a closure's packages, in `lib` order: the types `ref` gives them. -/
abbrev Loaded.ifaces (L : Loaded) : List Ty := L.pkgs.map (·.iface)

def reasonText (r : ByteArray) : String :=
  let r := r.extract 0 reasonMax
  (String.fromUTF8? r).getD s!"{r.size} bytes"

def faultText : Fault → String
  | .stuck => "stuck" | .overflow => "overflow" | .underflow => "underflow"
  | .divZero => "divZero" | .tooLarge => "tooLarge" | .ticks => "exhausted" | .stack => "stack"
  | .refused why => s!"refused {reasonText why}"

def decodeText (e : Codec.Refusal) : String := s!"decode {repr e}"

section
variable (bytesOf : D → ByteArray) (digestOf : ByteArray → Option D)

/-- The package in a pinned package cell. -/
def readPackage (look : Pinned D) (id : D) : Except (Refusal D) Package := do
  let cell ← readKind look id kindPackage
  match cell.slots.get 0 with
  | none => throw (.malformedCell id 0)
  | some b =>
    match Wire.decodePackage b with
    | .ok p => pure p
    | .error _ => throw (.malformedCell id 0)

def idOf (b : ByteArray) : Except (Refusal D) D :=
  match digestOf b with
  | some d => .ok d
  | none => .error (.program "import is not a digest")

/-- Every digest in `ds` is a digest of the World (LANG-38: an id enters a run only as one). -/
def digestsOk (ds : List ByteArray) : Bool := ds.all fun b => (digestOf b).isSome

/-- Install's and every load's id-literal check: the checked package, or `notDigest` when a
digest literal of its body is not a digest of the World (LANG-38). -/
def checkLits (p : Package) : Except (Refusal D) Unit :=
  if digestsOk digestOf p.body.digestLits then .ok () else .error (.program "notDigest")

def indexIn (b : ByteArray) : List ByteArray → Option Nat
  | [] => none
  | x :: xs => if x = b then some 0 else (indexIn b xs).map (· + 1)

/-- The interfaces of the closure's packages at positions `gs`. -/
def ifacesAt (pkgs : List Package) : List Nat → Option (List Ty)
  | [] => some []
  | g :: gs =>
    match pkgs[g]?, ifacesAt pkgs gs with
    | some P, some r => some (P.iface :: r)
    | _, _ => none

/-- Append package `p` (imports already loaded at `gis`) to the closure, RE-CHECKING it against its
imports' interfaces (decisions/lang.md LANG-16), its body relocated to the closure's indices. -/
def admitPackage (idb : ByteArray) (p : Package) (acc : Loaded) (gis : List Nat) :
    Except (Refusal D) (Loaded × Nat) :=
  match ifacesAt acc.pkgs gis with
  | none => .error (.program "closure")
  | some ifs =>
    match p.checkWith ifs with
    | .error e => .error (.program e.wire)
    | .ok () =>
      match checkLits digestOf p with
      | .error e => .error e
      | .ok () =>
      .ok ({ ids := acc.ids ++ [idb], lib := acc.lib ++ [p.body.relocate fun i => gis.getD i 0],
             pkgs := acc.pkgs ++ [p] }, acc.ids.length)

mutual
/-- Load package `idb` and its closure into `acc` (each package once); its index in the closure. -/
def loadUsing (admit : ByteArray → Package → Loaded → List Nat → Except (Refusal D) (Loaded × Nat)) (look : Pinned D) (fuel : Nat) (idb : ByteArray) (acc : Loaded) :
    Except (Refusal D) (Loaded × Nat) :=
  match indexIn idb acc.ids with
  | some i => .ok (acc, i)
  | none =>
    match fuel with
    | 0 => .error (.program "imports too deep")
    | fuel + 1 =>
      match idOf digestOf idb with
      | .error e => .error e
      | .ok id =>
        match readPackage look id with
        | .error e => .error e
        | .ok p =>
          match loadAllUsing admit look fuel p.imports acc with
          | .error e => .error e
          | .ok (acc', gis) => admit idb p acc' gis
termination_by (fuel, 0)

def loadAllUsing (admit : ByteArray → Package → Loaded → List Nat → Except (Refusal D) (Loaded × Nat)) (look : Pinned D) (fuel : Nat) (ds : List ByteArray) (acc : Loaded) :
    Except (Refusal D) (Loaded × List Nat) :=
  match ds with
  | [] => .ok (acc, [])
  | d :: ds =>
    match loadUsing admit look fuel d acc with
    | .error e => .error e
    | .ok (acc', g) =>
      match loadAllUsing admit look fuel ds acc' with
      | .error e => .error e
      | .ok (acc'', gs) => .ok (acc'', g :: gs)
termination_by (fuel, ds.length + 1)
end

/-- The closed specialization of the shared closure traversal. -/
def load (look : Pinned D) (fuel : Nat) (idb : ByteArray) (acc : Loaded) :
    Except (Refusal D) (Loaded × Nat) :=
  loadUsing digestOf (admitPackage digestOf) look fuel idb acc

def loadAll (look : Pinned D) (fuel : Nat) (ds : List ByteArray) (acc : Loaded) :
    Except (Refusal D) (Loaded × List Nat) :=
  loadAllUsing digestOf (admitPackage digestOf) look fuel ds acc

/-- All ROM code, including unselected candidates, passes the World's literal boundary. -/
def checkROMLits (p : Package) : Except (Refusal D) Unit :=
  if digestsOk digestOf (p.body.digestLits ++ p.holes.flatMap
      (fun h => h.guard.digestLits ++ h.code.flatMap (fun c => c.body.digestLits)))
  then .ok () else .error (.program "notDigest")

/-- A residual hole is a typed refusal when no row view is available (install
and law checking). Ordinary fields still evaluate; no selected code is guessed. -/
def unresolvedBody (p : Package) : Except String Term :=
  if p.holes.isEmpty then .ok p.body
  else Contextual.Term.fillBounded Wire.nodeMax 1
    (fun n => ((holeSignature p.holes).find? (fun d => d.name == n)).map
      (fun d => .refuse d.ty "holeUnresolved".toUTF8)) p.body

/-- Shared live admission. The package retained in Loaded is the original ROM;
only the transient machine library receives an instantiated body. -/
def admitContextual (prepare : List Ty → Package → Except String Term)
    (idb : ByteArray) (p : Package) (acc : Loaded) (gis : List Nat) :
    Except (Refusal D) (Loaded × Nat) :=
  if p.holes.isEmpty then admitPackage digestOf idb p acc gis
  else match ifacesAt acc.pkgs gis with
  | none => .error (.program "closure")
  | some ifs =>
    match p.checkContextual ifs with
    | .error e => .error (.program e)
    | .ok () =>
      match prepare ifs p with
      | .error e => .error (.program e)
      | .ok body =>
        match checkE ifs body p.iface with
        | .error e => .error (.program s!"holeInstanceType {e.text}")
        | .ok () =>
          match checkROMLits digestOf p, checkLits digestOf { p with body } with
          | .ok (), .ok () =>
            .ok ({ ids := acc.ids ++ [idb],
                   lib := acc.lib ++ [body.relocate fun i => gis.getD i 0],
                   pkgs := acc.pkgs ++ [p] }, acc.ids.length)
          | .error e, _ | _, .error e => .error e

def loadContextual (look : Pinned D) (fuel : Nat) (idb : ByteArray) (acc : Loaded) :
    Except (Refusal D) (Loaded × Nat) :=
  loadUsing digestOf (admitContextual digestOf (fun _ => unresolvedBody)) look fuel idb acc

def loadAllContextual (look : Pinned D) (fuel : Nat) (ds : List ByteArray) (acc : Loaded) :
    Except (Refusal D) (Loaded × List Nat) :=
  loadAllUsing digestOf (admitContextual digestOf (fun _ => unresolvedBody)) look fuel ds acc

def loadLive (rv : RowView D) (self : D) (look : Pinned D) (fuel : Nat)
    (idb : ByteArray) (acc : Loaded) : Except (Refusal D) (Loaded × Nat) :=
  loadUsing digestOf (admitContextual digestOf (fun Δ p =>
    (instantiateHoles rv self Δ p).map (·.body))) look fuel idb acc

/-- Conservative preparation charge derived entirely from the actual ROM syntax;
the selected candidate cannot exceed the maximum over its committed candidates. -/
def Package.preparationCost (p : Package) : Nat :=
  if p.holes.isEmpty then 0
  else Contextual.Term.nodes p.body *
    (1 + (p.holes.flatMap (fun h => h.code)).foldl
      (fun n c => max n (Contextual.Term.nodes c.body)) 1) + 256 * p.holes.length


def checkInstall (look : Pinned D) (b : ByteArray) : Except (Refusal D) Unit := do
  let p ← match Wire.decodePackage b with
    | .ok p => pure p
    | .error e => throw (.program (decodeText e))
  -- the imports' closure, loaded and re-checked exactly as a run loads it (one depth below the
  -- package's own load), so every interface the check reads passed `checkShape` (LANG-35)
  let (L, gis) ← loadAll digestOf look (closureDepthMax - 1) p.imports ⟨[], [], []⟩
  let some ifaces := ifacesAt L.pkgs gis | throw (.program "closure")
  match p.checkWith ifaces with
  | .ok () => checkLits digestOf p
  | .error e => throw (.program e.wire)

def checkInstallContextual (look : Pinned D) (b : ByteArray) : Except (Refusal D) Unit := do
  let p ← match Wire.decodePackage b with
    | .ok p => pure p
    | .error e => throw (.program (decodeText e))
  if p.holes.isEmpty then return ← checkInstall digestOf look b
  let (L, gis) ← loadAllContextual digestOf look (closureDepthMax - 1) p.imports ⟨[], [], []⟩
  let some ifaces := ifacesAt L.pkgs gis | throw (.program "closure")
  match p.checkContextual ifaces with
  | .error e => throw (.program e)
  | .ok () => checkROMLits digestOf p

/-- The state slots of a record row: field `i` at `stateBase + i`; `none` if a field has no bytes at
its type (extraction at the state type makes that unreachable; it is refused by name, not written). -/
def stateSlots : List (Label × Ty) → List (Label × Data) → Nat → Option Slots
  | [], [], _ => some []
  | (_, t) :: row, (_, d) :: ds, i =>
    match Wire.encodeData t d, stateSlots row ds (i + 1) with
    | some b, some s => some ((stateBase + i, b) :: s)
    | _, _ => none
  | _, _, _ => none

def readState (row : List (Label × Ty)) (s : Slots) : Except String Data :=
  go row 0
where
  go : List (Label × Ty) → Nat → Except String Data
    | [], _ => .ok (.record [])
    | (ℓ, t) :: row, i =>
      match s.get (stateBase + i) with
      | none => .error s!"state field {ℓ} missing"
      | some b =>
        match Wire.decodeData t b, go row (i + 1) with
        | .ok d, .ok (.record ds) =>
          if digestsOk digestOf d.digests then .ok (.record ((ℓ, d) :: ds))
          else .error s!"state field {ℓ}: not a digest"
        | .error e, _ => .error s!"state field {ℓ}: {decodeText e}"
        | _, .error e => .error e
        | _, _ => .error "state"

/-- The occasion as data at `occasionTy`; a law replacement's (and an adoption's) incoming ids as
their bytes, concatenated in the call's order (digests are fixed-width, so the concatenation is unambiguous). -/
def occasionData : Occasion D → Data
  | .birth => .inj "birth" (.record [])
  | .write => .inj "write" (.record [])
  | .relaw ls => .inj "relaw" (.bytes (ls.foldl (fun acc l => acc ++ bytesOf l) .empty))
  | .adopt ls => .inj "adopt" (.bytes (ls.foldl (fun acc l => acc ++ bytesOf l) .empty))
  | .invoke m => .inj "invoke" (.nat m)

/-- The occasion fits the language's data: a method index is a natural, a law list's bytes one
byte value. -/
def occasionOk : Occasion D → Bool
  | .birth | .write => true
  | .relaw ls | .adopt ls => decide ((ls.foldl (fun acc l => acc ++ bytesOf l) .empty).size ≤ Bounds.bytesMax)
  | .invoke m => decide (m < Bounds.natLimit)

/-- The request fits the language's data: its member and object digests fit a byte value, its window fits
a natural, its occasion fits `occasionTy`. KERNEL bounds the window only at admission
(`checkBounds`, after the receivers ran), so the language asserts it where the request enters a
run (law 4). -/
def reqOk (r : Req D) : Bool :=
  decide ((bytesOf r.agent).size ≤ Bounds.digestBytesMax) &&
    decide ((bytesOf r.principal).size ≤ Bounds.digestBytesMax) &&
    decide ((bytesOf r.self).size ≤ Bounds.digestBytesMax) &&
    decide (r.notBefore < Bounds.natLimit) && decide (r.validUntil < Bounds.natLimit) &&
    occasionOk bytesOf r.occasion

def reqData (r : Req D) : Data :=
  .record [("agent", .digest (bytesOf r.agent)), ("notBefore", .nat r.notBefore),
    ("occasion", occasionData bytesOf r.occasion),
    ("principal", .digest (bytesOf r.principal)), ("self", .digest (bytesOf r.self)),
    ("validUntil", .nat r.validUntil)]

/-- Apply field `ℓ` of closure body `g` to values bound as `var 2, var 1, var 0`. -/
def apply3 (g : Nat) (ℓ : Label) : Term :=
  .app (.app (.app (.get (.ref g) ℓ) (.var 2)) (.var 1)) (.var 0)

/-- Apply method `ℓ` of closure body `g` to its rows, state, arguments and request, bound as
`var 3, var 2, var 1, var 0` (LANG-49: rows first). -/
def apply4 (g : Nat) (ℓ : Label) : Term :=
  .app (.app (.app (.app (.get (.ref g) ℓ) (.var 3)) (.var 2)) (.var 1)) (.var 0)

def recordRow : Ty → List (Label × Ty)
  | .record r => r
  | _ => []

/-- Every law of the package at closure index `g` (whose id is `law`) on `old → new`, each run by
the one law runner `runLaw` on the package's field. -/
def judgeOneWith (loader : Pinned D → Nat → ByteArray → Loaded → Except (Refusal D) (Loaded × Nat)) (look : Pinned D) (law : D) (old new : Slots) (r : Req D) :
    Except (Refusal D) Unit := do
  unless reqOk bytesOf r do throw (.program "request out of bounds")
  let (L, g) ← loader look closureDepthMax (bytesOf law) ⟨[], [], []⟩
  let some p := L.pkgs[g]? | throw (.program "closure")
  let row := recordRow p.state
  let deny (why : String) : Refusal D := .lawDenied law why
  let o ← match readState digestOf row old with | .ok d => pure d | .error e => throw (deny e)
  let n ← match readState digestOf row new with | .ok d => pure d | .error e => throw (deny e)
  for ℓ in p.laws do
    match runLaw L.lib (.get (.ref g) ℓ) o n (reqData bytesOf r) with
    | .ok (.ok ()) => pure ()
    | .ok (.error why) => throw (deny s!"{ℓ}: {reasonText why}")
    | .error f => throw (deny s!"{ℓ}: {faultText f}")

def judgeOne (look : Pinned D) (law : D) (old new : Slots) (r : Req D) : Except (Refusal D) Unit :=
  judgeOneWith bytesOf digestOf (load digestOf) look law old new r

def judgeContextual (look : Pinned D) (pkg : Option D) (laws : List D) (old new : Slots) (r : Req D) :
    Except (Refusal D) Unit := do
  if let some p := pkg then
    judgeOneWith bytesOf digestOf (loadContextual digestOf) look p old new r
  for l in laws do
    judgeOneWith bytesOf digestOf (loadContextual digestOf) look l old new r

def judge (look : Pinned D) (pkg : Option D) (laws : List D) (old new : Slots) (r : Req D) :
    Except (Refusal D) Unit := do
  if let some p := pkg then judgeOne bytesOf digestOf look p old new r
  for l in laws do judgeOne bytesOf digestOf look l old new r

/-- Method `method` of package `p`: its label, its argument type and its call slots (the one
resolution: the run and the resident readers below all ask here). -/
def resolveMethod (p : Package) (method : Nat) : Except (Refusal D) (Label × Sig) := do
  let some ℓ := p.methods[method]? | throw (.program s!"no method {method}")
  let some mty := Row.find? ℓ (recordRow p.iface) | throw (.program s!"no method {ℓ}")
  let some sg := methodSig p.state p.rels mty | throw (.program s!"method {ℓ}")
  pure (ℓ, sg)

/-- What a method run starts from once every boundary check has passed (LANG-41): the closure's
bodies and size, the method's label, the state's record row, the type the result is extracted at,
the state and the arguments as data, and the term the machine evaluates in its environment
(`[req, args, state]`). Every id that enters a run enters here: a request's members and object
from the World (`reqData`), the state and the arguments each checked by `digestOf`, and the
closure's id literals checked at load (`checkLits`). -/
structure RunSetup where
  lib : List Term
  pkgs : Nat
  /-- the package's index in the closure, and its relations (LANG-49: guards run at `g`) -/
  g : Nat
  rels : List (Label × RelDecl)
  label : Label
  row : List (Label × Ty)
  ty : Ty
  state : Data
  args : Data
  /-- the rows argument (LANG-49): what `readsData` built from the caller's view; the env's fourth value -/
  reads : Data
  term : Term
  env : Env
  preparation : Nat := 0

/-- The front half of every method run: the request's bounds, the closure loaded and re-checked
(LANG-16), the method resolved, the state read at its row and the arguments decoded at their type,
each refused by name. `runMeasured` runs from it; the WASTE counter (`Lang.Need`) counts from it. -/
def runSetupWith (loader : Pinned D → Nat → ByteArray → Loaded → Except (Refusal D) (Loaded × Nat))
    (charge : Loaded → Nat) (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) : Except (Refusal D) RunSetup := do
  unless reqOk bytesOf r do throw (.program "request out of bounds")
  let (L, g) ← loader look closureDepthMax (bytesOf pkg) ⟨[], [], []⟩
  let some p := L.pkgs[g]? | throw (.program "closure")
  let (ℓ, sg) ← resolveMethod p method
  let row := recordRow p.state
  let s ← match readState digestOf row state with | .ok d => pure d | .error e => throw (.program e)
  let a ← match Wire.decodeData sg.arg args with
    | .ok d => if digestsOk digestOf d.digests then pure d else throw (.program "arguments: not a digest")
    | .error e => throw (.program s!"arguments: {decodeText e}")
  let rows ← readsData digestOf p.rels rv r.self sg.reads
  pure { lib := L.lib, pkgs := L.pkgs.length, g, rels := p.rels, label := ℓ, row,
         ty := resultTy p.state sg.calls (editTy p.rels) sg.edits, state := s,
         args := a, reads := rows, term := apply4 g ℓ, env := [(reqData bytesOf r).toVal, a.toVal, s.toVal, rows.toVal], preparation := charge L }

/-- Closed specialization retained for its landed statements. -/
def runSetup (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) : Except (Refusal D) RunSetup :=
  runSetupWith bytesOf digestOf (load digestOf) (fun _ => 0) look rv pkg state method args r

def Loaded.preparationCost (L : Loaded) : Nat :=
  (L.pkgs.map Package.preparationCost).foldl (· + ·) 0

/-- The deployed setup reauthenticates every contextual selection for this invocation. -/
def runSetupLive (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) : Except (Refusal D) RunSetup :=
  runSetupWith bytesOf digestOf (loadLive digestOf rv r.self)
    Loaded.preparationCost
    look rv pkg state method args r

/-- Every edit judged by its relation's guard, if it has one, over the state before the run, the
request, and the edit with its old row (LANG-49: O(edits), never a relation; one law runner,
`runLaw`). Every edit's old row is found first (`guardOld`), so an unpinned upsert or retract is
refused `rowUnpinned` before any guard runs (LANG-59). -/
def guardEdits (S : RunSetup) (rv : RowView D) (pkg : D) (r : Req D) (es : List (Edit D)) :
    Except (Refusal D) Unit := do
  let olds ← es.mapM (guardOld digestOf rv r.self)
  (es.zip olds).forM fun (e, o) =>
    match e.decl.guard with
    | none => .ok ()
    | some gl =>
      match runLaw S.lib (.get (.ref S.g) gl) S.state (reqData bytesOf r) (guardIn e.data o) with
      | .ok (.ok ()) => .ok ()
      | .ok (.error why) => .error (.lawDenied pkg s!"{gl}: {reasonText why}")
      | .error f => .error (.lawDenied pkg s!"{gl}: {faultText f}")

/-- Run method `method` of package `pkg` on `state`: the new state slots and the calls the method
makes as the object (`callsOf`, in slot order), with what the run cost (WASTE rows, PROTOCOL-4):
the machine steps the method and its extraction used, and the packages of the closure loaded and
re-checked (LANG-16). `runMethod` and `program`'s `run` are its components, so a measured number
is the deployed run's. -/
def runMeasuredWith
    (setup : Pinned D → RowView D → D → Slots → Nat → ByteArray → Req D → Except (Refusal D) RunSetup) (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) (budget : Nat) :
    Except (Refusal D) (Slots × List (Body D) × List (RowSlot D × RowAct) × Nat × Nat) := do
  let S ← setup look rv pkg state method args r
  if S.preparation > budget then throw (.program "holeTicks")
  let machineBudget := budget - S.preparation
  match run S.lib Bounds.stackMax machineBudget 0 (State.init S.term S.env) with
  | .fault f _ => throw (.program s!"{S.label}: {faultText f}")
  | .value v used =>
    match (Machine.mk S.lib).extract S.ty (machineBudget - used) v with
    | .ok (.record [("calls", c), ("edits", e), ("state", .record ds)], left) =>
      match stateSlots S.row ds 0 with
      | some slots => do
        let calls ← callsOf digestOf c
        let es ← editsOf S.rels r.self e
        guardEdits bytesOf digestOf S rv pkg r es
        pure (slots, calls, es.map (fun x => (x.slot, x.act)), budget - left, S.pkgs)
      | none => throw (.program s!"{S.label}: state bytes")
    | .ok _ => throw (.program s!"{S.label}: state")
    | .error f => throw (.program s!"{S.label}: {faultText f}")

def runMeasured (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) (budget : Nat) :
    Except (Refusal D) (Slots × List (Body D) × List (RowSlot D × RowAct) × Nat × Nat) :=
  runMeasuredWith bytesOf digestOf (runSetup bytesOf digestOf) look rv pkg state method args r budget

def runMeasuredLive (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) (budget : Nat) :
    Except (Refusal D) (Slots × List (Body D) × List (RowSlot D × RowAct) × Nat × Nat) :=
  runMeasuredWith bytesOf digestOf (runSetupLive bytesOf digestOf) look rv pkg state method args r budget

def runMethod (look : Pinned D) (rv : RowView D) (pkg : D) (state : Slots) (method : Nat) (args : ByteArray)
    (r : Req D) (budget : Nat) : Except (Refusal D) (Slots × List (Body D) × List (RowSlot D × RowAct)) :=
  (runMeasured bytesOf digestOf look rv pkg state method args r budget).map fun x => (x.1, x.2.1, x.2.2.1)

/-- The `declare` acts of the relations of an object of package `pkg` born at `self`, in
relation order: each key's width at the World's digest width (`self`'s). -/
def relsOf (look : Pinned D) (pkg : D) (self : D) : Except (Refusal D) (List RowAct) := do
  let p ← readPackage look pkg
  pure (p.rels.map fun r => .declare r.2.limit r.2.cap (r.2.width (bytesOf self).size) r.2.retract)

/-! ## The resident readers: TEXT at a package's types (what `nd create --pkg` and `nd invoke` sign)

A reader refusal is `program` with its `name @offset` text (law 7's convention for `program`
reasons: the first token is the name). -/

def readAt (T : Ty) (text : String) : Except (Refusal D) Data :=
  match Read.readData T text with
  | .ok d => if digestsOk digestOf d.digests then .ok d else .error (.program "notDigest")
  | .error e => .error (.program e.text)

/-- A seed state read at package `pkg`'s state type, as the object's state slots. -/
def seedOf (look : Pinned D) (pkg : D) (text : String) : Except (Refusal D) Slots := do
  let p ← readPackage look pkg
  match ← readAt digestOf p.state text with
  | .record ds =>
    match stateSlots (recordRow p.state) ds 0 with
    | some s => pure s
    | none => throw (.program "seed: no bytes at the state type")
  | _ => throw (.program "seed: not a record")

/-- Method `method`'s arguments read at its argument type, as the bytes the run decodes. -/
def argsOf (look : Pinned D) (pkg : D) (method : Nat) (text : String) : Except (Refusal D) ByteArray := do
  let p ← readPackage look pkg
  let (_, sg) ← resolveMethod p method
  match Wire.encodeData sg.arg (← readAt digestOf sg.arg text) with
  | some b => pure b
  | none => throw (.program "arguments: no bytes at the argument type")

end

/-- The language, as the kernel's receivers see it. -/
def program (bytesOf : D → ByteArray) (digestOf : ByteArray → Option D) : Program D where
  checkInstall := checkInstallContextual digestOf
  judge := judgeContextual bytesOf digestOf
  -- the slots, the calls the method makes as the object, and the ticks it used (LEDGER-8 (e))
  run := fun look rv pkg state method args r budget =>
    (runMeasuredLive bytesOf digestOf look rv pkg state method args r budget).map fun x =>
      (x.1, x.2.1, x.2.2.1, x.2.2.2.1)
  rels := relsOf bytesOf

end Nanodregg.Lang
/-
# Lang.Proofs.CallLive — call data that conforms to its type is refused only for a non-digest field

`Lang.Proofs.Call` proves the forward half: a callable Body in bounds has call data of `callTy`
(`callData_conforms`). This is the converse, liveness. `bodyOf_live`: data conforming to `callTy`
reads as a Body, or the refusal is `PATH: not a digest` for bytes the digest decoder refuses, held
at exactly that label path of the data (`Live`, `DigestAt`, `Names`), the one thing a type cannot say. `callsOf_live`: the same for a calls
row conforming to `callsTy ks` over call slots, with the slot named (`DigestRefusal`).
`extract_conforms`: a value typed at a type extracts to data conforming to it (forcing each
suspension is a typed run, `force_typed`, `unknot_typed`). `callsOf_go_kinds`: the calls a
conforming row reads match, in order and one to one, a sublist of its slots, each call of its own
slot's kinds (`Matched`, `KindOf`). `runMeasured_kinds` / `runMeasured_calls_le`: the same at the
deployed run (typed by `invoke_never_stuck`, carried to data by `extract_conforms`), so a method
makes at most as many calls as it declares slots and never two from one slot.
`bodyOf_ok_of_total` is the identity-digest corollary.
-/
import Lang.Proofs.Call
import Lang.Proofs.Invoke

namespace Nanodregg.Lang

open Nanodregg.Kernel Nanodregg.Kernel.Receive

variable {D : Type} {digestOf : ByteArray → Option D} {d0 : Data}

/-- Digest leaf `b` sits in data `d` at label path `p` (a `bytes` leaf never does: since LANG-38
only a field typed `digest` can be refused as not a digest). Each record field on the way is named in
the path (`field`). A sum arm is either named (`arm`, as an account's `well` is) or passed over (`inj`,
as an option's `some`, a call's kind, an account's `of`). -/
inductive DigestAt (b : ByteArray) : List Label → Data → Prop
  | here : DigestAt b [] (.digest b)
  | inj {p : List Label} {ℓ : Label} {d : Data} : DigestAt b p d → DigestAt b p (.inj ℓ d)
  | arm {p : List Label} {ℓ : Label} {d : Data} : DigestAt b p d → DigestAt b (ℓ :: p) (.inj ℓ d)
  | field {p : List Label} {fs : List (Label × Data)} {ℓ : Label} {d : Data} :
      (ℓ, d) ∈ fs → DigestAt b p d → DigestAt b (ℓ :: p) (.record fs)

/-- `f` is how a refusal names label path `p`: its labels joined by `.` (`acct.owner`). -/
inductive Names : List Label → String → Prop
  | one (ℓ : Label) : Names [ℓ] ℓ
  | cons (ℓ : Label) {p : List Label} {f : String} : Names p f → Names (ℓ :: p) (ℓ ++ "." ++ f)

/-- Data `d` sits in `d0` at path `p`: every digest leaf of `d` is a leaf of `d0`, `p` deeper. -/
def Under (p : List Label) (d d0 : Data) : Prop := ∀ q b, DigestAt b q d → DigestAt b (p ++ q) d0

/-- Reading `d0` gives `x`, which fails, if at all, only because bytes of `d0` are refused by
`digestOf`, and the refusal names the path in `d0` whose digest leaf holds them. -/
def Live (digestOf : ByteArray → Option D) (d0 : Data) {α : Type} (x : Except String α) : Prop :=
  ∀ e, x = .error e → ∃ (p : List Label) (f : String) (b : ByteArray),
    digestOf b = none ∧ DigestAt b p d0 ∧ Names p f ∧ e = s!"{f}: not a digest"

theorem Live.lift {d0 d1 : Data} {α : Type} {x : Except String α} (hx : Live digestOf d0 x)
    (hs : ∀ p b, DigestAt b p d0 → DigestAt b p d1) : Live digestOf d1 x := by
  intro e h
  obtain ⟨p, f, b, hn, hb, hf, rfl⟩ := hx e h
  exact ⟨p, f, b, hn, hs p b hb, hf, rfl⟩

theorem under_field {ℓ : Label} {d : Data} {fs : List (Label × Data)} {k : Label} (hm : (ℓ, d) ∈ fs) :
    Under [ℓ] d (.inj k (.record fs)) := fun _ _ hb => .inj (.field hm hb)

theorem Under.some {p : List Label} {d d0 : Data} (h : Under p (.inj "some" d) d0) : Under p d d0 :=
  fun q b hb => h q b (.inj hb)

theorem Under.of {p : List Label} {ℓ : Label} {d d0 : Data} (h : Under p (.inj ℓ d) d0) :
    Under (p ++ [ℓ]) d d0 := fun q b hb => by simpa using h (ℓ :: q) b (.arm hb)

theorem Under.under {p : List Label} {ℓ ℓ' : Label} {fs : List (Label × Data)} {d d0 : Data}
    (h : Under p (.inj ℓ (.record fs)) d0) (hm : (ℓ', d) ∈ fs) : Under (p ++ [ℓ']) d d0 :=
  fun q b hb => by simpa using h (ℓ' :: q) b (.inj (.field hm hb))

theorem Live.pure {α : Type} (a : α) : Live digestOf d0 (Except.ok a : Except String α) := by
  intro e h; cases h

theorem Live.bind {α β : Type} {x : Except String α} {k : α → Except String β} (hx : Live digestOf d0 x)
    (hk : ∀ a, Live digestOf d0 (k a)) : Live digestOf d0 (x >>= k) := by
  intro e h
  cases hx' : x with
  | error e' =>
    rw [hx'] at h; cases h; exact hx _ hx'
  | ok a => rw [hx'] at h; exact hk a e h

theorem Live.map {α β : Type} {x : Except String α} (g : α → β) (hx : Live digestOf d0 x) : Live digestOf d0 (g <$> x) := by
  intro e h
  cases hx' : x with
  | error e' => rw [hx'] at h; simp only [Functor.map, Except.map] at h; cases h; exact hx _ hx'
  | ok a => rw [hx'] at h; simp [Functor.map, Except.map] at h

theorem Live.map' {α β : Type} {x : Except String α} (g : α → β) (hx : Live digestOf d0 x) : Live digestOf d0 (x.map g) := by
  intro e h
  cases hx' : x with
  | error e' => rw [hx'] at h; simp only [Except.map] at h; cases h; exact hx _ hx'
  | ok a => rw [hx'] at h; simp [Except.map] at h

theorem conf_bytes {d : Data} (h : Conforms d .bytes) : ∃ b, d = .bytes b := by cases h; exact ⟨_, rfl⟩

theorem conf_digestD {d : Data} (h : Conforms d .digest) : ∃ b, d = .digest b := by cases h; exact ⟨_, rfl⟩

theorem conf_nat {d : Data} (h : Conforms d .nat) : ∃ n, d = .nat n := by cases h; exact ⟨_, rfl⟩

theorem conf_unit {d : Data} (h : Conforms d (.record [])) : d = .record [] := by
  cases h with | record hr => cases hr; rfl

theorem conf_opt {d : Data} {T : Ty} (h : Conforms d (optTy T)) :
    d = .inj "none" (.record []) ∨ ∃ d', d = .inj "some" d' ∧ Conforms d' T := by
  cases h with
  | inj hf hd =>
    simp only [Row.find?] at hf
    split at hf
    · cases hf; subst_vars; exact .inl (by rw [conf_unit hd])
    · split at hf
      · cases hf; subst_vars; exact .inr ⟨_, rfl, hd⟩
      · cases hf

/-- A digest field named `f`, the name of its path `p` in `d0`, refuses only bytes at `p`. -/
theorem digest_live {d d0 : Data} {p : List Label} (f : String) (hf : Names p f) (h : Conforms d .digest)
    (hu : Under p d d0) : Live digestOf d0 (digestAt digestOf f d) := by
  obtain ⟨b, rfl⟩ := conf_digestD h
  intro e he
  simp only [digestAt] at he
  split at he
  · cases he
  · rename_i hn; cases he; exact ⟨p, f, b, hn, by simpa using hu [] b .here, hf, rfl⟩

theorem optDigest_live {d d0 : Data} {p : List Label} (f g : String) (hf : Names p f) (h : Conforms d (optTy .digest))
    (hu : Under p d d0) : Live digestOf d0 (optOf (digestAt digestOf f) g d) := by
  rcases conf_opt h with rfl | ⟨d', rfl, hd⟩
  · simp only [optOf]; exact Live.pure _
  · simp only [optOf]; exact Live.map' _ (digest_live f hf hd hu.some)

theorem optBytes_live {d : Data} (f g : String) (h : Conforms d (optTy .bytes)) :
    Live digestOf d0 (optOf (bytesAt f) g d) := by
  rcases conf_opt h with rfl | ⟨d', rfl, hd⟩
  · simp only [optOf]; exact Live.pure _
  · obtain ⟨b, rfl⟩ := conf_bytes hd; simp only [optOf, bytesAt]; exact Live.map' _ (Live.pure _)

theorem natOf_live {d : Data} (f : String) (h : Conforms d .nat) : Live digestOf d0 (natOf f d) := by
  obtain ⟨n, rfl⟩ := conf_nat h; exact Live.pure _

theorem bytesAt_live {d : Data} (f : String) (h : Conforms d .bytes) : Live digestOf d0 (bytesAt f d) := by
  obtain ⟨b, rfl⟩ := conf_bytes h; exact Live.pure _

theorem names_dot {f g s : String} (hs : s = f ++ "." ++ g) : Names ([f] ++ [g]) s :=
  hs ▸ .cons f (.one g)

/-- An account named `f` (at path `[f]` in `d0`) refuses only bytes at `f.owner`, `f.asset` or
`f.well`, named so. -/
theorem acctRef_live {d d0 : Data} (f : String) (h : Conforms d acctRefTy) (hu : Under [f] d d0) :
    Live digestOf d0 (acctRefOf digestOf f d) := by
  cases h with
  | inj hf hd =>
    simp only [Row.find?] at hf
    split at hf
    · cases hf; subst_vars
      cases hd with
      | record hr =>
        cases hr with
        | cons ha hr =>
          cases hr with
          | cons ho hr =>
            cases hr
            simp only [acctRefOf]
            exact Live.bind (digest_live _ (names_dot (g := "owner") (by simp only [toString, String.append_assoc]; rfl)) ho (hu.under (by simp))) fun _ =>
              Live.bind (digest_live _ (names_dot (g := "asset") (by simp only [toString, String.append_assoc]; rfl)) ha (hu.under (by simp))) fun _ => Live.pure _
    · split at hf
      · cases hf; subst_vars
        simp only [acctRefOf]; exact Live.map' _ (digest_live _ (names_dot (g := "well") (by simp only [toString, String.append_assoc]; rfl)) hd hu.of)
      · cases hf

theorem right_ok {d : Data} (h : Conforms d rightTy) : ∃ r, rightOf d = .ok r := by
  cases h with
  | inj hf hd =>
    simp only [Row.find?] at hf
    repeat' split at hf
    all_goals first | cases hf | skip
    all_goals subst_vars
    · obtain ⟨n, rfl⟩ := conf_nat hd; exact ⟨_, rfl⟩
    · obtain ⟨n, rfl⟩ := conf_nat hd; exact ⟨_, rfl⟩
    · obtain ⟨n, rfl⟩ := conf_nat hd; exact ⟨_, rfl⟩
    · rw [conf_unit hd]; exact ⟨_, rfl⟩
    · rw [conf_unit hd]; exact ⟨_, rfl⟩
    · obtain ⟨n, rfl⟩ := conf_nat hd; exact ⟨_, rfl⟩

theorem rights_live : ∀ {rs : List (Label × Data)} {ls : List Label},
    RowConforms rs (ls.map fun l => (l, optTy rightTy)) → Live digestOf d0 (rightsOf rs)
  | [], _, _ => Live.pure _
  | (_, o) :: rs, [], h => by cases h
  | (_, o) :: rs, l :: ls, h => by
    cases h with
    | cons ho hr =>
      simp only [rightsOf]
      refine Live.bind ?_ fun _ => Live.bind (rights_live hr) fun _ => Live.pure _
      rcases conf_opt ho with rfl | ⟨d', rfl, hd⟩
      · simp only [optOf]; exact Live.pure _
      · obtain ⟨r, hr⟩ := right_ok hd; simp only [optOf, hr]; exact Live.map' _ (Live.pure _)

theorem rowConforms_length : ∀ {ds : List (Label × Data)} {r : List (Label × Ty)}, RowConforms ds r →
    ds.length = r.length
  | _, _, .nil => rfl
  | _, _, .cons _ h => by simp [rowConforms_length h]

/-- **Liveness**: data conforming to `callTy` reads as a Body, unless some field's bytes are not a
digest (`bodyOf`'s only refusal the type does not rule out). -/
theorem bodyOf_live {d : Data} (h : Conforms d callTy) : Live digestOf d (bodyOf digestOf d) := by
  cases h with
  | inj hf hd =>
    simp only [callArms, Row.find?] at hf
    split at hf
    · cases hf; subst_vars
      cases hd with | record hr => cases hr with | cons h1 hr => cases hr with | cons h2 hr =>
      cases hr
      simp only [bodyOf]
      exact Live.bind (digest_live _ (.one _) h1 (under_field (by simp))) fun _ => Live.bind (digest_live _ (.one _) h2 (under_field (by simp))) fun _ => Live.pure _
    split at hf
    · cases hf; subst_vars
      cases hd with | record hr => cases hr with | cons h1 hr => cases hr with | cons h2 hr =>
      cases hr with | cons h3 hr => cases hr with | cons h4 hr =>
      cases hr
      simp only [bodyOf]
      exact Live.bind (digest_live _ (.one _) h4 (under_field (by simp))) fun _ => Live.bind (acctRef_live _ h1 (under_field (by simp))) fun _ =>
        Live.bind (natOf_live _ h2) fun _ => Live.bind (optDigest_live _ _ (.one _) h3 (under_field (by simp))) fun _ => Live.pure _
    split at hf
    · cases hf; subst_vars
      cases hd with | record hr => cases hr with | cons h1 hr => cases hr with | cons h2 hr =>
      cases hr with | cons h3 hr => cases hr with | cons h4 hr =>
      cases hr
      cases h3 with
      | record hrs =>
        have hlen := rowConforms_length hrs
        simp only [List.length_map, rightLabels, slotLabels, List.length_range] at hlen
        simp only [bodyOf, hlen, rightsMax, Nat.le_refl, if_true]
        exact Live.bind (digest_live _ (.one _) h4 (under_field (by simp))) fun _ => Live.bind (digest_live _ (.one _) h1 (under_field (by simp))) fun _ =>
          Live.bind (rights_live hrs) fun _ => Live.bind (optDigest_live _ _ (.one _) h2 (under_field (by simp))) fun _ => Live.pure _
    split at hf
    · cases hf; subst_vars
      cases hd with | record hr => cases hr with | cons h1 hr => cases hr with | cons h2 hr =>
      cases hr with | cons h3 hr => cases hr with | cons h4 hr => cases hr with | cons h5 hr =>
      cases hr
      simp only [bodyOf]
      exact Live.bind (digest_live _ (.one _) h4 (under_field (by simp))) fun _ => Live.bind (natOf_live _ h3) fun _ =>
        Live.bind (bytesAt_live _ h1) fun _ => Live.bind (natOf_live _ h2) fun _ =>
        Live.bind (optDigest_live _ _ (.one _) h5 (under_field (by simp))) fun _ => Live.pure _
    split at hf
    · cases hf; subst_vars
      cases hd with | record hr => cases hr with | cons h1 hr => cases hr with | cons h2 hr =>
      cases hr with | cons h3 hr => cases hr with | cons h4 hr => cases hr with | cons h5 hr =>
      cases hr
      simp only [bodyOf]
      exact Live.bind (acctRef_live _ h4 (under_field (by simp))) fun _ => Live.bind (acctRef_live _ h2 (under_field (by simp))) fun _ =>
        Live.bind (natOf_live _ h1) fun _ => Live.bind (optDigest_live _ _ (.one _) h5 (under_field (by simp))) fun _ =>
        Live.bind (optBytes_live _ _ h3) fun _ => Live.pure _
    cases hf

/-- The identity-digest corollary (no real digest codec is total; `bodyOf_live` is the statement):
under a decoder that accepts every byte string, conforming call data always reads. -/
theorem bodyOf_ok_of_total (htot : ∀ b, (digestOf b).isSome = true) {d : Data} (h : Conforms d callTy) :
    ∃ b : Body D, bodyOf digestOf d = .ok b := by
  cases hb : bodyOf digestOf d with
  | ok b => exact ⟨b, rfl⟩
  | error e =>
    obtain ⟨_, _, b, hn, -, -, -⟩ := bodyOf_live h e hb
    have := htot b
    rw [hn] at this; cases this

/-! ## Extraction: a typed value extracts to data of its type -/

section
variable {Δ : List Ty}

theorem force_typed {m : Machine} (hlib : LibTy Δ m.lib) {fuel : Nat} {t : Term} {env : Env} {Γ : List Ty} {A : Ty}
    {v : Val} {f : Nat} (he : EnvTy Δ env Γ) (ht : HasType Δ Γ t A) (h : m.force fuel t env = .ok (v, f)) :
    ValTy Δ v A := by
  unfold Machine.force at h
  have hr := run_sound (cap := Bounds.stackMax) hlib fuel 0 (State.init t env) (.eval he ht .nil)
  split at h
  · rename_i v' used hv
    rw [hv] at hr
    cases h
    exact hr
  · cases h

theorem unknot_typed {m : Machine} (hlib : LibTy Δ m.lib) : ∀ {rounds fuel : Nat} {v : Val} {r : List (Label × Ty)}
    {fs : List (Label × (Term × Env))} {f : Nat}, ValTy Δ v (.record r) → m.unknot rounds fuel v = .ok (fs, f) →
    ThunksTy Δ fs r
  | rounds, fuel, .record fs', r, fs, f, hv, h => by
    cases hv with
    | record ht => simp only [Machine.unknot] at h; cases h; exact ht
  | 0, fuel, .knot b env, r, fs, f, _, h => by simp [Machine.unknot] at h
  | k + 1, fuel, .knot b env, r, fs, f, hv, h => by
    cases hv with
    | knot he hb =>
      simp only [Machine.unknot] at h
      split at h
      · rename_i v' fuel' hf
        exact unknot_typed hlib (force_typed hlib (.cons (.knot he hb) he) hb hf) h
      · cases h
  | _, _, .nat _, _, _, _, hv, _ => by cases hv
  | _, _, .bool _, _, _, _, hv, _ => by cases hv
  | _, _, .bytes _, _, _, _, hv, _ => by cases hv
  | _, _, .digest _, _, _, _, hv, _ => by cases hv
  | _, _, .clo _ _, _, _, _, hv, _ => by cases hv
  | _, _, .inj _ _, _, _, _, hv, _ => by cases hv

mutual
theorem extract_conforms {m : Machine} (hlib : LibTy Δ m.lib) : ∀ (T : Ty) {fuel : Nat} {v : Val} {d : Data} {f : Nat},
    ValTy Δ v T → m.extract T fuel v = .ok (d, f) → Conforms d T
  | .nat, _, _, _, _, hv, h => by
    cases hv with | nat hn => simp only [Machine.extract] at h; cases h; exact .nat hn
  | .bool, _, _, _, _, hv, h => by
    cases hv with | bool => simp only [Machine.extract] at h; cases h; exact .bool
  | .bytes, _, _, _, _, hv, h => by
    cases hv with | bytes hn => simp only [Machine.extract] at h; cases h; exact .bytes hn
  | .digest, _, _, _, _, hv, h => by
    cases hv with | digest hn => simp only [Machine.extract] at h; cases h; exact .digest hn
  | .fn _ _, _, v, _, _, _, h => by cases v <;> simp [Machine.extract] at h
  | .record row, _, _, _, _, hv, h => by
    simp only [Machine.extract] at h
    split at h
    · rename_i fs fuel' hu
      split at h
      · rename_i ds fuel'' hr
        cases h
        exact .record (extractRow_conforms hlib row (unknot_typed hlib hv hu) hr)
      · cases h
    · cases h
  | .sum row, _, v, _, _, hv, h => by
    cases hv with
    | inj hf hw =>
      simp only [Machine.extract] at h
      split at h
      · rename_i d' fuel' ha
        cases h
        exact .inj hf (extractArm_conforms hlib row hf hw ha)
      · cases h

theorem extractArm_conforms {m : Machine} (hlib : LibTy Δ m.lib) : ∀ (row : List (Label × Ty)) {ℓ : Label} {A : Ty}
    {fuel : Nat} {w : Val} {d : Data} {f : Nat}, Row.find? ℓ row = some A → ValTy Δ w A →
    m.extractArm row ℓ fuel w = .ok (d, f) → Conforms d A
  | [], _, _, _, _, _, _, hf, _, _ => by cases hf
  | (k, B) :: row, ℓ, A, _, _, _, _, hf, hw, h => by
    simp only [Machine.extractArm] at h
    simp only [Row.find?] at hf
    split at h
    · rename_i hk
      rw [if_pos hk] at hf; cases hf
      exact extract_conforms hlib B hw h
    · rename_i hk
      rw [if_neg hk] at hf
      exact extractArm_conforms hlib row hf hw h

theorem extractRow_conforms {m : Machine} (hlib : LibTy Δ m.lib) : ∀ (row : List (Label × Ty)) {fuel : Nat}
    {fs : List (Label × (Term × Env))} {ds : List (Label × Data)} {f : Nat},
    ThunksTy Δ fs row → m.extractRow row fuel fs = .ok (ds, f) → RowConforms ds row
  | [], _, _, _, _, ht, h => by
    cases ht; simp only [Machine.extractRow] at h; cases h; exact .nil
  | (ℓ, A) :: row, _, _, _, _, ht, h => by
    cases ht with
    | cons he htm hrest =>
      simp only [Machine.extractRow, if_true] at h
      split at h
      · rename_i v fuel' hfo
        split at h
        · rename_i d fuel'' hx
          split at h
          · rename_i ds' f' hr
            cases h
            exact .cons (extract_conforms hlib A (force_typed hlib he htm hfo) hx)
              (extractRow_conforms hlib row hrest hr)
          · cases h
        · cases h
      · cases h
end
end

/-! ## Call slots: a slot's value is a call of one of the slot's arms -/

theorem find?_mem {α : Type} : ∀ {r : List (Label × α)} {ℓ : Label} {a : α}, Row.find? ℓ r = some a → (ℓ, a) ∈ r
  | [], _, _, h => by cases h
  | (k, b) :: r, ℓ, a, h => by
    simp only [Row.find?] at h
    split at h
    · rename_i hk; cases h; subst hk; exact List.mem_cons_self ..
    · exact List.mem_cons_of_mem _ (find?_mem h)

/-- A value of a call slot's type is a value of `callTy`, injected at one of the slot's arms. -/
theorem slot_conforms {T : Ty} {d : Data} (hT : callSlotOk T = true) (h : Conforms d T) :
    Conforms d callTy ∧ ∃ arms ℓ d', T = .sum arms ∧ d = .inj ℓ d' ∧ ℓ ∈ arms.map Prod.fst := by
  cases T with
  | sum arms =>
    cases h with
    | inj hf hd =>
      simp only [callSlotOk, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at hT
      have hm := find?_mem hf
      exact ⟨.inj (hT.2 _ hm) hd, arms, _, _, rfl, rfl, List.mem_map.2 ⟨_, hm, rfl⟩⟩
  | _ => simp [callSlotOk] at hT

/-- The Body read from call data is of the kind its arm names. -/
theorem bodyOf_kind {d : Data} {b : Body D} (h : bodyOf digestOf d = .ok b) : ∃ d', d = .inj b.kindName d' := by
  unfold bodyOf at h
  split at h
  all_goals try simp only [bind, Except.bind, pure, Except.pure] at h
  all_goals (repeat' split at h)
  all_goals first | (simp at h; done) | (cases h; exact ⟨_, rfl⟩)

/-- Two lists matched one to one, in order, by `R`. -/
inductive Matched {α β : Type} (R : α → β → Prop) : List α → List β → Prop
  | nil : Matched R [] []
  | cons {a : α} {b : β} {as : List α} {bs : List β} : R a b → Matched R as bs → Matched R (a :: as) (b :: bs)

theorem Matched.length_eq {α β : Type} {R : α → β → Prop} : ∀ {as : List α} {bs : List β}, Matched R as bs →
    as.length = bs.length
  | _, _, .nil => rfl
  | _, _, .cons _ h => by simp [h.length_eq]

theorem Matched.mem_left {α β : Type} {R : α → β → Prop} : ∀ {as : List α} {bs : List β}, Matched R as bs →
    ∀ a ∈ as, ∃ b ∈ bs, R a b
  | _, _, .nil, _, ha => by cases ha
  | _, _, .cons hr h, a, ha => by
    cases ha with
    | head => exact ⟨_, List.mem_cons_self .., hr⟩
    | tail _ ha => obtain ⟨b, hb, hab⟩ := h.mem_left a ha; exact ⟨b, List.mem_cons_of_mem _ hb, hab⟩

theorem Matched.map_right {α β γ : Type} {R : α → β → Prop} {S : α → γ → Prop} {f : γ → β}
    (hRS : ∀ a c, R a (f c) → S a c) : ∀ {as : List α} {cs : List γ}, Matched R as (cs.map f) → Matched S as cs
  | [], [], _ => .nil
  | [], _ :: _, h => by cases h
  | _ :: _, [], h => by cases h
  | _ :: _, _ :: _, h => by
    cases h with
    | cons hr h => exact .cons (hRS _ _ hr) (Matched.map_right hRS h)

/-- Call `b` is of a kind slot type `t` declares (`t = optTy (sum arms)`, `b`'s kind an arm). -/
def KindOf (b : Body D) (t : Ty) : Prop := ∃ arms, t = optTy (.sum arms) ∧ b.kindName ∈ arms.map Prod.fst

/-- A calls row's slots: each an option over a call slot type. -/
def SlotRow (r : List (Label × Ty)) : Prop := ∀ p ∈ r, ∃ k, p.2 = optTy k ∧ callSlotOk k = true

/-- The refusal `callsOf` gives reading calls data `c` when slot `ℓ` holds, at path `p` in its
call, bytes the digest decoder refuses: the slot and the path by name. -/
def DigestRefusal (digestOf : ByteArray → Option D) (c : Data) (e : Refusal D) : Prop :=
  ∃ (ℓ : Label) (p : List Label) (f : String) (b : ByteArray), digestOf b = none ∧ DigestAt b (ℓ :: p) c ∧
    Names p f ∧ e = .program s!"calls: {ℓ} {s!"{f}: not a digest"}"

theorem callsOf_go_live : ∀ {fs : List (Label × Data)} {r : List (Label × Ty)}, RowConforms fs r → SlotRow r →
    ∀ e, callsOf.go digestOf fs = .error e → DigestRefusal digestOf (.record fs) e
  | _, _, .nil, _, e, h => by simp [callsOf.go] at h
  | _, _, .cons (ℓ := ℓ) (d := d) (ds := ds) ho hr, hs, e, h => by
    obtain ⟨k, hk, hok⟩ := hs _ (List.mem_cons_self ..)
    have hs' : SlotRow _ := fun p hp => hs p (List.mem_cons_of_mem _ hp)
    have tail : ∀ e, callsOf.go digestOf ds = .error e → DigestRefusal digestOf (.record ((ℓ, d) :: ds)) e := by
      intro e he
      obtain ⟨ℓ', p, f, b, hn, hb, hf, rfl⟩ := callsOf_go_live hr hs' e he
      cases hb with
      | field hm hb' => exact ⟨ℓ', p, f, b, hn, .field (List.mem_cons_of_mem _ hm) hb', hf, rfl⟩
    simp only at hk; subst hk
    rcases conf_opt ho with rfl | ⟨d', rfl, hd⟩
    · simp only [callsOf.go] at h; exact tail e h
    · simp only [callsOf.go] at h
      split at h
      · rename_i b hb
        cases hg : callsOf.go digestOf ds with
        | error e' => rw [hg] at h; cases h; exact tail _ hg
        | ok bs => rw [hg] at h; cases h
      · rename_i m hm
        cases h
        obtain ⟨p, f, b, hn, hb, hf, rfl⟩ := bodyOf_live (slot_conforms hok hd).1 m hm
        exact ⟨ℓ, p, f, b, hn, .field (List.mem_cons_self ..) (.inj hb), hf, rfl⟩

/-- **The calls a conforming row reads are its filled slots, in order, each of its own slot's
kinds**: a sublist of the row's slot types, matched one to one. So no slot yields two calls, and a
method makes at most as many calls as it has slots. -/
theorem callsOf_go_kinds : ∀ {fs : List (Label × Data)} {r : List (Label × Ty)} {bs : List (Body D)},
    RowConforms fs r → SlotRow r → callsOf.go digestOf fs = .ok bs →
    ∃ ts, ts.Sublist (r.map Prod.snd) ∧ Matched KindOf bs ts
  | _, _, bs, .nil, _, h => by simp [callsOf.go] at h; subst h; exact ⟨[], .slnil, .nil⟩
  | _, _, bs, .cons (ℓ := ℓ) (T := T) (ds := ds) (r := r) ho hr, hs, h => by
    obtain ⟨k, hk, hok⟩ := hs _ (List.mem_cons_self ..)
    have hs' : SlotRow _ := fun p hp => hs p (List.mem_cons_of_mem _ hp)
    simp only at hk; subst hk
    rcases conf_opt ho with rfl | ⟨d', rfl, hd⟩
    · simp only [callsOf.go] at h
      obtain ⟨ts, hts, hf⟩ := callsOf_go_kinds hr hs' h
      exact ⟨ts, hts.cons _, hf⟩
    · simp only [callsOf.go] at h
      split at h
      · rename_i b hb
        cases hg : callsOf.go digestOf ds with
        | error e' => rw [hg] at h; cases h
        | ok bs' =>
          rw [hg] at h; cases h
          obtain ⟨ts, hts, hf⟩ := callsOf_go_kinds hr hs' hg
          obtain ⟨-, arms, ℓ', d'', hT, hdd, hmem⟩ := slot_conforms hok hd
          obtain ⟨d3, hd3⟩ := bodyOf_kind hb
          rw [hdd] at hd3; cases hd3
          exact ⟨optTy k :: ts, hts.cons_cons _, .cons ⟨arms, by rw [hT], hmem⟩ hf⟩
      · cases h

theorem slotRow_callsTy {ks : List Ty} (hks : ∀ k ∈ ks, callSlotOk k = true) :
    SlotRow ((slotLabels "c" ks.length).zip (ks.map optTy)) := by
  intro p hp
  obtain ⟨-, h2⟩ := List.of_mem_zip hp
  obtain ⟨k, hk, he⟩ := List.mem_map.1 h2
  exact ⟨k, he.symm, hks k hk⟩

/-- **Liveness of a calls row**: data conforming to `callsTy ks` over call slot types is refused by
`callsOf` only for a slot field whose bytes are not a digest, named `calls: cI FIELD`. -/
theorem callsOf_live {ks : List Ty} {c : Data} (hks : ∀ k ∈ ks, callSlotOk k = true) (h : Conforms c (callsTy ks))
    (e : Refusal D) (he : callsOf digestOf c = .error e) : DigestRefusal digestOf c e := by
  cases h with
  | record hr => exact callsOf_go_live hr (slotRow_callsTy hks) e he

theorem callSlotsOf_ok : ∀ {row : List (Label × Ty)} {ks : List Ty},
    row.mapM (fun e => callSlotOf e.2) = some ks → ∀ k ∈ ks, callSlotOk k = true
  | [], ks, h => by simp at h; subst h; simp
  | (l, t) :: row, ks, h => by
    simp only [List.mapM_cons, bind, Option.bind_eq_some_iff, pure, Option.some.injEq] at h
    obtain ⟨T, hT, ks', hks', rfl⟩ := h
    intro k hk
    cases hk with
    | head =>
      unfold callSlotOf at hT
      split at hT
      · split at hT
        · rename_i hok; cases hT; exact hok
        · cases hT
      · cases hT
    | tail _ hk => exact callSlotsOf_ok hks' k hk

theorem methodSig_slots {S t : Ty} {rels : List (Label × RelDecl)} {sg : Sig}
    (h : methodSig S rels t = some sg) : ∀ k ∈ sg.calls, callSlotOk k = true := by
  unfold methodSig at h
  split at h
  · split at h
    · split at h
      · rename_i ks es rs hks hes hrs
        cases h
        unfold callSlotsOf at hks
        split at hks
        · exact callSlotsOf_ok hks
        · cases hks
      · cases h
    · cases h
  · cases h

theorem resolveMethod_spec {p : Package} {method : Nat} {ℓ : Label} {sg : Sig}
    (h : resolveMethod (D := D) p method = .ok (ℓ, sg)) :
    ∃ mty, Row.find? ℓ (recordRow p.iface) = some mty ∧ methodSig p.state p.rels mty = some sg := by
  unfold resolveMethod at h
  simp only [pure, Except.pure] at h
  repeat' split at h
  all_goals first | (simp at h; done) | skip
  simp only [Except.ok.injEq, Prod.mk.injEq] at h
  obtain ⟨rfl, rfl⟩ := h
  exact ⟨_, by assumption, by assumption⟩

/-! ## The deployed run -/

theorem sublist_map_inv {α β : Type} {f : α → β} : ∀ {l : List β} {l2 : List α}, l.Sublist (l2.map f) →
    ∃ l' : List α, l'.Sublist l2 ∧ l = l'.map f
  | l, [], h => by simp only [List.map_nil, List.sublist_nil] at h; subst h; exact ⟨[], .slnil, rfl⟩
  | l, a :: l2, h => by
    simp only [List.map_cons] at h
    cases h with
    | cons _ h => obtain ⟨l', h1, rfl⟩ := sublist_map_inv h; exact ⟨l', h1.cons _, rfl⟩
    | cons_cons _ h => obtain ⟨l', h1, rfl⟩ := sublist_map_inv h; exact ⟨a :: l', h1.cons_cons _, rfl⟩

/-- **Each call a method makes is in its own declared slot**: the calls of the deployed run match,
in order and one to one, a sublist of the resolved method's call slot types, each call of a kind
its slot names. So a method makes at most as many calls as it declares slots, and never two from
one slot (the run's result is typed by `invoke_never_stuck`, the calls row conforms by
`extract_conforms`, and `callsOf_go_kinds` reads it). Exercised with calls by journey LC0–LC4 and LC6. -/
theorem runMeasured_kinds {bytesOf : D → ByteArray}
    {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat} {args : ByteArray}
    {r : Req D} {budget : Nat} {s : Slots} {calls : List (Body D)} {rows : List (RowSlot D × RowAct)}
    {t n : Nat}
    (h : runMeasured bytesOf digestOf look rv pkg state method args r budget = .ok (s, calls, rows, t, n)) :
    ∃ (ℓ : Label) (sg : Sig) (L : Loaded) (g : Nat) (p : Package),
      load digestOf look closureDepthMax (bytesOf pkg) ⟨[], [], []⟩ = .ok (L, g) ∧ L.pkgs[g]? = some p ∧
      resolveMethod (D := D) p method = .ok (ℓ, sg) ∧
      ∃ ks', ks'.Sublist sg.calls ∧
        Matched (fun b k => ∃ arms, k = .sum arms ∧ b.kindName ∈ arms.map Prod.fst) calls ks' := by
  unfold runMeasured runMeasuredWith at h
  simp only [bind, Except.bind, pure, Except.pure] at h
  split at h
  · cases h
  rename_i S hS
  obtain ⟨L, g, p, ℓ, sg, sd, ad, wd, hr0, hl, hp, hres, hst, hargs, -, hrows, rfl⟩ := runSetup_spec hS
  simp only at h
  repeat' split at h
  all_goals first | (simp at h; done) | skip
  simp only [Except.ok.injEq, Prod.mk.injEq] at h
  obtain ⟨-, rfl, -, -, -⟩ := h
  obtain ⟨mty, hm, hA⟩ := resolveMethod_spec hres
  have hok := invoke_never_stuck (ticks := budget) hl hp hm hA hst hargs hrows hr0
  rw [‹run _ _ _ _ _ = .value _ _›] at hok
  have hcf := extract_conforms (load_libTy hl).1 _ hok ‹(Machine.mk _).extract _ _ _ = Except.ok _›
  have hks := methodSig_slots hA
  refine ⟨ℓ, sg, L, g, p, hl, hp, hres, ?_⟩
  cases hcf with
  | record hrow =>
    cases hrow with
    | cons hcalls _ =>
      cases hcalls with
      | record hcs =>
        obtain ⟨ts, hts, hf⟩ := callsOf_go_kinds hcs (slotRow_callsTy hks) ‹callsOf.go _ _ = Except.ok _›
        have hsnd : ((slotLabels "c" sg.calls.length).zip (sg.calls.map optTy)).map Prod.snd = sg.calls.map optTy :=
          List.map_snd_zip (by simp [slotLabels])
        rw [hsnd] at hts
        obtain ⟨ks', hks', rfl⟩ := sublist_map_inv hts
        refine ⟨ks', hks', ?_⟩
        refine Matched.map_right (fun b k hk => ?_) hf
        obtain ⟨arms, he, hmem⟩ := hk
        simp only [optTy, Ty.sum.injEq, List.cons.injEq, Prod.mk.injEq, true_and, and_true] at he
        exact ⟨arms, he, hmem⟩

/-- A run makes at most as many calls as the resolved method declares slots. -/
theorem runMeasured_calls_le {bytesOf : D → ByteArray}
    {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat} {args : ByteArray}
    {r : Req D} {budget : Nat} {s : Slots} {calls : List (Body D)} {rows : List (RowSlot D × RowAct)}
    {t n : Nat}
    (h : runMeasured bytesOf digestOf look rv pkg state method args r budget = .ok (s, calls, rows, t, n)) :
    ∃ (ℓ : Label) (sg : Sig) (L : Loaded) (g : Nat) (p : Package),
      load digestOf look closureDepthMax (bytesOf pkg) ⟨[], [], []⟩ = .ok (L, g) ∧ L.pkgs[g]? = some p ∧
      resolveMethod (D := D) p method = .ok (ℓ, sg) ∧ calls.length ≤ sg.calls.length := by
  obtain ⟨ℓ, sg, L, g, p, hl, hp, hres, ks', hsub, hf⟩ := runMeasured_kinds h
  exact ⟨ℓ, sg, L, g, p, hl, hp, hres, hf.length_eq ▸ hsub.length_le⟩

end Nanodregg.Lang


/-
# Kernel.Proofs.Logic.History — a World's history around one object, lifted once to every law (KERNEL-28, Q3)

`Lang.Proofs.Chain` lifts ONE law's admitted steps to a history (`Std.Chain`, its schemes). This
module is the kernel's half: what the World does around one object is a chain of steps each law in
force admitted, for every body kind, proved once.

* `ObjectStep X obj w w' e`: one step of the World from `w` to `w'`, as `obj` sees it. Steps that
  leave `obj` alone record nothing (`e = none`): a recorded refusal (`refusal`), an admitted turn
  that touches it nowhere and does not bear it (`other`, any turn), a call-derived turn whose
  footprint does not hold it (`frame`, by `CallFoot`), a call-derived turn that pins it, keeps it,
  and neither writes it, changes its laws, nor dispatched any invoke of it (`keep`). So a step that
  invoked the object is never filed as one that left it alone, even when its run kept the state:
  an invoke's own effect is a touch of the object (`other`, `frame` exclude it) and `keep` says
  "no invoke" outright; a history counts every invoke it holds. Steps that judge it record what the judge saw (`e = some (look, pkg,
  laws, req, old, new, calls)`): the signed `write` of it (over a canonical cell), the signed `law`
  of it (the `relaw` judgement, over the unchanged state), the signed `invoke` of it, and an invoke
  of it NESTED in another call's tree (`Dispatched`; the order laws are its route's price).
* `ObjectHistory X obj w w' tr`: the Kleene star; `tr` is the judged steps, in order.
* `object_step_none`, `object_step_some`: a step that records nothing keeps `obj`'s entry; a
  judged step's `old` is the live state, the laws in force passed `old → new` (`write_judged`,
  `law_judged`, `invoke_next_judged`, `invoke_tree_slots`), and the next live state reads `new` at
  every key (`write_next_slots`, `law_next_slots`, `invoke_next_slots`, `invoke_tree_slots`).
* `object_history_of_audit`: THE TOTALITY at the log: an audited log from a canonical World
  (`CellsCanon`, from genesis by `genesis_cellsCanon`/`audit_cellsCanon`) is an `ObjectHistory` of
  every object live at its start (`object_turn_cases` per turn: no receiver but write, law and
  invoke writes an object). For an object born inside the log, split the log at its birth (the
  object must be live at the history's start).
* `object_history_chain`: THE LIFT: for a `NoRef` law `t` (field `ℓ` of the package `p` that the law
  id reads as in every judged step's view) in force at every judged step, the history projects to
  `Std.Chain (Std.Step [] t)` from the object's state, step for step (`judgeOne_admits_relib`; a
  `relaw` keeps the state, so each step is a `Step`, not only an `Admits`).

The polarity (PROOF-ENGINEERING Q3): wp over the fold (a step is "if it committed then"), sp over
the law (`Std.Admits` stays existential; a faulting law has no derivation, so no step).
Teeth (`Kernel.Proofs.Logic.HistoryWitness`): `object_history_chain_witnessed` (every premise of
the lift holds together, through `Lang.program`, on a signed invoke whose run moves the state, with
the counter's `NoRef` law in force); `write_history_witnessed` (a write step, at a data object);
`object_history_needs_inForce` (on that write history, whose step no law judged, a law that admits
nothing has no chain: drop the in-force premise and the conclusion is false); the steps' own: `write_needs_canon` (`write`'s canonicity),
`law_slots_need_bound`, `effect_at_object_needs_kind` (the totality), `effectsPinned_unlawful_ord`
(`nested`'s order laws). `object_history_runs`: each judged step's calls are its run's;
`object_history_start`: a history with a judged step starts at a live object whose state reads.
-/
import Kernel.Proofs.WriteNext
import Kernel.Proofs.InvokeTree
import Kernel.Proofs.Logic.Triple
import Lang.Proofs.Chain
import Lang.Proofs.Extract
import Lang.Proofs.Invoke

namespace Nanodregg.Kernel.Receive

open Nanodregg.Kernel

variable {D : Type} [Ord D] [DecidableEq D]

/-- **One step of the World around `obj`.** `none`: the step leaves `obj` alone; `some (look, pkg,
laws, req, old, new, calls)`: the step judged `obj`'s state `old → new` under `req`, in the view
`look`, by the package `pkg` (an invoke's) and the laws `laws` (the cell's), and returned `calls`
(an invoke's; `[]` for a write or a law). -/
inductive ObjectStep (X : Ctx D) (obj : D) :
    World D → World D → Option (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D)) → Prop
  | refusal {w w' : World D} {r : Refused D} : World.refuse X.env w r = .ok w' → ObjectStep X obj w w' none
  | other {w w' : World D} {t : Turn D} :
      World.admit X.env w t = .ok w' → (∀ x ∈ t.touches, x.cell ≠ obj) → obj ∉ createdIds t →
      ObjectStep X obj w w' none
  | keep {w w' : World D} {c : Call D} {t : Turn D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' →
      (∀ x ∈ t.touches, x.cell = obj → x.act = .keep) → obj ∉ createdIds t →
      (∀ edits via, c.unsigned.body ≠ .write obj edits via) → (∀ laws via, c.unsigned.body ≠ .law obj laws via) →
      (∀ n wk actor method args budget via, ¬ Dispatched X w c n wk actor (.invoke obj method args budget via)) →
      ObjectStep X obj w w' none
  | frame {w w' : World D} {c : Call D} {t : Turn D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' → ¬ CallFoot X c w (.cell obj) →
      ObjectStep X obj w w' none
  | write {w w' : World D} {c : Call D} {t : Turn D} {edits : List (Nat × Option ByteArray)} {via : Option D}
      {cell : Cell} {principal : D} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' → c.unsigned.body = .write obj edits via →
      w.live X.env obj = some cell → Slots.ascending cell.slots = true →
      ownerAuthority X (pinned X.env w c.unsigned.pins) c.unsigned.member obj cell .mutate via = .ok principal →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, none, laws,
        reqOf c.unsigned obj principal .write, stateOf cell, applyEdits (stateOf cell) edits, []))
  | law {w w' : World D} {c : Call D} {t : Turn D} {laws' : List D} {via : Option D}
      {cell : Cell} {principal : D} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' → c.unsigned.body = .law obj laws' via →
      w.live X.env obj = some cell →
      ownerAuthority X (pinned X.env w c.unsigned.pins) c.unsigned.member obj cell .mutate via = .ok principal →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, none, laws,
        reqOf c.unsigned obj principal (.relaw laws'), stateOf cell, stateOf cell, []))
  | invoke {w w' : World D} {c : Call D} {t : Turn D} {method : Nat} {args : ByteArray} {budget : Nat}
      {via : Option D} {cell : Cell} {p : D} {r : Req D} {s : Slots} {calls : List (Body D)}
      {rows : List (RowSlot D × RowAct)} {used : Nat} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' →
      c.unsigned.body = .invoke obj method args budget via →
      invokeRun X (pinned X.env w c.unsigned.pins) c c.unsigned.member obj method via = .ok (cell, p, r) →
      X.program.run (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) p (stateOf cell)
        method args r (min budget (poolOf c.unsigned.body)) = .ok (s, calls, rows, used) →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, some p, laws, r, stateOf cell, s, calls))
  | nested [Std.TransOrd D] [Std.LawfulEqOrd D] {w w' : World D} {c : Call D} {t : Turn D} {n : Nat}
      {wk : Walk D} {actor : D} {method : Nat} {args : ByteArray} {budget : Nat}
      {via : Option D} {cell : Cell} {p : D} {r : Req D} {s : Slots} {calls : List (Body D)}
      {rows : List (RowSlot D × RowAct)} {used : Nat} {laws : List D} :
      receive X w c = .ok t → World.admit X.env w t = .ok w' →
      Dispatched X w c n wk actor (.invoke obj method args budget via) →
      invokeRun X (pinned X.env w c.unsigned.pins) c actor obj method via = .ok (cell, p, r) →
      X.program.run (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) p (stateOf cell)
        method args r (min budget wk.pool) = .ok (s, calls, rows, used) →
      lawsOf X obj cell = .ok laws →
      ObjectStep X obj w w' (some (pinned X.env w c.unsigned.pins, some p, laws, r, stateOf cell, s, calls))

/-- **A history of the World around `obj`**, from `w` to `w'`: the judged steps, in order. -/
inductive ObjectHistory (X : Ctx D) (obj : D) :
    World D → World D → List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D)) → Prop
  | nil (w : World D) : ObjectHistory X obj w w []
  | cons {w w₁ w' : World D} {e : Option (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))}
      {rest : List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))} :
      ObjectStep X obj w w₁ e → ObjectHistory X obj w₁ w' rest → ObjectHistory X obj w w' (e.toList ++ rest)

/-! ## One step -/

/-- **A step that records nothing keeps the object's entry**, live or not. -/
theorem object_step_none {X : Ctx D} {obj : D} {w w' : World D} (h : ObjectStep X obj w w' none) :
    w'.live X.env obj = w.live X.env obj := by
  cases h with
  | refusal hr => exact refuse_live hr obj
  | other ha hk hc =>
      have he := admit_frame ha (fun x hx hxc => absurd hxc (hk x hx)) hc
      unfold World.live; rw [he]
  | keep _ ha hk hc _ _ _ =>
      have he := admit_frame ha hk hc
      unfold World.live; rw [he]
  | frame hc ha hf =>
      have he := call_frame hc ha (.cell obj) hf
      unfold World.live World.entry
      rw [he]

omit [Ord D] in
private theorem invokeRun_occasion {X : Ctx D} {look : Pinned D} {c : Call D} {actor obj : D} {method : Nat}
    {via : Option D} {cell : Cell} {p : D} {r : Req D}
    (h : invokeRun X look c actor obj method via = .ok (cell, p, r)) : r.occasion = .invoke method := by
  unfold invokeRun at h
  simp only [except_bind_ok] at h
  obtain ⟨cell', -, pkg, -, p', -, pr, -, h⟩ := h
  simp only [pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at h
  rw [← h.2.2]; rfl

/-- **A judged step.** Its `old` is the object's live state; the laws in force (the package's and the
cell's) admitted `old → new` under its request, in its view; a law change or adoption keeps the
state; an invoke's package ran `old → new` on the method its request names, returning its calls (a
write or a law returns none); the object is live after it, with a state that reads `new` at every
key. -/
theorem object_step_some {X : Ctx D} {obj : D} {w w' : World D} {look : Pinned D} {pkg : Option D}
    {laws : List D} {r : Req D} {old new : Slots} {calls : List (Body D)}
    (h : ObjectStep X obj w w' (some (look, pkg, laws, r, old, new, calls)))
    {cell : Cell} (hl : w.live X.env obj = some cell) :
    old = stateOf cell ∧ X.program.judge look pkg laws old new r = .ok () ∧
      (∀ ls, r.occasion = .relaw ls ∨ r.occasion = .adopt ls → new = old) ∧
      (pkg = none → calls = []) ∧
      (∀ q, pkg = some q → ∃ rv method args fuel rows used, r.occasion = .invoke method ∧
        X.program.run look rv q old method args r fuel = .ok (new, calls, rows, used)) ∧
      ∃ cell', w'.live X.env obj = some cell' ∧ ∀ k, (stateOf cell').get k = new.get k := by
  cases h with
  | @write _ _ c t edits via cell₀ principal laws hc ha hb hl₀ hcan hau hlw =>
      rw [hl] at hl₀; cases hl₀
      obtain ⟨principal', laws', -, hau', hlw', hj, cell', hl', -, hk⟩ := write_next_slots hc ha hb hl hcan
      rw [hau] at hau'; cases hau'
      rw [hlw] at hlw'; cases hlw'
      refine ⟨rfl, hj, fun ls hls => ?_, fun _ => rfl, fun q hq => by simp at hq, cell', hl', hk⟩
      rcases hls with h | h <;> cases h
  | @law _ _ c t laws' via cell₀ principal laws hc ha hb hl₀ hau hlw =>
      rw [hl] at hl₀; cases hl₀
      obtain ⟨principal', laws'', -, hau', hlw', hrel, -, cell', hl', hk⟩ := law_next_slots hc ha hb hl
      rw [hau] at hau'; cases hau'
      rw [hlw] at hlw'; cases hlw'
      exact ⟨rfl, hrel, fun _ _ => rfl, fun _ => rfl, fun q hq => by simp at hq, cell', hl', hk⟩
  | @invoke _ _ c t method args budget via cell₀ p r s calls rows used laws hc ha hb hr hp hlw =>
  simp [Lang.reqData, Lang.Data.field, Lang.Row.find?]

omit [Ord D] [DecidableEq D] in
/-- A request whose occasion field is a `relaw` or an `adopt` injection IS a law change or adoption. -/
private theorem occasion_relaw {bytesOf : D → ByteArray} {r : Req D} {ℓ : Lang.Label} {x : Lang.Data}
    (h : (Lang.reqData bytesOf r).field "occasion" = some (.inj ℓ x)) (hℓ : ℓ = "relaw" ∨ ℓ = "adopt") :
    ∃ ls, r.occasion = .relaw ls ∨ r.occasion = .adopt ls := by
  rw [reqData_occasion] at h
  cases ho : r.occasion with
  | relaw ls => exact ⟨ls, .inl rfl⟩
  | adopt ls => exact ⟨ls, .inr rfl⟩
  | birth => rw [ho] at h; simp [Lang.occasionData] at h; obtain ⟨rfl, -⟩ := h; rcases hℓ with h | h <;> exact absurd h (by decide)
  | write => rw [ho] at h; simp [Lang.occasionData] at h; obtain ⟨rfl, -⟩ := h; rcases hℓ with h | h <;> exact absurd h (by decide)
  | invoke m => rw [ho] at h; simp [Lang.occasionData] at h; obtain ⟨rfl, -⟩ := h; rcases hℓ with h | h <;> exact absurd h (by decide)

/-- **THE LIFT: a World's history around an object is a history of every law in force.** At a lawful
`Ctx` running the language (`Lang.program` over its own codec), take a law `t` that mentions no closure
package (field `ℓ` of the package `p`, a law's shape, as every stdlib law is). Along any
`ObjectHistory` in whose every judged step the law's id `law` is among the judging laws (the package
or the cell's laws) and reads as `p` in that step's view, from a live object whose state reads `o`:
the judged steps are a `Std.Chain (Std.Step [] t)` from `o`, step for step (each step's request is
the judge's request as data, its new state the judged new slots as read), under every lib. A
non-judged step changes nothing the chain sees (`object_step_none`); a judged step's old state is
the live one and its new state the next live one, key by key (`object_step_some`), so the steps
link. No premise but the history and the law in force: no typing (`judgeOne_admits_relib` takes none),
no canonicity (a write step carries its cell's), no order law (a nested step carries it). -/
theorem object_history_chain {X : Ctx D} (hX : X.Lawful) (hprog : X.program = Lang.program X.env.bytes X.digestOf)
    {obj law : D} {p : Lang.Package} {fs : List (Lang.Label × Lang.Term)} {ℓ : Lang.Label} {t : Lang.Term}
    (hb : p.body = .record fs) (hℓ : ℓ ∈ p.laws) (hf : Lang.Row.find? ℓ fs = some t) (hlaw : Lang.IsLaw t)
    (hnr : Lang.NoRef t) :
    ∀ {w w' : World D} {tr : List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))},
      ObjectHistory X obj w w' tr →
      (∀ e ∈ tr, law ∈ e.2.1.toList ++ e.2.2.1 ∧ Lang.readPackage e.1 law = .ok p) →
      ∀ {cell : Cell} {o : Lang.Data}, w.live X.env obj = some cell →
        Lang.readState X.digestOf (Lang.recordRow p.state) (stateOf cell) = .ok o →
        ∃ steps, Lang.Std.Chain (Lang.Std.Step [] t) o steps ∧
          tr.map (fun e => (Lang.reqData X.env.bytes e.2.2.2.1,
            Lang.readState X.digestOf (Lang.recordRow p.state) e.2.2.2.2.2.1)) =
            steps.map (fun s => (s.1, .ok s.2)) := by
  intro w w' tr h
  induction h with
  | nil w => exact fun _ _ o _ _ => ⟨[], .nil o, rfl⟩
  | @cons w w₁ w' e rest hs _ ih =>
      intro hin cell o hl ho
      cases e with
      | none => exact ih hin ((object_step_none hs).trans hl) ho
      | some x =>
          obtain ⟨look, pkg, laws, r, old, new, calls⟩ := x
          obtain ⟨hold, hj, hkeep, -, -, cell', hl', hk⟩ := object_step_some hs hl
          obtain ⟨hmem, hpk⟩ := hin _ (List.mem_cons_self ..)
          rw [hprog] at hj
          have hj' : Lang.judge X.env.bytes X.digestOf look pkg laws old new r = .ok () := hj
          have hj1 := judge_mem hj' hmem
          obtain ⟨o', n, ho', hn, hall⟩ :=
            Lang.judgeOne_admits_relib X.env.bytes X.digestOf (hX.digestOf_bytes law) hpk hb hj1
          rw [hold, ho] at ho'
          cases ho'
          have hadm := hall ℓ hℓ t hf hlaw hnr []
          have hn' : Lang.readState X.digestOf (Lang.recordRow p.state) (stateOf cell') = .ok n :=
            (Lang.readState_get hk).trans hn
          obtain ⟨steps, hch, hfa⟩ := ih (fun e he => hin e (List.mem_cons_of_mem _ he)) hl' hn'
          refine ⟨(Lang.reqData X.env.bytes r, n) :: steps, .cons ⟨hadm, fun ℓ' x' hocc hℓ' => ?_⟩ hch,
            by simp only [Option.toList_some, List.singleton_append, List.map_cons, hn, hfa]⟩
          obtain ⟨ls, hls⟩ := occasion_relaw hocc hℓ'
          have hno := hkeep ls hls
          rw [hno, hold, ho] at hn
          cases hn
          rfl

/-- **What each judged step ran.** Along an `ObjectHistory`, a step judged by no package (a write, a
law) returned no calls; a step judged by a package `q` (an invoke, signed or nested) is a run of
`q`, in the step's view, from the step's old state to its new state, of the method its request
names, returning the step's calls. -/
theorem object_history_runs {X : Ctx D} {obj : D} :
    ∀ {w w' : World D} {tr : List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))},
      ObjectHistory X obj w w' tr → ∀ e ∈ tr, (e.2.1 = none → e.2.2.2.2.2.2 = []) ∧
        ∀ q, e.2.1 = some q → ∃ rv method args fuel rows used, e.2.2.2.1.occasion = .invoke method ∧
          X.program.run e.1 rv q e.2.2.2.2.1 method args e.2.2.2.1 fuel = .ok (e.2.2.2.2.2.1, e.2.2.2.2.2.2, rows, used) := by
  intro w w' tr h
  induction h with
  | nil => simp
  | @cons w w₁ w' e rest hs _ ih =>
      intro x hx
      cases e with
      | none => exact ih x hx
      | some y =>
          rcases List.mem_cons.mp hx with rfl | hx
          · obtain ⟨look, pkg, laws, r, old, new, calls⟩ := x
            obtain ⟨cell, hl⟩ := object_step_live hs
            obtain ⟨hold, -, -, hn, hq, -⟩ := object_step_some hs hl
            exact ⟨hn, hq⟩
          · exact ih x hx

/-- **A history with a judged step starts from a state the law reads.** Under the lift's premises,
an `ObjectHistory` with a judged step starts at a World holding the object live, with a state that
reads, at the package's state type, as data. -/
theorem object_history_start {X : Ctx D} (hX : X.Lawful) (hprog : X.program = Lang.program X.env.bytes X.digestOf)
    {obj law : D} {p : Lang.Package} :
    ∀ {w w' : World D} {tr : List (Pinned D × Option D × List D × Req D × Slots × Slots × List (Body D))},
      ObjectHistory X obj w w' tr →
      (∀ e ∈ tr, law ∈ e.2.1.toList ++ e.2.2.1 ∧ Lang.readPackage e.1 law = .ok p) → tr ≠ [] →
      ∃ cell o, w.live X.env obj = some cell ∧ Lang.readState X.digestOf (Lang.recordRow p.state) (stateOf cell) = .ok o := by
  intro w w' tr h
  induction h with
  | nil => intro _ hne; exact absurd rfl hne
  | @cons w w₁ w' e rest hs _ ih =>
      intro hin hne
      cases e with
      | none =>
          obtain ⟨cell, o, hl, ho⟩ := ih hin hne
          exact ⟨cell, o, (object_step_none hs).symm.trans hl, ho⟩
      | some x =>
          obtain ⟨look, pkg, laws, r, old, new, calls⟩ := x
          obtain ⟨cell, hl⟩ := object_step_live hs
          obtain ⟨hold, hj, -⟩ := object_step_some hs hl
          obtain ⟨hmem, hpk⟩ := hin _ (List.mem_cons_self ..)
          rw [hprog] at hj
          have hj' : Lang.judge X.env.bytes X.digestOf look pkg laws old new r = .ok () := hj
          obtain ⟨L, g, p', o, n, hload, hpg, ho, -, -⟩ := Lang.judgeOne_ok X.env.bytes X.digestOf (judge_mem hj' hmem)
          obtain ⟨hpg', -⟩ := Lang.load_top X.env.bytes X.digestOf (fuel := Lang.closureDepthMax - 1)
            (hX.digestOf_bytes law) hpk hload
          rw [hpg'] at hpg
          cases hpg
          exact ⟨cell, o, hl, hold ▸ ho⟩

end Nanodregg.Kernel.Receive
/-
# Ledger.Proofs.EscrowRun — the escrow's calls are what the RECEIVER's run returns

`Ledger.Proofs.Escrow` reads each method's result as `methodResult`: the method application
`apply4 0 ℓ` under the closure `[escrow.body]`, extracted whole at the methods' result type. The
receiver runs `Lang.runMeasured`: it loads the package's closure from the pinned view, resolves the
method index, reads the state slots, decodes the arguments, runs `apply4 g ℓ` under the loaded
closure at the call's budget, extracts the result, and reads its calls slot into `Body D`. Here the
two meet, through LANG-61 (`Lang.Proofs.Extract`):

* `escrow_noRef`: the escrow's body mentions no closure package, so the loaded closure holds it
  unrelocated and its meaning does not depend on the closure (`relocate_noRef`, `relib_apply4`).
* `escrow_resolve`: the method indices the receiver resolves are exactly 0 deposit, 1 refund,
  2 release, each at argument type `depositArg` / `unit`, result type `resultOf`, reading no rows.
* `escrow_state_shape`: a state that reads at the escrow's row is `stateOf` of seven terms.
* `run_result`: what a receiver extracts from `apply4 g ℓ` under a closure holding the body at
  `g` is `methodResult ℓ`, at every budget the run succeeded under (`runMeasured_means`,
  `bigStep_deterministic`, `means_deterministic`).
* `escrow_run_calls`, the escrow's payout theorem of the deployed path: a successful run of the
  escrow package (`readPackage look pkg = .ok escrow`, under a decoder that reads every id's bytes
  back) is `RunCalls`: it read the state as seven terms, and its calls are exactly the one transfer
  the method makes: `deposit` from `of depositor asset` into `of self asset` through the grant its
  argument names, spending the nonce; `refund` and `release` out of `of self asset` (`self` the
  request's object) to the depositor and the beneficiary, through no grant, spending `"payout"`;
  any other index does not run. KERNEL resolves `AcctRef.of o a` to `accountId X o a`
  (`AcctRef.resolve`), so a payout's source is `accountId X e asset`, the account both payouts'
  one nullifier names.
* `escrow_program_calls`: the same at `invoke`'s call `X.program.run`, for a lawful `Ctx` whose
  program is `Lang.program` over its own codec; `escrow_run_deployed`: at the node's `Ctx`
  (`Host.Deployed.X`), both discharged (`Receive.deployed_ctx_lawful`, `rfl`).

* `escrow_runs_one_payout`, the package's statement over the receiver's runs: along any sequence
  of runs the receiver commits on one escrow (`Runs`: each a successful run in its own view whose
  package cell reads as `escrow`, judged by the package's law and the cell's laws over the slots
  before and after, the next run reading slots that hold, key by key, what this one wrote (read by
  `readState` through Lang's `readState_get`), read back by LANG-63's
  `runMeasured_means`), at most one returned call is a payout (`payoutCalls`: a transfer through
  no grant), by `Std.chain_count`: `runs_chain` reads the runs as a `Std.Chain` of the escrow law's
  admitted steps under every lib (`escrow_step_admits`, through LANG's `judgeOne_admits_relib`;
  `escrow_law_noRef`, `escrow_law_isLaw`), each paired with its run's calls, of which at most one
  is a payout and a payout only into a settled state (`runCalls_payout`); `payoutCalls_le_one`
  marks the settled steps and `escrow_absorbing` stops the chain at one. The same count serves the
  World's history (`Ledger.Proofs.EscrowInvokes`). `escrow_runs_after_payout`: a run that pays out
  is the last the receiver commits (`chain_stops` on the same chain; `escrow_judge_settled`: the
  judge refuses everything out of `released` and `refunded`).
  `escrow_program_one_payout` and `escrow_runs_deployed`: at a lawful `Ctx` over its own codec
  and at the node's, premise only the runs (`Ledger.Proofs.EscrowWitness.escrow_runs_witness`: a
  deposit then a release there, evaluated by the kernel, is a `Runs` with exactly one payout).

Teeth: `run_result_needs_body` (another body at `g` gives the release another result: the body
premise is not idle); `run_calls_pins_payee` (a release paying the depositor, from a state whose
beneficiary is another, is not `RunCalls`); `escrow_judge_bites` (from `released` the method still
pays, the law admits nothing: the bound is the judge's); `payout_call_tells` (the count is not
constant: a deposit's grant-named transfer is not a payout).
-/
import Ledger.Proofs.Escrow
import Lang.Proofs.Extract
import Lang.Proofs.Invoke
import Kernel.Proofs.RootedDeployed

namespace Nanodregg.Ledger.Proofs

open Nanodregg.Lang
open Nanodregg.Kernel Nanodregg.Kernel.Receive
open Nanodregg.Ledger.Escrow

/-! ## The body holds no closure reference -/

private def mth (n : Nat) : Term :=
  match methods[n]? with
  | some (_, _, _, t) => t
  | none => .nat 0

private theorem fields_eq :
    bodyFields = [("deposit", mth 0), ("escrow", law), ("refund", mth 1), ("release", mth 2)] := rfl

open NoRefStd Std in
/-- **The escrow's body mentions no closure package**: no `ref` in its law or its methods. -/
theorem escrow_noRef : NoRef escrow.body := by
  rw [escrow_body, fields_eq]
  have hp : ∀ (a : At) (f p : Label), NoRef (isPh (a.oldF f) p) ∧ NoRef (isPh (a.newF f) p) := fun a f p => by
    simp only [isPh, Std.isState, At.oldF, At.newF, At.old, At.new, NoRef, row_iff]
    refine ⟨⟨trivial, ?_⟩, ⟨trivial, ?_⟩⟩ <;>
    · intro e he
      obtain ⟨_, _, rfl⟩ := List.mem_map.1 he
      trivial
  have hq : ∀ (a : At) (f : Label), NoRef (agentIs a f) := fun a f => by
    simp [agentIs, At.reqF, At.oldF, At.req, At.old, NoRef]
  refine ⟨?_, ?_, ?_, ?_, trivial⟩
  · simp [mth, methods, NoRef, NoRefRow, resultT, callsT, someCallT, depositCall, transferT, ofT, st, rq,
      someD, someB, keep, phaseT, slotLabels]
  · exact lawOf5_ (allOf_ (by simp [hp])) (allOf_ (by simp [hp])) refusedT_ refusedT_
      (by simp [invokeC, Std.guard, NoRef, methodClause, methodIs, refusedT_, allOf_, anyOf_, notT_, hp, hq,
        At.payload, natT])
  · simp [mth, methods, NoRef, NoRefRow, resultT, callsT, someCallT, payoutCall, transferT, ofT, st, rq,
      noneD, someB, keep, phaseT, slotLabels]
  · simp [mth, methods, NoRef, NoRefRow, resultT, callsT, someCallT, payoutCall, transferT, ofT, st, rq,
      noneD, someB, keep, phaseT, slotLabels]

/-- The escrow's law mentions no closure package. -/
  have hrb := hrb fun x => by rw [hdig]; rfl
  obtain ⟨hpe, f, hlib⟩ := load_top bytesOf digestOf (fuel := closureDepthMax - 1) (hdig pkg) hpkg hl
  rw [hp] at hpe
  cases hpe
  rw [relocate_noRef f _ escrow_noRef] at hlib
  obtain ⟨hx, hty⟩ := escrow_resolve hres
  rw [hty] at hm
  obtain ⟨amount, arb, asset, ben, dep, nk, ph, rfl⟩ := escrow_state_shape (readState_conforms hsd)
  rw [reqData_eq] at hb
  refine ⟨amount, arb, asset, ben, dep, nk, ph, ?_⟩
  rcases hx with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · obtain ⟨gb, rfl⟩ := deposit_arg_shape (decodeData_conforms had)
    have hd := run_result hlib hb hm (escrow_method_results amount arb asset ben dep nk (bytesOf r.self) gb ph
      _ _ _ _ _ (.record []) wd).1
    simp only [resultD, Data.record.injEq, List.cons.injEq, Prod.mk.injEq, and_true, true_and] at hd
    obtain ⟨rfl, -, hds⟩ := hd
    cases ha : digestOf asset <;> cases hg : digestOf gb <;> cases hdp : digestOf dep <;>
      simp [callsOf, callsOf.go, bodyOf, acctRefOf, Lang.digestAt, natOf, optOf, bytesAt, hdig, ha, hg, hdp,
        transferD, ofD, optSome, bind, Except.bind, pure, Except.pure, Except.map] at hc
    exact ⟨_, hsd, rfl, .inl ⟨rfl, hds ▸ hrb, gb, _, _, had, hg, rfl, hc.symm⟩⟩
  · have hd := run_result hlib hb hm (escrow_method_results amount arb asset ben dep nk (bytesOf r.self) .empty ph
      _ _ _ _ _ ad wd).2.1
    simp only [resultD, Data.record.injEq, List.cons.injEq, Prod.mk.injEq, and_true, true_and] at hd
    obtain ⟨rfl, -, hds⟩ := hd
    cases ha : digestOf asset <;> cases hdp : digestOf dep <;>
      simp [callsOf, callsOf.go, bodyOf, acctRefOf, Lang.digestAt, natOf, optOf, bytesAt, hdig, ha, hdp,
        transferD, ofD, optSome, optNone, bind, Except.bind, pure, Except.pure, Except.map] at hc
    exact ⟨_, hsd, rfl, .inr (.inl ⟨rfl, hds ▸ hrb, _, rfl, hc.symm⟩)⟩
  · have hd := run_result hlib hb hm (escrow_method_results amount arb asset ben dep nk (bytesOf r.self) .empty ph
      _ _ _ _ _ ad wd).2.2
    simp only [resultD, Data.record.injEq, List.cons.injEq, Prod.mk.injEq, and_true, true_and] at hd
    obtain ⟨rfl, -, hds⟩ := hd
    cases ha : digestOf asset <;> cases hbn : digestOf ben <;>
      simp [callsOf, callsOf.go, bodyOf, acctRefOf, Lang.digestAt, natOf, optOf, bytesAt, hdig, ha, hbn,
        transferD, ofD, optSome, optNone, bind, Except.bind, pure, Except.pure, Except.map] at hc
    exact ⟨_, hsd, rfl, .inr (.inr ⟨rfl, hds ▸ hrb, _, rfl, hc.symm⟩)⟩

/-- **At the kernel's call**: `invoke` runs `X.program.run` on the object's package; where that
program is the language over the World's own codec and the `Ctx` is lawful, a successful run of the
escrow package returns exactly the method's one transfer (`escrow_run_calls`). -/
theorem escrow_program_calls {X : Ctx D} (hX : X.Lawful) (hp : X.program = Lang.program X.env.bytes X.digestOf)
    {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat} {args : ByteArray}
    {r : Req D} {budget : Nat} {s : Slots} {calls : List (Body D)} {rows : List (RowSlot D × RowAct)}
    {used : Nat}
    (hpkg : readPackage look pkg = .ok escrow)
    (h : X.program.run look rv pkg state method args r budget = .ok (s, calls, rows, used)) :
    RunCalls X.digestOf state method args r.self calls s := by
  rw [hp] at h
  change (runMeasured X.env.bytes X.digestOf look rv pkg state method args r budget).map _ = _ at h
  cases hm : runMeasured X.env.bytes X.digestOf look rv pkg state method args r budget with
  | error _ => rw [hm] at h; cases h
  | ok y =>
    obtain ⟨s', calls', rows', t', n'⟩ := y
    rw [hm] at h
    simp only [Except.map, Except.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl, -⟩ := h
    exact escrow_run_calls hX.digestOf_bytes hpkg hm

end

/-- **Deployed**: the node's `Ctx` (`Host.Deployed.X`: the deployed codec, `Lang.program` over it)
meets both premises (`Receive.deployed_ctx_lawful`, the program is its own codec's by
construction), so a successful run of the escrow package there returns exactly the method's one
transfer, with no premise but the package. -/
theorem escrow_run_deployed
    {look : Pinned Codec.Digest} {rv : RowView Codec.Digest} {pkg : Codec.Digest} {state : Slots}
    {method : Nat} {args : ByteArray} {r : Req Codec.Digest} {budget : Nat} {s : Slots}
    {calls : List (Body Codec.Digest)} {rows : List (RowSlot Codec.Digest × RowAct)} {used : Nat}
    (hpkg : readPackage look pkg = .ok escrow)
    (h : (Codec.Deployed.ctx (Lang.program Codec.Digest.bytes Codec.Digest.ofBytes?)).program.run look rv pkg
      state method args r budget = .ok (s, calls, rows, used)) :
    RunCalls Codec.Digest.ofBytes? state method args r.self calls s :=
  escrow_program_calls (deployed_ctx_lawful _) rfl hpkg h

/-! ## The chain: the runs the receiver commits on one escrow -/

section
variable {D : Type}

/-- **A sequence of runs the receiver commits** on one object of package `pkg`, from the state slots
`state`, under the program `prog` (the `Ctx`'s, what `invoke` calls): each step, in its own pinned
view `look` (whose package cell reads as `p`), is a successful `prog.run` of any method on any
arguments, request and budget, whose written slots `prog.judge` admits over the slots before (the
package's own law first, then the cell's laws `laws`: what `invoke` checks before it derives the
calls), and the next step reads slots that hold, key by key, what it wrote (`Slots.get`: the cell
`invoke`'s write leaves need not be the same list, only the same contents). The list holds each
step's calls. -/
inductive Runs (prog : Program D) (pkg : D) (p : Package) : Slots → List (List (Body D)) → Prop
  | nil (state : Slots) : Runs prog pkg p state []
  | cons {look : Pinned D} {rv : RowView D} {state : Slots} {method : Nat} {args : ByteArray} {r : Req D}
      {budget : Nat} {s : Slots} {calls : List (Body D)} {rows : List (RowSlot D × RowAct)} {used : Nat}
      {laws : List D} {next : Slots} {rest : List (List (Body D))} :
      readPackage look pkg = .ok p →
      prog.run look rv pkg state method args r budget = .ok (s, calls, rows, used) →
      prog.judge look (some pkg) laws state s r = .ok () →
      (∀ k, next.get k = s.get k) →
      Runs prog pkg p next rest → Runs prog pkg p state (calls :: rest)

variable {bytesOf : D → ByteArray} {digestOf : ByteArray → Option D}

private theorem run_of_program {look : Pinned D} {rv : RowView D} {pkg : D} {state : Slots} {method : Nat}
    {args : ByteArray} {r : Req D} {budget : Nat} {s : Slots} {calls : List (Body D)}
    {rows : List (RowSlot D × RowAct)} {used : Nat}
    (h : (Lang.program bytesOf digestOf).run look rv pkg state method args r budget = .ok (s, calls, rows, used)) :
    ∃ t n, runMeasured bytesOf digestOf look rv pkg state method args r budget = .ok (s, calls, rows, t, n) := by
  change (runMeasured bytesOf digestOf look rv pkg state method args r budget).map _ = _ at h
  cases hm : runMeasured bytesOf digestOf look rv pkg state method args r budget with
  | error _ => rw [hm] at h; cases h
  | ok y =>
    obtain ⟨s', calls', rows', t', n'⟩ := y
    rw [hm] at h
    simp only [Except.map, Except.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl, rfl, -⟩ := h
    exact ⟨_, _, rfl⟩

/-- **A settled escrow admits no run**: the receiver's judge of the escrow package (and any further
laws) refuses every transition out of slots that read as a `released` or `refunded` state, whatever
the new slots and the request (`judgeOne_ok`, `escrow_judge_admits`, `escrow_absorbing`). -/
theorem escrow_judge_settled (hdig : ∀ x, digestOf (bytesOf x) = some x)
    {look : Pinned D} {pkg : D} {laws : List D} {old new : Slots} {r : Req D} {o : Data}
    (hpkg : readPackage look pkg = .ok escrow)
    (ho : readState digestOf (recordRow escrow.state) old = .ok o) (hs : Settled o)
    (h : Lang.judge bytesOf digestOf look (some pkg) laws old new r = .ok ()) : False := by
  have h1 : judgeOne bytesOf digestOf look pkg old new r = .ok () := by
    unfold Lang.judge at h
    simp only [bind, Except.bind] at h
    split at h
    · cases h
    · rename_i u hj
      cases u
      exact hj
  obtain ⟨L, g, p, o', n, hload, hpg, ho', -, hall⟩ := judgeOne_ok bytesOf digestOf h1
  obtain ⟨hpg', f, hlib⟩ := load_top bytesOf digestOf (fuel := closureDepthMax - 1) (hdig pkg) hpkg hload
  rw [hpg'] at hpg
  cases hpg
  rw [relocate_noRef f _ escrow_noRef] at hlib
  rw [ho] at ho'
  cases ho'
  exact escrow_absorbing hs (escrow_judge_admits hlib (hall "escrow" (by rw [escrow_laws]; simp)))

/-- The escrow's judge passed its own law: the package's verdict is the first of `judge`'s. -/
theorem escrow_judgeOne {look : Pinned D} {pkg : D} {laws : List D} {old new : Slots} {r : Req D}
    (h : Lang.judge bytesOf digestOf look (some pkg) laws old new r = .ok ()) :
    judgeOne bytesOf digestOf look pkg old new r = .ok () := by
  unfold Lang.judge at h
  simp only [bind, Except.bind] at h
into a settled state, at most one call is a payout: `chain_count` marks the steps into a settled
state, and the law admits nothing out of one (`escrow_absorbing`). -/
theorem payoutCalls_le_one {o : Data} :
    ∀ (ps : List (List (Body D) × (Data × Data))), Std.Chain (Std.Admits [] law) o (ps.map Prod.snd) →
      (∀ x ∈ ps, (x.1.filter isPayoutCall).length ≤ 1 ∧ (0 < (x.1.filter isPayoutCall).length → Settled x.2.2)) →
      payoutCalls (ps.map Prod.fst) ≤ 1 := by
  intro ps hc hp
  have hcount := Std.chain_count (fun s => decide (Settled s.2)) Settled
    (fun _ _ _ _ hm => of_decide_eq_true hm) (fun _ _ _ hs ha => escrow_absorbing hs ha) hc
  have key : ∀ (qs : List (List (Body D) × (Data × Data))),
      (∀ x ∈ qs, (x.1.filter isPayoutCall).length ≤ 1 ∧ (0 < (x.1.filter isPayoutCall).length → Settled x.2.2)) →
      payoutCalls (qs.map Prod.fst) ≤ ((qs.map Prod.snd).filter fun s => decide (Settled s.2)).length := by
    intro qs
    induction qs with
    | nil => intro _; simp [payoutCalls]
    | cons x rest ih =>
        intro hq
        have hr := ih (fun y hy => hq y (List.mem_cons_of_mem _ hy))
        obtain ⟨h1, h2⟩ := hq x (List.mem_cons_self ..)
        simp only [payoutCalls, List.map_cons, List.sum_cons, List.filter_cons] at hr ⊢
        by_cases hs : Settled x.2.2
        · simp only [hs, decide_true, if_true, List.length_cons]
          omega
        · have h0 : (x.1.filter isPayoutCall).length = 0 := by
            rcases Nat.eq_zero_or_pos (x.1.filter isPayoutCall).length with h | h
            · exact h
            · exact absurd (h2 h) hs
          simp only [hs, decide_false, Bool.false_eq_true, if_false]
          omega
  exact Nat.le_trans (key ps hp) hcount

end


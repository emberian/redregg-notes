    HasType Δ [] i.body p.iface ∧ Term.nodes i.body ≤ Wire.nodeMax := by
  unfold instantiateHoles at h
  simp only [bind, Except.bind, pure, Except.pure] at h
  repeat' split at h
  all_goals first | (simp at h; done) | skip

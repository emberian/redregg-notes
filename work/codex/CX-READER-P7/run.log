def stmt(t):
    depth=0;quoted=False;escape=False
    for i,c in enumerate(t):
        if quoted:
            if escape:escape=False
            elif c=='\\':escape=True
            elif c=='"':quoted=False
            continue
        if c=='"':quoted=True;continue
        if c in '({[':depth+=1
        if c in ')}]':depth-=1
        if depth==0 and (t[i:i+2]==':=' or t[i:i+4]=='\n  |'):return t[:i].strip()
    return t
def decls(s):
    ms=list(re.finditer(r'^(?:(?:private|protected)\s+)?(?:theorem|lemma)\s+(\S+)',s,re.M))
    return {m.group(1):s[m.start():(ms[i+1].start() if i+1<len(ms) else len(s))] for i,m in enumerate(ms)}
old={};new={}
for path in files:
    prior=subprocess.run(['git','show','HEAD:'+path],capture_output=True,text=True).stdout
    for n,t in decls(prior).items():old[n]=(path,t)
    for n,t in decls(Path(path).read_text()).items():new[n]=(path,t)
out=[]
for n,(path,t) in new.items():
    prev=old.get(n)

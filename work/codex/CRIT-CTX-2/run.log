/-
# Lang.Proofs.Contextual.ProtocolTyping — the statements of the open-protocol theory (lane PROTOCOL)

The Prop-valued relations over `Lang.Contextual.Protocol`'s data: the judgment
`Ω;Γ;Δ ⊢ P : Protocol(i, Q) ⊣ Φ` (`HasProt`), linear tokens as a bag (`SubBag`), a filling that
satisfies an interface (`Fills`), an interface-respecting substitution (`SubstOK`), algebra
morphisms, complete paths (`Runs`), prefixes (`Reach`), histories (`Started`), entered holes
(`Dispatched`), the guard on a re-plan (`Open.Replan`), the well-formed open object (`Open.WF`),
and sufficient supports (`Frag.ReadsOnly`). Theorems in `Lang.Proofs.Contextual.Protocol`.
The completion space `Conds.space`, the matcher assignments `Assigns`, the scalar matchers and the
private `World` went with PROT-6, replaced by Std.offer's deployed fuse (`Lang/StdOffer.lean`).
-/
import Lang.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.Protocol

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- `h` occurs in `P` (on some response path). -/
inductive Occurs : {i : Ix} → Prot S Hole A i → (j : Ix) → Hole j → Prop
  | here {j : Ix} (h : Hole j) : Occurs (.hole h) j h
  | call {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {j : Ix} {h : Hole j} (r : S.Resp op) : Occurs (k r) j h → Occurs (.call op k) j h

/-- `Δ₁ ≤ Δ₂` as bags: no token occurs more often in `Δ₁`. -/
def SubBag {Tok : Type} [DecidableEq Tok] (Δ₁ Δ₂ : List Tok) : Prop :=
  ∀ t, Δ₁.count t ≤ Δ₂.count t

/-- `HasProt sp Ω Γ Q Φ Δ P`. A `call` requires its facts from `Γ`, records its obligations in `Φ`,
and, if it spends a token, takes it from `Δ`: every continuation is judged with that token gone
(LINEAR: a token is spent by at most one call on any path, `Proofs.hasProt_reach`). A hole is
judged by its declared interface: its chooser must be `.me`, its context and tokens available here, its
results within `Q`, its obligations within `Φ`.

The hole rule's four premises are the check that the declared interface is AT LEAST AS STRONG as the
weakest one this occurrence admits, `(Γ, Δ, Q, Φ)` (Benveniste's quotient, PROT-7): `I.ctx ⊆ Γ`,
`SubBag I.need Δ`, `I.post → Q`, `I.owes ⊆ Φ`. The converse, completeness (a filling under which the
filled template is judged is judged at every occurrence's `(Γ, Δ, Q, Φ)`, so an over-strong `I` is
refuted by such a filling), is NOT proved: nothing reads it. Its reader would be a candidate check
that judges fillings by `HasProt`; the deployed candidate check is the fuse's `offerJoint`
(LANG-75.11), which judges two offer boxes and one θ by one term and reads no `Iface` (LANG-75.17). -/
inductive HasProt {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob)
    (Ω : Ctx S Hole A Tok Fact Ob) (Γ : List Fact) (Q : (j : Ix) → A j → Prop) (Φ : List Ob) :
    List Tok → {i : Ix} → Prot S Hole A i → Prop
  | ret {Δ : List Tok} {i : Ix} (a : A i) : Q i a → HasProt sp Ω Γ Q Φ Δ (.ret a)
  | call {Δ : List Tok} {i : Ix} (op : S.Op i)
      (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) :
      sp.consumes op = none → (∀ f ∈ sp.requires op, f ∈ Γ) →
      (∀ o ∈ sp.establishes op, o ∈ Φ) →
      (∀ r, HasProt sp Ω Γ Q Φ Δ (k r)) → HasProt sp Ω Γ Q Φ Δ (.call op k)
  | spend {Δ : List Tok} {i : Ix} (op : S.Op i)
      (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) (t : Tok) :
      sp.consumes op = some t → t ∈ Δ → (∀ f ∈ sp.requires op, f ∈ Γ) →
      (∀ o ∈ sp.establishes op, o ∈ Φ) →
      (∀ r, HasProt sp Ω Γ Q Φ (Δ.erase t) (k r)) → HasProt sp Ω Γ Q Φ Δ (.call op k)
  | hole {Δ : List Tok} {i : Ix} (h : Hole i) (I : Iface S Hole A Tok Fact Ob i) :
      Ω i h = some I → I.chooser = .me → (∀ f ∈ I.ctx, f ∈ Γ) → SubBag I.need Δ →
      (∀ j a, I.post j a → Q j a) → (∀ o ∈ I.owes, o ∈ Φ) → HasProt sp Ω Γ Q Φ Δ (.hole h)

/-- A filling satisfies a hole's interface: judged in the hole's own context, tokens, result and
obligations, and passing the hole's acceptance contract. -/
def Fills {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob)
    (Ω : Ctx S Hole A Tok Fact Ob) {i : Ix} (I : Iface S Hole A Tok Fact Ob i)
    (f : Prot S Hole A i) : Prop :=
  HasProt sp Ω I.ctx I.post I.owes I.need f ∧ I.accepts f

/-- A substitution respects `Ω`: it fills only declared `.me` holes, each with a filling that
satisfies the hole's interface. -/
def SubstOK {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob)
    (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A) : Prop :=
  ∀ i h f, σ i h = some f → ∃ I, Ω i h = some I ∧ I.chooser = .me ∧ Fills sp Ω I f

/-- `φ` is an algebra morphism `src → dst` (carriers may differ). -/
structure AlgebraHom {C D : Ix → Type} (src : Algebra S Hole A C) (dst : Algebra S Hole A D)
    (φ : (i : Ix) → C i → D i) : Prop where
  ret : ∀ {i : Ix} (a : A i), φ i (src.ret a) = dst.ret a
  call : ∀ {i : Ix} (op : S.Op i) (k : (r : S.Resp op) → C (S.next op r)),
    φ i (src.call op k) = dst.call op (fun r => φ (S.next op r) (k r))
  hole : ∀ {i : Ix} (h : Hole i), φ i (src.hole h) = dst.hole h

/-- A complete path: the interactions performed, each with SOME response, and the result. -/
inductive Runs : {i : Ix} → Prot S Hole A i → Trace S → (j : Ix) → A j → Prop
  | ret {i : Ix} (a : A i) : Runs (.ret a) [] i a
  | call {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {tr : Trace S} {j : Ix} {a : A j} (r : S.Resp op) :
      Runs (k r) tr j a → Runs (.call op k) (⟨i, op, r⟩ :: tr) j a

/-- A performed prefix and the residual protocol it leaves. -/
inductive Reach : {i : Ix} → Prot S Hole A i → Trace S → (Σ j, Prot S Hole A j) → Prop
  | here {i : Ix} (P : Prot S Hole A i) : Reach P [] ⟨i, P⟩
  | call {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {tr : Trace S} {R : Σ j, Prot S Hole A j} (r : S.Resp op) :
      Reach (k r) tr R → Reach (.call op k) (⟨i, op, r⟩ :: tr) R

/-- `H` is a history of `P`: the answered part is a prefix, and the in-flight call (if any) is the
call the prefix's residual makes. -/
inductive Started : {i : Ix} → Prot S Hole A i → Hist S → Prop
  | settled {i : Ix} {P : Prot S Hole A i} {t : Trace S} {R : Σ j, Prot S Hole A j} :
      Reach P t R → Started P ⟨t, none⟩
  | uncertain {i : Ix} {P : Prot S Hole A i} {t : Trace S} {j : Ix} {op : S.Op j}
      {k : (r : S.Resp op) → Prot S Hole A (S.next op r)} :
      Reach P t ⟨j, .call op k⟩ → Started P ⟨t, some ⟨j, op⟩⟩

/-- The history has ENTERED hole `h` of the template: the template's prefix reached `h` and
something after it was performed or dispatched (the filling's first call left). -/
def Dispatched {i : Ix} (P : Prot S Hole A i) (H : Hist S) (j : Ix) (h : Hole j) : Prop :=
  ∃ t₁ t₂, H.answered = t₁ ++ t₂ ∧ Reach P t₁ ⟨j, .hole h⟩ ∧ (t₂ ≠ [] ∨ H.inflight.isSome = true)

/-- A well-formed open object: the template is judged, the substitution respects `Ω`, the
history is a history of the current protocol. -/
structure Open.WF {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob) {i : Ix}
    (O : Open S Hole A Tok Fact Ob i) : Prop where
  typed : HasProt sp O.Ω O.Γ O.Q O.Φ O.Δ O.template
  substOK : SubstOK sp O.Ω O.σ
  started : Started O.current O.hist

/-- The guard on a re-plan: the new substitution agrees with the old one on every hole the history
has entered (there is no unguarded re-plan in any theorem: each takes this as a hypothesis). -/
def Open.Replan {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i) (σ' : Subst S Hole A) : Prop :=
  ∀ j h, Dispatched O.template O.hist j h → σ'.mine O.Ω j h = O.σ.mine O.Ω j h

end

/-- The fragment's check reads only its support (the soundness of a declared dependency set:
sufficient, not minimal). -/
def Frag.ReadsOnly {Name Key V : Type} (f : Frag Name Key V) : Prop :=
  ∀ w₁ w₂ : Key → V, (∀ k ∈ f.support, w₁ k = w₂ k) → f.check w₁ = f.check w₂


end Nanodregg.Lang.Contextual.Protocol
/-
# Lang.Contextual.Protocol — open protocols as typed families of continuations (lane PROTOCOL)

The object of the activities proposal's document 2: a protocol between parties is an OPEN object.
Its unspecified components are HOLES, each declared in a context `Ω` with an interface (where it
starts, what it must deliver, which reusable facts and which linear tokens it may use, which
obligations it may leave, who chooses its filling and which contract it must pass). Its
interactions with peers are `call op k` nodes whose continuation is a FAMILY indexed by the response
(`k : (r : Resp op) → Prot (next op r)`). A substitution is ONE filling per hole NAME, chosen before
anything is observed. Whether that separates a hole from an interaction depends on the NAMING, not
on the calculus: a template that puts the SAME name in every response branch gets one filling for
all of them (`Proofs.Contextual.Protocol.Coin.no_foresight`), but a template whose hole names
depend on the response (`call op fun r => hole (h r)`) gets a filling per response, which is
foresight (`response_indexed_names_have_foresight`; `foresight_iff_names_separate` is the exact
condition). Scope (one filling into every branch unchanged) is a naming discipline the author
keeps; the calculus does not enforce it. Its resources are tokens a `call` of a consuming operation
spends. The discipline is AFFINE: a token is spent at most once, and a token left unspent at `ret`
is allowed. There is one kind on purpose (PROT-8, LANG-75.18): LINEAR value is the kernel's, which
conserves every denomination over an admitted turn (`Kernel.Proofs.Value.admit_value`), and the
deployed offer that moves value (`Lang.StdOfferEscrow`) moves its leg in the same tree as every
retract of its row. A linear `Val` kind here would be a second count of the same value, with no
deployed reader. Its executed prefix is a history (`Hist`), possibly ending in a call
whose reply was lost (`inflight`), and a re-substitution must leave every hole the history has
already entered alone (`Dispatched`). The deployed lost reply is the resident's `AskEnd.lost` and
the kernel's journal-first retry; what each does with it is `Hosting.Proofs.LostReply`
(PROT-5: one Boolean per peer, `Peer.reliable`).

The shape generalises minidregg's `Theory/IndexedProgram.lean` (restated in Lean core, law 11): its
`IxSignature`/`Program` gain a third constructor `hole`, its `Algebra` a hole case, its interpreter
a `stuck` outcome (doc 2 section 7: partiality visible in the result type). A hole filled when the
run reaches it, from candidates under live supports, is `Lang.Contextual.Slot`; the deployed
resident's tick (`Hosting.Resident.Prog`) is a term of this calculus at a trivial index with two such
holes (`serve`, `use`), run by `Slot.interp`.

The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, A) ⊣ Φ` is `HasProt sp Ω Γ Q Φ Δ P`: `Γ` the reusable facts
(hypothetical: derivability is not current availability, `admits`), `Δ` the linear tokens (a bag:
`SubBag`), `Q` the result postcondition, `Φ` the obligations any completion may still owe (an upper
bound). Substitution is SINGLE-PASS: `subst σ` replaces each hole by its filling and does not
substitute into the filling, so a filling's own holes stay open under the same `σ`. Definitions only. The statements (`HasProt`, `Runs`, `Reach`, `Started`, `Dispatched`, `SubBag`,
`Fills`, `SubstOK`, ...) are in `Lang.Proofs.Contextual.ProtocolTyping`; the theorems are in
`Lang.Proofs.Contextual.Protocol`, `Lang.Proofs.Contextual.Negotiation` and
`Hosting.Proofs.LostReply`.
-/

namespace Nanodregg.Lang.Contextual.Protocol

/-! ## Signatures, the accounting of an operation, the chooser -/

/-- An indexed signature (mini's `IxSignature`, restated): at index `i` the operations `Op i`; each
operation's response type; the response selects the next index. -/
structure Sig (Ix : Type) where
  Op : Ix → Type
  Resp : {i : Ix} → Op i → Type
  next : {i : Ix} → (op : Op i) → Resp op → Ix

/-- What one operation does to the accounts: the linear token it SPENDS (if any), the reusable
facts it REQUIRES (authority, evidence: used, never consumed), and the obligations its DISPATCH
establishes (established when the call leaves, whatever the reply). -/
structure Spec {Ix : Type} (S : Sig Ix) (Tok Fact Ob : Type) where
  consumes : {i : Ix} → S.Op i → Option Tok
  requires : {i : Ix} → S.Op i → List Fact
  establishes : {i : Ix} → S.Op i → List Ob

/-- Who chooses a hole's filling, as the judgment uses it: `me`, the party whose protocol is judged
(`HasProt` admits a hole only with `chooser = .me`), or `other`, whose hole `fill` never fills. Two
values because every rule tests exactly that; nothing here tells two other parties apart (LANG-75.15). -/
inductive Chooser
  | me
  | other
deriving DecidableEq, Repr

/-! ## Open protocols -/

/-- The free open protocol over `S` with result family `A` and hole names `Hole`: return a result,
interact (`call`: one continuation per response, at the index the response selects), or leave a
named component unspecified (`hole h`, its interface in the context `Ω`, as a CMTT metavariable
refers to the meta-context). -/
inductive Prot {Ix : Type} (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) : Ix → Type where
  | ret {i : Ix} (a : A i) : Prot S Hole A i
  | call {i : Ix} (op : S.Op i) (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) :
      Prot S Hole A i
  | hole {i : Ix} (h : Hole i) : Prot S Hole A i

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- A hole's interface `u :: [Γ_u; Δ_u ⊢ Protocol(i, post)] ⊣ owes`, with its chooser and an
acceptance contract that every filling must pass (`Fills`). The start index is the hole name's
index. -/
structure Iface (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  /-- who chooses the filling -/
  chooser : Chooser
  /-- the reusable facts a filling may require (`Γ_u`) -/
  ctx : List Fact
  /-- the tokens a filling may spend (`Δ_u`) -/
  need : List Tok
  /-- what every result a filling delivers satisfies -/
  post : (j : Ix) → A j → Prop
  /-- the obligations a filling may leave -/
  owes : List Ob
  /-- the acceptance contract on a filling -/
  accepts : Prot S Hole A i → Prop

/-- `Ω`: the declared interface of every unresolved component. -/
abbrev Ctx (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) :=
  (i : Ix) → Hole i → Option (Iface S Hole A Tok Fact Ob i)

/-- `σ`: a partial substitution, a filling for some holes (doc 2 section 9). -/
abbrev Subst (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) :=
  (i : Ix) → Hole i → Option (Prot S Hole A i)

/-- Typed substitution: every hole `σ` fills is replaced by its filling; nothing else moves. -/
def subst (σ : Subst S Hole A) : {i : Ix} → Prot S Hole A i → Prot S Hole A i
  | _, .ret a => .ret a
  | _, .call op k => .call op fun r => subst σ (k r)

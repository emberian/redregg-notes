/-- The hex of a description's `object HEX` line (`Protocol.Command.describe`'s first line). -/
def objectWords : List Char → Option (List Char)
  | 'o' :: 'b' :: 'j' :: 'e' :: 'c' :: 't' :: ' ' :: rest => some rest
  | _ => none

/-- The description names the object `bell`: its `object` line's hex is `bell`'s bytes. -/
def objectNamed (bell : ByteArray) (ls : List (List Char)) : Bool :=
  match ls.findSome? objectWords with
  | some hx => Protocol.Text.ofHex (String.ofList hx) == some bell
  | none => false

/-- The shape from the description of the configured bell (HOSTING-49, law 4: the premise "this
reply describes `bell`" crosses the member socket, so it is asserted where it enters): the `object`
line names `bell` or the description is refused `wrongObject`; then `Shape.read`. -/
def Shape.ofDescription (bell : ByteArray) (out : String) : Except String Shape :=
  if objectNamed bell (splitLines out.toList) then Shape.read out else .error "wrongObject"

/-! ## An aim (HOSTING-53) -/

/-- An AIM, as a ring's capture holds it (`Lang.Bell.aimTy`): where the ring's answer is delivered.
The target object, the index of its method, the grant the Bell object holds on it (`via`), and the
candidate id the ringer chose. The resident carries it from the pending row to its answer unread. -/
structure Aim where
  cand : ByteArray
  method : Nat
  target : ByteArray
  via : ByteArray
  deriving DecidableEq

def Aim.data (a : Aim) : Data := Lang.Bell.aimData a.cand a.method a.target a.via

/-- An optional aim as the `to` field's datum (`Lang.Bell.toData` of the aim's data; `toDatum_eq`). -/
def toDatum : Option Aim → Data
  | none => .inj "none" (.record [])
  | some a => .inj "some" a.data

/-! ## A ring -/

/-- A pending ring: its key (the signed notBefore it rang at, who rang), its text and its aim. -/
structure Ring where
  notBefore : Nat
  ringer : ByteArray
  text : ByteArray
  to : Option Aim
  deriving DecidableEq

/-- A ring as the activity cursor row: key agent/notBefore, captured ask/{text, to}.
The declared key order remains notBefore then agent; the record labels are canonical. -/
def Ring.row (r : Ring) : Data :=
  .record [("key", .record [("agent", .digest r.ringer), ("notBefore", .nat r.notBefore)]),
    ("val", .record [("captured", .inj "ask" (.record [("text", .bytes r.text), ("to", toDatum r.to)]))])]

/-- The ring in a row datum, or why the datum is not a pending row. -/
def Ring.ofRow : Data → Except String Ring
  | .record [("key", .record [("agent", .digest g), ("notBefore", .nat n)]),
      ("val", .record [("captured", .inj "ask" (.record [("text", .bytes t), ("to", .inj "none" (.record []))]))])] =>
    .ok ⟨n, g, t, none⟩
  | .record [("key", .record [("agent", .digest g), ("notBefore", .nat n)]),
      ("val", .record [("captured", .inj "ask" (.record [("text", .bytes t), ("to", .inj "some" (.record
        [("cand", .digest c), ("method", .nat m), ("target", .digest o), ("via", .digest v)]))]))])] =>
    .ok ⟨n, g, t, some ⟨c, m, o, v⟩⟩
  | _ => .error "rowFields"

/-- One line of `read OBJ pending K`, read at `pending`'s row type. -/
def Ring.read (sh : Shape) (line : String) : Except String Ring :=
  match Read.readData (rowTy sh.pending) line with
  | .ok v => Ring.ofRow v
  | .error e => .error s!"rowUnread {e.name}"

/-- Every pending ring, in the order the range read lists them (key order: ring order). The
output's lines end in a line feed; a blank line is no row. The lines are the description's own
splitter's (`splitLines`, HOSTING-49: one splitter for the member surface's one output grammar). -/
def Ring.readAll (sh : Shape) (out : String) : Except String (List Ring) :=
  ((splitLines out.toList).filter (· ≠ [])).mapM fun l => Ring.read sh (String.ofList l)

/-! ## Deciding a tick -/

/-- What the resident does this tick. -/
inductive Act
  | idle
  /-- ask keybroker for this ring (a NEW ask: the meter is charged) -/
  | ask (r : Ring)
  /-- answer this pending ring with this text (decided earlier; no ask) -/
  | answer (r : Ring) (text : ByteArray)
  deriving DecidableEq

/-- The decision over every pending ring, lowest first. A kept ring (its answer decided by an
earlier ask) that is still pending is answered with its text, wherever it stands in the queue; with
none, the lowest pending ring is asked about; nothing pending is idle. -/
def decideTick (pending : List Ring) (kept : Option (Ring × ByteArray)) : Act :=
  match kept with
  | some (r, t) => if r ∈ pending then .answer r t else
      match pending with
      | [] => .idle
      | q :: _ => .ask q
  | none =>
      match pending with
      | [] => .idle
      | q :: _ => .ask q

/-! ## The answer -/

/-- The longest answer text: the upper bound of the `text` field among the Bell's own `answer`
bounds (`Lang.Bell.answerBounds`, which the package `bellCore` accepts carries: `Lang.Bell.shapeOk`
checks its `answer` term, `boundCheck` over these bounds). One definition, Lang's (HOSTING-49); a
text the bell still refuses ends the resident by that refusal's name, never as a second ask. -/
def textMax : Nat := ((Lang.Bell.answerBounds.find? (·.path == ["text"])).map (·.hi)).getD 0

/-- Whether a byte continues a UTF-8 sequence (`10xxxxxx`). -/
def continues (b : UInt8) : Bool := b &&& 0xC0 == 0x80

/-- `t`'s longest prefix of at most `n` bytes that ends on a UTF-8 boundary. -/
def utf8Prefix (t : ByteArray) (n : Nat) : ByteArray :=
  if t.size ≤ n then t else go n
where
  go : Nat → ByteArray
    | 0 => ByteArray.empty
    | k + 1 => if continues t[k + 1]! then go k else t.extract 0 (k + 1)

/-- What the resident answers when the ask brought no reply text: a short text naming it. -/
def named (what : String) : ByteArray := s!"({what})".toUTF8

/-- A text the bell takes: cut to `textMax` at a UTF-8 boundary; an empty one is named
(`Proofs.Resident.fit_size`: always 1..`textMax` bytes). -/
def fit (t : ByteArray) : ByteArray :=
  let u := utf8Prefix t textMax
  if u.isEmpty then named "empty reply" else u

/-- The answer text for what keybroker answered: the reply, or a short text naming the refusal or
the status, each fitted. -/
def answerText : Broker.Answer → ByteArray
  | .reply t => fit t
  | .refused why => fit (named s!"refused {why.name}")
  | .status c => fit (named s!"status {c}")

/-- The `answer` argument's datum, at `answerArgTy`: the ring's key, the ring's text and aim re-sent,
the answer text (the witness's `Lang.Bell.answerData`). -/
def answerDatum (r : Ring) (t : ByteArray) : Data :=
  Lang.Bell.answerData r.notBefore r.text r.ringer t (r.to.map Aim.data)

/-- The `answer` argument for ring `r`, through Lang's one printer. -/
def answerArg (r : Ring) (t : ByteArray) : Option String := Print.data (answerDatum r t)

/-- The ask for a ring: the ring's text as the one user message. -/
def askOf (c : Conf) (r : Ring) : Broker.Ask :=
  { model := c.model, maxTokens := c.maxTokens, system := c.system, roles := ⟨#[0]⟩, texts := [r.text] }

/-! ## What the volume keeps: a ring and its decided answer -/

/-- One kept record: the ring (key, text and aim) and the answer decided for it. -/
def keptTy : Ty :=
  .record [("answer", .bytes), ("notBefore", .nat), ("ringer", .digest), ("text", .bytes), ("to", optTy Lang.Bell.aimTy)]

def keptDatum (r : Ring) (t : ByteArray) : Data :=
  .record [("answer", .bytes t), ("notBefore", .nat r.notBefore), ("ringer", .digest r.ringer),
    ("text", .bytes r.text), ("to", toDatum r.to)]

def keptText (r : Ring) (t : ByteArray) : Option String := Print.data (keptDatum r t)

def keptRead (s : String) : Option (Ring × ByteArray) :=
  match Read.readData keptTy s with
  | .ok (.record [("answer", .bytes t), ("notBefore", .nat n), ("ringer", .digest g), ("text", .bytes x),
      ("to", .inj "none" (.record []))]) =>
    some (⟨n, g, x, none⟩, t)
  | .ok (.record [("answer", .bytes t), ("notBefore", .nat n), ("ringer", .digest g), ("text", .bytes x),
      ("to", .inj "some" (.record [("cand", .digest c), ("method", .nat m), ("target", .digest o), ("via", .digest v)]))]) =>
    some (⟨n, g, x, some ⟨c, m, o, v⟩⟩, t)
  | _ => none

/-! ## What the volume keeps: the withdrawn rings -/

/-- One withdrawn ring: the ring (key, text and aim) and the name of the cell its probe found gone. -/
def withdrawnTy : Ty :=
  .record [("cell", .bytes), ("notBefore", .nat), ("ringer", .digest), ("text", .bytes), ("to", optTy Lang.Bell.aimTy)]

def withdrawnDatum (r : Ring) (c : String) : Data :=
  .record [("cell", .bytes c.toUTF8), ("notBefore", .nat r.notBefore), ("ringer", .digest r.ringer),
    ("text", .bytes r.text), ("to", toDatum r.to)]

/-- The withdrawn rings as text: one printed value a line (a printed value is one line,
`Lang.Proofs.Print.data_one_line`); none withdrawn is the empty text. -/
def notedText (l : List (Ring × String)) : Option String :=
  (l.mapM fun x => Print.data (withdrawnDatum x.1 x.2)).map ("\n".intercalate)

/-- One line of the withdrawn file. -/
def notedLine (s : String) : Option (Ring × String) :=
  match Read.readData withdrawnTy s with
  | .ok (.record [("cell", .bytes c), ("notBefore", .nat n), ("ringer", .digest g), ("text", .bytes x),
      ("to", .inj "none" (.record []))]) =>
    (String.fromUTF8? c).map fun c => (⟨n, g, x, none⟩, c)
  | .ok (.record [("cell", .bytes c), ("notBefore", .nat n), ("ringer", .digest g), ("text", .bytes x),
      ("to", .inj "some" (.record [("cand", .digest d), ("method", .nat m), ("target", .digest o), ("via", .digest v)]))]) =>
    (String.fromUTF8? c).map fun c => (⟨n, g, x, some ⟨d, m, o, v⟩⟩, c)
  | _ => none

/-- The withdrawn file's text as the list it holds, or none when a line does not read. -/
def notedRead (s : String) : Option (List (Ring × String)) :=
  if s.isEmpty then some [] else (s.splitOn "\n").mapM notedLine

/-! ## The member commands (`nd --stdio`'s argv) -/

def hexOf (b : ByteArray) : ByteArray := (Print.hex b).toUTF8

def describeArgv (c : Conf) : List ByteArray := ["read".toUTF8, hexOf c.bell, "?".toUTF8]
/-- `read OBJ pending K`, K = `pending`'s declared limit (the range read refuses past it). -/
def pendingArgv (c : Conf) (sh : Shape) : List ByteArray :=
  ["read".toUTF8, hexOf c.bell, "pending".toUTF8, (toString sh.pending.limit).toUTF8]
/-- The row an aimed answer pins beside what its derivation asks for (HOSTING-58): the target's fact
row the forward's support cites (`Lang.Bell.forwardRel` at `Lang.Bell.forwardKey a.via`), as
`--pin TARGET/REL KEY` (a row of another object, CLIENT-50). A hole reads its facts as the caller's points, which no derivation can
choose; the key is a function of the aim alone, so the resident still reads nothing of the target. -/
def forwardPin : Option Aim → List ByteArray
  | none => []
  | some a => match Print.data (Lang.Bell.forwardKey a.via) with
    | some k => ["--pin".toUTF8, (Print.hex a.target ++ "/" ++ Lang.Bell.forwardRel).toUTF8, k.toUTF8]
    | none => []

def invokeArgv (c : Conf) (sh : Shape) (to : Option Aim) (arg : String) : List ByteArray :=
  ["invoke".toUTF8, hexOf c.bell, (toString sh.answer).toUTF8, arg.toUTF8] ++ forwardPin to ++
    ["--via".toUTF8, hexOf c.grant]

end Nanodregg.Hosting.Resident
/-
# Hosting.Proofs.ResidentSlots — the resident's repair is the slot's (`Lang.Contextual.Slot.slot_repair`)

The resident's tick has two holes (`Hosting.Resident.Hole`), each filled from a slot when the run reaches
it. This module states the resident's repair as the slot's, at those two slots.

- `resident_repair` (`slot_repair` at the `serve` slot, at the view of one read): an act on a ring is
  usable iff the ring is pending in this read and its answer stands; a blocked act names exactly the
  supports that fail; the act the slot fills is usable.
- `use_withdraws`: an answer refused while its ring still waits, a cell the answer cites (the aim's
  `via` grant or its target) probed and found gone (`read CELL ?` refused `missingCell`), is WITHDRAWN
  by that name: the log line names the cell, the kept answer is forgotten, and the ring joins
  `Mem.withdrawn` under the cell's name.
- `withdrawn_blocked`, `withdrawn_not_served`: a withdrawn ring's acts read blocked by the name
  `stands r` while it is listed, and the `serve` slot never fills with them.
- `serve_keeps_withdrawn`: a withdrawal lasts while the ring is listed: every tick's `serve` hole hands
  it on to the next tick's memory (`slot_repair`'s permanence, along ticks that list the ring).
- `serve_repairs`: the repair. With the withdrawn ring skipped, the slot fills with the next live ring's
  ask, in the same tick, which reads usable with its evidence: no restart, no reinstall.

What is not here: the withdrawn list is memory, not the volume. A restart asks a withdrawn ring once
more (one meter charge) and withdraws it again.
-/
import Hosting.Proofs.ResidentRun

namespace Nanodregg.Hosting.Proofs.ResidentSlots

open Nanodregg.Hosting Nanodregg.Hosting.Resident Nanodregg.Hosting.Proofs.ResidentRun
open Nanodregg.Lang.Contextual.Slot

/-- `slot_repair` at the `serve` slot, at the view of one read (`serveHolds m p`): (1) an act is usable
iff every support it cites holds: for an act on a ring, the ring is pending in this read and its answer
stands; (2) a blocked act names exactly its failing supports, at least one; (3) a usable act reads usable
the moment it is selected, with its evidence; and (4) the act the slot fills (`serveChoice`) is usable. -/
theorem resident_repair (m : Mem) (p : List Ring) (c : Act) :
    ((∃ ev, serveSlot.read (serveHolds m p) (some c) = .usable c ev) ↔
        ∀ f ∈ serveSlot.supports c, serveHolds m p f = true) ∧
    (∀ c' d, serveSlot.read (serveHolds m p) (some c) = .blocked c' d →
        d ≠ [] ∧ ∀ f, f ∈ d ↔ f ∈ serveSlot.supports c ∧ serveHolds m p f = false) ∧
    (∀ c', serveSlot.usable (serveHolds m p) c' = true →
        serveSlot.read (serveHolds m p) (some c') = .usable c' (serveSlot.evidence (serveHolds m p) c')) ∧
    serveSlot.usable (serveHolds m p) (serveChoice m p) = true := by
  obtain ⟨h1, h2, -, h4⟩ := slot_repair serveSlot (fun (_ : Unit) => serveHolds m p) (fun _ _ => True) () c
  refine ⟨h1.trans (by simp [serveSlot]), h2, h4, ?_⟩
  unfold serveChoice
  cases ha : serveSlot.alternatives (serveHolds m p) (serveOrder m p) with
  | nil => simp [Slot.usable, Slot.dead, serveSlot]
  | cons a rest =>
    have : a ∈ serveSlot.alternatives (serveHolds m p) (serveOrder m p) := by rw [ha]; exact List.mem_cons_self
    exact (List.mem_filter.mp this).2

private theorem stands_false {m : Mem} {r : Ring} {c : String} (hw : (r, c) ∈ m.withdrawn) :
    stands m r = false := by
  simp only [stands, Bool.not_eq_eq_eq_not, Bool.not_false, List.any_eq_true, beq_iff_eq]
  exact ⟨(r, c), hw, rfl⟩

/-- A withdrawn ring's acts read BLOCKED by the name `stands r` (its only failing support) while the
read lists it: the answer is stored, not usable. -/
theorem withdrawn_blocked {m : Mem} {p : List Ring} {r : Ring} {c : String} (hw : (r, c) ∈ m.withdrawn)
    (hp : r ∈ p) :
    serveSlot.read (serveHolds m p) (some (.ask r)) = .blocked (.ask r) [.stands r] ∧
      ∀ t, serveSlot.read (serveHolds m p) (some (.answer r t)) = .blocked (.answer r t) [.stands r] := by
  have hs := stands_false hw
  refine ⟨?_, fun t => ?_⟩ <;>
    simp [Slot.read, Slot.dead, serveSlot, serveHolds, hp, hs]

/-- The `serve` slot never fills with a withdrawn ring's act: no ask about it, no answer for it. -/
theorem withdrawn_not_served {m : Mem} {p : List Ring} {r : Ring} {c : String} (hw : (r, c) ∈ m.withdrawn) :
    serveChoice m p ≠ .ask r ∧ ∀ t, serveChoice m p ≠ .answer r t := by
  have hs := stands_false hw
  have hl : r ∉ live m p := by simp [live, List.mem_filter, hs]
  rw [serveChoice_eq]
  refine ⟨fun h => ?_, fun t h => ?_⟩
  · obtain ⟨hh, -⟩ := Nanodregg.Hosting.Proofs.Resident.decide_ask h
    cases hlv : live m p with
    | nil => rw [hlv] at hh; cases hh
    | cons x xs =>
      rw [hlv] at hh; cases hh
      exact hl (by rw [hlv]; exact List.mem_cons_self)
  · exact hl (Nanodregg.Hosting.Proofs.Resident.decide_answer h).2

/-- The `use` slot withdraws only by the name of a cell the ring's answer cites that the probes found
gone, while the ring still waits. -/
theorem use_withdraw_names {r : Ring} {p : List Ring} {gone : List ByteArray} {c : ByteArray}
    (h : useChoice r p gone = .withdraw c) : r ∈ p ∧ c ∈ aimCells r ∧ c ∈ gone := by
  have hmem : UseCand.withdraw c ∈ useSlot.alternatives (useHolds r p gone) (useOrder r) := by
    unfold useChoice at h
    cases ha : useSlot.alternatives (useHolds r p gone) (useOrder r) with
    | nil => rw [ha] at h; cases h
    | cons a rest => rw [ha] at h; cases h; exact List.mem_cons_self
  obtain ⟨ho, hu⟩ := List.mem_filter.mp hmem
  simp [Slot.usable, Slot.dead, useSlot, useHolds] at hu
  simp [useOrder] at ho
  exact ⟨hu.1, ho, hu.2⟩

/-- **Withdrawn by name.** An answer refused while its ring waits, a cell the answer cites probed and
found gone (the `use` slot's `withdraw c`): every path that goes on says so naming the cell, forgets
the kept answer, and hands on a memory where the ring is withdrawn under the cell's name and nothing is
kept. -/
theorem use_withdraws {m m' : Mem} {r : Ring} {n line : String} {p : List Ring} {gone : List ByteArray}
    {c : ByteArray} {es : List Ev} (hc : useChoice r p gone = .withdraw c)
    (h : Runs (useP m r n line p gone) es (.next m')) :
    es = [.say s!"answer withdrawn {r.notBefore} {Lang.Print.hex r.ringer}: its support {Lang.Print.hex c} is gone ({line})",
      .note ((r, Lang.Print.hex c) :: m.withdrawn) true, .forget true] ∧
      (r, Lang.Print.hex c) ∈ m'.withdrawn ∧ m'.kept = none := by
  unfold useP at h
  rw [hc] at h
  cases h with
  | say h =>
    cases h with
    | note b h =>
      cases b
      · simp at h; cases h
      · simp only [if_true] at h
        obtain ⟨hn, rfl⟩ := forgetThen_next h
        cases hn
        exact ⟨rfl, List.mem_cons_self, rfl⟩

/-! ## A withdrawal lasts while the ring is listed -/

theorem useP_withdrawn {m m' : Mem} {r : Ring} {n line : String} {p : List Ring} {gone : List ByteArray}
    {es : List Ev} (h : Runs (useP m r n line p gone) es (.next m')) : ∀ x ∈ m.withdrawn, x ∈ m'.withdrawn := by
  unfold useP at h
  split at h
  · cases h with | say h => obtain ⟨hn, -⟩ := forgetThen_next h; cases hn; exact fun x hx => hx
  · cases h with
    | say h =>
      cases h with
      | note b h =>
        cases b
        · simp at h; cases h
        · simp only [if_true] at h
          obtain ⟨hn, -⟩ := forgetThen_next h; cases hn; exact fun x hx => List.mem_cons_of_mem _ hx
  · cases h

theorem refusedP_withdrawn {sh : Shape} {m m' : Mem} {r : Ring} {n line : String} {p : List Ring}
    {es : List Ev} (h : Runs (refusedP sh m r n line p) es (.next m')) : ∀ x ∈ m.withdrawn, x ∈ m'.withdrawn := by
  obtain ⟨pre, rest, rfl, -, hr⟩ := refusedP_path h
  rcases hr with ⟨c, y, s, why, rfl, -, hr⟩ | ⟨gone, hr⟩
  · obtain rfl := retry_next hr.symm; exact fun x hx => hx
  · exact useP_withdrawn hr

theorem deliver_withdrawn {sh : Shape} {m m' : Mem} {r : Ring} {t : ByteArray} {es : List Ev}
    (h : Runs (deliverP sh m r t) es (.next m')) : ∀ x ∈ m.withdrawn, x ∈ m'.withdrawn := by
  unfold deliverP at h
  split at h
  · cases h
  · cases h with
    | cmd x h =>
      rcases x with e | rr
      · simp only at h; cases h with | say h => obtain ⟨-, rfl⟩ := done_retry h; exact fun x hx => hx
      · simp only at h
        split at h
        · cases h with
          | say h => obtain ⟨hn, -⟩ := forgetThen_next h; cases hn; exact fun x hx => hx
        · split at h
          · cases h with
            | cmd y h =>
              rcases y with e | rr'
              · simp only at h
                cases h with | say h => obtain ⟨-, rfl⟩ := done_retry h; exact fun x hx => hx
              · simp only at h
                split at h
                · cases h with | say h => obtain ⟨-, rfl⟩ := done_retry h; exact fun x hx => hx
                · split at h
                  · cases h
                  · exact refusedP_withdrawn h
          · cases h with | say h => obtain ⟨-, rfl⟩ := done_retry h; exact fun x hx => hx

theorem answered_withdrawn {sh : Shape} {m m' : Mem} {r : Ring} {t : ByteArray} {es : List Ev}
    (h : Runs (answeredP sh m r t) es (.next m')) : ∀ x ∈ m.withdrawn, x ∈ m'.withdrawn := by
  unfold answeredP at h
  cases h with
  | say h =>
    cases h with
    | keep b h =>
      cases b
      · simp at h; cases h
      · simp only [if_true] at h; exact deliver_withdrawn (m := { m with kept := some (r, t) }) h

theorem actOn_withdrawn {w : Where} {sh : Shape} {m m' : Mem} {p : List Ring} {es : List Ev}
    (h : Runs (actOn w sh m p) es (.next m')) : ∀ x ∈ m.withdrawn, x ∈ m'.withdrawn := by
  unfold actOn at h
  split at h
  · split at h
    · obtain ⟨hn, -⟩ := forgetThen_next h; cases hn; exact fun x hx => hx
    · cases h; exact fun x hx => hx
  · exact deliver_withdrawn h
  · cases h with
    | keep b h =>
      cases b
      · simp at h; cases h
      · simp only [Bool.not_true, Bool.false_eq_true, if_false] at h
        cases h with
        | ask x h =>
          rcases x with why | ans | why
          · simp only at h
            cases h with
            | say h =>
              obtain ⟨hn, -⟩ := forgetThen_next h
              obtain rfl := retry_next hn
              exact fun x hx => hx
          · simp only at h; exact answered_withdrawn h
          · simp only at h; cases h with | say h => exact answered_withdrawn h

/-- **A withdrawal lasts while the ring is listed.** The `serve` hole, reached with the read `p`, hands
every withdrawal of a ring `p` still lists on to the next tick's memory: along ticks that list the ring,
`stands r` is false at every later view, the permanence `slot_repair`'s third clause asks for. -/
theorem serve_keeps_withdrawn {w : Where} {sh : Shape} {m m' : Mem} {p : List Ring} {es : List Ev}
    (h : Runs (fill (.serve w sh m p)) es (.next m')) {x : Ring × String} (hx : x ∈ m.withdrawn)
    (hp : x.1 ∈ p) : x ∈ m'.withdrawn :=
  actOn_withdrawn (m := m.prune p) h x (List.mem_filter.mpr ⟨hx, decide_eq_true hp⟩)

/-! ## The repair -/

/-- **The repair: no restart, no reinstall.** When the kept answer is not live (withdrawn, gone, or
none) and `q` is the first ring whose answer stands, the `serve` slot fills with the ask about `q` in
this tick, and that act reads usable with its evidence: the same slot, another candidate. -/
theorem serve_repairs {m : Mem} {p : List Ring} {q : Ring}
    (hk : ∀ r t, m.kept = some (r, t) → r ∉ live m p) (hq : (live m p).head? = some q) :
    serveChoice m p = .ask q ∧
      serveSlot.read (serveHolds m p) (some (.ask q)) =
        .usable (.ask q) (serveSlot.evidence (serveHolds m p) (.ask q)) := by
  have hc : serveChoice m p = .ask q := by
    rw [serveChoice_eq]
    cases hl : live m p with
    | nil => rw [hl] at hq; cases hq
    | cons y ys =>
      rw [hl] at hq hk
      cases hq
      unfold decideTick
      cases hkm : m.kept with
      | none => rfl
      | some rt =>
        obtain ⟨r, t⟩ := rt
        simp [hk r t hkm]
  refine ⟨hc, (resident_repair m p (.ask q)).2.2.1 _ ?_⟩
  have := (resident_repair m p (.ask q)).2.2.2
  rwa [hc] at this

end Nanodregg.Hosting.Proofs.ResidentSlots


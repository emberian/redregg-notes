/-
# Lang.Contextual.Slot — a hole resolved when it is reached, from candidates under live supports

The calculus in `Lang.Contextual.Protocol` fills a hole by a substitution chosen before anything is
observed, and its interpreter stops `stuck` at a hole. A program that runs against a World decides
later: when the run reaches the hole, it looks at the World and takes a candidate whose supports hold
there. This module adds that.

A SLOT is a set of candidates. Each candidate cites SUPPORTS (facts a view can be asked about) and must
pass a JUDGE (the interface contract, independent of the view). A slot may hold a STORED selection. At a
view the selection is USABLE when it passes the judge and every support it cites holds; otherwise it is
BLOCKED, and the read names exactly the supports that do not hold. Stored and usable are different
things: a stored selection stays stored while it is blocked, and a read says which it is.

`slot_repair` is the one repair theorem. A selection is usable at a view iff every support it cites
holds there. A blocked read names every dead support of the selection and nothing else. A support that
is PERMANENT (false once means false at every later view of the World: a retired cell, an answered
ring) keeps the selection blocked, by that name, at every later view. And a candidate whose supports
hold is usable the moment it is selected: the repair changes the selection and nothing else of the slot.

`interp` runs a protocol whose holes a RESOLVER fills when reached; a resolver may refuse, and the run
then ends `withdrawn` with the resolver's reason. `Slot.resolve` is the resolver a slot gives.
-/
import Lang.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.Slot

open Nanodregg.Lang.Contextual.Protocol

/-- A slot over candidates `Cand` whose supports are facts `Fact`. -/
structure Slot (Fact Cand : Type) where
  /-- the facts a candidate cites -/
  supports : Cand → List Fact
  /-- the contract every filling must pass, whatever the view -/
  judge : Cand → Bool

section
variable {Fact Cand : Type}

/-- The supports of `c` that do not hold. -/
def Slot.dead (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) : List Fact :=
  (S.supports c).filter fun f => !holds f

/-- Every support of `c`, with whether it holds: the evidence a read shows. -/
def Slot.evidence (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) : List (Fact × Bool) :=
  (S.supports c).map fun f => (f, holds f)

/-- `c` passes the judge and every support it cites holds. -/
def Slot.usable (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) : Bool :=
  S.judge c && (S.dead holds c).isEmpty

/-- The candidates usable at the view, in order. -/
def Slot.alternatives (S : Slot Fact Cand) (holds : Fact → Bool) (cands : List Cand) : List Cand :=
  cands.filter (S.usable holds)

/-- What a read of a slot's stored selection says. -/
inductive Reading (Fact Cand : Type)
  /-- nothing is selected -/
  | empty
  /-- the selection fails the judge -/
  | rejected (c : Cand)
  /-- the selection is usable; every support it cites, each holding -/
  | usable (c : Cand) (evidence : List (Fact × Bool))
  /-- the selection is stored but not usable; the supports that do not hold, by name -/
  | blocked (c : Cand) (dead : List Fact)

/-- Read a stored selection at a view. -/
def Slot.read (S : Slot Fact Cand) (holds : Fact → Bool) : Option Cand → Reading Fact Cand
  | none => .empty
  | some c =>
    if S.judge c then
      match S.dead holds c with
      | [] => .usable c (S.evidence holds c)
      | d => .blocked c d
    else .rejected c

theorem dead_eq_nil_iff (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) :
    S.dead holds c = [] ↔ ∀ f ∈ S.supports c, holds f = true := by
  simp [Slot.dead, List.filter_eq_nil_iff]

theorem mem_dead_iff (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) (f : Fact) :
    f ∈ S.dead holds c ↔ f ∈ S.supports c ∧ holds f = false := by
  simp [Slot.dead, List.mem_filter]

theorem usable_iff (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) :
    S.usable holds c = true ↔ S.judge c = true ∧ ∀ f ∈ S.supports c, holds f = true := by
  simp [Slot.usable, List.isEmpty_iff, dead_eq_nil_iff]

/-- A read is usable iff the selection passes the judge and every support it cites holds. -/
theorem read_usable_iff (S : Slot Fact Cand) (holds : Fact → Bool) (c : Cand) :
    (∃ ev, S.read holds (some c) = .usable c ev) ↔ S.usable holds c = true := by
  rw [usable_iff]
  unfold Slot.read
  by_cases hj : S.judge c = true
  · simp only [hj, if_true, true_and]
    rw [← dead_eq_nil_iff]
    cases h : S.dead holds c with
    | nil => exact ⟨fun _ => rfl, fun _ => ⟨_, rfl⟩⟩
    | cons f d => simp
  · simp [hj]

/-- A blocked read names every support of the selection that does not hold, and nothing else, and
names at least one. -/
theorem read_blocked_names (S : Slot Fact Cand) (holds : Fact → Bool) {c c' : Cand} {d : List Fact}
    (h : S.read holds (some c) = .blocked c' d) :
    c' = c ∧ d ≠ [] ∧ ∀ f, f ∈ d ↔ f ∈ S.supports c ∧ holds f = false := by
  unfold Slot.read at h
  by_cases hj : S.judge c = true
  · simp only [hj, if_true] at h
    cases hd : S.dead holds c with
    | nil => simp [hd] at h
    | cons f t =>
      simp only [hd, Reading.blocked.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨rfl, List.cons_ne_nil _ _, fun g => by rw [← hd, mem_dead_iff]⟩
  · simp [hj] at h

/-- A support is PERMANENT along a relation of views when, false at a view, it is false at every view
the relation reaches from it. -/
def Permanent {V : Type} (holdsAt : V → Fact → Bool) (later : V → V → Prop) (f : Fact) : Prop :=
  ∀ v v', later v v' → holdsAt v f = false → holdsAt v' f = false

/-- The ONE repair theorem.
(1) A stored selection is usable at a view iff it passes the judge and every support it cites holds.
(2) A blocked read names exactly the dead supports of the selection, at least one.
(3) A dead PERMANENT support keeps the selection blocked, by that name, at every later view.
(4) A candidate that is usable at the view reads usable as soon as it is selected, with its evidence;
    the slot (its supports and its judge) is the same slot: nothing is reinstalled. -/
theorem slot_repair {V : Type} (S : Slot Fact Cand) (holdsAt : V → Fact → Bool)
    (later : V → V → Prop) (v : V) (c : Cand) :
    ((∃ ev, S.read (holdsAt v) (some c) = .usable c ev) ↔
        S.judge c = true ∧ ∀ f ∈ S.supports c, holdsAt v f = true) ∧
    (∀ c' d, S.read (holdsAt v) (some c) = .blocked c' d →
        d ≠ [] ∧ ∀ f, f ∈ d ↔ f ∈ S.supports c ∧ holdsAt v f = false) ∧
    (∀ f, f ∈ S.supports c → holdsAt v f = false → Permanent holdsAt later f →
        ∀ v', later v v' → S.judge c = true →
          ∃ d, S.read (holdsAt v') (some c) = .blocked c d ∧ f ∈ d) ∧
    (∀ c', S.usable (holdsAt v) c' = true →
        S.read (holdsAt v) (some c') = .usable c' (S.evidence (holdsAt v) c')) := by
  refine ⟨(read_usable_iff S _ c).trans (usable_iff S _ c), ?_, ?_, ?_⟩
  · intro c' d h
    exact (read_blocked_names S _ h).2
  · intro f hf hdead hperm v' hv' hj
    have hf' : holdsAt v' f = false := hperm v v' hv' hdead
    have hmem : f ∈ S.dead (holdsAt v') c := (mem_dead_iff S _ c f).2 ⟨hf, hf'⟩
    unfold Slot.read
    simp only [hj, if_true]
    cases hd : S.dead (holdsAt v') c with
    | nil => rw [hd] at hmem; cases hmem
    | cons g t => exact ⟨g :: t, rfl, hd ▸ hmem⟩
  · intro c' hu
    have ⟨hj, hall⟩ := (usable_iff S _ c').1 hu
    have hd : S.dead (holdsAt v) c' = [] := (dead_eq_nil_iff S _ c').2 hall
    unfold Slot.read
    simp [hj, hd]

end

/-! ## Resolution when a hole is reached -/

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- How a run with resolved holes ends: a result, or WITHDRAWN at a hole its resolver refused, with
the resolver's reason (for a slot: the dead supports, by name), or out of the static bound on how
many holes one run may resolve. -/
inductive Out (Hole : Ix → Type) (A : Ix → Type) (W : Type) where
  | done (j : Ix) (a : A j)
  | withdrawn (j : Ix) (h : Hole j) (why : W)
  | bound (j : Ix) (h : Hole j)

/-- The algebra of one run in a monad: a call is performed by `call` and the run goes on with its
response; a hole is `hole`'s. -/
def runAlg {M : Type → Type} [Monad M] {W : Type}
    (call : {i : Ix} → (op : S.Op i) → M (S.Resp op))
    (hole : {i : Ix} → Hole i → M (Out Hole A W)) :
    Algebra S Hole A (fun _ => M (Out Hole A W)) where
  ret := fun {i} a => pure (.done i a)
  call := fun op k => do let r ← call op; k r
  hole := hole

/-- Run an open protocol in a monad: each call is performed by `call`; each hole is filled when it is
reached by `resolve`, which may refuse. `n` bounds the depth of holes one run resolves (a filling may
itself hold holes). -/
def interp {M : Type → Type} [Monad M] {W : Type}
    (call : {i : Ix} → (op : S.Op i) → M (S.Resp op))
    (resolve : {i : Ix} → Hole i → Except W (Prot S Hole A i)) :
    Nat → {i : Ix} → Prot S Hole A i → M (Out Hole A W)
  | 0 => fold (runAlg call fun {i} h => pure (.bound i h))
  | n + 1 => fold (runAlg call fun {i} h => match resolve h with
    | .ok f => interp call resolve n f
    | .error w => pure (.withdrawn i h w))

/-- Every path of a run with resolved holes: the calls with their responses, and how it ends. `n`
is the depth bound, as `interp`'s. -/
inductive RunsR {W : Type} (resolve : {i : Ix} → Hole i → Except W (Prot S Hole A i)) :
    Nat → {i : Ix} → Prot S Hole A i → Trace S → Out Hole A W → Prop
  | ret {n : Nat} {i : Ix} (a : A i) : RunsR resolve n (.ret a) [] (.done i a)
  | call {n : Nat} {i : Ix} {op : S.Op i} {k : (r : S.Resp op) → Prot S Hole A (S.next op r)}
      {tr : Trace S} {o : Out Hole A W} (r : S.Resp op) :
      RunsR resolve n (k r) tr o → RunsR resolve n (.call op k) (⟨i, op, r⟩ :: tr) o
  | bound {i : Ix} (h : Hole i) : RunsR resolve 0 (.hole h) [] (.bound i h)
  | fill {n : Nat} {i : Ix} {h : Hole i} {f : Prot S Hole A i} {tr : Trace S} {o : Out Hole A W} :
      resolve h = .ok f → RunsR resolve n f tr o → RunsR resolve (n + 1) (.hole h) tr o
  | withdraw {n : Nat} {i : Ix} {h : Hole i} {w : W} :
      resolve h = .error w → RunsR resolve (n + 1) (.hole h) [] (.withdrawn i h w)

/-- A hole whose resolver refuses ends the run there, with the reason, and performs nothing. -/
theorem runsR_withdrawn {W : Type} {resolve : {i : Ix} → Hole i → Except W (Prot S Hole A i)}
    {n : Nat} {i : Ix} {h : Hole i} {w : W} (hw : resolve h = .error w) {tr : Trace S}
    {o : Out Hole A W} (hr : RunsR resolve (n + 1) (.hole h) tr o) :
    tr = [] ∧ o = .withdrawn i h w := by
  cases hr with
  | fill hf _ => rw [hw] at hf; cases hf
  | withdraw hw' => rw [hw] at hw'; cases hw'; exact ⟨rfl, rfl⟩

end

/-! ## The resolver a slot gives -/

section
variable {Fact Cand : Type} {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- Why a slot refuses to fill: for each candidate it considered, the candidate and its dead supports
(empty when it failed the judge instead). -/
abbrev Refusal (Fact Cand : Type) := List (Cand × List Fact)

/-- A slot's resolution at a view: the first usable candidate in the chooser's order, its body as the
filling; or the refusal naming, for every candidate, what failed. -/
def Slot.resolve (Sl : Slot Fact Cand) (holds : Fact → Bool) {i : Ix}
    (body : Cand → Prot S Hole A i) (order : List Cand) :
    Except (Refusal Fact Cand) (Prot S Hole A i) :=
  match Sl.alternatives holds order with
  | c :: _ => .ok (body c)
  | [] => .error (order.map fun c => (c, Sl.dead holds c))

/-- A slot fills only with a usable candidate of the chooser's order, the first one: the filling is
the body of the head of the usable candidates. -/
theorem resolve_ok {Sl : Slot Fact Cand} {holds : Fact → Bool} {i : Ix}
    {body : Cand → Prot S Hole A i} {order : List Cand} {f : Prot S Hole A i}
    (h : Sl.resolve holds body order = .ok f) :
    ∃ c rest, Sl.alternatives holds order = c :: rest ∧ c ∈ order ∧ Sl.usable holds c = true ∧
      f = body c := by
  unfold Slot.resolve at h
  cases ha : Sl.alternatives holds order with
  | nil => rw [ha] at h; cases h
  | cons c rest =>
    rw [ha] at h
    cases h
    have hc : c ∈ order.filter (Sl.usable holds) := by
      show c ∈ Sl.alternatives holds order; rw [ha]; exact List.mem_cons_self
    rw [List.mem_filter] at hc
    exact ⟨c, rest, rfl, hc.1, hc.2, rfl⟩

/-- A slot refuses only when no candidate in the chooser's order is usable, and the refusal names,
for each, exactly its dead supports. -/
theorem resolve_error {Sl : Slot Fact Cand} {holds : Fact → Bool} {i : Ix}
    {body : Cand → Prot S Hole A i} {order : List Cand} {w : Refusal Fact Cand}
    (h : Sl.resolve holds body order = .error w) :
    (∀ c ∈ order, Sl.usable holds c = false) ∧ w = order.map fun c => (c, Sl.dead holds c) := by
  unfold Slot.resolve at h
  cases ha : Sl.alternatives holds order with
  | cons c rest => rw [ha] at h; cases h
  | nil =>
    rw [ha] at h
    cases h
    refine ⟨fun c hc => ?_, rfl⟩
    have : c ∉ order.filter (Sl.usable holds) := by
      show c ∉ Sl.alternatives holds order; rw [ha]; simp
    simpa [List.mem_filter, hc] using this

end

end Nanodregg.Lang.Contextual.Slot
/-
# Lang.Contextual.Protocol — open protocols as typed families of continuations (lane PROTOCOL)

The object of the activities proposal's document 2: a protocol between parties is an OPEN object.
Its unspecified components are HOLES, each declared in a context `Ω` with an interface (where it
starts, what it must deliver, which reusable facts and which linear tokens it may use, which
obligations it may leave, who chooses its filling and which contract it must pass). Its
interactions with peers are `call op k` nodes whose continuation is a FAMILY indexed by the response
(`k : (r : Resp op) → Prot (next op r)`). A substitution is ONE filling per hole NAME, chosen before
anything is observed. Whether that separates a hole from an interaction depends on the NAMING, not
on the calculus: a template that puts the SAME name in every response branch gets one filling for
all of them (`Proofs.Contextual.Protocol.Coin.no_foresight`), but a template whose hole names
depend on the response (`call op fun r => hole (h r)`) gets a filling per response, which is
foresight (`response_indexed_names_have_foresight`; `foresight_iff_names_separate` is the exact
condition). Scope (one filling into every branch unchanged) is a naming discipline the author
keeps; the calculus does not enforce it. Its resources are tokens a `call` of a consuming operation
spends. The discipline is AFFINE: a token is spent at most once, and a token left unspent at `ret`
is allowed. There is one kind on purpose (PROT-8, LANG-75.18): LINEAR value is the kernel's, which
conserves every denomination over an admitted turn (`Kernel.Proofs.Value.admit_value`), and the
deployed offer that moves value (`Lang.StdOfferEscrow`) moves its leg in the same tree as every
retract of its row. A linear `Val` kind here would be a second count of the same value, with no
deployed reader. Its executed prefix is a history (`Hist`), possibly ending in a call
whose reply was lost (`inflight`), and a re-substitution must leave every hole the history has
already entered alone (`Dispatched`). The deployed lost reply is the resident's `AskEnd.lost` and
the kernel's journal-first retry; what each does with it is `Hosting.Proofs.LostReply`
(PROT-5: one Boolean per peer, `Peer.reliable`).

The shape generalises minidregg's `Theory/IndexedProgram.lean` (restated in Lean core, law 11): its
`IxSignature`/`Program` gain a third constructor `hole`, its `Algebra` a hole case, its interpreter
a `stuck` outcome (doc 2 section 7: partiality visible in the result type). A hole filled when the
run reaches it, from candidates under live supports, is `Lang.Contextual.Slot`; the deployed
resident's tick (`Hosting.Resident.Prog`) is a term of this calculus at a trivial index with two such
holes (`serve`, `use`), run by `Slot.interp`.

The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, A) ⊣ Φ` is `HasProt sp Ω Γ Q Φ Δ P`: `Γ` the reusable facts
(hypothetical: derivability is not current availability, `admits`), `Δ` the linear tokens (a bag:
`SubBag`), `Q` the result postcondition, `Φ` the obligations any completion may still owe (an upper
bound). Substitution is SINGLE-PASS: `subst σ` replaces each hole by its filling and does not
substitute into the filling, so a filling's own holes stay open under the same `σ`. Definitions only. The statements (`HasProt`, `Runs`, `Reach`, `Started`, `Dispatched`, `SubBag`,
`Fills`, `SubstOK`, ...) are in `Lang.Proofs.Contextual.ProtocolTyping`; the theorems are in
`Lang.Proofs.Contextual.Protocol`, `Lang.Proofs.Contextual.Negotiation` and
`Hosting.Proofs.LostReply`.
-/

namespace Nanodregg.Lang.Contextual.Protocol

/-! ## Signatures, the accounting of an operation, the chooser -/

/-- An indexed signature (mini's `IxSignature`, restated): at index `i` the operations `Op i`; each
operation's response type; the response selects the next index. -/
structure Sig (Ix : Type) where
  Op : Ix → Type
  Resp : {i : Ix} → Op i → Type
  next : {i : Ix} → (op : Op i) → Resp op → Ix

/-- What one operation does to the accounts: the linear token it SPENDS (if any), the reusable
facts it REQUIRES (authority, evidence: used, never consumed), and the obligations its DISPATCH
establishes (established when the call leaves, whatever the reply). -/
structure Spec {Ix : Type} (S : Sig Ix) (Tok Fact Ob : Type) where
  consumes : {i : Ix} → S.Op i → Option Tok
  requires : {i : Ix} → S.Op i → List Fact
  establishes : {i : Ix} → S.Op i → List Ob

/-- Who chooses a hole's filling, as the judgment uses it: `me`, the party whose protocol is judged
(`HasProt` admits a hole only with `chooser = .me`), or `other`, whose hole `fill` never fills. Two
values because every rule tests exactly that; nothing here tells two other parties apart (LANG-75.15). -/
inductive Chooser
  | me
  | other
deriving DecidableEq, Repr

/-! ## Open protocols -/

/-- The free open protocol over `S` with result family `A` and hole names `Hole`: return a result,
interact (`call`: one continuation per response, at the index the response selects), or leave a
named component unspecified (`hole h`, its interface in the context `Ω`, as a CMTT metavariable
refers to the meta-context). -/
inductive Prot {Ix : Type} (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) : Ix → Type where
  | ret {i : Ix} (a : A i) : Prot S Hole A i
  | call {i : Ix} (op : S.Op i) (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) :
      Prot S Hole A i
  | hole {i : Ix} (h : Hole i) : Prot S Hole A i

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- A hole's interface `u :: [Γ_u; Δ_u ⊢ Protocol(i, post)] ⊣ owes`, with its chooser and an
acceptance contract that every filling must pass (`Fills`). The start index is the hole name's
index. -/
structure Iface (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  /-- who chooses the filling -/
  chooser : Chooser
  /-- the reusable facts a filling may require (`Γ_u`) -/
  ctx : List Fact
  /-- the tokens a filling may spend (`Δ_u`) -/
  need : List Tok
  /-- what every result a filling delivers satisfies -/
  post : (j : Ix) → A j → Prop
  /-- the obligations a filling may leave -/
  owes : List Ob
  /-- the acceptance contract on a filling -/
  accepts : Prot S Hole A i → Prop

/-- `Ω`: the declared interface of every unresolved component. -/
abbrev Ctx (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) :=
  (i : Ix) → Hole i → Option (Iface S Hole A Tok Fact Ob i)

/-- `σ`: a partial substitution, a filling for some holes (doc 2 section 9). -/
abbrev Subst (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) :=
  (i : Ix) → Hole i → Option (Prot S Hole A i)

/-- Typed substitution: every hole `σ` fills is replaced by its filling; nothing else moves. -/
def subst (σ : Subst S Hole A) : {i : Ix} → Prot S Hole A i → Prot S Hole A i
  | _, .ret a => .ret a
  | _, .call op k => .call op fun r => subst σ (k r)
  | i, .hole h => match σ i h with
    | some f => f
    | none => .hole h

/-- `σ` restricted to the holes `Ω` declares chosen by `.me`: an `.other` hole is never filled. -/
def Subst.mine {Tok Fact Ob : Type} (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A) :
    Subst S Hole A := fun i h =>
  match Ω i h with
  | some I => if I.chooser = .me then σ i h else none
  | none => none

/-- `P[σ]` under `Ω`: fill the `.me` holes `σ` names. -/
def fill {Tok Fact Ob : Type} (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A)
    {i : Ix} (P : Prot S Hole A i) : Prot S Hole A i :=
  subst (σ.mine Ω) P

/-- The single substitution `[f/h]`. -/
def Subst.single [DecidableEq Ix] [∀ i, DecidableEq (Hole i)] {i : Ix} (h : Hole i)
    (f : Prot S Hole A i) : Subst S Hole A := fun j h' =>
  if hj : i = j then (by subst hj; exact if h' = h then some f else none) else none

/-- A signature whose response types are finite, listed. -/
structure Finite (S : Sig Ix) where
  resps : {i : Ix} → (op : S.Op i) → List (S.Resp op)
  complete : ∀ {i : Ix} (op : S.Op i) (r : S.Resp op), r ∈ resps op

/-- The holes of `P`, computed over a finite signature (`mem_holes_iff`: exactly `Occurs`). -/
def holes (fin : Finite S) : {i : Ix} → Prot S Hole A i → List (Σ j, Hole j)
  | _, .ret _ => []
  | _, .call op k => (fin.resps op).attach.flatMap fun r => holes fin (k r.1)
  | i, .hole h => [⟨i, h⟩]

/-! ## Linear tokens as a bag -/

/-! ## The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, Q) ⊣ Φ` -/

/-! ## Algebras, fold, fusion -/

/-- An algebra reads an open protocol into an indexed carrier; holes too. -/
structure Algebra (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (C : Ix → Type) where
  ret : {i : Ix} → A i → C i
  call : {i : Ix} → (op : S.Op i) → ((r : S.Resp op) → C (S.next op r)) → C i
  hole : {i : Ix} → Hole i → C i

/-- The fold. -/
def fold {C : Ix → Type} (alg : Algebra S Hole A C) : {i : Ix} → Prot S Hole A i → C i
  | _, .ret a => alg.ret a
  | _, .call op k => alg.call op fun r => fold alg (k r)
  | _, .hole h => alg.hole h

/-- Substitution as an algebra into protocols. -/
def substAlg (σ : Subst S Hole A) : Algebra S Hole A (Prot S Hole A) where
  ret := .ret
  call := .call
  hole := fun {i} h => match σ i h with
    | some f => f
    | none => .hole h

/-- Read a template under an environment: a filled hole is read as its filling's reading, an
unfilled one as the algebra's hole. -/
def underAlg {C : Ix → Type} (alg : Algebra S Hole A C) (σ : Subst S Hole A) :
    Algebra S Hole A C where
  ret := alg.ret
  call := alg.call
  hole := fun {i} h => match σ i h with
    | some f => fold alg f
    | none => alg.hole h

/-! ## Handlers, the interpreter, partial results -/

/-- A deterministic environment: one operation against an indexed state gives a response and a
state at the index the response selects (mini's `Handler`). -/
structure Handler (S : Sig Ix) (St : Ix → Type) where
  handle : {i : Ix} → (op : S.Op i) → St i → Σ r : S.Resp op, St (S.next op r)

/-- How an interpretation ends: a result, or STUCK at an unresolved hole (never a failure). -/
inductive Result (Hole : Ix → Type) (A : Ix → Type) (St : Ix → Type) where
  | done (j : Ix) (a : A j) (s : St j)
  | stuck (j : Ix) (h : Hole j) (s : St j)

/-- The handler as a state-transformer algebra. -/
def execAlgebra {St : Ix → Type} (H : Handler S St) :
    Algebra S Hole A (fun i => St i → Result Hole A St) where
  ret := fun {i} a s => .done i a s
  call := fun op k s => match H.handle op s with
    | ⟨r, s'⟩ => k r s'
  hole := fun {i} h s => .stuck i h s

/-- Run an open protocol against an environment. -/
def interpret {St : Ix → Type} (H : Handler S St) {i : Ix} (P : Prot S Hole A i) :
    St i → Result Hole A St :=
  fold (execAlgebra H) P

/-- Run a template with its holes bound by `σ` in the environment rather than in the syntax. -/
def interpretUnder {St : Ix → Type} (H : Handler S St) (σ : Subst S Hole A) {i : Ix}
    (P : Prot S Hole A i) : St i → Result Hole A St :=
  fold (underAlg (execAlgebra H) σ) P

/-- The recording environment: `H`, and each call appended to a trace with the response it had
(the shape of nano's `recorder`). -/
def record {St : Ix → Type} (H : Handler S St) : Handler S (fun i => St i × List (Σ i, Σ op : S.Op i, S.Resp op)) where
  handle := fun {i} op p => match H.handle op p.1 with
    | ⟨r, s'⟩ => ⟨r, (s', p.2 ++ [⟨i, op, r⟩])⟩

/-! ## History -/

/-- One performed interaction: the operation, at its index, with the response it had. -/
abbrev Entry (S : Sig Ix) := Σ i, Σ op : S.Op i, S.Resp op

/-- A history of performed interactions, in order. -/
abbrev Trace (S : Sig Ix) := List (Entry S)

/-- An accepted history: the answered interactions and, possibly, ONE dispatched call whose reply
has not arrived (lost or late: `uncertain`, a state, never a license to re-plan). Deployed, the
in-flight call is an ask that ended `AskEnd.lost` (kept as `(unanswered WHY)`, never re-asked:
`Failures.lost_ask_keeps_obligation`) or a signed call whose reply was lost (retried, recognised
`replayed`: `Failures.submit_at_most_once`). -/
structure Hist (S : Sig Ix) where
  answered : Trace S
  inflight : Option (Σ i, S.Op i)

/-- The tokens a trace spends. -/
def consumed {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (t : Trace S) : List Tok :=
  t.filterMap fun e => sp.consumes e.2.1

/-- The obligations a trace established. -/
def established {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (t : Trace S) : List Ob :=
  t.flatMap fun e => sp.establishes e.2.1

/-- The obligations a history established: the answered calls' and the in-flight call's (its
obligation stands from dispatch, whatever happened to the reply). -/
def Hist.established {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (H : Hist S) : List Ob :=
  Protocol.established sp H.answered ++
    match H.inflight with
    | some ⟨_, op⟩ => sp.establishes op
    | none => []

/-! ## The first-class open object (doc 2 section 9) -/

/-- `(P, Ω, σ, Γ, Δ, Q, Φ, t)`: the retained TEMPLATE, its open interface, the current partial
substitution, the hypotheses and tokens, the result contract, the obligation bound, and the
accepted history. The template is kept apart from `σ`: that is what makes re-substitution possible. -/
structure Open (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  template : Prot S Hole A i
  Ω : Ctx S Hole A Tok Fact Ob
  σ : Subst S Hole A
  Γ : List Fact
  Δ : List Tok
  Q : (j : Ix) → A j → Prop
  Φ : List Ob
  hist : Hist S

/-- The object's current protocol `P[σ]`. -/
def Open.current {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i) :
    Prot S Hole A i :=
  fill O.Ω O.σ O.template

/-- Replace the object's partial substitution. Data only: the GUARD (no re-substitution of a hole
the history has entered) is the statement `Open.Replan` in `Lang.Proofs.Contextual.ProtocolTyping`,
a hypothesis of every theorem about a re-plan (`Open.resubst_wf`). -/
def Open.replan {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i)
    (σ' : Subst S Hole A) : Open S Hole A Tok Fact Ob i :=
  { O with σ := σ' }

/-! ## Admission: current evidence, separate from derivability -/

/-- The CURRENT admission evidence: which facts hold now, which tokens are unspent now. -/
structure View (Tok Fact : Type) where
  holds : Fact → Bool
  live : Tok → Bool

/-- One concrete effect is admissible now: its facts hold and its token is unspent. -/
def admitOp {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix}
    (op : S.Op i) : Bool :=
  (sp.requires op).all v.holds &&
    match sp.consumes op with
    | some t => v.live t
    | none => true

/-- The protocol's NEXT concrete effect is admissible now. A hole has no concrete effect to admit
(an unfinished plan describes a family of transitions; only a complete one is admitted). -/
def admits {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix} :
    Prot S Hole A i → Bool
  | .ret _ => true
  | .call op _ => admitOp sp v op
  | .hole _ => false

/-- Durable consumption: mark a token spent. -/
def View.spend {Tok Fact : Type} [DecidableEq Tok] (v : View Tok Fact) (t : Tok) : View Tok Fact :=
  { v with live := fun t' => if t' = t then false else v.live t' }

/-- Commit one effect: refused unless admissible now; on success its token is spent durably. -/
def commit {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob) (v : View Tok Fact)
    {i : Ix} (op : S.Op i) : Option (View Tok Fact) :=
  if admitOp sp v op then
    some (match sp.consumes op with
      | some t => v.spend t
      | none => v)
  else none

/-- The keys an effect's admission reads: its facts and its token. -/
def opSupport {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) {i : Ix} (op : S.Op i) :
    List (Fact ⊕ Tok) :=
  (sp.requires op).map Sum.inl ++ (match sp.consumes op with
    | some t => [Sum.inr t]
    | none => [])

/-- A change of token REPRESENTATION (an authenticated representation of an unchanged semantic
token, e.g. an opening refreshed because a root moved): the spec with every token renamed. -/
def Spec.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') (sp : Spec S Tok Fact Ob) :
    Spec S Tok' Fact Ob where
  consumes := fun op => (sp.consumes op).map e
  requires := sp.requires
  establishes := sp.establishes

/-- An interface with its tokens renamed. -/
def Iface.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') {i : Ix}
    (I : Iface S Hole A Tok Fact Ob i) : Iface S Hole A Tok' Fact Ob i :=
  { I with need := I.need.map e }

/-- A context with its tokens renamed. -/
def Ctx.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') (Ω : Ctx S Hole A Tok Fact Ob) :
    Ctx S Hole A Tok' Fact Ob := fun i h => (Ω i h).map (Iface.mapTok e)

/-- A view as a store of keys. -/
def View.ofStore {Tok Fact : Type} (w : Fact ⊕ Tok → Bool) : View Tok Fact :=
  ⟨fun f => w (.inl f), fun t => w (.inr t)⟩

end

/-! ## Selective repair over fragments (doc 2 section 9, family 3) -/

/-- A checked fragment: a name, the keys its check declares it reads (its support), the check. -/
structure Frag (Name Key V : Type) where
  name : Name
  support : List Key
  check : (Key → V) → Bool

/-- Is the fragment affected by a change of `changed`? -/
def Frag.affected {Name Key V : Type} [DecidableEq Key] (f : Frag Name Key V)
    (changed : List Key) : Bool :=
  f.support.any fun k => decide (k ∈ changed)

/-- Check everything again. -/
def fromScratch {Name Key V : Type} (fs : List (Frag Name Key V)) (w : Key → V) : List Bool :=
  fs.map fun f => f.check w

/-- Selective repair: re-check the affected fragments, reuse every other cached verdict. -/
def repair {Name Key V : Type} [DecidableEq Key] :
    List (Frag Name Key V) → List Bool → List Key → (Key → V) → List Bool
  | [], _, _, _ => []
  | f :: fs, [], ch, w => f.check w :: repair fs [] ch w
  | f :: fs, c :: cs, ch, w => (if f.affected ch then f.check w else c) :: repair fs cs ch w

/-- The names of the fragments that do not check. Each name stands for one residual obligation
(re-establish that fragment); the list is `Φ′` only in that sense. -/
def residual {Name Key V : Type} : List (Frag Name Key V) → List Bool → List Name
  | [], _ => []
  | f :: fs, [] => f.name :: residual fs []
  | f :: fs, b :: bs => (if b then [] else [f.name]) ++ residual fs bs

/-- One effect's admission as a checked fragment over the store of keys. -/
def admitFrag {Ix : Type} {S : Sig Ix} {Name Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob)
    (name : Name) {i : Ix} (op : S.Op i) : Frag Name (Fact ⊕ Tok) Bool where
  name := name
  support := opSupport sp op
  check := fun w => admitOp sp (View.ofStore w) op

/-! ## Example: the committed bit (doc 2 section 5) -/

namespace Coin

/-- Before and after the peer reveals its bit. -/
inductive Phase
  | waiting
  | revealed
deriving DecidableEq, Repr

/-- The only operation: receive the peer's bit; nothing is available afterwards. -/
inductive Op : Phase → Type
  | recv : Op .waiting

def sig : Sig Phase where
  Op := Op
  Resp := fun | .recv => Bool
  next := fun | .recv, _ => .revealed

/-- One hole name, at `revealed`: our answer, planned before the reveal. -/
def HoleN : Phase → Type
  | .waiting => Empty
  | .revealed => Unit

abbrev Res : Phase → Type := fun _ => Bool

abbrev P := Prot sig HoleN Res

/-- The peer answers `b`. -/
def env (b : Bool) : Handler sig (fun _ => Unit) where
  handle := fun | .recv, () => ⟨b, ()⟩

/-- We win against `b` when the run ends with result `b`; a run stuck at a hole loses. The hole
names `Hn` are a parameter so that templates with different naming disciplines can be compared. -/
def wins {Hn : Phase → Type} {i : Phase} (b : Bool) (p : Prot sig Hn Res i) (s : Unit) : Bool :=
  match interpret (env b) p s with
  | .done _ a _ => a == b
  | .stuck _ _ _ => false

/-- The OPEN plan: receive, then do whatever our hole says. Its filling is chosen once. -/
def planHole : P .waiting := .call (S := sig) Op.recv fun _ => .hole (i := Phase.revealed) ()

/-- The RESPONSE-DEPENDENT plan: the continuation is a family over the response. -/
def planCall : P .waiting := .call (S := sig) Op.recv fun b => .ret b

/-- A template whose hole name may depend on the peer's bit: `name b` is the hole in branch `b`.
Response-free naming is the case `name true = name false`. -/
def planNamed {Hn : Phase → Type} (name : Bool → Hn .revealed) : Prot sig Hn Res .waiting :=
  .call (S := sig) Op.recv fun b => .hole (i := Phase.revealed) (name b)

/-- One hole name per possible bit at `revealed`. -/
def HoleB : Phase → Type
  | .waiting => Empty
  | .revealed => Bool

/-- The filling "answer `c`". -/
def answer (c : Bool) : Subst sig HoleN Res := fun
  | .waiting, h => nomatch h
  | .revealed, () => some (.ret c)

/-- The hole's interface, chosen by `p` (no facts, tokens or obligations in this game). -/
def iface (p : Chooser) : Iface sig HoleN Res Unit Unit Unit .revealed where
  chooser := p
  ctx := []
  need := []
  post := fun _ _ => True
  owes := []
  accepts := fun _ => True

/-- `Ω` declaring the answer hole chosen by `p`. -/
def ctxOf (p : Chooser) : Ctx sig HoleN Res Unit Unit Unit := fun
  | .waiting, h => nomatch h
  | .revealed, () => some (iface p)

end Coin

/-! ## The integration experiment: a one-use capability, two providers, a deadline, a cancel
(doc 3). Definitions here; the theorems in `Lang.Proofs.Contextual.Negotiation`.
The scalar matchers and the private Negotiation `World` went with PROT-6, replaced by Std.offer's
deployed fuse (`Lang/StdOffer.lean`). -/

namespace Negotiation

/-- Two candidate providers. -/
inductive Provider
  | p1
  | p2
deriving DecidableEq, Repr

/-- Phases: idle → reserved (deposit held) → done. -/
inductive Phase
  | idle
  | reserved
  | done
deriving DecidableEq, Repr

/-- The operations. `reserve` holds the buyer's deposit; `commit p` spends the one-use capability
on provider `p` (the provider's reply: delivered or not); `cancel` abandons and refunds. -/
inductive Op : Phase → Type
  | reserve : Op .idle
  | commit (p : Provider) : Op .reserved
  | cancel : Op .reserved

def respOf : {i : Phase} → Op i → Type
  | _, .reserve => Unit
  | _, .commit _ => Bool
  | _, .cancel => Unit

def sig : Sig Phase where
  Op := Op
  Resp := respOf
  next := fun
    | .reserve, _ => .reserved
    | .commit _, _ => .done
    | .cancel, _ => .done

/-- The single linear token: the capability. -/
inductive Tok
  | cap
deriving DecidableEq, Repr

/-- Reusable facts: a provider's authority; the deadline has not passed. -/
inductive Fact
  | auth (p : Provider)
  | beforeDeadline
deriving DecidableEq, Repr

/-- Obligations: the deposit is held; pay provider `p`; refund the deposit. -/
inductive Ob
  | holdDeposit
  | pay (p : Provider)
  | refund
deriving DecidableEq, Repr

def spec : Spec sig Tok Fact Ob where
  consumes := fun
    | .commit _ => some .cap
    | _ => none
  requires := fun
    | .commit p => [.auth p, .beforeDeadline]
    | _ => []
  establishes := fun
    | .reserve => [.holdDeposit]
    | .commit p => [.pay p]
    | .cancel => [.refund]

/-- One hole: which provider, chosen by us, after the reservation. -/
def HoleN : Phase → Type
  | .reserved => Unit
  | _ => Empty

/-- Results: whether the capability's service was delivered. -/
abbrev Res : Phase → Type := fun _ => Bool

abbrev P := Prot sig HoleN Res

instance : ∀ i, DecidableEq (HoleN i)
  | .idle => fun a => nomatch a
  | .reserved => fun () () => isTrue rfl
  | .done => fun a => nomatch a

/-- The open protocol: reserve, then the provider hole. -/
def template : P .idle := .call (S := sig) Op.reserve fun _ => .hole (i := Phase.reserved) ()

/-- A candidate: commit the capability on `p`; deliver its reply. -/
def plan (p : Provider) : P .reserved := .call (S := sig) (Op.commit p) fun ok => .ret ok

/-- The cancellation path. -/
def cancelPlan : P .reserved := .call (S := sig) Op.cancel fun _ => .ret false

/-- The hole's interface: chosen by `.me` (the buyer), accepted by the buyer, may use both providers' authority and the
deadline, may spend the capability, may owe payment to either provider or the refund. -/
def iface : Iface sig HoleN Res Tok Fact Ob .reserved where
  chooser := .me
  ctx := [.auth .p1, .auth .p2, .beforeDeadline]
  need := [.cap]
  post := fun _ _ => True
  owes := [.pay .p1, .pay .p2, .refund]
  accepts := fun _ => True

def Ω : Ctx sig HoleN Res Tok Fact Ob := fun
  | .reserved, () => some iface
  | .idle, h => nomatch h
  | .done, h => nomatch h

/-- Choose `f` for the provider hole. -/
def choose (f : P .reserved) : Subst sig HoleN Res := fun
  | .reserved, () => some f
  | .idle, h => nomatch h
  | .done, h => nomatch h

/-- The negotiation's responses, listed. -/
def finite : Finite sig where
  resps := fun
    | .reserve => [()]
    | .commit _ => [true, false]
    | .cancel => [()]
  complete := by
    intro i op r
    cases op with
    | reserve => cases r; simp
    | commit p => cases r <;> simp
    | cancel => cases r; simp

/-- The negotiation's hypotheses, tokens and obligation bound. -/
def Γ₀ : List Fact := [.auth .p1, .auth .p2, .beforeDeadline]
def Δ₀ : List Tok := [.cap]
def Φ₀ : List Ob := [.holdDeposit, .pay .p1, .pay .p2, .refund]

/-- The open object: the template with `f` chosen for the provider hole, history `H`. -/
def obj (f : P .reserved) (H : Hist sig) : Open sig HoleN Res Tok Fact Ob .idle where
  template := template
  Ω := Ω
  σ := choose f
  Γ := Γ₀
  Δ := Δ₀
  Q := fun _ _ => True
  Φ := Φ₀
  hist := H

/-- The reservation answered. -/
def reserved : Entry sig := ⟨.idle, Op.reserve, ()⟩

/-- Reserved; nothing dispatched yet. -/
def H₀ : Hist sig := ⟨[reserved], none⟩

/-- Reserved; the commitment to `p` dispatched and its reply LOST. -/
def lost (p : Provider) : Hist sig := ⟨[reserved], some ⟨.reserved, Op.commit p⟩⟩

/-- An environment: providers deliver iff `deliver`; the state counts calls. -/
def env (deliver : Bool) : Handler sig (fun _ => Nat) where
  handle := fun op n => match op with
    | .reserve => ⟨(), n + 1⟩
    | .commit _ => ⟨deliver, n + 1⟩
    | .cancel => ⟨(), n + 1⟩

/-- Reserved, then the commitment to `p` answered with `b`. -/
def answeredH (p : Provider) (b : Bool) : Hist sig :=
  ⟨[reserved, ⟨.reserved, Op.commit p, b⟩], none⟩

/-- A filling with the same first call as `plan p` but a different continuation. -/
def planFlip (p : Provider) : P .reserved := .call (S := sig) (Op.commit p) fun ok => .ret (!ok)

end Negotiation

end Nanodregg.Lang.Contextual.Protocol


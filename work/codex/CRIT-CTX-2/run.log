import Lang.Read
import Lang.Print
import Lang.Bell
import Protocol.Command.Text
import Hosting.BrokerWire

namespace Nanodregg.Hosting.Resident

open Nanodregg.Lang

/-! ## The config: `pkg/resident.conf`, one Lang data value -/

/-- The config's type. The operator writes one value of it beside the program:
`(record (bell #HEX) (grant #HEX) (maxTokens N) (model "NAME") (system "TEXT"))`, where `grant` is
the operator's grant to the resident's member that `invoke` names (`--via`). -/
def confTy : Ty :=
  .record [("bell", .digest), ("grant", .digest), ("maxTokens", .nat), ("model", .bytes), ("system", .bytes)]

/-- The largest config file read. -/
def confBytesMax : Nat := 65536

structure Conf where
  /-- the bell object's id (32 bytes) -/
  bell : ByteArray
  /-- the grant the answer is invoked through (32 bytes) -/
  grant : ByteArray
  maxTokens : Nat
  model : ByteArray
  system : ByteArray

/-- The config from its text; `none` names `confMalformed`. -/
def Conf.read (text : String) : Option Conf :=
  match Read.readData confTy text with
  | .ok (.record [("bell", .digest b), ("grant", .digest g), ("maxTokens", .nat n), ("model", .bytes m),
      ("system", .bytes s)]) =>
    if b.size = 32 ∧ g.size = 32 then some ⟨b, g, n, m, s⟩ else none
  | _ => none

/-! ## The description -/

/-- The argument type of the bell's `answer` (LANG-59, HOSTING-53): the ring's key, the ring's own
text and aim as the resident read them (`ringText`, `to`: the bell's guard refuses the answer unless
they equal the ring's), and the answer text. The witness's own (`Lang.Bell.answerArg`): one
definition, read back from the description and compared by name (`Shape.ofLines`). -/
def answerArgTy : Ty := Lang.Bell.answerArg

/-- The key of the bell's `pending`, in declared order (key bytes follow it, LANG-49/57). -/
def pendingKey : List (Label × Ty) := [("notBefore", .nat), ("agent", .digest)]

/-- The value of the bell's `pending`: the ring's capture (its text and its optional aim,
`Lang.Bell.askCaptured`), held beside the key so a tick is one read. -/
def pendingVal : Ty := .record [("captured", .sum [("ask", Lang.Bell.askCaptured)])]

/-- What the resident needs from the description: `answer`'s index and `pending` as declared,
with the key and value it reads at (so every theorem over a shape has them without a premise). -/
structure Shape where
  answer : Nat
  pending : RelDecl
  key : pending.key = pendingKey
  val : pending.val = pendingVal

/-- A text's lines: the pieces between its line breaks, in order (after a final break, the empty
piece). A description's lines hold no break (`Protocol.Command.noBreak`), so this reads back exactly
the lines `describe` printed (`Proofs.Socket.splitLines_join`). -/
def splitLines : List Char → List (List Char)
  | [] => [[]]
  | c :: cs =>
    if c = '\n' then [] :: splitLines cs else
    match splitLines cs with
    | [] => [[c]]
    | l :: ls => (c :: l) :: ls

/-- A line's text before its first space, and what follows that space (`none`: no space). -/
def word : List Char → Option (List Char × List Char)
  | [] => none
  | c :: rest => if c = ' ' then some ([], rest) else (word rest).map fun (w, r) => (c :: w, r)

/-- The words of a description's `method I LABEL TYPE` line: the index text, the label (one atom:
no space, `Lang.labelAtom`) and the type text (the rest of the line). -/
def methodWords (l : List Char) : Option (String × String × String) :=
  match l with
  | 'm' :: 'e' :: 't' :: 'h' :: 'o' :: 'd' :: ' ' :: rest =>
    match word rest with
    | some (i, r) =>
      match word r with
      | some (lab, ty) => some (String.ofList i, String.ofList lab, String.ofList ty)
      | none => none
    | none => none
  | _ => none

/-- The index text and type text of the first `method I answer TYPE` line. -/
def answerWords (ls : List (List Char)) : Option (String × String) :=
  ls.findSome? fun l => match methodWords l with
    | some (i, "answer", ty) => some (i, ty)
    | _ => none

/-- The hex of a description's `core HEX` line: the bell's package bytes (`Protocol.Command.Describe`). -/
def coreWords : List Char → Option (List Char)
  | 'c' :: 'o' :: 'r' :: 'e' :: ' ' :: rest => some rest
  | _ => none

/-- The package the description's `core` line carries, if it is the Bell (`Lang.Bell.shapeOk`: the
package the theorems of `Lang.Proofs.Bell` speak of), or why not: `noCore` (no `core` line: a data
object), `core` (its text is not a package's bytes), `notBell` (a package, not the Bell). -/
def bellCore (ls : List (List Char)) : Except String Lang.Package := do
  let some hx := ls.findSome? coreWords | throw "noCore"
  let some b := Protocol.Text.ofHex (String.ofList hx) | throw "core"
  match Wire.decodePackage b with
  | .ok p => if Lang.Bell.shapeOk p then pure p else throw "notBell"
  | .error _ => throw "core"

/-- The shape from a description's lines, or why not. The `method I answer TYPE` line's type is read
by `Lang.Read.readTy` (HOSTING-43: `Proofs.Socket.describe_shape` reads it back as the method's
declared argument type), the `rel (pending …)` line by `Lang.Read.rel`. -/
def Shape.ofLines (ls : List (List Char)) : Except String Shape := do
  let some (i, ty) := answerWords ls | throw "noAnswer"

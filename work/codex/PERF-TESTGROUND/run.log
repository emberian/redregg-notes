const enc = new TextEncoder(), dec = new TextDecoder();
export function packet(id, values) {
  const parts = values.map(value => {
    if (value instanceof Uint8Array) return [0, value];
    if (typeof value === '\\''string'\\'') return [1, enc.encode(value)];
    if (typeof value === '\\''number'\\'') {
      const b = new Uint8Array(8); new DataView(b.buffer).setFloat64(0, value, true); return [2, b];
    }
    if (typeof value === '\\''boolean'\\'') return [3, Uint8Array.of(+value)];
    throw new TypeError('\\''worker channel: unsupported value'\\'');
  });
  const b = new Uint8Array(8 + parts.reduce((n, [, p]) => n + 5 + p.length, 0));
  const v = new DataView(b.buffer); v.setUint32(0, id, true); v.setUint32(4, parts.length, true);
  let at = 8;
  for (const [tag, p] of parts) { b[at++] = tag; v.setUint32(at, p.length, true); at += 4; b.set(p, at); at += p.length; }

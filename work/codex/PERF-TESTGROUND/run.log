# demo (axes-run.mjs: the generator, the creator, the meter to ticksBudget, the time-lock, the document), the tutorial's
# steps in order (teach-run.mjs: each command ends as its step says), then a real
# hosted World on a fresh genesis (hosted-run.mjs basic, document and door: the live World's door, CLIENT-49). The expectation
# of each scene is its row's, read off Protocol.rows by the kernel, so a row that changes its lines is
# RED here until its scene follows, never silently left behind.
#
# The work directory (the toolchain's Init/Std C, the runtime, objects named by their C's content) is
# shared by every tree on the box, one build at a time (flock): ND_TESTGROUND_WORK, default
# ~/.cache/nd-testground/TOOLCHAIN. emcc is the one tool the judge needs beyond the tree's: on PATH, or
# ~/tools/emsdk (restore: `git clone https://github.com/emscripten-core/emsdk ~/tools/emsdk && cd
# ~/tools/emsdk && ./emsdk install 6.0.9 && ./emsdk activate 6.0.9`). Without it this row is RED.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); root=$(cd "$here/../.." && pwd)
fresh=${1:?usage: gate.sh FRESH [--harness-control]}; shift
tc=$(cat "$root/lean-toolchain"); tag=${tc##*:}
if ! command -v emcc >/dev/null && [ -f "$HOME/tools/emsdk/emsdk_env.sh" ]; then
  source "$HOME/tools/emsdk/emsdk_env.sh" >/dev/null 2>&1
fi
command -v emcc >/dev/null || { echo "FAIL no emcc on PATH or in ~/tools/emsdk (the restore command: testground/build/gate.sh's header)"; exit 1; }
command -v node >/dev/null || { echo "FAIL no node"; exit 1; }
work=${ND_TESTGROUND_WORK:-$HOME/.cache/nd-testground/$tag}; mkdir -p "$work"
t0=$(date +%s)
if ! ( flock 9; "$here/build.sh" all "$work" ) 9>"$work/.lock" > "$fresh/build.log" 2>&1; then
  tail -20 "$fresh/build.log"; echo "FAIL the kernel did not build (build.sh all; log above)"; exit 1
fi
echo "kernel: $(wc -c < "$root/testground/kernel.wasm") bytes, built in $(( $(date +%s) - t0 )) s"
cd "$root/testground"
# the hosted World (CLIENT-43): `host serve` under nd-supervise, the guest-book and the relay on a fresh
# genesis (deploy/testground/run.sh, every process by its PID file), two members in two kernels joined
# over the guest-book's invitation; hosted-run.mjs's `basic` and `document` must answer as scripted.
# STATE lives under TMPDIR (runs.py's own per run): host.sock must fit sun_path.
node_ws=(node); node -e 'process.exit(typeof WebSocket === "undefined" ? 1 : 0)' || node_ws=(node --experimental-websocket)
hosted() {   # hosted SCENE... [--harness-control]
  local st port rc=0
  ( cd "$root" && cargo build -q --release -p nanodregg-client --bin nd-supervise ) || { echo "FAIL nd-supervise did not build"; return 1; }
  st=$(mktemp -d "${TMPDIR:-/tmp}/ndtg.XXXXXX")
  port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
  export ND_TESTGROUND_ENROLL_FLOOR=250   # hosted-run.mjs door: a join past the scenes' six meets the floor
  export ND_HOST=${ND_LEAN_BIN:-$root/.lake/build/bin}/host ND_SUPERVISE=${CARGO_TARGET_DIR:-$root/target}/release/nd-supervise
  if "$root/deploy/testground/run.sh" genesis "$st/w" > "$st/genesis.log" 2>&1 && PORT=$port "$root/deploy/testground/run.sh" start "$st/w" > "$st/start.log" 2>&1; then
    for _ in $(seq 100); do curl -sf "http://127.0.0.1:$port/world.json" > /dev/null && break; sleep 0.2; done
    for sc in "$@"; do
      case $sc in --*) continue ;; esac
      "${node_ws[@]}" hosted-run.mjs "ws://127.0.0.1:$port/ws" "$sc" $([ "${!#}" = --harness-control ] && echo --harness-control) 2>&1 | grep -v -e ExperimentalWarning -e 'UNDICI-WS' -e trace-warnings | tail -3
      [ "${PIPESTATUS[0]}" -eq 0 ] || rc=1
    done
  else
    tail -5 "$st/genesis.log" "$st/start.log"; echo "FAIL the hosted World did not start (run.sh)"; rc=1
  fi
  "$root/deploy/testground/run.sh" stop "$st/w" > /dev/null 2>&1 || true
  rm -rf "$st"
  return $rc
}
if [ "${1-}" = --harness-control ]; then
  # each reader's own known-red control must read red; the row's control reads red only if both did
  if node lies-run.mjs --harness-control; then echo "FAIL harness: lies-run.mjs --harness-control passed"; exit 0; fi
  if node axes-run.mjs --harness-control; then echo "FAIL harness: axes-run.mjs --harness-control passed"; exit 0; fi
  if node teach-run.mjs --harness-control; then echo "FAIL harness: teach-run.mjs --harness-control passed"; exit 0; fi
  if hosted basic --harness-control; then echo "FAIL harness: hosted-run.mjs --harness-control passed"; exit 0; fi
  echo "FAIL harness-control: every reader read its known-red step red"; exit 1
fi
node lies-run.mjs || { echo "FAIL a lie's scene did not end as its row expects (lies-run.mjs)"; exit 1; }
node lies-run.mjs --honest || { echo "FAIL the control: with the lies off a scene still ended as its row expects (lies-run.mjs --honest)"; exit 1; }
node axes-run.mjs || { echo "FAIL an axis demo did not answer as scripted (axes-run.mjs)"; exit 1; }
node teach-run.mjs || { echo "FAIL a tutorial step did not end as it says (teach-run.mjs)"; exit 1; }
hosted basic document door || { echo "FAIL the hosted World did not answer as scripted (hosted-run.mjs)"; exit 1; }
echo "TESTGROUND GATE GREEN"
# Republishing the testground to GitHub Pages

The page is served from the `gh-pages` branch of emberian/nanodregg at
https://emberian.github.io/nanodregg/ (Pages source: `gh-pages`, `/`). The branch is a build
output: an orphan commit holding only what the browser loads, assembled by `build/publish.sh`.
Every republish replaces it whole. A change to the kernel's closure (wire, rows, `Host.Follow`,
`Web.Sim.Testground`) makes the published kernel stale; republish after it, and rebuild the demo
box's tenant at the same commit when the wire moved (the page's follow and the box's writer must
speak one wire; `dregg-infra-demo-vm/edge/demo/tenants/nd-testground/README.md`, "flag day").

**This deployment's live World:** `wss://nano.demo.dregg.online/ws` (the demo box's tenant
`nd-testground`). It is the `LIVE` argument of step 3 for GitHub Pages (the sandbox mirror, with a door
to the box). The box serves the page itself at https://nano.demo.dregg.online/ (beside /ws, /world.json,
/enroll, /attest): its tarball is assembled with `LIVE` = `self`, and the page then joins
`wss://<its own host>/ws`. It is set here and stamped into
`deployment.json` at publish time, never edited into the page.

## 1. Build the kernel at a pushed commit (hbox: the toolchain and emsdk at ~/tools/emsdk)

    git -C /tank/dregg-build/nanodregg/main fetch -q origin
    git -C /tank/dregg-build/nanodregg/main worktree add --detach ~/nd-land/publish origin/main   # or checkout --detach in it
    cd ~/nd-land/publish     # a warm .lake/build copied from a sibling (cp -a, never cp -al) saves the closure build
    source ~/tools/emsdk/emsdk_env.sh
    SWARM_MEM_MAX=6G LEAN_NUM_THREADS=2 JOBS=3 ionice -c3 nice -n 15 swarm-build testground/build/build.sh all ~/.cache/nd-testground/v4.30.0

`build.sh` writes `testground/kernel.json`: the commit, whether the tree was clean, the sha256 of
`kernel.wasm`, the toolchain. Build from a clean checkout of the commit you publish: `publish.sh`
refuses a dirty tree's kernel, and a commit that is not on `origin/main`.

## 2. Check it (the tree's gate, and the page locally)

    testground/build/gate.sh "$(mktemp -d)"          # every lie, the axes, a hosted World: basic, document, door
    (cd testground && python3 -m http.server 18741 --bind 127.0.0.1 & echo $! > /tmp/tg-http.pid)
    node testground/publish-check.mjs http://127.0.0.1:18741/ /tmp/tg-local   # on a machine with ~/tools/playwright
    kill "$(cat /tmp/tg-http.pid)"

## 3. Assemble and push

    testground/build/publish.sh /tmp/pages-out wss://nano.demo.dregg.online/ws
    git clone -q git@github.com:emberian/nanodregg.git /tmp/pages && cd /tmp/pages
    git checkout -q --orphan gh-pages-new && git rm -rq --cached . && git clean -fdxq
    cp -R /tmp/pages-out/. . && git add -A
    git commit -q -m "testground: the page built from nanodregg main $(python3 -c 'import json; print(json.load(open("kernel.json"))["commit"][:8])')"
    git push -f origin gh-pages-new:gh-pages

`publish.sh OUT LIVE [REPO]` copies the files the browser loads, `kernel.json`, writes
`deployment.json` (`live`, `repo`) and the branch README (both hashes, the door), and refuses unless
`kernel.json`'s sha256 is `kernel.wasm`'s, the tree was clean, the commit is on `origin/main`, and the
live World's `world.json` answers. `LIVE` = `none` publishes no door.

## 4. Check the live page (Chromium, Playwright from ~/tools/playwright)

    until [ "$(gh api repos/emberian/nanodregg/pages/builds/latest --jq .status)" = built ]; do sleep 10; done
    node testground/publish-check.mjs https://emberian.github.io/nanodregg/ ~/dev/redregg/work/promo/testground-published --live

It requires: the desktop, "Start here" step 1 `exit ok`, the Writer menu, the World window's
kernel sha256 equal to the tab's own hash of the bytes it runs and to `kernel.json`'s; with `--live`,
the door: joined and enrolled, first sync `ok`, the roster (the tab's own fold) holding the visitor
and the guest-book, the Wire showing its frames, a reload returning the SAME member, and "Forget me"
leaving nothing kept. Each `--live` run enrols one member of the live World (256 per World; the
guest-book keeps the last 16 for the operator), so run it once per publish.
// publish-check.mjs URL SHOT [--live] — the published page in Chromium (Playwright from ~/tools/playwright;
// testground/PUBLISH.md §3 and §5). The desktop renders, "Start here" step 1 (`alice$ nd create`) ends
// `exit ok`, the Writer menu exists, and the World window's kernel sha256 is the tab's own hash of the
// bytes it runs and kernel.json's. With --live, the door: the desktop's "Join the live World" joins the
// deployment's live World (enrolled, first sync ok, the roster read off the tab's own fold holds the
// visitor and the guest-book, the Frames window shows the visitor's frames); a reload returns the SAME member
// from the browser's storage, re-derived; "Forget me" leaves nothing kept. SHOT is a path prefix for
// the screenshots. Exit 0 only if every check holds; the JSON on stdout says which did not.
import { chromium } from '/Users/ember/tools/playwright/node_modules/playwright/index.mjs';
const [url, shot] = process.argv.slice(2).filter((a) => !a.startsWith('--'));
const live = process.argv.includes('--live');
const browser = await chromium.launch();
const ctx = await browser.newContext({ viewport: { width: 1280, height: 900 } });
const page = await ctx.newPage();
const logs = [];
page.on('console', (m) => logs.push(`${m.type()}: ${m.text()}`));
page.on('pageerror', (e) => logs.push(`pageerror: ${e.message}`));
page.on('dialog', (d) => d.accept());
const res = { url, checks: {} };
const check = (k, v, detail) => { res.checks[k] = v ? 'ok' : `FAILED${detail === undefined ? '' : `: ${detail}`}`; return v; };
const exits = () => page.evaluate(() => [...document.querySelectorAll('div.dim')].map((d) => d.innerText).filter((t) => /^exit \w+ ·/.test(t)));
const dbl = (label) => page.evaluate((l) => [...document.querySelectorAll('#icons .icon')].find((b) => b.innerText.includes(l)).dispatchEvent(new MouseEvent('dblclick', { bubbles: true })), label);
const termText = () => page.evaluate(() => document.querySelector('.term .out')?.innerText ?? '');
try {
  const t0 = Date.now();
  await page.goto(url, { waitUntil: 'load' });
  await page.waitForSelector('#tasks button', { timeout: 30000 });
  res.desktopMs = Date.now() - t0;
  res.icons = await page.locator('#icons .icon .label').allInnerTexts();
  const k = await page.evaluate(() => window.testground.kernel);
  res.kernel = { sha256: k.sha256, commit: k.built?.commit, stamped: k.built?.sha256, tree: k.built?.tree };
  check('kernel sha256 is the tab\'s and kernel.json\'s', k.sha256 && k.sha256 === k.built?.sha256, JSON.stringify(res.kernel));
  check('the World window shows the kernel sha256', (await page.locator('#desktop').innerText()).includes(k.sha256));
  check('Writer menu', (await page.locator('fieldset.writer select#writer-lie option').count()) > 1);
  await dbl('Start here');
  await page.waitForSelector('.tour li button.btn', { timeout: 10000 });
  const before = (await exits()).length;
  await page.locator('.tour li button.btn').first().click();
  await page.waitForFunction((n) => [...document.querySelectorAll('div.dim')].filter((d) => /^exit \w+ ·/.test(d.innerText)).length > n, before, { timeout: 20000 });
  check('tour step 1 exit ok', (await exits()).some((e) => e.startsWith('exit ok')), (await exits()).join(' | '));
  await page.waitForTimeout(300);
  await page.screenshot({ path: `${shot}-desktop.png` });
  if (live) {
    check('the door icon', res.icons.includes('Join the live World'), res.icons.join(', '));
    const tj = Date.now();
    await dbl('live World');
    await page.waitForFunction(() => /^exit \w+ ·/m.test(document.querySelector('.term .out')?.innerText ?? '') && /Enrolled\. member/.test(document.querySelector('.term .out')?.innerText ?? '') && document.querySelectorAll('.term .out div.dim').length >= 2, null, { timeout: 60000 });
    await page.waitForFunction(() => [...document.querySelectorAll('.term .out div.dim')].filter((d) => /^exit \w+ ·/.test(d.innerText)).length >= 2, null, { timeout: 60000 });
    res.joinMs = Date.now() - tj;
    const ex = await exits();
    check('joined: init and first sync ok', ex.length >= 2 && ex.every((e) => e.startsWith('exit ok')), ex.join(' | '));
    const st = await page.evaluate(() => { const w = window.testground.world(); return { me: w.members[0]?.id, sponsor: w.wj?.sponsor, origin: w.origin, roster: window.testground.roster(), frames: window.testground.frames().length, address: location.search }; });
    res.member = st.me; res.origin = st.origin; res.roster = { count: st.roster?.members.length, height: st.roster?.height };
    check('roster holds you and the guest-book', st.roster?.members.includes(st.me) && st.roster?.members.includes(st.sponsor), JSON.stringify(res.roster));
    check('the Frames window shows your frames', st.frames > 0 && (await page.locator('.log .row').count()) > 0, st.frames);
    check('the address is the door (?live)', st.address === '?live', st.address);
    const keptRec = await page.evaluate(() => Object.keys(localStorage).filter((x) => x.startsWith('nd-testground/member ')));
    check('membership kept in storage', keptRec.length === 1, keptRec.join(', '));
    await page.screenshot({ path: `${shot}-live.png` });
    // come back: a reload of the door is the same member, re-derived from the invitation
    const tr = Date.now();
    await page.reload({ waitUntil: 'load' });
    await page.waitForFunction(() => /Welcome back/.test(document.querySelector('.term .out')?.innerText ?? '') && [...document.querySelectorAll('.term .out div.dim')].some((d) => /^exit \w+ ·/.test(d.innerText)), null, { timeout: 60000 });
    res.returnMs = Date.now() - tr;
    const back = await page.evaluate(() => ({ me: window.testground.world().members[0]?.id, roster: window.testground.roster() }));
    const ex2 = await exits();
    check('returned as the same member, sync ok', back.me === st.me && ex2.at(-1)?.startsWith('exit ok'), `${back.me} vs ${st.me}; ${ex2.join(' | ')}`);
    check('the returned member is in its own fold', back.roster?.members.includes(st.me));
    await page.waitForTimeout(300);
    await page.screenshot({ path: `${shot}-return.png` });
    await page.getByRole('button', { name: 'Forget me' }).click();
    await page.waitForSelector('.tour li button.btn', { timeout: 10000 });
    const after = await page.evaluate(() => Object.keys(localStorage).filter((x) => x.startsWith('nd-testground/member ')).length);
    check('Forget me leaves nothing kept', after === 0, after);
    check('the door says Join again', (await page.locator('#door-label').innerText()) === 'Join the live World');
  }
} catch (e) {
  check('ran to the end', false, e.message.split('\n')[0]);
  await page.screenshot({ path: `${shot}-error.png` }).catch(() => {});
}
res.errors = logs.filter((l) => /error/i.test(l));
res.ok = Object.values(res.checks).every((v) => v === 'ok');
console.log(JSON.stringify(res, null, 1));
await browser.close();
process.exit(res.ok ? 0 : 1);
/-
# Web.Sim.Testground — a World in a browser tab: the writer and each member's follow, in process

The testground's kernel is the conformance rows' system (`Protocol.Rows.Writer`, `Host.Follow.answer`)
at the DEPLOYED parameters (`Protocol.Rows.Params.deployed`: the 32-byte digest, cSHAKE256, Ed25519,
KMAC256 Store tags), compiled to WebAssembly. A page is the client: it plays `nd`, the supervisor and
custody, exactly the parts `Protocol.Rows.Loopback` plays in process, and moves bytes only. Every
accept, refuse, plan, render and attempt decision is one of these exports' Lean:

* `tg_genesis ARGV` — `commandFrame` bytes of `[name, nonce, key₀, next₀, key₁, next₁, …]` (raw
  Ed25519 public keys): `Receive.genesis` at the deployed `Ctx`, a Store as `Host.Sim.memGenesis`
  leaves it, and one follow per founder whose World is that genesis; answers `host genesis`'s lines
  (`Host.Cli.genesisLines`), or `refused NAME`.
* `tg_host OP PAYLOAD` — one frame to the writer: `Host.serve`, the deployed loop (group commit, the
  seal cadence, whole-World bases), over the in-memory disk, run until its port is empty; answers
  `status ‖ payload` exactly as host.sock does.
* `tg_follow I OP PAYLOAD` — one frame to founder `I`'s `host follow` (`Host.Follow.answer`, the
  deployed per-frame decision); what follow would persist is held in memory, as the rows hold it.
* `tg_pub SEED`, `tg_sign SEED MSG` — custody's Ed25519 (CODEC's, RFC 8032), the page's custody
  calling it with seeds the page holds; follow never sees a seed.
* `tg_attempt SENDS_LEFT REQUEST SEEN` — `Protocol.Attempt.next`, the attempt store's decision.
* `tg_table` — the protocol table the page's codec reads (ops, statuses, step tags, layouts), from
  `Protocol.Table`: one source, never a hand-written copy.
* `tg_lie NAME` — the writer tells one of the conformance rows' own lies from now on (`lies`): a
  writer plant runs `Host.serve` with the parameters `Loopback.sys` gives that mutation; a relay
  fault puts the rows' relay (`Loopback.pageFault`, `lookupLie`, `losesFirstReply`, `forwards`,
  `cancelLie`) between the members and the writer — in a hosted tab, around its socket (`tg_relay_pre`
  before it, `tg_relay_post` after: the same two halves the tab's own writer is wrapped in). `honest` ends it. `tg_lies` is the menu as JSON,
  each lie with the row that plants it and that row's expected outcome, read off `Protocol.rows`;
  `tg_lied` says whether the relay rewrote the last frame.
* `tg_cold I` — founder `I`'s follow starts again from the genesis World (the rows' `cold` lines).
* `tg_forge I ARGV SEED NEXT` — a hostile client's call (`Loopback.forgedCall`): ARGV planned on
  founder `I`'s World WITHOUT its follow's admission and signed with the seed it is handed; the page
  submits it like any call. `tg_text NAME` — a row's own package text (`Protocol.slot`, …).
* `tg_members I` — the members of founder `I`'s World as its own fold holds them (a hosted tab's roster).
* `tg_found INPUT I`, `tg_join INVITATION KEY`, `tg_self I MEMBER GRANT` — a HOSTED World (no
  writer in the tab; the page relays each member's writer frames to a real `host serve`): a founder's
  follow from the genesis inputs `host genesis` printed, a stranger's from an invitation accepted
  under the sponsor key the page trusts (`Invite.accept`), and its ids once a sponsor enrolled it.

It is a simulation in the README's sense (the real loop over an in-memory disk), so it is tooling:
no deployed module imports it (closure C9), and nothing a member trusts runs here.
-/
import Protocol.Rows.Writer
import Protocol.Rows.Deployed
import Protocol.Rows.Loopback
import Host.Follow
import Host.Cli
import Protocol.Attempt
import Protocol.Health
import Protocol.Command.Exit
import Lang.StdGen
import Lang.StdOffer
import Lang.Journey.Kept

namespace Nanodregg.Web.Sim.Testground

open Nanodregg.Codec Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Host

abbrev D := Digest

/-- A lie the tab's writer tells: a conformance row's own plant, never a second implementation.
`writer m` runs the writer under the parameters `Loopback.sys` gives mutation `m`; `relay f` puts
the rows' relay fault `f` between every member and the writer. -/
inductive Lie
  | writer (m : Protocol.Mutation)
  | relay (f : Protocol.Fault)

/-- The menu: the lies whose rows catch them in a member's follow (the writer plants among them
leave every follower's `Ctx` the deployed one, `Loopback.sys`), and `neverForward`, the loss the
cancel lies need first. -/
def lies : List Lie :=
  [.relay (.flipEvent 0), .relay .dropLastEvent, .writer .forgesRefusal, .relay .lieLookup,
   .relay .lieCancel, .relay .forgeCancel, .relay .neverForward]

/-- A plant's word: its constructor's name, without arguments (`flipEvent 0` ↦ `flipEvent`). -/
def plantWord {α : Type} [Repr α] (a : α) : String :=
  let w := ((toString (repr a)).splitOn " ").head!
  ((w.splitOn ".").getLast!.replace "«" "").replace "»" ""

def Lie.word : Lie → String
  | .writer m => plantWord m
  | .relay f => plantWord f

/-- Where the rows plant a lie: the row, its line (counted from 0, as a row's `Plant.caught` counts) and the outcome the
row expects there, read off `Protocol.rows` (a writer plant: the row whose plant is that
mutation; a relay fault: the first line of any row that injects it). -/
def Lie.row : Lie → Option (String × Nat × String)
  | .writer m => Protocol.rows.findSome? fun r => match r.plant with
      | .caught m' n e => if plantWord m' = plantWord m then some (r.name, n, e.text) else none
      | _ => none
  | .relay f => Protocol.rows.findSome? fun r =>
      (r.lines.zipIdx.find? fun (l, _) => plantWord l.fault = plantWord f).map fun (l, i) =>
        (r.name, i, l.expect.text)

/-- The writer's parameters under a lie: `Loopback.sys`'s (no plant: the deployed rows parameters). -/
def writerOf : Option Lie → Rows.Writer.Params D
  | some (.writer m) => (Protocol.Rows.Loopback.sys Rows.Params.deployed (some m)).writer
  | _ => (Protocol.Rows.Loopback.sys Rows.Params.deployed none).writer

/-- The writer's parameters: the deployed rows parameters, no plant. -/
def P : Rows.Writer.Params D := writerOf none

/-- How a follow reads a base: the World codec and the writer's own base digest. -/
def base : Thin.Base (World D) :=
  ⟨P.R.world, World.steps, P.R.keys.worldDigest, Cadence.deployed.worldBytesMax⟩

/-- One founder's follow: who it serves and what it holds. -/
structure Member where
  self : Command.Self D
  follow : Command.Follow D
  /-- the steps this follow absorbed, each batch with the World it absorbed them onto (the last
  `seenMax` batches): what the page's Turn view re-derives a step from (`Web.Sim.Teach.tg_turn`) -/
  seen : Array (World D × List (Kernel.Step D)) := #[]

/-- The writer in the tab: its Store and its loop's state. -/
structure Writer where
  mem : Rows.Writer.Mem
  res : Resident (World D)

/-- The tab's World: the writer, when it runs in the tab, and every member's follow. A hosted World
(DESIGN-TESTGROUND §3.2) has no writer here: the page relays the members' writer frames to a real
`host serve`, and only the follows run in the tab. -/
structure Ground where
  writer : Option Writer
  members : Array Member
  conn : Nat := 0
  /-- the genesis World, where a cold follow starts -/
  genesis : World D
  /-- the lie the writer tells, `none` honest -/
  lie : Option Lie := none
  /-- the calls whose first reply the relay already lost (`losesFirstReply`: one per attempt) -/
  lost : Array ByteArray := #[]
  /-- the relay rewrote (or answered, or kept) the last frame -/
  lied : Bool := false

initialize ground : IO.Ref (Option Ground) ← IO.mkRef none

/-- `status ‖ payload`, as host.sock and follow.sock answer. -/
def reply (status : UInt8) (payload : ByteArray) : ByteArray := ByteArray.mk #[status] ++ payload

def refusedText (name : String) : ByteArray := reply Protocol.Status.refused.code name.toUTF8

/-- The tab's World has one writer and no certifiers (`Authority.none`): its heads are uncertified,
as every Store's is until the signing seed lands (TRUST T3). -/
def authority : Authority := Authority.none

/-- The founders of an argv: `(key, next)` pairs, the next committed as `nextKeyDigest`. -/
def foundersOf : List ByteArray → Option (List (ByteArray × D))
  | [] => some []
  | k :: n :: rest => (foundersOf rest).map ((k, nextKeyDigest P.X n) :: ·)
  | [_] => none

/-- The genesis World's head, as the rows bind it for a self-head seed (`Protocol.selfHeadSeed`'s
`{@chain0}` and `{@roots0}`, `Loopback`'s binds): `chain0 HEX`, `roots0 HEX`. -/
def head0Lines (g : World D) : List String :=
  [s!"chain0 {Text.toHex (P.X.env.bytes g.chain)}", s!"roots0 {Text.toHex (P.X.env.bytes (g.roots P.X.env))}"]

def genesisOf (argv : List ByteArray) : IO ByteArray := do
  let name :: nonce :: keys := argv | return refusedText "usage"
  let some fs := foundersOf keys | return refusedText "usage"
  match genesis P.X name nonce Rows.Params.allowance fs authority with
  | .error r => return refusedText r.name
  | .ok g =>
    match ← Rows.Writer.genesisStore P g with
    | .error e => return refusedText e
    | .ok (mem, res) =>
      let members := (List.range fs.length).toArray.map fun i =>
        { self := { world := g.origin, member := founderId P.X g.origin i,
                    grant := founderGrantId P.X g.origin i, window := Follow.window }
          follow := { world := g } : Member }
      ground.set (some { writer := some { mem, res }, members, genesis := g })
      let lines := Cli.genesisLines g nonce fs.length authority ++ head0Lines g
      return reply Protocol.Status.ok.code ("\n".intercalate lines ++ "\n").toUTF8

/-- One frame through the deployed loop: a port whose queue holds the frame, served until it is
empty (`Exit.eof`); the replies it sent. -/
def serveOne (g : Ground) (wr : Writer) (f : Frame) : IO (Ground × Array Reply) := do
  let P := writerOf g.lie
  let queue ← IO.mkRef #[f]
  let sent ← IO.mkRef (#[] : Array Reply)
  let back ← IO.mkRef (none : Option Frame)
  let pop : IO (Option Frame) := do
    match ← back.swap none with
    | some f => pure (some f)
    | none =>
      let q ← queue.get
      if h : 0 < q.size then queue.set (q.extract 1 q.size); pure (some q[0]) else pure none
  let port : Port :=
    { recv := pop, poll := pop, unread := fun f => back.set (some f)
      send := fun r => sent.modify (·.push r), close := pure () }
  let (_, res) ← serve (Rows.Writer.machine P) ⟨fun _ ts => Record.encode P.R.dc ts, Rows.Writer.mark P⟩
    P.R.keys.segment (Rows.Writer.checkpoint P wr.mem) (Rows.Writer.cadence P)
    (Sim.memStore wr.mem.disk none) (Rows.Writer.pager P wr.mem) port Rows.Writer.limits 2 wr.res
  return ({ g with writer := some { wr with res } }, ← sent.get)

/-- A lost reply, as the member's transport sees one: the connection closed, nothing said. -/
def lostReply : ByteArray := reply Protocol.Status.closed.code ByteArray.empty

/-- The relay's lie, if it tells one, and the op a frame names. -/
def faultOf (g : Ground) (op : UInt8) : Option (Protocol.Fault × Protocol.Op) :=
  match g.lie, Op.all.find? (·.code = op) with
  | some (.relay f), some o => some (f, o)
  | _, _ => none

/-- The relay BEFORE the writer: the answer it gives a frame itself (a cancel it answers on its own
word, `cancelLie`; a submit it never forwards, `forwards`), or `none`: the frame goes on to the writer. -/
def relayPre (g : Ground) (op : UInt8) : Option ByteArray := do
  let (f, o) ← faultOf g op
  match Protocol.Rows.Loopback.cancelLie (D := D) f o with
  | some r => some r
  | none => if o = .submit && !Protocol.Rows.Loopback.forwards f then some lostReply else none

/-- The relay AFTER the writer: the writer's reply `r` to a forwarded frame as the member receives
it (the first reply of a call lost, `losesFirstReply`; a page or a lookup rewritten, `pageFault`,
`lookupLie`), and the ground with the lost call remembered. -/
def relayPost (g : Ground) (op : UInt8) (payload r : ByteArray) : Ground × ByteArray :=
  match faultOf g op with
  | none => (g, r)
  | some (f, o) =>
    if o = .submit && Protocol.Rows.Loopback.losesFirstReply f && !g.lost.contains payload then
      ({ g with lost := g.lost.push payload }, lostReply)
    else if o = .log then (g, Protocol.Rows.Loopback.pageFault f r)
    else if o = .lookup then (g, Protocol.Rows.Loopback.lookupLie f r) else (g, r)

/-- The writer's answer to one frame, through the relay the lie puts in front of it: `relayPre`, the
tab's writer (`Host.serve`), `relayPost`. A hosted tab runs the same two halves around its socket. -/
def hostOf (op : UInt8) (payload : ByteArray) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some wr := g.writer | return refusedText "noWriter"
  let g := { g with conn := g.conn + 1, lied := false }
  if let some r := relayPre g op then ground.set (some { g with lied := true }); return r
  let (g, rs) ← serveOne g wr ⟨UInt32.ofNat g.conn, op, payload⟩
  let r := match rs[0]? with
    | some r => reply r.status r.payload
    | none => refusedText "noReply"
  let (g, r') := relayPost g op payload r
  ground.set (some { g with lied := r' != r }); return r'

/-- A hosted tab's relay before its socket: `ok ‖ reply` when the relay answers the frame itself,
`ok` alone when the frame goes on to the writer. -/
@[export tg_relay_pre] def tgRelayPre (op : UInt8) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  match relayPre g op with
  | some r => ground.set (some { g with lied := true }); return reply Protocol.Status.ok.code r
  | none => ground.set (some { g with lied := false }); return reply Protocol.Status.ok.code ByteArray.empty

/-- A hosted tab's relay after its socket: the writer's reply `R` as the member receives it. -/
@[export tg_relay_post] def tgRelayPost (op : UInt8) (payload r : ByteArray) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let (g, r') := relayPost g op payload r
  ground.set (some { g with lied := r' != r }); return r'

/-- How many absorbed batches a member keeps for the Turn view. -/
def seenMax : Nat := 64

def followOf (i : Nat) (op : UInt8) (payload : ByteArray) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some m := g.members[i]? | return refusedText "noMember"
  let (fs', persist, status, p) :=
    Follow.answer P.X P.R.dc base m.self m.follow ⟨UInt32.ofNat g.conn, op, payload⟩
  let seen := match persist with
    | .steps ss@(_ :: _) =>
      let s := m.seen.push (m.follow.world, ss.map (·.1))
      if s.size > seenMax then s.extract (s.size - seenMax) s.size else s
    | _ => m.seen
  ground.set (some { g with conn := g.conn + 1, members := g.members.set! i { m with follow := fs', seen } })
  return reply status p

@[export tg_genesis] def tgGenesis (argv : ByteArray) : IO ByteArray :=
  match commandFrame.decode argv with
  | .ok v => genesisOf (Text.unlist v.1.1)
  | .error _ => pure (refusedText "undecodableCommand")

@[export tg_host] def tgHost (op : UInt8) (payload : ByteArray) : IO ByteArray := hostOf op payload

@[export tg_follow] def tgFollow (i : UInt32) (op : UInt8) (payload : ByteArray) : IO ByteArray :=
  followOf i.toNat op payload

@[export tg_pub] def tgPub (seed : ByteArray) : ByteArray := Ed25519.publicKey seed

@[export tg_sign] def tgSign (seed msg : ByteArray) : ByteArray := Ed25519.sign seed msg

/-! ## The table the page reads (one source: `Protocol.Table`, read off its `all` lists) -/

/-- A constructor's own word (`Step.signNext` ↦ `signNext`), as `Emit.Rust.ctorName` reads it. -/
def word {α : Type} [Repr α] (a : α) : String :=
  let w := ((toString (repr a)).splitOn ".").getLast!
  (w.replace "«" "").replace "»" ""

def jstr (s : String) : String := "\"" ++ s ++ "\""
def jarr (xs : List String) : String := "[" ++ ",".intercalate xs ++ "]"
def jobj (kvs : List (String × String)) : String :=
  "{" ++ ",".intercalate (kvs.map fun (k, v) => jstr k ++ ":" ++ v) ++ "}"

def jfield : Codec.Field → String
  | .byte n => jobj [("kind", jstr "byte"), ("name", jstr n)]
  | .u64 n => jobj [("kind", jstr "u64"), ("name", jstr n)]
  | .bytes n => jobj [("kind", jstr "bytes"), ("name", jstr n)]
  | .list n => jobj [("kind", jstr "list"), ("name", jstr n)]
  | .oneOf n cs => jobj [("kind", jstr "oneOf"), ("name", jstr n),
      ("cases", jarr (cs.map fun (c, b) => jobj [("name", jstr c), ("code", toString b.toNat)]))]
  | .u32 n => jobj [("kind", jstr "u32"), ("name", jstr n)]
  | .path n => jobj [("kind", jstr "path"), ("name", jstr n)]
  | .paths n => jobj [("kind", jstr "paths"), ("name", jstr n)]

def jlayout (l : Codec.Layout) : String := jarr (l.map jfield)

def jcodes {α : Type} [Repr α] (xs : List α) (code : α → Nat) : String :=
  jarr (xs.map fun a => jobj [("name", jstr (word a)), ("code", toString (code a))])

/-- The protocol table as JSON: ops, statuses, step tags with their layouts, the follow socket's
layouts, custody's refusals, the command exits, the attempt store's words and the bounds. -/
def table : String := jobj [
  ("ops", jarr (Op.all.map fun o => jobj [("name", jstr o.name), ("code", toString o.code.toNat)])),
  ("relayable", jarr (Op.relayable.map fun o => jstr o.name)),
  ("statuses", jcodes Protocol.Status.all (·.code.toNat)),
  ("steps", jarr (Step.all.map fun st => jobj [("name", jstr (word st)), ("code", toString st.code.toNat),
      ("layout", jlayout st.layout)])),
  ("command", jlayout commandLayout), ("resume", jlayout resumeLayout),
  ("signResult", jlayout signResultLayout), ("precommitResult", jlayout precommitResultLayout),
  ("custodyRefused", jlayout custodyRefusalLayout),
  ("custodyRefusals", jarr (CustodyRefusal.all.map fun r => jobj [("name", jstr r.name), ("code", toString r.code.toNat)])),
  ("commandExits", jcodes CommandExit.all CommandExit.code),
  ("attemptRequests", jarr (Attempt.Request.all.map fun r => jstr (word r))),
  ("attemptSeen", jarr (Attempt.Seen.all.map fun s => jstr s.name)),
  ("receiptWords", jarr ([Attempt.receiptWord, Attempt.headWord, Attempt.settleWord].map jstr)),
  ("settleSeen", jarr (Attempt.settleWords.filterMap fun w => (Attempt.settleSeen w).map fun s =>
      jarr [jstr w, jstr s.name])),
  ("attemptActions", jarr (Attempt.Action.all.map fun a => jobj [("name", jstr a.name), ("code", toString a.code.toNat)])),
  ("bounds", jobj [("frameBytesMax", toString Bounds.frameBytesMax), ("argvBytesMax", toString Bounds.argvBytesMax),
      ("stepsPerCommandMax", toString Bounds.stepsPerCommandMax), ("sendsMax", toString Bounds.sendsMax)])]

@[export tg_table] def tgTable (_ : Unit) : String := table

/-- `Protocol.Attempt.next`: `sendsLeft` (0/1), the last request and what its reply said as
indices of `Request.all` and `Seen.all` (`255`: nothing sent yet); the action's `code`, `badReply` for an index past the lists. -/
@[export tg_attempt] def tgAttempt (sendsLeft req seen : UInt8) : UInt8 :=
  if req = 255 then (Attempt.next (sendsLeft = 1) none).code else
    match Attempt.Request.all[req.toNat]?, Attempt.Seen.all[seen.toNat]? with
    | some r, some s => (Attempt.next (sendsLeft = 1) (some (r, s))).code
    | _, _ => Attempt.Action.badReply.code

/-! ## The lying writer, cold follows and a hostile client -/

def lieOf (name : String) : Option Lie := lies.find? (·.word = name)

/-- From now on the writer tells the lie `NAME` (`honest`: none); answers the name, or `refused
noLie`. A hosted tab has no writer of its own: a writer lie there is `refused noWriter`, and a relay
lie is told by the tab's relay around its socket (`tg_relay_pre`, `tg_relay_post`). -/
@[export tg_lie] def tgLie (name : ByteArray) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let n := (String.fromUTF8? name).getD ""
  if n = "honest" then ground.set (some { g with lie := none, lost := #[] }); return reply Protocol.Status.ok.code name
  match lieOf n with
  | some (.writer _) => if g.writer.isNone then return refusedText "noWriter" else
      ground.set (some { g with lie := lieOf n, lost := #[] }); return reply Protocol.Status.ok.code name
  | some l => ground.set (some { g with lie := some l, lost := #[] }); return reply Protocol.Status.ok.code name
  | none => return refusedText "noLie"

/-- Whether the relay rewrote, answered or kept the last frame sent to the writer. -/
@[export tg_lied] def tgLied (_ : Unit) : IO UInt8 := do
  pure (match ← ground.get with | some g => if g.lied then 1 else 0 | none => 0)

/-- The lies a MEMBER tells and the honest writer admits (a hostile client's `forge` line), by the
row that plants each: the row's first line after its first `forge` that does not end `ok` is where a
member's follow catches it. -/
def memberLies : List (String × String) := [("forkedPost", "selfHead")]

def memberLieRow (row : String) : Option (Nat × String) := do
  let r ← Protocol.rows.find? (·.name = row)
  let ls := r.lines.zipIdx
  let (_, f) ← ls.find? fun (l, _) => match l.act with | .forge _ => true | _ => false
  let (l, i) ← ls.find? fun (l, i) => i > f && l.expect ≠ .ok
  pure (i, l.expect.text)

/-- The whole menu: the writer's and the relay's lies, then the members'. -/
def menuJson : String := jarr (
  (lies.map fun l =>
    let kind := match l with | .writer _ => "writer" | .relay _ => "relay"
    jobj ([("name", jstr l.word), ("kind", jstr kind)] ++ match l.row with
      | some (r, n, e) => [("row", jstr r), ("line", toString n), ("expect", jstr e)]
      | none => [])) ++
  (memberLies.map fun (n, row) =>
    jobj ([("name", jstr n), ("kind", jstr "member")] ++ match memberLieRow row with
      | some (i, e) => [("row", jstr row), ("line", toString i), ("expect", jstr e)]
      | none => [])))

@[export tg_lies] def tgLies (_ : Unit) : String := menuJson

/-- Founder `I`'s follow starts again from the genesis World (a rows `cold` line). -/
@[export tg_cold] def tgCold (i : UInt32) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some m := g.members[i.toNat]? | return refusedText "noMember"
  ground.set (some { g with members := g.members.set! i.toNat { m with follow := { world := g.genesis } } })
  return reply Protocol.Status.ok.code ByteArray.empty

/-- A hostile client's call (`Protocol.Rows.Loopback.forgedCall`): ARGV (`commandFrame` bytes) planned on
founder `I`'s follow World as it stands, without its follow's admission, signed with `SEED` (its
next key `NEXT`'s public key named); `ok ‖ call` for the page to submit, or `refused NAME`. -/
@[export tg_forge] def tgForge (i : UInt32) (argv seed next : ByteArray) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some m := g.members[i.toNat]? | return refusedText "noMember"
  match commandFrame.decode argv with
  | .error _ => return refusedText "undecodableCommand"
  | .ok v =>
    match Protocol.Rows.Loopback.forgedCall P.X m.self m.follow.world (Ed25519.publicKey seed)
        (Ed25519.publicKey next) (Ed25519.sign seed) ((Text.unlist v.1.1).map fun b => (String.fromUTF8? b).getD "") with
    | .ok call => return reply Protocol.Status.ok.code call
    | .error r => return refusedText r

/-- A package's text as `install` reads it (`Lang.Print.package`, the printer the rows' `slot` uses). -/
def packageText (p : Lang.Package) : String := (Lang.Print.package p).getD ""

section Spin
open Nanodregg.Lang

/-- `go k` counts `k` down to 0, one step per tick-charged call: `fix` of the record `{go}`. -/
def spinGo : Term :=
  .get (.fix (.lam (.record [("go", .fn .nat .nat)]) (.record [("go", .lam .nat
    (.ite (.prim .eq (.var 0) (.nat 0)) (.nat 0) (.app (.get (.var 1) "go") (.prim .sub (.var 0) (.nat 1)))))]))) "go"

/-- The meter's demo package (KERNEL-68, DESIGN-OBS §1): one method `spin {n}` that counts `n` down
before it writes `n := 0`, so an invoke spends ticks in proportion to `n`; nothing else. A member
who spins near the signed budget sixteen times in one window has spent `Bounds.ticksPerWindow`, and
the next spin is the kernel's `ticksBudget`, naming the member. -/
def spinPackage : Package :=
  Std.pkgOf (.record [("n", .nat)]) []
    [("spin", .record [("n", .nat)], [], .lam (.record []) (.lam (.record [("n", .nat)]) (.lam (.record [("n", .nat)])
      (.lam reqTy (resultT (callsT []) (.record [("n", .app spinGo (.get (.var 1) "n"))]))))))]

end Spin

/-- A row's own texts by name: the package a scene installs and the seed it creates with, and the
journey's generators (§GN, `Lang.Std`): `boundedGenerator` (GN6–GN8: `generate {max}` installs a
record bounded at `max`) and `ownerGenerator` (GN9–GN11: `generate {}` installs a record only its
invoker may use), `boundedCreator` (GN12–GN17: `make {max}` makes its invoker a record bounded
at `max` in one Turn, installing the package when the World lacks it); the journey's claiming package
`Kept` and its leaky twin (§LK); and the journey's offer (§LF), the tutorial's last step. -/
def texts : List (String × String) :=
  [("slot", Protocol.slot), ("selfHeadSeed", Protocol.selfHeadSeed),
   ("boundedGenerator", packageText (Lang.Std.boundedGenerator [("n", .nat)] "n")),
   ("ownerGenerator", packageText (Lang.Std.ownerGenerator [("n", .nat)])),
   ("boundedCreator", packageText (Lang.Std.boundedCreator "n" 0)),
   ("spin", packageText spinPackage),
   -- the journey's claim (§LK, LANG-93): `Kept` claims `keeps le100 bounded` and its law bears it;
   -- the same package with a `write` arm that skips the test (LK6) is refused at install
   ("kept", packageText Lang.Journey.kept),
   ("keptLeaky", packageText (Lang.Journey.keptWith Lang.Journey.leaky [.keeps "le100" "bounded"])),
   -- the journey's offer (§LF, `Lang.Journey.Offer`): one term `price`, roles buyer and seller
   ("offer", match Lang.Std.offerPackage ["price"] ["buyer", "seller"] with
     | .ok p => packageText p
     | .error _ => "")]

@[export tg_text] def tgText (name : ByteArray) : ByteArray :=
  match texts.lookup ((String.fromUTF8? name).getD "") with
  | some t => reply Protocol.Status.ok.code t.toUTF8
  | none => refusedText "noText"

/-- The meter, read back from member `I`'s OWN fold as its HEALTH RECEIPT (DESIGN-OBS §1.5,
`Protocol.Health`): the receipt `nd receipt --health` prints, built from the member's follow's World,
written to its bytes, read back and CHECKED against that World's head (`Health.checkBytes`), so the page
shows what the receipt states and that it checks, never a number beside it. Lines: `ticks N`, `budget M`,
`refusals R`, `total T`, `height H`, `health HEX`, `checked ok` (or `checked NAME`). Nothing here asks the
writer. -/
@[export tg_meter] def tgMeter (i : UInt32) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some m := g.members[i.toNat]? | return refusedText "noMember"
  let w := m.follow.world
  let E := P.X.env
  let some b := Health.bytes E P.R.dc (Health.build E w m.self.member) | return refusedText "badHealth"
  let (verdict, a) := match Health.checkBytes E P.R.dc (Head.headOf E w) m.self.member b with
    | .ok a => ("ok", a)
    | .error r => (r.name, Health.answerOf E w m.self.member)
  return reply Protocol.Status.ok.code
    (s!"ticks {a.ticks}\nbudget {Bounds.ticksPerWindow}\nrefusals {a.refusals}\ntotal {a.total}\n" ++
      s!"height {w.height}\nhealth {Text.toHex b}\nchecked {verdict}\n").toUTF8

/-! ## A hosted World: the follows in the tab, the writer elsewhere -/

/-- A member of a hosted World whose follow starts at `w` (no writer in the tab); `g` the tab's
ground when it is already this World's and holds no writer, else a new one. Answers its index. -/
def addMember (self : Command.Self D) (w : World D) : IO Nat := do
  let m : Member := { self, follow := { world := w } }
  match ← ground.get with
  | some g =>
    if g.writer.isNone && g.genesis.origin = w.origin then
      ground.set (some { g with members := g.members.push m }); return g.members.size
    else ground.set (some { writer := none, members := #[m], genesis := w }); return 0
  | none => ground.set (some { writer := none, members := #[m], genesis := w }); return 0

def hexOf (d : D) : String := Text.toHex (P.X.env.bytes d)

/-- The members of founder `I`'s World, read off its OWN fold: every live cell of kind `kindMember`
(`Receive.kindMember`), in trie order, one `member HEX` line each, then `height H`, then
`enrollLeft N` when the member's own grant carries an enrolment right (`Receive.enrollLeft`: the
count its next `enroll` would spend from). A hosted tab's roster is this: what its follow re-derived
from the log, not a list the writer or the guest-book keeps; a member the writer never logged is not
in it, and one it logged cannot be left out. The guest-book reads its own `enrollLeft` to keep a
floor for members who come back. -/
@[export tg_members] def tgMembers (i : UInt32) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some m := g.members[i.toNat]? | return refusedText "noMember"
  let w := m.follow.world
  let ids := w.cellIds.filter fun c => (w.live P.X.env c).any (·.kind == kindMember)
  let lines := ids.foldl (fun acc c => acc ++ s!"member {hexOf c}\n") ""
  let left := match w.live P.X.env m.self.grant with
    | some cell => match enrollLeft m.self.grant cell with
      | .ok (_, n) => s!"enrollLeft {n}\n"
      | .error _ => ""
    | none => ""
  return reply Protocol.Status.ok.code s!"{lines}height {w.height}\n{left}".toUTF8

/-- A founder of a hosted World: its follow starts at the genesis its INPUT makes (the `input HEX`
`host genesis` prints, as a founder's own follow Store reproduces it, RUNBOOK §2b's residual), its
ids founder `I`'s. Answers `index N`, `origin`, `member`, `grant`, or `refused NAME`. -/
@[export tg_found] def tgFound (input : ByteArray) (i : UInt32) : IO ByteArray := do
  let some st := Invite.startOf P.X input | return refusedText "badInput"
  match Invite.startGenesis P.X st with
  | .error r => return refusedText r.name
  | .ok w =>
    let self : Command.Self D :=
      { world := w.origin, member := founderId P.X w.origin i.toNat,
        grant := founderGrantId P.X w.origin i.toNat, window := Follow.window }
    let n ← addMember self w
    return reply Protocol.Status.ok.code
      s!"index {n}\norigin {hexOf w.origin}\nmember {hexOf self.member}\ngrant {hexOf self.grant}\n".toUTF8

/-- A stranger joins a hosted World over an invitation (`Invite.accept`, PROTOCOL-42): its follow
starts at the World the invitation's signed inputs make, checked under the sponsor `KEY` the page
trusts, never the writer's World handed over. Its ids are placeholders until a sponsor enrolls it
(`tg_self`), as the rows' strangers' are. Answers `index`, `origin`, `sponsor`, or `refused NAME`. -/
@[export tg_join] def tgJoin (invitation key : ByteArray) : IO ByteArray := do
  match Invite.accept P.X key invitation with
  | .error r => return refusedText r.name
  | .ok (inv, w) =>
    let self : Command.Self D :=
      { world := w.origin, member := P.X.env.hash "nanodregg/testground/stranger/v1" key,
        grant := P.X.env.hash "nanodregg/testground/stranger-grant/v1" key, window := Follow.window }
    let n ← addMember self w
    return reply Protocol.Status.ok.code
      s!"index {n}\norigin {hexOf w.origin}\nsponsor {hexOf inv.sponsor}\n".toUTF8

/-- Member `I`'s ids once its sponsor enrolled it: `MEMBER` and `GRANT` as `enroll` and `grant world`
printed them (hex). -/
@[export tg_self] def tgSelf (i : UInt32) (member grant : ByteArray) : IO ByteArray := do
  let some g ← ground.get | return refusedText "noWorld"
  let some m := g.members[i.toNat]? | return refusedText "noMember"
  let dig (b : ByteArray) := (String.fromUTF8? b) >>= Text.ofHex >>= P.X.digestOf
  match dig member, dig grant with
  | some mm, some gg =>
    ground.set (some { g with members := g.members.set! i.toNat { m with self := { m.self with member := mm, grant := gg } } })
    return reply Protocol.Status.ok.code ByteArray.empty
  | _, _ => return refusedText "badId"

end Nanodregg.Web.Sim.Testground
/-
# Web.Sim.Teach — what the testground's teaching windows ask the kernel

The page's object inspector, package editor, term REPL and Turn view (CLIENT-50) show the language;
every answer here is the language's own function, never a second implementation:

* `tg_ob TEXT` — `Lang.Resident.run`: the resident's checker (`(check P)` names the line a surface
  refusal is about, `(core P)` the core text a surface package lowers to, `(type T)`, `(eval TICKS
  T)` the value and the ticks it used, `(law P LABEL OLD NEW REQ)` one law judging one change).
* `tg_grammar WHICH` — the grammar a window shows: `core` (`Lang.Read.grammar`, what a term and a
  core package are) or `surface` (`Lang.Surface.grammar`, what a package source is).
* `tg_source I PKG` — package `PKG` as member `I`'s follow holds it, printed by `Lang.Print.package`
  (the core text `install` reads back to the same package).
* `tg_example TYPE ME` — a value of a method's argument type to start editing from.
* `tg_cell I ID` — what an id names on member `I`'s World (object, package, grant with its fields,
  member, none), so a link opens the right window.
* `tg_grants I OBJ` — the live grants on `OBJ` in member `I`'s follow World: one line each.
* `tg_turn I TX` — the step with transaction id `TX`, re-derived on the World member `I`'s follow
  absorbed it onto (`Testground.Member.seen`): who, the ticks, the call, every pin and what was done
  to it, the state of each touched object before and after, the calls the run returned (each invoke
  re-run on the same pinned view, as `deriveCalls` runs it), or the refusal's name and reason.

Tooling, like `Web.Sim.Testground`: no deployed module imports it.
-/
import Web.Sim.Testground
import Lang.Resident

namespace Nanodregg.Web.Sim.Teach

open Nanodregg.Codec Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Host
open Nanodregg.Web.Sim.Testground

def okText (s : String) : ByteArray := reply Protocol.Status.ok.code s.toUTF8

/-- One `ob` form: the resident's answer line, `ok ‖ LINE` or `refused ‖ LINE` (its `refused` word
dropped: the status says it). -/
@[export tg_ob] def tgOb (text : ByteArray) : ByteArray :=
  match String.fromUTF8? text with
  | none => refusedText "notUtf8"
  | some t =>
    let a := Lang.Resident.run t
    if a.refused then reply Protocol.Status.refused.code (String.ofList (a.line.toList.drop "refused ".length)).toUTF8
    else okText a.line

@[export tg_grammar] def tgGrammar (which : ByteArray) : ByteArray :=
  match String.fromUTF8? which with
  | some "core" => okText Lang.Read.grammar
  | some "surface" => okText Lang.Surface.grammar
  | _ => refusedText "noGrammar"

/-- A digest from its hex text. -/
def digestOfHex (b : ByteArray) : Option D := (String.fromUTF8? b) >>= Text.ofHex >>= P.X.digestOf

def memberWorld (i : UInt32) : IO (Except ByteArray (Member)) := do
  let some g ← ground.get | return .error (refusedText "noWorld")
  let some m := g.members[i.toNat]? | return .error (refusedText "noMember")
  return .ok m

@[export tg_source] def tgSource (i : UInt32) (pkg : ByteArray) : IO ByteArray := do
  match ← memberWorld i with
  | .error r => return r
  | .ok m =>
    let some p := digestOfHex pkg | return refusedText "badId"
    match Lang.readPackage (Command.worldLook P.X.env m.follow.world) p with
    | .error r => return refusedText r.name
    | .ok pk => match Lang.Print.package pk with
      | some t => return okText t
      | none => return refusedText "noText"

/-! ## An example argument -/

mutual
/-- A value of type `T` to start editing from: 0, false, "text", the viewer's own id for a digest
(a live cell, which is what a digest entering a run must name), every field of a record, a sum's
first arm. Only a starting point: the kernel judges what the visitor sends. -/
def exampleData (me : ByteArray) : Lang.Ty → Lang.Data
  | .nat => .nat 0
  | .bool => .bool false
  | .bytes => .bytes "text".toUTF8
  | .digest => .digest me
  | .fn _ _ => .record []
  | .record fs => .record (exampleFields me fs)
  | .sum [] => .record []
  | .sum ((ℓ, T) :: _) => .inj ℓ (exampleData me T)

def exampleFields (me : ByteArray) : List (Lang.Label × Lang.Ty) → List (Lang.Label × Lang.Data)
  | [] => []
  | (ℓ, T) :: fs => (ℓ, exampleData me T) :: exampleFields me fs
end

/-- `tg_example TYPE ME`: a value of the type (LANG's text of it, as `read OBJ ?` prints a method's
argument type), printed as `invoke` reads it back; `ME` (hex) is the viewer's member id. -/
@[export tg_example] def tgExample (ty me : ByteArray) : ByteArray :=
  match (String.fromUTF8? ty).map Lang.Read.readTy with
  | some (.ok T) =>
    let m := ((String.fromUTF8? me) >>= Text.ofHex).getD ByteArray.empty
    match Lang.Print.data (exampleData m T) with
    | some t => okText t
    | none => refusedText "noText"
  | _ => refusedText "notAType"

/-! ## Grants -/

/-- A grant cell's rights, read from its slot keys (`rightKey`, `rightSlots`): the uncounted rights
by key, a counted right with the count it was granted (its ledger's slot 0). -/
def rightsOf (c : Cell) : List String :=
  c.slots.filterMap fun (k, v) =>
    if k = rightKey .observe then some "observe"
    else if k = rightKey .mutate then some "mutate"
    else if k ≥ invokeBase then some s!"invoke:{k - invokeBase}"
    else if k = enrollBase then some s!"enroll:{(countOf v).getD 0}"
    else if k = transferBase then some s!"transfer:{(countOf v).getD 0}"
    else if k = creditBase then some s!"credit:{(countOf v).getD 0}"
    else none

def slotHex (c : Cell) (k : Nat) : String := ((c.slots.get k).map Text.toHex).getD "-"

/-- `grant ID grantee HEX|anyone issuer HEX [parent HEX] rights R,…` for every live grant on OBJ. -/
@[export tg_grants] def tgGrants (i : UInt32) (obj : ByteArray) : IO ByteArray := do
  match ← memberWorld i with
  | .error r => return r
  | .ok m =>
    let some o := digestOfHex obj | return refusedText "badId"
    let ob := P.X.env.bytes o
    let anyone := P.X.env.bytes (worldId P.X)
    let lines := m.follow.world.trie.toList.filterMap fun (s, l) => match s, l with
      | .cell id, .entry (.live c _) =>
        if c.kind = kindGrant && c.slots.get grantTarget == some ob then
          let grantee := if c.slots.get grantGrantee == some anyone then "anyone" else slotHex c grantGrantee
          let parent := match c.slots.get grantParent with
            | some p => s!" parent {Text.toHex p}"
            | none => ""
          some s!"grant {hexOf id} grantee {grantee} issuer {slotHex c grantIssuer}{parent} rights {",".intercalate (rightsOf c)}"
        else none
      | _, _ => none
    return okText (String.join (lines.map (· ++ "\n")))

/-! ## What an id names -/

def kindWord (k : Nat) : String :=
  if k = kindPackage then "package" else if k = kindObject then "object" else if k = kindGrant then "grant"
  else if k = kindMember then "member" else if k = kindAuthority then "authority"
  else if k = kindAccount then "account" else s!"kind{k}"

/-- `tg_cell I ID`: what ID names on member I's follow World, so the page opens the right window:
`kind WORD` (`none`: no cell has this id, a hash that is not a cell's), `retired` for a tombstone,
and for a grant its fields (`target`, `grantee` (or `anyone`), `issuer`, `parent`, `rights`). -/
@[export tg_cell] def tgCell (i : UInt32) (id : ByteArray) : IO ByteArray := do
  match ← memberWorld i with
  | .error r => return r
  | .ok m =>
    let some d := digestOfHex id | return refusedText "badId"
    let w := m.follow.world
    match World.live P.X.env w d with
    | none =>
      match World.entry P.X.env w d with
      | some .tomb => return okText "kind retired\n"
      | _ => return okText "kind none\n"
    | some c =>
      let anyone := P.X.env.bytes (worldId P.X)
      let extra := if c.kind = kindGrant then
          [s!"target {slotHex c grantTarget}",
           s!"grantee {if c.slots.get grantGrantee == some anyone then "anyone" else slotHex c grantGrantee}",
           s!"issuer {slotHex c grantIssuer}"] ++
          ((c.slots.get grantParent).map fun p => [s!"parent {Text.toHex p}"]).getD [] ++
          [s!"rights {",".intercalate (rightsOf c)}"]
        else if c.kind = kindObject then
          [s!"owner {slotHex c slotOwner}"] ++ ((c.slots.get slotPackage).map fun p => [s!"package {Text.toHex p}"]).getD []
        else []
      return okText (String.join ((s!"kind {kindWord c.kind}" :: extra).map (· ++ "\n")))

/-! ## The Turn view -/

def actText : Kernel.Act → String
  | .keep => "keep"
  | .retire => "retire"
  | .write ops => "write " ++ " ".intercalate (ops.map fun
      | .set k _ => s!"set:{k - stateBase}"
      | .erase k => s!"erase:{k - stateBase}")

def rowActText : RowAct → String
  | .keep => "keep" | .insert _ _ => "insert" | .upsert _ _ => "upsert" | .retract => "retract"
  | .declare limit _ _ _ => s!"declare limit {limit}"

def rowSlotText : RowSlot D → String
  | .head p r => s!"{hexOf p} rel {r} head"
  | .row k => s!"{hexOf k.parent} rel {k.rel} key {Text.toHex k.k}"

/-- The verb of a call body and what it names. -/
def bodyText : Body D → String
  | .enroll _ _ _ _ via => s!"enroll via {hexOf via}"
  | .rotate _ _ => "rotate"
  | .install pkg => s!"install {pkg.size} bytes"
  | .create pkg laws state => s!"create {(pkg.map hexOf).getD "data"} laws {laws.length} slots {state.length}"
  | .createOf pkg laws state => s!"createOf {pkg.size} bytes laws {laws.length} slots {state.length}"
  | .write obj edits _ => s!"write {hexOf obj} slots {",".intercalate (edits.map fun (k, _) => toString k)}"
  | .law obj laws _ => s!"law {hexOf obj} laws {laws.length}"
  | .invoke obj m _ budget _ => s!"invoke {hexOf obj} method {m} budget {budget}"
  | .grant t g rights _ => s!"grant {hexOf t} to {hexOf g} rights {rights.length}"
  | .retire c => s!"retire {hexOf c}"
  | .issue cap => s!"issue cap {cap}"
  | .account a o => s!"account {hexOf a} owner {hexOf o}"
  | .transfer _ _ amount _ _ => s!"transfer {amount}"
  | .credit w _ amount _ => s!"credit {hexOf w} {amount}"

/-- An invoke's arguments as text, at the method's argument type (`Lang.resolveMethod`), with its label. -/
def argsText (look : Pinned D) (obj : D) (m : Nat) (args : ByteArray) : String :=
  match look obj with
  | .ok (some cell) =>
    match packageOf P.X obj cell with
    | .ok (some p) =>
      match Lang.readPackage look p with
      | .ok pk => match Lang.resolveMethod (D := D) pk m with
        | .ok (ℓ, sg) => match Lang.Wire.decodeData sg.arg args with
          | .ok d => s!"{ℓ} {(Lang.Print.data d).getD s!"({args.size} bytes)"}"
          | .error _ => s!"{ℓ} ({args.size} bytes)"
        | .error _ => s!"({args.size} bytes)"
      | .error _ => s!"({args.size} bytes)"
    | _ => s!"({args.size} bytes)"
  | _ => s!"({args.size} bytes)"

/-- The calls an invoke's run returned, depth first, each invoke re-run on the same pinned view as
`deriveCalls` derives it (the actor of a call is the calling object, KERNEL-28 (b)); `d` bounds the
depth. Each line: `call DEPTH VERB …`, and for an invoke, its method's label, its arguments and the
ticks its run used. -/
def callLines (look : Pinned D) (rv : RowView D) (c : Call D) : Nat → Nat → D → D → Nat → ByteArray → Nat → Option D → List String
  | 0, _, _, _, _, _, _, _ => []
  | d + 1, depth, actor, obj, m, args, fuel, via =>
    match invokeRun P.X look c actor (if depth = 0 then none else some actor) obj m via with
    | .error r => [s!"call {depth} refused {r.name}"]
    | .ok (cell, p, r) =>
      match P.X.program.run look rv p (stateOf cell) m args r fuel with
      | .error e => [s!"call {depth} refused {e.name}"]
      | .ok (_, calls, rows, used) =>
        s!"run {depth} {hexOf obj} method {m} {argsText look obj m args} ticks {used} row-edits {rows.length}" ::
          calls.flatMap fun b => match b with
            | .invoke o m' a budget v =>
              s!"call {depth + 1} {bodyText b}" :: callLines look rv c d (depth + 1) obj o m' a (min budget (fuel - used)) v
            | _ => [s!"call {depth + 1} {bodyText b}"]

/-- A refusal's reason (`lawDenied` and `program` carry LANG's words). -/
def refusalText : Refusal D → String
  | .lawDenied l why => s!"lawDenied law {hexOf l} {Command.oneLine why}"
  | .program why => s!"program {Command.oneLine why}"
  | r => r.name

/-- The state of `obj` on `w` as `read OBJ` prints it, on one line. -/
def stateLine (w : World D) (obj : D) : String :=
  match World.live P.X.env w obj with
  | none => "(none)"
  | some cell => match cell.kind == kindObject, Command.readText P.X w obj cell with
    | true, .ok t => Command.oneLine t
    | _, _ => "-"

/-- The lines of one step re-derived on `w`, the World before it. -/
def stepLines (w : World D) (s : Kernel.Step D) : List String :=
  let callOf (b : ByteArray) : Option (Call D) := P.X.decodeCall b
  match s with
  | .turn t =>
    let w' : World D := (rederiveStep P.X w s).toOption.getD w
    let head : List String := [s!"step turn", s!"tx {hexOf t.txId}", s!"height {w.height} -> {w'.height}", s!"member {hexOf t.member}",
      s!"ticks {t.ticks}", s!"charge {t.charge}", s!"window {t.notBefore}..{t.validUntil}"]
    let body : List String := match callOf t.event with
      | some c => [s!"call {bodyText c.unsigned.body}"] ++ match c.unsigned.body with
        | .invoke obj m args budget via =>
          let look := pinned P.X.env w c.unsigned.pins
          let rv := rowView P.X.env w c.unsigned
          [s!"args {argsText look obj m args}"] ++ callLines look rv c 4 0 c.unsigned.member obj m args budget via
        | _ => []
      | none => ["call (undecodable)"]
    let pins := t.touches.map fun x => s!"pin {hexOf x.cell} seen {hexOf x.seen} {actText x.act}"
    let writes := t.touches.filterMap fun x => match x.act with
      | .write _ => some s!"state {hexOf x.cell} before {stateLine w x.cell} after {stateLine w' x.cell}"
      | _ => none
    let creates := t.creates.map fun ((id, c) : D × Cell) => s!"create {hexOf id} kind {c.kind}"
    let rows := t.rows.map fun r => s!"row {rowSlotText r.slot} {rowActText r.act}"
    let ranges := t.ranges.map fun q => s!"range {hexOf q.parent} rel {q.rel} prefix {Text.toHex q.pre} most {q.most}"
    head ++ body ++ pins ++ writes ++ creates ++ rows ++ ranges
  | .refusal r =>
    let head : List String := [s!"step refusal", s!"tx {hexOf r.txId}", s!"height {w.height}", s!"member {hexOf r.member}",
      s!"code {r.code} {(codeName r.code).getD "?"}", s!"window {r.notBefore}..{r.validUntil}"]
    let why : List String := if r.cancel.size > 0 then ["cancel signed by the member"] else match callOf r.event with
      | none => ["call (undecodable)"]
      | some c =>
        let look := pinned P.X.env w c.unsigned.pins
        [s!"call {bodyText c.unsigned.body}"] ++
        match deriveTurn P.X look (rowView P.X.env w c.unsigned) c with
        | .error e => [s!"refusal {refusalText e}"]
        | .ok t => match World.admit P.X.env w t with
          | .error rj => [s!"refusal {rj.name} (at admission)"]
          | .ok _ => ["refusal (re-derives as admitted on this World)"]
    head ++ why

def txOf : Kernel.Step D → D
  | .turn t => t.txId
  | .refusal r => r.txId

/-- The step `TX` (hex) as member `I`'s follow absorbed it: re-derived along its batch from the World
the batch was absorbed onto, then `stepLines`. -/
@[export tg_turn] def tgTurn (i : UInt32) (tx : ByteArray) : IO ByteArray := do
  match ← memberWorld i with
  | .error r => return r
  | .ok m =>
    let some x := digestOfHex tx | return refusedText "badId"
    let some (w0, ss) := m.seen.reverse.find? (fun (_, ss) => ss.any (txOf · = x)) | return refusedText "notSeen"
    let rec walk (w : World D) : List (Kernel.Step D) → Except String (List String)
      | [] => .error "notSeen"
      | s :: rest =>
        if txOf s = x then .ok (stepLines w s) else
        match rederiveStep P.X w s with
        | .ok w' => walk w' rest
        | .error v => .error s!"rederive {v.name}"
    match walk w0 ss with
    | .ok ls => return okText (String.join (ls.map (· ++ "\n")))
    | .error e => return refusedText e

end Nanodregg.Web.Sim.Teach


import Lang.Package

namespace Nanodregg.Lang.Wire

/-- A parser result together with equality to the ordinary decoder. The proof
is erased at runtime; a cached result cannot change acceptance or the value. -/
abbrev PackageDecoder := (b : ByteArray) →
  { r : Except Nanodregg.Codec.Refusal Package // r = decodePackage b }

def plainDecoder : PackageDecoder := fun b => ⟨decodePackage b, rfl⟩

structure DecodedPackage where
  bytes : ByteArray
  package : Package
  correct : decodePackage bytes = .ok package

/-- Exact bytes are the key, not a digest and not a claimed package id. -/
def cachedDecoder : List DecodedPackage → PackageDecoder
  | [], b => plainDecoder b
  | e :: rest, b =>
    if h : e.bytes = b then
      ⟨.ok e.package, by rw [← h]; exact e.correct.symm⟩
    else cachedDecoder rest b

def rememberDecoded (cache : List DecodedPackage) (b : ByteArray) : List DecodedPackage :=
  if cache.any (fun e => e.bytes == b) then cache
  else match h : decodePackage b with
    | .error _ => cache
    | .ok p => (⟨b, p, h⟩ :: cache).take 32

theorem decoder_eq_plain (d : PackageDecoder) : d = plainDecoder := by
  funext b
  exact Subtype.ext (d b).property

end Nanodregg.Lang.Wire
EOF

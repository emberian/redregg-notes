// A dedicated worker is a transport to the same byte API as loadKernel. No
// command, signature, verdict or retry is decided by the transport.
export async function loadWorkerKernel({ wasmBinary, onKernelCall } = {}) {
  const { packet, unpack, kernelMethods } = await import('\\''./kernel-wire.js'\\'');
  const worker = new Worker(new URL('\\''./kernel-worker.js'\\'', import.meta.url), { type: '\\''module'\\'' });
  let next = 0, failed = null;
  const pending = new Map();
  const fail = error => {
    failed = error;
    for (const p of pending.values()) p.reject(error);
    pending.clear();
  };
  worker.onerror = e => fail(new TransportError(e.message || '\\''kernel worker failed'\\''));
  worker.onmessageerror = () => fail(new TransportError('\\''kernel worker returned unreadable bytes'\\''));
  worker.onmessage = ({ data }) => {
    try {
      const { id, values: [ok, result, kernelMs, boundaryMs, workerMs] } = unpack(data);
      const p = pending.get(id);
      if ("'!p) throw new TransportError('"'\\''kernel worker returned an unknown request'\\'');
      pending.delete(id);
      if ("'!ok) { p.reject(new TransportError(result)); return; }
      if (onKernelCall) onKernelCall({ name: p.name, kernelMs, boundaryMs, workerMs, totalMs: performance.now() - p.started });
      p.resolve(result);
    } catch (e) { fail(e); }
  };
  const call = (name, ...args) => {
    if (failed) return Promise.reject(failed);
    const id = next++;
    const bytes = packet(id, [name, ...args]);
    return new Promise((resolve, reject) => {
      pending.set(id, { resolve, reject, name, started: performance.now() });
      // Transfer the packet, never the caller'"'\\''s buffer (it may be retained for
      // a retry or by the attempt store).
      try { worker.postMessage(bytes, [bytes.buffer]); }
      catch (e) { pending.delete(id); reject(e); }

//! The workspace plants: every crate directory of the repository is a workspace member (so the
//! workspace judgement builds it), no deployed crate depends on devtools, and a missing Lean exe
//! fails the calling test by name.
#![allow(clippy::unwrap_used)] // a plant that cannot set up is a failed plant
use std::fs;
use std::path::Path;

use nanodregg_devtools::{lean_bin, lean_bin_in, nd, nd_supervise, repo, supervise_host};

/// The `members = [...]` list of the root Cargo.toml.
fn members(root: &Path) -> Vec<String> {
    let text = fs::read_to_string(root.join("Cargo.toml")).unwrap();
    let line = text.lines().find(|l| l.starts_with("members")).unwrap();
    let inner = &line[line.find('[').unwrap() + 1..line.rfind(']').unwrap()];
    let mut m: Vec<String> = inner
        .split(',')
        .map(|s| s.trim().trim_matches('"').to_owned())
        .filter(|s| !s.is_empty())
        .collect();
    m.sort();
    m
}

/// Every directory under the root holding a Cargo.toml (the root itself, build output, Lean's
/// `.lake` and dot-directories excluded), as a path relative to the root.
fn crates(root: &Path) -> Vec<String> {
    let mut c = Vec::new();
    let mut stack = vec![root.to_path_buf()];
    while let Some(d) = stack.pop() {
        for e in fs::read_dir(&d).unwrap() {
            let p = e.unwrap().path();
            let name = p.file_name().unwrap().to_string_lossy().into_owned();
            if !p.is_dir() || name.starts_with('.') || name == "target" {
                continue;
            }
            if p.join("Cargo.toml").is_file() {
                c.push(p.strip_prefix(root).unwrap().to_string_lossy().into_owned());
            }
            stack.push(p);
        }
    }
    c.sort();
    c
}

#[test]
fn every_crate_directory_is_a_workspace_member_and_holds_no_lock_of_its_own() {
    let root = repo();
    let crates = crates(&root);
    assert!(crates.len() >= 5, "plant: found only {crates:?}");
    assert_eq!(
        members(&root),
        crates,
        "notAMember: a crate outside the workspace is never judged"
    );
    for c in &crates {
        assert!(
            !root.join(c).join("Cargo.lock").exists(),
            "ownLock: {c}/Cargo.lock beside the workspace's one lock"
        );
        let manifest = fs::read_to_string(root.join(c).join("Cargo.toml")).unwrap();
        assert!(
            !manifest.lines().any(|l| l.trim() == "[workspace]"),
            "ownWorkspace: {c}/Cargo.toml declares its own workspace"
        );
    }
    assert!(
        root.join("Cargo.lock").is_file(),
        "noLock: the workspace has no Cargo.lock"
    );
}

#[test]
fn no_crate_depends_on_devtools_outside_its_dev_dependencies() {
    let root = repo();
    for c in crates(&root) {
        let manifest = fs::read_to_string(root.join(&c).join("Cargo.toml")).unwrap();
        let mut section = String::new();
        for l in manifest.lines().map(str::trim) {
            if l.starts_with('[') {
                section = l.to_owned();
            } else if l.starts_with("nanodregg-devtools") {
                assert_eq!(
                    section, "[dev-dependencies]",
                    "devtoolsDeployed: {c} depends on devtools in {section}"
                );
            }
        }
    }
}

#[test]
fn a_missing_lean_exe_fails_by_name() {
    let empty = std::env::temp_dir().join(format!("nd-devtools-{}", std::process::id()));
    fs::create_dir_all(&empty).unwrap();
    let err = std::panic::catch_unwind(|| lean_bin_in(&empty, "host"));
    let _ = fs::remove_dir_all(&empty);
    let msg = err.err().unwrap();
    let msg = msg
        .downcast_ref::<String>()
        .cloned()
        .or_else(|| msg.downcast_ref::<&str>().map(|s| (*s).to_owned()))
        .unwrap();
    assert!(
        msg.contains("plant: no lake-built host at") && msg.contains("lake build host"),
        "{msg}"
    );
    // The same discovery finds this tree's host once it is built (`lake build host`).
    assert!(lean_bin("host").is_absolute());
}

/// What another crate's test does: this tree's `nd-supervise` (built by devtools) runs this tree's
/// `host serve` on a fresh Store and binds; dropping the holder stops it and removes its pid file.
#[test]
fn the_built_supervisor_runs_the_built_host() {
    assert!(nd().is_file() && nd().is_absolute());
    let root = std::env::temp_dir().join(format!("nd-dt-{}", std::process::id()));
    let _ = fs::remove_dir_all(&root);
    fs::create_dir_all(root.join("ws")).unwrap();
    let root = root.canonicalize().unwrap();
    let store = root.join("store");
    let g = std::process::Command::new(lean_bin("host"))
        .arg("genesis")
        .arg(&store)
        .arg("devtools")
        .output()
        .unwrap();
    assert!(g.status.success(), "plant: genesis: {g:?}");
    let sock = root.join("h.sock");
    let held = supervise_host(
        &nd_supervise(),
        &sock,
        &root.join("ws"),
        &store,
        &["serve", store.to_str().unwrap()],
    );
    let pid = root.join("h.sock.pid");
    assert!(
        fs::read_to_string(&pid)
            .unwrap()
            .trim()
            .parse::<u32>()
            .is_ok()
    );
    drop(held);
    assert!(!pid.exists(), "the holder removes its pid file");
    let _ = fs::remove_dir_all(&root);
}

#[test]
fn scratch_count_does_not_grow_across_one_test_run() {
    let prefix = format!("CX-GATES-scratch-{}-", std::process::id());
    let base = std::env::var_os("ND_SCRATCH").map_or_else(
        || std::path::PathBuf::from(std::env::var_os("HOME").expect("HOME")).join(".cache/nd-t"),
        std::path::PathBuf::from,
    );
    let count = || {
        fs::read_dir(&base)
            .expect("scratch base")
            .filter_map(Result::ok)
            .filter(|entry| entry.file_name().to_string_lossy().starts_with(&prefix))
            .count()
    };
    let before = count();
    let p = std::thread::spawn({
        let name = format!("{prefix}one");
        move || {
            let p = nanodregg_devtools::scratch(&name);
            assert!(p.is_dir(), "scratchAbsent: {}", p.display());
            fs::write(p.join("sentinel"), b"test").expect("write sentinel");
            p
        }
    })
    .join()
    .expect("scratch test thread");
    assert!(!p.exists(), "scratchLeaked: {}", p.display());
    assert_eq!(
        count(),
        before,
        "scratchCountGrew: one test run left a directory"
    );
}
"""gates/check.py TREE [--base-waste F] [--message F] [--changed F]
[--base-tree DIR] — every source gate, one line each, exit 1 if any is red. The build and the census are scripts/pre-push's."""
import argparse
import os
import re
import sys

import closure
import owners
import rebase
import refusals
import runs
import size
import tcb
import tree
import vectors
import waste

ap = argparse.ArgumentParser()
ap.add_argument("root")
ap.add_argument("--base-waste")
ap.add_argument("--base-tree", help="the parent tree: size rises are measured against it, and a\n                closure/refusal red the parent already had is reported as PRE-EXISTING, not red")
ap.add_argument("--message")
ap.add_argument("--owners-from", help="tree whose gates/OWNERS judges ownership (the parent)")
ap.add_argument("--changed", help="file listing the paths the commit changes (enables the owners gate)")
a, _unknown = ap.parse_known_args()  # a parent's check.py must accept a child's new flags
t = tree.read(a.root)
msg = open(a.message, encoding="utf-8").read() if a.message else ""


def has_lakefile(d):
    return any(os.path.exists(os.path.join(d, f)) for f in ("lakefile.lean", "lakefile.toml"))


def read(p):
    return open(p, encoding="utf-8").read() if p and os.path.exists(p) else None


changed = open(a.changed, encoding="utf-8").read().split() if a.changed else None


MARKER = re.compile(r"^(<{7}|>{7})(?: |$)")


def conflict_markers(root: str) -> list[str]:
    """A merge-conflict marker line (`<<<<<<< ours`, `>>>>>>> theirs`) in any file of the judged
    tree: an unresolved merge that a lane's own `git apply --3way` or `checkout -m` left in a file it
    then committed whole (4c327a7, 10-17, two decisions appended to decisions/host.md). The `=======`
    middle line is not matched: it is also a Markdown heading underline."""
    red = []
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            path = os.path.join(d, f)
            try:
                with open(path, encoding="utf-8") as fh:
                    for n, line in enumerate(fh, 1):
                        if MARKER.match(line):
                            red.append(f"{os.path.relpath(path, root)}:{n}: conflict marker {line.rstrip()[:40]!r}")
            except (UnicodeDecodeError, OSError):
                continue  # not text
    return red


def case_collisions(root: str) -> list[str]:
    """Two paths (files or directories) that differ only in case are ONE path on a case-insensitive
    disk (the Mac reader's APFS): `ops/RUNBOOK.md` silently became `Ops/RUNBOOK.md` inside the
    Lean library on 10-17 (OPS). Red by name."""
    seen: dict[str, set[str]] = {}
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        rel = os.path.relpath(d, root)
        for x in dirs + files:
            path = os.path.normpath(os.path.join(rel, x))
            seen.setdefault(path.lower(), set()).add(path)
    return [f"{' and '.join(sorted(v))} differ only in case: one path on a case-insensitive disk"
            for v in seen.values() if len(v) > 1]


results = {
    "closure": closure.check(t),
    "refusals": refusals.check(t),
    "size": size.check(t, msg, tree.read(a.base_tree) if a.base_tree and has_lakefile(a.base_tree) else None),
    "paths": case_collisions(t.root) + conflict_markers(t.root),
    "runs": runs.check(t),
    "rebase": rebase.check(t.root),
    "tcb": tcb.check(t.root),
    "vectors": vectors.check(t.root, a.base_tree if a.base_tree and has_lakefile(a.base_tree) else None),
    "waste": waste.check(read(os.path.join(t.root, "gates", "waste.tsv")) or "", read(a.base_waste), msg),
}
if changed is not None:
    src = a.owners_from if a.owners_from and os.path.exists(os.path.join(a.owners_from, "gates", "OWNERS")) else t.root
    results["owners"] = owners.check(src, changed, msg)
# Targets: a lib or exe the parent's lakefile declared and the candidate's does not is red by
# name, unless the message says `LAKE-DROP: <name>: <why>` (the toml -> lean switch must carry
# every target across).
if a.base_tree and has_lakefile(a.base_tree):
    bl = tree.lakefile(a.base_tree)
    before = {x["name"] for k in ("lean_lib", "lean_exe") for x in bl[k]}
    after = {x["name"] for k in ("lean_lib", "lean_exe") for x in t.lake[k]}
    results["targets"] = [f"lakefile dropped target {n}; needs 'LAKE-DROP: {n}: <why>'"
                          for n in sorted(before - after)
                          if not re.search(r"(?m)^LAKE-DROP:\s*" + re.escape(n) + r"\s*:\s*\S", msg)]
# A commit is refused for the reds it introduces. Reds its parent already had are printed (they
# are some layer's to fix forward, and scripts/standing.sh counts every one) but do not block an
# unrelated commit: otherwise one layer's red stops all six.
old = set()
if a.base_tree and has_lakefile(a.base_tree):
    bt = tree.read(a.base_tree)
    old = {re.sub(r":\d+", ":", r) for r in closure.check(bt) + refusals.check(bt)}
red = False
for gate, reds in results.items():
    new = []
    for r in reds:
        if gate in ("closure", "refusals") and re.sub(r":\d+", ":", r) in old:
            print(f"  {gate}: PRE-EXISTING {r}")
        else:
            print(f"  {gate}: {r}")
            new.append(r)
    print(f"{gate}: {'RED' if new else 'ok'}")
    red |= bool(new)
for w in size.WARN:
    print(f"WARN {w}")
sys.exit(1 if red else 0)


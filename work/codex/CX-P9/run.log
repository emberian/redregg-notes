/- First-class repair objects. P4; a demonstration Mini can take.
The indexed data lives here; correctness and equivalence laws live in Proofs.
The old five outcomes embed unchanged; transport adds the sixth case. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.RepairObjects

variable {D : CalculusData} {E : Type}

/-- An edit path with its source and destination in the type. -/
inductive Change (E : Type) : World E → World E → Type where
  | stay (w : World E) : Change E w w
  | edit (w : World E) (e : Edit E) : Change E w (e.apply w)
  | then {w v z : World E} : Change E w v → Change E v z → Change E w z

/-- A correspondence is data. The registry's Sound law certifies an equivalence on
checker-accepted fillings, including both inverses, not just a one-way replacement. -/
structure Correspondence (D : CalculusData) (E : Type) where
  source : Iface D E
  target : Iface D E
  forward : D.Tm → D.Tm
  backward : D.Tm → D.Tm

/-- Certificate identifiers resolve only through the supplied checked registry.
Its Sound predicate is in the proof module, just as CalculusData uses CalculusLaws. -/
abbrev Registry (D : CalculusData) (E : Type) := Nat → Option (Correspondence D E)

/-- Transport retains the original term and the certificate, so it is distinguishable
from an unrelated replacement even when their destination terms coincide. -/
structure TransportEvidence (D : CalculusData) (E : Type) where
  certificate : Nat
  correspondence : Correspondence D E
  original : Candidate D
  image : Candidate D

/-- Six semantic outcomes: the existing five, plus checked representation transport. -/
inductive Outcome (D : CalculusData) (E : Type) where
  | existing (outcome : Nanodregg.Lang.Contextual.Outcome D)
  | transported (evidence : TransportEvidence D E)

inductive OutcomeKind where
  | kept | replacement | strengthening | alternative | suspended | transported
deriving DecidableEq, Repr

def Outcome.kind : Outcome D E → OutcomeKind
  | .existing (.kept _) => .kept
  | .existing (.replacement _ _ _) => .replacement
  | .existing (.strengthening _ _ _) => .strengthening
  | .existing (.alternative _ _) => .alternative
  | .existing (.suspended _ _) => .suspended
  | .transported _ => .transported

inductive TransportRefusal where
  | unknownCertificate
  | sourceIllTyped
  | destination (status : Status)
deriving DecidableEq, Repr


/-- World-indexed state; coherence is a separate law, not an unchecked field. -/
structure State (D : CalculusData) {E : Type} (w : World E) where
  closure : Closure D E

/-- A resumable residual retains the template, all alternatives, history and world. -/
structure Residual (D : CalculusData) (E : Type) where
  world : World E
  closure : Closure D E
  outcomes : List (Outcome D E)

/-- Include obligations from every suspended alternative, not only the selected one. -/
def Residual.obligations (r : Residual D E) : List Obligation :=
  (r.closure.Φ ++ r.outcomes.flatMap (fun
    | .existing (.suspended _ obligations) => obligations
    | _ => [])).eraseDups

structure Result (D : CalculusData) {E : Type} (w : World E) where
  state : State D w
  /-- Ordered checkpoints: composition never discards intermediate obligations. -/
  residuals : List (Residual D E)
  inspected : List (Nat × Nat)
  transportRefusals : List TransportRefusal

/-- A repair is a value, abstractable over its indexed edit; arbitrary values need Sound. -/
structure Repair (D : CalculusData) {E : Type} {w v : World E} (e : Change E w v) where
  run : State D w → Result D v

def Repair.identity (w : World E) : Repair D (.stay w) :=
  ⟨fun s => ⟨s, [], [], []⟩⟩

def Repair.atomic (w : World E) (e : Edit E) : Repair D (.edit w e) :=
  ⟨fun s =>
    let r := repair w e s.closure
    ⟨⟨r.1⟩, [⟨e.apply w, r.1, r.2.1.map Outcome.existing⟩], r.2.2, []⟩⟩

def Repair.compose {w v z : World E} {e : Change E w v} {f : Change E v z}
    (r : Repair D e) (s : Repair D f) : Repair D (.then e f) :=
  ⟨fun st =>
    let a := r.run st
    let b := s.run a.state
    { b with residuals := a.residuals ++ b.residuals,
             inspected := a.inspected ++ b.inspected,
             transportRefusals := a.transportRefusals ++ b.transportRefusals }⟩

/-- Interpret a first-class edit path using the landed incremental repair. -/
def Repair.ofChange {w v : World E} : (e : Change E w v) → Repair D e
  | .stay w => .identity w
  | .edit w e => .atomic w e
  | .then e f => (Repair.ofChange e).compose (Repair.ofChange f)

/-- Resume the retained state through another edit, using the same incremental machinery. -/
def Residual.resume (r : Residual D E) (e : Edit E) : Result D (e.apply r.world) :=
  (Repair.atomic r.world e).run ⟨r.closure⟩

/-- From-scratch semantics, at any world, of the retained problem and candidates. -/
def analyze (w : World E) (cl : Closure D E) : List (List Status) :=

def ceilings(root: str) -> dict[str, tuple[int, str]]:
    """gates/ceilings.tsv: metric -> (ceiling, why). Absent file: no ceilings. A malformed row
    raises ValueError (red)."""
    p = os.path.join(root, CEILINGS)
    rows: dict[str, tuple[int, str]] = {}
    if not os.path.isfile(p):
        return rows
    for n, line in enumerate(open(p, encoding="utf-8"), 1):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.rstrip("\n").split("\t")
        if len(f) != 3 or not re.fullmatch(r"\d+", f[1]) or not f[0].strip() or not f[2].strip():
            raise ValueError(f"{CEILINGS}:{n}: need metric<TAB>ceiling (an integer)<TAB>why: {line.rstrip()!r}")
        if f[0] in rows:
            raise ValueError(f"{CEILINGS}:{n}: second row for '{f[0]}'")
        rows[f[0]] = (int(f[1]), f[2])
    return rows


HEAD = ("# SIZE — the ratchet (law 12)\n\n"
        "GENERATED by `python3 gates/size.py TREE --write` (scripts/commit writes it for every commit; never\n"
        "edit it, never pass it as a PATH). Ceilings live in `gates/ceilings.tsv`. A rise needs\n"
        "`SIZE: <metric>: <why>` in the commit message; a raised or removed ceiling needs\n"
        "`SIZE-CEILING: <metric>: <why>`.\n")


def render(measured: dict[str, int], ceil: dict[str, tuple[int, str]]) -> str:
    """The SIZE.md view: every measured metric in measurement order, then every ceiling nothing
    measured (shown `unmeasured`)."""
    lines = [HEAD, "| metric | now | ceiling |", "|---|---|---|"]
    for k, v in measured.items():
        lines.append(f"| {k} | {v} | {ceil[k][0] if k in ceil else '—'} |")
    for k, (c, _) in ceil.items():
        if k not in measured:
            lines.append(f"| {k} | unmeasured | {c} |")
    return "\n".join(lines) + "\n"


WARN: list[str] = []


def check(t: tree.Tree, message: str, base_tree: tree.Tree | None = None) -> list[str]:
    """Judge TREE against its parent tree (rises by measurement, ceilings by the parent's
    ceilings.tsv). A parent with no ceilings.tsv (the commit that introduced it) has no ceilings
    to compare: that commit was judged by the parent's own gates, which compare SIZE.md's."""
    try:
        ceil = ceilings(t.root)
        base_ceil = ceilings(base_tree.root) if base_tree is not None else {}
        measured = measure(t)
        base = measure(base_tree) if base_tree is not None else {}
    except ValueError as e:
        return [str(e)]
    red = []
    path = os.path.join(t.root, "SIZE.md")
    if not os.path.isfile(path) or open(path, encoding="utf-8").read() != render(measured, ceil):
        red.append("SIZE.md is not the generated view of this tree (scripts/commit writes it; ceilings "
                   "are edited in gates/ceilings.tsv)")

    def says(tag: str, k: str) -> bool:
        return re.search(r"(?m)^" + tag + r":\s*" + re.escape(k) + r"\s*:\s*\S", message) is not None

    for k, v in measured.items():
        if k in ceil and v > ceil[k][0]:
            red.append(f"'{k}' = {v} exceeds its ceiling {ceil[k][0]}")
        if k in base and v > base[k] and not says("SIZE", k):
            red.append(f"'{k}' rose {base[k]} -> {v}: the commit message needs 'SIZE: {k}: <why>'")
    for k, (c, _) in ceil.items():
        if k not in measured:
            # Unmeasured now but measured in the parent: this commit made a ceiling check nothing
            # (an exe renamed or dropped). Absent is not within bounds.
            if k in base and not says("SIZE-CEILING", k):
                red.append(f"'{k}' (ceiling {c}) was measured in the parent ({base[k]}) and is not now: "
                           f"its ceiling checks nothing; restore what it measures or 'SIZE-CEILING: {k}: <why>'")
            WARN.append(f"'{k}' has ceiling {c} but nothing measures it (add gates/metrics/<x>)")
    for k, (bc, _) in base_ceil.items():
        if k not in ceil and not says("SIZE-CEILING", k):
            red.append(f"ceiling '{k}' ({bc}) removed from {CEILINGS}: needs 'SIZE-CEILING: {k}: <why>'")
        elif k in ceil and ceil[k][0] > bc and not says("SIZE-CEILING", k):
            red.append(f"'{k}' ceiling raised {bc} -> {ceil[k][0]}: needs 'SIZE-CEILING: {k}: <why>'")
    return red


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("root", nargs="?", default=".")
    ap.add_argument("--write", action="store_true", help="write SIZE.md for the tree")
    a = ap.parse_args()
    t = tree.read(a.root)
    if a.write:
        open(os.path.join(t.root, "SIZE.md"), "w", encoding="utf-8").write(render(measure(t), ceilings(t.root)))
        print("size: SIZE.md written")
        sys.exit(0)
    red = check(t, "")
    for r in red:
        print(r)
    for w in WARN:
        print("WARN unmeasured:", w)
    print(f"size: {'RED' if red else 'ok'} ({len(red)})")
    sys.exit(1 if red else 0)
"""gates/closure.py TREE — the module-graph gate. Red on:

  C0 a lakefile.lean form tree.lakefile does not know, or a package without
     autoImplicit = false, relaxedAutoImplicit = false, warningAsError = true;
  C1 a .lean file outside a declared lib (a lib is `[[lean_lib]] name = X, globs = ["X.+"]`
     and owns exactly the directory X/), or a lib that is not rooted that way;
  C2 an import that is neither a tree module nor Init/Std (Lean only from Census);
  C3 a def-module exporting a theorem, or a proof-module (a `Proofs` path component)
     exporting a definition whose type is not `Prop`; private helpers are allowed on either
     side; statements (a declaration whose result type is Prop: `structure Checked … : Prop`,
     `inductive HasType : … → Prop`, `def P : X → Prop`) live in proof-modules, and a
     def-module exporting one is red;
  C4 a def-module importing a proof-module;
  C5 a module outside Census importing Census;
  C6 a lean_exe root that is a proof-module or not a tree module;
  C7 a lean_exe root that declares anything but `main` (logic lives in a lib module, which the
     census sees; the census skips exe roots, so two exes' `main`s never meet);
  C8 a C source outside an extern_lib's <Lib>/c directory, or an extern_lib directory that is
     not <Lib>/c of a declared lib.
  C9 a deployed def-module (neither a proof-module nor tooling, tree.Module.is_tooling)
     importing a tooling module: the size ratchet's deployed count excludes tooling, so deployed
     code may not depend on it.
  C10 a module outside Ops importing an Ops module: Ops is a renderer and driver over the
     Host/Protocol/Client tables, never an "ops utilities" hub (ROOT 10-17, OPS's request).
"""
import os
import sys

import tree


OPTIONS = ("⟨`autoImplicit, false⟩", "⟨`relaxedAutoImplicit, false⟩", "⟨`warningAsError, true⟩")


def check(t: tree.Tree) -> list[str]:
    red = [f"C0 lakefile.lean: {e}" for e in t.lake.get("errors", [])]
    for o in OPTIONS:
        if o not in t.lake.get("options", ""):
            red.append(f"C0 lakefile.lean: package leanOptions must contain {o}")
    libs = {}
    for lib in t.lake.get("lean_lib", []):
        name = lib["name"]
        if lib.get("globs") != [f"{name}.+"] or "roots" in lib:
            red.append(f"C1 lib {name}: must be rooted by globs = [\"{name}.+\"] and nothing else")
        libs[name] = lib
    for m in t.modules.values():
        if "." not in m.name:
            red.append(f"C1 {m.path}: a top-level module is an umbrella hub; put it in a layer directory")
        elif m.lib not in libs:
            red.append(f"C1 {m.path}: directory {m.lib}/ is not a declared lean_lib in lakefile.lean")
    for m in t.modules.values():
        for i in m.imports:
            root = i.split(".")[0]
            if i in t.modules:
                target = t.modules[i]
                if not m.is_proof and target.is_proof:
                    red.append(f"C4 {m.name} (def-module) imports proof-module {i}")
                if not m.is_proof and not m.is_tooling and target.is_tooling:
                    red.append(f"C9 {m.name} (deployed) imports tooling module {i}")
                if target.lib == "Ops" and m.lib != "Ops":
                    red.append(f"C10 {m.name} imports {i}: Ops renders and drives the other layers' tables, nothing depends on it")
                if target.lib == "Census" and m.lib != "Census":
                    red.append(f"C5 {m.name} imports {i}: Census is build tooling, never a dependency")
            elif root in ("Init", "Std"):
                pass
            elif root == "Lean" and m.lib == "Census":
                pass
            else:
                red.append(f"C2 {m.name} imports {i}: not a tree module and not Init/Std")
        for d in m.decls:
            if d.private or d.kind in ("example", "axiom"):
                continue  # example/axiom are refusals.py's
            if m.is_proof and d.kind in tree.DEF_KINDS and not d.is_prop:
                red.append(f"C3 {m.path}:{d.line} proof-module exports {d.kind} {d.name}")
            if not m.is_proof and d.kind in tree.DEF_KINDS and d.is_prop:
                red.append(f"C3 {m.path}:{d.line} def-module exports statement {d.kind} {d.name} (its type is "
                           f"Prop); statements belong in a Proofs module")
            if not m.is_proof and d.kind in tree.THEOREM_KINDS:
                red.append(f"C3 {m.path}:{d.line} def-module exports theorem {d.name}; "
                           f"move it to a Proofs module or make it private")
    for exe, root in t.exes.items():
        if root not in t.modules:
            red.append(f"C6 lean_exe {exe}: root {root} is not a tree module")
        elif t.modules[root].is_proof:
            red.append(f"C6 lean_exe {exe}: root {root} is a proof-module")
        else:
            others = [f"{d.kind} {d.name}" for d in t.modules[root].decls if not (d.kind == "def" and d.name == "main")]
            if others or not any(d.name == "main" for d in t.modules[root].decls):
                red.append(f"C7 lean_exe {exe}: root {root} must declare only `main` "
                           f"(found: {', '.join(others) or 'no main'})")
    cdirs = set()
    for ext in t.lake.get("extern_lib", []):
        for d in ext["cdirs"]:
            if d.split("/")[0] not in libs or d != d.split("/")[0] + "/c":
                red.append(f"C8 extern_lib {ext['name']}: {d} is not <Lib>/c of a declared lib")
            cdirs.add(d)
    for d, dirs, files in os.walk(t.root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith((".c", ".h", ".cc", ".cpp", ".m")):
                rel = os.path.relpath(os.path.join(d, f), t.root)
                if os.path.dirname(rel) not in cdirs:
                    red.append(f"C8 {rel}: C source outside every extern_lib directory")
    return red


if __name__ == "__main__":
    red = check(tree.read(sys.argv[1] if len(sys.argv) > 1 else "."))
    for r in red:
        print(r)
    print(f"closure: {'RED' if red else 'ok'} ({len(red)})")
    sys.exit(1 if red else 0)


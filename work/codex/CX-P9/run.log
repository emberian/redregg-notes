/-
# Lang.Contextual.CoreCalculus — CMTT's data as a `CalculusData` (lane CMTT-CORE)

The data half of CMTT as an instance of CLOSURE's abstract calculus (`Lang.Contextual.Closure`);
the laws are `Lang.Proofs.Contextual.CoreInstance.cmttLaws`, over the typing judgment
`fun Ω => HasTy (holeEnv Ω)`. A template's holes are the FREE metavariables of a Core term: the
hole named `n` is `mvar (n + d)` under `d` `letbox`es.
-/
import Lang.Contextual.Core
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

/-- The modal environment of a hole list: the hole named `n` is the first declaration named `n`. -/
def holeEnv (Ω : List (HoleDecl Ctx Ty)) : MEnv := fun n =>
  (Ω.find? fun d => d.name == n).map fun d => (d.ctx, d.ty)

/-- CMTT's data: hand-written decidable equality, hole filling `msubstP θ 0`, the exact checker,
free-variable occurrence, context deletion, strengthening/weakening at a position, variables. -/
def cmttData : CalculusData where
  Ty := Ty
  Ctx := Ctx
  Tm := Tm
  tmEq := Tm.decEq
  msubst θ t := msubstP θ 0 t
  check := check
  uses t x := uses x t
  drop Γ x := Γ.eraseIdx x
  strengthen x t := unshiftAt x t
  weaken x t := shiftAt x t
  var := Tm.var
  lookup Γ x := Γ[x]?

end Nanodregg.Lang.Contextual
/- P5: finite completion judgments, suspended negation, polarized transition systems.
A finite domain is part of the QUESTION, never inferred from the retained search list.
Refutation evidence is data; only judge checks it. Soundness is in Proofs/Contextual/P5. -/
import Lang.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.P5


/-- Four logical outcomes. Open always names at least one obligation. -/
inductive LogicalStatus (Witness Refutation Ob Reason : Type) where
  | witnessed (witness : Witness)
  | open (first : Ob) (rest : List Ob)
  | refuted (evidence : Refutation)
  | outsideThisProcedure (reason : Reason)
deriving DecidableEq, Repr

inductive Need where
  | searchRemaining
  | invalidRefutation
  | unfilled (atom : Nat)
  | admission
  | interaction (name : Nat)
  | gaveUp (name : Nat)
deriving DecidableEq, Repr

inductive Limit where
  | unsupportedFragment
  | budgetExhausted
deriving DecidableEq, Repr

structure Problem (A : Type) where
  domain : List A
  accepts : A → Bool

/-- An exclusion argument enumerates candidates, and the checker replays every exclusion. -/
structure Refutation (A : Type) where
  excluded : List A
deriving DecidableEq, Repr

variable {A : Type} [DecidableEq A]

def Problem.valid (p : Problem A) (a : A) : Bool :=
  decide (a ∈ p.domain) && p.accepts a

def checkRefutation (p : Problem A) (r : Refutation A) : Bool :=
  p.domain.all (fun a => decide (a ∈ r.excluded)) &&
    r.excluded.all (fun a => !p.accepts a)

/-- Supported retained search with an optional checked impossibility argument.
No certificate, or a bad certificate, leaves the completion question OPEN. -/
def judge (p : Problem A) (retained : List A) (certificate : Option (Refutation A))
    (limit : Option Limit := none) : LogicalStatus A (Refutation A) Need Limit :=
  match limit with
  | some why => .outsideThisProcedure why
  | none =>
    match retained.find? p.valid with
    | some a => .witnessed a
    | none =>
      match certificate with
      | none => .open .searchRemaining []
      | some r =>
        if checkRefutation p r then .refuted r else .open .invalidRefutation []

/-- Open Boolean syntax. A missing atom is a residual, including under negation.
Conjunction is strict: both judgments must finish; it performs no Boolean shortcut. -/
inductive Formula where
  | atom (name : Nat)
  | neg (body : Formula)
  | conj (left right : Formula)
deriving DecidableEq, Repr

inductive Evaluation where
  | value (b : Bool)
  | suspended (first : Nat) (rest : List Nat)
deriving DecidableEq, Repr

def Evaluation.neg : Evaluation → Evaluation
  | .value b => .value (!b)
  | .suspended n ns => .suspended n ns

def Evaluation.conj : Evaluation → Evaluation → Evaluation
  | .value a, .value b => .value (a && b)
  | .suspended n ns, .suspended m ms => .suspended n (ns ++ m :: ms)
  | .suspended n ns, .value _ => .suspended n ns
  | .value _, .suspended n ns => .suspended n ns

def evaluate (env : Nat → Option Bool) : Formula → Evaluation
  | .atom n => match env n with
    | some b => .value b
    | none => .suspended n []
  | .neg p => (evaluate env p).neg
  | .conj p q => (evaluate env p).conj (evaluate env q)

/-- Input-deterministic interface automata; outputs may be nondeterministic.
A receive is chosen by the peer (LANG-67 'theirs'); an emission by us ('ours').
No hidden/internal actions or fairness claim are included. -/
structure Machine (State Input Output : Type) where
  receive : State → Input → Option State
  emit : State → List (Output × State)

inductive Action (Input Output : Type) where
  | input (value : Input)
  | output (value : Output)
deriving DecidableEq, Repr

def Action.owner {I O : Type} : Action I O → Protocol.Polarity
  | .input _ => .theirs
  | .output _ => .ours

def receiveAll {S I O : Type} (m : Machine S I O) : S → List I → Option S
  | s, [] => some s
  | s, i :: is => (m.receive s i).bind (fun s' => receiveAll m s' is)

/-- Price receiver with a one-use input and a pending reply. -/
def priceReceiver (cap : Nat) (outputs : List Bool) : Machine Bool Nat Bool where
  receive s n := if s = false ∧ n ≤ cap then some true else none
  emit s := if s then outputs.map (fun b => (b, false)) else []

/-- A status session: each revision carries its question, retained search and certificate.
Keeping questions explicit prevents a refutation of yesterday's domain being reused today. -/
structure Request (A : Type) where
  problem : Problem A
  retained : List A
  certificate : Option (Refutation A)
  limit : Option Limit

def runSession (requests : List (Request A)) : List (LogicalStatus A (Refutation A) Need Limit) :=
  requests.map fun q => judge q.problem q.retained q.certificate q.limit

def statusSession : List (Request Nat) :=
  [⟨⟨[0, 1], fun n => n == 1⟩, [0], none, none⟩,
   ⟨⟨[0, 1], fun n => n == 1⟩, [0, 1], none, none⟩,
   ⟨⟨[0, 1], fun _ => false⟩, [0, 1], some ⟨[0, 1]⟩, none⟩,
   ⟨⟨[0, 1], fun _ => false⟩, [], none, some .unsupportedFragment⟩]

end Nanodregg.Lang.Contextual.P5
/-
# nanodregg — the one build (owner: BUILD-GATES; every layer adds its own `lean_lib`).

The file is a table, not a program: gates/tree.py reads it with a strict grammar and refuses any
top-level form it does not know (closure C0). The forms are
  * `package nanodregg where leanOptions := …` — warnings are errors, no auto-bound implicits;
  * `@[default_target] lean_lib X where globs := #[.submodules `X]` — one per layer directory,
    every file in X/ built, no umbrella module, no orphan (C1);
  * `@[default_target] lean_exe «name» where root := `M` — M holds only `main` (C7);
  * `extern_lib «ndhost»` — every Host/c/*.c, cc -Wall -Wextra -Werror, into libndhost.a. The only
    C in the tree; built from source, never a prebuilt object (ROOT ruling 2026-10-16).
No packages: Lean core and Std only (decisions/gates.md GATES-1). A bare `lake build` builds
every target, so it can never succeed by building nothing.
-/
import Lake
open Lake DSL System

package nanodregg where
  leanOptions := #[⟨`autoImplicit, false⟩, ⟨`relaxedAutoImplicit, false⟩, ⟨`warningAsError, true⟩]

-- The axiom census command (Census.Axioms): build tooling, the only place `import Lean` is
-- allowed; nothing outside Census may import it (gates/closure.py C2, C5).
@[default_target] lean_lib Census where
  globs := #[.submodules `Census]

@[default_target] lean_lib Kernel where
  globs := #[.submodules `Kernel]

@[default_target] lean_lib Protocol where
  globs := #[.submodules `Protocol]

@[default_target] lean_lib Host where
  globs := #[.submodules `Host]

@[default_target] lean_lib Lang where
  globs := #[.submodules `Lang]

@[default_target] lean_lib Codec where
  globs := #[.submodules `Codec]

@[default_target] lean_lib Hosting where
  globs := #[.submodules `Hosting]

-- LEDGER: packages over the ledger receivers (the escrow), their proofs and their journey.
@[default_target] lean_lib Ledger where
  globs := #[.submodules `Ledger]

-- HOSTING's grain lifecycle through KERNEL's receivers, with its plants (standing's sim stage).
@[default_target] lean_exe «hosting-sim» where
  root := `Hosting.Sim.Main

-- HOSTING's controller: follows one Store (Host.Tail), writes Hosting.Wire actions to grain-launch.
@[default_target] lean_exe «hosting-controller» where
  root := `Hosting.Main

-- One Lean-planned launch for launcher/tests/isolation.rs (a stand-in controller without a Store).
@[default_target] lean_exe «hosting-drive» where
  root := `Hosting.DriveMain

-- HOSTING's provider-key broker decider: keybroker's child, every ask decided by Hosting.Broker.
@[default_target] lean_exe «hosting-broker» where
  root := `Hosting.BrokerMain

-- nd-members' decider (HOSTING-33): the World's resident grains, nothing else (no clock, no key slots).
@[default_target] lean_exe «hosting-residents» where
  root := `Hosting.ResidentsMain

-- THE BAR's hosted Hermes (HOSTING-27): a resident grain's program; answers its bell through its
-- member socket with what keybroker answers on its broker socket.
@[default_target] lean_exe «resident» where
  root := `Hosting.Resident.Main


-- The Rust copy of the protocol table (client/src/generated.rs). Imports Protocol; nothing imports it.
@[default_target] lean_lib Emit where
  globs := #[.submodules `Emit]

@[default_target] lean_exe «emit-rust» where
  root := `Emit.Main

/usr/local/bin/swarm-build


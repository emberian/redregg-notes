/-
# Lang.Contextual.Core — contextual modal type theory, simply typed (lane CMTT-CORE)

The simply-typed fragment of Nanevski–Pfenning–Pientka, *Contextual Modal Type Theory* (TOCL
2008), with explicit simultaneous substitutions, de Bruijn indices for both kinds of variable.

* `Ty`: `base`, `arr A B`, and the contextual type `box Ψ A` (`[Ψ ⊢ A]`).
* `Ctx := List Ty` (ordinary variables; index 0 is the most recent binding) and the modal
  environment `MEnv := Nat → Option (Ctx × Ty)` (`Δ u = some (Ψ, A)` declares `u :: (Ψ ⊢ A)`;
  index 0 is the most recent `letbox`; the free metavariables of a template — its holes — are
  the indices past the bound ones, so a hole's NAME is its index at depth 0).
* `Tm`: `var i`, `lam A t`, `app t s`, `box Ψ t` (closes `t` over `Ψ`: `t`'s ordinary variables
  are `Ψ`'s and nothing else), `letbox t s` (binds one metavariable in `s`), and `mvar u σ`, the
  occurrence `u[σ]` carrying a simultaneous substitution `σ` for `u`'s local context.

Ordinary substitution is defined once over functions (`substFn f`, the instantiation of every
variable `i` by `f i`); a list `σ` denotes the function `ofList σ`, which is `σ` on its first
`σ.length` indices and the identity shifted down by `σ.length` after them (so `subst [s] t` is
β's `t[s/0]`, and `comp τ σ = σ.map (subst τ) ++ τ` is the composition exactly). `box` is opaque
to ordinary substitution and renaming: its body has no ordinary free variable of the ambient
context to rename. Metavariable renaming `mren` and metavariable substitution `msubst` go
inside `box`.

The judgments (`HasTy`, `HasSubst`, `Step`) are statements, so they live in the proof module
`Lang.Proofs.Contextual.Typing` (gate C3); this module is data only.
-/

namespace Nanodregg.Lang.Contextual

/-- Simple types with the contextual box `[Ψ ⊢ A]`. -/
inductive Ty
  | base
  | arr (dom cod : Ty)
  | box (ctx : List Ty) (ty : Ty)
  deriving Repr

/-- Ordinary contexts: index 0 is the most recently bound variable. -/
abbrev Ctx := List Ty

/-- Modal environments: `Δ u = some (Ψ, A)` is the declaration `u :: (Ψ ⊢ A)`. A function rather
than a list, so a PARTIAL metavariable substitution (`msubstP`) removes the filled declarations
and leaves every other one at its index: a list has no gaps. -/
abbrev MEnv := Nat → Option (Ctx × Ty)

/-- The empty modal environment. -/
def MEnv.nil : MEnv := fun _ => none

/-- Bind one more metavariable, at index 0 (what `letbox` does). -/
def MEnv.cons (P : Ctx × Ty) (Δ : MEnv) : MEnv
  | 0 => some P
  | v + 1 => Δ v

/-- Declare `P` at index `k`, moving the declarations at `k` and above up by one. -/
def MEnv.insert (k : Nat) (P : Ctx × Ty) (Δ : MEnv) : MEnv := fun v =>
  if v < k then Δ v else if v = k then some P else Δ (v - 1)

inductive Tm
  | var (i : Nat)
  | lam (dom : Ty) (body : Tm)
  | app (fn arg : Tm)
  /-- `box Ψ t`: the body is typed under `Ψ` alone. -/
  | box (ctx : Ctx) (body : Tm)
  /-- `letbox t s`: `t : [Ψ ⊢ A]`, and `s` sees one more metavariable, at index 0. -/
  | letbox (scrut body : Tm)
  /-- `mvar u σ`: the occurrence `u[σ]`, `σ` a substitution for `u`'s local context. -/
  | mvar (u : Nat) (σ : List Tm)
  deriving Repr

/-! ## Renaming of ordinary variables -/

/-- A renaming under one more ordinary binder. -/
def upR (ρ : Nat → Nat) : Nat → Nat
  | 0 => 0
  | i + 1 => ρ i + 1

mutual
/-- Rename the ordinary free variables of a term (not inside `box`: a box body is closed over the
ambient context). -/
def rename (ρ : Nat → Nat) : Tm → Tm
  | .var i => .var (ρ i)
  | .lam A t => .lam A (rename (upR ρ) t)
  | .app t s => .app (rename ρ t) (rename ρ s)
  | .box Ψ t => .box Ψ t
  | .letbox t s => .letbox (rename ρ t) (rename ρ s)
  | .mvar u σ => .mvar u (renameL ρ σ)
def renameL (ρ : Nat → Nat) : List Tm → List Tm
  | [] => []
  | t :: σ => rename ρ t :: renameL ρ σ
end

/-! ## Renaming of metavariables -/

mutual
/-- Rename the metavariables of a term (everywhere, `box` bodies included). -/
def mren (ρ : Nat → Nat) : Tm → Tm
  | .var i => .var i
  | .lam A t => .lam A (mren ρ t)
  | .app t s => .app (mren ρ t) (mren ρ s)
  | .box Ψ t => .box Ψ (mren ρ t)
  | .letbox t s => .letbox (mren ρ t) (mren (upR ρ) s)
  | .mvar u σ => .mvar (ρ u) (mrenL ρ σ)
def mrenL (ρ : Nat → Nat) : List Tm → List Tm
  | [] => []
  | t :: σ => mren ρ t :: mrenL ρ σ
end

/-- Modal weakening by one: every metavariable index moves up by one. -/
def mshift (t : Tm) : Tm := mren Nat.succ t

/-! ## Simultaneous substitution of ordinary variables -/

/-- A substitution under one more ordinary binder. -/
def upS (f : Nat → Tm) : Nat → Tm
  | 0 => .var 0
  | i + 1 => rename Nat.succ (f i)

/-- A substitution under one more metavariable binder (`letbox`). -/
def mshiftS (f : Nat → Tm) : Nat → Tm := fun i => mshift (f i)

mutual
/-
# Lang.Contextual.CoreCalculus — CMTT's data as a `CalculusData` (lane CMTT-CORE)

The data half of CMTT as an instance of CLOSURE's abstract calculus (`Lang.Contextual.Closure`);
the laws are `Lang.Proofs.Contextual.CoreInstance.cmttLaws`, over the typing judgment
`fun Ω => HasTy (holeEnv Ω)`. A template's holes are the FREE metavariables of a Core term: the
hole named `n` is `mvar (n + d)` under `d` `letbox`es.
-/
import Lang.Contextual.Core
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

/-- The modal environment of a hole list: the hole named `n` is the first declaration named `n`. -/
def holeEnv (Ω : List (HoleDecl Ctx Ty)) : MEnv := fun n =>
  (Ω.find? fun d => d.name == n).map fun d => (d.ctx, d.ty)

/-- CMTT's data: hand-written decidable equality, hole filling `msubstP θ 0`, the exact checker,
free-variable occurrence, context deletion, strengthening/weakening at a position, variables. -/
def cmttData : CalculusData where
  Ty := Ty
  Ctx := Ctx
  Tm := Tm
  tmEq := Tm.decEq
  msubst θ t := msubstP θ 0 t
  check := check
  uses t x := uses x t
  drop Γ x := Γ.eraseIdx x
  strengthen x t := unshiftAt x t
  weaken x t := shiftAt x t
  var := Tm.var
  lookup Γ x := Γ[x]?

end Nanodregg.Lang.Contextual
/- A guarded hole: retained candidates, withdrawable facts and blocker reasons.
Acceptance dispatches the selected value as an ordinary activity. -/
import Lang.StdActivity

namespace Nanodregg.Lang.Std

def holeState : Ty := .record [("accepted", .bool), ("acceptor", .digest),
  ("cap", .nat), ("chooser", .digest), ("closes", .nat), ("selected", optTy .digest)]

def holeSupport : Ty := .record [("cell", .digest), ("pin", .digest)]

def holeStatus : Ty := .sum [("conflict", .bytes), ("pruned", .bytes),
  ("suspended", .bytes), ("verified", .record [])]

def holeCandidate (V : Ty) : Ty := .record [
  ("blocker", optTy holeSupport), ("by", .digest), ("reason", .bytes),
  ("s0", optTy holeSupport), ("s1", optTy holeSupport), ("status", holeStatus), ("value", V)]

def holeCandidates (V : Ty) : RelDecl :=
  ⟨[("cand", .digest)], holeCandidate V, 64, none, 0, false, some "proposed"⟩

def holeFacts : RelDecl := ⟨[("cell", .digest)],
  .record [("by", .digest), ("pin", .digest)], 64, none, 0, true, some "posted"⟩

/-- A read of at most three fact rows: two positive supports and one blocker.
Matching is by cell identity, never by the order in which the pins arrived. -/
def holeFactsView : Ty := readsTy [("facts", holeFacts)] [("facts", ⟨3, none⟩)]

/-- Internal judgment preserves each refusal name until it is rendered either
as a retained row status or a method refusal. -/
def holeVerdict : Ty := .sum [
  ("conflict", .record []), ("pruned", .record []),
  ("support0Moved", .record []), ("support0Withdrawn", .record []),
  ("support1Moved", .record []), ("support1Withdrawn", .record []),
  ("verified", .record [])]

private abbrev H := List Label → Term
private def hv (x : Label) : H := fun sc => .var (sc.idxOf x)
private def hc (t : Term) : H := fun _ => t
private def hg (t : H) (l : Label) : H := fun sc => .get (t sc) l
private def hr (fs : List (Label × H)) : H :=
  fun sc => .record (Row.sort (fs.map fun (l, t) => (l, t sc)))
private def hi (T : Ty) (l : Label) (t : H) : H := fun sc => .inj T l (t sc)
private def hl (x : Label) (T : Ty) (t : H) : H := fun sc => .lam T (t (x :: sc))
private def ha (f : H) (xs : List H) : H := fun sc => activityApply (f sc) (xs.map (· sc))
private def hf (t : H) (arms : List (Label × Label × H)) : H :=
  fun sc => .case (t sc) (Row.sort (arms.map fun (l, x, b) => (l, b (x :: sc))))
private def ht (c a b : H) : H := fun sc => .ite (c sc) (a sc) (b sc)
private def hp (p : Prim) (a b : H) : H := fun sc => .prim p (a sc) (b sc)
private def he (T : Ty) (a b : H) : H := fun sc => eqData T (a sc) (b sc)
private def hu (t : H) (fs : List (Label × H)) : H :=
  fun sc => .extend (t sc) (Row.sort (fs.map fun (l, b) => (l, b sc)))
private def hn : H := hr []
private def hb (b : Bool) : H := hc (.bool b)
private def hs (s : String) : H := hc (.bytes s.toUTF8)
private def hnone (T : Ty) : H := hi (optTy T) "none" hn
private def hsome (T : Ty) (t : H) : H := hi (optTy T) "some" t


private def hlet (name : Label) (T : Ty) (value body : H) : H :=
  ha (hl name T body) [value]

/-- One point's observation: absent 0, same token 1, moved version 2. -/
def holeProbePoint : Term :=
  (hl "s" holeSupport (hl "point" (pointTy holeFacts)
    (hf (hv "point") [
      ("none", "_", hc (.nat 0)),
      ("some", "p", ht (hp .deq (hg (hg (hv "p") "key") "cell") (hg (hv "s") "cell"))
        (hf (hg (hv "p") "val") [
          ("none", "_", hc (.nat 0)),
          ("some", "f", ht (hp .deq (hg (hv "f") "pin") (hg (hv "s") "pin"))
            (hc (.nat 1)) (hc (.nat 2)))])
        (hc (.nat 0)))]))) []

/-- Bounded lookup by identity. Bind the probe once; its syntax is not copied
into every continuation branch. Real row views have at most one point per key. -/
def holeSupportProbe : Term :=
  let pointTy := Ty.fn holeSupport (.fn (pointTy holeFacts) .nat)
  let probe (i : Label) := ha (hv "probe") [hv "s", hg (hg (hv "rows") "facts") i]
  let anyEq (n : Nat) := ht (hp .eq (hv "p0") (hc (.nat n))) (hb true)
    (ht (hp .eq (hv "p1") (hc (.nat n))) (hb true) (hp .eq (hv "p2") (hc (.nat n))))
  (hl "s" holeSupport (hl "rows" holeFactsView
    (hlet "probe" pointTy (hc holeProbePoint)
      (hlet "p0" .nat (probe "p0") (hlet "p1" .nat (probe "p1")
        (hlet "p2" .nat (probe "p2")
          (ht (anyEq 1) (hc (.nat 1)) (ht (anyEq 2) (hc (.nat 2)) (hc (.nat 0)))))))))) []

def holeVerdictLabel (allowed blocked : Bool) (s0 s1 : Nat) : Label :=
  if !allowed then "conflict" else if blocked then "pruned"
  else if s0 != 1 then (if s0 = 2 then "support0Moved" else "support0Withdrawn")
  else if s1 != 1 then (if s1 = 2 then "support1Moved" else "support1Withdrawn")
  else "verified"

/-- The fixed judgment truth table, as executable core code. -/
def holeDecision : Term :=
  let verdict (l : Label) := hi holeVerdict l hn
  (hl "allowed" .bool (hl "blocked" .bool (hl "s0" .nat (hl "s1" .nat
    (ht (hv "allowed")
      (ht (hv "blocked") (verdict "pruned")
        (ht (hp .eq (hv "s0") (hc (.nat 1)))
          (ht (hp .eq (hv "s1") (hc (.nat 1))) (verdict "verified")
            (ht (hp .eq (hv "s1") (hc (.nat 2)))
              (verdict "support1Moved") (verdict "support1Withdrawn")))
          (ht (hp .eq (hv "s0") (hc (.nat 2)))
            (verdict "support0Moved") (verdict "support0Withdrawn"))))
      (verdict "conflict")))))) []

/-- Observation expressions in scope probe, rows, candidate, state. Each term
reads the actual clause or a concrete optional support from the pinned view. -/
def holeObservationTerms (clause : Term) : List Term :=
  let probe (s : H) := ha (hv "probe") [s, hv "rows"]
  let support (name : Label) := hf (hg (hv "c") name)
    [("none", "_", hc (.nat 1)), ("some", "s", probe (hv "s"))]
  let blocked := hf (hg (hv "c") "blocker") [
    ("none", "_", hb false),
    ("some", "s", hp .eq (probe (hv "s")) (hc (.nat 1)))]
  ([ha (hc clause) [hv "state", hg (hv "c") "value"],
    blocked, support "s0", support "s1"] : List H).map (· ["probe", "rows", "c", "state"])

/-- The state clause, blocker and supports are recomputed from the pinned view.
The candidate's recorded status is never trusted. -/
def holeJudge (V : Ty) (clause : Term) : Term :=
  let probeTy := Ty.fn holeSupport (.fn holeFactsView .nat)
  .lam holeState (.lam (holeCandidate V) (.lam holeFactsView
    (.app (.lam probeTy (activityApply holeDecision (holeObservationTerms clause)))
      holeSupportProbe)))

/-- Render judgment into the row while keeping the pruning reason separately
on the candidate even after its blocker is withdrawn. -/
def holeStatusOf : Term :=
  (hl "reason" .bytes (hl "verdict" holeVerdict
    (hf (hv "verdict") [
      ("conflict", "_", hi holeStatus "conflict" (hs "clause")),
      ("pruned", "_", hi holeStatus "pruned" (hv "reason")),
      ("support0Moved", "_", hi holeStatus "suspended" (hs "support0 moved")),
      ("support0Withdrawn", "_", hi holeStatus "suspended" (hs "support0 withdrawn")),
      ("support1Moved", "_", hi holeStatus "suspended" (hs "support1 moved")),
      ("support1Withdrawn", "_", hi holeStatus "suspended" (hs "support1 withdrawn")),
      ("verified", "_", hi holeStatus "verified" hn)]))) []


/-- The admission gate used by select, fill and accept. Rejudge does not call it. -/
def holeVerdictCheck : Term :=
  (hl "verdict" holeVerdict (hf (hv "verdict") [
    ("conflict", "_", hc (.refuse .bool "conflict".toUTF8)),


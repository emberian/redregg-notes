/- The boundary declaration: four independent observations, with explicit failed obligations.
This is a demonstration Mini can take; no wire or existing judgment changes. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

inductive Observation where
  | typingInterface
  | logicalContract
  | observableBehavior
  | costGuarantee
deriving DecidableEq, Repr

def Observation.all : List Observation :=
  [.typingInterface, .logicalContract, .observableBehavior, .costGuarantee]

/-- The powerset lattice: demanding cost does not imply demanding a particular behavior. -/
abbrev Declaration := Observation → Bool

def Declaration.meet (a b : Declaration) : Declaration := fun o => a o && b o
def Declaration.join (a b : Declaration) : Declaration := fun o => a o || b o
def Declaration.bottom : Declaration := fun _ => false
def Declaration.top : Declaration := fun _ => true

/-- A boundary belongs to a concrete hole interface. The behavior projection specifies exactly
what downstream caches may observe. The cost promise is separate from admission's budget. -/
structure Boundary (D : CalculusData) (E V : Type) where
  iface : Iface D E
  declares : Declaration
  behavior : E → D.Tm → V
  costBound : Nat

def Observation.Value (V : Type) : Observation → Type
  | .observableBehavior => V
  | _ => Bool

instance {V : Type} [DecidableEq V] (o : Observation) :
    DecidableEq (o.Value V) := by cases o <;> simp only [Observation.Value] <;> infer_instance

def Boundary.read {D : CalculusData} {E V : Type} (b : Boundary D E V)
    (w : World E) (c : Candidate D) : (o : Observation) → o.Value V
  | .typingInterface => D.check b.iface.ctx c.filling b.iface.ty
  | .logicalContract => b.iface.guard w.env c.filling
  | .observableBehavior => b.behavior w.env c.filling
  | .costGuarantee => decide (c.cost ≤ b.costBound)

/-- A failed declaration propagates an obligation bearing the hole name AND observation.
The old observation is retained as the reference, never overwritten by the repair's answer. -/
def Boundary.failures {D : CalculusData} {E V : Type} [DecidableEq V]
    (b : Boundary D E V) (w w' : World E) (c c' : Candidate D) : List Observation :=
  Observation.all.filter fun o => b.declares o && !decide (b.read w c o = b.read w' c' o)

/-- Inspect the actual selections after a repair/chooser session. An absent filling cannot
re-establish a declaration; all its promised observations remain obligations. -/
def Boundary.obligations {D : CalculusData} {E V : Type} [DecidableEq V]
    (b : Boundary D E V) (w w' : World E) (cl cl' : Closure D E) : List (Nat × Observation) :=
  let failed := match cl.selectedCand b.iface.name, cl'.selectedCand b.iface.name with
    | some c, some c' => b.failures w w' c c'
    | _, _ => Observation.all.filter b.declares
  failed.map fun o => (b.iface.name, o)

namespace BoundarySearch

/-- A small executable search calculus, not an encoding of deployed Lang terms.
The constructors denote actual algorithms below, not arbitrary supplied answers/costs. -/
inductive Term where
  | binary
  | linear
  | var (n : Nat)
  | hole (n : Nat)
deriving DecidableEq, Repr

def data : CalculusData where
  Ty := Unit
  Ctx := List Unit
  Tm := Term
  tmEq := inferInstance
  msubst σ t := match t with | .hole n => (σ n).getD t | _ => t
  check Γ t _ := match t with
    | .binary | .linear => true
    | .var n => (Γ[n]?).isSome
    | .hole _ => false
  uses t n := match t with | .var m => m == n | _ => false
  drop Γ n := Γ.eraseIdx n
  strengthen n t := match t with | .var m => .var (if m < n then m else m - 1) | _ => t
  weaken n t := match t with | .var m => .var (if m < n then m else m + 1) | _ => t
  var := .var
  lookup Γ n := Γ[n]?

structure Input where
  xs : List Nat
  key : Nat
deriving DecidableEq, Repr

/-- One step is one key probe (equality plus direction); not elapsed time or list traversal. -/
def linear (key : Nat) : List Nat → Bool × Nat
  | [] => (false, 0)
  | x :: xs =>
    if key = x then (true, 1)
    else let r := linear key xs; (r.1, r.2 + 1)

/-- Bounded binary search; fuel exhaustion is distinct from a negative membership answer. -/
def binary : Nat → List Nat → Nat → Option (Bool × Nat)
  | 0, _, _ => none
  | fuel + 1, xs, key =>
    if xs.isEmpty then some (false, 0)
    else
      let mid := xs.length / 2
      let x := xs.getD mid 0
      if key = x then some (true, 1)
/- Boundary declarations: the lattice, reuse licenses, dependent types, and concrete sessions. -/
import Lang.Contextual.Boundary
import Lang.Proofs.Contextual.Judge

namespace Nanodregg.Lang.Contextual
-- Lean's finite default maxHeartbeats cap applies; no local budget override.

def Declaration.Le (a b : Declaration) : Prop := ∀ o, a o = true → b o = true

theorem Declaration.le_refl (a : Declaration) : a.Le a := fun _ h => h

theorem Declaration.le_trans {a b c : Declaration} (hab : a.Le b) (hbc : b.Le c) :
    a.Le c := fun o ho => hbc o (hab o ho)

theorem Declaration.le_antisymm {a b : Declaration} (hab : a.Le b) (hba : b.Le a) :
    a = b := by
  funext o
  cases ha : a o <;> cases hb : b o <;> simp_all [Declaration.Le]

theorem Declaration.meet_glb (a b c : Declaration) :
    c.Le (a.meet b) ↔ c.Le a ∧ c.Le b := by
  simp only [Declaration.Le, Declaration.meet, Bool.and_eq_true]
  constructor
  · intro h; exact ⟨fun o ho => (h o ho).1, fun o ho => (h o ho).2⟩
  · rintro ⟨ha, hb⟩ o ho; exact ⟨ha o ho, hb o ho⟩

theorem Declaration.join_lub (a b c : Declaration) :
    (a.join b).Le c ↔ a.Le c ∧ b.Le c := by
  simp only [Declaration.Le, Declaration.join, Bool.or_eq_true]
  constructor
  · intro h; exact ⟨fun o ho => h o (Or.inl ho), fun o ho => h o (Or.inr ho)⟩
  · rintro ⟨ha, hb⟩ o (ho | ho)
    · exact ha o ho
    · exact hb o ho

theorem Declaration.bounds (a : Declaration) :
    Declaration.bottom.Le a ∧ a.Le Declaration.top := by
  simp [Declaration.Le, Declaration.bottom, Declaration.top]

/-- Cost and behavior are incomparable declarations, not adjacent rungs of a chain. -/
theorem Declaration.cost_behavior_independent :
    ¬ Declaration.Le (fun o => decide (o = Observation.costGuarantee))
      (fun o => decide (o = Observation.observableBehavior)) ∧
    ¬ Declaration.Le (fun o => decide (o = Observation.observableBehavior))
      (fun o => decide (o = Observation.costGuarantee)) := by
  constructor
  · intro h; have := h .costGuarantee (by decide); contradiction
  · intro h; have := h .observableBehavior (by decide); contradiction

variable {D : CalculusData} {E V : Type}

/-- A declaration is a promise, not itself a proof that the promise was met. -/
def preserves (b : Boundary D E V) (o : Observation) : Prop := b.declares o = true

def Boundary.Reestablished (b : Boundary D E V) (w w' : World E)
    (c c' : Candidate D) : Prop :=
  ∀ o, preserves b o → b.read w c o = b.read w' c' o

theorem Boundary.failure_iff [DecidableEq V] (b : Boundary D E V)
    (w w' : World E) (c c' : Candidate D) (o : Observation) :
    o ∈ b.failures w w' c c' ↔
      preserves b o ∧ b.read w c o ≠ b.read w' c' o := by
  have ho : o ∈ Observation.all := by cases o <;> simp [Observation.all]
  simp [Boundary.failures, ho, preserves]

/-- Per-observation evidence remains usable even when some OTHER observation failed. -/
theorem Boundary.read_eq_of_not_failed [DecidableEq V] {b : Boundary D E V}
    {w w' : World E} {c c' : Candidate D} {o : Observation}
    (hd : preserves b o) (hn : o ∉ b.failures w w' c c') :
    b.read w c o = b.read w' c' o := by
  by_cases he : b.read w c o = b.read w' c' o
  · exact he
  · exact False.elim (hn ((b.failure_iff w w' c c' o).2 ⟨hd, he⟩))

/-- Exact coverage: an empty obligation list means every declared observation was preserved.
This is checked against the old reference; it cannot be made true by dropping the failed entry. -/
theorem Boundary.failures_nil_iff [DecidableEq V] (b : Boundary D E V)
    (w w' : World E) (c c' : Candidate D) :
    b.failures w w' c c' = [] ↔ b.Reestablished w w' c c' := by
  constructor
  · intro h o ho
    by_cases he : b.read w c o = b.read w' c' o
    · exact he
    · have := (b.failure_iff w w' c c' o).2 ⟨ho, he⟩
      rw [h] at this; cases this
  · intro h
    apply List.eq_nil_iff_forall_not_mem.2
    intro o ho
    obtain ⟨hd, hn⟩ := (b.failure_iff w w' c c' o).1 ho
    exact hn (h o hd)

/-- If a declaration is NOT re-established, a particular observation must travel beyond
the boundary. No disjunction with a vacuously true success arm. -/
theorem Boundary.failed_obligation [DecidableEq V] {b : Boundary D E V}
    {w w' : World E} {c c' : Candidate D} {cl cl' : Closure D E}
    (hsel : cl.selectedCand b.iface.name = some c)
    (hsel' : cl'.selectedCand b.iface.name = some c')
    {o : Observation} (hd : preserves b o)
    (hn : b.read w c o ≠ b.read w' c' o) :
    (b.iface.name, o) ∈ b.obligations w w' cl cl' := by
  simp only [Boundary.obligations, hsel, hsel']
  exact List.mem_map.2 ⟨o, (b.failure_iff w w' c c' o).2 ⟨hd, hn⟩, rfl⟩

/-- Declaring more observations cannot remove an already exposed failure. -/
theorem Boundary.failures_mono [DecidableEq V] (b : Boundary D E V)
    {a a' : Declaration} (hle : a.Le a') (w w' : World E) (c c' : Candidate D) :
    ∀ o ∈ ({ b with declares := a }).failures w w' c c',
      o ∈ ({ b with declares := a' }).failures w w' c c' := by
  intro o ho
  obtain ⟨hd, hn⟩ := (Boundary.failure_iff _ _ _ _ _ _).1 ho
  exact (Boundary.failure_iff _ _ _ _ _ _).2 ⟨hle o hd, hn⟩

/-- Typing reuse is the calculus's meta-substitution lemma on a client template,
not an equality of status labels. The client may inspect the hole only through its declaration. -/
theorem Boundary.reuse_client_typing [DecidableEq V]
#!/usr/bin/env bash
# swarm-build — run a build under an ENFORCED memory cap + CPU pinning + KILLABLE.
# Two RAM-protection layers:
#   * per-build cap  (SWARM_MEM_MAX, default 96G) — bounds a single build.
#   * shared box cap (swarm.slice MemoryMax, set by the drop-in at
#     ~/.config/systemd/user/swarm.slice.d/50-memcap.conf) — bounds the SUM of
#     ALL concurrent swarm-build invocations, because every scope nests under
#     one swarm.slice. Without it, N parallel builds (multi-agent) each get an
#     INDEPENDENT cap and their box-level total is unbounded: that summing is
#     the mechanism behind the box-level RAM runaway (many ~6G builds summing,
#     misread as one process). The shared slice makes total box exposure
#     <= the slice cap no matter how many builds run at once.
# Advisory taskset caps CPU only; the cgroup caps RAM so a runaway compile
# cannot starve the box into unreachability.
#   usage: swarm-build lake build Foo   |   SWARM_MEM_MAX=48G swarm-build Holmake -j 8
set -euo pipefail
if [ -n "${SWARM_BUILD_INNER:-}" ]; then
  # CRITICAL: make the build explicitly KILLABLE. A -1000 inherited from a parent
  # (e.g. an sshd with OOMScoreAdjust set) makes the cgroup cap UNENFORCEABLE —
  # the kernel reports "no killable processes" and wedges the whole box. Learned
  # the hard way 2026-07-15: that exact interaction hard-downed hbox.
  echo 0 > /proc/self/oom_score_adj 2>/dev/null || true
  exec taskset -c 0-15 nice -n 15 "$@"
fi
export SWARM_BUILD_INNER=1
exec systemd-run --user --scope --slice=swarm.slice --quiet \
  -p MemoryMax="${SWARM_MEM_MAX:-96G}" -p MemorySwapMax=0 -p CPUWeight=50 \
  -- "$0" "$@"

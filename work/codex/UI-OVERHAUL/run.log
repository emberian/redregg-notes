/* testground.css — a net OS of the early 2000s: bevelled grey windows, navy title bars, a taskbar. */
:root {
  --desk: #3a6ea5; --face: #d4d0c8; --hi: #ffffff; --lo: #808080; --dk: #404040;
  --title-a: #0a246a; --title-b: #a6caf0; --title-off-a: #808080; --title-off-b: #c0c0c0;
  --text: #000000; --field: #ffffff; --mono: "Lucida Console", "Courier New", monospace;
  --ui: Tahoma, Verdana, "Segoe UI", sans-serif; --ok: #006400; --bad: #a00000; --warn: #8a5a00;
  --link: #0000c0;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --desk: #1d2f45; --face: #3b3b3b; --hi: #5a5a5a; --lo: #1f1f1f; --dk: #0e0e0e;
    --title-a: #1c3d7a; --title-b: #4a6fa8; --title-off-a: #444; --title-off-b: #666;
    --text: #e8e8e8; --field: #1b1b1b; --ok: #6fd36f; --bad: #ff7a7a; --warn: #ffc266; --link: #8ab4ff;
  }
}

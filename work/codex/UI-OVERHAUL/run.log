/* The compositor owns geometry at every viewport size. */
.window { min-width: 0; max-width: none; min-height: 0; }
.window[hidden] { display: none; }
.window.focused { outline: 2px solid var(--title-b); outline-offset: -2px; }
.window .body { min-width: 0; min-height: 0; }
.titlebar { flex: 0 0 auto; min-height: 32px; touch-action: none; }
.titlebar button { width: 28px; height: 28px; flex: 0 0 28px; font-size: 16px; line-height: 1; }
.titlebar:focus-visible { outline: 2px solid #fff; outline-offset: -3px; }
.moving { will-change: transform; }
.resize-handle { position: absolute; touch-action: none; z-index: 1; }
.resize-handle.n, .resize-handle.s { left: 10px; right: 10px; height: 8px; cursor: ns-resize; }
.resize-handle.n { top: -4px; } .resize-handle.s { bottom: -4px; }
.resize-handle.e, .resize-handle.w { top: 10px; bottom: 10px; width: 8px; cursor: ew-resize; }
.resize-handle.e { right: -4px; } .resize-handle.w { left: -4px; }
.resize-handle.ne, .resize-handle.nw, .resize-handle.se, .resize-handle.sw { width: 16px; height: 16px; }
.resize-handle.ne { top: -4px; right: -4px; cursor: nesw-resize; }
.resize-handle.nw { top: -4px; left: -4px; cursor: nwse-resize; }
.resize-handle.se { bottom: -4px; right: -4px; cursor: nwse-resize; }
.resize-handle.sw { bottom: -4px; left: -4px; cursor: nesw-resize; }
#tasks { overflow-x: auto; min-width: 0; }
#tasks button { min-width: 70px; flex-shrink: 0; }
.term .out { flex: 1; min-height: 0; height: auto; }
.term input { min-width: 0; }

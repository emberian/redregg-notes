# GATES-20b plants: the landed copy. Scratch worktree wt/gates9-plant; judge = a copy of wt/gates's
# scripts/ and gates/ (or main's for the old-judge column) with a STUB pre-push (prints the candidate's
# blob of the path, refuses): no judge slot is taken and nothing can land.
set -u
N=/tank/dregg-build/nanodregg
S=$N/wt/gates9-plant
P=${1:?judge dir}
F=launcher/tests/members.rs
OLD=a1ca640 C31=cdc0e9a H39=ea52a4a
cd $S
reset() { git checkout -q -f --detach main; git checkout -q main -- .; git clean -q -f -- launcher/tests; }
lanehunk() { printf '// GATES-9 plant: the lane hunk\n' >> $F; }
LD=""
attempt() { ND_COMMIT_ATTEMPT=1 ND_COMMIT_SCRIPTS=$P/scripts ND_LANDER_DIR=$LD $P/scripts/commit -m 'gates: plant GATES-20b' --no-build plant "$@" $F > $N/logs/gates9-p.out 2>&1; echo "exit=$?"; grep -v '^     ' $N/logs/gates9-p.out | grep -v '^ SIZE.md\|files changed' | head -24 | cut -c1-260; }
newld() { LD=$(mktemp -d $N/logs/gates9-ld.XXXX); }
echo "main=$(git -C $N/main rev-parse --short main): $F $(git show main:$F | wc -l) lines; $OLD: $(git show $OLD:$F | wc -l)"

echo "== P1 reduce (V1): stale copy, HEAD == main: $OLD's copy + one lane line"
reset; git show $OLD:$F > $F; lanehunk; newld; attempt

echo "== P2 reduce (V2): worktree at $OLD, lane line, then git reset main"
git checkout -q -f --detach $OLD; lanehunk; git reset -q main; newld; attempt

echo "== P3 merge from the recorded base: worktree at $OLD (the lane's real base), lane line"
git checkout -q -f --detach $OLD; lanehunk; newld; attempt

echo "== P4 mid-lander rewrite: attempt 1 records (HEAD $OLD); then the working file is overwritten with $OLD's copy and HEAD reset to main; attempt 2 of the same lander"
git checkout -q -f --detach $OLD; lanehunk; newld; attempt > /dev/null
git show $OLD:$F > $F; git reset -q main
echo "  (working file now $(wc -l < $F) lines, HEAD $(git rev-parse --short HEAD))"; attempt

echo "== P5 conflict: worktree at $C31, the line $H39 replaced edited differently"
reset; git checkout -q -f --detach $C31; sed -i 's/"the held supervisor still runs"/"GATES-9 plant: the held supervisor runs on"/' $F; newld; attempt

echo "== P6 clean, unchanged: worktree at main, lane line"
reset; lanehunk; newld; attempt

echo "== P7 a deliberate revert of $H39's hunk (worktree at main, $F = $C31's copy), not named"
reset; git show $C31:$F > $F; newld; attempt
echo "== P7b named --reverts $H39, no CROSS-LAYER naming HOSTING"
newld; attempt --reverts $H39
echo "== P7c named, CROSS-LAYER names HOSTING"
newld; attempt --reverts $H39 --cross-layer "plant: HOSTING-13 agreed"
echo "== P8 --reverts naming a commit the candidate does not revert (worktree at main, lane line)"
reset; lanehunk; newld; attempt --reverts $C31 --cross-layer "plant: CLIENT"
reset


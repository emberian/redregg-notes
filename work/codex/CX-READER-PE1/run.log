    a.out.mkdir(parents=True,exist_ok=False)
    source=(HERE/"Lang/Contextual/Journal.lean").read_text()
    changes={
        "revision": ("decide (r.revision = rev)", "true"),
        "successful": ("decide (r.result = .checked)", "true"),
        "complete": ("&& r.complete", "&& true"),
        "inputs": ("r.inputs.all fun p => decide (w p.1 = some p.2)", "true"),
    }
    receipts=[]
    teeth=HERE/"Lang/Proofs/Contextual/JournalTeeth.lean"
    control=lean(teeth,a.out/"control.log",[HERE/".lake/build/lib/lean"])

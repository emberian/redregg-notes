"""Coverage plants derived from an actual Lean export. All malformed payloads stay in scratch."""
import argparse
import importlib.util
import json
from pathlib import Path
from journal import Export, Incomplete, ROOTS, canonical, append_event, file_hash, inspect_journal
from journal_pilot import HERE, write, lean

def mutant_class(folder, source):
    path=folder/"mutant.py";write(path,source)
    spec=importlib.util.spec_from_file_location("pe1_mutant",path)
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module.Export

def missing_import(folder, source, export_path):
    folder.mkdir()
    run=folder/"Missing.lean";output=folder/"absent.json"
    write(run,'import Census.Journal\nimport Kernel.Proofs.JournalMissingImport\n'+
          f'#journal_export "{output}" '+" ".join(ROOTS)+"\n")
    process=lean(run,folder/"lean.log",[HERE/".lake/build/lib/lean"])
    assert process["exit"] and not output.exists()
    try:Export(output)
    except Incomplete as e:diagnostic=str(e)
    else:raise AssertionError("missing-import environment authorized")
    write(folder/"adapter.log",diagnostic+"\n")
    history=folder/"events.jsonl"
    append_event(history,dict(kind="seed",obligations=ROOTS,export=str(export_path)))
    append_event(history,dict(kind="incomplete",owed=ROOTS,process=process,diagnostic=diagnostic))
    enabled=inspect_journal(history)
    assert enabled["persistent_obligations"]==ROOTS and enabled["incomplete"][-1]["owed"]==ROOTS
    # Disable only the missing-file refusal in a scratch copy of the real validator.
    # Reuse the actual absent output from the failed Lean import, never a fabricated diagnostic.
    old='            raise Incomplete(f"INCOMPLETE COVERAGE: {exc}") from exc'
    new=('            if isinstance(exc, FileNotFoundError):\n'
         '                self.decls = {}\n'
         '                self.versions = {}\n'
         '                return\n'+old)
    assert source.count(old)==1
    cls=mutant_class(folder,source.replace(old,new,1))
    accepted=cls(output)
    disabled=dict(complete=True,obligations=sorted(n for n in accepted.decls if n in ROOTS))
    write(folder/"disabled.json",canonical(disabled)+"\n")
    try:
        assert disabled["complete"] is False and disabled["obligations"]==ROOTS, (
            f'missing-import coverage lied: complete={disabled["complete"]}, '
            f'obligations={len(disabled["obligations"])}, expected INCOMPLETE with {len(ROOTS)} owed')
    except AssertionError as exc:
        failure=str(exc)
    else:raise AssertionError("missing-import disabling tooth did not turn red")
    write(folder/"disabled.log","PLANT RED: "+failure+"\n")
    receipt=dict(check="missing-import",process=process,expected_log=str(folder/"adapter.log"),
                 expected_line=1,actual_diagnostic=diagnostic,disabled_log=str(folder/"disabled.log"),
                 obligation_inventory=enabled["persistent_obligations"],
                 disabled_complete=disabled["complete"],disabled_obligations=disabled["obligations"])
    print("MISSING IMPORT",diagnostic,"owed",len(ROOTS),flush=True)
    print("PLANT RED:",failure,flush=True)
    return receipt

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--export",type=Path,required=True)
    ap.add_argument("--out",type=Path,required=True)
    ap.add_argument("--cases",nargs="*")
    a=ap.parse_args();a.out.mkdir(parents=True,exist_ok=False)
    source=(HERE/"gates/journal.py").read_text()
    original=json.loads(a.export.read_text())
    good=Export(a.export)
    print("CONTROL COMPLETE",len(good.decls),len(ROOTS),flush=True)
    del good
    plans=[
      ("complete", 'if self.raw["schema"] != 1 or self.raw["complete"] is not True:', 'if False:'),
      ("roots", 'if self.raw["roots"] != roots:', 'if False:'),
      ("dependency", 'if any(x not in self.decls for x in d[key]):', 'if False:'),
      ("edge", 'if set(d["valueDeps"]) != self.expression_dependencies(d["value"]):', 'if False:'),
      ("saved", 'if saved != expected or len(saved) != len(self.raw["saved"]):', 'if False:'),
      ("cycle", 'raise Incomplete("cyclic expression graph")', 'return digest("disabled-cycle-check")'),
      ("artifact", 'if any(artifact[k] != declaration[k] for k in ("type", "value", "levels")):', 'if False:'),
      ("recursor", 'if not self.expression_dependencies(rule["rhs"]) <= set(d["shapeDeps"]):', 'if False:'),
    ]
    receipts=[]
    for name,old,new in plans:
        if a.cases is not None and name not in a.cases:continue
        folder=a.out/name;folder.mkdir()
        data=json.loads(a.export.read_text())
        if name=="complete":data["complete"]=False
        if name=="roots":data["roots"].pop()
        if name=="dependency":
            victim=next(d["name"] for d in data["declarations"] if d["kind"]=="definition")
            data["declarations"]=[d for d in data["declarations"] if d["name"]!=victim]
        if name=="edge":
            victim=next(d for d in data["declarations"] if d["name"]==ROOTS[4])
            assert victim["valueDeps"];victim["valueDeps"].pop()
        if name=="saved":data["saved"].pop()
        if name=="cycle":data["nodes"].append({"metadata":{"value":len(data["nodes"])}})
        if name=="artifact":data["saved"][0]["value"]=data["saved"][1]["value"]
        if name=="recursor":
            victim=next(d for d in data["declarations"] if isinstance(d["shape"],dict)
                        and d["shape"].get("rules") and d["shapeDeps"])
            victim["shapeDeps"]=[]
        path=folder/"input.json";write(path,canonical(data));del data
        try:
            Export(path)
        except Incomplete as e:
            diagnostic=str(e)
        else:
            raise AssertionError("malformed export accepted: "+name)
        write(folder/"enabled.log",diagnostic+"\n")
        print(name,diagnostic,flush=True)
        assert old in source
        cls=mutant_class(folder,source.replace(old,new,1))
        cls(path)
        write(folder/"disabled.log","PLANT RED: disabled "+name+" check accepted the real mutated export\n")
        receipt=dict(check=name,input=str(path),input_hash=file_hash(path),
                     expected_log=str(folder/"enabled.log"),expected_line=1,
                     actual_diagnostic=diagnostic,disabled_log=str(folder/"disabled.log"),
                     obligation_inventory=ROOTS)
        receipts.append(receipt)
        print(canonical(receipt),flush=True)
    if a.cases is None or "missing-import" in a.cases:
        receipts.append(missing_import(a.out/"missing-import",source,a.export))
    write(a.out/"receipts.json",canonical(receipts)+"\n")
    if a.cases is not None:
        print("SCOPED COVERAGE PLANTS GREEN",flush=True)
        return
    print("COVERAGE PLANTS GREEN",flush=True)

if __name__=="__main__":main()

/-! ## Selective repair over fragments (doc 2 section 9, family 3) -/

/-- A checked fragment: a name, the keys its check declares it reads (its support), the check. -/
structure Frag (Name Key V : Type) where
  name : Name
  support : List Key
  check : (Key → V) → Bool

/-- Is the fragment affected by a change of `changed`? -/
def Frag.affected {Name Key V : Type} [DecidableEq Key] (f : Frag Name Key V)
    (changed : List Key) : Bool :=
  f.support.any fun k => decide (k ∈ changed)

/-- Check everything again. -/
def fromScratch {Name Key V : Type} (fs : List (Frag Name Key V)) (w : Key → V) : List Bool :=
  fs.map fun f => f.check w

/-- Selective repair: re-check the affected fragments, reuse every other cached verdict. -/
def repair {Name Key V : Type} [DecidableEq Key] :
    List (Frag Name Key V) → List Bool → List Key → (Key → V) → List Bool
  | [], _, _, _ => []
  | f :: fs, [], ch, w => f.check w :: repair fs [] ch w
  | f :: fs, c :: cs, ch, w => (if f.affected ch then f.check w else c) :: repair fs cs ch w

/-- The names of the fragments that do not check. Each name stands for one residual obligation
(re-establish that fragment); the list is `Φ′` only in that sense. -/
def residual {Name Key V : Type} : List (Frag Name Key V) → List Bool → List Name
  | [], _ => []
  | f :: fs, [] => f.name :: residual fs []
  | f :: fs, b :: bs => (if b then [] else [f.name]) ++ residual fs bs

/-- One effect's admission as a checked fragment over the store of keys. -/
def admitFrag {Ix : Type} {S : Sig Ix} {Name Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob)
    {changed : List Key} (h : f.affected changed = false) : ∀ k ∈ f.support, k ∉ changed := by
  intro k hk hc
  have : f.affected changed = true := List.any_eq_true.mpr ⟨k, hk, by simp [hc]⟩
  rw [h] at this
  cases this

/-- **Locality** (family 3): a change outside a fragment's support leaves its verdict. -/
theorem locality {Name Key V : Type} [DecidableEq Key] {f : Frag Name Key V} (hf : f.ReadsOnly)
    {changed : List Key} {w₁ w₂ : Key → V} (hout : ∀ k, k ∉ changed → w₁ k = w₂ k)
    (hna : f.affected changed = false) : f.check w₁ = f.check w₂ :=
  hf w₁ w₂ fun k hk => hout k (Frag.unaffected hna k hk)

/-- **Selective repair agrees with checking from scratch** (family 3): from correct verdicts for
`w₁`, re-checking only the fragments a change of `changed` affects gives exactly the verdicts a
full re-check of `w₂` gives. -/
theorem repair_agrees_from_scratch {Name Key V : Type} [DecidableEq Key]
    (fs : List (Frag Name Key V)) (hfs : ∀ f ∈ fs, f.ReadsOnly) {changed : List Key}
    {w₁ w₂ : Key → V} (hout : ∀ k, k ∉ changed → w₁ k = w₂ k) :
    repair fs (fromScratch fs w₁) changed w₂ = fromScratch fs w₂ := by
  induction fs with
  | nil => rfl
  | cons f fs ih =>
    simp only [fromScratch, List.map_cons, repair]
    have ih' := ih (fun g hg => hfs g (by simp [hg]))
    simp only [fromScratch] at ih'
    rw [ih']
    congr 1
    cases ha : f.affected changed with
    | true => rfl
    | false => exact locality (hfs f (by simp)) hout ha

/-- The explicit residual obligations of a repair are those of a full re-check. -/
theorem repair_residual {Name Key V : Type} [DecidableEq Key]
    (fs : List (Frag Name Key V)) (hfs : ∀ f ∈ fs, f.ReadsOnly) {changed : List Key}
    {w₁ w₂ : Key → V} (hout : ∀ k, k ∉ changed → w₁ k = w₂ k) :
    residual fs (repair fs (fromScratch fs w₁) changed w₂) = residual fs (fromScratch fs w₂) := by
  rw [repair_agrees_from_scratch fs hfs hout]

variable {D : CalculusData}

/-! ## Judgment -/

/-- The supports a candidate relies on: declared, plus the token of every hypothesis it uses. -/
def effSupports (I : Iface D E) (c : Candidate D) : List Token :=
  c.supports ++ (I.hyps.filter fun h => D.uses c.filling h.1).map Prod.snd

/-- Everything a candidate's status reads from the token world. -/
def deps (I : Iface D E) (c : Candidate D) : List Token := effSupports I c ++ c.blockers

/-- THE judgment of a candidate at a world. -/
def judge (I : Iface D E) (w : World E) (c : Candidate D) : Status :=
  if D.check I.ctx c.filling I.ty = false then .conflict .illTyped
  else if I.guard w.env c.filling = false then .conflict .guardFails
  else if (c.blockers.filter w.live).isEmpty = false then .pruned (c.blockers.filter w.live)
  else if ((effSupports I c).filter fun t => !w.live t).isEmpty = false then
    .suspended ((effSupports I c).filter fun t => !w.live t)
  else if c.cost ≤ I.budget then .verified else .uncovered c.cost I.budget

/-- The provenance polynomial of a hole at a world: one monomial (a product of tokens) per candidate
that passes everything but its supports; the hole is justified iff some monomial is all live. -/
def provenance (I : Iface D E) (env : E) (cs : List (Candidate D)) :
    List (List Token × List Token) :=
  (cs.filter fun c => D.check I.ctx c.filling I.ty && I.guard env c.filling &&
      decide (c.cost ≤ I.budget)).map fun c => (effSupports I c, c.blockers)

theorem missing_empty_iff {w : World E} {ts : List Token} :
    (ts.filter fun t => !w.live t).isEmpty = true ↔ ∀ t ∈ ts, w.live t = true := by
  rw [List.isEmpty_iff, List.filter_eq_nil_iff]; simp

theorem judge_verified_iff {I : Iface D E} {w : World E} {c : Candidate D} :
    judge I w c = .verified ↔
      D.check I.ctx c.filling I.ty = true ∧ I.guard w.env c.filling = true ∧
      (∀ b ∈ c.blockers, w.live b = false) ∧ (∀ t ∈ effSupports I c, w.live t = true) ∧
      c.cost ≤ I.budget := by
  rw [← blockers_empty_iff, ← missing_empty_iff]
  unfold judge
  cases h1 : D.check I.ctx c.filling I.ty <;>
  cases h2 : I.guard w.env c.filling <;>
  cases h3 : (c.blockers.filter w.live).isEmpty <;>
  cases h4 : ((effSupports I c).filter fun t => !w.live t).isEmpty <;>
  by_cases h5 : c.cost ≤ I.budget <;> simp [h5]

/-- `conflict` is decided by the checker and the guard alone: it reads no token. Its `illTyped`
arm is a refutation of typing (`conflict_illTyped_refutes`, by `check_complete`), its `guardFails`
arm a checked guard failure in the current environment. -/
theorem judge_conflict_iff {I : Iface D E} {w : World E} {c : Candidate D} {ev : Evidence} :
    judge I w c = .conflict ev ↔
      (D.check I.ctx c.filling I.ty = false ∧ ev = .illTyped) ∨
      (D.check I.ctx c.filling I.ty = true ∧ I.guard w.env c.filling = false ∧ ev = .guardFails) := by
  unfold judge
  cases h1 : D.check I.ctx c.filling I.ty <;>
  cases h2 : I.guard w.env c.filling <;>
  cases h3 : (c.blockers.filter w.live).isEmpty <;>
  cases h4 : ((effSupports I c).filter fun t => !w.live t).isEmpty <;>
  by_cases h5 : c.cost ≤ I.budget <;> cases ev <;> simp [h5]


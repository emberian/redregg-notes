import Lang.Contextual.Closure
import Lang.Contextual.Protocol

/- Receipt-first adapter: finite data, never an invocation of Lean in CalculusData.check.
The revision names target, telescope, definition closure, deployment claim and toolchain.
Input values are immutable version identities, not declaration names alone. -/
namespace Nanodregg.Lang.Contextual.Journal

structure Revision where
  claim : String
  target : String
  context : String
  definitions : String
  instanceId : String
  toolchain : String
deriving DecidableEq, Repr

inductive CheckResult where
  | checked
  | rejected
  | exhausted
  | incomplete
deriving DecidableEq, Repr

structure Receipt where
  revision : Revision
  artifact : String
  recipe : String
  inputs : List (String × String)
  result : CheckResult
  complete : Bool
deriving DecidableEq, Repr

abbrev Store := String → Option String

def inputsMatch (r : Receipt) (w : Store) : Bool :=
  r.inputs.all fun p => decide (w p.1 = some p.2)

def receiptCheck (r : Receipt) (rev : Revision) : Bool :=
  decide (r.revision = rev) && decide (r.result = .checked) && r.complete

def calculus : CalculusData where
  Ty := Revision
  Ctx := Unit
  Tm := Receipt
  tmEq := inferInstance
  msubst := fun _ r => r
  check := fun _ r rev => receiptCheck r rev
  uses := fun _ _ => false
  drop := fun _ _ => ()
  strengthen := fun _ r => r
  weaken := fun _ r => r
  var := fun _ => ⟨⟨"", "", "", "", "", ""⟩, "", "", [], .incomplete, false⟩
  lookup := fun _ _ => none

def iface (name : Nat) (rev : Revision) (budget : Nat) : Iface calculus Store where
  name := name
  ctx := ()
  ty := rev
  hyps := []
  hyps_real := by simp
  guard := fun w r => inputsMatch r w
  budget := budget
  chooser := 0
  acceptor := 0

/-- Tokens include check availability, audit coverage and cost evidence. A missing successful
receipt is a missing support, not a claim that Lean's proposition is false. -/
def candidate (r : Receipt) (supports blockers : List Token) (cost : Nat) : Candidate calculus :=
  ⟨r, supports, blockers, cost, 0, .suspended supports⟩

def fragment (id : String) (rev : Revision) (r : Receipt) : Protocol.Frag String String (Option String) :=
  ⟨id, r.inputs.map Prod.fst, fun w => receiptCheck r rev && inputsMatch r w⟩

structure Entry where
  id : String
  revision : Revision
  candidates : List Receipt
deriving DecidableEq, Repr

inductive Event where
  | seeded (entry : Entry)
  | checked (id : String) (receipt : Receipt)
  | withdrawn (key version : String)
  | revised (before after : Revision)
deriving DecidableEq, Repr

/-- The immutable journal is the recovery source; indexes are derived views. -/
structure Log where
  events : List Event
deriving DecidableEq, Repr

def Log.append (log : Log) (ev : Event) : Log := ⟨log.events ++ [ev]⟩

/-- The list reference is intentionally retained as the inverted index oracle. -/
def affected (fs : List (Protocol.Frag String String (Option String))) (keys : List String) : List String :=
  (fs.filter fun f => f.affected keys).map (·.name)

end Nanodregg.Lang.Contextual.Journal
import Lang.Contextual.Journal
import Lang.Proofs.Contextual.Judge
import Lang.Proofs.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.Journal

theorem matches_iff (r : Receipt) (w : Store) :
    inputsMatch r w = true ↔ ∀ p ∈ r.inputs, w p.1 = some p.2 := by
  simp [inputsMatch, List.all_eq_true]

theorem receiptCheck_iff (r : Receipt) (rev : Revision) :
    receiptCheck r rev = true ↔
      r.revision = rev ∧ r.result = .checked ∧ r.complete = true := by
  simp [receiptCheck, Bool.and_eq_true, and_assoc]

/-- Admission is authority for this exact revision only, with successful, complete receipt
data whose declared inputs match. Authentic production of that data stays with Lean/judge. -/
theorem admitted_receipt (r : Receipt) (rev : Revision) (w : World Store)
    (supports blockers : List Token) (cost budget name : Nat)
    (h : judge (iface name rev budget) w (candidate r supports blockers cost) = .verified) :
    r.revision = rev ∧ r.result = .checked ∧ r.complete = true ∧
      (∀ p ∈ r.inputs, w.env p.1 = some p.2) ∧
      (∀ t ∈ supports, w.live t = true) ∧
      (∀ t ∈ blockers, w.live t = false) ∧ cost ≤ budget := by
  obtain ⟨hc, hg, hb, hs, hcost⟩ := judge_verified_iff.mp h
  have hr := (receiptCheck_iff r rev).mp hc
  exact ⟨hr.1, hr.2.1, hr.2.2, (matches_iff r w.env).mp hg,
    by simpa [effSupports, iface, candidate] using hs, hb, hcost⟩

/-- No unverifiable resource failure is interpreted as a checked proposition. -/
theorem exhausted_unavailable (r : Receipt) (rev : Revision)
    (h : r.result = .exhausted) : receiptCheck r rev = false := by
  simp [receiptCheck, h]

/-- A missing export/audit cannot authorize a receipt, even if its proof happened to check. -/
theorem incomplete_unavailable (r : Receipt) (rev : Revision)
    (h : r.complete = false) : receiptCheck r rev = false := by
  simp [receiptCheck, h]

/-- The fragment reads its finite declared list by construction; projection and hidden
dependencies must first be represented in that list by the exporter. -/
theorem fragment_readsOnly (id : String) (rev : Revision) (r : Receipt) :
    (fragment id rev r).ReadsOnly := by
  intro w w' h
  have hm : inputsMatch r w = inputsMatch r w' := by
    apply Bool.eq_iff_iff.mpr
    rw [matches_iff, matches_iff]
    have he : ∀ p ∈ r.inputs, w p.1 = w' p.1 := by
      intro p hp
      exact h p.1 (List.mem_map_of_mem (f := Prod.fst) hp)
    constructor
    · intro ha p hp
      rw [← he p hp]
      exact ha p hp
    · intro ha p hp
      rw [he p hp]
      exact ha p hp
  simp only [fragment, hm]

/-- Outside-change agreement is explicit, not inferred from absence in a truncated export.
Candidate identity is fixed by fs; this is Protocol's proved repair applied to real receipts. -/
theorem repair_receipts
    (rs : List (String × Revision × Receipt)) (changed : List String)
    (w w' : Store) (hout : ∀ k, k ∉ changed → w k = w' k) :
    Protocol.repair (rs.map fun x => fragment x.1 x.2.1 x.2.2)
      (Protocol.fromScratch (rs.map fun x => fragment x.1 x.2.1 x.2.2) w) changed w' =
    Protocol.fromScratch (rs.map fun x => fragment x.1 x.2.1 x.2.2) w' := by
  apply Protocol.repair_agrees_from_scratch
  · intro f hf
    obtain ⟨x, _, rfl⟩ := List.mem_map.mp hf
    exact fragment_readsOnly _ _ _
  · exact hout

/-- Sequential repair and batch checking have the same verdicts and residual obligations.
No equality of selected proofs, acceptance history or newly discovered candidates is claimed. -/
theorem repair_composes
    (rs : List (String × Revision × Receipt)) (ch₁ ch₂ : List String)
    (w₀ w₁ w₂ : Store)
    (h₁ : ∀ k, k ∉ ch₁ → w₀ k = w₁ k)
    (h₂ : ∀ k, k ∉ ch₂ → w₁ k = w₂ k) :
    let fs := rs.map fun x => fragment x.1 x.2.1 x.2.2
    let seq := Protocol.repair fs (Protocol.repair fs (Protocol.fromScratch fs w₀) ch₁ w₁) ch₂ w₂
    seq = Protocol.fromScratch fs w₂ ∧
      Protocol.residual fs seq = Protocol.residual fs (Protocol.fromScratch fs w₂) := by
  dsimp
  rw [repair_receipts rs ch₁ w₀ w₁ h₁, repair_receipts rs ch₂ w₁ w₂ h₂]
  exact ⟨rfl, rfl⟩

/-- An immutable old revision never gains authority from a differently named successor. -/
theorem revision_mismatch (r : Receipt) (rev : Revision) (h : r.revision ≠ rev) :
    receiptCheck r rev = false := by
  simp [receiptCheck, h]

/-- Journal append preserves every prior event, including withdrawn/pruned alternatives. -/
theorem append_history (log : Log) (ev old : Event) (h : old ∈ log.events) :
    old ∈ (log.append ev).events := by
  simp [Log.append, h]


/-- A batch of the same edits also agrees with sequential repair, including residuals.
The union proof discharges the batch's outside-change premise from the two step premises. -/
theorem repair_batch
    (rs : List (String × Revision × Receipt)) (ch₁ ch₂ : List String)
    (w₀ w₁ w₂ : Store)
    (h₁ : ∀ k, k ∉ ch₁ → w₀ k = w₁ k)
    (h₂ : ∀ k, k ∉ ch₂ → w₁ k = w₂ k) :
    let fs := rs.map fun x => fragment x.1 x.2.1 x.2.2
    Protocol.repair fs (Protocol.repair fs (Protocol.fromScratch fs w₀) ch₁ w₁) ch₂ w₂ =
      Protocol.repair fs (Protocol.fromScratch fs w₀) (ch₁ ++ ch₂) w₂ := by
  have hout : ∀ k, k ∉ ch₁ ++ ch₂ → w₀ k = w₂ k := by
    intro k hk
    simp only [List.mem_append, not_or] at hk
    exact (h₁ k hk.1).trans (h₂ k hk.2)
  dsimp
  rw [repair_receipts rs ch₁ w₀ w₁ h₁, repair_receipts rs ch₂ w₁ w₂ h₂,
      repair_receipts rs (ch₁ ++ ch₂) w₀ w₂ hout]

end Nanodregg.Lang.Contextual.Journal

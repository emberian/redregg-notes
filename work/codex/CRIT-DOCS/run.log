/-
# Lang.Wire — types and terms as CODEC's one recursive codec (`Codec.Tree`, CODEC-9)

A type or a term is a `Codec.Tree`: one node per constructor, its tag byte, its scalar field as a
payload written with CODEC's ordinary codecs (an index as `u32`, a natural as `u64be` as Lang data's
is (LANG-59), a boolean as `bool`, a primitive's code as `u8`, a label or a byte literal as its raw
bytes), and its subterms as children. A row entry `(ℓ, x)` is a FIELD node: the label as payload,
`x` as its one child. The byte-level reading, the depth bound and the size bounds are
`Stream.tree`'s, proved once (`Codec.Stream.tree_lawful`); this module only maps constructors to nodes and back.

`tyOf`/`termOf` accept exactly the trees `tyTree`/`termTree` write for a REPRESENTABLE type or term
(`tyWire`, `termWire`: every label UTF-8 of at most `labelBytesMax` bytes, every row at most
`rowMax` entries, every index below `2^32`, every literal natural below `2^64`). Everything else is
refused (`none`), so one value has one tree and one tree has one value (`Lang.Proofs.Wire`).

Tags (a type's and a term's tag spaces are read at different positions, so they may overlap):

    type  nat 0 · bool 1 · bytes 2 · fn 3 [a c] · record 4 [field*] · sum 5 [field*] · field 6 ℓ [T]
          digest 7
    term  var 0 i · lam 1 [T b] · app 2 [f a] · fix 3 [t] · nat 4 n · bool 5 v · bytes 6 s
          prim 7 code [a b] · record 8 [field*] · get 9 ℓ [t] · extend 10 [t field*] · inj 11 ℓ [T t]
          case 12 [t field*] · ite 13 [c t e] · ref 14 i · field 15 ℓ [t] · digest 16 s
          refuse 17 why [T] · hole 18 i [substitution*]
    prim codes add 0 · sub 1 · mul 2 · div 3 · mod 4 · eq 5 · lt 6 · le 7 · beq 8 · cat 9 · deq 10
          lenLe 11 · u64be 12 · sized 13 · dsized 14
-/
import Codec.Tree
import Lang.Term
import Lang.Bounds

namespace Nanodregg.Lang.Wire

open Nanodregg.Codec

/-- The deepest tree a reader accepts (a package's own node included). -/
def depthMax : Nat := 1024
/-- A label is at most 64 bytes of UTF-8. -/
def labelBytesMax : Nat := 64
/-- At most 256 fields, arms or row entries per node. -/
def rowMax : Nat := 256
/-- The tree's payload and child-list bound: a byte literal fills one kernel slot. -/
def nodeMax : Nat := Bounds.bytesMax

/-! ## Leaves -/

/-- A label is one atom of the text (`labelAtom`) of at most `labelBytesMax` bytes of UTF-8: the one
label rule of the wire, the reader and the printer. -/
def labelOk (ℓ : Label) : Bool := labelAtom ℓ && decide (ℓ.toUTF8.size ≤ labelBytesMax)

def labelOf (p : ByteArray) : Option Label :=
  if p.size ≤ labelBytesMax then
    match String.fromUTF8? p with
    | some ℓ => if labelAtom ℓ then some ℓ else none
    | none => none
  else none

def u32Of (p : ByteArray) : Option Nat :=
  match Stream.u32.decode p with
  | .ok v => some v.toNat
  | .error _ => none

def u64Of (p : ByteArray) : Option Nat :=
  match Stream.u64be.decode p with
  | .ok v => some v.toNat
  | .error _ => none

def boolOf (p : ByteArray) : Option Bool :=
  match Stream.bool.decode p with
  | .ok v => some v
  | .error _ => none

def u32Bytes (n : Nat) : ByteArray := Stream.u32.bytes (UInt32.ofNat n)
def u64Bytes (n : Nat) : ByteArray := Stream.u64be.bytes (UInt64.ofNat n)

def primCode : Prim → UInt8
  | .add => 0 | .sub => 1 | .mul => 2 | .div => 3 | .mod => 4
  | .eq => 5 | .lt => 6 | .le => 7 | .beq => 8 | .cat => 9 | .deq => 10 | .lenLe => 11
  | .u64be => 12 | .sized => 13 | .dsized => 14

def primOf : UInt8 → Option Prim
  | 0 => some .add | 1 => some .sub | 2 => some .mul | 3 => some .div | 4 => some .mod
  | 5 => some .eq | 6 => some .lt | 7 => some .le | 8 => some .beq | 9 => some .cat
  | 10 => some .deq | 11 => some .lenLe | 12 => some .u64be | 13 => some .sized | 14 => some .dsized
  | _ => none

def primOfBytes (p : ByteArray) : Option Prim :=
  match Stream.u8.decode p with
  | .ok c => primOf c
  | .error _ => none

/-! ## Types -/

mutual
def tyTree : Ty → Tree
  | .nat => .node 0 .empty []
  | .bool => .node 1 .empty []
  | .bytes => .node 2 .empty []
  | .digest => .node 7 .empty []
  | .fn a c => .node 3 .empty [tyTree a, tyTree c]
  | .record r => .node 4 .empty (tyRowTree r)
  | .sum r => .node 5 .empty (tyRowTree r)

def tyRowTree : List (Label × Ty) → List Tree
  | [] => []
  | (ℓ, t) :: r => .node 6 ℓ.toUTF8 [tyTree t] :: tyRowTree r
end

mutual
/-- The type a tree writes, if it writes one. -/
def tyOf : Tree → Option Ty
  | .node 0 p [] => if p = .empty then some .nat else none
  | .node 1 p [] => if p = .empty then some .bool else none
  | .node 2 p [] => if p = .empty then some .bytes else none
  | .node 7 p [] => if p = .empty then some .digest else none
  | .node 3 p [a, c] =>
    if p = .empty then
      match tyOf a, tyOf c with
      | some a, some c => some (.fn a c)
      | _, _ => none
    else none
  | .node 4 p cs =>
    if p = .empty ∧ cs.length ≤ rowMax then (tyRowOf cs).map .record else none
  | .node 5 p cs =>
    if p = .empty ∧ cs.length ≤ rowMax then (tyRowOf cs).map .sum else none
  | _ => none

def tyRowOf : List Tree → Option (List (Label × Ty))
  | [] => some []
  | .node 6 p [c] :: cs =>
    match labelOf p, tyOf c, tyRowOf cs with
    | some ℓ, some t, some r => some ((ℓ, t) :: r)
    | _, _, _ => none
  | _ => none
end

mutual
/-- The type has a tree that reads back to it: labels and rows in bounds. -/
def tyWire : Ty → Bool
  | .nat | .bool | .bytes | .digest => true
  | .fn a c => tyWire a && tyWire c
  | .record r => decide (r.length ≤ rowMax) && tyRowWire r
  | .sum r => decide (r.length ≤ rowMax) && tyRowWire r

def tyRowWire : List (Label × Ty) → Bool
  | [] => true
  | (ℓ, t) :: r => labelOk ℓ && tyWire t && tyRowWire r
end

/-- A canonical type the wire can carry: its data codec (`Lang.Wire.Data`) exists and is canonical.
Read here, beside `tyWire`, by the install check of a call slot's argument type (`Lang.callSlotOk`)
and by the codec (`encodeData`/`decodeData`): one predicate (law 1). -/
def dataTy (T : Ty) : Bool := T.wf && tyWire T

/-! ## Terms -/

mutual
def termTree : Term → Tree
  | .var i => .node 0 (u32Bytes i) []
  | .lam a b => .node 1 .empty [tyTree a, termTree b]
  | .app f a => .node 2 .empty [termTree f, termTree a]
  | .fix t => .node 3 .empty [termTree t]
  | .nat n => .node 4 (u64Bytes n) []
  | .bool v => .node 5 (Stream.bool.bytes v) []
  | .bytes s => .node 6 s []
  | .digest s => .node 16 s []
  | .prim op a b => .node 7 (Stream.u8.bytes (primCode op)) [termTree a, termTree b]
  | .record fs => .node 8 .empty (fieldsTree fs)
  | .get t ℓ => .node 9 ℓ.toUTF8 [termTree t]
  | .extend t fs => .node 10 .empty (termTree t :: fieldsTree fs)
  | .inj a ℓ t => .node 11 ℓ.toUTF8 [tyTree a, termTree t]
  | .case t arms => .node 12 .empty (termTree t :: fieldsTree arms)
  | .ite c t e => .node 13 .empty [termTree c, termTree t, termTree e]
  | .ref i => .node 14 (u32Bytes i) []
  | .refuse T w => .node 17 w [tyTree T]
  | .hole n σ => .node 18 (u32Bytes n) (termsTree σ)

def termsTree : List Term → List Tree
  | [] => []
  | t :: ts => termTree t :: termsTree ts

def fieldsTree : List (Label × Term) → List Tree
  | [] => []
  | (ℓ, t) :: fs => .node 15 ℓ.toUTF8 [termTree t] :: fieldsTree fs
end

mutual
/-- The term a tree writes, if it writes one. -/
def termOf : Tree → Option Term
  | .node 0 p [] => (u32Of p).map .var
  | .node 1 p [a, b] =>
    if p = .empty then
      match tyOf a, termOf b with
      | some a, some b => some (.lam a b)
      | _, _ => none
    else none
  | .node 2 p [f, a] =>
    if p = .empty then
      match termOf f, termOf a with
      | some f, some a => some (.app f a)
      | _, _ => none
    else none
  | .node 3 p [t] => if p = .empty then (termOf t).map .fix else none
  | .node 4 p [] => (u64Of p).map .nat
  | .node 5 p [] => (boolOf p).map .bool
  | .node 6 p [] => some (.bytes p)
  | .node 16 p [] => some (.digest p)
  | .node 7 p [a, b] =>
    match primOfBytes p, termOf a, termOf b with
    | some op, some a, some b => some (.prim op a b)
    | _, _, _ => none
  | .node 8 p fs =>
    if p = .empty ∧ fs.length ≤ rowMax then (fieldsOf fs).map .record else none
  | .node 9 p [t] =>
    match labelOf p, termOf t with
    | some ℓ, some t => some (.get t ℓ)
    | _, _ => none
  | .node 10 p (t :: fs) =>
    if p = .empty ∧ fs.length ≤ rowMax then
      match termOf t, fieldsOf fs with
      | some t, some fs => some (.extend t fs)
      | _, _ => none
    else none
  | .node 11 p [a, t] =>
    match labelOf p, tyOf a, termOf t with
    | some ℓ, some a, some t => some (.inj a ℓ t)
    | _, _, _ => none
  | .node 12 p (t :: arms) =>
    if p = .empty ∧ arms.length ≤ rowMax then
      match termOf t, fieldsOf arms with
      | some t, some arms => some (.case t arms)
      | _, _ => none
    else none
  | .node 13 p [c, t, e] =>
    if p = .empty then
      match termOf c, termOf t, termOf e with
      | some c, some t, some e => some (.ite c t e)
      | _, _, _ => none
    else none
  | .node 14 p [] => (u32Of p).map .ref
  | .node 17 p [a] => (tyOf a).map (.refuse · p)
  | .node 18 p ts =>
    if ts.length ≤ rowMax then
      match u32Of p, termsOf ts with
      | some n, some σ => some (.hole n σ)
      | _, _ => none
    else none
  | _ => none

def termsOf : List Tree → Option (List Term)
  | [] => some []
  | t :: ts =>
    match termOf t, termsOf ts with
    | some t, some ts => some (t :: ts)
    | _, _ => none

def fieldsOf : List Tree → Option (List (Label × Term))
  | [] => some []
  | .node 15 p [t] :: fs =>
    match labelOf p, termOf t, fieldsOf fs with
    | some ℓ, some t, some fs => some ((ℓ, t) :: fs)
    | _, _, _ => none
  | _ => none
end

mutual
/-
# Lang.Wire.Data — data at a type, as a CODEC stream built from the type

Data is written TYPE-DIRECTED and needs no recursive codec: the reader knows the type, and the type
is finite, so `dataStream T` is a composition of CODEC's ordinary combinators by recursion on `T`.
A natural is `u64be` (big-endian, so a relation key's bytes compare as its numbers: LANG-57), a
boolean `bool`, a byte string `bytesOf bytesMax`, a digest `bytesOf digestBytesMax` (a digest's
validity is the World's `digestOf`, asked where data enters a run: `Lang.Program`, LANG-38), a record the `product` of its
fields in row order (no labels), a sum CODEC's `choice` over its arms (one tag byte, the arm's
index, then the payload). A function type has no data. So the stream's `Shape` IS the type's structure,
and its canonicity is the combinators' (`Lang.Proofs.Data.dataStream_lawful`).

`DataAt T` is the stream's value type; `toData` names it as machine `Data` (the labels come from
`T`) and `ofData` reads machine `Data` back at `T`. Only a CANONICAL type the wire can carry
(`Ty.wf`: ascending, hence distinct labels; `tyWire`: at most 256 arms, so one tag byte) has a data
codec: in a row with a repeated label two arms would name the same `Data`, so
`decodeData`/`encodeData` refuse any other type.
-/
import Codec.Stream
import Lang.Data
import Lang.Wire

namespace Nanodregg.Lang.Wire

open Nanodregg.Codec

mutual
/-- The values of data type `T`, shaped like `T`. -/
def DataAt : Ty → Type
  | .nat => UInt64
  | .bool => Bool
  | .bytes => Bytes Bounds.bytesMax
  | .digest => Bytes Bounds.digestBytesMax
  | .fn _ _ => Empty
  | .record r => RowAt r
  | .sum r => (i : Fin r.length) × ArmAt r i

def RowAt : List (Label × Ty) → Type
  | [] => Unit
  | (_, t) :: r => DataAt t × RowAt r

/-- The payload type of arm `i`. -/
def ArmAt : (r : List (Label × Ty)) → Fin r.length → Type
  | [], i => Fin.elim0 i
  | (_, t) :: _, ⟨0, _⟩ => DataAt t
  | _ :: r, ⟨i + 1, h⟩ => ArmAt r ⟨i, Nat.lt_of_succ_lt_succ h⟩
end

/-- The stream with no values: every input is refused. -/
def noData : Stream Empty := Stream.refine "lang/data: no value" Stream.unit (fun _ => none) Empty.elim

mutual
def dataStream : (T : Ty) → Stream (DataAt T)
  | .nat => Stream.u64be
  | .bool => Stream.bool
  | .bytes => Stream.bytesOf Bounds.bytesMax (by decide)
  | .digest => Stream.bytesOf Bounds.digestBytesMax (by decide)
  | .fn _ _ => noData
  | .record r => rowStream r
  | .sum r => Stream.choice r.length (armStream r)

def rowStream : (r : List (Label × Ty)) → Stream (RowAt r)
  | [] => Stream.unit
  | (_, t) :: r => Stream.product (dataStream t) (rowStream r)

def armStream : (r : List (Label × Ty)) → (i : Fin r.length) → Stream (ArmAt r i)
  | [], i => Fin.elim0 i
  | (_, t) :: _, ⟨0, _⟩ => dataStream t
  | _ :: r, ⟨i + 1, h⟩ => armStream r ⟨i, Nat.lt_of_succ_lt_succ h⟩
end

mutual
/-- A value of `T` as machine data. -/
def toData : (T : Ty) → DataAt T → Data
  | .nat, n => .nat n.toNat
  | .bool, b => .bool b
  | .bytes, s => .bytes s.val
  | .digest, s => .digest s.val
  | .fn _ _, e => nomatch e
  | .record r, x => .record (rowToData r x)
  | .sum r, ⟨i, x⟩ => armToData r i x

def rowToData : (r : List (Label × Ty)) → RowAt r → List (Label × Data)
  | [], () => []
  | (ℓ, t) :: r, (x, y) => (ℓ, toData t x) :: rowToData r y

def armToData : (r : List (Label × Ty)) → (i : Fin r.length) → ArmAt r i → Data
  | [], i, _ => Fin.elim0 i
  | (ℓ, t) :: _, ⟨0, _⟩, x => .inj ℓ (toData t x)
  | _ :: r, ⟨i + 1, h⟩, x => armToData r ⟨i, Nat.lt_of_succ_lt_succ h⟩ x
end

mutual
/-- Machine data read at `T`: `none` unless it has exactly `T`'s shape, labels and bounds. -/
def ofData : (T : Ty) → Data → Option (DataAt T)
  | .nat, .nat n => if h : n < 2 ^ 64 then some (UInt64.ofNatLT n h) else none
  | .bool, .bool b => some b
  | .bytes, .bytes s => if h : s.size ≤ Bounds.bytesMax then some ⟨s, h⟩ else none
  | .digest, .digest s => if h : s.size ≤ Bounds.digestBytesMax then some ⟨s, h⟩ else none
  | .record r, .record fs => rowOfData r fs
  | .sum r, .inj ℓ d => armOfData r ℓ d
  | _, _ => none

def rowOfData : (r : List (Label × Ty)) → List (Label × Data) → Option (RowAt r)
  | [], [] => some ()
  | (ℓ, t) :: r, (k, d) :: fs =>
    if ℓ = k then
      match ofData t d, rowOfData r fs with
      | some x, some y => some (x, y)
      | _, _ => none
    else none
  | _, _ => none

/-- The FIRST arm labelled `ℓ`, with `d` read at its type. -/
def armOfData : (r : List (Label × Ty)) → Label → Data → Option ((i : Fin r.length) × ArmAt r i)
  | [], _, _ => none
  | (k, t) :: r, ℓ, d =>
    if ℓ = k then (ofData t d).map fun x => ⟨⟨0, Nat.succ_pos _⟩, x⟩
    else (armOfData r ℓ d).map fun ⟨i, y⟩ => ⟨i.succ, y⟩
end

/-- The bytes of data `d` at type `T`; `none` unless `dataTy T` and `d` is a value of `T`. -/
def encodeData (T : Ty) (d : Data) : Option ByteArray :=
  if dataTy T then (ofData T d).map (dataStream T).bytes else none

/-- Exactly one value of type `T` (refused unless `dataTy T`), nothing after it. -/
def decodeData (T : Ty) (b : ByteArray) : Except Refusal Data :=
  if dataTy T then ((dataStream T).decode b).map (toData T) else .error (.rejected 0 "lang/data: type")

end Nanodregg.Lang.Wire
import Codec.Stream

/-!
# Varint — LEB128 naturals, shortest form only

A natural as base-128 digits, least significant first, each byte's top bit set when another byte
follows: 0–127 is one byte, below 2^14 two. Two widths share one reader (`getVarint width limit`):
`varint`, below 2^32 in at most five bytes (lengths, counts), and `varint64`, below 2^64 in at most
ten (KERNEL-54's per-cell versions and rows floors on the World wire). A decoder refuses an overlong
spelling (a last byte of 0 after a continuation, which a shorter spelling would have omitted), a byte
past the width, and a value at or past the limit. So every value has exactly one spelling
(`Codec.Proofs.Varint`).
-/

namespace Nanodregg.Codec.Stream

/-- The LEB128 bytes of `n`, appended to `buf`. -/
def putVarint (n : Nat) (buf : ByteArray) : ByteArray :=
  if n < 128 then buf.push n.toUInt8
  else putVarint (n / 128) (buf.push (n % 128 + 128).toUInt8)
termination_by n
decreasing_by omega

/-- Read the rest of a varint of at most `width` bytes, below `limit`, at `i`, having read `k` bytes worth
`acc` so far. -/
def getVarint (width limit : Nat) (b : ByteArray) (start : Nat) :
    (fuel : Nat) → (i k acc : Nat) → Except Refusal (Nat × Nat)
  | 0, _, _, _ => .error (.pastBound start width (width + 1))
  | fuel + 1, i, k, acc =>
    if h : i < b.size then
      let x := b[i].toNat
      if x < 128 then
        if x = 0 ∧ k > 0 then .error (.rejected start "varint/overlong")
        else
          let v := acc + x * 128 ^ k
          if v < limit then .ok (v, i + 1) else .error (.pastBound start (limit - 1) v)
      else getVarint width limit b start fuel (i + 1) (k + 1) (acc + (x - 128) * 128 ^ k)
    else .error (.truncated i 1)

/-- The number of bytes `putVarint n` appends. -/
def varintSize (n : Nat) : Nat :=
  if n < 128 then 1 else 1 + varintSize (n / 128)
termination_by n
decreasing_by omega

/-- LEB128 naturals below `limit` in at most `width` bytes, under the shape `sh`. -/
def varintOf (width limit : Nat) (sh : Shape) : Stream Nat where
  shape := sh
  size := varintSize
  put := putVarint
  get b i := getVarint width limit b i width i 0 0

/-- A natural below 2^32 in one to five bytes. -/
def varint : Stream Nat := varintOf 5 (2 ^ 32) .varint

/-- A natural below 2^64 in one to ten bytes (KERNEL-54: a cell's version, a row's version, a relation's
floor, each below `Bounds.counterLimit`). The tenth byte carries bit 63 alone, so a tenth byte of 2 or
more is a value past 2^64 − 1 and refused `pastBound`; an eleventh byte is refused `pastBound 10 11`. -/
def varint64 : Stream Nat := varintOf 10 (2 ^ 64) .varint64

/-- `varint len ‖ bytes`, at most `max` bytes (`max < 2^32`): KERNEL's rows encoding of a key or a
prefix (`natBytes k.size ++ k`, cv 01a14f7e), so its bytes are `rowKeyBytes`' and `rangePinBytes'`.
A length past `max` is refused `pastBound`, an overlong length `varint/overlong`, a short input
`truncated`. -/
def bytesV (max : Nat) : Stream ByteArray where
  shape := .bytesV max
  size v := varintSize v.size + v.size
  put v buf := putVarint v.size buf ++ v
  get b i :=
    match varint.get b i with
    | .error e => .error e
    | .ok (n, j) =>
      if n ≤ max then
        if j + n ≤ b.size then .ok (b.extract j (j + n), j + n)
        else .error (.truncated j n)
      else .error (.pastBound i max n)

end Nanodregg.Codec.Stream


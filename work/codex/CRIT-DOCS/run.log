        rcases hg.1 with ⟨hocc, rfl⟩ | hgb
        · exact .inl ⟨hocc, rfl⟩
        · exact .inr (guardedBy_sound hgb hb)
      · have hf' : Row.find? ℓ arms = some body := by simpa [Row.find?, hℓ] using hf
        exact guardedArms_sound hg.2 hf' hb
end


theorem guardedBy_sound {S : Ty} {ib : Term} : ∀ {t : Term} {k r : Nat} {env : Env} {w : Val},
    Term.guardedBy (.lam S ib) k r t = true → BigStep lib env t (.ok (.inj "ok" w)) →
  | (ℓ', b') :: arms, k, r, occ, ℓ, body, env, w, hg, hf, hb => by

/-- The reply to a submit that `Receive.judge` did not admit: PROTOCOL's status rule. -/
def settled (X : Ctx D) (w : World D) (c : Call D) (o : Outcome D) : UInt8 × ByteArray :=
  match Protocol.Settle.verdictReply X w c o with
  | some (st, name) => (st.code, name.toUTF8)
  | none => named "admitted"

/-- The answer for an un-journaled call past `Kernel.journalForgets` (KERNEL-33): `uncertain`, so
the client resolves it from the log and never resubmits or concludes `refused`. -/
def forgotten : UInt8 × ByteArray :=
  (Protocol.Status.uncertain.code, "forgotten".toUTF8)

def receipt (X : Ctx D) (height : Nat) (d : D) : ByteArray :=
  Codec.Stream.u64.bytes (UInt64.ofNat height) ++ X.env.bytes d

/-- A hang-up frame's one reply (PROTOCOL-23): the supervisor ended connection `f.conn`; the child
acknowledges it by name, `closed ‖ the same reason` (`Protocol.ack`), and changes nothing else.
`none`: `f` is not a hang-up. Every child of a supervisor answers hang-ups with this function. -/
def hangUpAnswer (f : Frame) : Option (UInt8 × ByteArray) :=
  match Protocol.childKindOf? f.op with
  | some .hangup =>
    some (match Protocol.CloseReason.ofBytes? f.payload with
      | some r => (Protocol.Status.closed.code, r.name.toUTF8)
      | none => FrameRefusal.badHangup.reply)
  | _ => none

/-- A frame's answer from the World as the batch has advanced it. -/
def handle (X : Ctx D) (w : World D) (f : Frame) : Answer (World D) (Step D) :=
  let refuse := fun (p : UInt8 × ByteArray) => Answer.reply p.1 p.2
  match Protocol.Op.ofCode? f.op with
  | none =>
    match hangUpAnswer f with
    | some p => refuse p
    | none => refuse (FrameRefusal.unknownOp f.op).reply
  | some .submit =>
    match X.decodeCall f.payload with
    | none => refuse FrameRefusal.undecodableCall.reply
    | some c =>
      match w.journalAt X.env (txIdOf X c) with
      | some (h, d) => .reply Protocol.Status.ok.code (receipt X h d)
      | none =>
        if (refusedAnswer X w c).isNone && journalForgets w.height c.unsigned.notBefore then refuse forgotten else
        match judge X w c with
        | .admitted t w' => .commit (.turn t) w' Protocol.Status.ok.code (receipt X w'.height (turnDigest X.env t))
        | .recorded v r w' =>
          let (st, p) := settled X w c (.recorded v r w')
          .commit (.refusal r) w' st p
        | .declined v => refuse (settled X w c (.declined v))
  | some .lookup =>
    match X.decodeCall f.payload with
    | none => refuse FrameRefusal.undecodableCall.reply
    | some c =>
      match w.journalAt X.env (txIdOf X c) with
      | some (h, d) => .reply Protocol.Status.ok.code (receipt X h d)
      | none =>
        match refusedAnswer X w c with
        | some code => refuse (named (recordedName code))
        | none =>
        if journalForgets w.height c.unsigned.notBefore then refuse forgotten
        else if c.unsigned.validUntil ≤ w.height then refuse FrameRefusal.expired.reply
        else .reply Protocol.Status.absent.code ByteArray.empty
  | some .read =>
    match Protocol.Envelope.ofBytes X f.payload with
    | none => refuse (named Protocol.ReadRefusal.badEnvelope.name)
    | some e =>
      match Protocol.Envelope.check X w e with
      | .error r => .reply Protocol.Status.refused.code r.payload
      | .ok () => .defer (.read e.start)
  | some .log =>
    match Protocol.Envelope.ofBytes X f.payload with
    | none => refuse (named Protocol.ReadRefusal.badEnvelope.name)
    | some e =>
      match Protocol.Envelope.check X w e with
      | .error r => .reply Protocol.Status.refused.code r.payload
      | .ok () => .defer (.log e.start)
  | some .cancel =>
    match (if f.payload[0]? = some Protocol.eventCancel then Protocol.cancelParts f.payload else none) with
    | none => refuse FrameRefusal.undecodableCall.reply
    | some (sig, cb) =>
      match X.decodeCall cb with
      | none => refuse FrameRefusal.undecodableCall.reply
      | some c =>
        match w.journalAt X.env (txIdOf X c) with
        | some (h, d) => .reply Protocol.Status.ok.code (receipt X h d)
        | none =>
          if (refusedAnswer X w c).isNone && journalForgets w.height c.unsigned.notBefore then refuse forgotten else
          match cancel X w c sig with
          | .recorded v r w' =>
            let (st, p) := settled X w c (.recorded v r w')
            .commit (.refusal r) w' st p
          | o => refuse (settled X w c o)
  | some .command => refuse (FrameRefusal.wrongSocket .command).reply
  | some .resume => refuse (FrameRefusal.wrongSocket .resume).reply

/-- The writer's machine: every step it commits is `World.step`'s (`Host.Proofs.Serve.machine_commits`). -/
def machine (X : Ctx D) : Machine (World D) (Step D) Frame D where
  note := World.roots X.env
  handle := handle X
  ok := Protocol.Status.ok.code

end Nanodregg.Host
at that height. -/
def envelopeMessage (X : Ctx D) (me : Self D) (start upTo : Nat) : ByteArray :=
  Envelope.message X me.world me.member me.grant start (upTo - me.window) upTo

/-- The envelope follow sends: `envelopeMessage`'s fields, signed. -/
def envelopeOf (me : Self D) (start upTo : Nat) (s : Signed) : Envelope D :=
  { world := me.world, member := me.member, grant := me.grant, start, notBefore := upTo - me.window,
    validUntil := upTo,
    key := s.key, signature := s.signature }

/-- The envelope a thin member signs for the base page at byte `offset`, valid until `upTo`
(first the pin's height + window; after an `expired`, the writer's stated height + window). -/
def adoptEnvelope (X : Ctx D) (me : Self D) (upTo offset : Nat) : ByteArray :=
  envelopeMessage X me offset upTo

/-- The pin an `adopt` takes: that of an invitation `Invite.acceptStart` accepts under the trusted `key`,
to the member's own World (re-derived at every step from the argv, like every plan). -/
def adoptPin (X : Ctx D) (me : Self D) (inv key : ByteArray) : Except (Refusal D) (Invite.Invitation D) :=
  match Invite.acceptStart X key inv with
  | .error r => .error (.invite r)
  | .ok (i, o) => if o = me.world then .ok i else .error (.invite .otherWorld)

/-- `invite`'s check of its INPUT: the inputs decode and make the member's own World. -/
def inviteInput (X : Ctx D) (me : Self D) (input : ByteArray) : Except (Refusal D) Unit :=
  match Invite.startOf X input with
  | none => .error (.invite .badInvitation)
  | some start =>
    match Invite.startOrigin X start with
    | .error r => .error (.invite r)
    | .ok o => if o = me.world then .ok () else .error (.invite .otherWorld)

/-! ## The incoming key (PROTOCOL-46, CLIENT-13 amended)

A rotation can land while custody has not yet settled it (its `ok` lost): the writer then refuses
the old key's envelope `unknownKey`, and the confirm that would settle custody could never read.
So a command of a verb that signs no call (`readOnly`) asks custody ONCE to sign its envelope with
the ARMED rotation's incoming key (`signIncoming`), and every later envelope of that command too.
`tried`'s bit 0 is the one `expired` re-sign, bit 1 the incoming key. A second `unknownKey` ends the
command by the writer's word (`unknownKeyEnd`); so does ANY custody refusal of the `signIncoming`
step (`custodyEnd`, ROOT's rule (a), PROTOCOL-56): custody's refusal only says why the retry could not
happen (`notArmed`: no rotation in flight; `noRotation`: `nd --stdio`'s custody, which holds none),
never what the writer said. A write is never retried: its plan would be signed by the old key against an envelope the
incoming key signed; it ends `refused unknownKey` with the hint to sync. -/

/-- The verbs that sign no call: the only ones whose envelope may be signed by the incoming key. -/
def readOnly : Cmd D → Bool
/-
# Protocol.Head — a World's position, and a member's attestation of its own (PROTOCOL-74; DESIGN-TRUST T1)

A HEAD is one World's position as every party states it: the World (its origin, KERNEL-24), its step
count (the chain's index, KERNEL-47), its height, its roots digest (what a receipt is checked
against, PROTOCOL-45) and its chain (what `fold_head_binds` binds: one `(steps, chain)` is one log).
Four spellings of it were in the tree (`logPage`'s pair, `receipt CALL`'s `head` line, `Std.head`'s
record, `host check`'s anchor); this is the one.

An ATTESTATION is a member's signed statement that its OWN follow's fold sits at a head: the head,
the member and its key, signed under `domHead` (the seventh signing domain, pairwise disjoint from
the six of `Protocol.Proofs.Domains`). It is not an authority: it says what one member holds, never
what the World is. Follow makes one at the tip of a catch-up (`nd sync --attest`: the message it
hands custody is its own World's head, `Command.attestTip`) and checks another member's
(`nd sync --check ATTEST`): the signature under the key it names, the World, and, on the World it
caught up to, that the key is the signer's CURRENT one (a rotated-away key is `staleKey`: an
attestation is checked under the signer's current key; rotate, then attest again).

The ANCHOR CHECK is the comparison (`anchorCheck`): as follow absorbs a page it advances the chain
over the page's steps, each with the roots digest after it (the record's shape, `Persist.steps`),
exactly as the kernel's `chainOf` does, and when the fold reaches the anchor's step count the chain
there must be the anchor's. Reaching it with another chain is `forked`: this member and the member
whose head that is hold two histories of one World (`Proofs.Head.forked_not_on_fold`); reaching it
with the same chain is `shared`: their logs agree up to that step, or two listed inputs collide
(`Proofs.Head.anchor_binds`, through `fold_head_binds`). The member that is BEHIND does the check: it
passes through the other's position on its way to the tip. One already past it answers `ahead` (its
World holds only the current chain; `host check STORE --anchor` on its own Store compares a past
position), and one whose writer's tip is below the anchor answers `unreached`.

A SELF-HEAD POST (PROTOCOL-75; DESIGN-TRUST T2) is the comparison made automatic, through the
writer: a member posts its own head into a `Std.head` object of THIS World (`nd sync --post OBJ`:
`headText` of follow's own World, planned as `invoke OBJ post` at the tip, `Command.body`), and
every follow that absorbs the page carrying that post reads the object (`selfPosts`: a head object
whose `world` is this World's origin, touched by a step of the page) and walks the page against the
posted `(steps, chain)` exactly as `sync --to` walks (`forkedSelfPost`). A post at a position the
page reaches with ANOTHER chain is `forkedPost`, the page kept (it is lawful on follow's fold) and
the command ended by name: the poster's signed call is the witness. A post at a position follow was
already past is not compared here: its chain is in follow's own Store (cv task T2b', the follow loop
through its index), as `host check --anchor` reads it.
-/
import Protocol.Envelope
import Protocol.Command.Text
import Protocol.Foreign

namespace Nanodregg.Protocol.Head

open Nanodregg.Codec Nanodregg.Kernel Nanodregg.Kernel.Receive

variable {D : Type} [Ord D] [DecidableEq D]

/-- One World's position. -/
structure Head (D : Type) where
  origin : D
  steps : Nat
  height : Nat
  roots : D
  chain : D
  deriving DecidableEq

/-- A World's own head. -/
def headOf (E : Env D) (w : World D) : Head D :=
  ⟨w.origin, w.steps, w.height, w.roots E, w.chain⟩

/-- The domain every attestation message begins with. -/
def domHead : ByteArray := "nanodregg/protocol/head/v1".toUTF8

/-- The signed part: the head's five fields, the member's id bytes and its key. -/
def unsignedLayout : Layout :=
  [.bytes "origin", .u64 "steps", .u64 "height", .bytes "roots", .bytes "chain", .bytes "member", .bytes "key"]

/-- An attestation on the wire: the signed bytes as carried, then the signature over them. -/
def attestationLayout : Layout := [.bytes "unsigned", .bytes "signature"]

def unsignedFrame : Stream (Layout.Ty Bounds.frameBytesMax unsignedLayout) :=
  Layout.codec Bounds.frameBytesMax (by decide) unsignedLayout

def attestationFrame : Stream (Layout.Ty Bounds.frameBytesMax attestationLayout) :=
  Layout.codec Bounds.frameBytesMax (by decide) attestationLayout

/-- The unsigned bytes of an attestation's fields, or `none` past the frame bound. -/
def unsignedBytes (E : Env D) (h : Head D) (member : D) (key : ByteArray) : Option ByteArray := do
  let f := Text.fit Bounds.frameBytesMax
  pure (unsignedFrame.bytes (← f (E.bytes h.origin), h.steps.toUInt64, h.height.toUInt64,
    ← f (E.bytes h.roots), ← f (E.bytes h.chain), ← f (E.bytes member), ← f key, ()))

/-- What the member signs. -/
def message (unsigned : ByteArray) : ByteArray := domHead ++ unsigned

/-- An attestation's wire bytes, or `none` past the frame bound. -/
def bytes (unsigned signature : ByteArray) : Option ByteArray := do
  let f := Text.fit Bounds.frameBytesMax
  pure (attestationFrame.bytes (← f unsigned, ← f signature, ()))

/-- A decoded attestation. -/
structure Attestation (D : Type) where
  head : Head D
  member : D
  key : ByteArray
  /-- the signed bytes exactly as carried (`unsignedFrame`) -/
  unsigned : ByteArray
  signature : ByteArray

/-- Why an attestation is not taken (law 7). -/
inductive Refusal
  /-- the bytes are not an attestation (either frame, or a digest field) -/
  | badAttestation
  /-- it names another World than the member's own -/
  | otherWorld
  /-- the signature does not verify over the bytes carried under the key they name -/
  | badHeadSignature
  /-- the member it names is not a live member of the World follow caught up to -/
  | notMember
  /-- the key it names is not that member's current key on the World follow caught up to -/
  | staleKey
  deriving DecidableEq, Repr

def Refusal.name : Refusal → String
  | .badAttestation => "badAttestation" | .otherWorld => "otherWorld"
  | .badHeadSignature => "badHeadSignature" | .notMember => "notMember" | .staleKey => "staleKey"

/-- The constructor's index, the thing a name must determine (`Proofs.Head.Refusal.name_injective`). -/
def Refusal.tag : Refusal → Nat
  | .badAttestation => 0 | .otherWorld => 1 | .badHeadSignature => 2 | .notMember => 3 | .staleKey => 4

def Refusal.all : List Refusal := [.badAttestation, .otherWorld, .badHeadSignature, .notMember, .staleKey]

/-- Decode the signed bytes, checking nothing they state. -/
def said (X : Ctx D) (u : ByteArray) : Option (Head D × D × ByteArray) :=
  match unsignedFrame.decode u with
  | .error _ => none
  | .ok (o, s, h, r, c, m, k, ()) => do
      pure (⟨← X.digestOf o.1, s.toNat, h.toNat, ← X.digestOf r.1, ← X.digestOf c.1⟩, ← X.digestOf m.1, k.1)

/-- Decode an attestation, checking nothing it states. -/
def ofBytes (X : Ctx D) (b : ByteArray) : Option (Attestation D) :=
  match attestationFrame.decode b with
  | .error _ => none
  | .ok (u, s, ()) => do
      let (h, m, k) ← said X u.1
      pure { head := h, member := m, key := k, unsigned := u.1, signature := s.1 }

/-- Decode and verify: the attestation is for `origin` and its signature verifies under the key it
names. Whether that key is the member's is `signer`'s question, asked on a caught-up World. -/
def verified (X : Ctx D) (origin : D) (b : ByteArray) : Except Refusal (Attestation D) :=
  match ofBytes X b with
  | none => .error .badAttestation
  | some a =>
    if a.head.origin ≠ origin then .error .otherWorld
    else if !X.verify a.key (message a.unsigned) a.signature then .error .badHeadSignature
    else .ok a

/-- On `w`, the attestation's member is live and the key it names is that member's current one. -/
def signer (X : Ctx D) (w : World D) (a : Attestation D) : Except Refusal Unit :=
  match currentKey X.env w a.member with
  | none => .error .notMember
  | some k => if k = a.key then .ok () else .error .staleKey

/-! ## The anchor check -/

/-- What walking a page's steps against an anchor finds. -/
inductive Anchored
  /-- the fold reached the anchor's step count with the anchor's chain -/
  | shared
  /-- the page ends before the anchor's step count (or began past it) -/
  | unreached
  /-- the fold reached the anchor's step count with ANOTHER chain -/
  | forked
  deriving DecidableEq, Repr

/-- From position `(s, c)`, advance the chain over the steps (each with the roots digest after it,
as `World.fold` stamps them: `stepLink`, `chainOf`) and compare at the anchor's step count. -/
def anchorCheck (E : Env D) (steps : Nat) (chain : ByteArray) : Nat → D → List (Kernel.Step D × D) → Anchored
  | _, _, [] => .unreached
  | s, c, (t, r) :: rest =>
      let c' := stepLink E c t r
      if s + 1 = steps then (if E.bytes c' = chain then .shared else .forked)
      else anchorCheck E steps chain (s + 1) c' rest

/-! ## Self-heads through the writer (PROTOCOL-75) -/

/-
# Protocol.Thin — a member that starts from a pinned base, not from genesis (PROTOCOL-14, option A)

A thin member holds a PIN: a log position (a step count, KERNEL-47) and the digest of the World
bytes at that position
(`Host.Keys.worldDigest`, deployed `Hash.digest "nanodregg/host/base-digest/v1"`, unkeyed, HOST-15), which
it takes from an invitation signed by the sponsor key it trusts (`Protocol.Invite`, PROTOCOL-42). It pages
the writer's newest base with `read` (`readReplyLayout`) and `accept` decides each page. It trusts
NOTHING the page states: the assembled bytes are adopted only if they hash to the pin and decode to
a World at the pinned step count (`Protocol.Proofs.Thin.accept_done`). A forged byte anywhere in the
served base is `baseMismatch`. From the adopted World on, the member is an ordinary follower: the
same catch-up re-derives every event after the base (PROTOCOL-4), so consent is full from the pin
on; what it trusts is the history before it.

The pin binds the World's every byte, so its step count, height AND chain (all in the World bytes):
the decoded World's step count is checked against the pin's, and the member's log catch-up starts
from it (never from the height: after a recorded refusal the two differ, PROTOCOL-41), and its chain is what the next `log` page
must continue (`chainMismatch` otherwise). Bytes are checked against the pin BEFORE they are decoded: undecodable bytes that hash to the pin
are the pin's fault (`baseUndecodable`), never a guess about the writer.
-/
import Protocol.Frames
import Protocol.Command.Text

namespace Nanodregg.Protocol.Thin

/-- What a thin member trusts: the World at log position `steps` has World bytes hashing to
`digest`. -/
structure Pin where
  steps : Nat
  digest : ByteArray
  deriving DecidableEq

/-- How a base is read: the World codec, a World's step count, the digest of World bytes a pin names
(the writer's `Keys.worldDigest`: deployed, HOST-15's cSHAKE256; the Sim's, a toy), and the bound
on a World's bytes. -/
structure Base (W : Type) where
  world : Codec.Stream W
  stepsOf : W → Nat
  digest : ByteArray → ByteArray
  bytesMax : Nat

/-- A base download in progress: the bytes `[0, got.size)` of a base `total` bytes long. It lives
in follow's memory only; a restarted follow starts the download again. -/
structure Download where
  pin : Pin
  total : Nat
  got : ByteArray

/-- One `read` page, as decoded (`readReplyLayout`). -/
structure Page where
  steps : Nat
  total : Nat
  digest : ByteArray
  chain : ByteArray
  bytes : ByteArray
  /-- the writer's certificate of the base's head, as carried (empty: none); decided at the end of
  the download, on the World it decodes to (`Protocol.Head.certifiesWorld`, PROTOCOL-77.1) -/
  certificate : ByteArray

def Page.ofBytes (b : ByteArray) : Option Page :=
  match readReplyFrame.decode b with
  | .ok (h, t, d, c, x, k, ()) => do
      pure { steps := ← Text.ofU64 h.1, total := ← Text.ofU64 t.1, digest := d.1, chain := c.1,
             bytes := x.1, certificate := k.1 }
  | .error _ => none

/-- A page's wire bytes, or `none` when a field does not fit a frame. -/
def Page.toBytes (p : Page) : Option ByteArray := do
  let f := Text.fit Bounds.frameBytesMax
  pure (readReplyFrame.bytes (← f (Text.u64 p.steps), ← f (Text.u64 p.total), ← f p.digest,
    ← f p.chain, ← f p.bytes, ← f p.certificate, ()))

/-- Why a base is not adopted (law 7). -/
inductive Refusal
  /-- the `read` reply does not decode as a page -/
  | badPage
  /-- the writer's newest base is at another log position than the pin: a newer seal (get a fresh
  pin) or a writer serving an older one -/
  | baseMoved (steps : Nat)
  /-- the page states another digest, or the assembled bytes do not hash to the pin, or they
  decode to a World at another step count: a forged or corrupted base -/
  | baseMismatch
  /-- a page that does not continue the download: another total, no bytes, or past the total -/
  | pageMismatch
  /-- the stated total is past the bound on a World's bytes -/
  | baseTooLarge (total : Nat)
  /-- bytes that hash to the pin do not decode as a World: the pin itself names no World -/
  | baseUndecodable
  /-- follow's World is already at or past the pin: nothing to adopt -/
  | notBehind (steps : Nat)
  /-- follow's own Store already holds Turns past genesis: an adopted base over them would leave
  two histories in one Store, follow's own up to `steps` and the writer's from the pin, with the
  steps between in neither (HOST-3's review; law 1). A thin member adopts from a fresh Store. -/
  | notAtGenesis (steps : Nat)
  /-- the command read its page budget; the download is kept and the member runs it again -/
  | incomplete (got total : Nat)
  /-- the adopted World is another World than the one the member was invited to (KERNEL-24) -/
  | wrongWorld
  deriving DecidableEq, Repr

def Refusal.name : Refusal → String
  | .badPage => "badPage" | .baseMoved _ => "baseMoved" | .baseMismatch => "baseMismatch"
  | .pageMismatch => "pageMismatch" | .baseTooLarge _ => "baseTooLarge"
  | .baseUndecodable => "baseUndecodable" | .notBehind _ => "notBehind" | .incomplete _ _ => "incomplete"
  | .notAtGenesis _ => "notAtGenesis" | .wrongWorld => "wrongWorld"

def Refusal.tag : Refusal → Nat
  | .badPage => 0 | .baseMoved _ => 1 | .baseMismatch => 2 | .pageMismatch => 3
  | .baseTooLarge _ => 4 | .baseUndecodable => 5 | .notBehind _ => 6 | .incomplete _ _ => 7 | .notAtGenesis _ => 8
  | .wrongWorld => 9

/-- The download held for `pin`, if any (a download for another pin is dropped). -/
def held (pin : Pin) : Option Download → Option Download
  | some d => if d.pin = pin then some d else none
  | none => none

/-- The byte offset the next page is asked from. -/
def offset (pin : Pin) (dl : Option Download) : Nat :=
  ((held pin dl).map (·.got.size)).getD 0

/-- What one page leads to. -/
inductive Progress (W : Type)
  /-- more bytes to fetch, from `got.size` -/
  | more (d : Download)
  /-- the base, adopted -/
  | done (w : W)

variable {W : Type}

/-- The download held for `pin` was of another total: not a continuation. -/
def totalMoved (pin : Pin) (dl : Option Download) (total : Nat) : Bool :=
  match held pin dl with
  | some d => d.total != total
  | none => false

/-- The last check of a download: the bytes hash to the pin, then decode to a World at the pinned
step count. -/
def finish (B : Base W) (pin : Pin) (got : ByteArray) : Except Refusal (Progress W) :=
  if B.digest got ≠ pin.digest then .error .baseMismatch else
  match B.world.decode got with
  | .error _ => .error .baseUndecodable
  | .ok w => if B.stepsOf w ≠ pin.steps then .error .baseMismatch else .ok (.done w)

/-- Decide one page of the base download for `pin`, given the download so far. -/
def accept (B : Base W) (pin : Pin) (dl : Option Download) (p : Page) : Except Refusal (Progress W) :=
  let got := ((held pin dl).map (·.got)).getD ByteArray.empty
  if p.steps ≠ pin.steps then .error (.baseMoved p.steps)
  else if p.digest ≠ pin.digest then .error .baseMismatch
  else if B.bytesMax < p.total then .error (.baseTooLarge p.total)
  else if totalMoved pin dl p.total then .error .pageMismatch
  else if p.bytes.size = 0 ∨ p.total < got.size + p.bytes.size then .error .pageMismatch
  else if (got ++ p.bytes).size < p.total then .ok (.more ⟨pin, p.total, got ++ p.bytes⟩)
  else finish B pin (got ++ p.bytes)

end Nanodregg.Protocol.Thin


        with output.open('w') as out:
            p=subprocess.run(['swarm-build','lake','env','lean',str(path)],
                cwd=root,env=env,stdout=out,stderr=subprocess.STDOUT)
        body=output.read_text()
        bad=bool(re.search(r'unbound variable|No such file|Traceback|Unknown identifier',body,re.I))
        good=(p.returncode==0 and not bad) if mode=='control' else (p.returncode!=0 and not bad and ('is false' in body or 'unsolved goals' in body))
        print(f'{name} {mode}: exit={p.returncode} verdict={"EXPECTED" if good else "BAD"} log={output}',flush=True)
        print(body if body else '(empty successful compiler output)',flush=True)
        failed |= not good
raise SystemExit(1 if failed else 0)

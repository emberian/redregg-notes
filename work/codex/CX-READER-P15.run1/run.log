#!/usr/bin/env bash
# swarm-build — run a build under an ENFORCED memory cap + CPU pinning + KILLABLE.
# Two RAM-protection layers:
#   * per-build cap  (SWARM_MEM_MAX, default 96G) — bounds a single build.
#   * shared box cap (swarm.slice MemoryMax, set by the drop-in at
#     ~/.config/systemd/user/swarm.slice.d/50-memcap.conf) — bounds the SUM of
#     ALL concurrent swarm-build invocations, because every scope nests under
#     one swarm.slice. Without it, N parallel builds (multi-agent) each get an
#     INDEPENDENT cap and their box-level total is unbounded: that summing is
#     the mechanism behind the box-level RAM runaway (many ~6G builds summing,
#     misread as one process). The shared slice makes total box exposure
#     <= the slice cap no matter how many builds run at once.
# Advisory taskset caps CPU only; the cgroup caps RAM so a runaway compile
# cannot starve the box into unreachability.
#   usage: swarm-build lake build Foo   |   SWARM_MEM_MAX=48G swarm-build Holmake -j 8
set -euo pipefail
if [ -n "${SWARM_BUILD_INNER:-}" ]; then
  # CRITICAL: make the build explicitly KILLABLE. A -1000 inherited from a parent
  # (e.g. an sshd with OOMScoreAdjust set) makes the cgroup cap UNENFORCEABLE —
  # the kernel reports "no killable processes" and wedges the whole box. Learned
  # the hard way 2026-07-15: that exact interaction hard-downed hbox.
  echo 0 > /proc/self/oom_score_adj 2>/dev/null || true
  exec taskset -c 0-15 nice -n 15 "$@"
fi
export SWARM_BUILD_INNER=1
exec systemd-run --user --scope --slice=swarm.slice --quiet \
  -p MemoryMax="${SWARM_MEM_MAX:-96G}" -p MemorySwapMax=0 -p CPUWeight=50 \
  -- "$0" "$@"

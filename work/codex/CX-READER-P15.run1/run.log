 ('exclusion','P5','positive_candidate_refutes_certificate','r.excluded.all (fun a => !p.accepts a)','true',''),
 ('exhaustion','P5','four_status_session','| none => .open .searchRemaining []','| none => .refuted ⟨[]⟩',''),

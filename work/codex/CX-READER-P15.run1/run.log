logs=Path('/tank/dregg-build/nanodregg/logs')
env=os.environ.copy()
env.update(SWARM_MEM_MAX='6G', LEAN_NUM_THREADS='2', CARGO_TARGET_DIR=str(root/'target'))
def theorem(module,name):
    s=(root/f'Lang/Proofs/Contextual/{module}.lean').read_text()
    start=s.index('theorem '+name)
    end=s.find('\n\n',start)
    return s[start:end]+'\n'

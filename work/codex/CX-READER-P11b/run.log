import Lang.Contextual.TransportKinds
import Lang.Proofs.Contextual.RepairObjects
import Lang.Proofs.Contextual.Stability

namespace Nanodregg.Lang.Contextual.TransportKinds

/-- Evidence is indexed by the actual evidence form; internal evidence includes a relation
and preserved proposition, while rechecked evidence names the destination judgment
(Ringer p7; Viola pp1–2). -/
inductive Valid {D : CalculusData} {E V : Type} (I : Iface D E) (w : World E)
    (value : D.Tm → V) : Claim D E → Prop where
  | rechecked {ev : RepairObjects.TransportEvidence D E} :
      ev.correspondence.target = I → judge I w ev.image = .verified →
      Valid I w value (.rechecked ev)
  | internal {source target : Candidate D} :
      value source.filling = value target.filling →
      judge I w target = .verified → Valid I w value (.internal source target)

/-- Successful translation validation really rejudges the returned destination term;
the claim does not inherit validity from its tag (Ringer et al. p7). -/
theorem recheck_sound {D : CalculusData} {E : Type}
    {registry : RepairObjects.Registry D E} (hr : registry.Sound)
    {n : Nat} {w : World E} {c : Candidate D} {cost : Nat}
    {ev : RepairObjects.TransportEvidence D E}
    (h : recheck registry n w c cost = .ok (.rechecked ev)) :
    judge ev.correspondence.target w ev.image = .verified := by
  unfold recheck at h
  split at h
  · cases h
  · rename_i ev' he
    cases h
    exact (RepairObjects.transport_sound hr he).2.2.2.2.1
  · cases h

/-- Representation maps commute with observations on every quotient element
(Viola et al. p2, internally proved in Lean). -/
theorem lift_observation {A B V : Type} (a : A → V) (b : B → V) (f : A → B)
    (h : ∀ x, b (f x) = a x) (q : Observed A V a) :
    observation b (liftMap a b f h q) = observation a q := by
  induction q using Quot.ind with
  | _ x => exact h x

/-- Two observation-preserving maps are inverse on quotients, although concrete
representatives need not be equal (Viola et al. p2). -/
theorem quotient_inverse {A B V : Type} (a : A → V) (b : B → V)
    (f : A → B) (g : B → A)
    (hf : ∀ x, b (f x) = a x) (hg : ∀ y, a (g y) = b y)
    (q : Observed A V a) :
    liftMap b a g hg (liftMap a b f hf q) = q := by
  induction q using Quot.ind with
  | _ x =>
    apply Quot.sound
    exact (hg (f x)).trans (hf x)

/-- An extensional predicate transports internally along the quotient map; no fresh
execution of the predicate is required (Viola et al. pp1–2). -/
theorem quotient_predicate_transport {A B V : Type} (a : A → V) (b : B → V)
    (f : A → B) (hf : ∀ x, b (f x) = a x) (P : V → Prop)
    (q : Observed A V a) (h : P (observation a q)) :
    P (observation b (liftMap a b f hf q)) := by
  rw [lift_observation]
  exact h

/-- The two evidence forms cannot be confused by a consumer (Ringer p7; Viola p1). -/
theorem evidence_forms_distinct {D : CalculusData} {E : Type}
    (ev : RepairObjects.TransportEvidence D E) (s t : Candidate D) :
    Claim.rechecked ev ≠ .internal s t := by
  intro h
  cases h

/-- Forgetting a representation flag is many-to-one, yet quotient-invertible
(Viola et al. p2, analogous to their multiple queue representatives). -/
theorem redundant_flag_quotient :
    Quot.mk (fun x y : Nat × Bool => x.1 = y.1) (7, false) =
      Quot.mk (fun x y : Nat × Bool => x.1 = y.1) (7, true) ∧
    (7, false) ≠ (7, true) := by
  exact ⟨Quot.sound rfl, by decide⟩


/-- A quotient relation plus a value guard derives destination validity internally.
Typing, dependencies and cost remain independent obligations: quotient equality does
not erase them (Viola et al. pp1–2; Kavvos p1). -/
theorem internal_from_quotient {D : CalculusData} {E V : Type}
    (value : D.Tm → V) {I : Iface D E} (hg : ValueGuard value I.guard)
    {w : World E} {s t : Candidate D}
    (hq : (Quot.mk _ s.filling : Observed D.Tm V value) = Quot.mk _ t.filling)
    (hs : judge I w s = .verified)
    (hchk : D.check I.ctx t.filling I.ty = D.check I.ctx s.filling I.ty)
    (hb : t.blockers = s.blockers) (hdeps : effSupports I t = effSupports I s)
    (hcost : t.cost = s.cost) :
    Valid I w value (.internal s t) := by
  have hv : value s.filling = value t.filling :=
    congrArg (observation value) hq
  exact .internal hv ((judge_stable value hg hv.symm hchk hb hdeps hcost).trans hs)

/-- Both evidence forms deliver admission of their actual destination; the internal form
also carries an observable equality (Ringer p7; Viola pp1–2). -/
theorem internal_valid_destination {D : CalculusData} {E V : Type}
    {I : Iface D E} {w : World E} {value : D.Tm → V} {s t : Candidate D}
    (h : Valid I w value (.internal s t)) :
    value s.filling = value t.filling ∧ judge I w t = .verified := by
  cases h with
  | internal hv hj => exact ⟨hv, hj⟩

/-- Rechecking constructs the matching validity judgment (Ringer et al. p7). -/
theorem recheck_valid {D : CalculusData} {E V : Type} (value : D.Tm → V)
    {registry : RepairObjects.Registry D E} (hr : registry.Sound)
    {n : Nat} {w : World E} {c : Candidate D} {cost : Nat}
    {ev : RepairObjects.TransportEvidence D E}
    (h : recheck registry n w c cost = .ok (.rechecked ev)) :
    Valid ev.correspondence.target w value (.rechecked ev) :=
  .rechecked rfl (recheck_sound hr h)

end Nanodregg.Lang.Contextual.TransportKinds
/- Typed syntax-reading guards and extensional boundaries: Kavvos (2020) p1;
Jang et al., Moebius (2021), pp1–2. Simply-typed contextual fragment only. -/
import Lang.Contextual.Boundary
import Lang.Contextual.CoreCalculus

namespace Nanodregg.Lang.Contextual.ModalBoundary

/-- Intrinsically scoped variables (Moebius p2, contextual code). -/
inductive Var : Ctx → Ty → Type where
  | here {Γ : Ctx} {A : Ty} : Var (A :: Γ) A
  | there {Γ : Ctx} {A B : Ty} : Var Γ A → Var (B :: Γ) A

/-- Contextual code carries its context and result type. This STLC fragment supports
typed syntax analysis, not the full polymorphic Moebius calculus (Moebius pp1–2). -/
inductive Code : Ctx → Ty → Type where
  | var {Γ : Ctx} {A : Ty} : Var Γ A → Code Γ A
  | lam {Γ : Ctx} (A : Ty) {B : Ty} : Code (A :: Γ) B → Code Γ (.arr A B)
  | app {Γ : Ctx} {A B : Ty} : Code Γ (.arr A B) → Code Γ A → Code Γ B

/-- Scoped variables erase to the existing CMTT indices (Moebius p2). -/
def Var.index {Γ : Ctx} {A : Ty} : Var Γ A → Nat
  | .here => 0
  | .there v => v.index + 1

/-- Typed code erases to the LANDED term language, not a new operational semantics
(Moebius p2). -/
def Code.erase {Γ : Ctx} {A : Ty} : Code Γ A → Tm
  | .var v => .var v.index
  | .lam A body => .lam A body.erase
  | .app f a => .app f.erase a.erase

/-- Syntax-reading guards are typed patterns; lambda inspection requires an arrow
contextual type (Moebius pp1–2). -/
inductive Guard (Γ : Ctx) : Ty → Type where
  | isVariable {A : Ty} : Guard Γ A
  | isApplication {A : Ty} : Guard Γ A
  | isLambda {A B : Ty} : Guard Γ (.arr A B)

/-- Evaluate the pattern on well-scoped code (Moebius pp1–2). -/
def Guard.run {Γ : Ctx} {A : Ty} (g : Guard Γ A) (c : Code Γ A) : Bool :=
  match g, c with
  | .isVariable, .var _ => true
  | .isApplication, .app _ _ => true
  | .isLambda, .lam _ _ => true
  | _, _ => false

/-- The raw extension is consumed ONLY through the existing typed candidate judge;
raw_erase proves agreement on code (Moebius pp1–2). -/
def Guard.raw {Γ : Ctx} {A : Ty} (g : Guard Γ A) (t : Tm) : Bool :=
  match g, t with
  | .isVariable, .var _ => true
  | .isApplication, .app _ _ => true
  | .isLambda, .lam _ _ => true
  | _, _ => false

/-- Install a typed syntax pattern at an existing CMTT boundary; the original checker,
support checks and budget still apply (Kavvos p1; Moebius p2). -/
def boundary {V : Type} (Γ : Ctx) (A : Ty) (g : Guard Γ A)
    (behavior : Tm → V) : Boundary cmttData Unit V where
  iface := {
    name := 0, ctx := Γ, ty := A, hyps := [], hyps_real := by simp,
    guard := fun _ t => g.raw t, budget := 1, chooser := 1, acceptor := 2 }
  declares := Declaration.top
  behavior := fun _ t => behavior t
  costBound := 1

/-- Candidate construction consumes typed contextual code (Moebius p2). -/
def candidate {Γ : Ctx} {A : Ty} (c : Code Γ A) : Candidate cmttData :=
  ⟨c.erase, [], [], 1, 1, .verified⟩

/-- One explicit beta contraction as a boundary observation; no normalization claim
(Kavvos p1, values versus descriptions). -/
def betaObservation : Tm → Tm
  | .app (.lam _ body) arg => subst [arg] body
  | t => t

/-- A typed contextual beta redex (Moebius p2). -/
def redex : Code [.base] .base := .app (.lam .base (.var .here)) (.var .here)

/-- The redex's contextual result (Moebius p2). -/
def reduced : Code [.base] .base := .var .here

/-- A world without token prerequisites for the boundary demonstration (Kavvos p1). -/
def world : World Unit := ⟨fun _ => false, ()⟩

end Nanodregg.Lang.Contextual.ModalBoundary
import Lang.Contextual.ModalBoundary
import Lang.Proofs.Contextual.Boundary
import Lang.Proofs.Contextual.Core

namespace Nanodregg.Lang.Contextual.ModalBoundary

/-- Scoped indices really refer to their carried type (Moebius p2). -/
theorem Var.lookup {Γ : Ctx} {A : Ty} (v : Var Γ A) : Γ[v.index]? = some A := by
  induction v with
  | here => rfl
  | there v ih => exact ih

/-- Every typed pattern input has a derivation in the landed CMTT calculus
(Moebius pp1–2). -/
theorem Code.typed {Γ : Ctx} {A : Ty} (c : Code Γ A) :
    HasTy MEnv.nil Γ c.erase A := by
  induction c with
  | var v => exact .var v.lookup
  | lam A body ih => exact .lam ih
  | app f a ihf iha => exact .app ihf iha

/-- The raw extension used by Boundary agrees with typed pattern evaluation
(Moebius pp1–2). -/
theorem Guard.raw_erase {Γ : Ctx} {A : Ty} (g : Guard Γ A) (c : Code Γ A) :
    g.raw c.erase = g.run c := by
  cases g <;> cases c <;> rfl

/-- Typed syntax patterns feed the actual existing candidate judge, not only a detached
Boolean demonstration (Moebius p2). -/
theorem typed_guard_judge {V : Type} {Γ : Ctx} {A : Ty}
    (g : Guard Γ A) (behavior : Tm → V) (c : Code Γ A) :
    judge (boundary Γ A g behavior).iface world (candidate c) = .verified ↔
      g.run c = true := by
  rw [judge_verified_iff]
  have hc : cmttData.check Γ c.erase A = true := check_complete c.typed
  simp [boundary, candidate, hc, effSupports, Guard.raw_erase]

/-- Extensional consumers of a boundary's preserved behavior retain their observation
(Kavvos p1). This is the extensional side of the same split as the syntax counterexample. -/
theorem extensional_locality {D : CalculusData} {E V R : Type}
    (b : Boundary D E V) {w w' : World E} {c c' : Candidate D}
    (h : b.behavior w.env c.filling = b.behavior w'.env c'.filling) (consumer : V → R) :
    consumer (b.behavior w.env c.filling) = consumer (b.behavior w'.env c'.filling) :=
  congrArg consumer h

/-- Equal boundary observations do not license syntax-guard reuse. Exactly the logical
contract reopens; typing, beta observation and cost stay preserved (Kavvos p1; Moebius p2). -/
theorem intensional_boundary_breaks :
    (boundary [.base] .base .isApplication betaObservation).failures
      world world (candidate redex) (candidate reduced) = [.logicalContract] := by decide

/-- This is a real typed beta step, not two arbitrarily equated values (Moebius p2). -/
theorem typed_beta_witness :
    HasTy MEnv.nil [.base] redex.erase .base ∧
    HasTy MEnv.nil [.base] reduced.erase .base ∧ Step redex.erase reduced.erase := by
  exact ⟨redex.typed, reduced.typed, .beta⟩

/-- The same repair is admitted by the application pattern before reduction and refused
after it; typed syntax inspection is intentionally intensional (Kavvos p1; Moebius p2). -/
theorem intensional_judge_breaks :
    judge (boundary [.base] .base .isApplication betaObservation).iface world
      (candidate redex) = .verified ∧
    judge (boundary [.base] .base .isApplication betaObservation).iface world
      (candidate reduced) = .conflict .guardFails := by decide

end Nanodregg.Lang.Contextual.ModalBoundary


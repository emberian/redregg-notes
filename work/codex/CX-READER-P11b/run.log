results=[]
def run(name,args):
    path=logs/('CX-P11b-'+name+'.log')
    with path.open('w') as out:
        p=subprocess.run(['swarm-build']+args,env=env,stdout=out,stderr=subprocess.STDOUT)
    return p.returncode
for plant in plants:
    name=plant['name']
    file=root/('Lang/Contextual/'+plant['module']+'.lean')
    original=file.read_text()
    assert original.count(plant['old'])==1, name
    probe=logs/('CX-P11b-probe-'+name+'.lean')
    probe.write_text(plant['probe'])
    lean=['lake','env','lean','-DmaxHeartbeats=200000','-DautoImplicit=false','-DrelaxedAutoImplicit=false','-DwarningAsError=true',str(probe)]
    baseline=run('plant-'+name+'-control',lean)
    if baseline:
        raise RuntimeError('baseline failed: '+name)
    try:
        file.write_text(original.replace(plant['old'],plant['new']))
        (logs/('CX-P11b-mutant-'+name+'.txt')).write_text(file.read_text())
        build=run('plant-'+name+'-build',['lake','build','Lang.Contextual.'+plant['module']])
        if build:
            raise RuntimeError('mutant build failed: '+name)
        verdict=run('plant-'+name+'-red',lean)
        if verdict==0:
            raise RuntimeError('mutant passed: '+name)
    finally:
        file.write_text(original)
        restored=run('plant-'+name+'-restore',['lake','build','Lang.Contextual.'+plant['module']])
        if restored:
            raise RuntimeError('restored build failed: '+name)
    restored_probe=run('plant-'+name+'-restored-control',lean)
    if restored_probe:
        raise RuntimeError('restored probe failed: '+name)
    result=dict(name=name,control=baseline,mutant_build=build,mutant_probe=verdict,restored_build=restored,restored_probe=restored_probe)
    results.append(result)
    (logs/'CX-P11b-plant-results.json').write_text(json.dumps(results,indent=2)+'\n')
    print(json.dumps(result),flush=True)

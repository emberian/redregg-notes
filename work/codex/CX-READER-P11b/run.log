/- Context-morphism values, not token edits: Cave–Pientka (2013), pp1–2. -/
import Lang.Contextual.Core

namespace Nanodregg.Lang.Contextual.ContextMorphisms

/-- First-class substitution data scoped by domain and codomain; Valid lives in Proofs
(Cave–Pientka p1). Phantom indices alone are not typing evidence. -/
structure Morphism (source target : Ctx) where
  term : Nat → Tm

/-- Identity context morphism (Cave–Pientka p2, substitution equations). -/
def identity (Γ : Ctx) : Morphism Γ Γ := ⟨Tm.var⟩

/-- Apply a first-class context morphism, using the landed capture-avoiding substitution
(Cave–Pientka pp1–2). -/
def apply {Γ Ψ : Ctx} (s : Morphism Γ Ψ) (t : Tm) : Tm := substFn s.term t

/-- Compose scoped substitutions; token withdrawal has no constructor here
(Cave–Pientka pp1–2). -/
def compose {Γ Ψ Φ : Ctx} (s : Morphism Γ Ψ) (t : Morphism Ψ Φ) : Morphism Γ Φ :=
  ⟨fun i => apply t (s.term i)⟩

/-- Weakening is a morphism into the extended context (Cave–Pientka p1). -/
def weakening (Γ : Ctx) (A : Ty) : Morphism Γ (A :: Γ) := ⟨fun i => .var (i + 1)⟩

/-- Exchange the first two variables (Cave–Pientka p1). -/
def exchange (Γ : Ctx) (A B : Ty) : Morphism (A :: B :: Γ) (B :: A :: Γ) :=
  ⟨fun | 0 => .var 1 | 1 => .var 0 | i + 2 => .var (i + 2)⟩

/-- Strengthening offers the lower-context term only if the removed variable is unused.
This is a partial inverse of weakening, not a total map of the removed variable
(Cave–Pientka p1; landed CMTT strengthening). -/
def strengthen (x : Nat) (t : Tm) : Option Tm :=
  if uses x t then none else some (unshiftAt x t)

end Nanodregg.Lang.Contextual.ContextMorphisms
import Lang.Contextual.ContextMorphisms
import Lang.Proofs.Contextual.Core

namespace Nanodregg.Lang.Contextual.ContextMorphisms

/-- Context morphisms map each declared variable to a term of the same type
(Cave–Pientka p1). -/
def Valid {Γ Ψ : Ctx} (Δ : MEnv) (s : Morphism Γ Ψ) : Prop :=
  ∀ i A, Γ[i]? = some A → HasTy Δ Ψ (s.term i) A

/-- The morphism action preserves typing (Cave–Pientka pp1–2). -/
theorem apply_typed {Γ Ψ : Ctx} {Δ : MEnv} {s : Morphism Γ Ψ}
    (hs : Valid Δ s) {t : Tm} {A : Ty} (ht : HasTy Δ Γ t A) :
    HasTy Δ Ψ (apply s t) A :=
  hasTy_substFn ht Ψ s.term hs

/-- Identity substitution is scoped and typed (Cave–Pientka p2). -/
theorem identity_valid (Δ : MEnv) (Γ : Ctx) : Valid Δ (identity Γ) := by
  intro i A h
  exact .var h

/-- Composed substitutions remain scoped (Cave–Pientka pp1–2). -/
theorem compose_valid {Γ Ψ Φ : Ctx} {Δ : MEnv}
    {s : Morphism Γ Ψ} {t : Morphism Ψ Φ} (hs : Valid Δ s) (ht : Valid Δ t) :
    Valid Δ (compose s t) := by
  intro i A h
  exact apply_typed ht (hs i A h)

/-- Substitution composition agrees with sequential application (Cave–Pientka p2). -/
theorem apply_compose {Γ Ψ Φ : Ctx} (s : Morphism Γ Ψ) (t : Morphism Ψ Φ) (a : Tm) :
    apply (compose s t) a = apply t (apply s a) :=
  (substFn_substFn t.term s.term a).symm

/-- Identity acts on terms, including under binders (Cave–Pientka p2). -/
theorem apply_identity (Γ : Ctx) (a : Tm) : apply (identity Γ) a = a := substFn_var a

/-- Weakening preserves each declared variable (Cave–Pientka p1). -/
theorem weakening_valid (Δ : MEnv) (Γ : Ctx) (A : Ty) :
    Valid Δ (weakening Γ A) := by
  intro i B h
  exact .var h

/-- Exchange is typed for heterogeneous adjacent variables (Cave–Pientka p1). -/
theorem exchange_valid (Δ : MEnv) (Γ : Ctx) (A B : Ty) :
    Valid Δ (exchange Γ A B) := by
  intro i C h
  cases i with
  | zero =>
    simp only [List.getElem?_cons_zero, Option.some.injEq] at h
    subst C
    exact .var rfl
  | succ i =>
    cases i with
    | zero =>
      simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at h
      subst C
      exact .var rfl
    | succ i => exact .var h

/-- A strengthening result is typed in the reduced context and reconstructs the original
through projection (Cave–Pientka p1; CMTT factorization). -/
theorem strengthen_sound {Δ : MEnv} {Γ : Ctx} {t s : Tm} {A : Ty} {x : Nat}
    (ht : HasTy Δ Γ t A) (h : strengthen x t = some s) :
    HasTy Δ (Γ.eraseIdx x) s A ∧ shiftAt x s = t := by
  unfold strengthen at h
  split at h
  · cases h
  · rename_i hu
    have hfalse : uses x t = false := Bool.eq_false_iff.2 hu
    cases h
    exact ⟨hasTy_unshiftAt ht hfalse, shiftAt_unshiftAt hfalse⟩

/-- Removing a used hypothesis refuses; exchanging distinct typed variables computes
(Cave–Pientka p1). -/
theorem scope_teeth :
    strengthen 0 (.var 0) = none ∧
    apply (exchange [] .base (.arr .base .base)) (.var 0) = .var 1 := by decide

end Nanodregg.Lang.Contextual.ContextMorphisms
/- Translation validation versus internal transport, Ringer et al. (2021) p7;
Viola–Fan–Ringer (2025) pp1–2. -/
import Lang.Contextual.RepairObjects

namespace Nanodregg.Lang.Contextual.TransportKinds

/-- Distinct data constructors record how a claim is justified; Valid is a separate Prop
(Ringer p7; Viola pp1–2). Merely constructing a claim is not evidence of validity. -/
inductive Claim (D : CalculusData) (E : Type) where
  | rechecked (evidence : RepairObjects.TransportEvidence D E)
  | internal (source target : Candidate D)

/-- Rechecked claims can be emitted only after the existing transport operation succeeds
(Ringer et al. p7). -/
def recheck {D : CalculusData} {E : Type} (registry : RepairObjects.Registry D E)
    (certificate : Nat) (w : World E) (c : Candidate D) (cost : Nat) :
    Except RepairObjects.TransportRefusal (Claim D E) :=
  match RepairObjects.transport registry certificate w c cost with
  | .error e => .error e
  | .ok (.transported ev) => .ok (.rechecked ev)
  | .ok (.existing _) => .error .unknownCertificate

/-- Quotient by the declared observable, permitting multiple concrete representatives
(Viola et al. p2). -/
abbrev Observed (A V : Type) (observe : A → V) :=
  Quot (fun a b : A => observe a = observe b)

/-- The quotient's observation is well-defined (Viola et al. pp1–2). -/
def observation {A V : Type} (observe : A → V) : Observed A V observe → V :=
  Quot.lift observe (fun _ _ h => h)

/-- Lift an observation-preserving representation map to quotients. The required proof is
kernel checked, not a Boolean recheck (Viola et al. p2). -/
def liftMap {A B V : Type} (a : A → V) (b : B → V) (f : A → B)
    (h : ∀ x, b (f x) = a x) : Observed A V a → Observed B V b :=
  Quot.lift (fun x => Quot.mk _ (f x)) (by
    intro x y he
    apply Quot.sound
    exact (h x).trans (he.trans (h y).symm))


/-- Consume the actual offered candidate from either evidence form; admission still goes
through the existing propose/select operations (Ringer p7; Viola pp1–2). -/
def Claim.destination {D : CalculusData} {E : Type} : Claim D E → Candidate D
  | .rechecked ev => ev.image
  | .internal _ target => target

end Nanodregg.Lang.Contextual.TransportKinds


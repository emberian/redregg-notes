      exact ⟨List.mem_cons_of_mem _ hm, he, hv⟩

theorem choose_none (policy : Policy D) (I : Iface D E) (w : World E) :
    ∀ (cs : List (Candidate D)) (n : Nat), choose policy I w cs n = none →
      ∀ c ∈ cs, policy.eligible c = true → judge I w c ≠ .verified

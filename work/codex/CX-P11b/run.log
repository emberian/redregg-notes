/- The boundary declaration: four independent observations, with explicit failed obligations.
This is a demonstration Mini can take; no wire or existing judgment changes. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

inductive Observation where
  | typingInterface
  | logicalContract
  | observableBehavior
  | costGuarantee
deriving DecidableEq, Repr

def Observation.all : List Observation :=
  [.typingInterface, .logicalContract, .observableBehavior, .costGuarantee]

/-- The powerset lattice: demanding cost does not imply demanding a particular behavior. -/
abbrev Declaration := Observation → Bool

def Declaration.meet (a b : Declaration) : Declaration := fun o => a o && b o
def Declaration.join (a b : Declaration) : Declaration := fun o => a o || b o
def Declaration.bottom : Declaration := fun _ => false
def Declaration.top : Declaration := fun _ => true

/-- A boundary belongs to a concrete hole interface. The behavior projection specifies exactly
what downstream caches may observe. The cost promise is separate from admission's budget. -/
structure Boundary (D : CalculusData) (E V : Type) where
  iface : Iface D E
  declares : Declaration
  behavior : E → D.Tm → V
  costBound : Nat

def Observation.Value (V : Type) : Observation → Type
  | .observableBehavior => V
  | _ => Bool

instance {V : Type} [DecidableEq V] (o : Observation) :
    DecidableEq (o.Value V) := by cases o <;> simp only [Observation.Value] <;> infer_instance

def Boundary.read {D : CalculusData} {E V : Type} (b : Boundary D E V)
    (w : World E) (c : Candidate D) : (o : Observation) → o.Value V
  | .typingInterface => D.check b.iface.ctx c.filling b.iface.ty
  | .logicalContract => b.iface.guard w.env c.filling
  | .observableBehavior => b.behavior w.env c.filling
  | .costGuarantee => decide (c.cost ≤ b.costBound)

/-- A failed declaration propagates an obligation bearing the hole name AND observation.
The old observation is retained as the reference, never overwritten by the repair's answer. -/
def Boundary.failures {D : CalculusData} {E V : Type} [DecidableEq V]
    (b : Boundary D E V) (w w' : World E) (c c' : Candidate D) : List Observation :=
  Observation.all.filter fun o => b.declares o && !decide (b.read w c o = b.read w' c' o)

/-- Inspect the actual selections after a repair/chooser session. An absent filling cannot
re-establish a declaration; all its promised observations remain obligations. -/
def Boundary.obligations {D : CalculusData} {E V : Type} [DecidableEq V]
    (b : Boundary D E V) (w w' : World E) (cl cl' : Closure D E) : List (Nat × Observation) :=
  let failed := match cl.selectedCand b.iface.name, cl'.selectedCand b.iface.name with
    | some c, some c' => b.failures w w' c c'
    | _, _ => Observation.all.filter b.declares
  failed.map fun o => (b.iface.name, o)

namespace BoundarySearch

/-- A small executable search calculus, not an encoding of deployed Lang terms.
The constructors denote actual algorithms below, not arbitrary supplied answers/costs. -/
inductive Term where
  | binary
  | linear
  | var (n : Nat)
  | hole (n : Nat)
deriving DecidableEq, Repr

def data : CalculusData where
  Ty := Unit
  Ctx := List Unit
  Tm := Term
  tmEq := inferInstance
  msubst σ t := match t with | .hole n => (σ n).getD t | _ => t
  check Γ t _ := match t with
    | .binary | .linear => true
    | .var n => (Γ[n]?).isSome
    | .hole _ => false
  uses t n := match t with | .var m => m == n | _ => false
  drop Γ n := Γ.eraseIdx n
  strengthen n t := match t with | .var m => .var (if m < n then m else m - 1) | _ => t
  weaken n t := match t with | .var m => .var (if m < n then m else m + 1) | _ => t
  var := .var
  lookup Γ n := Γ[n]?

structure Input where
  xs : List Nat
  key : Nat
deriving DecidableEq, Repr

/-- One step is one key probe (equality plus direction); not elapsed time or list traversal. -/
def linear (key : Nat) : List Nat → Bool × Nat
  | [] => (false, 0)
  | x :: xs =>
    if key = x then (true, 1)
    else let r := linear key xs; (r.1, r.2 + 1)

/-- Bounded binary search; fuel exhaustion is distinct from a negative membership answer. -/
def binary : Nat → List Nat → Nat → Option (Bool × Nat)
  | 0, _, _ => none
  | fuel + 1, xs, key =>
    if xs.isEmpty then some (false, 0)
    else
      let mid := xs.length / 2
      let x := xs.getD mid 0
      if key = x then some (true, 1)
      else
        let rest := if key < x then xs.take mid else xs.drop (mid + 1)
        (binary fuel rest key).map fun r => (r.1, r.2 + 1)

def run (i : Input) : Term → Option (Bool × Nat)
  | .binary => binary (i.xs.length + 1) i.xs i.key
  | .linear => some (linear i.key i.xs)
  | _ => none

def membership (i : Input) (t : Term) : Bool :=
  match run i t with
  | some r => r.1 == i.xs.contains i.key
  | none => false

def sortedToken : Token := ⟨20, 0⟩
def exclusionToken : Token := ⟨21, 0⟩

def input : Input := ⟨[0, 1, 2, 3, 4, 5, 6, 7], 7⟩
def world : World Input := ⟨fun t => t == sortedToken || t == exclusionToken, input⟩

/-- Admission allows the linear fallback. A separate boundary promises four probes for eight
elements (1 + log2 8); that promise must be reopened when the fallback takes eight. -/
def iface : Iface data Input :=
  { name := 0, ctx := [], ty := (), hyps := [], hyps_real := by simp,
    guard := membership, budget := 8, chooser := 1, acceptor := 2 }

def template : Template data Input :=
  { Γ := [], T := (), P := .hole 0, Ω := [iface], names := by decide }

def candidate (t : Term) (supports : List Token) : Candidate data :=
  { filling := t, supports := supports, blockers := [],
    cost := ((run input t).map Prod.snd).getD 9, by_ := 3, status := .suspended [] }

def boundary : Boundary data Input (Option Bool) :=
  { iface := iface, declares := Declaration.top,
    behavior := fun i t => (run i t).map Prod.fst, costBound := 4 }

def start : Closure data Input := fromScratch world template fun _ => []

def before : Except Refusal (World Input × Closure data Input) :=
  Session.run [.propose 0 (candidate .binary [sortedToken]),
    .propose 0 (candidate .linear []), .select 1 0 0] (world, start)

def after : Except Refusal (World Input × Closure data Input) :=
  before.bind fun st => Session.run [.edit (.withdraw sortedToken), .select 1 0 1] st

def observations : Except Refusal (World Input × Closure data Input) →
    Option (List (List Status) × Option Nat × Option Bool)
  | .error _ => none
  | .ok st => some (observe st.2, (st.2.slot 0).selected,
      (st.2.sigma 0).bind fun t => (run st.1.env t).map Prod.fst)

def boundaryReport : Option (List (Nat × Observation)) := do
  let old ← before.toOption
  let new ← after.toOption
  pure (boundary.obligations old.1 new.1 old.2 new.2)

/-- A successful answer with an empty support trace, beside an excluded alternative. -/
def prunedSession : Except Refusal (World Input × Closure data Input) :=
  Session.run [.propose 0 (candidate .linear []), .select 1 0 0,
    .propose 0 (candidate .binary []), .prune 1 0 1 exclusionToken] (world, start)

def pruningReport : Option (List Token × List (Nat × Nat) × List (List Status)) := do
  let st ← prunedSession.toOption
  let repaired := repair st.1 (.withdraw exclusionToken) st.2
  pure (st.2.support, repaired.2.2, observe repaired.1)

end BoundarySearch
end Nanodregg.Lang.Contextual
/- Boundary declarations: the lattice, reuse licenses, dependent types, and concrete sessions. -/
import Lang.Contextual.Boundary
import Lang.Proofs.Contextual.Judge

namespace Nanodregg.Lang.Contextual
-- Lean's finite default maxHeartbeats cap applies; no local budget override.

def Declaration.Le (a b : Declaration) : Prop := ∀ o, a o = true → b o = true

theorem Declaration.le_refl (a : Declaration) : a.Le a := fun _ h => h

theorem Declaration.le_trans {a b c : Declaration} (hab : a.Le b) (hbc : b.Le c) :
    a.Le c := fun o ho => hbc o (hab o ho)

theorem Declaration.le_antisymm {a b : Declaration} (hab : a.Le b) (hba : b.Le a) :
    a = b := by
  funext o
  cases ha : a o <;> cases hb : b o <;> simp_all [Declaration.Le]

theorem Declaration.meet_glb (a b c : Declaration) :
    c.Le (a.meet b) ↔ c.Le a ∧ c.Le b := by
  simp only [Declaration.Le, Declaration.meet, Bool.and_eq_true]
  constructor
  · intro h; exact ⟨fun o ho => (h o ho).1, fun o ho => (h o ho).2⟩
  · rintro ⟨ha, hb⟩ o ho; exact ⟨ha o ho, hb o ho⟩

theorem Declaration.join_lub (a b c : Declaration) :
    (a.join b).Le c ↔ a.Le c ∧ b.Le c := by
  simp only [Declaration.Le, Declaration.join, Bool.or_eq_true]
  constructor
  · intro h; exact ⟨fun o ho => h o (Or.inl ho), fun o ho => h o (Or.inr ho)⟩
  · rintro ⟨ha, hb⟩ o (ho | ho)
    · exact ha o ho
    · exact hb o ho

theorem Declaration.bounds (a : Declaration) :
    Declaration.bottom.Le a ∧ a.Le Declaration.top := by
  simp [Declaration.Le, Declaration.bottom, Declaration.top]

/-- Cost and behavior are incomparable declarations, not adjacent rungs of a chain. -/
theorem Declaration.cost_behavior_independent :
    ¬ Declaration.Le (fun o => decide (o = Observation.costGuarantee))
      (fun o => decide (o = Observation.observableBehavior)) ∧
    ¬ Declaration.Le (fun o => decide (o = Observation.observableBehavior))
      (fun o => decide (o = Observation.costGuarantee)) := by
  constructor
  · intro h; have := h .costGuarantee (by decide); contradiction
  · intro h; have := h .observableBehavior (by decide); contradiction

variable {D : CalculusData} {E V : Type}

/-- A declaration is a promise, not itself a proof that the promise was met. -/
def preserves (b : Boundary D E V) (o : Observation) : Prop := b.declares o = true

def Boundary.Reestablished (b : Boundary D E V) (w w' : World E)
    (c c' : Candidate D) : Prop :=
  ∀ o, preserves b o → b.read w c o = b.read w' c' o

theorem Boundary.failure_iff [DecidableEq V] (b : Boundary D E V)
    (w w' : World E) (c c' : Candidate D) (o : Observation) :
    o ∈ b.failures w w' c c' ↔
      preserves b o ∧ b.read w c o ≠ b.read w' c' o := by
  have ho : o ∈ Observation.all := by cases o <;> simp [Observation.all]
  simp [Boundary.failures, ho, preserves]

/-- Per-observation evidence remains usable even when some OTHER observation failed. -/
theorem Boundary.read_eq_of_not_failed [DecidableEq V] {b : Boundary D E V}
    {w w' : World E} {c c' : Candidate D} {o : Observation}
    (hd : preserves b o) (hn : o ∉ b.failures w w' c c') :
    b.read w c o = b.read w' c' o := by
  by_cases he : b.read w c o = b.read w' c' o
  · exact he
  · exact False.elim (hn ((b.failure_iff w w' c c' o).2 ⟨hd, he⟩))

/-- Exact coverage: an empty obligation list means every declared observation was preserved.
This is checked against the old reference; it cannot be made true by dropping the failed entry. -/
theorem Boundary.failures_nil_iff [DecidableEq V] (b : Boundary D E V)
    (w w' : World E) (c c' : Candidate D) :
    b.failures w w' c c' = [] ↔ b.Reestablished w w' c c' := by
  constructor
  · intro h o ho
    by_cases he : b.read w c o = b.read w' c' o
    · exact he
    · have := (b.failure_iff w w' c c' o).2 ⟨ho, he⟩
      rw [h] at this; cases this
  · intro h
    apply List.eq_nil_iff_forall_not_mem.2
    intro o ho
    obtain ⟨hd, hn⟩ := (b.failure_iff w w' c c' o).1 ho
    exact hn (h o hd)

/-- If a declaration is NOT re-established, a particular observation must travel beyond
the boundary. No disjunction with a vacuously true success arm. -/
theorem Boundary.failed_obligation [DecidableEq V] {b : Boundary D E V}
    {w w' : World E} {c c' : Candidate D} {cl cl' : Closure D E}
    (hsel : cl.selectedCand b.iface.name = some c)
    (hsel' : cl'.selectedCand b.iface.name = some c')
    {o : Observation} (hd : preserves b o)
    (hn : b.read w c o ≠ b.read w' c' o) :
    (b.iface.name, o) ∈ b.obligations w w' cl cl' := by
  simp only [Boundary.obligations, hsel, hsel']
  exact List.mem_map.2 ⟨o, (b.failure_iff w w' c c' o).2 ⟨hd, hn⟩, rfl⟩

/-- Declaring more observations cannot remove an already exposed failure. -/
theorem Boundary.failures_mono [DecidableEq V] (b : Boundary D E V)
    {a a' : Declaration} (hle : a.Le a') (w w' : World E) (c c' : Candidate D) :
    ∀ o ∈ ({ b with declares := a }).failures w w' c c',
      o ∈ ({ b with declares := a' }).failures w w' c c' := by
  intro o ho
  obtain ⟨hd, hn⟩ := (Boundary.failure_iff _ _ _ _ _ _).1 ho
  exact (Boundary.failure_iff _ _ _ _ _ _).2 ⟨hle o hd, hn⟩

/-- Typing reuse is the calculus's meta-substitution lemma on a client template,
not an equality of status labels. The client may inspect the hole only through its declaration. -/
theorem Boundary.reuse_client_typing [DecidableEq V]
    {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}
    (L : CalculusLaws D HasTy) {b : Boundary D E V} {w w' : World E}
    {c c' : Candidate D} (hr : .typingInterface ∉ b.failures w w' c c')
    (hd : preserves b .typingInterface)
    (hold : HasTy [] b.iface.ctx c.filling b.iface.ty)
    {Γ : D.Ctx} {P : D.Tm} {T : D.Ty}
    (client : HasTy [b.iface.decl] Γ P T) :
    HasTy [] Γ
      (D.msubst (fun u => if u = b.iface.name then some c'.filling else none) P) T := by
  have hc : HasTy [] b.iface.ctx c'.filling b.iface.ty :=
    L.check_sound ((Boundary.read_eq_of_not_failed hd hr).symm.trans (L.check_complete hold))
  have h := L.msubst_lemma
    (fun u => if u = b.iface.name then some c'.filling else none) client
    (by
      intro d hd M hM
      simp only [List.mem_singleton] at hd
      subst d
      simp only [Iface.decl, if_true, Option.some.injEq] at hM
      subst M
      exact hc)
  simpa [Iface.decl] using h

/-- A client's proof depending solely on the declared Boolean contract can be carried.
The old contract must actually hold; preserving two failures establishes nothing. -/
theorem Boundary.reuse_client_contract [DecidableEq V] {b : Boundary D E V} {w w' : World E}
    {c c' : Candidate D} (hr : .logicalContract ∉ b.failures w w' c c')
    (hd : preserves b .logicalContract) (hold : b.iface.guard w.env c.filling = true)
    {Q : E → D.Tm → Prop}
    (client : ∀ env term, b.iface.guard env term = true → Q env term) :
    Q w'.env c'.filling := by
  exact client _ _ ((Boundary.read_eq_of_not_failed hd hr).symm.trans hold)

/-- Every downstream observation factoring through the declared behavior has the same cache
key/result, including non-Boolean observations. -/
theorem Boundary.reuse_cached_observation [DecidableEq V] {b : Boundary D E V} {w w' : World E}
    {c c' : Candidate D} (hr : .observableBehavior ∉ b.failures w w' c c')
    (hd : preserves b .observableBehavior) {R : Type} (client : V → R) :
    client (b.behavior w.env c.filling) = client (b.behavior w'.env c'.filling) :=
  congrArg client (Boundary.read_eq_of_not_failed hd hr)

/-- A scheduler's overhead can be composed with the promised cost bound. This uses the
candidate's cost field; an instance must connect that field to its cost semantics. -/
theorem Boundary.reuse_cost_bound [DecidableEq V] {b : Boundary D E V} {w w' : World E}
    {c c' : Candidate D} (hr : .costGuarantee ∉ b.failures w w' c c')
    (hd : preserves b .costGuarantee) (hold : c.cost ≤ b.costBound) (overhead : Nat) :
    c'.cost + overhead ≤ b.costBound + overhead := by
  have h : decide (c'.cost ≤ b.costBound) = true :=
    (Boundary.read_eq_of_not_failed hd hr).symm.trans (decide_eq_true hold)
  exact Nat.add_le_add_right (of_decide_eq_true h) overhead

/-- Same carrier type (Nat) is insufficient: changing 1 to 0 destroys a dependent Fin fiber. -/
theorem dependent_inhabitants_change_types :
    Nonempty (Fin 1) ∧ ¬ Nonempty (Fin 0) := by
  exact ⟨⟨⟨0, by decide⟩⟩, fun ⟨i⟩ => Nat.not_lt_zero i.val i.isLt⟩

/-- Thus there is no generic local replacement of dependent data from the inhabitant's
carrier type alone. -/
theorem no_unconditional_dependent_reuse :
    ¬ (∀ n m : Nat, Nonempty (Fin n) → Nonempty (Fin m)) := by
  intro h
  exact dependent_inhabitants_change_types.2
    (h 1 0 dependent_inhabitants_change_types.1)

/-- Abstraction gives the needed transport: a dependent client's type mentions only the
preserved behavior. Equality of that behavior transports its inhabitant. -/
theorem Boundary.reuse_abstract_dependent_client [DecidableEq V] {b : Boundary D E V} {w w' : World E}
    {c c' : Candidate D} (hr : .observableBehavior ∉ b.failures w w' c c')
    (hd : preserves b .observableBehavior) (F : V → Type)
    (old : Nonempty (F (b.behavior w.env c.filling))) :
    Nonempty (F (b.behavior w'.env c'.filling)) := by
  have he : b.behavior w.env c.filling = b.behavior w'.env c'.filling :=
    Boundary.read_eq_of_not_failed hd hr
  rw [← he]
  exact old

/-- An entire retained region reopens when its sole exclusion argument is withdrawn.
The region is explicit and finite; no successful answer's trace appears in the premises. -/
theorem pruning_explanation_reopens_region {I : Iface D E} {w : World E} {t : Token}
    (region : List (Candidate D)) (hlive : w.live t = true)
    (hregion : ∀ c ∈ region,
      D.check I.ctx c.filling I.ty = true ∧ I.guard w.env c.filling = true ∧
      c.blockers = [t] ∧ (∀ s ∈ effSupports I c, w.live s = true ∧ s ≠ t) ∧
      c.cost ≤ I.budget) :
    ∀ c ∈ region, judge I w c = .pruned [t] ∧
      judge I ((Edit.withdraw t).apply w) c = .verified := by
  intro c hc
  obtain ⟨ht, hg, hb, hs, hcost⟩ := hregion c hc
  refine ⟨by simp [judge, ht, hg, hb, hlive], judge_verified_iff.2 ?_⟩
  refine ⟨ht, hg, ?_, ?_, hcost⟩
  · intro s hmem
    rw [hb] at hmem
    simp only [List.mem_singleton] at hmem
    subst s
    simp [Edit.apply, World.set]
  · intro s hmem
    obtain ⟨hl, hne⟩ := hs s hmem
    simp [Edit.apply, World.set, hne, hl]

namespace BoundarySearch

/-- These costs are computed by the search algorithms, not manually labelled candidates. -/
theorem search_probe_measurement :
    run input .binary = some (true, 3) ∧ run input .linear = some (true, 8) := by decide

/-- Withdrawal opens binary's sortedness obligation; linear is selected through the existing
chooser operation, preserving membership. Both candidate statuses and the selection compute. -/
theorem binary_to_linear_session :
    observations before = some ([[.verified, .verified]], some 0, some true) ∧
    observations after = some ([[.suspended [sortedToken], .verified]], some 1, some true) := by
  decide

/-- Membership and behavior survive; the four-probe logarithmic promise is the EXACT propagated
obligation, despite the fallback remaining admissible under the original eight-probe budget. -/
theorem binary_to_linear_boundary :
    boundaryReport = some [(0, .costGuarantee)] := by decide

/-- All queries in this concrete domain exercise positive and negative membership answers. -/
theorem search_membership_domain :
    (List.range 10).all (fun key =>
      membership ⟨input.xs, key⟩ .binary && membership ⟨input.xs, key⟩ .linear) = true := by
  decide

/-- Removing sortedness is not evidence of unsortedness. But actually changing the input to an
unsorted one demonstrates why binary's precondition cannot be erased. -/
theorem unsorted_binary_tooth :
    membership ⟨[2, 0, 1], 2⟩ .binary = false ∧
    membership ⟨[2, 0, 1], 2⟩ .linear = true := by decide

/-- The selected answer has no token dependencies. Nonetheless withdrawing the exclusion
reason re-judges exactly the alternative and reopens it. -/
theorem pruning_beyond_selected_trace :
    pruningReport = some ([], [(0, 1)], [[.verified, .verified]]) := by decide

/-- Every observation check is live: an unbound variable is ill typed, fails the contract,
has no behavior, and exceeds the declared bound through the failed-run cost. -/
theorem all_observation_checks_exercised :
    boundary.failures world world (candidate .binary [sortedToken]) (candidate (.var 0) []) =
      [.typingInterface, .logicalContract, .observableBehavior, .costGuarantee] := by decide

/-- Missing selections are not a vacuous success, even when both sides are missing. -/
theorem unfilled_boundary_obligations :
    boundary.obligations world world start start =
      [(0, .typingInterface), (0, .logicalContract), (0, .observableBehavior), (0, .costGuarantee)] := by
  decide

/-- The general cache-reuse license applies to this swap despite its reported cost failure. -/
theorem membership_clients_survive_cost_failure {R : Type} (client : Option Bool → R) :
    client (boundary.behavior world.env (candidate .binary [sortedToken]).filling) =
      client (boundary.behavior ((Edit.withdraw sortedToken).apply world).env
        (candidate .linear []).filling) :=
  Boundary.reuse_cached_observation (b := boundary) (w := world)
    (w' := (Edit.withdraw sortedToken).apply world)
    (c := candidate .binary [sortedToken]) (c' := candidate .linear [])
    (by decide) (by rfl) client

end BoundarySearch
end Nanodregg.Lang.Contextual
"""gates/check.py TREE [--base-waste F] [--message F] [--changed F]
[--base-tree DIR] — every source gate, one line each, exit 1 if any is red. The build and the census are scripts/pre-push's."""
import argparse
import os
import re
import sys

import closure
import owners
import rebase
import refusals
import runs
import size
import tcb
import tree
import vectors
import waste

ap = argparse.ArgumentParser()
ap.add_argument("root")
ap.add_argument("--base-waste")
ap.add_argument("--base-tree", help="the parent tree: size rises are measured against it, and a\n                closure/refusal red the parent already had is reported as PRE-EXISTING, not red")
ap.add_argument("--message")
ap.add_argument("--owners-from", help="tree whose gates/OWNERS judges ownership (the parent)")
ap.add_argument("--changed", help="file listing the paths the commit changes (enables the owners gate)")
a, _unknown = ap.parse_known_args()  # a parent's check.py must accept a child's new flags
t = tree.read(a.root)
msg = open(a.message, encoding="utf-8").read() if a.message else ""


def has_lakefile(d):
    return any(os.path.exists(os.path.join(d, f)) for f in ("lakefile.lean", "lakefile.toml"))


def read(p):
    return open(p, encoding="utf-8").read() if p and os.path.exists(p) else None


changed = open(a.changed, encoding="utf-8").read().split() if a.changed else None


MARKER = re.compile(r"^(<{7}|>{7})(?: |$)")


def conflict_markers(root: str) -> list[str]:
    """A merge-conflict marker line (`<<<<<<< ours`, `>>>>>>> theirs`) in any file of the judged
    tree: an unresolved merge that a lane's own `git apply --3way` or `checkout -m` left in a file it
    then committed whole (4c327a7, 10-17, two decisions appended to decisions/host.md). The `=======`
    middle line is not matched: it is also a Markdown heading underline."""
    red = []
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            path = os.path.join(d, f)
            try:
                with open(path, encoding="utf-8") as fh:
                    for n, line in enumerate(fh, 1):
                        if MARKER.match(line):
                            red.append(f"{os.path.relpath(path, root)}:{n}: conflict marker {line.rstrip()[:40]!r}")
            except (UnicodeDecodeError, OSError):
                continue  # not text
    return red


def case_collisions(root: str) -> list[str]:
    """Two paths (files or directories) that differ only in case are ONE path on a case-insensitive
    disk (the Mac reader's APFS): `ops/RUNBOOK.md` silently became `Ops/RUNBOOK.md` inside the
    Lean library on 10-17 (OPS). Red by name."""
    seen: dict[str, set[str]] = {}
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        rel = os.path.relpath(d, root)
        for x in dirs + files:
            path = os.path.normpath(os.path.join(rel, x))
            seen.setdefault(path.lower(), set()).add(path)
    return [f"{' and '.join(sorted(v))} differ only in case: one path on a case-insensitive disk"
            for v in seen.values() if len(v) > 1]


results = {
    "closure": closure.check(t),
    "refusals": refusals.check(t),
    "size": size.check(t, msg, tree.read(a.base_tree) if a.base_tree and has_lakefile(a.base_tree) else None),
    "paths": case_collisions(t.root) + conflict_markers(t.root),
    "runs": runs.check(t),
    "rebase": rebase.check(t.root),
    "tcb": tcb.check(t.root),
    "vectors": vectors.check(t.root, a.base_tree if a.base_tree and has_lakefile(a.base_tree) else None),
    "waste": waste.check(read(os.path.join(t.root, "gates", "waste.tsv")) or "", read(a.base_waste), msg),
}
if changed is not None:
    src = a.owners_from if a.owners_from and os.path.exists(os.path.join(a.owners_from, "gates", "OWNERS")) else t.root
    results["owners"] = owners.check(src, changed, msg)
# Targets: a lib or exe the parent's lakefile declared and the candidate's does not is red by
# name, unless the message says `LAKE-DROP: <name>: <why>` (the toml -> lean switch must carry
# every target across).
if a.base_tree and has_lakefile(a.base_tree):
    bl = tree.lakefile(a.base_tree)
    before = {x["name"] for k in ("lean_lib", "lean_exe") for x in bl[k]}
    after = {x["name"] for k in ("lean_lib", "lean_exe") for x in t.lake[k]}
    results["targets"] = [f"lakefile dropped target {n}; needs 'LAKE-DROP: {n}: <why>'"
                          for n in sorted(before - after)
                          if not re.search(r"(?m)^LAKE-DROP:\s*" + re.escape(n) + r"\s*:\s*\S", msg)]
# A commit is refused for the reds it introduces. Reds its parent already had are printed (they
# are some layer's to fix forward, and scripts/standing.sh counts every one) but do not block an
# unrelated commit: otherwise one layer's red stops all six.
old = set()
if a.base_tree and has_lakefile(a.base_tree):
    bt = tree.read(a.base_tree)
    old = {re.sub(r":\d+", ":", r) for r in closure.check(bt) + refusals.check(bt)}
red = False
for gate, reds in results.items():
    new = []
    for r in reds:
        if gate in ("closure", "refusals") and re.sub(r":\d+", ":", r) in old:
            print(f"  {gate}: PRE-EXISTING {r}")
        else:
            print(f"  {gate}: {r}")
            new.append(r)
    print(f"{gate}: {'RED' if new else 'ok'}")
    red |= bool(new)
for w in size.WARN:
    print(f"WARN {w}")
sys.exit(1 if red else 0)
/-
# nanodregg — the one build (owner: BUILD-GATES; every layer adds its own `lean_lib`).

The file is a table, not a program: gates/tree.py reads it with a strict grammar and refuses any
top-level form it does not know (closure C0). The forms are
  * `package nanodregg where leanOptions := …` — warnings are errors, no auto-bound implicits;
  * `@[default_target] lean_lib X where globs := #[.submodules `X]` — one per layer directory,
    every file in X/ built, no umbrella module, no orphan (C1);
  * `@[default_target] lean_exe «name» where root := `M` — M holds only `main` (C7);
  * `extern_lib «ndhost»` — every Host/c/*.c, cc -Wall -Wextra -Werror, into libndhost.a. The only
    C in the tree; built from source, never a prebuilt object (ROOT ruling 2026-10-16).
No packages: Lean core and Std only (decisions/gates.md GATES-1). A bare `lake build` builds
every target, so it can never succeed by building nothing.
-/
import Lake
open Lake DSL System

package nanodregg where
  leanOptions := #[⟨`autoImplicit, false⟩, ⟨`relaxedAutoImplicit, false⟩, ⟨`warningAsError, true⟩]

-- The axiom census command (Census.Axioms): build tooling, the only place `import Lean` is
-- allowed; nothing outside Census may import it (gates/closure.py C2, C5).
@[default_target] lean_lib Census where
  globs := #[.submodules `Census]

@[default_target] lean_lib Kernel where
  globs := #[.submodules `Kernel]

@[default_target] lean_lib Protocol where
  globs := #[.submodules `Protocol]

@[default_target] lean_lib Host where
  globs := #[.submodules `Host]

@[default_target] lean_lib Lang where
  globs := #[.submodules `Lang]

@[default_target] lean_lib Codec where
  globs := #[.submodules `Codec]

@[default_target] lean_lib Hosting where
  globs := #[.submodules `Hosting]

-- LEDGER: packages over the ledger receivers (the escrow), their proofs and their journey.
@[default_target] lean_lib Ledger where
  globs := #[.submodules `Ledger]

-- HOSTING's grain lifecycle through KERNEL's receivers, with its plants (standing's sim stage).
@[default_target] lean_exe «hosting-sim» where
  root := `Hosting.Sim.Main

-- HOSTING's controller: follows one Store (Host.Tail), writes Hosting.Wire actions to grain-launch.
@[default_target] lean_exe «hosting-controller» where
  root := `Hosting.Main

-- One Lean-planned launch for launcher/tests/isolation.rs (a stand-in controller without a Store).
@[default_target] lean_exe «hosting-drive» where
  root := `Hosting.DriveMain

-- HOSTING's provider-key broker decider: keybroker's child, every ask decided by Hosting.Broker.
@[default_target] lean_exe «hosting-broker» where
  root := `Hosting.BrokerMain

-- nd-members' decider (HOSTING-33): the World's resident grains, nothing else (no clock, no key slots).
@[default_target] lean_exe «hosting-residents» where
  root := `Hosting.ResidentsMain

-- THE BAR's hosted Hermes (HOSTING-27): a resident grain's program; answers its bell through its
-- member socket with what keybroker answers on its broker socket.
@[default_target] lean_exe «resident» where
  root := `Hosting.Resident.Main


-- The Rust copy of the protocol table (client/src/generated.rs). Imports Protocol; nothing imports it.
@[default_target] lean_lib Emit where
  globs := #[.submodules `Emit]

@[default_target] lean_exe «emit-rust» where
  root := `Emit.Main



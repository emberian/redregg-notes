/-- The typed repair outcomes for one hole. The proposal's four are `replacement`, `strengthening`,
`alternative`, `suspended`; `kept` (the selected candidate stands, nothing to repair) is the fifth
case a total repair function needs. -/
inductive Outcome (D : CalculusData) where
  | kept (u : Nat)
  /-- `σ' = σ[u ↦ M]`: a verified candidate `j` with a DIFFERENT filling, offered to the chooser -/
  | replacement (u j : Nat) (M : D.Tm)
  /-- hypothesis `x` left the hole's context; the selected filling factors as `t₀[π]` -/
  | strengthening (u x : Nat) (t₀ : D.Tm)
  /-- the same filling through another derivation `j`: `σ` unchanged, `D` changed (applied) -/
  | alternative (u j : Nat)
  | suspended (u : Nat) (Φ : List Obligation)

inductive Refusal where
  | unknownHole
  | notChooser
  | notAcceptor
  | noCandidate
  | notVerified (s : Status)
  | accepted
  | notSelected
/- Guarded contextual closure: Stability. Moved without statement changes from Closure. -/
import Lang.Proofs.Contextual.Judge

namespace Nanodregg.Lang.Contextual

variable {D : CalculusData} {E : Type}
  {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}


/-! ## Stability class -/

/-- **A guard is a value guard iff its verdict is invariant under every value-preserving
replacement of the filling.** -/
theorem valueGuard_iff {V : Type} (value : D.Tm → V) (g : E → D.Tm → Bool) :
    ValueGuard value g ↔ ∀ e t t', value t = value t' → g e t = g e t' := by
  constructor
  · rintro ⟨g', hg⟩ e t t' hv
    rw [hg, hg, hv]
  · intro h
    refine ⟨fun e v => @dite _ (∃ t, value t = v) (Classical.propDecidable _)
      (fun hv => g e (Classical.choose hv)) (fun _ => false), ?_⟩
    intro e t
    have hex : ∃ t', value t' = value t := ⟨t, rfl⟩
    simp only [dif_pos hex]
    exact h e t _ (Classical.choose_spec hex).symm

/-- **Stability class** (Hu–Pientka–Schöpp: which substitutions is a result stable under). A
value guard's verdict is stable under every term map that preserves the value. -/
theorem stability_class {V : Type} (value : D.Tm → V) {g : E → D.Tm → Bool}
    (hg : ValueGuard value g) {s : D.Tm → D.Tm} (hs : ∀ t, value (s t) = value t) :
    StableUnder g s :=
  fun e t => (valueGuard_iff value g).1 hg e (s t) t (hs t)

/-- A value guard's hole judges a filling and its value-preserving image alike, provided the
checker and supports agree (the guard is the only place the filling's VALUE is read). -/
theorem judge_stable {V : Type} (value : D.Tm → V) {I : Iface D E} (hg : ValueGuard value I.guard)
    {w : World E} {c c' : Candidate D} (hv : value c'.filling = value c.filling)
    (hchk : D.check I.ctx c'.filling I.ty = D.check I.ctx c.filling I.ty)
    (hb : c'.blockers = c.blockers) (hsup : effSupports I c' = effSupports I c)
    (hcost : c'.cost = c.cost) : judge I w c' = judge I w c := by
  have hgd : I.guard w.env c'.filling = I.guard w.env c.filling :=
    (valueGuard_iff value I.guard).1 hg _ _ _ hv
  unfold judge
  rw [hchk, hgd, hb, hsup, hcost]

/-! ## Grounding: least fixpoint -/

theorem lfpIter_sound {R : List Rule} {F : Nat → Bool} :
    ∀ (n x : Nat), lfpIter R F n x = true → Derives R F x
  | 0, x, h => .fact h
  | n + 1, x, h => by
    simp only [lfpIter, Bool.or_eq_true, List.any_eq_true, Bool.and_eq_true, beq_iff_eq,
      List.all_eq_true] at h
    rcases h with h | ⟨r, hr, hx, hb⟩
    · exact lfpIter_sound n x h
    · subst hx
      exact .rule hr fun y hy => lfpIter_sound n y (hb y hy)

/-- **Grounding is well-founded.** With no live fact and every rule needing a premise, nothing is
derivable, however the rules cycle. -/
theorem no_facts_no_derivation {R : List Rule} {F : Nat → Bool} (hF : ∀ x, F x = false)
    (hR : ∀ r ∈ R, r.body ≠ []) {x : Nat} : ¬ Derives R F x := by
  intro h
  induction h with
  | fact hx => rw [hF] at hx; cases hx
  | @rule r hr _ ih =>
    obtain ⟨y, hy⟩ := List.exists_mem_of_ne_nil _ (hR r hr)
    exact ih y hy

/-! ## Grounding: unfounded sets -/

/-- AVAILABILITY: every support of every selected candidate is live in `w`. -/
def Available (w : World E) (cl : Closure D E) : Prop :=
  ∀ I ∈ cl.tpl.Ω, ∀ c, cl.selectedCand I.name = some c → ∀ t ∈ effSupports I c, w.live t = true

/-- The recorded statuses are the judgment at `w`. -/
def Coherent (w : World E) (cl : Closure D E) : Prop :=
  ∀ I ∈ cl.tpl.Ω, ∀ c ∈ (cl.slot I.name).cands, c.status = judge I w c

/-- The guard is a function of the filling's VALUE only. -/
def ValueGuard {V : Type} (value : D.Tm → V) (g : E → D.Tm → Bool) : Prop :=
  ∃ g' : E → V → Bool, ∀ e t, g e t = g' e (value t)

/-- The guard's verdict is stable under the term map `s`. -/
def StableUnder (g : E → D.Tm → Bool) (s : D.Tm → D.Tm) : Prop :=
  ∀ e t, g e (s t) = g e t

/-- Least-fixpoint grounding: an atom holds iff a well-founded derivation from live facts exists. -/

/-- Preference really minimizes the policy's cost over all eligible, currently verified
candidates. Admissibility remains independent of this ordering. -/
theorem choose_minimal (policy : Policy D) (I : Iface D E) (w : World E) :
    ∀ (cs : List (Candidate D)) (n : Nat) {c : Candidate D} {i : Nat},
      choose policy I w cs n = some (c, i) →
      ∀ d ∈ cs, policy.eligible d = true → judge I w d = .verified →
        policy.cost c ≤ policy.cost d
  | [], _, _, _, h => by simp [choose] at h
  | a :: as, n, c, i, h => by
    unfold choose at h
    dsimp only at h
    split at h
    · split at h
      · rename_i hn
        cases h
        intro d hd he hv
        rcases List.mem_cons.1 hd with rfl | hd
        · exact Nat.le_refl _
        · exact False.elim (choose_none policy I w as (n + 1) hn d hd he hv)
      · rename_i b j hb
        split at h
        · rename_i hab
          cases h
          intro d hd he hv
          rcases List.mem_cons.1 hd with rfl | hd
          · exact Nat.le_refl _
          · exact Nat.le_trans hab (choose_minimal policy I w as (n + 1) hb d hd he hv)
        · rename_i hab
          cases h
          intro d hd he hv
          rcases List.mem_cons.1 hd with rfl | hd
          · omega
          · exact choose_minimal policy I w as (n + 1) hb d hd he hv
    · rename_i ha
      intro d hd he hv
      rcases List.mem_cons.1 hd with rfl | hd
      · simp [he, hv, isVerified] at ha
      · exact choose_minimal policy I w as (n + 1) h d hd he hv

/-- Conditional soundness remains its own result, over a repaired candidate rather than
over the definition of the observation used for repair correctness. -/
theorem conditional_soundness {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}
    (laws : CalculusLaws D HasTy) {w v : World E} {e : Change E w v} {r : Repair D e}
    (hr : r.Sound) (st : State D w) (hc : Coherent w st.closure)
    {I : Iface D E} (hI : I ∈ (r.run st).state.closure.tpl.Ω)
    {c : Candidate D} (hcm : c ∈ ((r.run st).state.closure.slot I.name).cands)
    (hv : c.status = .verified) :
    HasTy [] I.ctx c.filling I.ty ∧ I.guard v.env c.filling = true ∧
      (∀ b ∈ c.blockers, v.live b = false) ∧
      (∀ t ∈ effSupports I c, v.live t = true) ∧ c.cost ≤ I.budget :=
  Nanodregg.Lang.Contextual.conditional_soundness laws (hr.coherent st hc) hI hcm hv

/-- Adding transport offers keeps the repair's state semantics. Admission of each offer
is separately covered by transport_sound and the registry's checked-equivalence law. -/
theorem withTransport_sound {w v : World E} {e : Change E w v} {r : Repair D e}
    (hr : r.Sound) (registry : Registry D E) (n : Nat) (c : Candidate D) (cost : Nat) :
    (r.withTransport registry n c cost).Sound := by
  constructor
  · intro st hc
    unfold Repair.withTransport
    dsimp only
    split <;> exact hr.coherent st hc
  · intro st z
    unfold Repair.withTransport
    dsimp only
    split <;> exact hr.problem st z


/-- The selected retained index satisfies the policy and is cheapest among the candidates
which satisfy that policy and the independent current-world judgment. -/
theorem select_preference {policy : Policy D} {w : World E} {p u i : Nat}
    {cl cl' : Closure D E} (h : select policy w p u cl = .ok (cl', i)) :
    ∃ I c, cl.find u = some I ∧ (cl.slot u).cands[i]? = some c ∧
      policy.eligible c = true ∧
      ∀ d ∈ (cl.slot u).cands, policy.eligible d = true → judge I w d = .verified →
        policy.cost c ≤ policy.cost d := by
  unfold select at h
  split at h
  · cases h
  · rename_i I hI
    split at h
    · cases h
    · rename_i c j hj
      split at h
      · cases h
      · cases h
        have hg := (choose_index policy I w _ 0 hj).2
        exact ⟨I, c, hI, by simpa using hg, (choose_sound policy I w _ 0 hj).2.1,
          choose_minimal policy I w _ 0 hj⟩

#!/usr/bin/env bash
# swarm-build — run a build under an ENFORCED memory cap + CPU pinning + KILLABLE.
# Two RAM-protection layers:
#   * per-build cap  (SWARM_MEM_MAX, default 96G) — bounds a single build.
#   * shared box cap (swarm.slice MemoryMax, set by the drop-in at
#     ~/.config/systemd/user/swarm.slice.d/50-memcap.conf) — bounds the SUM of
#     ALL concurrent swarm-build invocations, because every scope nests under
#     one swarm.slice. Without it, N parallel builds (multi-agent) each get an
#     INDEPENDENT cap and their box-level total is unbounded: that summing is
#     the mechanism behind the box-level RAM runaway (many ~6G builds summing,
#     misread as one process). The shared slice makes total box exposure
#     <= the slice cap no matter how many builds run at once.
# Advisory taskset caps CPU only; the cgroup caps RAM so a runaway compile
# cannot starve the box into unreachability.
#   usage: swarm-build lake build Foo   |   SWARM_MEM_MAX=48G swarm-build Holmake -j 8
set -euo pipefail
if [ -n "${SWARM_BUILD_INNER:-}" ]; then
  # CRITICAL: make the build explicitly KILLABLE. A -1000 inherited from a parent
  # (e.g. an sshd with OOMScoreAdjust set) makes the cgroup cap UNENFORCEABLE —
  # the kernel reports "no killable processes" and wedges the whole box. Learned
  # the hard way 2026-07-15: that exact interaction hard-downed hbox.
  echo 0 > /proc/self/oom_score_adj 2>/dev/null || true
  exec taskset -c 0-15 nice -n 15 "$@"
fi
export SWARM_BUILD_INNER=1
exec systemd-run --user --scope --slice=swarm.slice --quiet \
  -p MemoryMax="${SWARM_MEM_MAX:-96G}" -p MemorySwapMax=0 -p CPUWeight=50 \
  -- "$0" "$@"


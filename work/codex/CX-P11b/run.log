import json
files=json.loads(\"{\\\"Lang/Contextual/RepairChanges.lean\\\":\\\"/- Repair observations as change structures, Cai et al. (2013), Defs 2.1–2.4 p2.\\\\nThe full residual history is deliberately not quotiented by final observation. -/\\\\nimport Lang.Contextual.RepairObjects\\\\n\\\\nnamespace Nanodregg.Lang.Contextual.RepairChanges\\\\n\\\\n/-- Change-structure data; the update/difference law lives in Proofs (Cai et al. Def 2.1 p2). -/\\\\nstructure ChangeData (A : Type) where\\\\n  Delta : A → Type\\\\n  update : (a : A) → Delta a → A\\\\n  difference : (new old : A) → Delta old\\\\n\\\\n/-- Nil is the self-difference (Cai et al. Def 2.2 p2). -/\\\\ndef ChangeData.nil {A : Type} (C : ChangeData A) (a : A) : C.Delta a :=\\\\n  C.difference a a\\\\n\\\\n/-- Replacement changes with an explicit nil, lawful for arbitrary decidable observations.\\\\nChanges need not have a unique representation (Cai et al. p2). -/\\\\ndef replacement (A : Type) [DecidableEq A] : ChangeData A where\\\\n  Delta _ := Option A\\\\n  update a d := d.getD a\\\\n  difference new old := if new = old then none else some new\\\\n\\\\n/-- Compose replacement changes; the later non-nil change wins (Cai et al. p2). -/\\\\ndef compose {A : Type} (first second : Option A) : Option A :=\\\\n  match second with | none => first | some a => some a\\\\n\\\\n/-- The observed derivative is computed by the actual repair interpreter; from-scratch\\\\nconsistency proves its derivative law (Cai et al. Def 2.4 p2). -/\\\\ndef derivative {D : CalculusData} {E : Type} {w v : World E}\\\\n    {e : RepairObjects.Change E w v} (r : RepairObjects.Repair D e)\\\\n    (s : RepairObjects.State D w) : Option (List (List Status)) :=\\\\n  (replacement _).difference (observe (r.run s).state.closure) (observe s.closure)\\\\n\\\\nend Nanodregg.Lang.Contextual.RepairChanges\\\\n\\\",\\\"Lang/Proofs/Contextual/RepairChanges.lean\\\":\\\"import Lang.Contextual.RepairChanges\\\\nimport Lang.Proofs.Contextual.RepairObjects\\\\n\\\\nnamespace Nanodregg.Lang.Contextual.RepairChanges\\\\n\\\\n/-- Update after difference recovers the new value (Cai et al. Def 2.1(e) p2). -/\\\\nstructure Laws {A : Type} (C : ChangeData A) : Prop where\\\\n  update_difference : ∀ new old, C.update old (C.difference new old) = new\\\\n\\\\n/-- The replacement representation satisfies the change-structure law\\\\n(Cai et al. Def 2.1 p2); no invertibility of changes is claimed. -/\\\\ntheorem replacement_laws (A : Type) [DecidableEq A] : Laws (replacement A) := by\\\\n  constructor\\\\n  intro new old\\\\n  by_cases h : new = old <;> simp [replacement, h]\\\\n\\\\n/-- Nil changes keep values, derived from the difference law (Cai et al. Lemma 2.3 p2). -/\\\\ntheorem nil_kept {A : Type} {C : ChangeData A} (h : Laws C) (a : A) :\\\\n    C.update a (C.nil a) = a := h.update_difference a a\\\\n\\\\n/-- Sequential changes agree with composed changes (Cai et al. pp2–3). -/\\\\ntheorem update_compose {A : Type} [DecidableEq A] (a : A) (d e : Option A) :\\\\n    (replacement A).update a (compose d e) =\\\\n      (replacement A).update ((replacement A).update a d) e := by\\\\n  cases e <;> rfl\\\\n\\\\n/-- Associativity includes nil (Cai et al. pp2–3, replacement instance). -/\\\\ntheorem compose_assoc {A : Type} (a b c : Option A) :\\\\n    compose (compose a b) c = compose a (compose b c) := by\\\\n  cases c <;> rfl\\\\n\\\\n/-- The actual first-class identity repair keeps its entire state and emits no inspections\\\\nor residuals; this is the nil/kept case, not a recheck (Cai et al. Lemma 2.3 p2). -/\\\\ntheorem identity_kept {D : CalculusData} {E : Type} {w : World E}\\\\n    (s : RepairObjects.State D w) :\\\\n    (RepairObjects.Repair.identity w).run s = ⟨s, [], [], []⟩ := rfl\\\\n\\\\n/-- Identity repair has a nil observed derivative (Cai et al. Def 2.2 p2). -/\\\\ntheorem identity_derivative {D : CalculusData} {E : Type} {w : World E}\\\\n    (s : RepairObjects.State D w) :\\\\n    derivative (RepairObjects.Repair.identity w) s = none := by\\\\n  simp [derivative, RepairObjects.Repair.identity, replacement]\\\\n\\\\n/-- From-scratch consistency supplies the derivative equation for actual Repair values,\\\\nrather than assuming the desired equation as a law (Cai et al. Def 2.4 p2). -/\\\\ntheorem repair_derivative {D : CalculusData} {E : Type} {w v : World E}\\\\n    {e : RepairObjects.Change E w v} {r : RepairObjects.Repair D e}\\\\n    (hr : r.Sound) (s : RepairObjects.State D w) (hc : Coherent w s.closure) :\\\\n    (replacement _).update (observe s.closure) (derivative r s) =\\\\n      RepairObjects.analyze v s.closure := by\\\\n  unfold derivative\\\\n  rw [(replacement_laws _).update_difference]\\\\n  exact RepairObjects.repair_correctness hr s hc\\\\n\\\\n/-- Composition preserves the same derivative law for the original retained problem\\\\n(Cai et al. Lemma 2.8 p3). No landed compose_sound premise changes. -/\\\\ntheorem composed_derivative {D : CalculusData} {E : Type} {w v z : World E}\\\\n    {e : RepairObjects.Change E w v} {f : RepairObjects.Change E v z}\\\\n    {r : RepairObjects.Repair D e} {s : RepairObjects.Repair D f}\\\\n    (hr : r.Sound) (hs : s.Sound) (st : RepairObjects.State D w)\\\\n    (hc : Coherent w st.closure) :\\\\n    (replacement _).update (observe st.closure) (derivative (r.compose s) st) =\\\\n      RepairObjects.analyze z st.closure :=\\\\n  repair_derivative (RepairObjects.compose_sound hr hs) st hc\\\\n\\\\n/-- Repair composition is associative INCLUDING residuals, inspected candidates and refusals,\\\\nnot just final observations (Cai et al. pp2–3, path action instance). -/\\\\ntheorem repair_compose_assoc {D : CalculusData} {E : Type} {w v z q : World E}\\\\n    {e : RepairObjects.Change E w v} {f : RepairObjects.Change E v z}\\\\n    {g : RepairObjects.Change E z q}\\\\n    (r : RepairObjects.Repair D e) (s : RepairObjects.Repair D f)\\\\n    (t : RepairObjects.Repair D g) (st : RepairObjects.State D w) :\\\\n    ((r.compose s).compose t).run st = (r.compose (s.compose t)).run st := by\\\\n  simp [RepairObjects.Repair.compose, List.append_assoc]\\\\n\\\\n/-- Both identity sides preserve complete result records (Cai et al. Lemma 2.3 p2). -/\\\\ntheorem repair_identity_sides {D : CalculusData} {E : Type} {w v : World E}\\\\n    {e : RepairObjects.Change E w v} (r : RepairObjects.Repair D e)\\\\n    (st : RepairObjects.State D w) :\\\\n    ((RepairObjects.Repair.identity w).compose r).run st = r.run st ∧\\\\n      (r.compose (RepairObjects.Repair.identity v)).run st = r.run st := by\\\\n  simp [RepairObjects.Repair.compose, RepairObjects.Repair.identity]\\\\n\\\\nend Nanodregg.Lang.Contextual.RepairChanges\\\\n\\\",\\\"Lang/Contextual/TransportKinds.lean\\\":\\\"/- Translation validation versus internal transport, Ringer et al. (2021) p7;\\\\nViola–Fan–Ringer (2025) pp1–2. -/\\\\nimport Lang.Contextual.RepairObjects\\\\n\\\\nnamespace Nanodregg.Lang.Contextual.TransportKinds\\\\n\\\\n/-- Distinct data constructors record how a claim is justified; Valid is a separate Prop\\\\n(Ringer p7; Viola pp1–2). Merely constructing a claim is not evidence of validity. -/\\\\ninductive Claim (D : CalculusData) (E : Type) where\\\\n  | rechecked (evidence : RepairObjects.TransportEvidence D E)\\\\n  | internal (source target : Candidate D)\\\\n\\\\n/-- Rechecked claims can be emitted only after the existing transport operation succeeds\\\\n(Ringer et al. p7). -/\\\\ndef recheck {D : CalculusData} {E : Type} (registry : RepairObjects.Registry D E)\\\\n    (certificate : Nat) (w : World E) (c : Candidate D) (cost : Nat) :\\\\n    Except RepairObjects.TransportRefusal (Claim D E) :=\\\\n  match RepairObjects.transport registry certificate w c cost with\\\\n  | .error e => .error e\\\\n  | .ok (.transported ev) => .ok (.rechecked ev)\\\\n  | .ok (.existing _) => .error .unknownCertificate\\\\n\\\\n/-- Quotient by the declared observable, permitting multiple concrete representatives\\\\n(Viola et al. p2). -/\\\\nabbrev Observed (A V : Type) (observe : A → V) :=\\\\n  Quot (fun a b : A => observe a = observe b)\\\\n\\\\n/-- The quotient'\\''\\'\\'''\\''s observation is well-defined (Viola et al. pp1–2). -/\\\\ndef observation {A V : Type} (observe : A → V) : Observed A V observe → V :=\\\\n  Quot.lift observe (fun _ _ h => h)\\\\n\\\\n/-- Lift an observation-preserving representation map to quotients. The required proof is\\\\nkernel checked, not a Boolean recheck (Viola et al. p2). -/\\\\ndef liftMap {A B V : Type} (a : A → V) (b : B → V) (f : A → B)\\\\n    (h : ∀ x, b (f x) = a x) : Observed A V a → Observed B V b :=\\\\n  Quot.lift (fun x => Quot.mk _ (f x)) (by\\\\n    intro x y he\\\\n    apply Quot.sound\\\\n    exact (h x).trans (he.trans (h y).symm))\\\\n\\\\nend Nanodregg.Lang.Contextual.TransportKinds\\\\n\\\",\\\"Lang/Proofs/Contextual/TransportKinds.lean\\\":\\\"import Lang.Contextual.TransportKinds\\\\nimport Lang.Proofs.Contextual.RepairObjects\\\\n\\\\nnamespace Nanodregg.Lang.Contextual.TransportKinds\\\\n\\\\n/-- Evidence is indexed by the actual evidence form; internal evidence includes a relation\\\\nand preserved proposition, while rechecked evidence names the destination judgment\\\\n(Ringer p7; Viola pp1–2). -/\\\\ninductive Valid {D : CalculusData} {E V : Type} (I : Iface D E) (w : World E)\\\\n    (value : D.Tm → V) : Claim D E → Prop where\\\\n  | rechecked {ev : RepairObjects.TransportEvidence D E} :\\\\n      ev.correspondence.target = I → judge I w ev.image = .verified →\\\\n      Valid I w value (.rechecked ev)\\\\n  | internal {source target : Candidate D} :\\\\n      value source.filling = value target.filling →\\\\n      judge I w target = .verified → Valid I w value (.internal source target)\\\\n\\\\n/-- Successful translation validation really rejudges the returned destination term;\\\\nthe claim does not inherit validity from its tag (Ringer et al. p7). -/\\\\ntheorem recheck_sound {D : CalculusData} {E : Type}\\\\n    {registry : RepairObjects.Registry D E} (hr : registry.Sound)\\\\n    {n : Nat} {w : World E} {c : Candidate D} {cost : Nat}\\\\n    {ev : RepairObjects.TransportEvidence D E}\\\\n    (h : recheck registry n w c cost = .ok (.rechecked ev)) :\\\\n    judge ev.correspondence.target w ev.image = .verified := by\\\\n  unfold recheck at h\\\\n  split at h\\\\n  · cases h\\\\n  · rename_i ev'\\''\\'\\'''\\'' he\\\\n    cases h\\\\n    exact (RepairObjects.transport_sound hr he).2.2.2.2.1\\\\n  · cases h\\\\n\\\\n/-- Representation maps commute with observations on every quotient element\\\\n(Viola et al. p2, internally proved in Lean). -/\\\\ntheorem lift_observation {A B V : Type} (a : A → V) (b : B → V) (f : A → B)\\\\n    (h : ∀ x, b (f x) = a x) (q : Observed A V a) :\\\\n    observation b (liftMap a b f h q) = observation a q := by\\\\n  induction q using Quot.ind with\\\\n  | _ x => exact h x\\\\n\\\\n/-- Two observation-preserving maps are inverse on quotients, although concrete\\\\nrepresentatives need not be equal (Viola et al. p2). -/\\\\ntheorem quotient_inverse {A B V : Type} (a : A → V) (b : B → V)\\\\n    (f : A → B) (g : B → A)\\\\n    (hf : ∀ x, b (f x) = a x) (hg : ∀ y, a (g y) = b y)\\\\n    (q : Observed A V a) :\\\\n    liftMap b a g hg (liftMap a b f hf q) = q := by\\\\n  induction q using Quot.ind with\\\\n  | _ x =>\\\\n    apply Quot.sound\\\\n    exact (hg (f x)).trans (hf x)\\\\n\\\\n/-- An extensional predicate transports internally along the quotient map; no fresh\\\\nexecution of the predicate is required (Viola et al. pp1–2). -/\\\\ntheorem quotient_predicate_transport {A B V : Type} (a : A → V) (b : B → V)\\\\n    (f : A → B) (hf : ∀ x, b (f x) = a x) (P : V → Prop)\\\\n    (q : Observed A V a) (h : P (observation a q)) :\\\\n    P (observation b (liftMap a b f hf q)) := by\\\\n  rw [lift_observation]\\\\n  exact h\\\\n\\\\n/-- The two evidence forms cannot be confused by a consumer (Ringer p7; Viola p1). -/\\\\ntheorem evidence_forms_distinct {D : CalculusData} {E : Type}\\\\n    (ev : RepairObjects.TransportEvidence D E) (s t : Candidate D) :\\\\n    Claim.rechecked ev ≠ .internal s t := by\\\\n  intro h\\\\n  cases h\\\\n\\\\n/-- Forgetting a representation flag is many-to-one, yet quotient-invertible\\\\n(Viola et al. p2, analogous to their multiple queue representatives). -/\\\\ntheorem redundant_flag_quotient :\\\\n    Quot.mk (fun x y : Nat × Bool => x.1 = y.1) (7, false) =\\\\n      Quot.mk (fun x y : Nat × Bool => x.1 = y.1) (7, true) ∧\\\\n    (7, false) ≠ (7, true) := by\\\\n  exact ⟨Quot.sound rfl, by decide⟩\\\\n\\\\nend Nanodregg.Lang.Contextual.TransportKinds\\\\n\\\"}\")

/-
# Lang.Contextual.CoreCalculus — CMTT's data as a `CalculusData` (lane CMTT-CORE)

The data half of CMTT as an instance of CLOSURE's abstract calculus (`Lang.Contextual.Closure`);
the laws are `Lang.Proofs.Contextual.CoreInstance.cmttLaws`, over the typing judgment
`fun Ω => HasTy (holeEnv Ω)`. A template's holes are the FREE metavariables of a Core term: the
hole named `n` is `mvar (n + d)` under `d` `letbox`es.
-/
import Lang.Contextual.Core
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

/-- The modal environment of a hole list: the hole named `n` is the first declaration named `n`. -/
def holeEnv (Ω : List (HoleDecl Ctx Ty)) : MEnv := fun n =>
  (Ω.find? fun d => d.name == n).map fun d => (d.ctx, d.ty)

/-- CMTT's data: hand-written decidable equality, hole filling `msubstP θ 0`, the exact checker,
free-variable occurrence, context deletion, strengthening/weakening at a position, variables. -/
def cmttData : CalculusData where
  Ty := Ty
  Ctx := Ctx
  Tm := Tm
  tmEq := Tm.decEq
  msubst θ t := msubstP θ 0 t
  check := check
  uses t x := uses x t
  drop Γ x := Γ.eraseIdx x
  strengthen x t := unshiftAt x t
  weaken x t := shiftAt x t
  var := Tm.var
  lookup Γ x := Γ[x]?

end Nanodregg.Lang.Contextual
/-
# Lang.Contextual.NanoBridge — nano's free program over effects as an open protocol (lane PROTOCOL)

`Hosting.Resident.Prog` (`cmd | keep | forget | ask | say`, a continuation per result) is the
instance of `Lang.Contextual.Protocol.Prot` with a trivial index (`Unit`) and no holes (`Empty`):
`ofProg` embeds a program, `toEv` reads a performed interaction as nano's trace event, `oracleH` is
nano's oracle as a deterministic environment. Definitions only; the theorems (`nano_runs_iff`,
`nano_interp_agrees`, `nano_interp_runs`) are in `Lang.Proofs.Contextual.Protocol`.
-/
import Lang.Contextual.Protocol
import Hosting.Resident.Trace

namespace Nanodregg.Lang.Contextual.Protocol.Nano

open Nanodregg.Hosting Nanodregg.Hosting.Resident

/-- Nano's five effects as operation shapes. -/
inductive NOp
  | cmd (c : Cmd)
  | keep (r : Ring) (t : ByteArray)
  | forget
  | ask (r : Ring) (q : Broker.Ask)
  | say (s : String)

/-- Each effect's result type, as `Prog`'s continuations take it. -/
def NOp.Resp : NOp → Type
  | .cmd _ => Except String Reply
  | .keep _ _ => Bool
  | .forget => Bool
  | .ask _ _ => AskEnd
  | .say _ => Unit

/-- The trivially indexed signature of nano's effects. -/
def sig : Sig Unit where
  Op := fun _ => NOp
  Resp := fun op => NOp.Resp op
  next := fun _ _ => ()

/-- A nano program as an open protocol without holes. -/
def ofProg {α : Type} : Prog α → Prot sig (fun _ => Empty) (fun _ => α) ()
  | .done a => .ret a
  | .cmd c k => .call (S := sig) (NOp.cmd c) fun x => ofProg (k x)
  | .keep r t k => .call (S := sig) (NOp.keep r t) fun b => ofProg (k b)
  | .forget k => .call (S := sig) NOp.forget fun b => ofProg (k b)
  | .ask r q k => .call (S := sig) (NOp.ask r q) fun x => ofProg (k x)
  | .say s k => .call (S := sig) (NOp.say s) fun _ => ofProg k

/-- A performed interaction as nano's trace event. -/
def toEv : Entry sig → Ev
  | ⟨_, op, r⟩ => match op, r with
    | .cmd c, x => .cmd c x
    | .keep r t, b => .keep r t b
    | .forget, b => .forget b
    | .ask r q, x => .ask r q x
    | .say s, _ => .say s

/-- The oracle as a deterministic environment whose state is the call counter. -/
def oracleH (o : Oracle) : Handler sig (fun _ => Nat) where
  handle := fun op n => match op with
    | .cmd _ => ⟨o.cmd n, n + 1⟩
    | .keep _ _ => ⟨o.keep n, n + 1⟩
    | .forget => ⟨o.forget n, n + 1⟩
    | .ask _ _ => ⟨o.ask n, n + 1⟩
    | .say _ => ⟨(), n + 1⟩

end Nanodregg.Lang.Contextual.Protocol.Nano
/-
# Lang.Proofs.Contextual.Typing — the judgments of `Lang.Contextual.Core` (lane CMTT-CORE)

`HasTy Δ Γ t A` is CMTT's typing judgment; `HasSubst Δ Γ σ Ψ` (`σ : Ψ` under `Δ; Γ`) its pointwise
lift, inlined into the `mvar` rule so the judgment is one inductive (`HasTy.mvar'` is the textbook
rule); `Step` is weak-head reduction. Statements, hence a proof module (gate C3).
-/
import Lang.Contextual.Core

namespace Nanodregg.Lang.Contextual

/-! ## Typing -/

/-- `HasTy Δ Γ t A`: CMTT's typing judgment, `Δ; Γ ⊢ t : A`. -/
inductive HasTy : MEnv → Ctx → Tm → Ty → Prop
  | var {Δ : MEnv} {Γ : Ctx} {i : Nat} {A : Ty} :
      Γ[i]? = some A → HasTy Δ Γ (.var i) A
  | lam {Δ : MEnv} {Γ : Ctx} {A B : Ty} {t : Tm} :
      HasTy Δ (A :: Γ) t B → HasTy Δ Γ (.lam A t) (.arr A B)
  | app {Δ : MEnv} {Γ : Ctx} {A B : Ty} {t s : Tm} :
      HasTy Δ Γ t (.arr A B) → HasTy Δ Γ s A → HasTy Δ Γ (.app t s) B
  /-- The body is typed under `Ψ` ONLY; the ambient `Γ` is not available. -/
  | box {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {t : Tm} :
      HasTy Δ Ψ t A → HasTy Δ Γ (.box Ψ t) (.box Ψ A)
  | letbox {Δ : MEnv} {Γ Ψ : Ctx} {A B : Ty} {t s : Tm} :
      HasTy Δ Γ t (.box Ψ A) → HasTy (MEnv.cons (Ψ, A) Δ) Γ s B → HasTy Δ Γ (.letbox t s) B
  /-- `u :: (Ψ ⊢ A) ∈ Δ` and `σ : Ψ` (the premises of `HasSubst`, inlined). -/
  | mvar {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {u : Nat} {σ : List Tm} :
      Δ u = some (Ψ, A) → σ.length = Ψ.length →
      (∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → HasTy Δ Γ s C) →
      HasTy Δ Γ (.mvar u σ) A

/-- `HasSubst Δ Γ σ Ψ`: `Δ; Γ ⊢ σ : Ψ`, pointwise. -/
def HasSubst (Δ : MEnv) (Γ : Ctx) (σ : List Tm) (Ψ : Ctx) : Prop :=
  σ.length = Ψ.length ∧
    ∀ (i : Nat) (s : Tm) (C : Ty), σ[i]? = some s → Ψ[i]? = some C → HasTy Δ Γ s C

/-- The `mvar` rule in its textbook form: `u :: (Ψ ⊢ A) ∈ Δ` and `Δ; Γ ⊢ σ : Ψ`. -/
theorem HasTy.mvar' {Δ : MEnv} {Γ Ψ : Ctx} {A : Ty} {u : Nat} {σ : List Tm}
    (hu : Δ u = some (Ψ, A)) (hσ : HasSubst Δ Γ σ Ψ) : HasTy Δ Γ (.mvar u σ) A :=
  .mvar hu hσ.1 hσ.2

/-! ## Reduction -/

/-- Weak-head small-step reduction: β, the contextual β (`letbox (box Ψ t) s ↦ ⟦Ψ.t/u⟧s`), and
congruence in the function position of `app` and the scrutinee of `letbox`. Nothing reduces under
`lam` or inside `box` (a box body is closed over its own `Ψ` and is a value). -/
inductive Step : Tm → Tm → Prop
  | beta {A : Ty} {t s : Tm} : Step (.app (.lam A t) s) (subst [s] t)
  | letboxBox {Ψ : Ctx} {t s : Tm} : Step (.letbox (.box Ψ t) s) (msubst t 0 s)
  | appL {t t' s : Tm} : Step t t' → Step (.app t s) (.app t' s)
  | letboxL {t t' s : Tm} : Step t t' → Step (.letbox t s) (.letbox t' s)

end Nanodregg.Lang.Contextual
/-
# Lang.Proofs.Contextual.CoreInstance — the laws of CMTT as a `Calculus` (lane CMTT-CORE)

`cmttLaws : CalculusLaws cmttData (fun Ω => HasTy (holeEnv Ω))`: every theorem
`Lang.Proofs.Contextual.Closure` proves over all lawful calculi holds of CMTT. Law by law:

| law | Core |
|---|---|
| `msubst_lemma` | `hasTy_msubstP` + `holeEnv_filter` + `holeEnv_some` |
| `check_sound`, `check_complete` | `check_sound`, `check_complete` |
| `strengthen_lemma` | `hasTy_unshiftAt` |
| `strengthen_factor` | `shiftAt_unshiftAt` |
| `weaken_avoids` | `uses_shiftAt` (holds without the typing premise) |
| `hasTy_var` | `HasTy.var` |
| `uses_var` | `uses` on `var` |
-/
import Lang.Contextual.CoreCalculus
import Lang.Proofs.Contextual.Typing
import Lang.Proofs.Contextual.Core
import Lang.Proofs.Contextual.ClosureStatements

namespace Nanodregg.Lang.Contextual

theorem holeEnv_nil : holeEnv [] = MEnv.nil := rfl

/-- Removing declarations of OTHER names (or none of name `n`) leaves `n`'s lookup alone. -/
theorem holeEnv_filter (p : HoleDecl Ctx Ty → Bool) (n : Nat) :
    ∀ Ω : List (HoleDecl Ctx Ty), (∀ d ∈ Ω, d.name = n → p d = true) →
      holeEnv (Ω.filter p) n = holeEnv Ω n
  | [], _ => rfl
  | d :: Ω, h => by
    have ih := holeEnv_filter p n Ω fun d' hd' => h d' (List.mem_cons_of_mem _ hd')
    by_cases hn : d.name = n
    · have hp := h d List.mem_cons_self hn
      simp only [holeEnv, List.filter_cons_of_pos hp, List.find?_cons, hn, beq_self_eq_true]
    · have hb : (d.name == n) = false := by simp [hn]
      by_cases hp : p d = true
      · simp only [holeEnv, List.filter_cons_of_pos hp, List.find?_cons, hb] at ih ⊢
        exact ih
      · simp only [holeEnv, List.filter_cons_of_neg hp, List.find?_cons, hb] at ih ⊢
        exact ih

theorem holeEnv_some {Ω : List (HoleDecl Ctx Ty)} {n : Nat} {Ψ : Ctx} {A : Ty}
    (h : holeEnv Ω n = some (Ψ, A)) : ∃ d ∈ Ω, d.name = n ∧ d.ctx = Ψ ∧ d.ty = A := by
  unfold holeEnv at h
  simp only [Option.map_eq_some_iff, Prod.mk.injEq] at h
  obtain ⟨d, hd, hc, ht⟩ := h
  exact ⟨d, List.mem_of_find?_eq_some hd, by simpa using List.find?_some hd, hc, ht⟩

/-- **CMTT is a lawful `Calculus`.** -/
theorem cmttLaws : CalculusLaws cmttData (fun Ω => HasTy (holeEnv Ω)) where
  msubst_lemma := by
    intro Ω Γ P T θ hP hθ
    refine hasTy_msubstP hP θ 0 _ (fun v hv => absurd hv (Nat.not_lt_zero v)) ?_ ?_
    · intro n hn
      exact holeEnv_filter _ n Ω fun d _ hd => by rw [hd, hn]; rfl
    · intro n M Ψ A hn hv
      obtain ⟨d, hd, hname, hctx, hty⟩ := holeEnv_some hv
      have := hθ d hd M (by rw [hname]; exact hn)
      rw [hctx, hty] at this
      exact this
  check_sound := check_sound
  check_complete := check_complete
  strengthen_lemma := hasTy_unshiftAt
  strengthen_factor := shiftAt_unshiftAt
  weaken_avoids := fun {_ M _ x} _ => uses_shiftAt x M
  hasTy_var := HasTy.var
  uses_var := by intro x; simp [cmttData, uses]

/-! ## Toy: a template with one hole, filled -/

/-- The hole `0 :: [r : base ⊢ base]` (a continuation awaiting a response `r`). -/
private def bellHole : HoleDecl Ctx Ty := ⟨0, [.base], .base⟩

/-- The template `λx. u₀[x]`: resume the hole at the argument. -/
private def bellTemplate : Tm := .lam .base (.mvar 0 [.var 0])

/-- The filling `u₀ := r.(λy.y) r`. -/
private def bellFill : Nat → Option Tm :=
  fun n => if n = 0 then some (.app (.lam .base (.var 0)) (.var 0)) else none

/-- The template is typed WITH the hole and NOT without it; filled, it computes to
`λx. (λy.y) x` and is typed with the hole gone, through `cmttLaws.msubst_lemma`. -/
theorem bell_template_toy :
    HasTy (holeEnv [bellHole]) [] bellTemplate (.arr .base .base) ∧
      ¬ HasTy (holeEnv []) [] bellTemplate (.arr .base .base) ∧
      cmttData.msubst bellFill bellTemplate = .lam .base (.app (.lam .base (.var 0)) (.var 0)) ∧
      HasTy (holeEnv []) [] (cmttData.msubst bellFill bellTemplate) (.arr .base .base) := by
  have hT : HasTy (holeEnv [bellHole]) [] bellTemplate (.arr .base .base) :=
    HasTy.lam (HasTy.mvar' rfl (hasSubst_cons (.var rfl) (hasSubst_nil _ _)))
  refine ⟨hT, ?_, rfl, ?_⟩
  · intro h
    cases h with
    | lam hb => cases hb with | mvar hu _ _ => cases hu
  · have := cmttLaws.msubst_lemma (Ω := [bellHole]) (Γ := []) (P := bellTemplate)
      (T := .arr .base .base) bellFill hT
      (fun d hd M hM => by
        simp only [List.mem_singleton] at hd
        subst hd
        simp only [bellHole, bellFill, if_true] at hM
        injection hM with hM
        subst hM
        show HasTy (holeEnv []) [.base] _ .base
        exact HasTy.app (HasTy.lam (HasTy.var rfl)) (HasTy.var rfl))
    simpa [bellHole, bellFill] using this

/-- The instance's strengthening is the real one: `t ≡ t₀[π]` with `t₀ ≠ t`. -/
theorem cmtt_strengthen_toy :
    cmttData.strengthen 1 (.app (.var 0) (.var 2)) = (.app (.var 0) (.var 1) : Tm) ∧
      cmttData.weaken 1 (cmttData.strengthen 1 (.app (.var 0) (.var 2))) =
        (.app (.var 0) (.var 2) : Tm) :=
  ⟨rfl, rfl⟩

end Nanodregg.Lang.Contextual
/- Guarded contextual closure: History. Moved without statement changes from Closure. -/
import Lang.Proofs.Contextual.Soundness

namespace Nanodregg.Lang.Contextual

variable {D : CalculusData} {E : Type}
  {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}


/-! ## Selection, acceptance, the executed prefix -/

/-- **select requires availability.** An admitted `select` was made by the hole's chooser, before
acceptance, of a retained candidate that judges `verified` AT THE CURRENT WORLD (every support
live), and `σ` now maps the hole to that candidate's filling. -/
theorem select_requires_available {w : World E} {p : Party} {u i : Nat} {cl cl' : Closure D E}
    (h : select w p u i cl = .ok cl') :
    ∃ I c, cl.find u = some I ∧ p = I.chooser ∧ (cl.slot u).accepted = false ∧
      (cl.slot u).cands[i]? = some c ∧ judge I w c = .verified ∧
      (∀ t ∈ effSupports I c, w.live t = true) ∧ cl'.sigma u = some c.filling := by
  obtain ⟨I, c, hf, hp, hacc, hc, hv, -, -, -, hs⟩ := select_ok h
  refine ⟨I, c, hf, hp, hacc, hc, hv, (judge_verified_iff.1 hv).2.2.2.1, ?_⟩
  simp only [Closure.sigma, Closure.selectedCand, hs, update_at, if_true]
  rw [List.getElem?_set_self (List.getElem?_eq_some_iff.1 hc).1]
  rfl

/-- A token re-issued at a new version no longer supports anything: a candidate citing the old
version does not judge `verified` after the re-issue. -/
theorem reissued_support_unverified {w : World E} {I : Iface D E} {c : Candidate D}
    {id old new : Nat} (hne : old ≠ new) (hcite : ⟨id, old⟩ ∈ effSupports I c) :
    judge I (applyAll (reissue id old new) w) c ≠ .verified := by
  intro hv
  have := (judge_verified_iff.1 hv).2.2.2.1 _ hcite
  rw [reissue_never_reenables w id old new hne] at this
  cases this

/-- **An executed prefix blocks re-planning.** After `accept` of hole `u`: no `select` and no
`deselect` of `u` is admitted at any world by anyone; no repair moves `u`'s selection; the
settlement it owes is recorded and survives every later operation; and a `select` of ANOTHER hole
(an unexecuted component) leaves `u`'s slot, the owed obligations and the history prefix as they
were. -/
theorem executed_prefix_blocks_replan {w : World E} {p : Party} {u : Nat} {cl cl₁ : Closure D E}
    (ha : accept w p u cl = .ok cl₁) :
    (∀ (w' : World E) q j cl₂, select w' q u j cl₁ ≠ .ok cl₂) ∧
    (∀ q cl₂, deselect q u cl₁ ≠ .ok cl₂) ∧
    (∀ (w' : World E) (e : Edit E), ((repair w' e cl₁).1.slot u).selected = (cl₁.slot u).selected) ∧
    (∃ i, (cl₁.slot u).selected = some i ∧ Obligation.settle u i ∈ cl₁.owed ∧
      (∀ (w' : World E) q (r : Token) cl₂, prune w' q u i r cl₁ ≠ .ok cl₂) ∧
      ∀ (w' : World E) (op : Op D E) cl₂, op.run w' cl₁ = .ok cl₂ → Obligation.settle u i ∈ cl₂.owed) ∧
    (∀ (w' : World E) q v j cl₂, v ≠ u → select w' q v j cl₁ = .ok cl₂ →
      cl₂.slot u = cl₁.slot u ∧ cl₂.owed = cl₁.owed ∧ cl₂.hist = cl₁.hist ++ [.selected v j]) := by
  obtain ⟨I, i, c, hf, -, -, hsel, -, -, ht, ho, -, hs⟩ := accept_ok ha
  have hacc : (cl₁.slot u).accepted = true := by rw [hs, update_at]; simp
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro w' q j cl₂ h
    obtain ⟨-, -, -, -, h', -⟩ := select_ok h
    rw [hacc] at h'; cases h'
  · intro q cl₂ h
    obtain ⟨-, -, -, h', -⟩ := deselect_ok h
    rw [hacc] at h'; cases h'
  · intro w' e
    simp only [repair]
    split
    · rename_i J hJ
      exact repair_keeps_accepted _ _ _ _ hacc
    · rfl
  · have hsel₁ : (cl₁.slot u).selected = some i := by rw [hs, update_at]; simp [hsel]
    refine ⟨i, hsel₁, by rw [ho]; simp, ?_, ?_⟩
    · intro w' q r cl₂ h
      obtain ⟨-, -, -, -, h', -⟩ := prune_ok h
      exact h' ⟨hacc, hsel₁⟩
    intro w' op cl₂ h
    obtain ⟨-, -, ⟨sfx, hsfx⟩⟩ := history_is_prefix h
    rw [hsfx, ho]; simp
  · intro w' q v j cl₂ hne h
    obtain ⟨J2, c2, -, -, -, -, -, -, ho2, hh2, hs2⟩ := select_ok h
    refine ⟨?_, ho2, hh2⟩
    rw [hs2, update_at]
    simp [Ne.symm hne]

/-! ## Boundaries -/

/-- **The boundary theorem for a consumer.** A consumer that relies on a hole only through an
exported projection gives the same verdict on any two closures whose selected fillings agree on
that projection: candidate identity, supports, history are invisible to it. -/
theorem consumer_boundary {V : Type} (k : Consumer D V) {cl cl' : Closure D E}
    (h : (cl.sigma k.hole).map k.proj = (cl'.sigma k.hole).map k.proj) : k.holds cl = k.holds cl' := by
  unfold Consumer.holds
  cases h1 : cl.sigma k.hole <;> cases h2 : cl'.sigma k.hole <;> rw [h1, h2] at h <;>
    simp_all

/-! ## Sessions -/

/-- Coherence holds along a session (the world threaded through every edit). -/
theorem session_preserves_coherent :
    ∀ (ops : List (Op D E)) {w w' : World E} {cl cl' : Closure D E},
      Coherent w cl → Session.run ops (w, cl) = .ok (w', cl') → Coherent w' cl'
  | [], _, _, _, _, hc, h => by
    simp only [Session.run, Except.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h; exact hc
  | op :: ops, w, w', cl, cl', hc, h => by
    simp only [Session.run] at h
    split at h
    · cases h
    · rename_i cl₁ h₁
      exact session_preserves_coherent ops (op_preserves_coherent hc h₁) h

/-- A session never rewrites the template. -/
theorem session_preserves_tpl :
    ∀ (ops : List (Op D E)) {w w' : World E} {cl cl' : Closure D E},
      Session.run ops (w, cl) = .ok (w', cl') → cl'.tpl = cl.tpl
  | [], _, _, _, _, h => by
    simp only [Session.run, Except.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h; rfl
  | op :: ops, w, w', cl, cl', h => by
    simp only [Session.run] at h
    split at h
    · cases h
    · rename_i cl₁ h₁
      rw [session_preserves_tpl ops h, (history_is_prefix h₁).tpl]

/-- Well-filledness (hence derivability) holds along a session. -/
theorem session_preserves_wellFilled :
    ∀ (ops : List (Op D E)) {w w' : World E} {cl cl' : Closure D E},
      WellFilled cl → Session.run ops (w, cl) = .ok (w', cl') → WellFilled cl'
  | [], _, _, _, _, hc, h => by
    simp only [Session.run, Except.ok.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h; exact hc
  | op :: ops, w, w', cl, cl', hc, h => by
    simp only [Session.run] at h
    split at h
    · cases h
    · rename_i cl₁ h₁
      exact session_preserves_wellFilled ops (op_preserves_wellFilled hc h₁) h

theorem fromScratch_wellFilled (w : World E) (tpl : Template D E) (cands : Nat → List (Candidate D)) :
    WellFilled (fromScratch w tpl cands) := by
  intro I hI i hi
  simp only [fromScratch, find_name_self tpl.names hI] at hi
  cases hi


end Nanodregg.Lang.Contextual

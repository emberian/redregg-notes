theorem renameL_substFnL (ρ : Nat → Nat) (f : Nat → Tm) :
    ∀ σ : List Tm, renameL ρ (substFnL f σ) = substFnL (fun i => rename ρ (f i)) σ
  | [] => rfl
  | t :: σ => by simp only [renameL, substFnL, rename_substFn ρ f t, renameL_substFnL ρ f σ]

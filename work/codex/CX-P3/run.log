correspondence (a map with a left inverse, so possibly PARTIAL on the new side: stale
representations need not name anything) carries a judged protocol to a judged protocol over the
new representation, its tokens renamed. -/
theorem hasProt_mapTok {Tok' : Type} [DecidableEq Tok] [DecidableEq Tok']
    {e : Tok → Tok'} {e' : Tok' → Tok} (h₁ : ∀ a, e' (e a) = a)
    {sp : Spec S Tok Fact Ob} {Ω : Ctx S Hole A Tok Fact Ob} {Γ : List Fact}
    {Q : (j : Ix) → A j → Prop} {Φ : List Ob} {Δ : List Tok} {i : Ix} {P : Prot S Hole A i}
    (h : HasProt sp Ω Γ Q Φ Δ P) : HasProt (sp.mapTok e) (Ω.mapTok e) Γ Q Φ (Δ.map e) P := by
  induction h with
  | ret a hq => exact .ret a hq
  | call op k hc hr he _ ih =>
    exact .call op k (by simp [Spec.mapTok, hc]) hr he ih
  | @spend Δ i op k t hc ht hr he _ ih =>
    refine .spend op k (e t) (by simp [Spec.mapTok, hc]) (List.mem_map_of_mem ht) hr he ?_
    intro r
    have := ih r
    rwa [map_erase_bij h₁] at this
  | hole h I hI hp hctx hneed hpost howes =>
    refine .hole h (I.mapTok e) (by simp [Ctx.mapTok, hI]) hp hctx ?_ hpost howes
    exact SubBag.map h₁ hneed

/-- **Representation change transports admission**: an effect is admissible over the renamed
tokens, against the view read back through the correspondence, exactly when it was before. -/
theorem admitOp_mapTok {Tok' : Type} {e : Tok → Tok'} {e' : Tok' → Tok}
    (h₁ : ∀ a, e' (e a) = a) (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix}
    (op : S.Op i) :
    admitOp (sp.mapTok e) ⟨v.holds, fun b => v.live (e' b)⟩ op = admitOp sp v op := by
  unfold admitOp Spec.mapTok
  cases hc : sp.consumes op <;> simp [hc, h₁]

end

/-! ## Shared parameters -/

/-- **Separate witnesses are insufficient** (doc 2 section 4), a SCALAR ILLUSTRATION with `θ` a
price: each party's condition has a witness, and the completion space is empty:
`(∃x B x) ∧ (∃x S x) ⇏ ∃x (B x ∧ S x)`. The form over substitutions of an open protocol is
`Negotiation.separate_witnesses_over_substitutions`. -/
theorem separate_witnesses_insufficient :
    (∃ x, priceConds.guards x) ∧ (∃ x, priceConds.authority x) ∧ ¬ ∃ x, priceConds.space x := by
  refine ⟨⟨5, Nat.le_refl 5⟩, ⟨7, Nat.le_refl 7⟩, ?_⟩
  rintro ⟨x, _, hb, hs, _⟩
  have hb' : x ≤ 5 := hb
  have hs' : 7 ≤ x := hs
  omega

/-- The general form: per-condition witnesses never compose into a completion. -/
theorem witnesses_do_not_compose :
    ¬ ∀ (B S : Nat → Prop), (∃ x, B x) → (∃ x, S x) → ∃ x, B x ∧ S x := by
  intro h
  obtain ⟨x, hb, hs⟩ := h priceConds.guards priceConds.authority
    separate_witnesses_insufficient.1 separate_witnesses_insufficient.2.1
  exact separate_witnesses_insufficient.2.2 ⟨x, trivial, hb, hs, trivial⟩

/-- The same instance, decided over a bounded price range. -/
theorem separate_witnesses_bounded :
    (∃ x : Fin 20, x.val ≤ 5) ∧ (∃ x : Fin 20, 7 ≤ x.val) ∧ ¬ ∃ x : Fin 20, x.val ≤ 5 ∧ 7 ≤ x.val := by
  decide

/-! ## Search state versus logical status -/

/-- **Greedy versus logical** (doc 2 section 4, the matcher), an ILLUSTRATION over number lists,
not over protocols: offers `[100, 50]`, wants `[50, 100]`:
first-fit satisfies one want of two, while a complete assignment (want 0 ← offer 1, want 1 ← offer
0) exists and complete search finds it. -/
theorem greedy_vs_logical :
    firstFit [100, 50] [50, 100] = 1 ∧ coverAll [100, 50] [50, 100] = true ∧
      Assigns [100, 50] [50, 100] [1, 0] := by
  refine ⟨by decide, by decide, ?_⟩
  unfold Assigns
  decide

/-- **Search state is not logical status**: a greedy shortfall does not refute the intent. -/
theorem search_state_ne_logical_status :
    ¬ ∀ offers wants : List Nat, firstFit offers wants < wants.length →
      ¬ ∃ picks, Assigns offers wants picks := by
  intro h
  exact h [100, 50] [50, 100] (by decide) ⟨[1, 0], greedy_vs_logical.2.2⟩

/-! ## A hole is not an interaction (doc 2 section 5) -/

namespace Coin

/-- Running the open plan under a filling: the filling's answer, compared with the peer's bit. -/
theorem wins_planHole (θ : Subst sig HoleN Res) (b : Bool) :
    wins b (subst θ planHole) () =
      match θ .revealed () with
      | some (.ret c) => c == b
      | _ => false := by
  have e : wins b (subst θ planHole) () =
      wins b (subst θ (Prot.hole (S := sig) (A := Res) (i := Phase.revealed) ())) () := rfl
  rw [e]
  cases hθ : θ .revealed () with
  | none => simp only [subst, hθ]; rfl
  | some f =>
    cases f with
    | ret c => simp only [subst, hθ]; rfl
    | call op k => exact nomatch op
    | hole h => simp only [subst, hθ]; rfl

/-- **No foresight, for a response-free naming**: `planHole` names its hole `()` in BOTH branches of
the peer's bit. For every environment SOME filling wins (`∀ E ∃ θ, Success (P[θ], E)`), but no
single filling wins against every environment (`¬ ∃ θ ∀ E`): the "commit a bit before you reveal
yours" game. This holds BECAUSE of the naming: with names that depend on the response the opposite
holds (`response_indexed_names_have_foresight`), and `foresight_iff_names_separate` is the exact
condition. Scope (one filling into every branch unchanged) is a naming discipline, not a fact of
the calculus. -/
theorem no_foresight :
    (∀ b, ∃ θ, wins b (subst θ planHole) () = true) ∧
      ¬ ∃ θ, ∀ b, wins b (subst θ planHole) () = true := by
  refine ⟨fun b => ⟨answer b, by rw [wins_planHole]; cases b <;> rfl⟩, ?_⟩
  rintro ⟨θ, hθ⟩
  have h0 := hθ false
  have h1 := hθ true
  rw [wins_planHole] at h0 h1
  cases hr : θ .revealed () with
  | none => simp [hr] at h0
  | some f =>
    cases f with
    | ret c => cases c <;> simp [hr] at h0 h1
    | call op k => exact nomatch op
    | hole h => simp [hr] at h0

/-- **The response-dependent continuation succeeds**: the same game with the answer written as
the continuation of the `call` (a family over the response) wins against every environment. -/
theorem response_dependent_succeeds : ∀ b, wins b planCall () = true := by
  intro b; cases b <;> rfl

/-- Running a named template under a filling: the filling of branch `b`'s hole, compared with `b`. -/
theorem wins_planNamed {Hn : Phase → Type} (name : Bool → Hn .revealed) (θ : Subst sig Hn Res)
    (b : Bool) :
    wins b (subst θ (planNamed name)) () =
      match θ .revealed (name b) with
      | some (.ret c) => c == b
      | _ => false := by
  have e : wins b (subst θ (planNamed name)) () =
      wins b (subst θ (Prot.hole (S := sig) (A := Res) (i := Phase.revealed) (name b))) () := rfl
  rw [e]
  cases hθ : θ .revealed (name b) with
  | none => simp only [subst, hθ]; rfl
  | some f =>
    cases f with
    | ret c => simp only [subst, hθ]; rfl
    | call op k => exact nomatch op
    | hole h => simp only [subst, hθ]; rfl

/-- **Foresight exactly when the names separate**: a single filling chosen before the reveal wins
against every bit iff the template gives the two branches DIFFERENT hole names. A response-free
naming (`name true = name false`) leaves no causal strategy; a response-indexed one is a filling
per response. -/
theorem foresight_iff_names_separate {Hn : Phase → Type} [DecidableEq (Hn .revealed)]
    (name : Bool → Hn .revealed) :
    (∃ θ : Subst sig Hn Res, ∀ b, wins b (subst θ (planNamed name)) () = true) ↔
      name true ≠ name false := by
  constructor
  · rintro ⟨θ, hθ⟩ heq
    have h0 := hθ false
    have h1 := hθ true
    rw [wins_planNamed] at h0 h1
    rw [heq] at h1
    cases hr : θ .revealed (name false) with
    | none => simp [hr] at h0
    | some f =>
      cases f with
      | ret c => cases c <;> simp [hr] at h0 h1
      | call op k => exact nomatch op
      | hole h => simp [hr] at h0
  · intro hne
    refine ⟨fun i => match i with
      | .waiting => fun _ => none
      | .revealed => fun n => some (.ret (decide (n = name true))), fun b => ?_⟩
    rw [wins_planNamed]
    cases b with
    | true => simp
    | false => simp [Ne.symm hne]

/-- **Response-indexed names have foresight**: `call recv (fun b => hole b)` (one hole name per bit,
well typed) admits ONE filling that wins against every environment. A hole whose name depends on the
response is a family over the response, exactly like a `call` continuation. -/
theorem response_indexed_names_have_foresight :
    ∃ θ : Subst sig HoleB Res, ∀ b, wins b (subst θ (planNamed (Hn := HoleB) fun b => b)) () = true :=
  (@foresight_iff_names_separate HoleB (inferInstanceAs (DecidableEq Bool)) fun b => b).mpr
    (by intro h; cases h)

/-- `planHole` is the response-free naming. -/
theorem planHole_named : planHole = planNamed (Hn := HoleN) fun _ => () := rfl

/-- **A `theirs` hole is never planned**: declared `theirs`, the hole is never filled by our plan, so
every run of the open plan stops at the hole. It "loses" only because `wins` scores a stuck run as
`false`: the theorem says the planner cannot win by filling, not that the peer wins. -/
theorem theirs_never_planned (σ : Subst sig HoleN Res) (b : Bool) :
    wins b (fill (ctxOf .theirs) σ planHole) () = false := by
  unfold fill
  rw [wins_planHole]
  simp [Subst.ours, ctxOf, iface]

end Coin

/-! ## Nano's free program over effects is an open protocol with a trivial index and no holes

`Hosting.Resident.Prog` (`cmd | keep | forget | ask | say`, a continuation per result) is the
instance `Ix := Unit`, `Hole := Empty` (the embedding is `Lang.Contextual.NanoBridge`). -/

namespace Nano

open Nanodregg.Hosting Nanodregg.Hosting.Resident

theorem runs_of_nano {α : Type} {p : Prog α} {es : List Ev} {a : α}
    (h : Proofs.ResidentRun.Runs p es a) : ∃ tr, Runs (ofProg p) tr () a ∧ tr.map toEv = es := by
  induction h with
  | done a => exact ⟨[], Runs.ret (S := sig) (Hole := fun _ => Empty) (A := fun _ => α) (i := ()) a, rfl⟩
  | @cmd c k es a x _ ih =>
    obtain ⟨tr, h, e⟩ := ih
    exact ⟨⟨(), NOp.cmd c, x⟩ :: tr, Runs.call (S := sig) (op := NOp.cmd c) x h, by simp [toEv, e]⟩
  | @keep r t k es a b _ ih =>
    obtain ⟨tr, h, e⟩ := ih
    exact ⟨⟨(), NOp.keep r t, b⟩ :: tr, Runs.call (S := sig) (op := NOp.keep r t) b h,
      by simp [toEv, e]⟩
  | @forget k es a b _ ih =>
    obtain ⟨tr, h, e⟩ := ih
    exact ⟨⟨(), NOp.forget, b⟩ :: tr, Runs.call (S := sig) (op := NOp.forget) b h,
      by simp [toEv, e]⟩
  | @ask r q k es a x _ ih =>
    obtain ⟨tr, h, e⟩ := ih
    exact ⟨⟨(), NOp.ask r q, x⟩ :: tr, Runs.call (S := sig) (op := NOp.ask r q) x h,
      by simp [toEv, e]⟩
  | @say s k es a _ ih =>
    obtain ⟨tr, h, e⟩ := ih
    exact ⟨⟨(), NOp.say s, ()⟩ :: tr, Runs.call (S := sig) (op := NOp.say s) () h,
      by simp [toEv, e]⟩

theorem nano_of_runs {α : Type} (p : Prog α) {tr : Trace sig} {a : α}
    (h : Runs (ofProg p) tr () a) : Proofs.ResidentRun.Runs p (tr.map toEv) a := by
  induction p generalizing tr with
  | done b =>
    cases h
    exact .done _
  | cmd c k ih =>
    cases h with
    | call x h => exact .cmd x (ih x h)
  | keep r t k ih =>
    cases h with
    | call b h => exact .keep b (ih b h)
  | forget k ih =>
    cases h with
    | call b h => exact .forget b (ih b h)
  | ask r q k ih =>
    cases h with
    | call x h => exact .ask x (ih x h)
  | say s k ih =>
    cases h with
    | call u h => exact .say (ih h)

/-- **Nano's paths are protocol paths**: `Hosting.Proofs.ResidentRun.Runs p es a` is exactly a
`Runs` path of the protocol `ofProg p`, read through `toEv`. -/
theorem nano_runs_iff {α : Type} (p : Prog α) (es : List Ev) (a : α) :
    Proofs.ResidentRun.Runs p es a ↔ ∃ tr, Runs (ofProg p) tr () a ∧ tr.map toEv = es :=
  ⟨runs_of_nano, fun ⟨_, h, e⟩ => e ▸ nano_of_runs p h⟩

/-- **The interpreters agree**: nano's `Prog.interp` at its recording handler computes what this
module's `interpret` computes at the recording oracle environment: the same value, the same
counter, and the trace read through `toEv`. -/
theorem nano_interp_agrees (o : Oracle) {α : Type} (p : Prog α) (n : Nat) (es : List Ev)
    (tr₀ : Trace sig) :
    ∃ a n' tr, interpret (record (oracleH o)) (ofProg p) (n, tr₀) = .done () a (n', tr₀ ++ tr) ∧
      (p.interp (recorder o)).run (n, es) = (a, (n', es ++ tr.map toEv)) := by
  induction p generalizing n es tr₀ with
  | done a => exact ⟨a, n, [], by simp [interpret, fold, execAlgebra, ofProg], by simp [Prog.interp]; rfl⟩
  | cmd c k ih =>
    obtain ⟨a, n', tr, h1, h2⟩ := ih (o.cmd n) (n + 1) (es ++ [.cmd c (o.cmd n)])
      (tr₀ ++ [⟨(), NOp.cmd c, o.cmd n⟩])
    exact ⟨a, n', ⟨(), NOp.cmd c, o.cmd n⟩ :: tr, by simpa [interpret, fold, execAlgebra, record, ofProg, oracleH] using h1,
      by simpa [Prog.interp, recorder, toEv] using h2⟩
  | keep r t k ih =>
    obtain ⟨a, n', tr, h1, h2⟩ := ih (o.keep n) (n + 1) (es ++ [.keep r t (o.keep n)])
      (tr₀ ++ [⟨(), NOp.keep r t, o.keep n⟩])
    exact ⟨a, n', ⟨(), NOp.keep r t, o.keep n⟩ :: tr, by simpa [interpret, fold, execAlgebra, record, ofProg, oracleH] using h1,
      by simpa [Prog.interp, recorder, toEv] using h2⟩
  | forget k ih =>
    obtain ⟨a, n', tr, h1, h2⟩ := ih (o.forget n) (n + 1) (es ++ [.forget (o.forget n)])
      (tr₀ ++ [⟨(), NOp.forget, o.forget n⟩])
    exact ⟨a, n', ⟨(), NOp.forget, o.forget n⟩ :: tr, by simpa [interpret, fold, execAlgebra, record, ofProg, oracleH] using h1,
      by simpa [Prog.interp, recorder, toEv] using h2⟩
  | ask r q k ih =>
    obtain ⟨a, n', tr, h1, h2⟩ := ih (o.ask n) (n + 1) (es ++ [.ask r q (o.ask n)])
      (tr₀ ++ [⟨(), NOp.ask r q, o.ask n⟩])
    exact ⟨a, n', ⟨(), NOp.ask r q, o.ask n⟩ :: tr, by simpa [interpret, fold, execAlgebra, record, ofProg, oracleH] using h1,
      by simpa [Prog.interp, recorder, toEv] using h2⟩
  | say s k ih =>
    obtain ⟨a, n', tr, h1, h2⟩ := ih (n + 1) (es ++ [.say s]) (tr₀ ++ [⟨(), NOp.say s, ()⟩])
    exact ⟨a, n', ⟨(), NOp.say s, ()⟩ :: tr, by simpa [interpret, fold, execAlgebra, record, ofProg, oracleH] using h1,
      by simpa [Prog.interp, recorder, toEv] using h2⟩

/-- **`interp_runs`, recovered**: nano's theorem (the interpreter performs exactly a path, for
every oracle) follows from this module's `interpret_record`, the agreement of the interpreters,
and `nano_runs_iff`. -/
theorem nano_interp_runs (o : Oracle) {α : Type} (p : Prog α) (n : Nat) (es : List Ev) :
    ∃ es', ((p.interp (recorder o)).run (n, es)).2.2 = es ++ es' ∧
      Proofs.ResidentRun.Runs p es' ((p.interp (recorder o)).run (n, es)).1 := by
  obtain ⟨a, n', tr, h1, h2⟩ := nano_interp_agrees o p n es []
  have hr := interpret_record (oracleH o) (ofProg p) n []
  rw [h1] at hr
  obtain ⟨tr', htr, hrun⟩ := hr
  simp only [List.nil_append] at htr
  subst htr
  rw [h2]
  exact ⟨tr.map toEv, rfl, nano_of_runs p hrun⟩

end Nano

end Nanodregg.Lang.Contextual.Protocol
/-
# Lang.Proofs.Contextual.Negotiation — the integration experiment (lane PROTOCOL)

The proposal's document 3 first integration experiment: two parties negotiate a ONE-USE capability
with ALTERNATIVE providers, a DEADLINE and a CANCELLATION path. The open protocol
(`Negotiation.template`: reserve the deposit, then an `ours` provider hole) is judged once, under
hypotheses (`Γ₀`: both providers' authority, the deadline); each candidate (`plan p1`, `plan p2`,
`cancelPlan`) is a filling checked against the hole's interface; admission asks the CURRENT world.
The four changes, each forced to say which operation it is:

* an unrelated update: a reused derivation (`unrelated_update_keeps_plan`, by `admits_local`;
  `unrelated_update_repair_reuses`);
* a provider's authority withdrawn: that instantiation unavailable, the open protocol and the
  other candidates intact, the residual obligation explicit (`provider_revoked_unavailable`,
  `revocation_repair`);
* a representation change: transport along a checked (partial) correspondence, and a STALE
  representation refused (`representation_change_transports`, `stale_opening_refused`);
* a replayed or competing commitment: refused by durable consumption (`replay_refused`,
  `competing_commitments`), and the gap between internal at-most-once and external exactly-once
  (`internal_once_not_external_once`, `exactly_once_needs_reply_and_dedupe`, over the internal
  record READ OFF the histories `lost p`, `H₀`, `answeredH p b` by `Internal.ofHist`).

And the deadline (`deadline_expires`), the cancellation path (`cancel_path_refunds_obligation`),
the lost reply and the answered call (`lost_reply_keeps_obligation`, `lost_reply_blocks_replan`,
`answered_blocks_replan`, `guard_stricter_than_wf`, `guarded_replan_after_dispatch_is_noop`)
against the free re-plan before dispatch
(`replan_before_dispatch`).
-/
import Lang.Proofs.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.Protocol.Negotiation

/-- THE DELIVERY MODEL (an assumption of this experiment; the proposal supplies none): an external
run CONSISTENT with an internal record. A spent nullifier means one dispatch, which the network may
deliver any number of times (including zero, if the reply is lost); an answered reply means at
least one delivery; an unspent nullifier means none. Under a lost reply this constrains NOTHING:
every external run is consistent with it, which is the point. -/
def Consistent (i : Internal) (e : External) : Prop :=
  (i.capSpent = false → e.deliveries = 0) ∧ (i.reply.isSome = true → 1 ≤ e.deliveries) ∧
    (i.reply.isSome = true → i.capSpent = true)

/-! ## The open protocol is judged; every candidate fills the hole -/

/-- The template is judged: `Ω; Γ₀; [cap] ⊢ template : Protocol(idle, True) ⊣ Φ₀`. -/
theorem template_hasProt : HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ template :=
  .call (S := sig) Op.reserve _ rfl (by simp [spec]) (by simp [spec, Φ₀])
    fun _ => .hole () iface rfl rfl (by simp [iface, Γ₀]) (SubBag.refl _) (fun _ _ _ => trivial)
      (by simp [iface, Φ₀])

/-- Each provider's plan satisfies the hole's interface (spends the capability once, uses that
provider's authority and the deadline, owes that provider's payment). -/
theorem plan_fills (p : Provider) : Fills spec Ω iface (plan p) := by
  refine ⟨.spend (S := sig) (Op.commit p) _ .cap rfl (by simp [iface]) ?_ ?_
    fun _ => .ret _ trivial, trivial⟩
  · cases p <;> simp [spec, iface]
  · cases p <;> simp [spec, iface]

/-- The cancellation path satisfies the hole's interface. -/
theorem cancel_fills : Fills spec Ω iface cancelPlan :=
  ⟨.call (S := sig) Op.cancel _ rfl (by simp [spec]) (by simp [spec, iface])
    fun _ => .ret _ trivial, trivial⟩

theorem choose_ok {f : P .reserved} (hf : Fills spec Ω iface f) : SubstOK spec Ω (choose f) := by
  intro i h g hs
  cases i with
  | idle => exact nomatch h
  | done => exact nomatch h
  | reserved =>
    cases h
    cases hs
    exact ⟨iface, rfl, rfl, hf⟩

/-- Family 1, instance: every candidate's instantiation is judged at the template's judgment. -/
theorem instantiations_hasProt :
    (∀ p, HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ (fill Ω (choose (plan p)) template)) ∧
      HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ (fill Ω (choose cancelPlan) template) :=
  ⟨fun p => fill_preserves_hasProt (choose_ok (plan_fills p)) template_hasProt,
    fill_preserves_hasProt (choose_ok cancel_fills) template_hasProt⟩

/-- Family 2, instance: running the instantiation against a delivering provider is running the
template with the choice in the environment; both compute the same outcome. -/
theorem interpret_instance :
    interpret (env true) (subst (choose (plan .p1)) template) 0 =
        interpretUnder (env true) (choose (plan .p1)) template 0 ∧
      (match interpret (env true) (subst (choose (plan .p1)) template) 0 with
        | .done j a n => decide (j = .done) && a && decide (n = 2)
        | .stuck _ _ _ => false) = true :=
  ⟨by rw [interpret_fill], rfl⟩

/-- The open protocol has exactly one hole, the provider; every instantiation has none. -/
theorem holes_instance :
    (holes finite template).length = 1 ∧ Occurs template .reserved () ∧
      (∀ p, holes finite (fill Ω (choose (plan p)) template) = []) ∧
      holes finite (fill Ω (choose cancelPlan) template) = [] := by
  refine ⟨rfl, (mem_holes_iff finite template .reserved ()).mp
      (by simp [holes, template, finite]; exact ⟨rfl, HEq.rfl⟩),
    fun p => ?_, rfl⟩
  cases p <;> rfl

/-! ## Change 1: an unrelated state update -/

/-- **An unrelated update keeps the plan**: an update to the unrelated store, or to the OTHER
provider's authority, leaves the plan's admission as it was: the keys its admission reads
(`opSupport`) are untouched, so `admits_local` reuses the verdict. -/
theorem unrelated_update_keeps_plan (w : World) (g : Nat → Nat) :
    admits spec ({ w with other := g }).view (plan .p1) = admits spec w.view (plan .p1) ∧
      admits spec (w.revoke .p2).view (plan .p1) = admits spec w.view (plan .p1) := by
  refine ⟨rfl, ?_⟩
  show admitOp spec (View.ofStore (w.revoke .p2).store) (S := sig) (Op.commit .p1) =
    admitOp spec (View.ofStore w.store) (S := sig) (Op.commit .p1)
  apply admits_local
  intro k hk
  simp [opSupport, spec] at hk
  rcases hk with rfl | rfl | rfl <;> rfl

/-- The same as selective repair: after a change to `auth p2` only `plan p2`'s fragment is
re-checked (the affected list), and the repaired verdicts are those of a full re-check. -/
theorem unrelated_update_repair_reuses :
    repair frags (fromScratch frags w0.store) [.inl (.auth .p2)] (w0.revoke .p2).store =
        fromScratch frags (w0.revoke .p2).store ∧
      repair frags (fromScratch frags w0.store) [.inl (.auth .p2)] (w0.revoke .p2).store =
        [true, false, true] ∧
      (frags.map fun f => f.affected [.inl (.auth .p2)]) = [false, true, false] := by
  refine ⟨repair_agrees_from_scratch frags ?_ ?_, rfl, rfl⟩
  · intro f hf
    simp only [frags, List.mem_cons, List.not_mem_nil, or_false] at hf
    rcases hf with rfl | rfl | rfl <;> exact admitFrag_readsOnly _ _ _
  · intro k hk
    rcases k with (⟨p⟩ | _) | ⟨⟩ <;> (try cases p) <;> simp_all [World.store, World.view, World.revoke, w0]

/-! ## Change 2: a provider's authority withdrawn -/

/-- **Provider revoked → that instantiation unavailable**: with `p1`'s authority withdrawn,
`plan p1` is still DERIVABLE (it fills the hole, its instantiation is judged) but not ADMISSIBLE
now; the open protocol stays judged and the other candidates stay available. -/
theorem provider_revoked_unavailable :
    available w0 = [1, 2, 3] ∧ available (w0.revoke .p1) = [2, 3] ∧
      Fills spec Ω iface (plan .p1) ∧ admits spec (w0.revoke .p1).view (plan .p1) = false ∧
      HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ template ∧
      admits spec (w0.revoke .p1).view (plan .p2) = true :=
  ⟨rfl, rfl, plan_fills .p1, rfl, template_hasProt, rfl⟩

/-- The revocation as selective repair: only `plan p1`'s fragment is affected; the repair agrees
with a full re-check; the explicit residual obligation names exactly that fragment. -/
theorem revocation_repair :
    repair frags (fromScratch frags w0.store) [.inl (.auth .p1)] (w0.revoke .p1).store =
        fromScratch frags (w0.revoke .p1).store ∧
      residual frags (repair frags (fromScratch frags w0.store) [.inl (.auth .p1)]
        (w0.revoke .p1).store) = [1] ∧
      (frags.map fun f => f.affected [.inl (.auth .p1)]) = [true, false, false] := by
  refine ⟨repair_agrees_from_scratch frags ?_ ?_, rfl, rfl⟩
  · intro f hf
    simp only [frags, List.mem_cons, List.not_mem_nil, or_false] at hf
    rcases hf with rfl | rfl | rfl <;> exact admitFrag_readsOnly _ _ _
  · intro k hk
    rcases k with (⟨p⟩ | _) | ⟨⟩ <;> (try cases p) <;> simp_all [World.store, World.view, World.revoke, w0]

/-! ## Change 3: a change of representation -/

/-- The correspondence back is a left inverse of the representation at the current epoch. -/
theorem current_at (E : Nat) (t : Tok) : ((t.at E).current E).getD .cap = t := by
  cases t; simp [Tok.at, Tok'.current]

/-- **Representation change transports**: re-issuing the capability's opening under epoch `E` (a
partial correspondence: only epoch-`E` openings name the token) carries the open protocol's
judgment over, and every effect is admissible against the world's epoch-`E` view exactly when it
was against the old view. -/
theorem representation_change_transports (E : Nat) :
    HasProt (spec.mapTok (Tok.at E)) (Ω.mapTok (Tok.at E)) Γ₀ (fun _ _ => True) Φ₀
        (Δ₀.map (Tok.at E)) template ∧
      ∀ (w : World) {i : Phase} (op : Op i),
        admitOp (spec.mapTok (Tok.at E)) (w.viewAt E) (S := sig) op =
          admitOp spec w.view (S := sig) op := by
  refine ⟨hasProt_mapTok (e' := fun t => (t.current E).getD .cap) (current_at E) template_hasProt, fun w _ op => ?_⟩
  cases op <;> simp [admitOp, Spec.mapTok, spec, World.viewAt, Tok.at, Tok'.current]

/-- **A stale opening is refused**: a commitment that presents the capability under an epoch other
than the current one is not admissible, whatever the providers' authority and the nullifier. -/
theorem stale_opening_refused (w : World) {E E' : Nat} (h : E' ≠ E) (p : Provider) :
    admitOp (spec.mapTok (Tok.at E')) (w.viewAt E) (S := sig) (Op.commit p) = false := by
  simp [admitOp, Spec.mapTok, spec, World.viewAt, Tok.at, Tok'.current, h]

/-! ## Change 4: replayed and competing commitments -/

/-- **Competing commitments**: after any successful commitment, no commitment (to either
provider) is admitted: the nullifier is durable. -/
theorem competing_commitments (w w' : World) (p q : Provider)
    (h : w.commit (Op.commit p) = some w') : w'.commit (Op.commit q) = none := by
  unfold World.commit at h
  split at h
  · simp only [spec, Option.some.injEq] at h
    subst h
    simp [World.commit, admitOp, World.view, spec]
  · cases h

/-- **Replay refused**: from day 0 the commitment to `p1` succeeds; replaying it, or committing to
`p2` instead, is refused; the cancellation (which spends nothing) is still admitted. -/
theorem replay_refused :
    (w0.commit (Op.commit .p1)).isSome = true ∧
      (∀ w', w0.commit (Op.commit .p1) = some w' →
        w'.commit (Op.commit .p1) = none ∧ w'.commit (Op.commit .p2) = none ∧
          (w'.commit Op.cancel).isSome = true) := by
  refine ⟨rfl, fun w' h => ⟨competing_commitments _ _ _ _ h, competing_commitments _ _ _ _ h, ?_⟩⟩
  simp only [World.commit] at h
  cases h
  rfl

/-- The internal records the histories leave. -/
theorem internal_of_histories (p : Provider) (b : Bool) :
    Internal.ofHist (lost p) = ⟨true, none⟩ ∧ Internal.ofHist H₀ = ⟨false, none⟩ ∧
      Internal.ofHist (answeredH p b) = ⟨true, some b⟩ := by
  cases p <;> cases b <;> exact ⟨rfl, rfl, rfl⟩

/-- **Internal once is not external once**: the history with the commitment to `p` in flight
(nullifier spent, reply lost) is consistent, under the delivery model, with the service performed
ZERO times and ONE time even by a deduplicating provider; the history with the reply answered is
consistent, without deduplication, with TWO executions. The internal at-most-once consumption alone
concludes neither exactly-once nor at-most-once outside. -/
theorem internal_once_not_external_once (p : Provider) :
    Consistent (Internal.ofHist (lost p)) ⟨0, true⟩ ∧ External.executions ⟨0, true⟩ = 0 ∧
      Consistent (Internal.ofHist (lost p)) ⟨1, true⟩ ∧ External.executions ⟨1, true⟩ = 1 ∧
      Consistent (Internal.ofHist (answeredH p true)) ⟨2, false⟩ ∧
        External.executions ⟨2, false⟩ = 2 ∧
      ¬ ∀ e, Consistent (Internal.ofHist (lost p)) e → e.dedupe = true → e.executions = 1 := by
  obtain ⟨hl, _, ha⟩ := internal_of_histories p true
  rw [hl, ha]
  refine ⟨by simp [Consistent], rfl, by simp [Consistent], rfl, by simp [Consistent], rfl, ?_⟩
  intro h
  have := h ⟨0, true⟩ (by simp [Consistent]) rfl
  simp [External.executions] at this

/-- **What the model CAN conclude, per history**: before dispatch (`H₀`) the service was not
performed; after an ANSWERED commitment, a deduplicating provider performed it exactly once. The
remaining fact (a deduplicating provider performs at most once, whatever the history) is the
provider's, not the history's: it needs no `Consistent` premise. -/
theorem exactly_once_needs_reply_and_dedupe (p : Provider) :
    (∀ e, Consistent (Internal.ofHist H₀) e → e.executions = 0) ∧
      (∀ b e, Consistent (Internal.ofHist (answeredH p b)) e → e.dedupe = true →
        e.executions = 1) ∧
      (∀ e : External, e.dedupe = true → e.executions ≤ 1) := by


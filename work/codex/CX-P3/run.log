mutual
/-- Metavariable renaming distributes over ordinary substitution. -/
theorem mren_substFn (ρ : Nat → Nat) (f : Nat → Tm) :
    ∀ t : Tm, mren ρ (substFn f t) = substFn (fun i => mren ρ (f i)) (mren ρ t)
  | .var _ => rfl

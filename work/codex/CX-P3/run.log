theorem hasSubst_nil (Δ : MEnv) (Γ : Ctx) : HasSubst Δ Γ [] [] :=
  ⟨rfl, fun _ _ _ h _ => by simp at h⟩

theorem hasSubst_cons {Δ : MEnv} {Γ Ψ : Ctx} {s : Tm} {σ : List Tm} {A : Ty}
    (hs : HasTy Δ Γ s A) (hσ : HasSubst Δ Γ σ Ψ) : HasSubst Δ Γ (s :: σ) (A :: Ψ) := by

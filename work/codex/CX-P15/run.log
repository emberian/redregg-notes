"""gates/closure.py TREE — the module-graph gate. Red on:

  C0 a lakefile.lean form tree.lakefile does not know, or a package without
     autoImplicit = false, relaxedAutoImplicit = false, warningAsError = true;
  C1 a .lean file outside a declared lib (a lib is `[[lean_lib]] name = X, globs = ["X.+"]`
     and owns exactly the directory X/), or a lib that is not rooted that way;
  C2 an import that is neither a tree module nor Init/Std (Lean only from Census);
  C3 a def-module exporting a theorem, or a proof-module (a `Proofs` path component)
     exporting a definition whose type is not `Prop`; private helpers are allowed on either
     side; statements (a declaration whose result type is Prop: `structure Checked … : Prop`,
     `inductive HasType : … → Prop`, `def P : X → Prop`) live in proof-modules, and a
     def-module exporting one is red;
  C4 a def-module importing a proof-module;
  C5 a module outside Census importing Census;
  C6 a lean_exe root that is a proof-module or not a tree module;
  C7 a lean_exe root that declares anything but `main` (logic lives in a lib module, which the
     census sees; the census skips exe roots, so two exes' `main`s never meet);
  C8 a C source outside an extern_lib's <Lib>/c directory, or an extern_lib directory that is
     not <Lib>/c of a declared lib.
  C9 a deployed def-module (neither a proof-module nor tooling, tree.Module.is_tooling)
     importing a tooling module: the size ratchet's deployed count excludes tooling, so deployed
     code may not depend on it.
  C10 a module outside Ops importing an Ops module: Ops is a renderer and driver over the
     Host/Protocol/Client tables, never an "ops utilities" hub (ROOT 10-17, OPS's request).
"""
import os
import sys

import tree


OPTIONS = ("⟨`autoImplicit, false⟩", "⟨`relaxedAutoImplicit, false⟩", "⟨`warningAsError, true⟩")


def check(t: tree.Tree) -> list[str]:
    red = [f"C0 lakefile.lean: {e}" for e in t.lake.get("errors", [])]
    for o in OPTIONS:
        if o not in t.lake.get("options", ""):
            red.append(f"C0 lakefile.lean: package leanOptions must contain {o}")
    libs = {}
    for lib in t.lake.get("lean_lib", []):
        name = lib["name"]
        if lib.get("globs") != [f"{name}.+"] or "roots" in lib:
            red.append(f"C1 lib {name}: must be rooted by globs = [\"{name}.+\"] and nothing else")
        libs[name] = lib
    for m in t.modules.values():
        if "." not in m.name:
            red.append(f"C1 {m.path}: a top-level module is an umbrella hub; put it in a layer directory")
        elif m.lib not in libs:
            red.append(f"C1 {m.path}: directory {m.lib}/ is not a declared lean_lib in lakefile.lean")
    for m in t.modules.values():
        for i in m.imports:
            root = i.split(".")[0]
            if i in t.modules:
                target = t.modules[i]
                if not m.is_proof and target.is_proof:
                    red.append(f"C4 {m.name} (def-module) imports proof-module {i}")
                if not m.is_proof and not m.is_tooling and target.is_tooling:
                    red.append(f"C9 {m.name} (deployed) imports tooling module {i}")
                if target.lib == "Ops" and m.lib != "Ops":
                    red.append(f"C10 {m.name} imports {i}: Ops renders and drives the other layers' tables, nothing depends on it")
                if target.lib == "Census" and m.lib != "Census":
                    red.append(f"C5 {m.name} imports {i}: Census is build tooling, never a dependency")
            elif root in ("Init", "Std"):
                pass
            elif root == "Lean" and m.lib == "Census":
                pass
            else:
                red.append(f"C2 {m.name} imports {i}: not a tree module and not Init/Std")
        for d in m.decls:
            if d.private or d.kind in ("example", "axiom"):
                continue  # example/axiom are refusals.py's
            if m.is_proof and d.kind in tree.DEF_KINDS and not d.is_prop:
                red.append(f"C3 {m.path}:{d.line} proof-module exports {d.kind} {d.name}")
            if not m.is_proof and d.kind in tree.DEF_KINDS and d.is_prop:
                red.append(f"C3 {m.path}:{d.line} def-module exports statement {d.kind} {d.name} (its type is "
                           f"Prop); statements belong in a Proofs module")
            if not m.is_proof and d.kind in tree.THEOREM_KINDS:
                red.append(f"C3 {m.path}:{d.line} def-module exports theorem {d.name}; "
                           f"move it to a Proofs module or make it private")
    for exe, root in t.exes.items():
        if root not in t.modules:
            red.append(f"C6 lean_exe {exe}: root {root} is not a tree module")
        elif t.modules[root].is_proof:
            red.append(f"C6 lean_exe {exe}: root {root} is a proof-module")
        else:
            others = [f"{d.kind} {d.name}" for d in t.modules[root].decls if not (d.kind == "def" and d.name == "main")]
            if others or not any(d.name == "main" for d in t.modules[root].decls):
                red.append(f"C7 lean_exe {exe}: root {root} must declare only `main` "
                           f"(found: {', '.join(others) or 'no main'})")
    cdirs = set()
    for ext in t.lake.get("extern_lib", []):
        for d in ext["cdirs"]:
            if d.split("/")[0] not in libs or d != d.split("/")[0] + "/c":
                red.append(f"C8 extern_lib {ext['name']}: {d} is not <Lib>/c of a declared lib")
            cdirs.add(d)
    for d, dirs, files in os.walk(t.root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith((".c", ".h", ".cc", ".cpp", ".m")):
                rel = os.path.relpath(os.path.join(d, f), t.root)
                if os.path.dirname(rel) not in cdirs:
                    red.append(f"C8 {rel}: C source outside every extern_lib directory")
    return red


if __name__ == "__main__":
    red = check(tree.read(sys.argv[1] if len(sys.argv) > 1 else "."))
    for r in red:
        print(r)
    print(f"closure: {'RED' if red else 'ok'} ({len(red)})")
    sys.exit(1 if red else 0)
"""gates/size.py TREE [--write] — the size ratchet (law 12).

Two files, two roles:
  gates/ceilings.tsv  hand-edited, `metric<TAB>ceiling<TAB>why`: the bounds, and the only input;
  SIZE.md             generated (`--write`; scripts/commit writes it for every candidate and
                      refuses it as a PATH): every measured metric, its value, its ceiling.
Red on:
  - SIZE.md differing from the view generated for the tree;
  - a measured value above its ceiling;
  - a value above the PARENT TREE's measurement without `SIZE: <metric>: <why>` in the message;
  - a ceiling raised, or a ceiling row removed, against the parent's gates/ceilings.tsv without
    `SIZE-CEILING: <metric>: <why>`;
  - a malformed ceilings.tsv row.
A ceiling on a metric nothing measures prints `WARN unmeasured`, which scripts/standing.sh turns
into an INCOMPLETE verdict (a ceiling over nothing checks nothing). Metrics this script cannot
measure come from executables in gates/metrics/, each printing `<metric>\t<integer>` lines.
"""
import argparse
import os
import re
import subprocess
import sys

import tree

# The deployed Host exe (lakefile `lean_exe «host»`, HOST-17). When it is absent the closure row is
# not measured (WARN unmeasured: a ceiling over nothing checks nothing), never measured as 0.
HOST_EXE = "host"


# A file Emit/Rust.lean wrote starts with its stable marker (CODEC 23a1445), and is registered in
# gates/generated.tsv, whose rows `lake exe emit-rust --check` gates. The client/src ceilings bound
# hand-written Rust (CLIENT-1, ROOT 10-16), so it excludes generated files; `Rust lines (generated)`
# keeps their growth visible. Only a REGISTERED file with the header counts as generated: a
# hand-written file that copies the header is counted as hand-written AND shows in the ceiling-0 row
# `Rust files with an unregistered generated header`.
GENERATED = re.compile(r"^// GENERATED by emit-rust\b.* — do not edit$")


def registered(root: str) -> set[str]:
    p = os.path.join(root, "gates", "generated.tsv")
    if not os.path.isfile(p):
        return set()
    rows = (l.split("\t") for l in open(p, encoding="utf-8") if l.strip() and not l.startswith("#"))
    return {os.path.normpath(r[1].strip()) for r in rows if len(r) > 1}


def source_files(root: str, exts: tuple[str, ...]):
    """(path relative to root, line count) for each file below root ending in one of exts. Only
    directories BELOW root are skipped by name: a gate tree itself lives under `.git/`."""
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith(exts):
                with open(os.path.join(d, f), encoding="utf-8", errors="replace") as fh:
                    yield os.path.relpath(os.path.join(d, f), root), sum(1 for _ in fh)


def rust_files(root: str, sub: str = ""):
    """(path relative to root, line count, has the generated header) for each .rs under root/sub."""
    for d, dirs, files in os.walk(os.path.join(root, sub)):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            if f.endswith(".rs"):
                path = os.path.join(d, f)
                with open(path, encoding="utf-8", errors="replace") as fh:
                    lines = fh.readlines()
                header = bool(lines) and bool(GENERATED.match(lines[0].rstrip("\n")))
                yield os.path.normpath(os.path.relpath(path, root)), len(lines), header


def rust_lines(root: str) -> int:
    return sum(n for _, n, _ in rust_files(root))


# Constructor-count metrics (ROOT ruling 2026-10-16: PROTOCOL's rows are computed, never hand
# rows): metric -> [(module prefix, inductive name)]; a missing module counts 0.
CONSTRUCTORS = {
    "protocol operations": [("Protocol.Table", "Op")],
    "call kinds (Receive.Body constructors)": [("Kernel.Receive", "Body")],
    "command verbs (the one command language)": [("Protocol.Command", "Verb")],
    "refusal constructors": [("Kernel.World", "Reject"), ("Kernel.Receive", "Refusal")],
    "protocol status codes": [("Protocol.Table", "Status")],
    "protocol step codes": [("Protocol.Table", "Step")],
}


def list_len(t: tree.Tree, module: str, name: str) -> int | None:
    """Elements of `def NAME : List … := [a, b, …]` in MODULE (the conformance rows are
    `Protocol.Rows.rows`); None when the module or the definition is absent."""
    m = t.modules.get(module)
    hit = m and re.search(r"(?m)^def[ \t]+" + re.escape(name) + r"[ \t]*:[^=]*:=\s*\[([^\]]*)\]", m.code)
    if not hit:
        return None
    return len([x for x in hit.group(1).split(",") if x.strip()])


def constructors(t: tree.Tree, prefix: str, name: str) -> int:
    n = 0
    for m in t.modules.values():
        if m.is_proof or not (m.name == prefix or m.name.startswith(prefix + ".")):
            continue
        for hit in re.finditer(r"(?m)^[ \t]*(?:(?:private|protected)[ \t]+)?inductive[ \t]+" + re.escape(name) + r"\b", m.code):
            body = []
            for line in m.code[hit.end():].split("\n")[1:]:
                if line and not line[0].isspace() or re.match(r"\s*deriving\b", line):
                    break
                body.append(line)
            n += sum(len(re.findall(r"(?:^|\s)\|\s*[\w«]", l)) for l in body)
    return n


def measure(t: tree.Tree) -> dict[str, int]:
    mods = t.modules.values()
    out = {}
    host = t.exes.get(HOST_EXE)
    if host:
        out["Lean modules in the Host closure"] = len(t.closure([host]))
    out["Lean modules"] = len(t.modules)
    out["Lean proof-modules"] = sum(1 for m in mods if m.is_proof)
    for lib in sorted(set(m.lib for m in mods)):
        out[f"Lean lines ({lib})"] = sum(m.lines for m in mods if m.lib == lib)
    # Deployed = definitions that are not tooling; tooling (the sims, rows, journeys, census and
    # emitter: tree.Module.is_tooling) is informational, and closure C9 keeps it out of deployed
    # imports. Proof-modules are in neither.
    out["Lean lines (deployed)"] = sum(m.lines for m in mods if not m.is_proof and not m.is_tooling)
    out["Lean lines (tooling: Sim, Rows, Journey, Census, Emit, Ops, Bench)"] = sum(
        m.lines for m in mods if not m.is_proof and m.is_tooling)
    deps = t.dependents()
    found = foundations(t)
    out["foundation modules"] = len(found)
    out["max dependents of a non-foundation module"] = max(
        (len(v) for m, v in deps.items() if m not in found), default=0)
    out["theorems"] = sum(1 for m in mods for d in m.decls if d.kind in tree.THEOREM_KINDS)
    out["partial defs (deployed)"] = sum(1 for m in mods for d in m.decls if d.partial)
    out["sorry"] = sum(len(re.findall(r"\bsorry\b", m.code)) for m in mods)
    out["native (extern/implemented_by)"] = sum(
        len(re.findall(r"@\[[^\]]*\b(?:implemented_by|extern)\b", m.code)) for m in mods)
    out["C lines"] = sum(n for _, n in source_files(t.root, (".c", ".h")))
    out["Rust lines"] = rust_lines(t.root)
    gen = registered(t.root)
    rs = list(rust_files(t.root))
    # client/src, hand-written only, in three parts (ROOT 10-17): each binary is bounded alone, and
    # the library is EVERYTHING else under client/src, so a new file (or binary) cannot escape a row.
    hand = {p: n for p, n, h in rs
            if p.startswith(os.path.join("client", "src") + os.sep) and not (h and p in gen)}
    bins = {"Rust lines (nd)": os.path.join("client", "src", "bin", "nd.rs"),
            "Rust lines (nd-supervise)": os.path.join("client", "src", "bin", "nd-supervise.rs")}
    for metric, path in bins.items():
        out[metric] = hand.get(path, 0)
    out["Rust lines (client library)"] = sum(n for p, n in hand.items() if p not in bins.values())
    # attach/ is its own program (ROOT 10-17): the ssh forced-command endpoint, its own row.
    out["Rust lines (attach/src)"] = sum(
        n for p, n, h in rs if p.startswith(os.path.join("attach", "src") + os.sep) and not (h and p in gen))
    out["Rust lines (generated)"] = sum(n for p, n, h in rs if h and p in gen)
    out["Rust files with an unregistered generated header"] = sum(
        1 for p, _, h in rs if h and p not in gen)
    for metric, sources in CONSTRUCTORS.items():
        out[metric] = sum(constructors(t, p, n) for p, n in sources)
    rows = list_len(t, "Protocol.Rows", "rows")
    if rows is not None:
        out["conformance rows"] = rows
    mdir = os.path.join(t.root, "gates", "metrics")
    if os.path.isdir(mdir):
        for f in sorted(os.listdir(mdir)):
            p = os.path.join(mdir, f)
            if os.access(p, os.X_OK) and os.path.isfile(p):
                r = subprocess.run([p, t.root], capture_output=True, text=True, timeout=120)
                if r.returncode != 0:
                    raise SystemExit(f"size: gates/metrics/{f} failed: {r.stderr.strip()}")
                for line in r.stdout.splitlines():
                    k, v = line.split("\t")
                    out[k] = int(v)
    return out



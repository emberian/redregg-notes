/-- The explicit residual obligations of a repair are those of a full re-check. -/
theorem repair_residual {Name Key V : Type} [DecidableEq Key]
    (fs : List (Frag Name Key V)) (hfs : ∀ f ∈ fs, f.ReadsOnly) {changed : List Key}
    {w₁ w₂ : Key → V} (hout : ∀ k, k ∉ changed → w₁ k = w₂ k) :
    residual fs (repair fs (fromScratch fs w₁) changed w₂) = residual fs (fromScratch fs w₂) := by
  rw [repair_agrees_from_scratch fs hfs hout]

/-- **Repair reads only the affected fragments**: two new worlds on which every AFFECTED fragment
checks alike yield the same repair; the unaffected verdicts are reused, never recomputed. -/
theorem repair_reuses {Name Key V : Type} [DecidableEq Key] (fs : List (Frag Name Key V))
    (cache : List Bool) (hlen : cache.length = fs.length) (changed : List Key) {w w' : Key → V}
    (h : ∀ f ∈ fs, f.affected changed = true → f.check w = f.check w') :
    repair fs cache changed w = repair fs cache changed w' := by
  induction fs generalizing cache with
  | nil => rfl
  | cons f fs ih =>
    have ih' := fun c hc => ih c hc (fun g hg => h g (by simp [hg]))
    cases cache with
    | nil => cases hlen
    | cons c cs =>
      simp only [repair]
      rw [ih' cs (by simpa using hlen)]
      congr 1
      cases ha : f.affected changed with
      | true => simp [h f (by simp) ha]
      | false => rfl

/-! ## Representation change -/

theorem count_map_inj {α β : Type} [DecidableEq α] [DecidableEq β] {e : α → β} {e' : β → α}
    (h₁ : ∀ a, e' (e a) = a) (l : List α) (a : α) : (l.map e).count (e a) = l.count a := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    simp only [List.map_cons, List.count_cons, ih]
    by_cases hx : x = a
    · subst hx; simp
    · have hex : e x ≠ e a := fun h => hx (by rw [← h₁ x, h, h₁])
      simp [hx, hex]

/-- Renaming along a map with a left inverse (injective) preserves bag inclusion. -/
theorem SubBag.map [DecidableEq Tok] {Tok' : Type} [DecidableEq Tok'] {e : Tok → Tok'}
    {e' : Tok' → Tok} (h₁ : ∀ a, e' (e a) = a) {Δ₁ Δ₂ : List Tok} (h : SubBag Δ₁ Δ₂) :
    SubBag (Δ₁.map e) (Δ₂.map e) := by
  intro b
  by_cases hb : ∃ a, e a = b
  · obtain ⟨a, rfl⟩ := hb
    rw [count_map_inj h₁, count_map_inj h₁]
    exact h a
  · have hn : b ∉ Δ₁.map e := fun hm => hb (by
      obtain ⟨a, _, ha⟩ := List.mem_map.mp hm
      exact ⟨a, ha⟩)
    rw [List.count_eq_zero.mpr hn]
    exact Nat.zero_le _

theorem map_erase_bij {α β : Type} [DecidableEq α] [DecidableEq β] {e : α → β} {e' : β → α}
    (h₁ : ∀ a, e' (e a) = a) (l : List α) (a : α) : (l.erase a).map e = (l.map e).erase (e a) := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    by_cases hx : x = a
    · subst hx; simp
    · have hex : e x ≠ e a := fun h => hx (by rw [← h₁ x, h, h₁])
      simp [hx, hex, ih]

/-- **Representation change transports the judgment**: renaming every token along a checked
correspondence (a map with a left inverse, so possibly PARTIAL on the new side: stale
representations need not name anything) carries a judged protocol to a judged protocol over the
new representation, its tokens renamed. -/
theorem hasProt_mapTok {Tok' : Type} [DecidableEq Tok] [DecidableEq Tok']
    {e : Tok → Tok'} {e' : Tok' → Tok} (h₁ : ∀ a, e' (e a) = a)
    {sp : Spec S Tok Fact Ob} {Ω : Ctx S Hole A Tok Fact Ob} {Γ : List Fact}
    {Q : (j : Ix) → A j → Prop} {Φ : List Ob} {Δ : List Tok} {i : Ix} {P : Prot S Hole A i}
    (h : HasProt sp Ω Γ Q Φ Δ P) : HasProt (sp.mapTok e) (Ω.mapTok e) Γ Q Φ (Δ.map e) P := by
  induction h with
  | ret a hq => exact .ret a hq
  | call op k hc hr he _ ih =>
    exact .call op k (by simp [Spec.mapTok, hc]) hr he ih
  | @spend Δ i op k t hc ht hr he _ ih =>
    refine .spend op k (e t) (by simp [Spec.mapTok, hc]) (List.mem_map_of_mem ht) hr he ?_
    intro r
    have := ih r
    rwa [map_erase_bij h₁] at this
  | hole h I hI hp hctx hneed hpost howes =>
    refine .hole h (I.mapTok e) (by simp [Ctx.mapTok, hI]) hp hctx ?_ hpost howes
    exact SubBag.map h₁ hneed

/-- **Representation change transports admission**: an effect is admissible over the renamed
tokens, against the view read back through the correspondence, exactly when it was before. -/
theorem admitOp_mapTok {Tok' : Type} {e : Tok → Tok'} {e' : Tok' → Tok}
    (h₁ : ∀ a, e' (e a) = a) (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix}
    (op : S.Op i) :
    admitOp (sp.mapTok e) ⟨v.holds, fun b => v.live (e' b)⟩ op = admitOp sp v op := by
  unfold admitOp Spec.mapTok
  cases hc : sp.consumes op <;> simp [hc, h₁]

end

/-! ## Shared parameters -/

/-- **Separate witnesses are insufficient** (doc 2 section 4), a SCALAR ILLUSTRATION with `θ` a
price: each party's condition has a witness, and the completion space is empty:
`(∃x B x) ∧ (∃x S x) ⇏ ∃x (B x ∧ S x)`. The form over substitutions of an open protocol is
`Negotiation.separate_witnesses_over_substitutions`. -/
theorem separate_witnesses_insufficient :
    (∃ x, priceConds.guards x) ∧ (∃ x, priceConds.authority x) ∧ ¬ ∃ x, priceConds.space x := by
  refine ⟨⟨5, Nat.le_refl 5⟩, ⟨7, Nat.le_refl 7⟩, ?_⟩
  rintro ⟨x, _, hb, hs, _⟩
  have hb' : x ≤ 5 := hb
  have hs' : 7 ≤ x := hs
  omega

/-- The general form: per-condition witnesses never compose into a completion. -/
theorem witnesses_do_not_compose :
    ¬ ∀ (B S : Nat → Prop), (∃ x, B x) → (∃ x, S x) → ∃ x, B x ∧ S x := by
  intro h
  obtain ⟨x, hb, hs⟩ := h priceConds.guards priceConds.authority
    separate_witnesses_insufficient.1 separate_witnesses_insufficient.2.1
  exact separate_witnesses_insufficient.2.2 ⟨x, trivial, hb, hs, trivial⟩

/-- The same instance, decided over a bounded price range. -/
theorem separate_witnesses_bounded :
    (∃ x : Fin 20, x.val ≤ 5) ∧ (∃ x : Fin 20, 7 ≤ x.val) ∧ ¬ ∃ x : Fin 20, x.val ≤ 5 ∧ 7 ≤ x.val := by
  decide

/-! ## Search state versus logical status -/

/-- **Greedy versus logical** (doc 2 section 4, the matcher), an ILLUSTRATION over number lists,
not over protocols: offers `[100, 50]`, wants `[50, 100]`:
first-fit satisfies one want of two, while a complete assignment (want 0 ← offer 1, want 1 ← offer
0) exists and complete search finds it. -/
theorem greedy_vs_logical :
    firstFit [100, 50] [50, 100] = 1 ∧ coverAll [100, 50] [50, 100] = true ∧
      Assigns [100, 50] [50, 100] [1, 0] := by
  refine ⟨by decide, by decide, ?_⟩
  unfold Assigns
  decide

/-- **Search state is not logical status**: a greedy shortfall does not refute the intent. -/
theorem search_state_ne_logical_status :
    ¬ ∀ offers wants : List Nat, firstFit offers wants < wants.length →
      ¬ ∃ picks, Assigns offers wants picks := by
  intro h
  exact h [100, 50] [50, 100] (by decide) ⟨[1, 0], greedy_vs_logical.2.2⟩

/-! ## A hole is not an interaction (doc 2 section 5) -/

namespace Coin

/-- Running the open plan under a filling: the filling's answer, compared with the peer's bit. -/
theorem wins_planHole (θ : Subst sig HoleN Res) (b : Bool) :
    wins b (subst θ planHole) () =
      match θ .revealed () with
      | some (.ret c) => c == b
      | _ => false := by
  have e : wins b (subst θ planHole) () =
      wins b (subst θ (Prot.hole (S := sig) (A := Res) (i := Phase.revealed) ())) () := rfl
  rw [e]
  cases hθ : θ .revealed () with
  | none => simp only [subst, hθ]; rfl
  | some f =>
    cases f with
    | ret c => simp only [subst, hθ]; rfl
    | call op k => exact nomatch op
    | hole h => simp only [subst, hθ]; rfl

/-- **No foresight, for a response-free naming**: `planHole` names its hole `()` in BOTH branches of
the peer's bit. For every environment SOME filling wins (`∀ E ∃ θ, Success (P[θ], E)`), but no
single filling wins against every environment (`¬ ∃ θ ∀ E`): the "commit a bit before you reveal
yours" game. This holds BECAUSE of the naming: with names that depend on the response the opposite
holds (`response_indexed_names_have_foresight`), and `foresight_iff_names_separate` is the exact
condition. Scope (one filling into every branch unchanged) is a naming discipline, not a fact of
the calculus. -/
theorem no_foresight :
    (∀ b, ∃ θ, wins b (subst θ planHole) () = true) ∧
      ¬ ∃ θ, ∀ b, wins b (subst θ planHole) () = true := by
  refine ⟨fun b => ⟨answer b, by rw [wins_planHole]; cases b <;> rfl⟩, ?_⟩
  rintro ⟨θ, hθ⟩
  have h0 := hθ false
  have h1 := hθ true
  rw [wins_planHole] at h0 h1
  cases hr : θ .revealed () with
  | none => simp [hr] at h0
  | some f =>
    cases f with
    | ret c => cases c <;> simp [hr] at h0 h1
    | call op k => exact nomatch op
    | hole h => simp [hr] at h0

/-- **The response-dependent continuation succeeds**: the same game with the answer written as
the continuation of the `call` (a family over the response) wins against every environment. -/
theorem response_dependent_succeeds : ∀ b, wins b planCall () = true := by
  intro b; cases b <;> rfl

/-- Running a named template under a filling: the filling of branch `b`'s hole, compared with `b`. -/
theorem wins_planNamed {Hn : Phase → Type} (name : Bool → Hn .revealed) (θ : Subst sig Hn Res)
    (b : Bool) :
    wins b (subst θ (planNamed name)) () =
      match θ .revealed (name b) with
      | some (.ret c) => c == b
      | _ => false := by
  have e : wins b (subst θ (planNamed name)) () =
      wins b (subst θ (Prot.hole (S := sig) (A := Res) (i := Phase.revealed) (name b))) () := rfl
  rw [e]
  cases hθ : θ .revealed (name b) with
  | none => simp only [subst, hθ]; rfl
  | some f =>
    cases f with
    | ret c => simp only [subst, hθ]; rfl
    | call op k => exact nomatch op
    | hole h => simp only [subst, hθ]; rfl

/-- **Foresight exactly when the names separate**: a single filling chosen before the reveal wins
against every bit iff the template gives the two branches DIFFERENT hole names. A response-free
naming (`name true = name false`) leaves no causal strategy; a response-indexed one is a filling
per response. -/
theorem foresight_iff_names_separate {Hn : Phase → Type} [DecidableEq (Hn .revealed)]
    (name : Bool → Hn .revealed) :
    (∃ θ : Subst sig Hn Res, ∀ b, wins b (subst θ (planNamed name)) () = true) ↔
      name true ≠ name false := by
  constructor
  · rintro ⟨θ, hθ⟩ heq
    have h0 := hθ false
    have h1 := hθ true
    rw [wins_planNamed] at h0 h1
    rw [heq] at h1
    cases hr : θ .revealed (name false) with
    | none => simp [hr] at h0
    | some f =>
      cases f with
      | ret c => cases c <;> simp [hr] at h0 h1
      | call op k => exact nomatch op
      | hole h => simp [hr] at h0
  · intro hne
    refine ⟨fun i => match i with
      | .waiting => fun _ => none
      | .revealed => fun n => some (.ret (decide (n = name true))), fun b => ?_⟩
    rw [wins_planNamed]
    cases b with
    | true => simp
    | false => simp [Ne.symm hne]

/-- **Response-indexed names have foresight**: `call recv (fun b => hole b)` (one hole name per bit,
well typed) admits ONE filling that wins against every environment. A hole whose name depends on the
response is a family over the response, exactly like a `call` continuation. -/
theorem response_indexed_names_have_foresight :
    ∃ θ : Subst sig HoleB Res, ∀ b, wins b (subst θ (planNamed (Hn := HoleB) fun b => b)) () = true :=
  (@foresight_iff_names_separate HoleB (inferInstanceAs (DecidableEq Bool)) fun b => b).mpr
    (by intro h; cases h)

/-- `planHole` is the response-free naming. -/
theorem planHole_named : planHole = planNamed (Hn := HoleN) fun _ => () := rfl

/-- **A `theirs` hole is never planned**: declared `theirs`, the hole is never filled by our plan, so
every run of the open plan stops at the hole. It "loses" only because `wins` scores a stuck run as
`false`: the theorem says the planner cannot win by filling, not that the peer wins. -/
/-
# Lang.Proofs.Contextual.LangInstance — the laws of `Lang.Term` as a `Calculus` (ACTIVITIES-2)

`langLaws : CalculusLaws langData LangHasTy`. `LangHasTy Ω Γ t T` asks every hole's context to be
empty, every `ref` to be a declared hole, and `t` typed by `Lang.HasType` with the holes as the
package types (`ΔOf Ω`). Law by law:

| law | Lang theorem |
|---|---|
| `msubst_lemma` | `fillRefs_typed` + `usesRef_fillRefs` + `tyOf_filter` + `ΔOf_getElem?` |
| `check_sound`, `check_complete` | `Lang.infer_sound`, `Lang.infer_complete` (+ `hasType_usesRef` for the refs) |
| `strengthen_lemma` | `hasType_unshiftAt` (+ `usesRef_renameVar`) |
| `strengthen_factor` | `shiftAt_unshiftAt` |
| `weaken_avoids` | `usesVar_shiftAt` (holds without the typing premise) |
| `hasTy_var` | `HasType.var` |
| `uses_var` | `Term.usesVar` on `var` |

The REACH theorem `langTemplate_no_hyps`: in every template typed by `LangHasTy`, every hole has
no token-backed hypothesis, so the closure's strengthening outcome, its alternative-by-hypothesis
outcome and its hypothesis-derived supports are EMPTY on every Lang template (the closed-hole
fragment; the CMTT instance `cmttLaws` is where they are exercised).
-/
import Lang.Contextual.LangCalculus
import Lang.Proofs.Check
import Lang.Proofs.Load
import Lang.Proofs.Contextual.Core
import Lang.Proofs.Contextual.ClosureStatements

namespace Nanodregg.Lang.Contextual

/-! ## Row shapes -/

theorem renameVarRow_ascending (ρ : Nat → Nat) :
    ∀ fs : List (Label × Term), Row.ascending (Term.renameVarRow ρ fs) = Row.ascending fs
  | [] => rfl
  | [_] => rfl
  | (a, s) :: (b, t) :: rest => by
      have ih := renameVarRow_ascending ρ ((b, t) :: rest)
      simp only [Term.renameVarRow] at ih ⊢
      simp only [Row.ascending, ih]

theorem fillRefsRow_ascending (σ : Nat → Option Term) :
    ∀ fs : List (Label × Term), Row.ascending (Term.fillRefsRow σ fs) = Row.ascending fs
  | [] => rfl
  | [_] => rfl
  | (a, s) :: (b, t) :: rest => by
      have ih := fillRefsRow_ascending σ ((b, t) :: rest)
      simp only [Term.fillRefsRow] at ih ⊢
      simp only [Row.ascending, ih]

/-! ## Renaming composes -/

mutual
theorem renameVar_renameVar (ρ ρ' : Nat → Nat) : ∀ t : Term,
    Term.renameVar ρ (Term.renameVar ρ' t) = Term.renameVar (fun i => ρ (ρ' i)) t
  | .var _ | .nat _ | .bool _ | .bytes _ | .digest _ | .ref _ | .refuse _ _ => rfl
  | .lam _ b => by simp only [Term.renameVar, renameVar_renameVar (upR ρ) (upR ρ') b, upR_upR]
  | .app f a => by
    simp only [Term.renameVar, renameVar_renameVar ρ ρ' f, renameVar_renameVar ρ ρ' a]
  | .fix t => by simp only [Term.renameVar, renameVar_renameVar ρ ρ' t]
  | .prim _ a b => by
    simp only [Term.renameVar, renameVar_renameVar ρ ρ' a, renameVar_renameVar ρ ρ' b]
  | .record fs => by simp only [Term.renameVar, renameVarRow_renameVarRow ρ ρ' fs]
  | .get t _ => by simp only [Term.renameVar, renameVar_renameVar ρ ρ' t]
  | .extend t fs => by
    simp only [Term.renameVar, renameVar_renameVar ρ ρ' t, renameVarRow_renameVarRow ρ ρ' fs]
  | .inj _ _ t => by simp only [Term.renameVar, renameVar_renameVar ρ ρ' t]
  | .case t as => by
    simp only [Term.renameVar, renameVar_renameVar ρ ρ' t, renameVarArms_renameVarArms ρ ρ' as]
  | .ite c a b => by
    simp only [Term.renameVar, renameVar_renameVar ρ ρ' c, renameVar_renameVar ρ ρ' a,
      renameVar_renameVar ρ ρ' b]
theorem renameVarRow_renameVarRow (ρ ρ' : Nat → Nat) : ∀ fs : List (Label × Term),
    Term.renameVarRow ρ (Term.renameVarRow ρ' fs) = Term.renameVarRow (fun i => ρ (ρ' i)) fs
  | [] => rfl
  | (_, t) :: fs => by
    simp only [Term.renameVarRow, renameVar_renameVar ρ ρ' t, renameVarRow_renameVarRow ρ ρ' fs]
theorem renameVarArms_renameVarArms (ρ ρ' : Nat → Nat) : ∀ as : List (Label × Term),
    Term.renameVarArms ρ (Term.renameVarArms ρ' as) = Term.renameVarArms (fun i => ρ (ρ' i)) as
  | [] => rfl
  | (_, t) :: as => by
    simp only [Term.renameVarArms, renameVar_renameVar (upR ρ) (upR ρ') t, upR_upR,
      renameVarArms_renameVarArms ρ ρ' as]
end

mutual
theorem renameVar_id : ∀ t : Term, Term.renameVar (fun i => i) t = t
  | .var _ | .nat _ | .bool _ | .bytes _ | .digest _ | .ref _ | .refuse _ _ => rfl
  | .lam _ b => by simp only [Term.renameVar, upR_id, renameVar_id b]
  | .app f a => by simp only [Term.renameVar, renameVar_id f, renameVar_id a]
  | .fix t => by simp only [Term.renameVar, renameVar_id t]
  | .prim _ a b => by simp only [Term.renameVar, renameVar_id a, renameVar_id b]
  | .record fs => by simp only [Term.renameVar, renameVarRow_id fs]
  | .get t _ => by simp only [Term.renameVar, renameVar_id t]
  | .extend t fs => by simp only [Term.renameVar, renameVar_id t, renameVarRow_id fs]
  | .inj _ _ t => by simp only [Term.renameVar, renameVar_id t]
  | .case t as => by simp only [Term.renameVar, renameVar_id t, renameVarArms_id as]
  | .ite c a b => by simp only [Term.renameVar, renameVar_id c, renameVar_id a, renameVar_id b]
theorem renameVarRow_id : ∀ fs : List (Label × Term), Term.renameVarRow (fun i => i) fs = fs
  | [] => rfl
  | (_, t) :: fs => by simp only [Term.renameVarRow, renameVar_id t, renameVarRow_id fs]
theorem renameVarArms_id : ∀ as : List (Label × Term), Term.renameVarArms (fun i => i) as = as
  | [] => rfl
  | (_, t) :: as => by simp only [Term.renameVarArms, upR_id, renameVar_id t, renameVarArms_id as]
end

/-! ## A renaming acts only through the variables a term uses -/

mutual
theorem renameVar_congr : ∀ (t : Term) (ρ ρ' : Nat → Nat),
    (∀ k, Term.usesVar k t = true → ρ k = ρ' k) → Term.renameVar ρ t = Term.renameVar ρ' t
  | .var i, ρ, ρ', h => by simp only [Term.renameVar, h i (by simp [Term.usesVar])]
  | .nat _, _, _, _ | .bool _, _, _, _ | .bytes _, _, _, _ | .digest _, _, _, _
  | .ref _, _, _, _ | .refuse _ _, _, _, _ => rfl
  | .lam _ b, ρ, ρ', h => by
    have h' : ∀ k, Term.usesVar k b = true → upR ρ k = upR ρ' k := by
      intro k hk; cases k with
      | zero => rfl
      | succ j => simp only [upR, h j (by simpa [Term.usesVar] using hk)]
    simp only [Term.renameVar, renameVar_congr b _ _ h']
  | .app f a, ρ, ρ', h => by
    simp only [Term.renameVar,
      renameVar_congr f ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk]),
      renameVar_congr a ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .fix t, ρ, ρ', h => by
    simp only [Term.renameVar, renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .prim _ a b, ρ, ρ', h => by
    simp only [Term.renameVar,
      renameVar_congr a ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk]),
      renameVar_congr b ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .record fs, ρ, ρ', h => by
    simp only [Term.renameVar,
      renameVarRow_congr fs ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .get t _, ρ, ρ', h => by
    simp only [Term.renameVar, renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .extend t fs, ρ, ρ', h => by
    simp only [Term.renameVar,
      renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk]),
      renameVarRow_congr fs ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .inj _ _ t, ρ, ρ', h => by
    simp only [Term.renameVar, renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .case t as, ρ, ρ', h => by
    simp only [Term.renameVar,
      renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk]),
      renameVarArms_congr as ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
  | .ite c a b, ρ, ρ', h => by
    simp only [Term.renameVar,
      renameVar_congr c ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk]),
      renameVar_congr a ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk]),
      renameVar_congr b ρ ρ' fun k hk => h k (by simp [Term.usesVar, hk])]
theorem renameVarRow_congr : ∀ (fs : List (Label × Term)) (ρ ρ' : Nat → Nat),
    (∀ k, Term.usesVarRow k fs = true → ρ k = ρ' k) →
      Term.renameVarRow ρ fs = Term.renameVarRow ρ' fs
  | [], _, _, _ => rfl
  | (_, t) :: fs, ρ, ρ', h => by
    simp only [Term.renameVarRow,
      renameVar_congr t ρ ρ' fun k hk => h k (by simp [Term.usesVarRow, hk]),
      renameVarRow_congr fs ρ ρ' fun k hk => h k (by simp [Term.usesVarRow, hk])]
theorem renameVarArms_congr : ∀ (as : List (Label × Term)) (ρ ρ' : Nat → Nat),
    (∀ k, Term.usesVarArms k as = true → ρ k = ρ' k) →
      Term.renameVarArms ρ as = Term.renameVarArms ρ' as
  | [], _, _, _ => rfl
  | (_, t) :: as, ρ, ρ', h => by
    have h' : ∀ k, Term.usesVar k t = true → upR ρ k = upR ρ' k := by
      intro k hk; cases k with
      | zero => rfl
      | succ j => simp only [upR, h j (by simp [Term.usesVarArms, hk])]
    simp only [Term.renameVarArms, renameVar_congr t _ _ h',
      renameVarArms_congr as ρ ρ' fun k hk => h k (by simp [Term.usesVarArms, hk])]
end


"""gates/refusals.py TREE — constructs that never land. Matched on blanked code (comments and
strings removed), so prose may name them. Red on:

  sorry, admit                      unproved obligations
  #guard #eval #print #check #reduce #guard_msgs #exit
                                    a fact worth asserting is a named theorem (law 6), and the
                                    build is not a REPL
  example                           an unnamed check; name it
  axiom                             no new axioms; the census allows only the standard three
  partial, unsafe                   no partial or unsafe code anywhere (law 4)
  @[implemented_by], @[extern]      an unproved second implementation; allowed only for a module
                                    listed in gates/native-allow.tsv (module<TAB>reason)
  set_option maxHeartbeats / maxRecDepth / synthInstance.*  a slow proof is fixed, not fed
  set_option autoImplicit / relaxedAutoImplicit / warningAsError / linter.*  lakefile's options hold
  List UInt8 in a def-module        bytes are ByteArray (law 3)
  "…\\xHH<hex digit>…"             a string literal Lean v4.30's C backend miscompiles (greedy C \\x)
  createTempFile/createTempDir/withTempFile/withTempDir
                                    segfault under a missing TMPDIR (v4.30); name the path
"""
import os
import re
import sys

import tree

PATTERNS = [
    (r"\bsorry\b", "sorry"),
    # the tactic, not the identifier (`World.admit`, a constructor or field named admit)
    (r"(?:\bby|[;\n(])[ \t]*admit[ \t]*(?=$|\n|;|\)|<;>)", "admit"),
    (r"(?m)^\s*#(guard_msgs|guard|eval|print|check|reduce|exit)\b", "command"),
    (r"(?m)^\s*(?:@\[[^\]]*\]\s*)*(?:(?:private|protected|noncomputable)\s+)*example\b", "example"),
    (r"(?m)^\s*(?:@\[[^\]]*\]\s*)*(?:(?:private|protected|noncomputable)\s+)*axiom\b", "axiom"),
    (r"\bpartial\b", "partial"),
    (r"\bunsafe\b", "unsafe"),
    (r"\bset_option\s+(maxHeartbeats|maxRecDepth|synthInstance\.\w+)\b", "set_option budget"),
    (r"\bset_option\s+(autoImplicit|relaxedAutoImplicit|warningAsError|linter\.[\w.]+)\b", "set_option override"),
    # Lean v4.30's temp-file primitives segfault (exit 139, no output) when TMPDIR names a missing
    # directory, instead of raising an IO error: a crash is never a refusal (law 7). Measured
    # 10-17 (OPS D9). A process names its own paths.
    (r"\b(?:createTempFile|createTempDir|withTempFile|withTempDir)\b", "temp file"),
]
NATIVE = re.compile(r"@\[[^\]]*\b(implemented_by|extern)\b")
LIST_BYTES = re.compile(r"\bList\s+UInt8\b")


def native_allow(root: str) -> set[str]:
    path = os.path.join(root, "gates", "native-allow.tsv")
    out = set()
    if os.path.exists(path):
        for line in open(path, encoding="utf-8"):
            if line.strip() and not line.startswith("#"):
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 2 or not parts[1].strip():
                    raise SystemExit(f"native-allow.tsv: row without a reason: {line!r}")
                out.add(parts[0])
    return out


# Lean v4.30.0's C backend emits a String literal's `\xHH` escape into C unchanged, and C's `\x`
# escape is greedy: "a\x00b" compiles to the bytes a, 0x0b (two bytes) while the interpreter and the
# kernel see a, 0x00, b. Measured 10-17 (CODEC-4, CODEC-27 / 23c9530; GATES-2 saw `lean -c` emit the
# C literal "a\x00b"). So a `\xHH` escape directly followed by a hex digit is refused in every
# module (tooling compiles too); write the bytes as a ByteArray, or end the literal (`"\x00" ++ "b"`).
# Lift when a toolchain splits the C literal (re-run the plant in the commit that lifts it).
STRING = re.compile(r'"(?:[^"\\\n]|\\.)*"')
GREEDY_X = re.compile(r"\\(?:(?P<greedy>x[0-9a-fA-F]{2}(?=[0-9a-fA-F]))|.)")


def greedy_hex_escapes(m) -> list[str]:
    red = []
    code = tree.blank(m.text, strings=False)
    for lit in STRING.finditer(code):
        for e in GREEDY_X.finditer(lit.group(0)):
            if e.group("greedy"):
                line = code.count("\n", 0, lit.start()) + 1
                red.append(f"hex escape: {m.path}:{line}: {e.group(0)} followed by a hex digit in {lit.group(0)[:40]} "
                           f"(Lean v4.30.0's C backend compiles it as one greedy C \\x escape)")
    return red


def check(t: tree.Tree) -> list[str]:
    red = []
    allowed = native_allow(t.root)
    for m in t.modules.values():
        for pat, what in PATTERNS:
            for hit in re.finditer(pat, m.code):
                line = m.code.count("\n", 0, hit.start()) + 1
                red.append(f"{what}: {m.path}:{line}: {m.text.splitlines()[line - 1].strip()}")
        red += greedy_hex_escapes(m)
        if m.name not in allowed:
            for hit in NATIVE.finditer(m.code):
                line = m.code.count("\n", 0, hit.start()) + 1
                red.append(f"native: {m.path}:{line}: @[{hit.group(1)}] outside gates/native-allow.tsv")
        if not m.is_proof:
            for hit in LIST_BYTES.finditer(m.code):
                line = m.code.count("\n", 0, hit.start()) + 1
                red.append(f"List UInt8: {m.path}:{line}: def-modules carry bytes as ByteArray")
    for name in allowed - set(t.modules):
        red.append(f"native-allow.tsv: {name} is not a tree module (stale row)")
    return red


if __name__ == "__main__":
    red = check(tree.read(sys.argv[1] if len(sys.argv) > 1 else "."))
    for r in red:
"""gates/check.py TREE [--base-waste F] [--message F] [--changed F]
[--base-tree DIR] — every source gate, one line each, exit 1 if any is red. The build and the census are scripts/pre-push's."""
import argparse
import os
import re
import sys

import closure
import owners
import rebase
import refusals
import runs
import size
import tcb
import tree
import vectors
import waste

ap = argparse.ArgumentParser()
ap.add_argument("root")
ap.add_argument("--base-waste")
ap.add_argument("--base-tree", help="the parent tree: size rises are measured against it, and a\n                closure/refusal red the parent already had is reported as PRE-EXISTING, not red")
ap.add_argument("--message")
ap.add_argument("--owners-from", help="tree whose gates/OWNERS judges ownership (the parent)")
ap.add_argument("--changed", help="file listing the paths the commit changes (enables the owners gate)")
a, _unknown = ap.parse_known_args()  # a parent's check.py must accept a child's new flags
t = tree.read(a.root)
msg = open(a.message, encoding="utf-8").read() if a.message else ""


def has_lakefile(d):
    return any(os.path.exists(os.path.join(d, f)) for f in ("lakefile.lean", "lakefile.toml"))


def read(p):
    return open(p, encoding="utf-8").read() if p and os.path.exists(p) else None


changed = open(a.changed, encoding="utf-8").read().split() if a.changed else None


MARKER = re.compile(r"^(<{7}|>{7})(?: |$)")


def conflict_markers(root: str) -> list[str]:
    """A merge-conflict marker line (`<<<<<<< ours`, `>>>>>>> theirs`) in any file of the judged
    tree: an unresolved merge that a lane's own `git apply --3way` or `checkout -m` left in a file it
    then committed whole (4c327a7, 10-17, two decisions appended to decisions/host.md). The `=======`
    middle line is not matched: it is also a Markdown heading underline."""
    red = []
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        for f in files:
            path = os.path.join(d, f)
            try:
                with open(path, encoding="utf-8") as fh:
                    for n, line in enumerate(fh, 1):
                        if MARKER.match(line):
                            red.append(f"{os.path.relpath(path, root)}:{n}: conflict marker {line.rstrip()[:40]!r}")
            except (UnicodeDecodeError, OSError):
                continue  # not text
    return red


def case_collisions(root: str) -> list[str]:
    """Two paths (files or directories) that differ only in case are ONE path on a case-insensitive
    disk (the Mac reader's APFS): `ops/RUNBOOK.md` silently became `Ops/RUNBOOK.md` inside the
    Lean library on 10-17 (OPS). Red by name."""
    seen: dict[str, set[str]] = {}
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in tree.SKIP_DIRS]
        rel = os.path.relpath(d, root)
        for x in dirs + files:
            path = os.path.normpath(os.path.join(rel, x))
            seen.setdefault(path.lower(), set()).add(path)
    return [f"{' and '.join(sorted(v))} differ only in case: one path on a case-insensitive disk"
            for v in seen.values() if len(v) > 1]


results = {
    "closure": closure.check(t),
    "refusals": refusals.check(t),
    "size": size.check(t, msg, tree.read(a.base_tree) if a.base_tree and has_lakefile(a.base_tree) else None),
    "paths": case_collisions(t.root) + conflict_markers(t.root),
    "runs": runs.check(t),
    "rebase": rebase.check(t.root),
    "tcb": tcb.check(t.root),
    "vectors": vectors.check(t.root, a.base_tree if a.base_tree and has_lakefile(a.base_tree) else None),
    "waste": waste.check(read(os.path.join(t.root, "gates", "waste.tsv")) or "", read(a.base_waste), msg),
}
if changed is not None:
    src = a.owners_from if a.owners_from and os.path.exists(os.path.join(a.owners_from, "gates", "OWNERS")) else t.root
    results["owners"] = owners.check(src, changed, msg)
# Targets: a lib or exe the parent's lakefile declared and the candidate's does not is red by
# name, unless the message says `LAKE-DROP: <name>: <why>` (the toml -> lean switch must carry
# every target across).
if a.base_tree and has_lakefile(a.base_tree):
    bl = tree.lakefile(a.base_tree)
    before = {x["name"] for k in ("lean_lib", "lean_exe") for x in bl[k]}
    after = {x["name"] for k in ("lean_lib", "lean_exe") for x in t.lake[k]}
    results["targets"] = [f"lakefile dropped target {n}; needs 'LAKE-DROP: {n}: <why>'"
                          for n in sorted(before - after)
                          if not re.search(r"(?m)^LAKE-DROP:\s*" + re.escape(n) + r"\s*:\s*\S", msg)]
# A commit is refused for the reds it introduces. Reds its parent already had are printed (they
# are some layer's to fix forward, and scripts/standing.sh counts every one) but do not block an
# unrelated commit: otherwise one layer's red stops all six.
old = set()
if a.base_tree and has_lakefile(a.base_tree):
    bt = tree.read(a.base_tree)
    old = {re.sub(r":\d+", ":", r) for r in closure.check(bt) + refusals.check(bt)}
red = False
for gate, reds in results.items():
    new = []
    for r in reds:
        if gate in ("closure", "refusals") and re.sub(r":\d+", ":", r) in old:
            print(f"  {gate}: PRE-EXISTING {r}")
        else:
            print(f"  {gate}: {r}")
            new.append(r)
    print(f"{gate}: {'RED' if new else 'ok'}")
    red |= bool(new)
for w in size.WARN:
    print(f"WARN {w}")
sys.exit(1 if red else 0)


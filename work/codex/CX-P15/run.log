 succeeded in 334ms:
/-
# Lang.Contextual.Protocol — open protocols as typed families of continuations (lane PROTOCOL)

The object of the activities proposal's document 2: a protocol between parties is an OPEN object.
Its unspecified components are HOLES, each declared in a context `Ω` with an interface (where it
starts, what it must deliver, which reusable facts and which linear tokens it may use, which
obligations it may leave, who chooses its filling and which contract it must pass). Its
interactions with peers are `call op k` nodes whose continuation is a FAMILY indexed by the response
(`k : (r : Resp op) → Prot (next op r)`). A substitution is ONE filling per hole NAME, chosen before
anything is observed. Whether that separates a hole from an interaction depends on the NAMING, not
on the calculus: a template that puts the SAME name in every response branch gets one filling for
all of them (`Proofs.Contextual.Protocol.Coin.no_foresight`), but a template whose hole names
depend on the response (`call op fun r => hole (h r)`) gets a filling per response, which is
foresight (`response_indexed_names_have_foresight`; `foresight_iff_names_separate` is the exact
condition). Scope (one filling into every branch unchanged) is a naming discipline the author
keeps; the calculus does not enforce it. Its resources are tokens a `call` of a consuming operation
spends. The discipline is AFFINE: a token is spent at most once, and a token left unspent at `ret`
is allowed. Its executed prefix is a history (`Hist`), possibly ending in a call
whose reply was lost (`inflight`), and a re-substitution must leave every hole the history has
already entered alone (`Dispatched`).

The shape generalises minidregg's `Theory/IndexedProgram.lean` (restated in Lean core, law 11): its
`IxSignature`/`Program` gain a third constructor `hole`, its `Algebra` a hole case, its interpreter
a `stuck` outcome (doc 2 section 7: partiality visible in the result type). Nano's own free program
over effects (`Hosting.Resident.Prog`) is the instance with a trivial index and no holes
(`Proofs.Contextual.Protocol.nano_runs_iff`, `nano_interp_agrees`).

The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, A) ⊣ Φ` is `HasProt sp Ω Γ Q Φ Δ P`: `Γ` the reusable facts
(hypothetical: derivability is not current availability, `admits`), `Δ` the linear tokens (a bag:
`SubBag`), `Q` the result postcondition, `Φ` the obligations any completion may still owe (an upper
bound). Substitution is SINGLE-PASS: `subst σ` replaces each hole by its filling and does not
substitute into the filling, so a filling's own holes stay open under the same `σ`. Definitions only. The statements (`HasProt`, `Runs`, `Reach`, `Started`, `Dispatched`, `SubBag`,
`Fills`, `SubstOK`, ...) are in `Lang.Proofs.Contextual.ProtocolTyping`; the theorems are in
`Lang.Proofs.Contextual.Protocol` and `Lang.Proofs.Contextual.Negotiation`.
-/

namespace Nanodregg.Lang.Contextual.Protocol

/-! ## Signatures, the accounting of an operation, polarity -/

/-- An indexed signature (mini's `IxSignature`, restated): at index `i` the operations `Op i`; each
operation's response type; the response selects the next index. -/
structure Sig (Ix : Type) where
  Op : Ix → Type
  Resp : {i : Ix} → Op i → Type
  next : {i : Ix} → (op : Op i) → Resp op → Ix

/-- What one operation does to the accounts: the linear token it SPENDS (if any), the reusable
facts it REQUIRES (authority, evidence: used, never consumed), and the obligations its DISPATCH
establishes (established when the call leaves, whatever the reply). -/
structure Spec {Ix : Type} (S : Sig Ix) (Tok Fact Ob : Type) where
  consumes : {i : Ix} → S.Op i → Option Tok
  requires : {i : Ix} → S.Op i → List Fact
  establishes : {i : Ix} → S.Op i → List Ob

/-- Who chooses a hole's filling (and, reused, which side must accept it). -/
inductive Polarity
  | ours
  | theirs
deriving DecidableEq, Repr

/-! ## Open protocols -/

/-- The free open protocol over `S` with result family `A` and hole names `Hole`: return a result,
interact (`call`: one continuation per response, at the index the response selects), or leave a
named component unspecified (`hole h`, its interface in the context `Ω`, as a CMTT metavariable
refers to the meta-context). -/
inductive Prot {Ix : Type} (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) : Ix → Type where
  | ret {i : Ix} (a : A i) : Prot S Hole A i
  | call {i : Ix} (op : S.Op i) (k : (r : S.Resp op) → Prot S Hole A (S.next op r)) :
      Prot S Hole A i
  | hole {i : Ix} (h : Hole i) : Prot S Hole A i

section
variable {Ix : Type} {S : Sig Ix} {Hole : Ix → Type} {A : Ix → Type}

/-- A hole's interface `u :: [Γ_u; Δ_u ⊢ Protocol(i, post)] ⊣ owes`, with its polarity and an
acceptance contract that every filling must pass (`Fills`). The start index is the hole name's
index. -/
structure Iface (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  /-- who chooses the filling -/
  pol : Polarity
  /-- the reusable facts a filling may require (`Γ_u`) -/
  ctx : List Fact
  /-- the tokens a filling may spend (`Δ_u`) -/
  need : List Tok
  /-- what every result a filling delivers satisfies -/
  post : (j : Ix) → A j → Prop
  /-- the obligations a filling may leave -/
  owes : List Ob
  /-- the acceptance contract on a filling -/
  accepts : Prot S Hole A i → Prop

/-- `Ω`: the declared interface of every unresolved component. -/
abbrev Ctx (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) :=
  (i : Ix) → Hole i → Option (Iface S Hole A Tok Fact Ob i)

/-- `σ`: a partial substitution, a filling for some holes (doc 2 section 9). -/
abbrev Subst (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) :=
  (i : Ix) → Hole i → Option (Prot S Hole A i)

/-- Typed substitution: every hole `σ` fills is replaced by its filling; nothing else moves. -/
def subst (σ : Subst S Hole A) : {i : Ix} → Prot S Hole A i → Prot S Hole A i
  | _, .ret a => .ret a
  | _, .call op k => .call op fun r => subst σ (k r)
  | i, .hole h => match σ i h with
    | some f => f
    | none => .hole h

/-- `σ` restricted to the holes `Ω` declares `ours`: a `theirs` hole is never filled. -/
def Subst.ours {Tok Fact Ob : Type} (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A) :
    Subst S Hole A := fun i h =>
  match Ω i h with
  | some I => if I.pol = .ours then σ i h else none
  | none => none

/-- `P[σ]` under `Ω`: fill the `ours` holes `σ` names. -/
def fill {Tok Fact Ob : Type} (Ω : Ctx S Hole A Tok Fact Ob) (σ : Subst S Hole A)
    {i : Ix} (P : Prot S Hole A i) : Prot S Hole A i :=
  subst (σ.ours Ω) P

/-- The single substitution `[f/h]`. -/
def Subst.single [DecidableEq Ix] [∀ i, DecidableEq (Hole i)] {i : Ix} (h : Hole i)
    (f : Prot S Hole A i) : Subst S Hole A := fun j h' =>
  if hj : i = j then (by subst hj; exact if h' = h then some f else none) else none

/-- A signature whose response types are finite, listed. -/
structure Finite (S : Sig Ix) where
  resps : {i : Ix} → (op : S.Op i) → List (S.Resp op)
  complete : ∀ {i : Ix} (op : S.Op i) (r : S.Resp op), r ∈ resps op

/-- The holes of `P`, computed over a finite signature (`mem_holes_iff`: exactly `Occurs`). -/
def holes (fin : Finite S) : {i : Ix} → Prot S Hole A i → List (Σ j, Hole j)
  | _, .ret _ => []
  | _, .call op k => (fin.resps op).attach.flatMap fun r => holes fin (k r.1)
  | i, .hole h => [⟨i, h⟩]

/-! ## Linear tokens as a bag -/

/-! ## The judgment `Ω;Γ;Δ ⊢ P : Protocol(i, Q) ⊣ Φ` -/

/-! ## Algebras, fold, fusion -/

/-- An algebra reads an open protocol into an indexed carrier; holes too. -/
structure Algebra (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (C : Ix → Type) where
  ret : {i : Ix} → A i → C i
  call : {i : Ix} → (op : S.Op i) → ((r : S.Resp op) → C (S.next op r)) → C i
  hole : {i : Ix} → Hole i → C i

/-- The fold. -/
def fold {C : Ix → Type} (alg : Algebra S Hole A C) : {i : Ix} → Prot S Hole A i → C i
  | _, .ret a => alg.ret a
  | _, .call op k => alg.call op fun r => fold alg (k r)
  | _, .hole h => alg.hole h

/-- Substitution as an algebra into protocols. -/
def substAlg (σ : Subst S Hole A) : Algebra S Hole A (Prot S Hole A) where
  ret := .ret
  call := .call
  hole := fun {i} h => match σ i h with
    | some f => f
    | none => .hole h

/-- Read a template under an environment: a filled hole is read as its filling's reading, an
unfilled one as the algebra's hole. -/
def underAlg {C : Ix → Type} (alg : Algebra S Hole A C) (σ : Subst S Hole A) :
    Algebra S Hole A C where
  ret := alg.ret
  call := alg.call
  hole := fun {i} h => match σ i h with
    | some f => fold alg f
    | none => alg.hole h

/-! ## Handlers, the interpreter, partial results -/

/-- A deterministic environment: one operation against an indexed state gives a response and a
state at the index the response selects (mini's `Handler`). -/
structure Handler (S : Sig Ix) (St : Ix → Type) where
  handle : {i : Ix} → (op : S.Op i) → St i → Σ r : S.Resp op, St (S.next op r)

/-- How an interpretation ends: a result, or STUCK at an unresolved hole (never a failure). -/
inductive Result (Hole : Ix → Type) (A : Ix → Type) (St : Ix → Type) where
  | done (j : Ix) (a : A j) (s : St j)
  | stuck (j : Ix) (h : Hole j) (s : St j)

/-- The handler as a state-transformer algebra. -/
def execAlgebra {St : Ix → Type} (H : Handler S St) :
    Algebra S Hole A (fun i => St i → Result Hole A St) where
  ret := fun {i} a s => .done i a s
  call := fun op k s => match H.handle op s with
    | ⟨r, s'⟩ => k r s'
  hole := fun {i} h s => .stuck i h s

/-- Run an open protocol against an environment. -/
def interpret {St : Ix → Type} (H : Handler S St) {i : Ix} (P : Prot S Hole A i) :
    St i → Result Hole A St :=
  fold (execAlgebra H) P

/-- Run a template with its holes bound by `σ` in the environment rather than in the syntax. -/
def interpretUnder {St : Ix → Type} (H : Handler S St) (σ : Subst S Hole A) {i : Ix}
    (P : Prot S Hole A i) : St i → Result Hole A St :=
  fold (underAlg (execAlgebra H) σ) P

/-- The recording environment: `H`, and each call appended to a trace with the response it had
(the shape of nano's `recorder`). -/
def record {St : Ix → Type} (H : Handler S St) : Handler S (fun i => St i × List (Σ i, Σ op : S.Op i, S.Resp op)) where
  handle := fun {i} op p => match H.handle op p.1 with
    | ⟨r, s'⟩ => ⟨r, (s', p.2 ++ [⟨i, op, r⟩])⟩

/-! ## History -/

/-- One performed interaction: the operation, at its index, with the response it had. -/
abbrev Entry (S : Sig Ix) := Σ i, Σ op : S.Op i, S.Resp op

/-- A history of performed interactions, in order. -/
abbrev Trace (S : Sig Ix) := List (Entry S)

/-- An accepted history: the answered interactions and, possibly, ONE dispatched call whose reply
has not arrived (lost or late: `uncertain`, a state, never a license to re-plan). -/
structure Hist (S : Sig Ix) where
  answered : Trace S
  inflight : Option (Σ i, S.Op i)

/-- The tokens a trace spends. -/
def consumed {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (t : Trace S) : List Tok :=
  t.filterMap fun e => sp.consumes e.2.1

/-- The obligations a trace established. -/
def established {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (t : Trace S) : List Ob :=
  t.flatMap fun e => sp.establishes e.2.1

/-- The obligations a history established: the answered calls' and the in-flight call's (its
obligation stands from dispatch, whatever happened to the reply). -/
def Hist.established {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (H : Hist S) : List Ob :=
  Protocol.established sp H.answered ++
    match H.inflight with
    | some ⟨_, op⟩ => sp.establishes op
    | none => []

/-! ## The first-class open object (doc 2 section 9) -/

/-- `(P, Ω, σ, Γ, Δ, Q, Φ, t)`: the retained TEMPLATE, its open interface, the current partial
substitution, the hypotheses and tokens, the result contract, the obligation bound, and the
accepted history. The template is kept apart from `σ`: that is what makes re-substitution possible. -/
structure Open (S : Sig Ix) (Hole : Ix → Type) (A : Ix → Type) (Tok Fact Ob : Type) (i : Ix) where
  template : Prot S Hole A i
  Ω : Ctx S Hole A Tok Fact Ob
  σ : Subst S Hole A
  Γ : List Fact
  Δ : List Tok
  Q : (j : Ix) → A j → Prop
  Φ : List Ob
  hist : Hist S

/-- The object's current protocol `P[σ]`. -/
def Open.current {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i) :
    Prot S Hole A i :=
  fill O.Ω O.σ O.template

/-- Replace the object's partial substitution. Data only: the GUARD (no re-substitution of a hole
the history has entered) is the statement `Open.Replan` in `Lang.Proofs.Contextual.ProtocolTyping`,
a hypothesis of every theorem about a re-plan (`Open.resubst_wf`). -/
def Open.replan {Tok Fact Ob : Type} {i : Ix} (O : Open S Hole A Tok Fact Ob i)
    (σ' : Subst S Hole A) : Open S Hole A Tok Fact Ob i :=
  { O with σ := σ' }

/-! ## Admission: current evidence, separate from derivability -/

/-- The CURRENT admission evidence: which facts hold now, which tokens are unspent now. -/
structure View (Tok Fact : Type) where
  holds : Fact → Bool
  live : Tok → Bool

/-- One concrete effect is admissible now: its facts hold and its token is unspent. -/
def admitOp {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix}
    (op : S.Op i) : Bool :=
  (sp.requires op).all v.holds &&
    match sp.consumes op with
    | some t => v.live t
    | none => true

/-- The protocol's NEXT concrete effect is admissible now. A hole has no concrete effect to admit
(an unfinished plan describes a family of transitions; only a complete one is admitted). -/
def admits {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) (v : View Tok Fact) {i : Ix} :
    Prot S Hole A i → Bool
  | .ret _ => true
  | .call op _ => admitOp sp v op
  | .hole _ => false

/-- Durable consumption: mark a token spent. -/
def View.spend {Tok Fact : Type} [DecidableEq Tok] (v : View Tok Fact) (t : Tok) : View Tok Fact :=
  { v with live := fun t' => if t' = t then false else v.live t' }

/-- Commit one effect: refused unless admissible now; on success its token is spent durably. -/
def commit {Tok Fact Ob : Type} [DecidableEq Tok] (sp : Spec S Tok Fact Ob) (v : View Tok Fact)
    {i : Ix} (op : S.Op i) : Option (View Tok Fact) :=
  if admitOp sp v op then
    some (match sp.consumes op with
      | some t => v.spend t
      | none => v)
  else none

/-- The keys an effect's admission reads: its facts and its token. -/
def opSupport {Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob) {i : Ix} (op : S.Op i) :
    List (Fact ⊕ Tok) :=
  (sp.requires op).map Sum.inl ++ (match sp.consumes op with
    | some t => [Sum.inr t]
    | none => [])

/-- A change of token REPRESENTATION (an authenticated representation of an unchanged semantic
token, e.g. an opening refreshed because a root moved): the spec with every token renamed. -/
def Spec.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') (sp : Spec S Tok Fact Ob) :
    Spec S Tok' Fact Ob where
  consumes := fun op => (sp.consumes op).map e
  requires := sp.requires
  establishes := sp.establishes

/-- An interface with its tokens renamed. -/
def Iface.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') {i : Ix}
    (I : Iface S Hole A Tok Fact Ob i) : Iface S Hole A Tok' Fact Ob i :=
  { I with need := I.need.map e }

/-- A context with its tokens renamed. -/
def Ctx.mapTok {Tok Tok' Fact Ob : Type} (e : Tok → Tok') (Ω : Ctx S Hole A Tok Fact Ob) :
    Ctx S Hole A Tok' Fact Ob := fun i h => (Ω i h).map (Iface.mapTok e)

/-- A view as a store of keys. -/
def View.ofStore {Tok Fact : Type} (w : Fact ⊕ Tok → Bool) : View Tok Fact :=
  ⟨fun f => w (.inl f), fun t => w (.inr t)⟩

end

/-! ## Selective repair over fragments (doc 2 section 9, family 3) -/

/-- A checked fragment: a name, the keys its check declares it reads (its support), the check. -/
structure Frag (Name Key V : Type) where
  name : Name
  support : List Key
  check : (Key → V) → Bool

/-- Is the fragment affected by a change of `changed`? -/
def Frag.affected {Name Key V : Type} [DecidableEq Key] (f : Frag Name Key V)
    (changed : List Key) : Bool :=
  f.support.any fun k => decide (k ∈ changed)

/-- Check everything again. -/
def fromScratch {Name Key V : Type} (fs : List (Frag Name Key V)) (w : Key → V) : List Bool :=
  fs.map fun f => f.check w

/-- Selective repair: re-check the affected fragments, reuse every other cached verdict. -/
def repair {Name Key V : Type} [DecidableEq Key] :
    List (Frag Name Key V) → List Bool → List Key → (Key → V) → List Bool
  | [], _, _, _ => []
  | f :: fs, [], ch, w => f.check w :: repair fs [] ch w
  | f :: fs, c :: cs, ch, w => (if f.affected ch then f.check w else c) :: repair fs cs ch w

/-- The names of the fragments that do not check. Each name stands for one residual obligation
(re-establish that fragment); the list is `Φ′` only in that sense. -/
def residual {Name Key V : Type} : List (Frag Name Key V) → List Bool → List Name
  | [], _ => []
  | f :: fs, [] => f.name :: residual fs []
  | f :: fs, b :: bs => (if b then [] else [f.name]) ++ residual fs bs

/-- One effect's admission as a checked fragment over the store of keys. -/
def admitFrag {Ix : Type} {S : Sig Ix} {Name Tok Fact Ob : Type} (sp : Spec S Tok Fact Ob)
    (name : Name) {i : Ix} (op : S.Op i) : Frag Name (Fact ⊕ Tok) Bool where
  name := name
  support := opSupport sp op
  check := fun w => admitOp sp (View.ofStore w) op

/-! ## Shared parameters: the completion space (doc 2 section 4) -/

/-- The four conditions on ONE completion `θ`. -/
structure Conds (Θ : Type) where
  typed : Θ → Prop
  guards : Θ → Prop
  authority : Θ → Prop
  resources : Θ → Prop

/-! ## Search state versus logical status (the matcher, doc 2 section 4) -/

/-- Greedy first-fit: each want in order takes the FIRST remaining offer that covers it; the count
of wants satisfied. -/
def firstFit : List Nat → List Nat → Nat
  | _, [] => 0
  | offers, w :: ws =>
    match offers.findIdx? (fun o => decide (w ≤ o)) with
    | some n => firstFit (offers.eraseIdx n) ws + 1
    | none => firstFit offers ws

/-- Complete search: is there an assignment of distinct offers covering every want? -/
def coverAll : List Nat → List Nat → Bool
  | _, [] => true
  | offers, w :: ws =>
    (List.range offers.length).any fun n =>
      decide (w ≤ offers.getD n 0) && coverAll (offers.eraseIdx n) ws

/-- A SCALAR ILLUSTRATION of shared parameters (the price alone is `θ`): the buyer accepts a price
at most 5, the seller at least 7. The same separation over `Subst` of the negotiation template is
`Proofs.Contextual.Negotiation.separate_witnesses_over_substitutions`. -/
def priceConds : Conds Nat where
  typed := fun _ => True
  guards := fun x => x ≤ 5
  authority := fun x => 7 ≤ x
  resources := fun _ => True

/-! ## Example: the committed bit (doc 2 section 5) -/

namespace Coin

/-- Before and after the peer reveals its bit. -/
inductive Phase
  | waiting
  | revealed
deriving DecidableEq, Repr

/-- The only operation: receive the peer's bit; nothing is available afterwards. -/
inductive Op : Phase → Type
  | recv : Op .waiting

def sig : Sig Phase where
  Op := Op
  Resp := fun | .recv => Bool
  next := fun | .recv, _ => .revealed

/-- One hole name, at `revealed`: our answer, planned before the reveal. -/
def HoleN : Phase → Type
  | .waiting => Empty
  | .revealed => Unit

abbrev Res : Phase → Type := fun _ => Bool

abbrev P := Prot sig HoleN Res

/-- The peer answers `b`. -/
def env (b : Bool) : Handler sig (fun _ => Unit) where
  handle := fun | .recv, () => ⟨b, ()⟩

/-- We win against `b` when the run ends with result `b`; a run stuck at a hole loses. The hole
names `Hn` are a parameter so that templates with different naming disciplines can be compared. -/
def wins {Hn : Phase → Type} {i : Phase} (b : Bool) (p : Prot sig Hn Res i) (s : Unit) : Bool :=
  match interpret (env b) p s with
  | .done _ a _ => a == b
  | .stuck _ _ _ => false

/-- The OPEN plan: receive, then do whatever our hole says. Its filling is chosen once. -/
def planHole : P .waiting := .call (S := sig) Op.recv fun _ => .hole (i := Phase.revealed) ()

/-- The RESPONSE-DEPENDENT plan: the continuation is a family over the response. -/
def planCall : P .waiting := .call (S := sig) Op.recv fun b => .ret b

/-- A template whose hole name may depend on the peer's bit: `name b` is the hole in branch `b`.
Response-free naming is the case `name true = name false`. -/
def planNamed {Hn : Phase → Type} (name : Bool → Hn .revealed) : Prot sig Hn Res .waiting :=
  .call (S := sig) Op.recv fun b => .hole (i := Phase.revealed) (name b)

/-- One hole name per possible bit at `revealed`. -/
def HoleB : Phase → Type
  | .waiting => Empty
  | .revealed => Bool

/-- The filling "answer `c`". -/
def answer (c : Bool) : Subst sig HoleN Res := fun
  | .waiting, h => nomatch h
  | .revealed, () => some (.ret c)

/-- The hole's interface, with polarity `p` (no facts, tokens or obligations in this game). -/
def iface (p : Polarity) : Iface sig HoleN Res Unit Unit Unit .revealed where
  pol := p
  ctx := []
  need := []
  post := fun _ _ => True
  owes := []
  accepts := fun _ => True

/-- `Ω` declaring the answer hole with polarity `p`. -/
def ctxOf (p : Polarity) : Ctx sig HoleN Res Unit Unit Unit := fun
  | .waiting, h => nomatch h
  | .revealed, () => some (iface p)

end Coin

/-! ## The integration experiment: a one-use capability, two providers, a deadline, a cancel
(doc 3). Definitions here; the theorems in `Lang.Proofs.Contextual.Negotiation`. -/

namespace Negotiation

/-- Two candidate providers. -/
inductive Provider
  | p1
  | p2
deriving DecidableEq, Repr

/-- Phases: idle → reserved (deposit held) → done. -/
inductive Phase
  | idle
  | reserved
  | done
deriving DecidableEq, Repr

/-- The operations. `reserve` holds the buyer's deposit; `commit p` spends the one-use capability
on provider `p` (the provider's reply: delivered or not); `cancel` abandons and refunds. -/
inductive Op : Phase → Type
  | reserve : Op .idle
  | commit (p : Provider) : Op .reserved
  | cancel : Op .reserved

def respOf : {i : Phase} → Op i → Type
  | _, .reserve => Unit
  | _, .commit _ => Bool
  | _, .cancel => Unit

def sig : Sig Phase where
  Op := Op
  Resp := respOf
  next := fun
    | .reserve, _ => .reserved
    | .commit _, _ => .done
    | .cancel, _ => .done

/-- The single linear token: the capability. -/
inductive Tok
  | cap
deriving DecidableEq, Repr

/-- Reusable facts: a provider's authority; the deadline has not passed. -/
inductive Fact
  | auth (p : Provider)
  | beforeDeadline
deriving DecidableEq, Repr

/-- Obligations: the deposit is held; pay provider `p`; refund the deposit. -/
inductive Ob
  | holdDeposit
  | pay (p : Provider)
  | refund
deriving DecidableEq, Repr

def spec : Spec sig Tok Fact Ob where
  consumes := fun
    | .commit _ => some .cap
    | _ => none
  requires := fun
    | .commit p => [.auth p, .beforeDeadline]
    | _ => []
  establishes := fun
    | .reserve => [.holdDeposit]
    | .commit p => [.pay p]
    | .cancel => [.refund]

/-- One hole: which provider, chosen by us, after the reservation. -/
def HoleN : Phase → Type
  | .reserved => Unit
  | _ => Empty

/-- Results: whether the capability's service was delivered. -/
abbrev Res : Phase → Type := fun _ => Bool

abbrev P := Prot sig HoleN Res

instance : ∀ i, DecidableEq (HoleN i)
  | .idle => fun a => nomatch a
  | .reserved => fun () () => isTrue rfl
  | .done => fun a => nomatch a

/-- The open protocol: reserve, then the provider hole. -/
def template : P .idle := .call (S := sig) Op.reserve fun _ => .hole (i := Phase.reserved) ()

/-- A candidate: commit the capability on `p`; deliver its reply. -/
def plan (p : Provider) : P .reserved := .call (S := sig) (Op.commit p) fun ok => .ret ok

/-- The cancellation path. -/
def cancelPlan : P .reserved := .call (S := sig) Op.cancel fun _ => .ret false

/-- The hole's interface: ours, accepted by us, may use both providers' authority and the
deadline, may spend the capability, may owe payment to either provider or the refund. -/
def iface : Iface sig HoleN Res Tok Fact Ob .reserved where
  pol := .ours
  ctx := [.auth .p1, .auth .p2, .beforeDeadline]
  need := [.cap]
  post := fun _ _ => True
  owes := [.pay .p1, .pay .p2, .refund]
  accepts := fun _ => True

def Ω : Ctx sig HoleN Res Tok Fact Ob := fun
  | .reserved, () => some iface
  | .idle, h => nomatch h
  | .done, h => nomatch h

/-- Choose `f` for the provider hole. -/
def choose (f : P .reserved) : Subst sig HoleN Res := fun
  | .reserved, () => some f
  | .idle, h => nomatch h
  | .done, h => nomatch h

/-- The negotiation's responses, listed. -/
def finite : Finite sig where
  resps := fun
    | .reserve => [()]
    | .commit _ => [true, false]
    | .cancel => [()]
  complete := by
    intro i op r
    cases op with
    | reserve => cases r; simp
    | commit p => cases r <;> simp
    | cancel => cases r; simp

/-- The negotiation's hypotheses, tokens and obligation bound. -/
def Γ₀ : List Fact := [.auth .p1, .auth .p2, .beforeDeadline]
def Δ₀ : List Tok := [.cap]
def Φ₀ : List Ob := [.holdDeposit, .pay .p1, .pay .p2, .refund]

/-- The open object: the template with `f` chosen for the provider hole, history `H`. -/
def obj (f : P .reserved) (H : Hist sig) : Open sig HoleN Res Tok Fact Ob .idle where
  template := template
  Ω := Ω
  σ := choose f
  Γ := Γ₀
  Δ := Δ₀
  Q := fun _ _ => True
  Φ := Φ₀
  hist := H

/-- The reservation answered. -/
def reserved : Entry sig := ⟨.idle, Op.reserve, ()⟩

/-- Reserved; nothing dispatched yet. -/
def H₀ : Hist sig := ⟨[reserved], none⟩

/-- Reserved; the commitment to `p` dispatched and its reply LOST. -/
def lost (p : Provider) : Hist sig := ⟨[reserved], some ⟨.reserved, Op.commit p⟩⟩

/-- An environment: providers deliver iff `deliver`; the state counts calls. -/
def env (deliver : Bool) : Handler sig (fun _ => Nat) where
  handle := fun op n => match op with
    | .reserve => ⟨(), n + 1⟩
    | .commit _ => ⟨deliver, n + 1⟩
    | .cancel => ⟨(), n + 1⟩

/-- The world: a clock and a deadline, provider authority, the capability's nullifier (spent or
not), and an unrelated store. -/
structure World where
  now : Nat
  deadline : Nat
  auth : Provider → Bool
  capSpent : Bool
  other : Nat → Nat

/-- What the world says to admission. -/
def World.view (w : World) : View Tok Fact where
  holds := fun
    | .auth p => w.auth p
    | .beforeDeadline => decide (w.now < w.deadline)
  live := fun .cap => !w.capSpent

/-- The candidates, numbered, in the order the plan lists them. -/
def candidates : List (Nat × P .reserved) := [(1, plan .p1), (2, plan .p2), (3, cancelPlan)]

/-- The numbers of the candidates admissible in `w` now. -/
def available (w : World) : List Nat :=
  (candidates.filter fun c => admits spec w.view c.2).map Prod.fst

/-- The world on day 0: both providers authorised, deadline 10, capability unspent. -/
def w0 : World := ⟨0, 10, fun _ => true, false, fun _ => 0⟩

/-- Revoke a provider's authority. -/
def World.revoke (w : World) (p : Provider) : World :=
  { w with auth := fun q => if q = p then false else w.auth q }

/-- A commitment against the world: refused unless admissible, then the nullifier is spent. -/
def World.commit (w : World) {i : Phase} (op : Op i) : Option World :=
  if admitOp spec w.view (S := sig) op then
    some (match spec.consumes (S := sig) op with
      | some .cap => { w with capSpent := true }
      | none => w)
  else none

/-- The candidate fragments for selective repair: each candidate's admission, over the keys of
its first effect. -/
def frags : List (Frag Nat (Fact ⊕ Tok) Bool) :=
  [admitFrag spec 1 (S := sig) (Op.commit .p1), admitFrag spec 2 (S := sig) (Op.commit .p2),
    admitFrag spec 3 (S := sig) Op.cancel]

/-- A second representation of the capability token: its opening under the root of an epoch.
Openings from different epochs are different representations of the same capability. -/
inductive Tok'
  | capAt (epoch : Nat)
deriving DecidableEq, Repr

/-- The representation under epoch `E`. -/
def Tok.at (E : Nat) : Tok → Tok'
  | .cap => .capAt E

/-- The PARTIAL correspondence back: only an opening from the current epoch `E` names the token. -/
def Tok'.current (E : Nat) : Tok' → Option Tok
  | .capAt e => if e = E then some .cap else none

/-- The world's admission view over the new representation at current epoch `E`: an opening is
live only when it is from epoch `E` and the token it names is unspent. A stale opening is not. -/
def World.viewAt (w : World) (E : Nat) : View Tok' Fact where
  holds := w.view.holds
  live := fun t => match t.current E with
    | some t₀ => w.view.live t₀
    | none => false

/-- The world as a store of keys. -/
def World.store (w : World) : Fact ⊕ Tok → Bool
  | .inl f => w.view.holds f
  | .inr t => w.view.live t

/-! ### Internal once versus external once -/

/-- The external side of one commitment: how many times the network delivered the dispatched
request, whether the provider deduplicates by the request identity, and so how many times the
service was performed. -/
structure External where
  deliveries : Nat
  dedupe : Bool

def External.executions (e : External) : Nat :=
  if e.dedupe then min e.deliveries 1 else e.deliveries

/-- What the internal model records about one commitment: the nullifier spent and the reply
(`none`: lost). -/
structure Internal where
  capSpent : Bool
  reply : Option Bool

/-- The reply an answered entry carries, if it is a commitment. -/
def entryReply : Entry sig → Option Bool
  | ⟨_, op, r⟩ => match op, r with
    | .commit _, b => some b
    | .reserve, _ => none
    | .cancel, _ => none

/-- Is an in-flight call a commitment? -/
def inflightSpends : Option (Σ i, sig.Op i) → Bool
  | some ⟨_, .commit _⟩ => true
  | _ => false

/-- The internal record, READ OFF a history: the nullifier is spent when an answered or in-flight
call spent the capability; the reply is the answered commitment's. -/
def Internal.ofHist (H : Hist sig) : Internal where
  capSpent := (consumed spec H.answered).contains .cap || inflightSpends H.inflight
  reply := H.answered.findSome? entryReply

/-- Reserved, then the commitment to `p` answered with `b`. -/
def answeredH (p : Provider) (b : Bool) : Hist sig :=
  ⟨[reserved, ⟨.reserved, Op.commit p, b⟩], none⟩

/-- A filling with the same first call as `plan p` but a different continuation. -/
def planFlip (p : Provider) : P .reserved := .call (S := sig) (Op.commit p) fun ok => .ret (!ok)

end Negotiation

end Nanodregg.Lang.Contextual.Protocol
/-
# Lang.Contextual.NanoBridge — nano's free program over effects as an open protocol (lane PROTOCOL)

`Hosting.Resident.Prog` (`cmd | keep | forget | ask | say`, a continuation per result) is the
instance of `Lang.Contextual.Protocol.Prot` with a trivial index (`Unit`) and no holes (`Empty`):
`ofProg` embeds a program, `toEv` reads a performed interaction as nano's trace event, `oracleH` is
nano's oracle as a deterministic environment. Definitions only; the theorems (`nano_runs_iff`,
`nano_interp_agrees`, `nano_interp_runs`) are in `Lang.Proofs.Contextual.Protocol`.
-/
import Lang.Contextual.Protocol
import Hosting.Resident.Trace

namespace Nanodregg.Lang.Contextual.Protocol.Nano

open Nanodregg.Hosting Nanodregg.Hosting.Resident

/-- Nano's five effects as operation shapes. -/
inductive NOp
  | cmd (c : Cmd)
  | keep (r : Ring) (t : ByteArray)
  | forget
  | ask (r : Ring) (q : Broker.Ask)
  | say (s : String)

/-- Each effect's result type, as `Prog`'s continuations take it. -/
def NOp.Resp : NOp → Type
  | .cmd _ => Except String Reply
  | .keep _ _ => Bool
  | .forget => Bool
  | .ask _ _ => AskEnd
  | .say _ => Unit

/-- The trivially indexed signature of nano's effects. -/
def sig : Sig Unit where
  Op := fun _ => NOp
  Resp := fun op => NOp.Resp op
  next := fun _ _ => ()

/-- A nano program as an open protocol without holes. -/
def ofProg {α : Type} : Prog α → Prot sig (fun _ => Empty) (fun _ => α) ()
  | .done a => .ret a
  | .cmd c k => .call (S := sig) (NOp.cmd c) fun x => ofProg (k x)
  | .keep r t k => .call (S := sig) (NOp.keep r t) fun b => ofProg (k b)
  | .forget k => .call (S := sig) NOp.forget fun b => ofProg (k b)
  | .ask r q k => .call (S := sig) (NOp.ask r q) fun x => ofProg (k x)
  | .say s k => .call (S := sig) (NOp.say s) fun _ => ofProg k

/-- A performed interaction as nano's trace event. -/
def toEv : Entry sig → Ev
  | ⟨_, op, r⟩ => match op, r with
    | .cmd c, x => .cmd c x
    | .keep r t, b => .keep r t b
    | .forget, b => .forget b
    | .ask r q, x => .ask r q x
    | .say s, _ => .say s

/-- The oracle as a deterministic environment whose state is the call counter. -/
def oracleH (o : Oracle) : Handler sig (fun _ => Nat) where
  handle := fun op n => match op with
    | .cmd _ => ⟨o.cmd n, n + 1⟩
    | .keep _ _ => ⟨o.keep n, n + 1⟩
    | .forget => ⟨o.forget n, n + 1⟩
    | .ask _ _ => ⟨o.ask n, n + 1⟩
    | .say _ => ⟨(), n + 1⟩

end Nanodregg.Lang.Contextual.Protocol.Nano
/-
# Lang.Contextual.CoreCalculus — CMTT's data as a `CalculusData` (lane CMTT-CORE)

The data half of CMTT as an instance of CLOSURE's abstract calculus (`Lang.Contextual.Closure`);
the laws are `Lang.Proofs.Contextual.CoreInstance.cmttLaws`, over the typing judgment
`fun Ω => HasTy (holeEnv Ω)`. A template's holes are the FREE metavariables of a Core term: the
hole named `n` is `mvar (n + d)` under `d` `letbox`es.
-/
import Lang.Contextual.Core
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

/-- The modal environment of a hole list: the hole named `n` is the first declaration named `n`. -/
def holeEnv (Ω : List (HoleDecl Ctx Ty)) : MEnv := fun n =>
  (Ω.find? fun d => d.name == n).map fun d => (d.ctx, d.ty)

/-- CMTT's data: hand-written decidable equality, hole filling `msubstP θ 0`, the exact checker,
free-variable occurrence, context deletion, strengthening/weakening at a position, variables. -/
def cmttData : CalculusData where
  Ty := Ty
  Ctx := Ctx
  Tm := Tm
  tmEq := Tm.decEq
  msubst θ t := msubstP θ 0 t
  check := check
  uses t x := uses x t
  drop Γ x := Γ.eraseIdx x
  strengthen x t := unshiftAt x t
  weaken x t := shiftAt x t
  var := Tm.var
  lookup Γ x := Γ[x]?

end Nanodregg.Lang.Contextual
/- Guarded contextual closure: ClosureStatements. Moved without statement changes from Closure. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

variable {D : CalculusData} {E : Type}
  {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}


/-! ## The laws of a calculus, and the statements over closures -/

/-- The LAWS of a contextual calculus over its data `D` and a typing relation `HasTy`
(`HasTy Ω Ψ M A` is `Ω; Ψ ⊢ M : A`, meta-context `Ω`), each named after the CMTT fact it stands for. -/
structure CalculusLaws (D : CalculusData)
    (HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop) : Prop where
  /-- CMTT's meta-substitution lemma, partial form: the filled holes leave the meta-context. -/
  msubst_lemma : ∀ {Ω : List (HoleDecl D.Ctx D.Ty)} {Γ : D.Ctx} {P : D.Tm} {T : D.Ty}
    (σ : Nat → Option D.Tm), HasTy Ω Γ P T →
    (∀ d ∈ Ω, ∀ M, σ d.name = some M → HasTy [] d.ctx M d.ty) →
    HasTy (Ω.filter fun d => (σ d.name).isNone) Γ (D.msubst σ P) T
  check_sound : ∀ {Ψ : D.Ctx} {M : D.Tm} {A : D.Ty}, D.check Ψ M A = true → HasTy [] Ψ M A
  /-- The checker is complete: a `false` verdict is a refutation of typing, not an omission. -/
  check_complete : ∀ {Ψ : D.Ctx} {M : D.Tm} {A : D.Ty}, HasTy [] Ψ M A → D.check Ψ M A = true
  strengthen_lemma : ∀ {Ψ : D.Ctx} {M : D.Tm} {A : D.Ty} {x : Nat}, HasTy [] Ψ M A →
    D.uses M x = false → HasTy [] (D.drop Ψ x) (D.strengthen x M) A
  strengthen_factor : ∀ {M : D.Tm} {x : Nat}, D.uses M x = false → D.weaken x (D.strengthen x M) = M
  /-- Non-degeneracy of `drop`/`weaken`: a term typed WITHOUT `x`, weakened back, does not use `x`.
  With `hasTy_var`/`uses_var` it refutes both degenerate choices: `uses ≡ false` (refuted by
  `uses_var`) and `drop Ψ _ = Ψ` with `weaken = id` (`drop_removes`). -/
  weaken_avoids : ∀ {Ψ : D.Ctx} {M : D.Tm} {A : D.Ty} {x : Nat}, HasTy [] (D.drop Ψ x) M A →
    D.uses (D.weaken x M) x = false
  /-- The variable rule. -/
  hasTy_var : ∀ {Ψ : D.Ctx} {x : Nat} {A : D.Ty}, D.lookup Ψ x = some A → HasTy [] Ψ (D.var x) A
  /-- A variable uses itself. -/
  uses_var : ∀ {x : Nat}, D.uses (D.var x) x = true

/-- The template types at its closed type under the open interface of its holes. -/
def Template.Typed (tpl : Template D E)
    (HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop) : Prop :=
  HasTy (tpl.Ω.map Iface.decl) tpl.Γ tpl.P tpl.T

/-- A monomial holds in a world: its positive literals live, its negative literals dead. -/
def Monomial.holds (w : World E) (m : List Token × List Token) : Prop :=
  (∀ t ∈ m.1, w.live t = true) ∧ (∀ b ∈ m.2, w.live b = false)

/-- DERIVABILITY: the template with the selected fillings types at its closed type, under the
meta-context of the holes still unfilled. -/
def Derivable (HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop) (cl : Closure D E) :
    Prop :=
  HasTy ((cl.tpl.Ω.map Iface.decl).filter fun d => (cl.sigma d.name).isNone)
    cl.tpl.Γ (D.msubst cl.sigma cl.tpl.P) cl.tpl.T

/-- A hole's selection names a retained candidate whose filling passes the hole's checker. -/
def SlotFilled (I : Iface D E) (s : Slot D) : Prop :=
  ∀ i, s.selected = some i → ∃ c, s.cands[i]? = some c ∧ D.check I.ctx c.filling I.ty = true

/-- Every selection is well filled. -/
def WellFilled (cl : Closure D E) : Prop :=
  ∀ I ∈ cl.tpl.Ω, SlotFilled I (cl.slot I.name)

/-- Every selected candidate's RECORDED status is `verified` (nothing awaits repair). -/
def Settled (cl : Closure D E) : Prop :=
  ∀ I ∈ cl.tpl.Ω, ∀ i, (cl.slot I.name).selected = some i →
    ∃ c, (cl.slot I.name).cands[i]? = some c ∧ c.status = .verified

/-- AVAILABILITY: every support of every selected candidate is live in `w`. -/
def Available (w : World E) (cl : Closure D E) : Prop :=
  ∀ I ∈ cl.tpl.Ω, ∀ c, cl.selectedCand I.name = some c → ∀ t ∈ effSupports I c, w.live t = true

/-- The recorded statuses are the judgment at `w`. -/
def Coherent (w : World E) (cl : Closure D E) : Prop :=
  ∀ I ∈ cl.tpl.Ω, ∀ c ∈ (cl.slot I.name).cands, c.status = judge I w c

/-- The guard is a function of the filling's VALUE only. -/
def ValueGuard {V : Type} (value : D.Tm → V) (g : E → D.Tm → Bool) : Prop :=
  ∃ g' : E → V → Bool, ∀ e t, g e t = g' e (value t)

/-- The guard's verdict is stable under the term map `s`. -/
def StableUnder (g : E → D.Tm → Bool) (s : D.Tm → D.Tm) : Prop :=
  ∀ e t, g e (s t) = g e t

/-- Least-fixpoint grounding: an atom holds iff a well-founded derivation from live facts exists. -/
inductive Derives (R : List Rule) (F : Nat → Bool) : Nat → Prop where
  | fact {x : Nat} : F x = true → Derives R F x
  | rule {r : Rule} : r ∈ R → (∀ y ∈ r.body, Derives R F y) → Derives R F r.head



end Nanodregg.Lang.Contextual
/- Guarded contextual closure: Judge. Moved without statement changes from Closure. -/
import Lang.Proofs.Contextual.ClosureStatements

namespace Nanodregg.Lang.Contextual

variable {D : CalculusData} {E : Type}
  {HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop}


/-! ## Tokens -/

theorem set_live (w : World E) (t t' : Token) (b : Bool) :
    (w.set t b).live t' = if t' = t then b else w.live t' := rfl

/-- **Immutable versioned tokens.** Re-issuing an id at a new version never re-enables the old
token: whatever was live before, the old version is dead afterwards. -/
theorem reissue_never_reenables (w : World E) (id old new : Nat) (h : old ≠ new) :
    (applyAll (reissue id old new) w).live ⟨id, old⟩ = false := by
  simp [reissue, applyAll, Edit.apply, World.set, h]

/-! ## The judgment -/

theorem judge_congr {I : Iface D E} {w w' : World E} {c : Candidate D} (he : w.env = w'.env)
    (hl : ∀ t ∈ deps I c, w.live t = w'.live t) : judge I w c = judge I w' c := by
  have hb : c.blockers.filter w.live = c.blockers.filter w'.live :=
    List.filter_congr fun t ht => hl t (by simp [deps, ht])
  have hs : (effSupports I c).filter (fun t => !w.live t) =
      (effSupports I c).filter (fun t => !w'.live t) :=
    List.filter_congr fun t ht => by rw [hl t (by simp [deps, ht])]
  simp only [judge, he, hb, hs]

/-- **The boundary lemma.** An edit that does not touch a candidate leaves its judgment unchanged:
the dependency sets are sufficient. -/
theorem judge_frame {I : Iface D E} {w : World E} {c : Candidate D} {e : Edit E}
    (h : touches e I c = false) : judge I (e.apply w) c = judge I w c := by
  cases e with
  | withdraw t =>
    simp only [touches, decide_eq_false_iff_not] at h
    exact judge_congr rfl fun t' ht' => by
      have : t' ≠ t := fun he => h (he ▸ ht')
      simp [Edit.apply, World.set, this]
  | assert t =>
    simp only [touches, decide_eq_false_iff_not] at h
    exact judge_congr rfl fun t' ht' => by
      have : t' ≠ t := fun he => h (he ▸ ht')
      simp [Edit.apply, World.set, this]
  | setEnv _ => simp [touches] at h

theorem blockers_empty_iff {w : World E} {bs : List Token} :
    (bs.filter w.live).isEmpty = true ↔ ∀ b ∈ bs, w.live b = false := by
  rw [List.isEmpty_iff, List.filter_eq_nil_iff]; simp

theorem missing_empty_iff {w : World E} {ts : List Token} :
    (ts.filter fun t => !w.live t).isEmpty = true ↔ ∀ t ∈ ts, w.live t = true := by
  rw [List.isEmpty_iff, List.filter_eq_nil_iff]; simp

theorem judge_verified_iff {I : Iface D E} {w : World E} {c : Candidate D} :
    judge I w c = .verified ↔
      D.check I.ctx c.filling I.ty = true ∧ I.guard w.env c.filling = true ∧
      (∀ b ∈ c.blockers, w.live b = false) ∧ (∀ t ∈ effSupports I c, w.live t = true) ∧
      c.cost ≤ I.budget := by
  rw [← blockers_empty_iff, ← missing_empty_iff]
  unfold judge
  cases h1 : D.check I.ctx c.filling I.ty <;>
  cases h2 : I.guard w.env c.filling <;>
  cases h3 : (c.blockers.filter w.live).isEmpty <;>
  cases h4 : ((effSupports I c).filter fun t => !w.live t).isEmpty <;>
  by_cases h5 : c.cost ≤ I.budget <;> simp [h5]

/-- `conflict` is decided by the checker and the guard alone: it reads no token. Its `illTyped`
arm is a refutation of typing (`conflict_illTyped_refutes`, by `check_complete`), its `guardFails`
arm a checked guard failure in the current environment. -/
theorem judge_conflict_iff {I : Iface D E} {w : World E} {c : Candidate D} {ev : Evidence} :
    judge I w c = .conflict ev ↔
      (D.check I.ctx c.filling I.ty = false ∧ ev = .illTyped) ∨
      (D.check I.ctx c.filling I.ty = true ∧ I.guard w.env c.filling = false ∧ ev = .guardFails) := by
  unfold judge
  cases h1 : D.check I.ctx c.filling I.ty <;>
  cases h2 : I.guard w.env c.filling <;>
  cases h3 : (c.blockers.filter w.live).isEmpty <;>
  cases h4 : ((effSupports I c).filter fun t => !w.live t).isEmpty <;>
  by_cases h5 : c.cost ≤ I.budget <;> cases ev <;> simp [h5]

/-- **`illTyped` is a refutation.** With a complete checker, a candidate judged `conflict illTyped`
does not type at its hole: checked contrary evidence, not a missing proof. -/
theorem conflict_illTyped_refutes (L : CalculusLaws D HasTy) {I : Iface D E} {w : World E}
    {c : Candidate D} (h : judge I w c = .conflict .illTyped) : ¬ HasTy [] I.ctx c.filling I.ty := by
  intro hty
  rcases judge_conflict_iff.1 h with ⟨hc, -⟩ | ⟨-, -, hev⟩
  · rw [L.check_complete hty] at hc; cases hc
  · cases hev

/-- `pruned` names exactly the live blockers, and there is at least one. -/
theorem judge_pruned {I : Iface D E} {w : World E} {c : Candidate D} {bs : List Token}
    (h : judge I w c = .pruned bs) :
    D.check I.ctx c.filling I.ty = true ∧ I.guard w.env c.filling = true ∧
      bs = c.blockers.filter w.live ∧ (c.blockers.filter w.live).isEmpty = false := by
  unfold judge at h
  revert h
  cases h1 : D.check I.ctx c.filling I.ty <;>
  cases h2 : I.guard w.env c.filling <;>
  cases h3 : (c.blockers.filter w.live).isEmpty <;>
  cases h4 : ((effSupports I c).filter fun t => !w.live t).isEmpty <;>
  by_cases h5 : c.cost ≤ I.budget <;> simp [h5, eq_comm]

/-- **The provenance bridge.** `provenance I env cs` is a polynomial over tokens computed from the
environment alone (it reads no liveness): one monomial per candidate that passes the checker, the
guard and the budget, its supports as positive literals and its blockers as negative literals. A
hole has a verified candidate at `w` iff some monomial holds in `w` (sum = alternatives, product =
joint requirements, negation = an exclusion reason). This is the bridge to `judge_verified_iff`: the
token part of the judgment IS the evaluation of a world-independent polynomial. -/
theorem provenance_iff {I : Iface D E} {w : World E} {cs : List (Candidate D)} :
    (∃ c ∈ cs, judge I w c = .verified) ↔
      ∃ m ∈ provenance I w.env cs, Monomial.holds w m := by
  constructor
  · rintro ⟨c, hc, hv⟩
    obtain ⟨h1, h2, h3, h4, h5⟩ := judge_verified_iff.1 hv
    refine ⟨(effSupports I c, c.blockers), ?_, h4, h3⟩
    simp only [provenance, List.mem_map, List.mem_filter]
    exact ⟨c, ⟨hc, by simp [h1, h2, h5]⟩, rfl⟩
  · rintro ⟨m, hm, hl, hb⟩
    simp only [provenance, List.mem_map, List.mem_filter, Bool.and_eq_true, decide_eq_true_eq] at hm
    obtain ⟨c, ⟨hc, ⟨⟨h1, h2⟩, h5⟩⟩, rfl⟩ := hm
    exact ⟨c, hc, judge_verified_iff.2 ⟨h1, h2, hb, hl, h5⟩⟩

/-- **The obstruction is real.** For every token-backed hypothesis `(x, t)` of a hole, the bare
variable `x` types at the type the context gives it and cites `t`: a filling that uses `x` depends on
`t`, so `uses ≡ false` cannot hide the obstruction. -/
theorem hyp_var_cites (L : CalculusLaws D HasTy) {I : Iface D E} {x : Nat} {t : Token} (h : (x, t) ∈ I.hyps)
    (c : Candidate D) (hc : c.filling = D.var x) :
    (∃ A, D.lookup I.ctx x = some A ∧ HasTy [] I.ctx c.filling A) ∧ t ∈ effSupports I c := by
  refine ⟨?_, ?_⟩
  · have := I.hyps_real _ h
    cases hA : D.lookup I.ctx x with
    | none => rw [hA] at this; cases this
    | some A => exact ⟨A, rfl, hc ▸ L.hasTy_var hA⟩
  · simp only [effSupports, List.mem_append, List.mem_map, List.mem_filter]
    exact Or.inr ⟨(x, t), ⟨h, by rw [hc]; exact L.uses_var⟩, rfl⟩

/-- **Weakening never produces the dropped variable.** No term typed in `drop Ψ x`, weakened back,
is the variable `x`: the general form, which bites for every calculus (de Bruijn included). -/
theorem weaken_never_var (L : CalculusLaws D HasTy) {Ψ : D.Ctx} {M : D.Tm} {A : D.Ty} {x : Nat}
    (h : HasTy [] (D.drop Ψ x) M A) : D.weaken x M ≠ D.var x := by
  intro he
  have := L.weaken_avoids h
  rw [he, L.uses_var] at this
  cases this

/-- **`drop` removes the hypothesis, for weakenings that fix the variable.** If weakening fixes
`var x` (named-variable calculi such as the toy, or the degenerate `weaken = id`), then `var x` does
not type in `drop Ψ x`, so `drop = id` with `weaken = id` is refuted. It does NOT cover a de Bruijn
weakening (CMTT's `shiftAt` sends `var x` to `var (x+1)`, so the premise is false there); the
general statement is `weaken_never_var`. -/
theorem drop_removes (L : CalculusLaws D HasTy) {Ψ : D.Ctx} {x : Nat} {A : D.Ty}
    (hw : D.weaken x (D.var x) = D.var x) : ¬ HasTy [] (D.drop Ψ x) (D.var x) A :=
  fun h => weaken_never_var L h hw

/-! ## Withdrawal never refutes -/

/-- **Losing a justification does not establish its negation.** A withdrawal neither creates nor
removes a `conflict`, with the same evidence. -/
theorem withdraw_never_refutes {I : Iface D E} {w : World E} {c : Candidate D} {t : Token}
    {ev : Evidence} :
    judge I ((Edit.withdraw t).apply w) c = .conflict ev ↔ judge I w c = .conflict ev := by
  rw [judge_conflict_iff, judge_conflict_iff]; rfl

/-- Any token edit (withdraw or assert) leaves `conflict` exactly as it was: only an environment
change (or a different filling) can produce or remove checked contrary evidence. -/
theorem token_edit_conflict_iff {I : Iface D E} {w : World E} {c : Candidate D} {e : Edit E}
    {t : Token} (he : e = .withdraw t ∨ e = .assert t) {ev : Evidence} :
    judge I (e.apply w) c = .conflict ev ↔ judge I w c = .conflict ev := by
  rcases he with rfl | rfl <;> (rw [judge_conflict_iff, judge_conflict_iff]; rfl)

/-- A withdrawal never creates a pruning: it only removes liveness. -/
theorem withdraw_never_prunes {I : Iface D E} {w : World E} {c : Candidate D} {t : Token}
    {bs : List Token} (h : judge I ((Edit.withdraw t).apply w) c = .pruned bs) :
    ∃ bs', judge I w c = .pruned bs' := by
  obtain ⟨h1, h2, _, h3⟩ := judge_pruned h
  have h3' : (c.blockers.filter w.live).isEmpty = false := by
    cases hx : (c.blockers.filter w.live).isEmpty
    · rfl
    · have hall := blockers_empty_iff.1 hx
      have : (c.blockers.filter ((Edit.withdraw t).apply w).live).isEmpty = true := by
        apply blockers_empty_iff.2
        intro b hb
        simp only [Edit.apply, World.set]
        split
        · rfl
        · exact hall b hb
      rw [this] at h3; cases h3
  refine ⟨c.blockers.filter w.live, ?_⟩
  have h2' : I.guard w.env c.filling = true := h2
  unfold judge
  simp [h1, h2', h3']

/-! ## Lookup -/

theorem find_name_self {Ω : List (Iface D E)} (hn : (Ω.map Iface.name).Nodup) {I : Iface D E}
    (hI : I ∈ Ω) : Ω.find? (fun J => J.name == I.name) = some I := by
  induction Ω with
  | nil => cases hI
  | cons J rest ih =>
    rw [List.map_cons, List.nodup_cons] at hn
    rw [List.find?_cons]
    rcases List.mem_cons.1 hI with rfl | h
    · simp
    · have hne : J.name ≠ I.name := fun he => hn.1 (he ▸ List.mem_map.2 ⟨I, h, rfl⟩)
      have hb : (J.name == I.name) = false := by simp [hne]
      simp [hb, ih hn.2 h]

theorem find_self {cl : Closure D E} {I : Iface D E} (hI : I ∈ cl.tpl.Ω) : cl.find I.name = some I :=
  find_name_self cl.tpl.names hI

theorem find_some {cl : Closure D E} {u : Nat} {I : Iface D E} (h : cl.find u = some I) :
    I ∈ cl.tpl.Ω ∧ I.name = u := by
  unfold Closure.find at h
  exact ⟨List.mem_of_find?_eq_some h, by simpa using List.find?_some h⟩


end Nanodregg.Lang.Contextual


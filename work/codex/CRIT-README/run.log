52:/-- A primitive's frame pays its ticks (LANG-64) until the tick that computes it: a run from the
53:frame with `j` paid passes, no later, through the frame with some `j'` paid at which the next tick
54:computes (`primTicks ≤ j' + 1`). -/
55:theorem Ends.paid {p : Prim} {a v : Val} {k : List Frame} {d : Nat} {o : Except Fault Val} :
56:    ∀ (i j n : Nat), primTicks p a v ≤ j + 1 + i → Ends lib ⟨.ret v, .primR p a j :: k, d⟩ o n →
57:      ∃ j' n', n' ≤ n ∧ primTicks p a v ≤ j' + 1 ∧ Ends lib ⟨.ret v, .primR p a j' :: k, d⟩ o n'
58:  | 0, j, n, hi, h => ⟨j, n, Nat.le_refl _, by omega, h⟩
59:  | i + 1, j, n, hi, h => by
67:/-- A run from `eval t env` on stack `k` ends in `t`'s faulting meaning, or returns `t`'s value. -/
68:def EvalAgrees (lib : List Term) (n : Nat) : Prop :=
69:  ∀ (t : Term) (env : Env) (k : List Frame) (d : Nat) (o : (Except Fault Val)), o ≠ .error .stuck →
70:    Ends lib ⟨.eval t env, k, d⟩ o n →
71:    (∃ e, o = .error e ∧ BigStep lib env t (.error e)) ∨
72:    (∃ w m, m < n ∧ BigStep lib env t (.ok w) ∧ Ends lib ⟨.ret w, k, d⟩ o m)
75:value to the rest of the stack. -/
76:def SelAgrees (lib : List Term) (n : Nat) : Prop :=
77:  ∀ (v : Val) (ℓ : Label) (k : List Frame) (d : Nat) (o : (Except Fault Val)), o ≠ .error .stuck →
78:    Ends lib ⟨.ret v, .get ℓ :: k, d + 1⟩ o n →
79:    (∃ e, o = .error e ∧ Sel lib v ℓ (.error e)) ∨
80:    (∃ w m, m < n ∧ Sel lib v ℓ (.ok w) ∧ Ends lib ⟨.ret w, k, d⟩ o m)
81:
82:def ExtAgrees (lib : List Term) (n : Nat) : Prop :=
83:  ∀ (v : Val) (fs : List (Label × Term)) (env : Env) (k : List Frame) (d : Nat) (o : (Except Fault Val)),
84:    o ≠ .error .stuck → Ends lib ⟨.ret v, .extend fs env :: k, d + 1⟩ o n →
85:    (∃ e, o = .error e ∧ Ext lib v fs env (.error e)) ∨
86:    (∃ w m, m < n ∧ Ext lib v fs env (.ok w) ∧ Ends lib ⟨.ret w, k, d⟩ o m)

SOURCE Host/Sim/File.lean
1180:(DIR defaults to `.lake/host-file-sim`), which this run creates, refuses to reuse, and removes
1181:when it ends (D9: no runtime temp-file primitive; they abort under a missing TMPDIR). -/
1182:def run (args : List String) : IO UInt32 := do
1183:  -- `--harness-control` (GATES-15): one check nothing meets, inside the ordinary run. Any other
1184:  -- argument that is not `SEED [DIR]` is refused, never read as seed 1 or as a directory.
1185:  let control := args.contains "--harness-control"
1186:  let adoptionOnly := args.contains "--adoption-only"
1187:  let (some seed, root) := (match args.filter (fun a => a != "--harness-control" && a != "--adoption-only") with
1188:      | [] => (some 1, ".lake/host-file-sim")
1189:      | [s] => (s.toNat?, ".lake/host-file-sim")
1190:      | [s, d] => (s.toNat?, d)

SOURCE Protocol/Rows/Run.lean
15:`--times N` scales every repeated line (THE BAR: `rows --times 1000 bar`).
16:
17:`--deployed` runs every member row (and its plant) at the DEPLOYED parameters
18:(`Rows.Params.deployed`: `host`'s own `Ctx`, World codec and KMAC256 sealers, custody's Ed25519
19:keys) instead of the toy's; it selects the parameters the harness instantiates the one pipeline
20:with, never a mode inside admission (PROTOCOL-50). Before any row, the run measures its parameters'
21:widths (`Params.atDeployed`: a 32-byte digest, an Ed25519 key and signature, a 32-byte base digest
22:and tag) and requires the toy's to FAIL that check by name (`digest 8≠32`): the plant that the
23:check reads the parameters at all. Each row prints its cost in deterministic units beside the
24:verdict: `COST <row> frames <frames sent on either socket> steps <the writer's World steps>`.
25:-/
26:import Protocol.Rows.Judge
202:
203:/-- Drive one row under the parameters `R`. `measures`: print THE BAR row's LIVE and WASTE lines
204:(the toy run's; the deployed run prints none, so a WASTE measure is collected once). -/
205:def drive {D : Type} [Ord D] [DecidableEq D] (R : Params D) (r : Row) (times : Option Nat)
206:    (control : Bool := false) (measures : Bool := true) : IO Ran :=
207:  if let some why := r.blockedOn then pure (.pending s!"blocked on {why}") else
208:  match r.drive with
209:  | .exe name args _ => runExe name args
210:  | .members ls => do
211:      match ← runMembers R none ls times r.pageBudget with
212:      | .error e => pure (.broken e)
277:    IO.println "ALL PASS"; pure 0
278:
279:/-- The deployed run's parameter check, before any row: the deployed parameters measure the deployed
280:widths, and the toy's are refused by name (the plant: a check that passed the toy would not be
281:reading the widths). An error names what is wrong. -/
282:def checkDeployed : Except String Unit := do
283:  match Params.atDeployed Params.deployed with
284:  | .error e => throw s!"the deployed parameters are not at the deployed widths: {e}"
285:  | .ok () => pure ()
286:  match Params.atDeployed Params.toy with
287:  | .ok () => throw "plant toyWidths BLIND: the toy parameters pass the deployed-width check"
288:  | .error e =>
289:    if (e.splitOn " ").head? ≠ some "digest" then throw s!"plant toyWidths MOVED: refused {e}, not digest"
290:
291:/-- `rows [--deployed] [-v] [--times N] [--harness-control] [ROW…]`. `--harness-control` (GATES-15)
292:reads every plant at a line its row does not have, so every planted row must read
293:`FAIL … BLIND … (harness-control)`: the known-red control gates/runs.py runs before reading a
294:verdict. `--deployed` runs at the deployed parameters (above). -/
295:def main (args : List String) : IO UInt32 := do
296:  let control := args.contains "--harness-control"
297:  let deployed := args.contains "--deployed"
298:  let args := args.filter fun a => a != "--harness-control" && a != "--deployed"
299:  let (verbose, args) := match args with
300:    | "-v" :: rest => (true, rest)
301:    | _ => (false, args)
302:  let (times, args) := match args with
303:    | "--times" :: n :: rest => (n.toNat?, rest)
304:    | _ => (none, args)
305:  let unknown := args.filter fun a => !rows.any (·.name == a)
306:  if !unknown.isEmpty then
308:    return 2
309:  let selected := if args.isEmpty then rows else rows.filter fun r => args.contains r.name
310:  if deployed then
311:    if let .error e := checkDeployed then

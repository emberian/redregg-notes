102:32 bytes before it (`frameOf`, what a page reads) and decodes to steps `ts`; the next entry, or
103:the tip after the last, sits at that frame's end and at the step count `ts` leaves. -/
104:def Indexes {D : Type} (dc : Codec.Stream D) (s : Log.Sealer) (recordMax : Nat)
105:    (read : Nat → Nat → Id ByteArray) : List Entry → Nat × Nat → Prop
106:  | [], _ => True
107:  | e :: rest, tip => ∃ (r : ByteArray) (ts : List (Kernel.Step D × D)),
108:      frameOf s recordMax read e.offset = some r ∧ (Record.codec dc).decode r = .ok ts ∧
109:      (match rest with | [] => tip | e' :: _ => (e'.offset, e'.steps)) =
110:        (e.offset + frameSize r, e.steps + ts.length) ∧
111:      Indexes dc s recordMax read rest tip

690:to the new end and the step count `ts` leaves. -/
691:theorem Indexes.snoc {D : Type} {dc : Codec.Stream D} {s : Sealer} {rm : Nat} {S prev r : ByteArray}
692:    {h : Nat} {ch : ByteArray} {L : List Entry} {ts : List (Kernel.Step D × D)}
693:    (hL : Indexes dc s rm (fun o l => (pure (S.extract o (o + l)) : Id ByteArray)) L (S.size, h))
694:    (h32 : tagBytes ≤ S.size) (hp : S.extract (S.size - tagBytes) (S.size - tagBytes + tagBytes) = prev)
695:    (hr : r.size ≤ rm) (hr32 : r.size < 2 ^ 32) (hdec : (Record.codec dc).decode r = .ok ts) :
696:    Indexes dc s rm (fun o l => (pure ((S ++ frame s prev r).extract o (o + l)) : Id ByteArray))
697:      (L ++ [⟨h, S.size, ch⟩]) (S.size + frameSize r, h + ts.length) := by
698:  have hfs : (frame s prev r).size = frameSize r := by rw [size_frame]; rfl
699:  have hL' := Indexes.congr (S' := S ++ frame s prev r)
713:record pushes, last, an entry at or past `off` whose offset holds the last record's frame, chained
714:from the 32 bytes before it, ending at the fold's offset. -/
715:theorem indexed_last {W F : Type} {s : Sealer} {rm : Nat} {S : ByteArray}
716:    (mark : W → Nat × ByteArray) (step : W → ByteArray → Except F W) :
717:    ∀ (rs : List ByteArray) (w : W) (idx : Array Entry) (off : Nat) (prev : ByteArray)
718:      {st : W × Array Entry × Nat}, rs ≠ [] →
719:      (∀ r ∈ rs, r.size ≤ rm ∧ r.size < 2 ^ 32) →
720:      S.extract (off - tagBytes) (off - tagBytes + tagBytes) = prev →
721:      S.extract off (off + (encodeAll s prev rs).size) = encodeAll s prev rs →
722:      rs.foldlM (indexed mark step) (w, idx, off) = .ok st →
723:      ∃ (e : Entry) (r : ByteArray), st.2.1.back? = some e ∧ off ≤ e.offset ∧ r.size ≤ rm ∧ r.size < 2 ^ 32 ∧
757:
758:
759:theorem frameAt_bounds {s : Sealer} {rm : Nat} {log prev : ByteArray} {off : Nat} {rd : Read}
760:    (h : frameAt s rm log off prev = some rd) : rd.record.size ≤ rm ∧ rd.record.size < 2 ^ 32 := by
761:  unfold frameAt at h
762:  split at h
763:  · cases h
764:  · rename_i len hl
765:    split at h
766:    · cases h
767:    · rename_i hlen
780:segment's first 32 bytes whose offset holds a frame, chained from the 32 bytes before it and within the
781:record bound, that ends at `B` (inside the segment). -/
782:theorem lastFrameFault_frame {F : Type} {s : Sealer} {rm O B : Nat} {S r : ByteArray} {e : Entry}
783:    (h32 : tagBytes ≤ e.offset) (hB : e.offset + frameSize r = B) (hBS : B ≤ S.size)
784:    (hf : S.extract e.offset (e.offset + frameSize r) = frame s (S.extract (e.offset - tagBytes) e.offset) r)
785:    (hr : r.size ≤ rm) (hr32 : r.size < 2 ^ 32) :
786:    Id.run (lastFrameFault (F := F) s rm O B (some e) (segReader S)) = none := by
787:  have hfs := frameSize_ge r
788:  have hlr : lastRange rm B e = some (e.offset - tagBytes, B - e.offset + tagBytes) := by
789:    unfold lastRange
790:    rw [if_pos ⟨h32, by omega, by unfold frameMax; unfold frameSize at hB; omega⟩]
807:segment, `e`'s offset is at least 32 bytes into the segment and holds a frame a page reads (`frameOf`)
808:that ends exactly at `B`. -/
809:theorem lastFrameFault_sound {F : Type} {s : Sealer} {rm O B : Nat} {S : ByteArray} {e : Entry}
810:    (h : Id.run (lastFrameFault (F := F) s rm O B (some e) (segReader S)) = none) :
811:    tagBytes ≤ e.offset ∧ ∃ r, frameOf s rm (fun o l => (pure (S.extract o (o + l)) : Id ByteArray)) e.offset = some r ∧
812:      e.offset + frameSize r = B := by
813:  simp only [lastFrameFault] at h
814:  cases hlr : lastRange rm B e with
815:  | none => rw [hlr] at h; cases h
816:  | some p =>
817:    obtain ⟨a, len⟩ := p
849:record before the base, HOST-53's alternative (d)) is refused `indexCorrupt`, before anything is
850:read. -/
851:theorem lastFrameFault_past {F : Type} {m : Type → Type} [Monad m] (s : Sealer) (rm O B : Nat) (e : Entry)
852:    (readTail : Nat → Nat → m (Except (StoreFault F) ByteArray)) (h : B ≤ e.offset) :
853:    lastFrameFault s rm O B (some e) readTail = pure (some (.base .indexCorrupt)) := by
854:  simp only [lastFrameFault, lastRange]
855:  rw [if_neg (by omega)]
856:
857:/-- **The tooth of `lastFrame`**: a frame that verifies but ends before the bytes do (an entry
858:pointing at an earlier record, not the last before the base) is refused `indexCorrupt`. -/
859:theorem lastFrame_short {s : Sealer} {rm : Nat} {bytes : ByteArray} {rd : Read}
860:    (h : frameAt s rm bytes tagBytes (bytes.extract 0 tagBytes) = some rd) (hn : rd.next ≠ bytes.size) :
861:    lastFrame s rm bytes = some .indexCorrupt := by
862:  unfold lastFrame
863:  rw [h]
864:  simp only [if_neg hn]
865:
866:/-- **The one entry open reads points at its own record** (HOST-63): an open that succeeds over a
867:base that counts an entry read that entry at its position under the Store's index key, and its
869:base's offset. That this is the segment's own last record, not another frame that verifies there,
870:rests on the sealer's tags; it is not proved from `Log.recover`. -/
871:theorem openWith_lastFrame {W F : Type} (keys : Keys) (c : Cadence) (world : Codec.Stream W)
872:    (mark : W → Nat × ByteArray) (origin : W → ByteArray) (step : W → ByteArray → Except F W)
873:    (file H I S : ByteArray) {o : Opening W}
874:    (h : Id.run (openWith keys c world mark origin step file H S.size I.size (segReader I) (segReader S)) = .ok o)
875:    (hpos : 0 < o.sealed.index.count) :
876:    ∃ (b : Base W) (n : Nat) (d : ByteArray) (e : Entry) (r : ByteArray),
877:      Base.read keys c world file = .ok (b, n, d) ∧ b.indexCount = o.sealed.index.count ∧
878:      b.offset = o.sealed.offset ∧ Entry.read (keys.forStore (origin b.world)) (b.indexCount - 1)
879:        (I.extract ((b.indexCount - 1) * entryBytes keys) ((b.indexCount - 1) * entryBytes keys + entryBytes keys)) =
901:the origin frame's end (a record before it that no entry indexes) is refused `indexCorrupt`,
902:before anything is read. -/
903:theorem lastFrameFault_none_off {F : Type} {m : Type → Type} [Monad m] (s : Sealer) (rm O B : Nat)
904:    (readTail : Nat → Nat → m (Except (StoreFault F) ByteArray)) (h : B ≠ O) :
905:    lastFrameFault s rm O B none readTail = pure (some (.base .indexCorrupt)) := by
906:  simp only [lastFrameFault, if_neg h]
907:
908:/-- **A base that counts no entry sits at the origin frame's end** (HOST-65): an open that succeeds
909:over a base counting none read a base whose offset is the end of the origin frame, so no record
910:lies before it (`StoreIndexes`' run start). -/
911:theorem openWith_originEnd {W F : Type} (keys : Keys) (c : Cadence) (world : Codec.Stream W)
912:    (mark : W → Nat × ByteArray) (origin : W → ByteArray) (step : W → ByteArray → Except F W)
913:    (file H I S : ByteArray) {o : Opening W}
914:    (h : Id.run (openWith keys c world mark origin step file H S.size I.size (segReader I) (segReader S)) = .ok o)
915:    {b : Base W} {n : Nat} {d : ByteArray} (hb : Base.read keys c world file = .ok (b, n, d))
916:    (h0 : b.indexCount = 0) :
917:    b.offset = frameSize (origin b.world) := by
918:  obtain ⟨b', _, _, _, _, _, hb', _, _, _, _, _, _, _, _, hlf, _, _, _⟩ :=
919:    openWith_seg_ok keys c world mark origin step file H I S h

SOURCE Protocol/Head.lean
2:# Protocol.Head — a World's position, and a member's attestation of its own (PROTOCOL-74; DESIGN-TRUST T1)
3:
4:A HEAD is one World's position as every party states it: the World (its origin, KERNEL-24), its step
5:count (the chain's index, KERNEL-47), its height, its roots digest (what a receipt is checked
6:against, PROTOCOL-45) and its chain (what `fold_head_binds` binds: one `(steps, chain)` is one log).
7:Four spellings of it were in the tree (`logPage`'s pair, `receipt CALL`'s `head` line, `Std.head`'s
8:record, `host check`'s anchor); this is the one.
9:
10:An ATTESTATION is a member's signed statement that its OWN follow's fold sits at a head: the head,
11:the member and its key, signed under `domHead` (the seventh signing domain, pairwise disjoint from
12:the six of `Protocol.Proofs.Domains`). It is not an authority: it says what one member holds, never
13:what the World is. Follow makes one at the tip of a catch-up (`nd sync --attest`: the message it
14:hands custody is its own World's head, `Command.attestTip`) and checks another member's
15:(`nd sync --check ATTEST`): the signature under the key it names, the World, and, on the World it
16:caught up to, that the key is the signer's CURRENT one (a rotated-away key is `staleKey`: an
17:attestation is checked under the signer's current key; rotate, then attest again).
18:
19:The ANCHOR CHECK is the comparison (`anchorCheck`): as follow absorbs a page it advances the chain
20:over the page's steps, each with the roots digest after it (the record's shape, `Persist.steps`),
32:`headText` of follow's own World, planned as `invoke OBJ post` at the tip, `Command.body`), and
33:every follow that absorbs the page carrying that post reads the object (`selfPosts`: a head object
34:whose `world` is this World's origin, touched by a step of the page) and walks the page against the
35:posted `(steps, chain)` exactly as `sync --to` walks (`forkedSelfPost`). A post at a position the
36:page reaches with ANOTHER chain is `forkedPost`, the page kept (it is lawful on follow's fold) and
37:the command ended by name: the poster's signed call is the witness. A post at a position follow was
38:already past is not compared here: its chain is in follow's own Store (cv task T2b', the follow loop
39:through its index), as `host check --anchor` reads it.
40:-/
41:import Protocol.Envelope
42:import Protocol.Command.Text
51:/-- One World's position. -/
52:structure Head (D : Type) where
53:  origin : D
54:  steps : Nat
55:  height : Nat
56:  roots : D
57:  chain : D
58:  deriving DecidableEq
59:
60:/-- A World's own head. -/
61:def headOf (E : Env D) (w : World D) : Head D :=
62:  ⟨w.origin, w.steps, w.height, w.roots E, w.chain⟩
63:
64:/-- The domain every attestation message begins with. -/
65:def domHead : ByteArray := "nanodregg/protocol/head/v1".toUTF8
66:
67:/-- The signed part: the head's five fields, the member's id bytes and its key. -/
68:def unsignedLayout : Layout :=
69:  [.bytes "origin", .u64 "steps", .u64 "height", .bytes "roots", .bytes "chain", .bytes "member", .bytes "key"]
70:
71:/-- An attestation on the wire: the signed bytes as carried, then the signature over them. -/
72:def attestationLayout : Layout := [.bytes "unsigned", .bytes "signature"]
73:
74:def unsignedFrame : Stream (Layout.Ty Bounds.frameBytesMax unsignedLayout) :=
75:  Layout.codec Bounds.frameBytesMax (by decide) unsignedLayout
76:
77:def attestationFrame : Stream (Layout.Ty Bounds.frameBytesMax attestationLayout) :=
81:def unsignedBytes (E : Env D) (h : Head D) (member : D) (key : ByteArray) : Option ByteArray := do
82:  let f := Text.fit Bounds.frameBytesMax
83:  pure (unsignedFrame.bytes (← f (E.bytes h.origin), h.steps.toUInt64, h.height.toUInt64,
84:    ← f (E.bytes h.roots), ← f (E.bytes h.chain), ← f (E.bytes member), ← f key, ()))
85:
86:/-- What the member signs. -/
87:def message (unsigned : ByteArray) : ByteArray := domHead ++ unsigned
88:
89:/-- An attestation's wire bytes, or `none` past the frame bound. -/
90:def bytes (unsigned signature : ByteArray) : Option ByteArray := do
91:  let f := Text.fit Bounds.frameBytesMax
140:      pure { head := h, member := m, key := k, unsigned := u.1, signature := s.1 }
141:
142:/-- Decode and verify: the attestation is for `origin` and its signature verifies under the key it
143:names. Whether that key is the member's is `signer`'s question, asked on a caught-up World. -/
144:def verified (X : Ctx D) (origin : D) (b : ByteArray) : Except Refusal (Attestation D) :=
145:  match ofBytes X b with
146:  | none => .error .badAttestation
147:  | some a =>
148:    if a.head.origin ≠ origin then .error .otherWorld
149:    else if !X.verify a.key (message a.unsigned) a.signature then .error .badHeadSignature
150:    else .ok a
151:
152:/-- On `w`, the attestation's member is live and the key it names is that member's current one. -/
153:def signer (X : Ctx D) (w : World D) (a : Attestation D) : Except Refusal Unit :=
154:  match currentKey X.env w a.member with
155:  | none => .error .notMember
156:  | some k => if k = a.key then .ok () else .error .staleKey
194:/-- A self-head post: on `w'` (the World after the page), cell `c`, touched by step `s` of the page,
195:is a head object of THIS World (`Lang.headView` at `Foreign.headPackageId`, its `world` the World's
196:origin) holding an `at` head: its `(steps, chain)`, and the member whose call the step was. -/
197:def selfPost (X : Ctx D) (w' : World D) (s : Kernel.Step D) (c : D) : Option (Nat × ByteArray × Option D) := do
198:  let cell ← w'.live X.env c
199:  match Lang.headView X.digestOf (X.env.bytes (Foreign.headPackageId X.env)) cell with
200:  | some (.at world chain _ _ steps) =>
201:      if world = X.env.bytes w'.origin then
202:        some (steps, chain, match s with
203:          | .turn t => (X.decodeCall t.event).map (·.unsigned.member)
204:          | .refusal _ => none)
205:      else none
206:  | _ => none
207:
208:/-- Every self-head post a page carries, in log order. -/
209:def selfPosts (X : Ctx D) (w' : World D) (ts : List (Kernel.Step D × D)) : List (Nat × ByteArray × Option D) :=
239:
240:An attestation says what ONE MEMBER holds. A CERTIFICATE says what the WORLD is at: a head with
241:`threshold` signatures by the World's CERTIFIERS, the authority a World is given at its genesis
242:(KERNEL-69: `Kernel.Receive.Authority`, in the genesis input and the World's authority cell).
243:Every World today has `Authority.none` (no certifier, threshold 0: the writer's page is its bare
244:word and members audit, as before); one key at threshold 1 is the lock writer with a signature; `3f+1`
245:keys at threshold `2f+1` is the committee. The object, its domain (`domCertify`, the eighth a key
246:signs under) and its one verification path (`certified`: `threshold` DISTINCT listed certifiers,
247:each signature verifying over the certified bytes) land here, with refusals by name. No deployed
248:path PRODUCES a certificate yet (a Store holds no certify seed: cv 01a1769d, Ember's), and none
249:consumes one yet (the `Carried` start, the `log`/`read` reply field, `Thin.accept`, the head law's
250:`uncertified`: the next landing). What a verifier learns from `certified = .ok` is `Proofs.Head.certified_ok`; what two
251:certificates at one step count mean under a quorum is `certified_intersect` and
252:`certified_equivocation` there, the committee row of DESIGN-TRUST §1.3's table as a theorem over
253:the object alone. -/
254:
255:/-! `Authority` here is KERNEL's (`Kernel.Receive.Authority`, KERNEL-69): who may certify and how
256:many must, fixed at genesis, committed in the origin (`GenesisInput`) and carried in the World as
257:one ROM cell (`authorityCell`, read back by `authorityOf`); `Authority.none` names nobody. This file
258:defines no copy of it. -/
259:
260:/-- The domain every certificate message begins with (byte 19 differs from `domHead`). -/
261:def domCertify : ByteArray := "nanodregg/protocol/certify/v1".toUTF8
262:
263:/-- The certified part: the head's five fields. No member, no key: a certificate is the World's
264:statement, and who made it is the authority's list, not the bytes. -/
265:def certifiedLayout : Layout :=
266:  [.bytes "origin", .u64 "steps", .u64 "height", .bytes "roots", .bytes "chain"]
267:
268:/-- A certificate on the wire: the certified bytes as carried, then the signers (each an index into
269:the authority's list, as u64 bytes) and their signatures, two lists read in step. -/
270:def certificateLayout : Layout := [.bytes "certified", .list "signers", .list "signatures"]
271:
272:def certifiedFrame : Stream (Layout.Ty Bounds.frameBytesMax certifiedLayout) :=
273:  Layout.codec Bounds.frameBytesMax (by decide) certifiedLayout
274:
275:def certificateFrame : Stream (Layout.Ty Bounds.frameBytesMax certificateLayout) :=
276:  Layout.codec Bounds.frameBytesMax (by decide) certificateLayout
277:
278:/-- The bytes a certifier signs over, or `none` past the frame bound. -/
279:def certifiedBytes (E : Env D) (h : Head D) : Option ByteArray := do
280:  let f := Text.fit Bounds.frameBytesMax
281:  pure (certifiedFrame.bytes (← f (E.bytes h.origin), h.steps.toUInt64, h.height.toUInt64,
282:    ← f (E.bytes h.roots), ← f (E.bytes h.chain), ()))
283:
284:/-- What a certifier signs. -/
285:def certifyMessage (certified : ByteArray) : ByteArray := domCertify ++ certified
286:
287:/-- A certificate's wire bytes, or `none` past the frame bounds. -/
288:def certificateBytes (certified : ByteArray) (sigs : List (Nat × ByteArray)) : Option ByteArray := do
289:  let f := Text.fit Bounds.frameBytesMax
290:  let l := Text.fitList Bounds.frameBytesMax
291:  pure (certificateFrame.bytes (← f certified, ← l (sigs.map fun p => Text.u64 p.1),
292:    ← l (sigs.map (·.2)), ()))
293:
294:/-- A decoded certificate. -/
295:structure Certificate (D : Type) where
296:  head : Head D
297:  /-- the certified bytes exactly as carried (`certifiedFrame`) -/
298:  certified : ByteArray
299:  /-- the signers (indices into the authority's list) and their signatures, as carried -/
300:  sigs : List (Nat × ByteArray)
301:  deriving DecidableEq
302:
303:/-- Why a certificate is not taken (law 7). -/
304:inductive CertRefusal
305:  /-- the bytes are not a certificate (either frame, a digest field, or lists of two lengths) -/
306:  | badCertificate
307:  /-- it names another World -/
308:  | otherWorld
309:  /-- signer `index` is not in the authority's list -/
310:  | unlisted (index : Nat)
311:  /-- certifier `index` signs twice -/
312:  | repeated (index : Nat)
313:  /-- certifier `index`'s signature does not verify over the certified bytes -/
314:  | badCertifySignature (index : Nat)
315:  /-- fewer distinct listed certifiers than the authority's threshold -/
316:  | belowThreshold (signers threshold : Nat)
317:  /-- the authority names nobody (threshold 0, `Authority.none`): it certifies nothing, so no
318:  certificate under it is taken, however many signatures it carries (PROTOCOL-77.1) -/
319:  | noAuthority
320:  /-- it verifies, but certifies another head than the World it is checked against (PROTOCOL-77.1:
321:  a stale certificate of an older base, or a forged World under a genuine one) -/
322:  | otherHead
323:  deriving DecidableEq, Repr
324:
325:def CertRefusal.name : CertRefusal → String
339:
340:/-- Decode the certified bytes, checking nothing they state. -/
341:def certifiedSaid (X : Ctx D) (u : ByteArray) : Option (Head D) :=
342:  match certifiedFrame.decode u with
343:  | .error _ => none
344:  | .ok (o, s, h, r, c, ()) => do
345:      pure ⟨← X.digestOf o.1, s.toNat, h.toNat, ← X.digestOf r.1, ← X.digestOf c.1⟩
346:
347:/-- Decode a certificate, checking nothing it states. -/
348:def certificateOfBytes (X : Ctx D) (b : ByteArray) : Option (Certificate D) :=
349:  match certificateFrame.decode b with
350:  | .error _ => none
351:  | .ok (u, ss, sg, ()) =>
352:      match certifiedSaid X u.1, (Text.unlist ss).mapM Text.ofU64 with
353:      | some h, some signers =>
354:          if signers.length = (Text.unlist sg).length then
355:            some { head := h, certified := u.1, sigs := signers.zip (Text.unlist sg) }
356:          else none
359:/-- Walk the signatures from the signers `seen`: each signer listed, not seen, verifying over `msg`.
360:Returns every signer accepted. -/
361:def certifySigners (X : Ctx D) (auth : Authority) (msg : ByteArray) :
362:    List (Nat × ByteArray) → List Nat → Except CertRefusal (List Nat)
363:  | [], seen => .ok seen
364:  | (i, s) :: rest, seen =>
365:      match auth.certifiers[i]? with
366:      | none => .error (.unlisted i)
367:      | some k =>
368:          if i ∈ seen then .error (.repeated i)
369:          else if !X.verify k msg s then .error (.badCertifySignature i)
370:          else certifySigners X auth msg rest (i :: seen)
371:
372:/-- Decode and verify under `auth`: the authority names somebody (`noAuthority` otherwise: a
373:threshold of 0 would take a certificate with no signature), the certificate is for `origin`, and at
374:least `auth.threshold` distinct listed certifiers each signed its certified bytes under `domCertify`. The one path every
375:party that trusts a head without a World (a thin joiner, a foreign World, a phone) will run. -/
376:def certified (X : Ctx D) (auth : Authority) (origin : D) (b : ByteArray) :
377:    Except CertRefusal (Certificate D) :=
378:  if auth.threshold = 0 then .error .noAuthority else
379:  match certificateOfBytes X b with
380:  | none => .error .badCertificate
381:  | some c =>
382:    if c.head.origin ≠ origin then .error .otherWorld
383:    else match certifySigners X auth (certifyMessage c.certified) c.sigs [] with
384:      | .error r => .error r
385:      | .ok signers =>
386:          if signers.length < auth.threshold then .error (.belowThreshold signers.length auth.threshold)
387:          else .ok c
388:
389:/-- **A World's head, certified under the World's own authority** (PROTOCOL-77.1): what a member
390:adopting a base asks of the writer's certificate `b`. Under an authority that names nobody nothing
391:is asked (`ok`: every World today, `Authority.none`); otherwise `b` verifies under that authority
392:(`certified`) and certifies exactly `headOf w` (`otherHead` else). A World that carries no single
393:authority cell is refused `noAuthority` (no honest fold reaches one: `authorityOf_honest_fold`). The
394:authority is read off `w`, so the caller must already trust `w`'s bytes (a pin binds them); what
395:this adds is the writer's own signature on the head, non-repudiable to anyone holding the genesis. -/
396:def certifiesWorld (X : Ctx D) (w : World D) (b : ByteArray) : Except CertRefusal Unit :=
397:  match authorityOf w with
398:  | none => .error .noAuthority
399:  | some auth =>
400:      if auth.threshold = 0 then .ok ()
401:      else match certified X auth w.origin b with
402:        | .error r => .error r
403:        | .ok c => if c.head = headOf X.env w then .ok () else .error .otherHead
404:
405:end Nanodregg.Protocol.Head


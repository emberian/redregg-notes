58:  | ok {w n} : Reach lib cap s ⟨.ret w, k, d⟩ n → Leads lib cap s k d (.ok w) n
59:  | err {e s' n} : Reach lib cap s s' n → step lib s' = .fault e → Leads lib cap s k d (.error e) (n + 1)
60:
61:theorem Leads.mono {cap cap' : Nat} {s : State} {k : List Frame} {d : Nat} {r : (Except Fault Val)} {n : Nat}
62:    (h : Leads lib cap s k d r n) (hc : cap ≤ cap') : Leads lib cap' s k d r n := by
63:  cases h with
64:  | ok h => exact .ok (h.mono hc)
65:  | err h hs => exact .err (h.mono hc) hs
67:/-- One transition in front. -/
68:theorem Leads.cons {cap : Nat} {s s1 : State} {k : List Frame} {d : Nat} {r : (Except Fault Val)} {n : Nat}
69:    (hs : step lib s = .next s1) (hd : s1.depth ≤ cap) (h : Leads lib cap s1 k d r n) :
70:    Leads lib cap s k d r (n + 1) := by
71:  cases h with
72:  | ok h => exact .ok (.next hs hd h)

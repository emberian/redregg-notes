153:/-- A record whose every step is at or below `start` is skipped whole: the page keeps its
154:events, bytes and `full`, and its count moves past the record. -/
155:theorem foldl_walkStep_skip (E : Kernel.Env D) (budget start : Nat) :
156:    ∀ (ts : List (Kernel.Step D × D)) (a : Acc) (c : D) (k : Nat), a.full = false → a.steps = k →
157:      k + ts.length ≤ start →
158:      (ts.foldl (walkStep E budget start) (a, c, k)).1.events = a.events ∧
159:      (ts.foldl (walkStep E budget start) (a, c, k)).1.bytes = a.bytes ∧
160:      (ts.foldl (walkStep E budget start) (a, c, k)).1.full = false ∧
161:      (ts.foldl (walkStep E budget start) (a, c, k)).1.steps = k + ts.length
162:  | [], a, _, k, hf, hk, _ => by simpa using ⟨hf, hk⟩
163:  | (t, root) :: ts, a, c, k, hf, _, hle => by

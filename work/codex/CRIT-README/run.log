273:  | err hr hs =>
274:    rename_i s' n
275:    refine ⟨0 + D, n, fun cap fuel hc hf => ⟨n + 1, ?_⟩⟩
276:    obtain ⟨m, rfl⟩ : ∃ m, fuel = n + (m + 1) := ⟨fuel - n - 1, by omega⟩
301:machine returns from `t` (under any stack bound and budget), it charged more than `n` ticks,
302:within its budget. So `n < used ≤ fuel`: the machine pays at least one tick per rule instance. -/
303:theorem derives_lt_used {t : Term} {env : Env} {v v' : Val} {n cap fuel used : Nat}
304:    (hd : Derives lib env t (.ok v) n) (hr : run lib cap fuel 0 (State.init t env) = .value v' used) :
305:    n < used ∧ used ≤ fuel := by
306:  obtain ⟨D, m, hnm, hl⟩ := derives_leads hd [] 0
307:  cases hl with
308:  | ok hreach =>
309:    obtain ⟨f', rfl, hr'⟩ := reach_value hreach hr
310:    cases f' with
311:    | zero => simp [run] at hr'


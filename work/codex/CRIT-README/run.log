22:/-- `unread` pushes a frame back on the front. -/
23:private def listUnread (f : Frame) : StateM (List Frame) Unit :=
24:  modify (f :: ·)
25:
26:/-! The four ways one step of the cut goes, over the list model. -/
27:
28:theorem go_full (limits : Limits) (n : Nat) (acc : Array Frame) (bytes : Nat) (q : List Frame)
29:    (hm : limits.batchMax ≤ acc.size) :
30:    (drainM.go listPoll listUnread limits (n + 1) acc bytes).run q = (acc, q) := by


SOURCE Protocol/Foreign.lean
/-
# Protocol.Foreign — a receipt from another World, checked against a head this World holds (E5)

`check E dc` is the deployed `Lang.ReceiptCheck` (`Host.Deployed.X` passes it to `Lang.program`): the
point's cell must be an object of `Std.headPackage` (`Lang.headView`, else `notHead`) holding an
`at` head (a `forked` one checks nothing: `forkedHead`; the head's chain is for comparing folds,
PROTOCOL-75, and the check ignores it); the receipt's bytes must decode
(`badReceipt`); `Receipt.check` against the head's height and roots must answer `committed`
(`headMismatch` / `pathMismatch` / `forgotten` by the check's own names; `refused` and `absent`
are `notCommitted`: acting on them needs the call's window, which the receipt does not carry).
The column then shows the committed height, turn digest and transaction id.

What it means is `Proofs.Foreign.foreign_receipt_sound`: under the named premise that the held head
is the head of a fold of A from A's genesis (head freshness: B holds A head, not THE head), the
transaction was admitted in that fold at that height, or the hash collides among a listed set.
-/
import Protocol.Receipt
import Lang.StdHead

namespace Nanodregg.Protocol.Foreign

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Codec

variable {D : Type} [Ord D] [DecidableEq D]

/-- `Std.headPackage`'s canonical bytes (empty if it had none, which `headPackage_encodes` refutes). -/
def headPackageBytes : ByteArray := (Lang.Wire.encodePackage Lang.Std.headPackage).getD .empty

/-- The deployed id of `Std.headPackage`: its package cell's content digest (`install`, KERNEL-3). -/
def headPackageId (E : Env D) : D :=
  romIdOf E { kind := kindPackage, discipline := .rom, slots := [(0, headPackageBytes)] }

/-- THE deployed receipt check. -/
def check (E : Env D) (dc : Stream D) : Lang.ReceiptCheck := fun cell rb =>
  let digestOf (b : ByteArray) : Option D := (dc.decode b).toOption
  match Lang.headView digestOf (E.bytes (headPackageId E)) cell with
  | none => .error "notHead"
  | some (.forked _) => .error "forkedHead"
  | some (.at _ _ height rootsB _) =>
    match digestOf rootsB, Receipt.ofBytes E dc rb with
    | none, _ => .error "notHead"
    | _, none => .error "badReceipt"
    | some roots, some r =>
      match Receipt.check E height roots r.txId 0 r with
      | .ok (.committed h td) => .ok ⟨h, E.bytes td, E.bytes r.txId⟩
      | .ok _ => .error "notCommitted"
      | .error e => .error e.name

end Nanodregg.Protocol.Foreign


SOURCE Codec/Deployed.lean
import Codec.Kernel
import Codec.World
import Codec.Hash
import Codec.Ed25519

/-!
# Codec.Deployed — the one deployed `Env` and `Ctx`

The kernel is generic in its digest and hash. This module fixes them for deployment: digests are
`Codec.Digest` (32 bytes), the hash is cSHAKE256 with the domain as customization (`Hash.digest`),
turns, cells and calls are encoded by `Codec.Kernel`, and signatures are checked by RFC 8032
Ed25519 (`Ed25519.verify`). LANG supplies the `Program`. `Codec.Proofs.Deployed` proves the
codec laws and decoded-World invariants for this instance. Cryptographic faithfulness and the
other premises of the composed claims remain explicit in `Spec`.
-/

namespace Nanodregg.Codec.Deployed

open Nanodregg.Kernel Nanodregg.Kernel.Receive

/-- The deployed digest's codec: its 32 bytes. -/
abbrev digestCodec : Stream Digest := Stream.digest

def env : Env Digest where
  hash := Hash.digest
  bytes := Digest.bytes
  turnBytes := Nanodregg.Codec.Kernel.turnBytes digestCodec
  cellBytes := Nanodregg.Codec.Kernel.cellBytes

def ctx (program : Program Digest) : Ctx Digest where
  env := env
  unsignedBytes := Nanodregg.Codec.Kernel.unsignedBytes digestCodec
  callBytes := Nanodregg.Codec.Kernel.callBytes digestCodec
  decodeCall := Nanodregg.Codec.Kernel.decodeCall digestCodec
  digestOf := Digest.ofBytes?
  verify := Ed25519.verify
  program := program

/-- The checkpoint's codec. -/
def world : Stream (World Digest) := Nanodregg.Codec.Kernel.world env digestCodec

end Nanodregg.Codec.Deployed


SOURCE Lang/Proofs/Meaning.lean
/-
# Lang.Proofs.Meaning — reading a term's meaning off its `BigStep` derivation

Inversion lemmas for the reference semantics (one per term former a law uses), and the
data-level view of a law's environment: a state or request is `Data` put into the machine with
`toVal`, so a field selection means the field's data (`bigStep_getVar`). Everything here is about
`BigStep`, never about the machine; `Lang.Proofs.Agree` carries a machine result to a meaning.
-/
import Lang.Proofs.BigStep
import Lang.Data

namespace Nanodregg.Lang

variable {lib : List Term} {env : Env}

/-! ## Inversion -/

theorem bigStep_var_inv {i : Nat} {r : Except Fault Val} (h : BigStep lib env (.var i) r) :
    ∃ v, env[i]? = some v ∧ r = .ok v := by
  cases h with | var h => exact ⟨_, h, rfl⟩

theorem bigStep_var_ok {i : Nat} {v : Val} (h : BigStep lib env (.var i) (.ok v)) : env[i]? = some v := by
  cases h with | var h => exact h

theorem bigStep_nat_inv {n : Nat} {r : Except Fault Val} (h : BigStep lib env (.nat n) r) :
    r = .ok (.nat n) := by cases h; rfl

theorem bigStep_bool_inv {b : Bool} {r : Except Fault Val} (h : BigStep lib env (.bool b) r) :
    r = .ok (.bool b) := by cases h; rfl

theorem bigStep_bytes_inv {s : ByteArray} {r : Except Fault Val} (h : BigStep lib env (.bytes s) r) :
    r = .ok (.bytes s) := by cases h; rfl

theorem bigStep_digest_inv {s : ByteArray} {r : Except Fault Val} (h : BigStep lib env (.digest s) r) :
    r = .ok (.digest s) := by cases h; rfl

/-- A conditional with a value: the condition was a boolean and the taken branch has the value. -/
theorem bigStep_ite_ok {c a b : Term} {v : Val} (h : BigStep lib env (.ite c a b) (.ok v)) :
    (BigStep lib env c (.ok (.bool true)) ∧ BigStep lib env a (.ok v)) ∨
    (BigStep lib env c (.ok (.bool false)) ∧ BigStep lib env b (.ok v)) := by
  cases h with
  | iteT hc ha => exact .inl ⟨hc, ha⟩
  | iteF hc hb => exact .inr ⟨hc, hb⟩

/-- A primitive with a value: both operands had values and `primEval` gave it. -/
theorem bigStep_prim_ok {p : Prim} {a b : Term} {v : Val} (h : BigStep lib env (.prim p a b) (.ok v)) :
    ∃ x y, BigStep lib env a (.ok x) ∧ BigStep lib env b (.ok y) ∧ primEval p x y = .ok v := by
  generalize hr : (Except.ok v : Except Fault Val) = r at h
  cases h with
  | prim ha hb _ => exact ⟨_, _, ha, hb, by first | exact hr.symm | rfl⟩
  | primL _ => cases hr
  | primR _ _ => cases hr

theorem bigStep_inj_ok {A : Ty} {ℓ : Label} {t : Term} {v : Val}
    (h : BigStep lib env (.inj A ℓ t) (.ok v)) : ∃ w, BigStep lib env t (.ok w) ∧ v = .inj ℓ w := by
  cases h with | inj ht => exact ⟨_, ht, rfl⟩

/-- A case with a value: the scrutinee was an injection, its label's arm ran on its payload. -/
theorem bigStep_case_ok {t : Term} {arms : List (Label × Term)} {v : Val}
    (h : BigStep lib env (.case t arms) (.ok v)) :
    ∃ ℓ w body, BigStep lib env t (.ok (.inj ℓ w)) ∧ Row.find? ℓ arms = some body ∧
      BigStep lib (w :: env) body (.ok v) := by
  cases h with | case ht hf hb => exact ⟨_, _, _, ht, hf, hb⟩

/-- Applying a closed `λ` to a variable: the body ran with the variable's value bound. -/
theorem bigStep_app_ok {f : Term} {a : Term} {v : Val}
    (h : BigStep lib env (.app f a) (.ok v)) :
    ∃ body cenv w, BigStep lib env f (.ok (.clo body cenv)) ∧ BigStep lib env a (.ok w) ∧
      BigStep lib (w :: cenv) body (.ok v) := by
  cases h with | app hf ha hb => exact ⟨_, _, _, hf, ha, hb⟩

/-! ## Data in the environment -/

theorem find_rowToVal {ℓ : Label} : ∀ {fs : List (Label × Data)} {t : Term} {e : Env},
    Row.find? ℓ (Data.rowToVal fs) = some (t, e) → ∃ x, Row.find? ℓ fs = some x ∧ t = .var 0 ∧ e = [x.toVal]
  | [], _, _, h => by simp [Data.rowToVal, Row.find?] at h
  | (k, d) :: fs, t, e, h => by
    simp only [Data.rowToVal, Row.find?] at h ⊢
    split at h
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      exact ⟨d, by simp [*], rfl, rfl⟩
    · rw [if_neg (by assumption)]; exact find_rowToVal h

/-- Selecting a field of record data bound at `var i` means the field's data. -/
theorem bigStep_getVar {i : Nat} {d : Data} {ℓ : Label} {v : Val} (hi : env[i]? = some d.toVal)
    (h : BigStep lib env (.get (.var i) ℓ) (.ok v)) : ∃ x, d.field ℓ = some x ∧ v = x.toVal := by
  cases h with
  | get ht hs =>
    obtain ⟨w, hw, hv⟩ := bigStep_var_inv ht
    rw [hi] at hw; cases hv; cases hw
    cases d with
    | record fs =>
      cases hs with
      | field hf hb =>
        obtain ⟨x, hx, rfl, rfl⟩ := find_rowToVal hf
        obtain ⟨u, hu, hu'⟩ := bigStep_var_inv hb
        simp at hu; subst hu; cases hu'
        exact ⟨x, hx, rfl⟩
    | nat _ | bool _ | bytes _ | digest _ | inj _ _ => cases hs

theorem Data.toVal_nat {x : Data} {n : Nat} (h : x.toVal = .nat n) : x = .nat n := by
  cases x <;> simp [Data.toVal] at h <;> simp [h]

theorem Data.toVal_bool {x : Data} {b : Bool} (h : x.toVal = .bool b) : x = .bool b := by
  cases x <;> simp [Data.toVal] at h <;> simp [h]

theorem Data.toVal_bytes {x : Data} {s : ByteArray} (h : x.toVal = .bytes s) : x = .bytes s := by
  cases x <;> simp [Data.toVal] at h <;> simp [h]

theorem Data.toVal_digest {x : Data} {s : ByteArray} (h : x.toVal = .digest s) : x = .digest s := by
  cases x <;> simp [Data.toVal] at h <;> simp [h]

theorem Data.toVal_inj {x : Data} {ℓ : Label} {w : Val} (h : x.toVal = .inj ℓ w) :
    ∃ y, x = .inj ℓ y ∧ w = y.toVal := by
  cases x <;> simp [Data.toVal] at h
  obtain ⟨rfl, rfl⟩ := h
  exact ⟨_, rfl, rfl⟩

end Nanodregg.Lang


SOURCE Lang/Proofs/Cost.lean
/-
# Lang.Proofs.Cost — a tick walks at most one word of bytes (LANG-64; LANG-L made a theorem)

LANG-L reads the tick as a unit of work: every step O(1). Before LANG-64 that was false for the
byte primitives: `cat` copied up to 64 KiB and `beq` compared up to 128 KiB in ONE tick, so one law
run under `lawTicks` could copy about 6.5 GB. LANG-64 charges a primitive `primTicks`: one tick per
`Bounds.wordBytes` (32) bytes its operands hold, rounded up, at least one; it pays them first and
computes on the last (`primStep`).

`primBytes_le`: a primitive walks at most `wordBytes` bytes per tick it is charged.
`walked_le`: a whole run walks at most `wordBytes` primitive operand bytes per tick it reports (`used`), whatever its
budget and however it ends, so a run cut off by its budget while a primitive is paying has walked
none of that primitive's bytes. `primTicks_word`: a primitive on at most one word costs one tick,
as before. `primBytes_cat`: a `cat`'s count is the size of the bytes it writes.
-/
import Lang.Eval

namespace Nanodregg.Lang

theorem primTicks_pos {p : Prim} {x y : Val} : 0 < primTicks p x y := Nat.succ_pos _

/-- **A primitive walks at most one word per tick it is charged.** -/
theorem primBytes_le (p : Prim) (x y : Val) : primBytes p x y ≤ Bounds.wordBytes * primTicks p x y := by
  unfold primTicks
  have hw : 0 < Bounds.wordBytes := by decide
  have := Nat.lt_mul_div_succ (primBytes p x y - 1) hw
  omega

/-- A primitive on at most one word of bytes costs one tick: the charge before LANG-64. -/
theorem primTicks_word {p : Prim} {x y : Val} (h : primBytes p x y ≤ Bounds.wordBytes) :
    primTicks p x y = 1 := by
  unfold primTicks
  have hw : 0 < Bounds.wordBytes := by decide
  have : (primBytes p x y - 1) / Bounds.wordBytes = 0 := Nat.div_eq_of_lt (by omega)
  omega

/-- A primitive walks bytes only where its operands are bytes or digests: every arithmetic and
comparison primitive, and `lenLe`, costs one tick. -/
theorem primTicks_nat {p : Prim} {a b : Nat} : primTicks p (.nat a) (.nat b) = 1 := by
  cases p <;> simp [primTicks, primBytes]

theorem primTicks_lenLe {a : ByteArray} {n : Nat} : primTicks .lenLe (.bytes a) (.nat n) = 1 := by
  simp [primTicks, primBytes]

/-- `beq` is charged for both operands, whatever their sizes: `decide (a = b)` on `ByteArray` is
`ByteArray.ext_iff`, i.e. `a.data = b.data`, and each `.data` is `lean_byte_array_data`, which
builds an array from the whole byte string. -/
theorem primBytes_beq (a b : ByteArray) : primBytes .beq (.bytes a) (.bytes b) = a.size + b.size := rfl

/-- `deq` is `beq` on digests: both operands, by the same copies. -/
theorem primBytes_deq (a b : ByteArray) : primBytes .deq (.digest a) (.digest b) = a.size + b.size := rfl

/-- What a payload writer is charged for is what it writes: the size of its result (LANG-87). -/
theorem primBytes_written {p : Prim} {x y : Val} {r : ByteArray}
    (hp : p = .u64be ∨ p = .sized ∨ p = .dsized) (h : primEval p x y = .ok (.bytes r)) :
    primBytes p x y = r.size := by
  rcases hp with rfl | rfl | rfl <;> cases x <;> cases y <;> simp only [primEval, appended] at h <;>
    (try cases h) <;> split at h <;> cases h <;> simp_all [primBytes, primBytes.written]

/-- What `cat` is charged for is what it writes: the size of its result. -/
theorem primBytes_cat {x y : Val} {r : ByteArray} (h : primEval .cat x y = .ok (.bytes r)) :
    primBytes .cat x y = r.size := by
  cases x <;> cases y <;> simp only [primEval] at h <;> try cases h
  rename_i a b
  by_cases hs : a.size + b.size ≤ Bounds.bytesMax
  · simp only [hs, if_true, Except.ok.injEq, Val.bytes.injEq] at h
    subst h; simp [primBytes, hs, ByteArray.size_append]
  · simp [hs] at h

/-- The ticks already paid toward the primitives on a stack: the `paid` of each `primR` frame. -/
private def stackPaid : List Frame → Nat
  | [] => 0
  | .primR _ _ j :: k => j + stackPaid k
  | _ :: k => stackPaid k

private theorem stepBytes_le_paid (lib : List Term) (s : State) :
    stepBytesBy (step lib) s ≤ Bounds.wordBytes * (stackPaid s.stack + 1) := by
  obtain ⟨c, k, d⟩ := s
  cases c with
  | eval t env => simp [stepBytesBy]
  | ret v =>
    cases k with
    | nil => simp [stepBytesBy]
    | cons f k =>
      cases f with
      | primR p a j =>
        simp only [stepBytesBy, stackPaid]
        split
        · exact Nat.zero_le _
        · rename_i hnp
          have hj : ¬ j + 1 < primTicks p a v := fun hj => hnp (by simp [step, primStep, hj, Step.pays])
          have := primBytes_le p a v
          have : Bounds.wordBytes * primTicks p a v ≤ Bounds.wordBytes * (j + stackPaid k + 1) :=
            Nat.mul_le_mul_left _ (by omega)
          omega
      | _ => simp [stepBytesBy]

/-- One transition: the bytes it walks, plus a word for every tick paid toward a primitive after it,
are at most a word for every tick paid before it and one more for itself. -/
private theorem step_paid {lib : List Term} {s s' : State} (h : step lib s = .next s') :
    stepBytesBy (step lib) s + Bounds.wordBytes * stackPaid s'.stack ≤
      Bounds.wordBytes * (stackPaid s.stack + 1) := by
  obtain ⟨c, k, d⟩ := s
  cases c with
  | eval t env =>
    have h0 : stepBytesBy (step lib) ⟨.eval t env, k, d⟩ = 0 := by simp [stepBytesBy]
    rw [h0]
    cases t <;> simp only [step, push] at h <;> (repeat' split at h) <;> (try simp at h) <;>
      (try (cases h; simp [stackPaid, Nat.mul_add] <;> omega))
  | ret v =>
    cases k with
    | nil => simp [step] at h
    | cons f k =>
      cases f with
      | primR p a j =>
        by_cases hj : j + 1 < primTicks p a v
        · have hs : step lib ⟨.ret v, .primR p a j :: k, d⟩ = .next ⟨.ret v, .primR p a (j + 1) :: k, d⟩ := by
            simp [step, primStep, hj]
          rw [hs] at h; cases h
          have h0 : stepBytesBy (step lib) ⟨.ret v, .primR p a j :: k, d⟩ = 0 := by
            simp [stepBytesBy, hs, Step.pays]
          simp only [h0, stackPaid, Nat.mul_add, Nat.mul_one]; omega
        · have hle : stepBytesBy (step lib) ⟨.ret v, .primR p a j :: k, d⟩ ≤ primBytes p a v := by
            simp only [stepBytesBy]; split <;> omega
          have hs := h
          simp only [step, primStep, hj, if_false] at hs
          split at hs
          · cases hs
            have := primBytes_le p a v
            have : Bounds.wordBytes * primTicks p a v ≤ Bounds.wordBytes * (j + 1) :=
              Nat.mul_le_mul_left _ (by omega)
            simp only [stackPaid, Nat.mul_add, Nat.mul_one] at *
            omega
          · cases hs
      | _ =>
        have h0 : ∀ fr, (∀ p a j, fr ≠ Frame.primR p a j) →
            stepBytesBy (step lib) ⟨.ret v, fr :: k, d⟩ = 0 := by
          intro fr hfr; cases fr <;> simp [stepBytesBy] <;> exact absurd rfl (hfr _ _ _)
        rw [h0 _ (by intros; simp)]
        simp only [step] at h <;> (repeat' split at h) <;> (try simp at h) <;>
          (try (cases h; simp [stackPaid, Nat.mul_add] <;> omega))

/-- **A run walks at most one word per tick** (LANG-L, LANG-64): under every budget and stack bound,
the primitive operand bytes a run walks are at most `wordBytes` per tick it reports, plus a word for each tick already
paid toward a primitive on the stack it starts from (none, from `State.init`). -/
theorem walked_le_paid {lib : List Term} {cap : Nat} :
    ∀ (fuel u : Nat) (s : State),
      walked lib cap fuel s + Bounds.wordBytes * u ≤
        Bounds.wordBytes * ((run lib cap fuel u s).used + stackPaid s.stack)
  | 0, u, s => by simp [walked, walkedBy, run, Outcome.used, Nat.mul_add]
  | fuel + 1, u, s => by
    have hb := stepBytes_le_paid lib s
    simp only [walked, walkedBy, run]
    cases hs : step lib s with
    | halt v => simp only [Outcome.used]; (try simp only [Nat.mul_add, Nat.mul_one] at *); omega
    | fault f => simp only [Outcome.used]; (try simp only [Nat.mul_add, Nat.mul_one] at *); omega
    | next s' =>
      simp only
      split
      · simp only [Outcome.used]; (try simp only [Nat.mul_add, Nat.mul_one] at *); omega
      · have h1 := step_paid hs
        have h2 := walked_le_paid (lib := lib) (cap := cap) fuel (u + 1) s'
        simp only [walked, Nat.mul_add, Nat.mul_one] at *
        omega

/-- **From the start, a run walks at most `wordBytes` primitive operand bytes per tick it is
charged.** -/
theorem walked_le {lib : List Term} {cap fuel : Nat} {t : Term} {env : Env} :
    walked lib cap fuel (State.init t env) ≤
      Bounds.wordBytes * (run lib cap fuel 0 (State.init t env)).used := by
  have := walked_le_paid (lib := lib) (cap := cap) fuel 0 (State.init t env)
  simpa [State.init, stackPaid] using this

end Nanodregg.Lang



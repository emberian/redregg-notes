328:/-- A search refused was refused by one of its reads. -/
329:theorem locate_error {get : Nat → Id (Except Fault Entry)} {count start : Nat} {f : Fault}
330:    (h : locate get count start = .error f) : ∃ k, get k = .error f := by
331:  simp only [locate, bind] at h
332:  split at h
333:  · rename_i f' hg
334:    simp only [pure] at h; cases h; exact ⟨0, hg⟩
335:  · exact locate_go_error get start _ _ _ _ h

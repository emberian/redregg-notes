SOURCE Lang/Proofs/Cost.lean
1:/-
2:# Lang.Proofs.Cost — a tick walks at most one word of bytes (LANG-64; LANG-L made a theorem)
3:
4:LANG-L reads the tick as a unit of work: every step O(1). Before LANG-64 that was false for the
5:byte primitives: `cat` copied up to 64 KiB and `beq` compared up to 128 KiB in ONE tick, so one law
6:run under `lawTicks` could copy about 6.5 GB. LANG-64 charges a primitive `primTicks`: one tick per
7:`Bounds.wordBytes` (32) bytes its operands hold, rounded up, at least one; it pays them first and
8:computes on the last (`primStep`).
9:
10:`primBytes_le`: a primitive walks at most `wordBytes` bytes per tick it is charged.
11:`walked_le`: a whole run walks at most `wordBytes` primitive operand bytes per tick it reports (`used`), whatever its
12:budget and however it ends, so a run cut off by its budget while a primitive is paying has walked
13:none of that primitive's bytes. `primTicks_word`: a primitive on at most one word costs one tick,
14:as before. `primBytes_cat`: a `cat`'s count is the size of the bytes it writes.
15:-/
16:import Lang.Eval
17:
18:namespace Nanodregg.Lang
19:
20:theorem primTicks_pos {p : Prim} {x y : Val} : 0 < primTicks p x y := Nat.succ_pos _
21:
22:/-- **A primitive walks at most one word per tick it is charged.** -/
23:theorem primBytes_le (p : Prim) (x y : Val) : primBytes p x y ≤ Bounds.wordBytes * primTicks p x y := by
24:  unfold primTicks
25:  have hw : 0 < Bounds.wordBytes := by decide
26:  have := Nat.lt_mul_div_succ (primBytes p x y - 1) hw
27:  omega
29:/-- A primitive on at most one word of bytes costs one tick: the charge before LANG-64. -/
30:theorem primTicks_word {p : Prim} {x y : Val} (h : primBytes p x y ≤ Bounds.wordBytes) :
31:    primTicks p x y = 1 := by
32:  unfold primTicks
33:  have hw : 0 < Bounds.wordBytes := by decide
34:  have : (primBytes p x y - 1) / Bounds.wordBytes = 0 := Nat.div_eq_of_lt (by omega)
38:comparison primitive, and `lenLe`, costs one tick. -/
39:theorem primTicks_nat {p : Prim} {a b : Nat} : primTicks p (.nat a) (.nat b) = 1 := by
40:  cases p <;> simp [primTicks, primBytes]
41:
42:theorem primTicks_lenLe {a : ByteArray} {n : Nat} : primTicks .lenLe (.bytes a) (.nat n) = 1 := by
43:  simp [primTicks, primBytes]
44:
45:/-- `beq` is charged for both operands, whatever their sizes: `decide (a = b)` on `ByteArray` is
46:`ByteArray.ext_iff`, i.e. `a.data = b.data`, and each `.data` is `lean_byte_array_data`, which
47:builds an array from the whole byte string. -/
48:theorem primBytes_beq (a b : ByteArray) : primBytes .beq (.bytes a) (.bytes b) = a.size + b.size := rfl
49:
50:/-- `deq` is `beq` on digests: both operands, by the same copies. -/
51:theorem primBytes_deq (a b : ByteArray) : primBytes .deq (.digest a) (.digest b) = a.size + b.size := rfl
52:
53:/-- What a payload writer is charged for is what it writes: the size of its result (LANG-87). -/
54:theorem primBytes_written {p : Prim} {x y : Val} {r : ByteArray}
55:    (hp : p = .u64be ∨ p = .sized ∨ p = .dsized) (h : primEval p x y = .ok (.bytes r)) :
56:    primBytes p x y = r.size := by
57:  rcases hp with rfl | rfl | rfl <;> cases x <;> cases y <;> simp only [primEval, appended] at h <;>
58:    (try cases h) <;> split at h <;> cases h <;> simp_all [primBytes, primBytes.written]
60:/-- What `cat` is charged for is what it writes: the size of its result. -/
61:theorem primBytes_cat {x y : Val} {r : ByteArray} (h : primEval .cat x y = .ok (.bytes r)) :
62:    primBytes .cat x y = r.size := by
63:  cases x <;> cases y <;> simp only [primEval] at h <;> try cases h
64:  rename_i a b
65:  by_cases hs : a.size + b.size ≤ Bounds.bytesMax
145:paid toward a primitive on the stack it starts from (none, from `State.init`). -/
146:theorem walked_le_paid {lib : List Term} {cap : Nat} :
147:    ∀ (fuel u : Nat) (s : State),
148:      walked lib cap fuel s + Bounds.wordBytes * u ≤
149:        Bounds.wordBytes * ((run lib cap fuel u s).used + stackPaid s.stack)
150:  | 0, u, s => by simp [walked, walkedBy, run, Outcome.used, Nat.mul_add]
167:charged.** -/
168:theorem walked_le {lib : List Term} {cap fuel : Nat} {t : Term} {env : Env} :
169:    walked lib cap fuel (State.init t env) ≤
170:      Bounds.wordBytes * (run lib cap fuel 0 (State.init t env)).used := by
171:  have := walked_le_paid (lib := lib) (cap := cap) fuel 0 (State.init t env)
172:  simpa [State.init, stackPaid] using this


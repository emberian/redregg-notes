235:theorem build_nonempty [Ord D] [DecidableEq D] {dc : Codec.Stream D} {PD : D → Prop} (hd : Codec.Stream.LawfulOn PD dc)
236:    {E : Kernel.Env D} {digestOf : ByteArray → Option D} {s : Log.Sealer} {recordMax budget : Nat}
237:    {read : Nat → Nat → Id ByteArray} {get : Nat → Id (Except Fault Entry)} {endOff : Nat}
238:    {now : Nat × ByteArray} {start : Nat} {a : Acc} {L : List Entry}
239:    (hB : Protocol.Bounds.pageEventBytesMax + 4 ≤ budget)
240:    (hget : ∀ k e, get k = .ok e → L[k]? = some e)
241:    (hL : Indexes dc s recordMax read L (endOff, now.1)) (hs : start < now.1)
242:    (h : build E dc digestOf s recordMax budget read get L.length endOff now start = .ok a) :
243:    0 < a.events.size := by
256:/-- **The tooth of `build_nonempty`**: one entry, at or below `start`, pointing at the durable end
257:(no frame of the index's own there) serves an EMPTY page short of the tip. -/
258:theorem build_empty_incoherent (E : Kernel.Env D) (dc : Codec.Stream D) (digestOf : ByteArray → Option D)
259:    (s : Log.Sealer) (recordMax budget : Nat) (read : Nat → Nat → Id ByteArray) (endOff : Nat)
260:    (now : Nat × ByteArray) (start : Nat) (e : Entry) (c : D) (hs : start < now.1) (hle : e.steps ≤ start)
261:    (hc : digestOf e.chain = some c) (hend : endOff ≤ e.offset) :
262:    build E dc digestOf s recordMax budget read (fun _ => pure (.ok e)) 1 endOff now start =
263:      .ok { steps := e.steps, chain := e.chain } := by
264:  simp only [build, locate, locate.go, walk, bind, pure, if_neg (Nat.not_le.mpr hs),
265:    Nat.one_ne_zero, ↓reduceIte, Nat.le_refl, if_neg (Nat.not_lt.mpr hle), hc,
266:    Bool.false_or, decide_eq_true_eq, hend]

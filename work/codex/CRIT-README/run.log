55:  | .stuck => "stuck" | .overflow => "overflow" | .underflow => "underflow"
56:  | .divZero => "divZero" | .tooLarge => "tooLarge" | .ticks => "exhausted" | .stack => "stack"
57:  | .refused why => s!"refused {reasonText why}"

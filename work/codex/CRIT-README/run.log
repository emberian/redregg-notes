268:theorem locate_go_le (get : Nat → Id (Except Fault Entry)) (start : Nat) :
269:    ∀ (fuel lo hi : Nat) (e : Entry), e.steps ≤ start → ∀ {k : Nat} {e' : Entry},
270:      locate.go get start fuel lo hi e = .ok (k, e') → e'.steps ≤ start := by
271:  intro fuel
272:  induction fuel with
273:  | zero =>
274:    intro lo hi e he k e' hg
275:    simp only [locate.go, pure] at hg
276:    cases hg; exact he
288:        · exact ih lo _ e he hg

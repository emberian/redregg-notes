317:/-- A run that ends with an arithmetic fault ended with the term's `BigStep` fault. -/
318:theorem run_fault_bigStep {cap fuel used : Nat} {t : Term} {env : Env} {f : Fault}
319:    (h : run lib cap fuel 0 (State.init t env) = .fault f used) (hs : f ≠ .stuck) (ht : f ≠ .ticks)

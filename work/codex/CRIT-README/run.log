290:theorem walk_error {E : Kernel.Env D} {dc : Codec.Stream D} {s : Log.Sealer} {recordMax budget : Nat}
291:    {read : Nat → Nat → Id ByteArray} {endOff start : Nat} :
292:    ∀ (fuel off : Nat) (c : D) (acc : Acc) (f : Fault),
293:      walk E dc s recordMax budget read endOff start fuel off c acc = .error f → ∃ o, f = .corrupt o := by
294:  intro fuel
295:  induction fuel with
296:  | zero => intro off c acc f h; simp only [walk, pure] at h; cases h
297:  | succ fuel ih =>
298:    intro off c acc f h
307:        · exact ih _ _ _ _ h

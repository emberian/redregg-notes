179:theorem walk_indexes [Ord D] [DecidableEq D] {dc : Codec.Stream D} {PD : D → Prop} (hd : Codec.Stream.LawfulOn PD dc)
180:    {E : Kernel.Env D} {s : Log.Sealer} {recordMax budget : Nat} {read : Nat → Nat → Id ByteArray}
181:    {endOff now start : Nat} (hB : Protocol.Bounds.pageEventBytesMax + 4 ≤ budget) (hs : start < now) :
182:    ∀ (rest : List Entry) (e : Entry) (c : D) (acc a : Acc),
183:      Indexes dc s recordMax read (e :: rest) (endOff, now) →
184:      acc.events = #[] → acc.bytes = 0 → acc.full = false → acc.steps = e.steps → e.steps ≤ start →
185:      walk E dc s recordMax budget read endOff start (rest.length + 1) e.offset c acc = .ok a →
186:      0 < a.events.size := by
187:  intro rest

309:theorem locate_go_error (get : Nat → Id (Except Fault Entry)) (start : Nat) :
310:    ∀ (fuel lo hi : Nat) (e : Entry) {f : Fault}, locate.go get start fuel lo hi e = .error f →
311:      ∃ k, get k = .error f := by
312:  intro fuel
313:  induction fuel with
314:  | zero => intro lo hi e f hg; simp only [locate.go, pure] at hg; cases hg
315:  | succ fuel ih =>
316:    intro lo hi e f hg
317:    simp only [locate.go] at hg

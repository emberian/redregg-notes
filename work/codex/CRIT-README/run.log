591:/-- Where the entry after `e` begins (or the tip, after the last). -/
592:theorem Indexes.next_le {D : Type} {dc : Codec.Stream D} {s : Sealer} {rm : Nat}
593:    {read : Nat → Nat → Id ByteArray} {tip : Nat × Nat} (rest : List Entry)
594:    (h : Indexes dc s rm read rest tip) :
595:    (match rest with | [] => tip | e' :: _ => (e'.offset, e'.steps)).1 ≤ tip.1 := by
596:  cases rest with
597:  | nil => exact Nat.le_refl _
598:  | cons e' rest => exact Nat.le_of_lt (Page.Indexes.offset_lt rest e' h)

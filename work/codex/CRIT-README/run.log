302:    decide ((bytesOf r.principal).size ≤ Bounds.digestBytesMax) &&
303:    decide ((bytesOf r.self).size ≤ Bounds.digestBytesMax) &&
304:    decide (r.notBefore < Bounds.natLimit) && decide (r.validUntil < Bounds.natLimit) &&
306:
307:def reqData (r : Req D) : Data :=
308:  .record [("agent", .digest (bytesOf r.agent)), ("notBefore", .nat r.notBefore),
309:    ("occasion", occasionData bytesOf r.occasion),
310:    ("principal", .digest (bytesOf r.principal)), ("self", .digest (bytesOf r.self)),
311:    ("validUntil", .nat r.validUntil)]

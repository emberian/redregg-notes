30:theorem Reach.trans {cap : Nat} {s s1 s2 : State} {n m : Nat} (h1 : Reach lib cap s s1 n)
31:    (h2 : Reach lib cap s1 s2 m) : Reach lib cap s s2 (n + m) := by
32:  induction h1 with
33:  | refl => simpa using h2
34:  | next hs hd _ ih => rw [Nat.add_right_comm]; exact .next hs hd (ih h2)
35:
36:theorem Reach.mono {cap cap' : Nat} {s s' : State} {n : Nat} (h : Reach lib cap s s' n)
37:    (hc : cap ≤ cap') : Reach lib cap' s s' n := by
38:  induction h with
39:  | refl => exact .refl
40:  | next hs hd _ ih => exact .next hs (Nat.le_trans hd hc) ih

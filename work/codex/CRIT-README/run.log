630:theorem extract_split {S A B : ByteArray} {off : Nat} (h : S.extract off (off + (A ++ B).size) = A ++ B) :
631:    S.extract off (off + A.size) = A ∧ S.extract (off + A.size) (off + A.size + B.size) = B := by
632:  have e1 : (S.extract off (off + (A ++ B).size)).extract 0 A.size = S.extract off (off + A.size) := by
633:    rw [extract_extract, Nat.add_zero, size_append, Nat.min_eq_left (by omega)]
634:  have e2 : (S.extract off (off + (A ++ B).size)).extract A.size (A.size + B.size) =
635:      S.extract (off + A.size) (off + A.size + B.size) := by
636:    rw [extract_extract, size_append, ← Nat.add_assoc, Nat.min_self]
637:  exact ⟨by rw [← e1, h, extract_append_eq_left rfl], by rw [← e2, h, extract_append_eq_right rfl rfl]⟩

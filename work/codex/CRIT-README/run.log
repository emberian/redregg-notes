 succeeded in 136ms:
#!/usr/bin/env bash
# scripts/commit — land a change on main: rebase on origin/main, build what it changed, run what it touched, push.
#
#   scripts/commit [-m MSG | -F FILE] [PATH...]
#
# With a message and PATHs, the commit is this worktree's HEAD plus exactly those paths as they are in the working
# tree (a directory means every file under it; a deleted file is deleted). With neither, the commits already on HEAD
# that origin/main lacks are landed as they are. The message is prose: what changed and what it lets the system do.
#
#  1. fetch origin; replay the commit(s) onto origin/main (git merge-tree, no checkout). A conflict stops here and
#     names the paths: resolve it in this worktree (git rebase origin/main) and run this again;
#  2. materialize the rebased tree in the lane's build directory on the home disk (hbox: NVMe, never /tank):
#     ~/nd-land/<worktree name>/tree, its .lake and cargo target kept between landings (seeded once from this
#     worktree's .lake/build), so a build re-hashes only that tree;
#  3. build what the change touched (gates/touched.py: the changed modules and their importers, their libs and the
#     exes whose closure holds one; `cargo check` of the reached packages), under the clone's build wrapper
#     (hbox: swarm-build, SWARM_MEM_MAX default 24G) at idle priority (ionice -c3, nice 15);
#  4. run the rows the change touched (gates/touched.py rows: the Lean verdict rows whose exe it reaches, the cargo
#     rows whose crate or driven exes it reaches), at idle priority;
#  5. push to origin main. A push refused because main moved is re-based and pushed again; it is rebuilt and re-run
#     only when the commits that moved main changed a path this change changed;
#  6. refs/heads/main of this clone follows origin/main, and this worktree moves to the landed commit when its
#     uncommitted edits allow.
# A build killed by a signal (the memory cap, earlyoom) is NOT BUILT (exit 76), never RED: run it again with a larger
# SWARM_MEM_MAX or fewer LEAN_NUM_THREADS.
# Green or red, nothing else judges a landing. The whole tree, every row, the benches, the census and the tables are
# the convergence's report (scripts/converge), which names the landing a red came from; that lane fixes it forward.
#
# Run detached with a PID file: nohup bash -c 'exec scripts/commit -F MSG PATH...' > LOG 2>&1 & echo $! > job.pid
# Every lander also writes <git common dir>/nanodregg-pids/<pid> (its worktree, its stage, the commit), removed
# when it exits, so another session on the box can see what is landing.
# Flags of the old judge (--cross-layer, --no-build, --reverts) are accepted and ignored.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(git rev-parse --show-toplevel) || exit 2
common=$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd)
export PATH=$HOME/.elan/bin:$PATH
msgsrc="" msgfile="" paths=()
while [ $# -gt 0 ]; do
  case $1 in
    -m) msgsrc=$2; shift ;;
    -F) msgfile=$2; shift ;;
    --cross-layer|--no-build|--reverts) echo "scripts/commit: $1 is ignored (rule 1 has no such line)"; shift ;;
    --) shift; paths+=("$@"); break ;;
    -*) echo "scripts/commit: unknown flag $1" >&2; exit 2 ;;
    *) paths+=("$1") ;;
  esac
  shift
done
if [ ${#paths[@]} -gt 0 ] && [ -z "$msgsrc$msgfile" ]; then echo "scripts/commit: PATHs need -m or -F" >&2; exit 2; fi
if [ ${#paths[@]} -eq 0 ] && [ -n "$msgsrc$msgfile" ]; then echo "scripts/commit: a message needs PATHs (or commit with git, then run scripts/commit alone)" >&2; exit 2; fi

tmp=$(mktemp -d)
pids=$common/nanodregg-pids; mkdir -p "$pids"
trap 'rm -rf "$tmp" "$pids/$$"' EXIT
stage() { printf '%s\t%s\t%s\n' "$repo" "$1" "${2:-}" > "$pids/$$"; echo "scripts/commit: $1${2:+ $2}"; }

# idle CMD…: at idle I/O and low CPU priority, under the clone's build wrapper (hbox: swarm-build's cgroup)
read -r -a wrap <<< "$(git -C "$repo" config nanodregg.buildwrap || true)"
export SWARM_MEM_MAX=${SWARM_MEM_MAX:-24G}
idle() {
  local p=(nice -n 15)
  command -v ionice > /dev/null && p=(ionice -c3 "${p[@]}")
  "${p[@]}" "${wrap[@]}" "$@"
}

# 1. the commit, replayed onto origin/main
stage fetching
git -C "$repo" fetch -q origin main || { echo "scripts/commit: git fetch origin failed"; exit 1; }
if [ ${#paths[@]} -gt 0 ]; then
  msg=$tmp/msg
  if [ -n "$msgfile" ]; then cat "$msgfile" > "$msg"; else printf '%s\n' "$msgsrc" > "$msg"; fi
  grep -q '^Co-Authored-By:' "$msg" || printf '\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n' >> "$msg"
  prefix=$(git rev-parse --show-prefix)
  export GIT_INDEX_FILE=$tmp/index
  git -C "$repo" read-tree HEAD || exit 2
  for p in "${paths[@]}"; do
    r=$prefix${p#./}; r=${r%/}
    if [ -e "$repo/$r" ]; then git -C "$repo" add -A -- "$r" || exit 2
    else git -C "$repo" rm -q -r --cached --ignore-unmatch -- "$r" || exit 2; fi
  done
  t=$(git -C "$repo" write-tree) || exit 2
  unset GIT_INDEX_FILE
  [ "$t" != "$(git -C "$repo" rev-parse 'HEAD^{tree}')" ] || { echo "scripts/commit: nothing to commit in those paths"; exit 1; }
  tip=$(git -C "$repo" commit-tree "$t" -p HEAD -F "$msg") || exit 2
else
  tip=$(git -C "$repo" rev-parse HEAD) || exit 2
fi
# replay ONTO: every commit of TIP that ONTO lacks, oldest first; prints the new tip, or the conflict and fails
replay() {
  local onto=$1 c out
  for c in $(git -C "$repo" rev-list --reverse --topo-order --no-merges "$onto..$tip"); do
    if ! out=$(git -C "$repo" merge-tree --write-tree --name-only --merge-base="$c^" "$onto" "$c"); then
      echo "scripts/commit: CONFLICT replaying $(git -C "$repo" log -1 --format='%h %s' "$c" | cut -c1-100) onto origin/main:" >&2
      printf '%s\n' "$out" | sed -n '2,/^$/p' | sed '/^$/d; s/^/  /' >&2
      echo "  resolve it here (git rebase origin/main), then run scripts/commit again" >&2
      return 1
    fi
    onto=$(GIT_AUTHOR_NAME=$(git -C "$repo" log -1 --format=%an "$c") GIT_AUTHOR_EMAIL=$(git -C "$repo" log -1 --format=%ae "$c") \
           GIT_AUTHOR_DATE=$(git -C "$repo" log -1 --format=%aD "$c") \
           git -C "$repo" commit-tree "$(head -1 <<< "$out")" -p "$onto" -m "$(git -C "$repo" log -1 --format=%B "$c")") || return 1
  done
  echo "$onto"
}
base=$(git -C "$repo" rev-parse origin/main)
[ -n "$(git -C "$repo" rev-list -1 --no-merges "$base..$tip")" ] || { echo "scripts/commit: origin/main already holds this"; exit 0; }
R=$(replay "$base") || exit 1
git -C "$repo" log --oneline "$base..$R" | sed 's/^/  landing: /' | cut -c1-140

# 2-4. build what it changed, run what it touched, in the lane's build directory on the home disk
D=${ND_LAND_DIR:-$HOME/nd-land/$(basename "$repo")}
judge() {
  local c=$1 plan targets crates rowsel exes
  mkdir -p "$D"
  GIT_INDEX_FILE=$D/tree.index git -C "$repo" --work-tree="$D/tree" read-tree --reset -u "$c" 2>/dev/null ||
    { mkdir -p "$D/tree" && GIT_INDEX_FILE=$D/tree.index git -C "$repo" --work-tree="$D/tree" read-tree --reset -u "$c"; } || return 2
  if [ ! -d "$D/tree/.lake/build" ] && [ -d "$repo/.lake/build" ]; then
    stage seeding "the build directory from this worktree's .lake/build (once)"
    mkdir -p "$D/tree/.lake" && cp -a "$repo/.lake/build" "$D/tree/.lake/" || return 2
  fi
  git -C "$repo" diff --name-only "$base" "$c" > "$tmp/changed"
  git -C "$repo" show "$base:gates/runs.tsv" > "$tmp/runs.base" 2>/dev/null || : > "$tmp/runs.base"
  plan=$(python3 "$D/tree/gates/touched.py" plan "$D/tree" --changed "$tmp/changed" --base-table "$tmp/runs.base") ||
    { echo "scripts/commit: gates/touched.py plan failed"; return 1; }
  targets=$(sed -n 's/^targets: //p' <<< "$plan"); crates=$(sed -n 's/^crates: //p' <<< "$plan")
  rowsel=$(sed -n 's/^rows: //p' <<< "$plan"); exes=$(sed -n 's/^exes: //p' <<< "$plan")
  # shellcheck disable=SC2086
  local build=$(printf '%s\n' $targets $exes | awk 'NF && !seen[$0]++' | tr '\n' ' ')
  if [ -n "${build// }" ]; then
    stage building "$build"
    # shellcheck disable=SC2086
    idle env -C "$D/tree" LEAN_NUM_THREADS="${LEAN_NUM_THREADS:-4}" lake build $build > "$tmp/build.log" 2>&1
    local rc=$?
    cp "$tmp/build.log" "$D/build.log"
    if [ $rc -ne 0 ]; then
      if ! grep -qE '^error: [^ ]+\.lean:[0-9]+:[0-9]+:' "$tmp/build.log" &&
         { [ $rc -ge 128 ] || grep -qE '^Terminated|^Killed|exited with code (137|143)|signal: (9|15)' "$tmp/build.log"; }; then
        tail -3 "$tmp/build.log"
        echo "scripts/commit: NOT BUILT — the build was killed (exit $rc; SWARM_MEM_MAX=$SWARM_MEM_MAX, LEAN_NUM_THREADS=${LEAN_NUM_THREADS:-4}): not a verdict about the change; run again with a larger budget or fewer threads (log: $D/build.log)"
        return 76
      fi
      grep -E '^error|error:' "$tmp/build.log" | head -30; tail -5 "$tmp/build.log"
      echo "scripts/commit: RED — the build of what this change touched failed (log: $D/build.log)"; return 1
    fi
  else echo "scripts/commit: no module changed; nothing to build"; fi
  export CARGO_TARGET_DIR=$D/cargo-target
  case $crates in
    "") ;;
    workspace) stage checking "the Rust workspace"
      idle cargo check --quiet --locked --workspace --all-targets --manifest-path "$D/tree/Cargo.toml" > "$tmp/cargo.log" 2>&1 ||
        { tail -30 "$tmp/cargo.log"; echo "scripts/commit: RED — cargo check"; return 1; } ;;
    *) stage checking "$crates"; local pk=(); for x in $crates; do pk+=(-p "$x"); done
      idle cargo check --quiet --locked "${pk[@]}" --all-targets --manifest-path "$D/tree/Cargo.toml" > "$tmp/cargo.log" 2>&1 ||
        { tail -30 "$tmp/cargo.log"; echo "scripts/commit: RED — cargo check"; return 1; } ;;
  esac
  if [ -n "$rowsel" ]; then
    stage running "$rowsel"
    idle python3 "$D/tree/gates/touched.py" rows "$D/tree" --changed "$tmp/changed" --base-table "$tmp/runs.base" \
      --bin "$D/tree/.lake/build/bin" || { echo "scripts/commit: RED — a row this change touched"; return 1; }
  else echo "scripts/commit: no row touched"; fi
  return 0
}
judge "$R"; rc=$?; [ $rc -eq 0 ] || exit $rc

# 5. push; a moved main is re-based, and re-judged only when it changed a path this change changed
mine=$(git -C "$repo" diff --name-only "$base" "$R")
for attempt in $(seq 1 20); do
  stage pushing "$(git -C "$repo" rev-parse --short "$R")"
  if GIT_SSH_COMMAND=${GIT_SSH_COMMAND:-"ssh -o BatchMode=yes -o ConnectTimeout=20"} git -C "$repo" push -q origin "$R:refs/heads/main" 2> "$tmp/push"; then
    break
  fi
  [ "$attempt" = 20 ] && { cat "$tmp/push"; echo "scripts/commit: push refused 20 times"; exit 1; }
  git -C "$repo" fetch -q origin main || { cat "$tmp/push"; exit 1; }
  nb=$(git -C "$repo" rev-parse origin/main)
  [ "$nb" != "$base" ] || { cat "$tmp/push"; echo "scripts/commit: push refused and origin/main did not move"; exit 1; }
  overlap=$(git -C "$repo" diff --name-only "$base" "$nb" | grep -Fxf <(printf '%s\n' "$mine") || true)
  old=$base; base=$nb
  R=$(replay "$base") || exit 1
  if [ -n "$overlap" ]; then
    echo "scripts/commit: main moved and changed $(wc -l <<< "$overlap") path(s) this change changed ($(head -3 <<< "$overlap" | tr '\n' ' ')); building and running again"
    judge "$R"; rc=$?; [ $rc -eq 0 ] || exit $rc
  else
    echo "scripts/commit: main moved (${old:0:9}..${base:0:9}), touching none of this change's paths; re-based, pushing"
  fi
done
echo "scripts/commit: landed $(git -C "$repo" log --oneline -1 "$R" | cut -c1-140)"

# 6. this clone's main follows origin; this worktree moves to the landed commit
git -C "$repo" fetch -q origin main
lm=$(git -C "$repo" rev-parse -q --verify refs/heads/main || true)
if [ -n "$lm" ] && [ "$lm" != "$(git -C "$repo" rev-parse origin/main)" ]; then
  git -C "$repo" merge-base --is-ancestor "$lm" origin/main ||
    echo "scripts/commit: NOTE refs/heads/main held commits origin/main lacks; it now follows origin: $(git -C "$repo" log --oneline origin/main.."$lm" | head -5 | tr '\n' ';' | cut -c1-300)"
  git -C "$repo" update-ref refs/heads/main origin/main
fi
if ! git -C "$repo" checkout -q --detach "$R" 2> "$tmp/co"; then
  echo "scripts/commit: landed; this worktree stays where it was (an uncommitted edit conflicts with the landed tree): git checkout --detach origin/main when ready"
fi
exit 0
#!/usr/bin/env bash
# scripts/converge [--scheduled] | --install — THE CONVERGENCE: a periodic REPORT on the whole of origin/main.
#
# A landing builds what it changed and runs what it touched (scripts/commit). This is where the whole is looked at:
#   1. scripts/standing.sh on origin/main in the converge worktree (wt/converge, reset to origin/main on every run;
#      nothing else edits it), one convergence at a time box-wide (nanodregg-converge.flock): the whole build, the
#      census, the generated files, the Rust workspace (check, clippy, fmt), every row and bench, the waste ceilings,
#      and the source checks (gates/check.py);
#   2. gates/converge.py record: the CONVERGENCE line over the range since the last GREEN report, each RED unit with
#      the landings of that range it READ (by owner), each FIXED unit with its time-to-fix; appended to
#      <common>/nanodregg-standing/convergence.log.
# It never refuses a landing and never reverts one: a red is a task for the lane whose landing it names, fixed forward.
# --scheduled (the timer, every 3 h): skipped when origin/main has not moved since the last report, or one is running.
# --install: the systemd user timer nanodregg-converge.timer on this box (every 3 h).
# The whole-tree build needs a real memory budget: SWARM_MEM_MAX (unset: swarm-build's 96G) below `gates/converge.py
# floor` (1.25 x the largest completed build peak of the last 14 days) is refused by name (cv 01a16f6d: a 6 GB scope
# killed lean with no error line, 84 false reds). A build that did not finish reads build=ABSENT(killed: …), never RED.
# Run detached: nohup bash -c 'exec scripts/converge' > LOG 2>&1 & echo $! > job.pid
set -uo pipefail
. "$(dirname "$0")/gate-lib.sh"
W=$(git -C "$repo" config nanodregg.convergewt || echo "$(cd "$common/../.." && pwd)/wt/converge")
mode=now args=("$@")
while [ $# -gt 0 ]; do
  case $1 in
    --scheduled) mode=scheduled ;;
    --install) mode=install ;;
    *) echo "usage: scripts/converge [--scheduled] | --install" >&2; exit 2 ;;
  esac
  shift
done

if [ $mode = install ]; then
  d=$HOME/.config/systemd/user; mkdir -p "$d"
  cat > "$d/nanodregg-converge.service" <<EOF
[Unit]
Description=nanodregg convergence: a report on origin/main, every 3 h while landings happen
[Service]
Type=oneshot
WorkingDirectory=$W
ExecStart=/bin/bash -c 'exec $W/scripts/converge --scheduled >> $common/nanodregg-standing/converge-timer.log 2>&1'
EOF
  cat > "$d/nanodregg-converge.timer" <<EOF
[Unit]
Description=nanodregg convergence every 3 h
[Timer]
OnCalendar=*-*-* 00/3:17:00
Persistent=false
[Install]
WantedBy=timers.target
EOF
  git -C "$repo" fetch -q origin main || exit 2
  [ -d "$W" ] || git -C "$repo" worktree add -q --detach "$W" origin/main || exit 2
  systemctl --user daemon-reload && systemctl --user enable --now nanodregg-converge.timer &&
    systemctl --user list-timers nanodregg-converge.timer --no-pager
  exit $?
fi

# mem_floor_or_refuse: the build budget this run will have against the floor its whole-tree build needs.
mem_floor_or_refuse() {
  local fl cap capb
  case " ${wrap[*]:-} " in *swarm-build*) ;; *) echo "converge: no swarm-build wrapper on this clone; no memory cap to judge"; return 0 ;; esac
  fl=$(python3 "$repo/gates/converge.py" floor --peaks "$common/nanodregg-standing/build-peaks.log") ||
    { echo "converge: REFUSED — gates/converge.py floor could not read the memory floor"; return 1; }
  cap=${SWARM_MEM_MAX:-96G}
  capb=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[2]); import converge; print(converge.size_bytes(sys.argv[1]) or 0)' "$cap" "$repo/gates")
  if [ "${capb:-0}" -lt "${fl%% *}" ]; then
    echo "converge: REFUSED — SWARM_MEM_MAX=$cap is below the whole-tree build's memory floor ${fl#* }; a build under it is"
    echo "  OOM-killed and reports nothing. Run with SWARM_MEM_MAX at or above the floor, or unset (96G)."
    return 1
  fi
  echo "converge: memory: SWARM_MEM_MAX=$cap, floor ${fl#* }"
}

# One convergence at a time, box-wide. fd 5 is inherited by the re-exec below and by nothing it backgrounds.
if [ -z "${ND_CONVERGE_INNER:-}" ]; then
  flock_or_refuse || exit 2
  exec 5> "$common/nanodregg-converge.flock"
  if [ $mode = scheduled ]; then
    flock -n 5 || { echo "converge: a convergence is running; this scheduled one is skipped"; exit 0; }
  else
    flock -w 7200 5 || { echo "converge: a convergence held the lock for 2 h; not run"; exit 76; }
  fi
  # The converge worktree is this script's own: reset to origin/main, then run that copy of this script.
  git -C "$repo" fetch -q origin main || exit 2
  [ -d "$W" ] || git -C "$repo" worktree add -q --detach "$W" origin/main || exit 2
  git -C "$W" reset -q --hard origin/main || exit 2
  cd "$W" || exit 2
  ND_CONVERGE_INNER=1 exec bash "$W/scripts/converge" "${args[@]}"
fi
[ "$repo" = "$(cd "$W" && pwd)" ] || { echo "converge: the inner run must be the converge worktree's copy ($W)"; exit 2; }
SD=$common/nanodregg-standing
mkdir -p "$SD"
mem_floor_or_refuse || exit 2

sha=$(git -C "$repo" rev-parse HEAD)
if [ $mode = scheduled ] && grep -qE "^CONVERGENCE ${sha:0:12} .* => (GREEN|RED) " "$SD/convergence.log" 2>/dev/null; then
  echo "converge: origin/main ${sha:0:12} has not moved since the last report; skipped"; exit 0
fi
start=$(date +%s)
echo "converge: origin/main ${sha:0:12}, started $(date -u +%FT%TZ)"
bash "$W/scripts/standing.sh" "$sha" | tee "$SD/converge.standing"
line=$(grep -m1 '^STANDING ' "$SD/converge.standing")
[ -n "$line" ] || line="STANDING ${sha:0:12} (no verdict line: standing.sh exited before its verdict) => INCOMPLETE"
printf '%s\n' "$line" > "$SD/converge.line"
python3 "$W/gates/converge.py" record --repo "$repo" --sha "$sha" --line "$SD/converge.line" --dir "$SD" \
  --tree "$SD/tree" --traces "$common/nanodregg-traces" | tee "$SD/converge.out"
echo "converge: wall $(( ($(date +%s) - start) / 60 )) min"
exit 0
"""gates/touched.py — what a change touches: what a landing builds and runs (WORK-RULES 10-27, rule 1).

  touched.py plan TREE --changed FILE [--base-table F]
                                                 four lines: `targets: …`, `crates: …`, `rows: …`, `exes: …` (the
                                                 exes those rows run, built beside the targets)
  touched.py rows TREE --changed FILE --bin DIR [--base-table F]
                                                 run the rows the change touches over the built exes in DIR; one
                                                 line per run, exit 1 when one is not ok

A landing builds what it changed and runs what it touched, then pushes (scripts/commit). Nothing else gates it; the
whole tree, every row, the benches, the census and the tables are the convergence's REPORT (scripts/converge).

THE TARGETS. The changed modules, their importers, and the importers of a deleted module (tree.reach): the lean_libs
holding one of them and the lean_exes whose import closure holds one. A non-module build input (lakefile.lean,
lean-toolchain, lake-manifest.json, a C source or header) builds every target. A lib target is built whole.

THE CRATES. A path under a workspace member reaches that member's package and every member that depends on it by a
path dependency; the root Cargo.toml or Cargo.lock, or a manifest that does not parse, reaches the workspace whole.

THE ROWS (gates/runs.tsv, read by gates/runs.py's table). A Lean verdict row runs when a changed module is in its
exe's reach (runs.reach: the import closure, every exe's closure for an exe that spawns others), when its own row line
changed, or when a path under world/ changed (the package texts the rows install). A `cargo:`/`cargo-untraced:` row
runs when its crate changed or it drives an exe that runs. `standing:` rows (benches) and `script:` rows (THE BAR, the
gates' own plants) are the convergence's. A row passes when every one of its argument lists exits 0 and prints its
pass line last (a cargo row: exit 0). Known-red controls are not run here.
"""
import os
import sys
import tomllib

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import tree  # noqa: E402

BUILD_INPUTS = ("lakefile.lean", "lean-toolchain", "lake-manifest.json")


def targets(root: str, changed: list[str]) -> list[str]:
    t = tree.read(root)
    allt = [x["name"] for x in t.lake["lean_lib"]] + [x["name"] for x in t.lake["lean_exe"]]
    if any(p in BUILD_INPUTS or p.endswith((".c", ".h")) for p in changed):
        return allt
    lean = tree.changed_modules(changed)
    if not lean:
        return []
    gone = lean - set(t.modules)
    r = tree.reach(t, lean)
    libs = [x for x in t.libs if any(m.split(".")[0] == x for m in r)]
    exes = [e for e, root_mod in t.exes.items() if t.closure([root_mod]) & r]
    # a deleted module with no importer reaches its lib (its other modules may still name it in a doc only)
    libs += [x for x in t.libs if x not in libs and any(m.split(".")[0] == x for m in gone)]
    return libs + exes


def crates(root: str, changed: list[str]) -> list[str] | str:
    if any(p in ("Cargo.toml", "Cargo.lock") for p in changed):
        return "workspace"
    try:
        members = tomllib.load(open(os.path.join(root, "Cargo.toml"), "rb"))["workspace"]["members"]
        assert isinstance(members, list) and all(isinstance(m, str) for m in members)
    except FileNotFoundError:
        return []
    except Exception:
        return "workspace"
    hit = [m for m in members if any(p.startswith(m.rstrip("/") + "/") for p in changed)]
    if not hit:
        return []
    # each member's package name and path dependencies, read from the manifests
    name, deps = {}, {}
    try:
        for m in members:
            man = tomllib.load(open(os.path.join(root, m, "Cargo.toml"), "rb"))
            name[m] = man["package"]["name"]
            ds = set()
            for sec in ("dependencies", "dev-dependencies", "build-dependencies"):
                for v in (man.get(sec) or {}).values():
                    if isinstance(v, dict) and "path" in v:
                        ds.add(os.path.normpath(os.path.join(m, v["path"])))
            deps[m] = ds
    except Exception:
        return "workspace"
    out, stack = set(), list(hit)
    while stack:
        m = stack.pop()
        if m in out:
            continue
        out.add(m)
        stack += [x for x in members if os.path.normpath(m) in deps[x]]
    return [name[m] for m in members if m in out]


def row_lines(path: str) -> dict[str, str]:
    try:
        return {l.split("\t", 1)[0]: l.rstrip("\n") for l in open(path, encoding="utf-8") if l.strip() and not l.startswith("#")}
    except FileNotFoundError:
        return {}


def rows(root: str, changed: list[str], base_table: str | None = None) -> list[str]:
    import runs  # noqa: E402  (the table reader and the exe reach)
    t = tree.read(root)
    table = runs.table(root)
    mods = tree.changed_modules(changed)
    world = any(p.startswith("world/") for p in changed)
    now, before = row_lines(os.path.join(root, runs.RUNS)), row_lines(base_table) if base_table else {}
    moved = {k for k in now if runs.RUNS in changed and now.get(k) != before.get(k)}
    lean = [k for k, (rs, _p, _c) in table.items()
            if rs is not None and not k.startswith(runs.CARGO + ("script:", runs.STANDING))
            and k in t.exes and (world or k in moved or runs.reach(t, k) & mods)]
    reached = set(lean) | {e for e in t.exes if mods and runs.reach(t, e) & mods}
    cargo = [k for k, (rs, _p, _c) in table.items() if k.startswith(runs.CARGO)
             and (k in moved or any(p.startswith(k.split(":")[1] + "/") for p in changed) or set(rs[0]) & reached)]
    return sorted(lean) + sorted(cargo)


def needs(root: str, selected: list[str]) -> list[str]:
    """The lean_exes the selected rows run: the row's own exe, `host` for a `{host}` argument, a cargo row's drives."""
    import runs  # noqa: E402
    table, out = runs.table(root), set()
    for k in selected:
        rs = table[k][0]
        if k.startswith(runs.CARGO):
            out |= set(rs[0])
        else:
            out.add(k)
            if any("{host}" in a for args in rs for a in args):
                out.add("host")
    return sorted(out)


def run_rows(root: str, selected: list[str], bindir: str) -> int:
    import runs  # noqa: E402
    import tempfile  # noqa: E402
    t = tree.read(root)
    table = runs.table(root)
    bad = 0
    scratch = tempfile.mkdtemp(prefix="nd-land-rows-")
    for k in selected:
        rs, passline, _ = table[k]
        lists = [[]] if k.startswith(runs.CARGO) else rs
        for i, args in enumerate(lists):
            out, v = runs.run(t, k, args, passline, os.path.join(scratch, f"r{i}"), bindir,
                              drives=rs[0] if k.startswith(runs.CARGO) else ())
            label = k + (" " + " ".join(args) if args else "")
            print(f"  row {label}: {v}", flush=True)
            if not v.startswith("ok"):
                bad += 1
                tail = [l for l in out.strip().splitlines() if l.strip()][-12:]
                print("\n".join("    | " + l[:200] for l in tail), flush=True)
    os.rmdir(scratch) if os.path.isdir(scratch) and not os.listdir(scratch) else None
    print(f"rows: {'ok' if not bad else f'{bad} not ok'} ({len(selected)} row(s))")
    return 1 if bad else 0


def main() -> int:
    cmd, root, args = sys.argv[1], sys.argv[2], sys.argv[3:]

    def opt(f: str) -> str | None:
        return args[args.index(f) + 1] if f in args else None
    changed = [x for x in open(opt("--changed"), encoding="utf-8").read().split("\n") if x]
    if cmd == "plan":
        c = crates(root, changed)
        print("targets: " + " ".join(targets(root, changed)))
        print("crates: " + (c if isinstance(c, str) else " ".join(c)))
        rs = rows(root, changed, opt("--base-table"))
        print("rows: " + " ".join(rs))
        print("exes: " + " ".join(needs(root, rs)))
        return 0
    if cmd == "rows":
        return run_rows(root, rows(root, changed, opt("--base-table")), opt("--bin"))
    print(f"touched.py: unknown command {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())

exec
/bin/zsh -lc "ssh -n hbox 'cd /tank/dregg-build/nanodregg/main && python3 -c '\\''import subprocess,re,json

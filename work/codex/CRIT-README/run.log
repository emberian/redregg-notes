for p in paths:
 r=subprocess.run([\"git\",\"show\",rev+\":\"+p],text=True,capture_output=True)
 print(json.dumps({\"path\":p,\"exists\":r.returncode==0,\"lines\":len(r.stdout.splitlines()),\"error\":r.stderr.strip()}))
for p in [\"Kernel/Sim/Main.lean\",\"Host/Sim/Main.lean\",\"Host/Sim/FileMain.lean\",\"Lang/Journey/Main.lean\",\"Protocol/Rows/Main.lean\",\"docs/TESTGROUND.md\",\"docs/OBJECTS.md\"]:
 print(\"\\nSOURCE \"+p+\"\\n\"+show(p))

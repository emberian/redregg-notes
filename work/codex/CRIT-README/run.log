870:rests on the sealer's tags; it is not proved from `Log.recover`. -/
871:theorem openWith_lastFrame {W F : Type} (keys : Keys) (c : Cadence) (world : Codec.Stream W)
872:    (mark : W → Nat × ByteArray) (origin : W → ByteArray) (step : W → ByteArray → Except F W)
873:    (file H I S : ByteArray) {o : Opening W}
874:    (h : Id.run (openWith keys c world mark origin step file H S.size I.size (segReader I) (segReader S)) = .ok o)
875:    (hpos : 0 < o.sealed.index.count) :
902:before anything is read. -/
903:theorem lastFrameFault_none_off {F : Type} {m : Type → Type} [Monad m] (s : Sealer) (rm O B : Nat)
904:    (readTail : Nat → Nat → m (Except (StoreFault F) ByteArray)) (h : B ≠ O) :
905:    lastFrameFault s rm O B none readTail = pure (some (.base .indexCorrupt)) := by
906:  simp only [lastFrameFault, if_neg h]
907:
910:lies before it (`StoreIndexes`' run start). -/
911:theorem openWith_originEnd {W F : Type} (keys : Keys) (c : Cadence) (world : Codec.Stream W)
912:    (mark : W → Nat × ByteArray) (origin : W → ByteArray) (step : W → ByteArray → Except F W)
913:    (file H I S : ByteArray) {o : Opening W}
914:    (h : Id.run (openWith keys c world mark origin step file H S.size I.size (segReader I) (segReader S)) = .ok o)
915:    {b : Base W} {n : Nat} {d : ByteArray} (hb : Base.read keys c world file = .ok (b, n, d))

SOURCE Protocol/Head.lean
1:/-
2:# Protocol.Head — a World's position, and a member's attestation of its own (PROTOCOL-74; DESIGN-TRUST T1)
3:
4:A HEAD is one World's position as every party states it: the World (its origin, KERNEL-24), its step
5:count (the chain's index, KERNEL-47), its height, its roots digest (what a receipt is checked
6:against, PROTOCOL-45) and its chain (what `fold_head_binds` binds: one `(steps, chain)` is one log).
7:Four spellings of it were in the tree (`logPage`'s pair, `receipt CALL`'s `head` line, `Std.head`'s
8:record, `host check`'s anchor); this is the one.
9:
10:An ATTESTATION is a member's signed statement that its OWN follow's fold sits at a head: the head,
11:the member and its key, signed under `domHead` (the seventh signing domain, pairwise disjoint from
12:the six of `Protocol.Proofs.Domains`). It is not an authority: it says what one member holds, never
13:what the World is. Follow makes one at the tip of a catch-up (`nd sync --attest`: the message it
14:hands custody is its own World's head, `Command.attestTip`) and checks another member's
15:(`nd sync --check ATTEST`): the signature under the key it names, the World, and, on the World it
16:caught up to, that the key is the signer's CURRENT one (a rotated-away key is `staleKey`: an
17:attestation is checked under the signer's current key; rotate, then attest again).
18:
51:/-- One World's position. -/
52:structure Head (D : Type) where
53:  origin : D
54:  steps : Nat
55:  height : Nat
56:  roots : D
60:/-- A World's own head. -/
61:def headOf (E : Env D) (w : World D) : Head D :=
62:  ⟨w.origin, w.steps, w.height, w.roots E, w.chain⟩
63:
64:/-- The domain every attestation message begins with. -/
65:def domHead : ByteArray := "nanodregg/protocol/head/v1".toUTF8
66:
67:/-- The signed part: the head's five fields, the member's id bytes and its key. -/
68:def unsignedLayout : Layout :=
69:  [.bytes "origin", .u64 "steps", .u64 "height", .bytes "roots", .bytes "chain", .bytes "member", .bytes "key"]
70:
71:/-- An attestation on the wire: the signed bytes as carried, then the signature over them. -/
72:def attestationLayout : Layout := [.bytes "unsigned", .bytes "signature"]
73:
74:def unsignedFrame : Stream (Layout.Ty Bounds.frameBytesMax unsignedLayout) :=
75:  Layout.codec Bounds.frameBytesMax (by decide) unsignedLayout
76:
77:def attestationFrame : Stream (Layout.Ty Bounds.frameBytesMax attestationLayout) :=
78:  Layout.codec Bounds.frameBytesMax (by decide) attestationLayout
79:
80:/-- The unsigned bytes of an attestation's fields, or `none` past the frame bound. -/
81:def unsignedBytes (E : Env D) (h : Head D) (member : D) (key : ByteArray) : Option ByteArray := do
82:  let f := Text.fit Bounds.frameBytesMax
83:  pure (unsignedFrame.bytes (← f (E.bytes h.origin), h.steps.toUInt64, h.height.toUInt64,
84:    ← f (E.bytes h.roots), ← f (E.bytes h.chain), ← f (E.bytes member), ← f key, ()))
85:
86:/-- What the member signs. -/
87:def message (unsigned : ByteArray) : ByteArray := domHead ++ unsigned
88:
89:/-- An attestation's wire bytes, or `none` past the frame bound. -/
90:def bytes (unsigned signature : ByteArray) : Option ByteArray := do
91:  let f := Text.fit Bounds.frameBytesMax
92:  pure (attestationFrame.bytes (← f unsigned, ← f signature, ()))
93:
94:/-- A decoded attestation. -/
95:structure Attestation (D : Type) where
96:  head : Head D
97:  member : D
98:  key : ByteArray
99:  /-- the signed bytes exactly as carried (`unsignedFrame`) -/
103:/-- Why an attestation is not taken (law 7). -/
104:inductive Refusal
105:  /-- the bytes are not an attestation (either frame, or a digest field) -/
106:  | badAttestation
107:  /-- it names another World than the member's own -/
108:  | otherWorld
116:
117:def Refusal.name : Refusal → String
118:  | .badAttestation => "badAttestation" | .otherWorld => "otherWorld"
119:  | .badHeadSignature => "badHeadSignature" | .notMember => "notMember" | .staleKey => "staleKey"
120:
121:/-- The constructor's index, the thing a name must determine (`Proofs.Head.Refusal.name_injective`). -/
122:def Refusal.tag : Refusal → Nat
123:  | .badAttestation => 0 | .otherWorld => 1 | .badHeadSignature => 2 | .notMember => 3 | .staleKey => 4
124:
125:def Refusal.all : List Refusal := [.badAttestation, .otherWorld, .badHeadSignature, .notMember, .staleKey]
126:
127:/-- Decode the signed bytes, checking nothing they state. -/
128:def said (X : Ctx D) (u : ByteArray) : Option (Head D × D × ByteArray) :=
129:  match unsignedFrame.decode u with
130:  | .error _ => none
131:  | .ok (o, s, h, r, c, m, k, ()) => do
132:      pure (⟨← X.digestOf o.1, s.toNat, h.toNat, ← X.digestOf r.1, ← X.digestOf c.1⟩, ← X.digestOf m.1, k.1)
134:/-- Decode an attestation, checking nothing it states. -/
135:def ofBytes (X : Ctx D) (b : ByteArray) : Option (Attestation D) :=
136:  match attestationFrame.decode b with
137:  | .error _ => none
138:  | .ok (u, s, ()) => do
139:      let (h, m, k) ← said X u.1
143:names. Whether that key is the member's is `signer`'s question, asked on a caught-up World. -/
144:def verified (X : Ctx D) (origin : D) (b : ByteArray) : Except Refusal (Attestation D) :=
145:  match ofBytes X b with
146:  | none => .error .badAttestation
147:  | some a =>
148:    if a.head.origin ≠ origin then .error .otherWorld
152:/-- On `w`, the attestation's member is live and the key it names is that member's current one. -/
153:def signer (X : Ctx D) (w : World D) (a : Attestation D) : Except Refusal Unit :=
154:  match currentKey X.env w a.member with
155:  | none => .error .notMember
156:  | some k => if k = a.key then .ok () else .error .staleKey
157:
160:/-- What walking a page's steps against an anchor finds. -/
161:inductive Anchored
162:  /-- the fold reached the anchor's step count with the anchor's chain -/
163:  | shared
164:  /-- the page ends before the anchor's step count (or began past it) -/
165:  | unreached
171:as `World.fold` stamps them: `stepLink`, `chainOf`) and compare at the anchor's step count. -/
172:def anchorCheck (E : Env D) (steps : Nat) (chain : ByteArray) : Nat → D → List (Kernel.Step D × D) → Anchored
173:  | _, _, [] => .unreached
174:  | s, c, (t, r) :: rest =>
175:      let c' := stepLink E c t r
176:      if s + 1 = steps then (if E.bytes c' = chain then .shared else .forked)
181:/-- `Std.headPackage`'s `post`: method 1 (methods by label, ascending: `fork`, `post`). -/
182:def postMethod : Nat := 1
183:
184:/-- The text `sync --post` hands the head object's `post`: follow's own World's head at
185:`Std.headAtTy` (labels ascending: chain, height, roots, steps), as `nd invoke` would be given it. -/
186:def headText (X : Ctx D) (w : World D) : String :=
187:  s!"(record (chain #{Text.toHex (X.env.bytes w.chain)}) (height {w.height}) (roots #{Text.toHex (X.env.bytes (w.roots X.env))}) (steps {w.steps}))"
188:
189:/-- The cells a step wrote or made: where a head object can have changed. -/
190:def stepCells : Kernel.Step D → List D
191:  | .turn t => t.touches.map (·.cell) ++ createdIds t
192:  | .refusal _ => []
193:
194:/-- A self-head post: on `w'` (the World after the page), cell `c`, touched by step `s` of the page,
196:origin) holding an `at` head: its `(steps, chain)`, and the member whose call the step was. -/
197:def selfPost (X : Ctx D) (w' : World D) (s : Kernel.Step D) (c : D) : Option (Nat × ByteArray × Option D) := do
198:  let cell ← w'.live X.env c
199:  match Lang.headView X.digestOf (X.env.bytes (Foreign.headPackageId X.env)) cell with
200:  | some (.at world chain _ _ steps) =>
201:      if world = X.env.bytes w'.origin then
208:/-- Every self-head post a page carries, in log order. -/
209:def selfPosts (X : Ctx D) (w' : World D) (ts : List (Kernel.Step D × D)) : List (Nat × ByteArray × Option D) :=
210:  ts.flatMap fun p => (stepCells p.1).filterMap (selfPost X w' p.1)
211:
212:/-- The first self-head post whose position follow's fold reached ON THIS PAGE with another chain
213:(`anchorCheck` from follow's position before the page, as `sync --to` walks): its step count and
224:own Store answers them (`forkedBehindPost`, `Host.Follow.loop`: T2b'). -/
225:def behindPosts (X : Ctx D) (w : World D) (ts : List (Kernel.Step D × D)) (w' : World D) :
226:    List (Nat × ByteArray × Option D) :=
227:  (selfPosts X w' ts).filter fun p => decide (p.1 ≤ w.steps)
228:
229:/-- The first behind post whose chain is not the chain follow's own history holds at its step count
231:longer keeps (`chainAt s = none`: below its oldest kept file) is not compared: the Store cannot say. -/
232:def forkedBehindPost (posts : List (Nat × ByteArray × Option D)) (chainAt : Nat → Option ByteArray) :
233:    Option (Nat × Option D) :=
234:  posts.findSome? fun p => match chainAt p.1 with
235:    | some c => if c = p.2.1 then none else some (p.1, p.2.2)
236:    | none => none
240:An attestation says what ONE MEMBER holds. A CERTIFICATE says what the WORLD is at: a head with
241:`threshold` signatures by the World's CERTIFIERS, the authority a World is given at its genesis
242:(KERNEL-69: `Kernel.Receive.Authority`, in the genesis input and the World's authority cell).
243:Every World today has `Authority.none` (no certifier, threshold 0: the writer's page is its bare
244:word and members audit, as before); one key at threshold 1 is the lock writer with a signature; `3f+1`
245:keys at threshold `2f+1` is the committee. The object, its domain (`domCertify`, the eighth a key
246:signs under) and its one verification path (`certified`: `threshold` DISTINCT listed certifiers,
247:each signature verifying over the certified bytes) land here, with refusals by name. No deployed
248:path PRODUCES a certificate yet (a Store holds no certify seed: cv 01a1769d, Ember's), and none
249:consumes one yet (the `Carried` start, the `log`/`read` reply field, `Thin.accept`, the head law's
250:`uncertified`: the next landing). What a verifier learns from `certified = .ok` is `Proofs.Head.certified_ok`; what two
251:certificates at one step count mean under a quorum is `certified_intersect` and
252:`certified_equivocation` there, the committee row of DESIGN-TRUST §1.3's table as a theorem over
253:the object alone. -/
254:
255:/-! `Authority` here is KERNEL's (`Kernel.Receive.Authority`, KERNEL-69): who may certify and how
256:many must, fixed at genesis, committed in the origin (`GenesisInput`) and carried in the World as
257:one ROM cell (`authorityCell`, read back by `authorityOf`); `Authority.none` names nobody. This file
258:defines no copy of it. -/
259:
260:/-- The domain every certificate message begins with (byte 19 differs from `domHead`). -/
261:def domCertify : ByteArray := "nanodregg/protocol/certify/v1".toUTF8
262:
263:/-- The certified part: the head's five fields. No member, no key: a certificate is the World's
264:statement, and who made it is the authority's list, not the bytes. -/
265:def certifiedLayout : Layout :=
266:  [.bytes "origin", .u64 "steps", .u64 "height", .bytes "roots", .bytes "chain"]
267:
268:/-- A certificate on the wire: the certified bytes as carried, then the signers (each an index into
269:the authority's list, as u64 bytes) and their signatures, two lists read in step. -/
270:def certificateLayout : Layout := [.bytes "certified", .list "signers", .list "signatures"]
271:
272:def certifiedFrame : Stream (Layout.Ty Bounds.frameBytesMax certifiedLayout) :=
273:  Layout.codec Bounds.frameBytesMax (by decide) certifiedLayout
274:
275:def certificateFrame : Stream (Layout.Ty Bounds.frameBytesMax certificateLayout) :=
276:  Layout.codec Bounds.frameBytesMax (by decide) certificateLayout
277:
278:/-- The bytes a certifier signs over, or `none` past the frame bound. -/
279:def certifiedBytes (E : Env D) (h : Head D) : Option ByteArray := do
280:  let f := Text.fit Bounds.frameBytesMax
281:  pure (certifiedFrame.bytes (← f (E.bytes h.origin), h.steps.toUInt64, h.height.toUInt64,
282:    ← f (E.bytes h.roots), ← f (E.bytes h.chain), ()))
283:
284:/-- What a certifier signs. -/
285:def certifyMessage (certified : ByteArray) : ByteArray := domCertify ++ certified
286:
287:/-- A certificate's wire bytes, or `none` past the frame bounds. -/
288:def certificateBytes (certified : ByteArray) (sigs : List (Nat × ByteArray)) : Option ByteArray := do
289:  let f := Text.fit Bounds.frameBytesMax
290:  let l := Text.fitList Bounds.frameBytesMax
291:  pure (certificateFrame.bytes (← f certified, ← l (sigs.map fun p => Text.u64 p.1),
292:    ← l (sigs.map (·.2)), ()))
293:
294:/-- A decoded certificate. -/
295:structure Certificate (D : Type) where
296:  head : Head D
297:  /-- the certified bytes exactly as carried (`certifiedFrame`) -/
298:  certified : ByteArray
299:  /-- the signers (indices into the authority's list) and their signatures, as carried -/
300:  sigs : List (Nat × ByteArray)
301:  deriving DecidableEq
302:
303:/-- Why a certificate is not taken (law 7). -/
304:inductive CertRefusal
305:  /-- the bytes are not a certificate (either frame, a digest field, or lists of two lengths) -/
306:  | badCertificate
307:  /-- it names another World -/
308:  | otherWorld
309:  /-- signer `index` is not in the authority's list -/
310:  | unlisted (index : Nat)
311:  /-- certifier `index` signs twice -/
312:  | repeated (index : Nat)
313:  /-- certifier `index`'s signature does not verify over the certified bytes -/
314:  | badCertifySignature (index : Nat)
315:  /-- fewer distinct listed certifiers than the authority's threshold -/
316:  | belowThreshold (signers threshold : Nat)
317:  /-- the authority names nobody (threshold 0, `Authority.none`): it certifies nothing, so no
318:  certificate under it is taken, however many signatures it carries (PROTOCOL-77.1) -/
319:  | noAuthority
320:  /-- it verifies, but certifies another head than the World it is checked against (PROTOCOL-77.1:
321:  a stale certificate of an older base, or a forged World under a genuine one) -/
322:  | otherHead
323:  deriving DecidableEq, Repr
324:
325:def CertRefusal.name : CertRefusal → String
326:  | .badCertificate => "badCertificate" | .otherWorld => "otherWorld" | .unlisted _ => "unlisted"
327:  | .repeated _ => "repeated" | .badCertifySignature _ => "badCertifySignature"
328:  | .belowThreshold .. => "belowThreshold" | .noAuthority => "noAuthority" | .otherHead => "otherHead"
329:
330:/-- The constructor's index, the thing a name must determine (`Proofs.Head.CertRefusal.name_injective`). -/
331:def CertRefusal.tag : CertRefusal → Nat
332:  | .badCertificate => 0 | .otherWorld => 1 | .unlisted _ => 2 | .repeated _ => 3
333:  | .badCertifySignature _ => 4 | .belowThreshold .. => 5 | .noAuthority => 6 | .otherHead => 7
334:
335:/-- One refusal of every name (arguments are placeholders; a name drops them). -/
336:def CertRefusal.all : List CertRefusal :=
337:  [.badCertificate, .otherWorld, .unlisted 0, .repeated 0, .badCertifySignature 0, .belowThreshold 0 0,
338:   .noAuthority, .otherHead]
339:
340:/-- Decode the certified bytes, checking nothing they state. -/
341:def certifiedSaid (X : Ctx D) (u : ByteArray) : Option (Head D) :=
342:  match certifiedFrame.decode u with
343:  | .error _ => none
344:  | .ok (o, s, h, r, c, ()) => do
345:      pure ⟨← X.digestOf o.1, s.toNat, h.toNat, ← X.digestOf r.1, ← X.digestOf c.1⟩
346:
347:/-- Decode a certificate, checking nothing it states. -/
348:def certificateOfBytes (X : Ctx D) (b : ByteArray) : Option (Certificate D) :=
349:  match certificateFrame.decode b with
350:  | .error _ => none
351:  | .ok (u, ss, sg, ()) =>
352:      match certifiedSaid X u.1, (Text.unlist ss).mapM Text.ofU64 with
353:      | some h, some signers =>
354:          if signers.length = (Text.unlist sg).length then
355:            some { head := h, certified := u.1, sigs := signers.zip (Text.unlist sg) }
356:          else none
357:      | _, _ => none
358:
359:/-- Walk the signatures from the signers `seen`: each signer listed, not seen, verifying over `msg`.
360:Returns every signer accepted. -/
361:def certifySigners (X : Ctx D) (auth : Authority) (msg : ByteArray) :
362:    List (Nat × ByteArray) → List Nat → Except CertRefusal (List Nat)
363:  | [], seen => .ok seen
364:  | (i, s) :: rest, seen =>
365:      match auth.certifiers[i]? with
366:      | none => .error (.unlisted i)
367:      | some k =>
368:          if i ∈ seen then .error (.repeated i)
369:          else if !X.verify k msg s then .error (.badCertifySignature i)
370:          else certifySigners X auth msg rest (i :: seen)
371:
372:/-- Decode and verify under `auth`: the authority names somebody (`noAuthority` otherwise: a
373:threshold of 0 would take a certificate with no signature), the certificate is for `origin`, and at
374:least `auth.threshold` distinct listed certifiers each signed its certified bytes under `domCertify`. The one path every
375:party that trusts a head without a World (a thin joiner, a foreign World, a phone) will run. -/
376:def certified (X : Ctx D) (auth : Authority) (origin : D) (b : ByteArray) :
377:    Except CertRefusal (Certificate D) :=
378:  if auth.threshold = 0 then .error .noAuthority else
379:  match certificateOfBytes X b with
380:  | none => .error .badCertificate
381:  | some c =>
382:    if c.head.origin ≠ origin then .error .otherWorld
383:    else match certifySigners X auth (certifyMessage c.certified) c.sigs [] with
384:      | .error r => .error r
385:      | .ok signers =>
386:          if signers.length < auth.threshold then .error (.belowThreshold signers.length auth.threshold)
387:          else .ok c
388:
389:/-- **A World's head, certified under the World's own authority** (PROTOCOL-77.1): what a member
390:adopting a base asks of the writer's certificate `b`. Under an authority that names nobody nothing
391:is asked (`ok`: every World today, `Authority.none`); otherwise `b` verifies under that authority
392:(`certified`) and certifies exactly `headOf w` (`otherHead` else). A World that carries no single
393:authority cell is refused `noAuthority` (no honest fold reaches one: `authorityOf_honest_fold`). The
394:authority is read off `w`, so the caller must already trust `w`'s bytes (a pin binds them); what
395:this adds is the writer's own signature on the head, non-repudiable to anyone holding the genesis. -/
396:def certifiesWorld (X : Ctx D) (w : World D) (b : ByteArray) : Except CertRefusal Unit :=
397:  match authorityOf w with
398:  | none => .error .noAuthority
399:  | some auth =>
400:      if auth.threshold = 0 then .ok ()
401:      else match certified X auth w.origin b with
402:        | .error r => .error r
403:        | .ok c => if c.head = headOf X.env w then .ok () else .error .otherHead
404:
405:end Nanodregg.Protocol.Head

SOURCE Kernel/Receive/Submit.lean
1:/-
2:# Kernel.Receive.Submit — the Host's whole decision for one signed call
3:
4:A retry is recognised before anything is derived: the transaction id is the digest of the signed
5:call, so a call already in the journal is `replayed` at its height whatever the World is now
6:(a retried rotation must not be re-judged against the key it already rotated). Otherwise: check its
7:signer, compare its pins, derive, then admit (`World.admit`). The Host commits exactly the returned
8:World.
9:
10:Order of the checks `submit` makes (each refuses by name; the first that fails answers):
11:1. the journal: an exact retry is `replayed` at its height;
12:2. the recorded refusals: a recorded call is `refusedFinal` with its code (KERNEL-44);
13:3. its authority to be judged (`signedBy`): the World it names (`wrongWorld`, KERNEL-24), its signature
14:   (the one verify, PERF-1), the member's key (`authKey`: the current key, or for a rotation the
15:   precommitted next one). A party that holds no key of a member is answered here, before any cell is
16:   compared, so the pins are no oracle on the World's cells for it;
17:4. the pins (KERNEL-66, `checkPins`): every cell pin, row pin and range read against the Host's World.
18:   A moved pin is `stale`, before any receiver or law reads a cell: a stale call is judged by what it
19:   observed, never by what the World holds now (`Kernel.Proofs.Rederive.stale_declined_before_receive`);
20:5. the receivers (`deriveTurn`: authority, laws, programs) on the pinned view;
21:6. `World.admit` of the derived Turn, in the order its own header lists.
22:Steps 3 and 5 are `receive` with step 4 between them (`Kernel.Proofs.Receive.receive_signed`).
23:-/
24:import Kernel.Receive.Derive
30:/-- Why a submission did not commit: the receive layer refused, or the kernel rejected. -/
31:inductive Verdict (D : Type)
32:  | refused (r : Refusal D)
33:  | rejected (r : Reject D)
34:  deriving DecidableEq, Repr
35:
38:/-- A recorded refusal answers its transaction id with its code, without re-deriving (KERNEL-44). -/
39:def refusedAnswer (X : Ctx D) (w : World D) (c : Call D) : Option Nat :=
40:  match w.refusalAt X.env (.tx (txIdOf X c)) with
41:  | some (.refused _ code _) => some code
42:  | _ => none
43:
45:the precommitted next key (`rotate`'s own check: KERNEL-47 amendment 7). -/
46:def authKey (X : Ctx D) (look : Pinned D) (c : Call D) : Except (Refusal D) Unit :=
47:  match c.unsigned.body with
48:  | .rotate key next => (rotate X look c key next).map fun _ => ()
49:  | _ => checkKey look c.unsigned
50:
52:made at most once per judgement. -/
53:def checkSignatureBy (X : Ctx D) (c : Call D) (verified : Bool) : Except (Refusal D) Unit :=
54:  if verified then .ok () else checkSignature X c
55:
56:/-- Is the call signed, for THIS World, by a key the member holds (KERNEL-44's class (A))? The World it
57:names first (`wrongWorld`, KERNEL-24), then the signature (skipped when `verified` carries a passing
59:(KERNEL-66), and `judge` records only a refusal of a call it passes. -/
60:def signedBy (X : Ctx D) (w : World D) (c : Call D) (verified : Bool) : Except (Refusal D) Unit := do
61:  req (c.unsigned.world = w.origin) .wrongWorld
62:  checkSignatureBy X c verified
63:  authKey X (pinned X.env w c.unsigned.pins) c
64:
66:refused call is `refusedFinal` with its recorded code, never re-derived: KERNEL-44), then its
67:authority to be judged (`signedBy`), then its pins (a moved one is `stale`, before anything is
68:derived: KERNEL-66), then derive (`deriveTurn` on the pinned view) and admit. -/
69:def submit (X : Ctx D) (w : World D) (c : Call D) : Except (Verdict D) (Turn D × World D) :=
70:  match w.journalAt X.env (txIdOf X c) with
71:  | some (h, _) => .error (.rejected (.replayed h))
72:  | none =>
73:      match refusedAnswer X w c with
92:`codeName_code`). -/
93:def refusalNames : List String :=
94:  ["wrongWorld", "badSignature", "unknownKey", "notPrecommitted", "badPossession", "unpinned",
95:   "missingCell", "wrongKind", "malformedCell", "lawDenied", "program", "stateKey", "tooManyLaws",
96:   "hasMethods", "noMethods", "noGrant", "grantTarget", "grantRight", "grantWidens", "unrooted",
97:   "enrollSpent", "transferSpent", "creditSpent", "rightTarget", "notIssuer", "grantTooDeep", "overPrice", "eventMismatch",
103:/-- The wire names of the kernel's rejections, in constructor order (checked against `Reject.name`). -/
104:def rejectNames : List String :=
105:  ["overBound", "replayed", "duplicateTouch", "duplicateNullifier", "duplicateKey", "nonCanonicalCell",
106:   "outsideWindow", "stale", "spent", "chargeMismatch", "overAllowance", "idTaken", "notContentId",
107:   "bornTouched", "missingCell", "romWrite", "romRetire", "appendOnly", "valueMalformed", "belowFloor",
108:   "notConserved", "floorNotConserved", "refusedFinal", "refusalBudget", "keyTaken", "relationFull",
113:/-- A verdict's wire name. -/
114:def Verdict.name : Verdict D → String
115:  | .refused r => r.name
116:  | .rejected r => r.name
117:
118:/-- The code a recorded refusal carries: its name's index, the receive refusals first. -/
119:def Verdict.code : Verdict D → Nat
120:  | .refused r => refusalNames.idxOf r.name
121:  | .rejected r => refusalNames.length + rejectNames.idxOf r.name
122:
123:/-- Is the verdict a stale pin (KERNEL-54)? Such a refusal is never recorded (`judgeBy` declines it):
125:(`stale_behind_forever`), so the fold settles it without a record. -/
126:def Verdict.isStale : Verdict D → Bool
127:  | .rejected (.stale _) => true
128:  | _ => false
129:
130:/-- The code a stale refusal would carry: one `judge` never records (`judge_recorded_not_stale`). -/
131:def staleCode : Nat := refusalNames.length + rejectNames.idxOf "stale"
132:
133:/-- The name a recorded code answers with (`lookup`'s and a resubmit's `refused NAME`). -/
134:def codeName (k : Nat) : Option String :=
135:  if k < refusalNames.length then refusalNames[k]? else rejectNames[k - refusalNames.length]?
136:
137:/-- The code table by name: every recorded code's name, in code order (`codeName`). A record holds
138:its code, never its name, so a Store is stamped with this table (`Host.Base.shapeStamp`): a binary
140:Store `shapeMismatch` rather than reading its codes as other names. -/
141:def codeTable : String :=
142:  "kernel/refusal-codes/v1: " ++ ",".intercalate (refusalNames ++ rejectNames)
143:
144:/-- What `World.refuse` records for call `c` with verdict `v` and cancel field `a` (KERNEL-60): the
145:call's own transaction id, member, window and bytes, whoever asks for the record. -/
146:def recordOf (X : Ctx D) (c : Call D) (v : Verdict D) (a : ByteArray) : Refused D :=
147:  { txId := txIdOf X c, member := c.unsigned.member, notBefore := c.unsigned.notBefore,
148:    validUntil := c.unsigned.validUntil, code := v.code, event := X.callBytes c, cancel := a }
149:
150:/-- What `World.refuse` records for a call refused with `v`: its record with no cancel signature. -/
151:def refusedOf (X : Ctx D) (c : Call D) (v : Verdict D) : Refused D := recordOf X c v ByteArray.empty
152:
153:/-- Did `submit` reach verdict `v` only past a signature that VERIFIED (PERF-1)? A refusal `receive`
154:made after its signature check (anything but `wrongWorld` and `badSignature`), a moved pin (`stale`,
155:KERNEL-66: compared only past `signedBy`), or any rejection `World.admit` made, is reached only through
159:verify failed. -/
160:def Verdict.verified : Verdict D → Bool
161:  | .refused .wrongWorld => false
162:  | .refused .badSignature => false
163:  | .refused _ => true
164:  | .rejected (.replayed _) => false
169:signature check skipped when `verified` already carries its passing (`judge`)? `signedBy` passed. -/
170:def authenticatedBy (X : Ctx D) (w : World D) (c : Call D) (verified : Bool) : Bool :=
171:  match signedBy X w c verified with
172:  | .ok () => true
173:  | .error _ => false
174:
176:such a refusal is charged to the member and recorded; any other is answered and forgotten (U). -/
177:def authenticated (X : Ctx D) (w : World D) (c : Call D) : Bool := authenticatedBy X w c false
178:
179:/-- What the Host does with a signed call (KERNEL-44): admitted; refused and RECORDED (final within
180:the window: `submit_refused_final`); or refused and NOT recorded (`declined`: stale (KERNEL-54), unauthenticated, early,
181:or over the member's `refusalBudget`, or the World's `refusalsFull` (KERNEL-55 R1), which is the
185:instead (`stale_behind_forever`), and an AHEAD stale is not final. -/
186:inductive Outcome (D : Type) [Ord D]
187:  | admitted (t : Turn D) (w' : World D)
188:  | recorded (v : Verdict D) (r : Refused D) (w' : World D)
189:  | declined (v : Verdict D)
190:
194:budget). -/
195:def judgeBy (X : Ctx D) (w : World D) (c : Call D) (auth : Verdict D → Bool) : Outcome D :=
196:  match submit X w c with
197:  | .ok (t, w') => .admitted t w'
198:  | .error v =>
199:      if v.isStale then .declined v else
211:`judge_eq`: the same Outcome as authenticating by `authenticated` (the two-verify judge). -/
212:def judge (X : Ctx D) (w : World D) (c : Call D) : Outcome D :=
213:  judgeBy X w c fun v => authenticatedBy X w c v.verified
214:
215:/-! ## Cancelling a call (KERNEL-60, design C1)
216:
228:/-- The cancel signature's domain: distinct from `domCall`, so a cancel is never a call signature. -/
229:def domCancel : ByteArray := "nanodregg/kernel/cancel-signature".toUTF8
230:
231:/-- What a cancel of `c` is a signature over: `domCancel`, then `c`'s transaction id's bytes. -/
232:def Ctx.cancelMessage (X : Ctx D) (c : Call D) : ByteArray := domCancel ++ X.env.bytes (txIdOf X c)
233:
234:/-- The record a cancel of `c` with signature `sig` makes. -/
235:def cancelOf (X : Ctx D) (c : Call D) (sig : ByteArray) : Refused D :=
236:  recordOf X c (.refused .cancelled) sig
237:
238:/-- A cancel's authority on `w`: the call names this World, the signature is non-empty and within
239:`cancelBytesMax`, and it verifies under the member's current key on `w`. -/
240:def cancelAuth (X : Ctx D) (w : World D) (c : Call D) (sig : ByteArray) : Except (Refusal D) Unit := do
241:  req (c.unsigned.world = w.origin) .wrongWorld
242:  req (decide (0 < sig.size ∧ sig.size ≤ Bounds.cancelBytesMax)) .badSignature
243:  match w.live X.env c.unsigned.member with
244:  | some m =>
254:`outsideWindow`, `replayed`, `refusedFinal`, `refusalBudget`, `refusalsFull`). -/
255:def cancel (X : Ctx D) (w : World D) (c : Call D) (sig : ByteArray) : Outcome D :=
256:  match cancelAuth X w c sig with
257:  | .error e => .declined (.refused e)
258:  | .ok () =>
259:      match World.refuse X.env w (cancelOf X c sig) with


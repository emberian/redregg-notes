113:variable {D : Type}
114:
115:theorem frameSize_pos (r : ByteArray) : 0 < frameSize r := by
116:  unfold frameSize; omega
117:
118:/-- Every entry of a coherent index begins before the durable end. -/
119:theorem Indexes.offset_lt {dc : Codec.Stream D} {s : Log.Sealer} {recordMax : Nat}
120:    {read : Nat → Nat → Id ByteArray} {tip : Nat × Nat} :
121:    ∀ (rest : List Entry) (e : Entry), Indexes dc s recordMax read (e :: rest) tip → e.offset < tip.1
122:  | [], e, h => by
123:    obtain ⟨r, ts, -, -, hn, -⟩ := h
124:    simp only at hn
125:    rw [hn]; exact Nat.lt_add_of_pos_right (frameSize_pos r)
126:  | e' :: rest, e, h => by
127:    obtain ⟨r, ts, -, -, hn, hr⟩ := h
133:/-- **The tooth of `Indexes`**: an index holding one entry twice in a row (two entries at one
134:record) is not coherent: the next entry must sit at its record's frame end, past it. -/
135:theorem Indexes.not_dup {dc : Codec.Stream D} {s : Log.Sealer} {recordMax : Nat}
136:    {read : Nat → Nat → Id ByteArray} {tip : Nat × Nat} (e : Entry) (rest : List Entry) :
137:    ¬ Indexes dc s recordMax read (e :: e :: rest) tip := by
138:  rintro ⟨r, ts, -, -, hn, -⟩
139:  simp only [Prod.mk.injEq] at hn
140:  have := frameSize_pos r
141:  omega

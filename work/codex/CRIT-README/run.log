564:/-- A frame written at `off`, after the 32 bytes it chains from, is what a page reads there. -/
565:theorem frameOf_frame {s : Sealer} {rm off : Nat} {S prev r : ByteArray}
566:    (hp : S.extract (off - tagBytes) (off - tagBytes + tagBytes) = prev)

143:/-- A suffix of a coherent index is coherent. -/
144:theorem Indexes.drop {dc : Codec.Stream D} {s : Log.Sealer} {recordMax : Nat}
145:    {read : Nat → Nat → Id ByteArray} {tip : Nat × Nat} :
146:    ∀ (k : Nat) (L : List Entry), Indexes dc s recordMax read L tip → Indexes dc s recordMax read (L.drop k) tip
147:  | 0, _, h => h
148:  | _ + 1, [], _ => trivial
149:  | k + 1, _ :: rest, h => by
150:    obtain ⟨_, _, _, _, _, hr⟩ := h
151:    exact Indexes.drop k rest hr

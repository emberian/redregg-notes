525:  have hf := frameSize_ge r
526:  unfold frameOf at h ⊢
527:  simp only [bind, pure] at h ⊢
528:  rw [← hS (off - tagBytes) (off - tagBytes + tagBytes) (by unfold tagBytes at hf ⊢; omega),

328:theorem run_agree_meaning {cap cap' fuel fuel' used used' : Nat} {t : Term} {env : Env} {v v' : Val}
329:    (h : run lib cap fuel 0 (State.init t env) = .value v used)
330:    (h' : run lib cap' fuel' 0 (State.init t env) = .value v' used') : v = v' := by
331:  have := bigStep_deterministic (run_bigStep h) (run_bigStep h')
332:  cases this; rfl

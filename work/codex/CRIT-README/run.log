340:    e.steps ≤ start := by
341:  simp only [locate, bind] at h
342:  split at h
343:  · simp only [pure] at h; cases h
344:  · rename_i e₀ hg
345:    exact locate_go_le get start _ _ _ e₀ (h0 e₀ hg) h

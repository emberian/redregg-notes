281:their bytes, concatenated in the call's order (digests are fixed-width, so the concatenation is unambiguous). -/
282:def occasionData : Occasion D → Data
283:  | .birth => .inj "birth" (.record [])
284:  | .write => .inj "write" (.record [])
285:  | .relaw ls => .inj "relaw" (.bytes (ls.foldl (fun acc l => acc ++ bytesOf l) .empty))
286:  | .adopt ls => .inj "adopt" (.bytes (ls.foldl (fun acc l => acc ++ bytesOf l) .empty))
290:byte value. -/
291:def occasionOk : Occasion D → Bool
292:  | .birth | .write => true
293:  | .relaw ls | .adopt ls => decide ((ls.foldl (fun acc l => acc ++ bytesOf l) .empty).size ≤ Bounds.bytesMax)
294:  | .invoke m => decide (m < Bounds.natLimit)

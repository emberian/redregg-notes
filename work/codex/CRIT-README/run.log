76:theorem Leads.bind {cap : Nat} {s : State} {k k' : List Frame} {d d' : Nat} {w : Val} {r : (Except Fault Val)}
77:    {n m : Nat} (h : Leads lib cap s k' d' (.ok w) n) (h2 : Leads lib cap ⟨.ret w, k', d'⟩ k d r m) :
78:    Leads lib cap s k d r (n + m) := by
79:  cases h with
80:  | ok h =>

613:/-- Two coherent runs, the second beginning where the first ends, are one coherent run. -/
614:theorem Indexes.append {D : Type} {dc : Codec.Stream D} {s : Sealer} {rm : Nat}
615:    {read : Nat → Nat → Id ByteArray} {tip : Nat × Nat} :
616:    ∀ (A B : List Entry) (p : Nat × Nat), Indexes dc s rm read A p → Indexes dc s rm read B tip →
617:      (match B with | [] => tip | e :: _ => (e.offset, e.steps)) = p →
618:      Indexes dc s rm read (A ++ B) tip
619:  | [], _, _, _, hB, _ => hB
620:  | [a], B, p, hA, hB, hp => by
621:    obtain ⟨r, ts, hr, hdec, hn, -⟩ := hA
622:    refine ⟨r, ts, hr, hdec, ?_, hB⟩
628:    exact ⟨r, ts, hr, hdec, hn, Indexes.append (a' :: A) B p hA' hB hp⟩

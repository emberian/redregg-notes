600:/-- **Coherence depends only on the bytes before the tip**: a coherent index over `S` is coherent
601:over any `S'` that agrees with `S` below the tip's offset. -/
602:theorem Indexes.congr {D : Type} {dc : Codec.Stream D} {s : Sealer} {rm : Nat} {S S' : ByteArray}
603:    {tip : Nat × Nat} (hS : ∀ i j, j ≤ tip.1 → S.extract i j = S'.extract i j) :
604:    ∀ L : List Entry, Indexes dc s rm (fun o l => (pure (S.extract o (o + l)) : Id ByteArray)) L tip →
605:      Indexes dc s rm (fun o l => (pure (S'.extract o (o + l)) : Id ByteArray)) L tip
606:  | [], _ => trivial
607:  | e :: rest, h => by
608:    obtain ⟨r, ts, hr, hdec, hn, hI⟩ := h

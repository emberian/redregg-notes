1:/-
2:# Lang.Proofs.Agree — the machine computes the reference semantics
3:
4:`Ends lib s o n`: the machine, from `s`, ends with `o` (a value, or the fault a step raised) after
5:`n` steps, the stack bound ignored. `run_bigStep`: a run that ends with a value computed the
6:term's meaning (`BigStep`, Lang.Proofs.BigStep). `run_fault_bigStep`: a run that ends with an
7:arithmetic fault (anything but `stuck`, `ticks`, `stack`) computed the term's meaning too. With
8:`bigStep_deterministic`, two runs of one term that both end with a value or an arithmetic fault end
9:with the same one, because the LANGUAGE gives the term one meaning (`run_agree_meaning`).
10:
11:The proof is a decomposition of machine runs: a run from `eval t env` on a stack `k` either ends in
12:a fault that is `t`'s meaning, or first returns `t`'s value `w` to `k` (`evalAgrees`); a run from a
13:`get ℓ` / `extend fs` frame first returns the selection's / extension's result (`selAgrees`,
14:`extAgrees`). By induction on the number of steps; a `stuck` ending is excluded (a checked program
15:never reaches it: `checked_never_stuck`).
16:-/
17:import Lang.Proofs.BigStep
18:
22:
23:inductive Ends (lib : List Term) : State → (Except Fault Val) → Nat → Prop
24:  | halt {s v} : step lib s = .halt v → Ends lib s (.ok v) 1
25:  | fault {s f} : step lib s = .fault f → Ends lib s (.error f) 1
26:  | next {s s' o n} : step lib s = .next s' → Ends lib s' o n → Ends lib s o (n + 1)
27:
28:theorem Ends.inv_next {s s' : State} {o : (Except Fault Val)} {n : Nat} (h : Ends lib s o n)
29:    (hs : step lib s = .next s') : ∃ n', n = n' + 1 ∧ Ends lib s' o n' := by
30:  cases h with
31:  | halt h => rw [hs] at h; cases h
32:  | fault h => rw [hs] at h; cases h
34:
35:theorem Ends.inv_fault {s : State} {f : Fault} {o : (Except Fault Val)} {n : Nat} (h : Ends lib s o n)
36:    (hs : step lib s = .fault f) : o = .error f := by
37:  cases h with
38:  | halt h => rw [hs] at h; cases h
39:  | fault h => rw [hs] at h; cases h; rfl
41:
42:theorem Ends.inv_halt {s : State} {v : Val} {o : (Except Fault Val)} {n : Nat} (h : Ends lib s o n)
43:    (hs : step lib s = .halt v) : o = .ok v := by
44:  cases h with
45:  | halt h => rw [hs] at h; cases h; rfl
46:  | fault h => rw [hs] at h; cases h
48:
49:theorem Ends.pos {s : State} {o : (Except Fault Val)} {n : Nat} (h : Ends lib s o n) : 0 < n := by
50:  cases h <;> omega

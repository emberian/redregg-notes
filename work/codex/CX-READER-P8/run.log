+  match genesis X Sim.worldName (Sim.nonceOf 8) 100000000
+      (fk.map fun (k, n) => (k, nextKeyDigest X n)) with
+  | .error e => note { st := { rng := ⟨1⟩, host := World.genesis X.env 0 0, members := [] } }

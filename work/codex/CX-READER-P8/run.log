  let spent := Receive.transfer X (pinned Sim.env r.st.host
    (Sim.S.pinsFor r.st.host [asset, accountId X a.id asset, cap]))
    ⟨obj, 0⟩ (.well asset) (.of a.id asset) 1 (some cap) none

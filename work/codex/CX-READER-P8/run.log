  r := note r' s!"P8.2 withdraw provider 0: {vr}" (vr == "admitted")
  let (_, stale, _) := go prog r oldPlan
  r := note r s!"P8.2 withdrawn instantiation: {stale}; live provenance {p8Available r.st.host supports}"

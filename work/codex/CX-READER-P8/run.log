import Lang.Journey
set_option maxHeartbeats 200000
open Nanodregg.Lang.Journey

def main (args : List String) : IO UInt32 := do
  let mode := args.headD "control"
  let src := match mode with
    | "deadline" => p8Text.replace "((<= req.validUntil state.closes) \"closed\")" ""
    | "support" => p8Text.replace "((deq v.pin s.pin) \"support0 moved\")" ""
    | "accepted" => p8Text.replace "((not state.accepted) \"accepted\")" ""
    | _ => p8Text
  let r := p8Session src
  for line in r.log do IO.println line
  IO.println s!"P8-{mode}: {if r.bad = 0 then "GREEN" else s!"RED ({r.bad})"}"
  return if r.bad = 0 then 0 else 1


/-
Alternative worlds for the contextual rule model (CARD P3).
A demonstration Mini can take, not a second kernel World or an admission path.
Default absence is tested against ONE proposed world. A reduct uses the landed
positive Rule/lfpIter machinery. Exhausted iteration is unfinished, never false.
-/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.Worlds

/-- A normal rule, with immutable external premise tokens. An absent atom is a
default test, not evidence for its explicit contrary. -/
structure NormalRule where
  head : Nat
  body : List Nat
  absent : List Nat
  supports : List Token
deriving DecidableEq, Repr

abbrev Program := List NormalRule
abbrev Alternative := List Nat

/-- Freeze default tests at the proposed world; only positive bodies remain. -/
def reduct {E : Type} (P : Program) (w : World E) (v : Alternative) : List Rule :=
  (P.filter fun r => r.supports.all w.live &&
    r.absent.all (fun a => !v.contains a)).map fun r => ⟨r.head, r.body⟩

/-- No external facts enter secretly: a fact is a rule with an empty body,
optionally backed by external premise tokens. -/
def ground (R : List Rule) (rounds : Nat) : Nat → Bool :=
  lfpIter R (fun _ => false) rounds

/-- Closure under every rule is checked, rather than inferred from the fuel. -/
def closed (R : List Rule) (v : Nat → Bool) : Bool :=
  R.all fun r => !(r.body.all v) || v r.head

/-- The finite universe of possible conclusions. Body-only atoms cannot be derived. -/
def heads (P : Program) : List Nat := (P.map NormalRule.head).eraseDups

def subsets : List Nat → List Alternative
  | [] => [[]]
  | a :: as => subsets as ++ (subsets as).map (a :: ·)

/-- None means the reduct has not stabilized. Some false is a completed rejection.
Comparison covers both directions and arbitrary proposed lists (order irrelevant). -/
def check {E : Type} (rounds : Nat) (P : Program) (w : World E)
    (v : Alternative) : Option Bool :=
  let R := reduct P w v
  let g := ground R rounds
  if closed R g then
    some (v.all g && (heads P).all (fun a => !g a || v.contains a))
  else none

/-- Complete finite search, retaining worlds separately. A pending reduct makes
the whole answer pending: a partially scanned list cannot justify absence. -/
def collect {E : Type} (rounds : Nat) (P : Program) (w : World E) :
    List Alternative → Option (List Alternative)
  | [] => some []
  | v :: vs => do
    let ok ← check rounds P w v
    let rest ← collect rounds P w vs
    pure (if ok then v :: rest else rest)

def analyze {E : Type} (rounds : Nat) (P : Program) (w : World E) :
    Option (List Alternative) :=
  collect rounds P w (subsets (heads P))

/-- The four requested distinctions plus the ordinary supported case and the
separate case of a completed search with no admissible world. A query names two
incompatible evidence atoms; it does not identify absence with explicit negation. -/
inductive Report where
  | noJustification
  | alternatives (left right : Alternative)
  | conflictingEvidence (proposed : Alternative)
  | unfinished
  | supported (worlds : List Alternative)
  | noWorld
deriving DecidableEq, Repr

/-- Diagnose a proposed evidence world and a pair of opposed observations.
Conflicting evidence is reported about the proposal, never asserted admissible.
Alternatives are witnesses from the completed admissible-world search. -/
def report {E : Type} (rounds : Nat) (P : Program) (w : World E)
    (positive negative : Nat) (proposed : Alternative) : Report :=
  match analyze rounds P w with
  | none => .unfinished
  | some worlds =>
    if proposed.contains positive && proposed.contains negative then .conflictingEvidence proposed
    else if worlds.isEmpty then .noWorld
    else
      match worlds.find? (·.contains positive), worlds.find? (·.contains negative) with
      | some left, some right =>
        if left == right then .conflictingEvidence left else .alternatives left right
      | none, none => .noJustification
      | _, _ => .supported worlds

/-- A real edit session, observing every revision including the initial one.
Rules and token identities are retained throughout. -/
def session {E : Type} (rounds : Nat) (P : Program) :
    List (Edit E) → World E → List (Option (List Alternative))
  | [], w => [analyze rounds P w]
  | e :: es, w => analyze rounds P w :: session rounds P es (e.apply w)

namespace Experiment

def pToken : Token := ⟨10, 0⟩
def qToken : Token := ⟨11, 0⟩
def initial : World Unit := ⟨fun t => t == pToken || t == qToken, ()⟩
def twoRules : Program :=
  [⟨0, [], [1], [pToken]⟩, ⟨1, [], [0], [qToken]⟩]
def withdrawn : World Unit := (Edit.withdraw pToken).apply initial
def neither : World Unit := (Edit.withdraw qToken).apply withdrawn
def both : Alternative := [0, 1]
def union (a b : Alternative) : Alternative := (a ++ b).eraseDups

def cycle : Program :=
  [⟨0, [], [], [pToken]⟩, ⟨1, [0], [], []⟩, ⟨1, [2], [], []⟩,
   ⟨2, [1], [], []⟩, ⟨5, [], [], [qToken]⟩, ⟨6, [5], [], []⟩]
def beforeCycle : Alternative := [0, 1, 2, 5, 6]
def afterCycle : Alternative := [5, 6]

end Experiment
end Nanodregg.Lang.Contextual.Worlds
/- P5: finite completion judgments, suspended negation, polarized transition systems.
A finite domain is part of the QUESTION, never inferred from the retained search list.
Refutation evidence is data; only judge checks it. Soundness is in Proofs/Contextual/P5. -/
import Lang.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.P5


/-- Four logical outcomes. Open always names at least one obligation. -/
inductive LogicalStatus (Witness Refutation Ob Reason : Type) where
  | witnessed (witness : Witness)
  | open (first : Ob) (rest : List Ob)
  | refuted (evidence : Refutation)
  | outsideThisProcedure (reason : Reason)
deriving DecidableEq, Repr

inductive Need where
  | searchRemaining
  | invalidRefutation
  | unfilled (atom : Nat)
  | admission
  | interaction (name : Nat)
  | gaveUp (name : Nat)
deriving DecidableEq, Repr

inductive Limit where
  | unsupportedFragment
  | budgetExhausted
deriving DecidableEq, Repr

structure Problem (A : Type) where
  domain : List A
  accepts : A → Bool

/-- An exclusion argument enumerates candidates, and the checker replays every exclusion. -/
structure Refutation (A : Type) where
  excluded : List A
deriving DecidableEq, Repr

variable {A : Type} [DecidableEq A]

def Problem.valid (p : Problem A) (a : A) : Bool :=
  decide (a ∈ p.domain) && p.accepts a

def checkRefutation (p : Problem A) (r : Refutation A) : Bool :=
  p.domain.all (fun a => decide (a ∈ r.excluded)) &&
    r.excluded.all (fun a => !p.accepts a)

/-- Supported retained search with an optional checked impossibility argument.
No certificate, or a bad certificate, leaves the completion question OPEN. -/
def judge (p : Problem A) (retained : List A) (certificate : Option (Refutation A))
    (limit : Option Limit := none) : LogicalStatus A (Refutation A) Need Limit :=
  match limit with
  | some why => .outsideThisProcedure why
  | none =>
    match retained.find? p.valid with
    | some a => .witnessed a
    | none =>
      match certificate with
      | none => .open .searchRemaining []
      | some r =>
        if checkRefutation p r then .refuted r else .open .invalidRefutation []

/-- Open Boolean syntax. A missing atom is a residual, including under negation.
Conjunction is strict: both judgments must finish; it performs no Boolean shortcut. -/
inductive Formula where
  | atom (name : Nat)
  | neg (body : Formula)
  | conj (left right : Formula)
deriving DecidableEq, Repr

inductive Evaluation where
  | value (b : Bool)
  | suspended (first : Nat) (rest : List Nat)
deriving DecidableEq, Repr

def Evaluation.neg : Evaluation → Evaluation
  | .value b => .value (!b)
  | .suspended n ns => .suspended n ns

def Evaluation.conj : Evaluation → Evaluation → Evaluation
  | .value a, .value b => .value (a && b)
  | .suspended n ns, .suspended m ms => .suspended n (ns ++ m :: ms)
  | .suspended n ns, .value _ => .suspended n ns
  | .value _, .suspended n ns => .suspended n ns

def evaluate (env : Nat → Option Bool) : Formula → Evaluation
  | .atom n => match env n with
    | some b => .value b
    | none => .suspended n []
  | .neg p => (evaluate env p).neg
  | .conj p q => (evaluate env p).conj (evaluate env q)

/-- Input-deterministic interface automata; outputs may be nondeterministic.
A receive is chosen by the peer (LANG-67 'theirs'); an emission by us ('ours').
No hidden/internal actions or fairness claim are included. -/
structure Machine (State Input Output : Type) where
  receive : State → Input → Option State
  emit : State → List (Output × State)

inductive Action (Input Output : Type) where
  | input (value : Input)
  | output (value : Output)
deriving DecidableEq, Repr

def Action.owner {I O : Type} : Action I O → Protocol.Polarity
  | .input _ => .theirs
  | .output _ => .ours

def receiveAll {S I O : Type} (m : Machine S I O) : S → List I → Option S
  | s, [] => some s
  | s, i :: is => (m.receive s i).bind (fun s' => receiveAll m s' is)

/-- Price receiver with a one-use input and a pending reply. -/
def priceReceiver (cap : Nat) (outputs : List Bool) : Machine Bool Nat Bool where
  receive s n := if s = false ∧ n ≤ cap then some true else none
  emit s := if s then outputs.map (fun b => (b, false)) else []

/-- A status session: each revision carries its question, retained search and certificate.
Keeping questions explicit prevents a refutation of yesterday's domain being reused today. -/
structure Request (A : Type) where
  problem : Problem A
  retained : List A
  certificate : Option (Refutation A)
  limit : Option Limit

def runSession (requests : List (Request A)) : List (LogicalStatus A (Refutation A) Need Limit) :=
  requests.map fun q => judge q.problem q.retained q.certificate q.limit

def statusSession : List (Request Nat) :=
  [⟨⟨[0, 1], fun n => n == 1⟩, [0], none, none⟩,
   ⟨⟨[0, 1], fun n => n == 1⟩, [0, 1], none, none⟩,
   ⟨⟨[0, 1], fun _ => false⟩, [0, 1], some ⟨[0, 1]⟩, none⟩,
   ⟨⟨[0, 1], fun _ => false⟩, [], none, some .unsupportedFragment⟩]

end Nanodregg.Lang.Contextual.P5


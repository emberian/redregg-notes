from pathlib import Path
import os, subprocess, sys
base=Path('/tank/dregg-build/nanodregg/wt/CX-P11a')
scratch=Path('/tank/dregg-build/nanodregg/logs/CX-P11a-plants')
scratch.mkdir(exist_ok=True)
source=(base/'Lang/Contextual/Games.lean').read_text()
probes="""
open Nanodregg.Lang.Contextual.P5
open Nanodregg.Lang.Contextual.P5.Games
theorem loop_control :
  judgeDraw loopMoves 0 [0] = .outsideThisProcedure (.drawn [0]) := by decide
theorem sink_tooth :
  judgeDraw (fun _ => []) 0 [0] = .open .invalidRefutation [] := by decide
theorem escape_tooth :
  judgeDraw (fun x => if x = 0 then [0, 1] else []) 0 [0] =
    .open .invalidRefutation [] := by decide
theorem root_tooth :
  judgeDraw (fun x => if x = 1 then [1] else []) 0 [1] =
    .open .invalidRefutation [] := by decide
"""
mutations=[
('Control',None,None),
('Root','region.contains root && region.all','(root == root) && region.all'),
('Sink','!(moves x).isEmpty && (moves x).all region.contains','(moves x).all region.contains'),
('Escape','!(moves x).isEmpty && (moves x).all region.contains','!(moves x).isEmpty')
]
env=os.environ.copy()
env['LEAN_PATH']=str(scratch)+':'+env.get('LEAN_PATH','')
ok=True
for name,before,after in mutations:
    stem='CX_P11a_'+name
    mutant=source
    if before:
        assert mutant.count(before)==1, (name,'mutation target count')
        mutant=mutant.replace(before,after)
    src=scratch/(stem+'.lean')
    src.write_text(mutant)
    probe=scratch/(stem+'Probe.lean')
    probe.write_text('import '+stem+'\n'+probes)
    log=scratch/(stem+'-run2.log')
    with log.open('w') as out:
        build=subprocess.run(['lake','env','lean','-DmaxHeartbeats=200000','-R',str(scratch),
          str(src),'-o',str(scratch/(stem+'.olean'))],cwd=base,env=env,
          stdout=out,stderr=subprocess.STDOUT)
        out.write('DEFINITION_EXIT='+str(build.returncode)+'\n')
        out.flush()
        check=subprocess.run(['lake','env','lean','-DmaxHeartbeats=200000','-R',str(scratch),str(probe)],
          cwd=base,env=env,stdout=out,stderr=subprocess.STDOUT) if build.returncode==0 else None
        out.write('PROBE_EXIT='+str(check.returncode if check else 'not-run')+'\n')
    print(name,log,flush=True)
    print(log.read_text(),flush=True)
    expected=0 if name=='Control' else 1
    ok &= build.returncode==0 and check is not None and check.returncode==expected
sys.exit(0 if ok else 1)


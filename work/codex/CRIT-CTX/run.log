255-/-- Emit the activity as an ordinary checked package. Additional application
256-methods/laws can be composed with its fields; the final package is checked by
257-the same install checker. Limits are the relation's normal kernel bounds.
258:With a declared `patience`, `retire` is `activityRetireMethod` (LANG-76): it also
259-abandons an unanswered activity at or past its deadline, by anyone. -/
260:def activityPackage (S : Ty) (cursor log : Label) (cursorLimit logLimit : Nat)
261-    (resumer : Term) (plans : List ActivityPlan)
262-    (extraRels : List (Label × RelDecl) := [])
263-    (guardNames : Option (Label × Label) := none) (names : ActivityVocabulary := {})
264:    (patience : Option Nat := none) : Package := Id.run do
265-  let cg := (guardNames.map (·.1)).getD (cursor ++ "_queued")
266-  let lg := (guardNames.map (·.2)).getD (log ++ "_waiting")
267-  let cd := activityCursor plans cursorLimit cg
268-  let ld := activityLog plans logLimit lg
269-  let rels := Row.sort ([(cursor, cd), (log, ld)] ++ extraRels)
270-  let E := editTy rels
271-  let reads := readsTy rels [(log, ⟨1, none, false, false⟩)]
272-  let empty := Ty.record []
273-  let mut fields : List (Label × Ty × Term) := [
274:    (cg, guardTy S cd, activityQueued S cd resumer names patience),
275:    (lg, guardTy S ld, activityWaiting S plans ld resumer names patience)]
276-  let mut methods : List Label := []
277-  for p in plans do
278-    let startName := "start_" ++ p.name
279-    let resumeName := "resume_" ++ p.name
280-    fields := fields ++ [
281-      (startName, methodTy S p.captured [] empty E 2,
282-        activityStartMethod S rels cursor log cd ld plans p),
283-      (resumeName, methodTy S (activityResumeArg p) [] reads E 2,
284-        activityResumeMethod S rels cursor log cd ld resumer plans p)]
285-    methods := methods ++ [startName, resumeName]
286:  -- with a patience the abandon must take the cursor row too; without one an unanswered row is
287-  -- never retired, so the one-edit form is the whole method
288:  let cur := patience.map fun _ => (cursor, cd)
289-  fields := fields ++ [("retire", activityRetireTy S rels ld log cur, activityRetireMethod S rels log ld cur)]
290-  methods := methods ++ ["retire"]
291-  let sortedFields := Row.sort fields
292-  let pkg : Package := {
293-    imports := [], state := S,
294-    iface := .record (sortedFields.map fun (l, T, _) => (l, T)),
295-    body := .record (sortedFields.map fun (l, _, t) => (l, t)),
296-    methods := (Row.sort (methods.map (·, ()))).map (·.1), laws := [], rels }
297-  return pkg

116:/-- Who may retract a cursor row: the resumer; with a declared patience, also anyone at or after
117-the row's deadline (LANG-76: `timeout` retracts the cursor row beside the log row). Under the
118-retract arm's binder: payload=0, request=2, state=3. -/
119:def activityDequeue (patience : Option Nat) (resumer : Term) (names : ActivityVocabulary) : Term :=
120-  let byResumer := guard (activityApply resumer [.var 3, .var 2]) names.notResumer okT

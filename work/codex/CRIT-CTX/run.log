307-  match checkE [] resumer (.fn S (.fn reqTy .bool)) (Ω := []) with
308-  | .error why => throw (.package (.illTyped why))
309-  | .ok () => pure ()
310-  for p in plans do
311-    for (t, T) in [
312-      (p.precondition, Ty.fn S (.fn p.captured (.fn reqTy .bool))),
313-      (p.start, Ty.fn S (.fn p.captured (.fn reqTy S))),
314-      (p.resume, Ty.fn S (.fn p.captured (.fn p.response (.fn reqTy S))))] do
315-      match checkE [] t T (Ω := []) with
316-      | .error why => throw (.package (.illTyped why))
317-      | .ok () => pure ()
318:  let pkg := activityPackage S cursor log cursorLimit logLimit resumer plans (patience := patience)
319-  match pkg.checkWith [] with
320-  | .error why => throw (.package why)

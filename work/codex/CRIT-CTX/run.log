72-/-- An activity's deadline has come (LANG-76): the call's signed `notBefore` is at least the row's
73:own key `notBefore` plus the declared `patience`, in heights. A Turn lands at a height in its signed
74-window `[notBefore, validUntil]` (KERNEL-10, `World.admit`), so a call that meets this lands at or
75-after the deadline; as `windowed`, no clock holder is read. A key's `notBefore` is the starter's
76-signed one, at most the kernel's window below the height its start landed at, so the deadline falls
77:between `patience - window` and `patience` heights after the start landed. The sum faults past
78-`natLimit`, and a fault is a refusal. -/
79:def activityDue (patience : Nat) (key req : Term) : Term :=
80:  .prim .le (.prim .add (.get key "notBefore") (natT patience)) (.get req "notBefore")
81-
82-/-- What the log guard does with a retraction of an UNANSWERED row (LANG-76). With no declared
83:patience it refuses `unanswered`, always: the row waits for its resumer. With `some p` it refuses
84-`unanswered` before the deadline and admits at or after it, whoever retracts (the abandon of an
85-activity whose resumer was silent, or whose resume ran out of ticks). -/
86-def activityLate : Option Nat → Term → Term → Term
87-  | none, _, _ => refusedT "unanswered"
88-  | some p, key, req => guard (activityDue p key req) "unanswered" okT
89-
90-/-- Row guard for an activity log. Its old row is read by the kernel at the
91-edited key; capture and plan cannot change when the row is answered. An
92-unanswered row is retracted only past its deadline (`activityLate`). -/
93-def activityWaiting (S : Ty) (plans : List ActivityPlan) (d : RelDecl) (resumer : Term) (names : ActivityVocabulary := {})
94:    (patience : Option Nat := none) : Term :=
95-  let f (i : Nat) (l : Label) := Term.get (.var i) l
96-  let key (i : Nat) := Term.get (f i "key") "agent"
97-  let val (i : Nat) (l : Label) := Term.get (f i "val") l
98-  .lam S (.lam reqTy (.lam (guardInTy d)
99-    (.case (f 0 "edit") [
100-      ("insert", guard (.prim .deq (key 0) (f 2 "agent")) "notYours"
101-        (.case (val 0 "answered") [("none", okT), ("some", refusedT "answered")])),
102-      ("retract", .case (f 1 "old") [
103-        ("none", refusedT names.unstarted),
104-        -- under the old row's and its `none` answer's binders: payload=2, request=4
105:        ("some", .case (f 0 "answered") [("none", activityLate patience (f 2 "key") (.var 4)), ("some", okT)])]),
106-      ("upsert", guard (activityApply resumer [.var 3, .var 2]) names.notResumer
107-        (.case (f 1 "old") [
108-          ("none", refusedT names.unstarted),
109-          ("some", .case (f 0 "answered") [
110-            ("none", guard (eqData (activityCaptured plans) (val 2 "captured") (f 1 "captured")) names.captured
111-              (.case (val 2 "answered") [
112-                ("none", refusedT "unanswered"),
113-                ("some", guard (activitySamePlan plans (val 3 "captured") (.var 0)) "plan" okT)])),
114-            ("some", refusedT "answered")])]))])))

/-
# Spec.Proofs.Claims — what nanodregg is FOR, as predicates on a `System`

The top-level statements (redregg/work/promo/TOPLEVEL-SPEC.md §2–§8), each a `Prop` over the
record of deployed entry points (`Spec.System`). `Spec.Proofs.Floor` refutes each one on a trivial
system and inhabits it with a deployed run; that is the tree's whole vacuity obligation: a lemma
under a top theorem carries meaning only through the claim it proves, whatever its own shape.
`Spec.Proofs.Deployed` proves `Claim (deployed d)` where the composition exists.

Premises that are true of the deployed system only under an assumption the system does not yet
discharge are PARAMETERS of the claim, named (a relay, a restriction to `NoRef` laws), never hidden
in a definition. Removing one is a strengthening the checker sees.

This module lives under `Proofs` because a claim is a statement (closure C3); it defines no
function.
-/
import Spec.System
import Kernel.Proofs.Rederive
import Kernel.Proofs.Fold
import Kernel.Proofs.Cells
import Kernel.Proofs.Logic.History
import Kernel.Proofs.WriteNext
import Lang.Proofs.Chain
import Lang.Proofs.Receiver
import Protocol.Proofs.Behind

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol

variable {D : Type} [Ord D] [DecidableEq D]

/-! ## The vocabulary -/

/-- Every step of the log is the system's own decision of its own event on the World before it: a
Turn is what `receive` derives from the call its event decodes to, a refusal is what `recordedBy`
records for it. (`Receive.Honest`, with the kernel a parameter.) -/
def Decided (S : System D) : World D → List (Step D) → Prop
  | _, [] => True
  | w, .turn t :: rest => ∃ c, S.X.decodeCall t.event = some c ∧ S.receive w c = .ok t ∧
      ∀ w', S.admit w t = .ok w' → Decided S w' rest
  | w, .refusal r :: rest => ∃ c v w₁, S.X.decodeCall r.event = some c ∧
      S.recordedBy w c r = .recorded v r w₁ ∧ ∀ w', S.refuse w r = .ok w' → Decided S w' rest

/-- An audited log: it folds under the system's kernel to `w'`, and every step is the kernel's
own decision. -/
def Audited (S : System D) (w : World D) (l : List (Step D)) (w' : World D) : Prop :=
  S.fold w l = .ok w' ∧ Decided S w l

/-- A World a member's follower may start from: a genesis World (built by the kernel from the
signed inputs), or a base whose bytes hash to the pin of an invitation that the sponsor key the
member trusts signed, for the member's own World (thin consent: the history before the pin is the
sponsor's word, PROTOCOL-14). -/
inductive Start (S : System D) (me : Command.Self D) (trusted : ByteArray) : World D → Prop
  | genesis (name nonce : ByteArray) (allowance : Nat) (founders : List (ByteArray × D))
      (auth : Authority) : Start S me trusted (genesisWorld S.X name nonce allowance founders auth)
  | pinned {inv : ByteArray} {i : Invite.Invitation D} {w : World D} :
      Command.adoptPin S.X me inv trusted = .ok i →
      S.B.digest (S.B.world.bytes w) = i.pin.digest → S.B.stepsOf w = i.pin.steps →
      w.origin = me.world → Start S me trusted w

/-- The relay assumption the deployed follower needs today: every continuation the relay hands
follow that parses as `adopt INVITE KEY` names the sponsor key the member trusts. (The continuation
is client-held bytes; under an arbitrary relay a forged `adopt` names the forger's key, and the pin
it signs is any World. TOPLEVEL-SPEC §11.2 removes this premise by keeping the command's state
inside follow.) -/
def keyFaithful (S : System D) (trusted kb : ByteArray) : Prop :=
  ∀ st inv key, Command.State.ofBytes kb = some st →
    Command.parse S.X.digestOf st.argv = .ok (Command.Cmd.adopt inv key) → key = trusted

/-- One frame of the member's follower, from a World to a World: any memory, any result the
Host returns, and any continuation the relay allows. -/
def Moves (S : System D) (relay : ByteArray → ByteArray → Prop) (me : Command.Self D)
    (trusted : ByteArray) (w w' : World D) : Prop :=
  ∃ (f f' : Command.Follow D) (kb res : ByteArray) (p : Command.Persist D) (r : Command.Reply),
    relay trusted kb ∧ f.world = w ∧ S.follow me f kb res = (f', p, r) ∧ f'.world = w'

/-- Any number of frames (any interleaving of the member's commands). -/
inductive Reach (S : System D) (relay : ByteArray → ByteArray → Prop) (me : Command.Self D)
    (trusted : ByteArray) : World D → World D → Prop
  | refl (w : World D) : Reach S relay me trusted w w
  | tail {w w₁ w₂ : World D} : Reach S relay me trusted w w₁ → Moves S relay me trusted w₁ w₂ →
      Reach S relay me trusted w w₂

/-! ## §2 ONE HISTORY (the apex, with §3) -/

/-- **A1. The member's World is an audited fold from a start.** Whatever frames follow is fed —
any Host replies, any continuation the relay allows, any interleaving of the member's commands —
the World it holds is an audited log's fold from a start (`∃ w₁`: an adopt replaces a World that
holds nothing by a pinned base, a new start). -/
def OneHistory.member (S : System D) (relay : ByteArray → ByteArray → Prop) : Prop :=
  ∀ (me : Command.Self D) (trusted : ByteArray) (w₀ w : World D), Start S me trusted w₀ →
    Reach S relay me trusted w₀ w → ∃ w₁ l, Start S me trusted w₁ ∧ Audited S w₁ l w

/-- **A2. Two logs the kernel folds from one World, agreeing on step count and chain, reach one
World**, or the hash collides among the two folds' link inputs. (Any folds, audited or not: the
chain binds what was folded, whoever decided it.) -/
def OneHistory.pair (S : System D) : Prop :=
  ∀ {g wf wg : World D} {lf lg : List (Step D)}, S.fold g lf = .ok wf → S.fold g lg = .ok wg →
    wf.steps = wg.steps → wf.chain = wg.chain →
      wf = wg ∨ CollidesAmong S.X.env.hash (foldPres S.X.env g lf ++ foldPres S.X.env g lg)

/-! ## §3 INTEGRITY — what "the kernel's own decision" means -/

/-- **B2. Value.** Along any log the kernel folds (audited or not: conservation does not depend on
authority), every denomination's balance sum is unchanged, and so is its floor sum unless a Turn
of the log created the denomination's well. -/
def Integrity.value (S : System D) : Prop :=
  ∀ {w w' : World D} {l : List (Step D)}, w.Canon S.X.env → S.fold w l = .ok w' → ∀ d,
    w'.valueSum d = w.valueSum d ∧
      ((∀ t ∈ Step.turns l, d ∉ (createdIds t).map S.X.env.bytes) → w'.floorSum d = w.floorSum d)

/-- **B3. Law (what an object's author is promised), for `NoRef` laws.** Along an audited log, an
object live at the start has a history of judged steps (`ObjectHistory`), its package never
changes, and EVERY history of it between the two Worlds in whose judged steps a `NoRef` law `t` of
its package is in force is a chain of steps the law's reference meaning admits (`Std.Step [] t`,
the `BigStep` semantics), each paired with the request that made it. Every history, not some: a
judged step carries the view of the call that made it, and a step of another call reaching the same
World with a view that lacks the law makes "some history" vacuous; excluding it is a collision over
an unbounded preimage set, so the existential form (SPEC-2) had no floor against a kernel no law
judges (`floor_integrity_lawChain`). The restriction to `NoRef` is the premise TOPLEVEL-SPEC §11.6
removes. -/
def Integrity.law (S : System D) : Prop :=
  ∀ {obj law : D} {p : Lang.Package} {fs : List (Lang.Label × Lang.Term)} {ℓ : Lang.Label}
    {t : Lang.Term}, p.body = .record fs → ℓ ∈ p.laws → Lang.Row.find? ℓ fs = some t →
    Lang.IsLaw t → Lang.NoRef t →
    ∀ {w w' : World D} {l : List (Step D)}, Audited S w l w' → CellsCanon S.X.env w →
    ∀ {cell : Cell}, w.live S.X.env obj = some cell → cell.kind = kindObject →
      (∃ tr, ObjectHistory S.X obj w w' tr) ∧
        (∃ cell', w'.live S.X.env obj = some cell' ∧ packageOf S.X obj cell' = packageOf S.X obj cell) ∧
        ∀ tr, ObjectHistory S.X obj w w' tr →
          (∀ e ∈ tr, law ∈ e.2.1.toList ++ e.2.2.1 ∧ Lang.readPackage e.1 law = .ok p) →
          ∀ {o : Lang.Data}, Lang.readState S.X.digestOf (Lang.recordRow p.state) (stateOf cell) = .ok o →
            ∃ steps, Lang.Std.Chain (Lang.Std.Step [] t) o steps ∧
              tr.map (fun e => (Lang.reqData S.X.env.bytes e.2.2.2.1,
                Lang.readState S.X.digestOf (Lang.recordRow p.state) e.2.2.2.2.2.1)) =
                steps.map (fun s => (s.1, .ok s.2))

/-! ## §4 CONSENT AND SETTLEMENT — what a member is promised of its own follower -/

/-- **C(ii), submit-class. `ok` means committed.** A follow step that ends a command `done ok` at
the settle phase (4) means follow's own World journals the call the continuation carries. -/
def Consent.okCommitted (S : System D) : Prop :=
  ∀ (me : Command.Self D) (f f' : Command.Follow D) (kb res o e : ByteArray) (p : Command.Persist D)
    (argv acc : List ByteArray), Command.State.ofBytes kb = some ⟨argv, 4, acc⟩ →
    S.follow me f kb res = (f', p, .done CommandExit.ok.code.toUInt8 o e) →
    ∃ cb c hh td, acc.getLast? = some cb ∧ S.X.decodeCall cb = some c ∧
      f.world.journalAt S.X.env (txIdOf S.X c) = some (hh, td)

/-- **C(iii). Final is final.** A settlement follow prints as `expired`, or `refused` by a name
other than `stale`, is never contradicted: on no extension of the log does the writer admit the
call. (`refused stale` is final only for the member's own planned call and up to a collision:
`staleBehind_final`, a separate claim.) -/
def Consent.final (S : System D) : Prop :=
  ∀ (me : Command.Self D) {w w' : World D} (c : Call D) {l : List (Step D)},
    w.RefusalsCanon S.X.env → w.JournalCanon S.X.env →
    (S.settle me w c = .expired ∨ ∃ code, code ≠ staleCode ∧ S.settle me w c = .refused code) →
    S.fold w l = .ok w' → ∀ out, S.submit w' c ≠ .ok out

/-- **C(ii), cancel. `ok` means cancelled on the member's own World.** A follow step of a
`cancel CALL` command that ends `done ok` leaves follow at a World whose settlement of the call is
`refused cancelled`: the writer's word that it recorded the cancel is never enough (collation A7). -/
def Consent.cancelOk (S : System D) : Prop :=
  ∀ (me : Command.Self D) (f f' : Command.Follow D) (kb res o e : ByteArray) (p : Command.Persist D)
    (st : Command.State) (cb : ByteArray), Command.State.ofBytes kb = some st →
    Command.parse S.X.digestOf st.argv = .ok (Command.Cmd.cancel cb) →
    S.follow me f kb res = (f', p, .done CommandExit.ok.code.toUInt8 o e) →
    ∃ c, S.X.decodeCall cb = some c ∧ S.settle me f'.world c = .refused (Command.cancelledCode (D := D))

/-- **C(iii), stale. `refused stale` is final for the member's own call.** A call the member's
follower planned at a World `w₀` of its fold (`signedReads`, `plan`), that a later World `w` of the
fold settles `refused stale`, is admitted by no `submit` at any World the fold reaches from `w` —
or the hash collides among the call's pin inputs at `w₀` and there (`behindPres`, an explicit list). -/
def Consent.staleFinal (S : System D) : Prop :=
  ∀ (me : Command.Self D) {w₀ w w' : World D} {l₁ l₂ : List (Step D)} {key : ByteArray}
    {cmd : Command.Cmd D} {rs : Command.SignedReads D} {b : Body D} {u : Unsigned D} (c : Call D),
    w₀.CellsFit Codec.Kernel.Cell.Fits S.X.env → w₀.RowsCanon S.X.env → w₀.RowsOk S.X.env →
    Command.signedReads S.X w₀ cmd = .ok rs → Command.plan S.X me w₀ key rs b = .ok u → c.unsigned = u →
    w.RefusalsCanon S.X.env → w.JournalCanon S.X.env →
    S.fold w₀ l₁ = .ok w → S.fold w l₂ = .ok w' → S.settle me w c = .refused staleCode →
    (∀ out, S.submit w' c ≠ .ok out) ∨ CollidesAmong S.X.env.hash (Command.behindPres S.X.env w₀ w' u)

/-! ## §8 WHAT A NON-MEMBER IS SHOWN -/

/-- **G2. Nothing of the log is shown past a failed envelope.** The writer defers a frame (answers
it with a page of the log or of a base) only when its payload is an envelope `Envelope.check`
passes on the writer's World: this World, a window inside the bound, the member's current key,
a verifying signature, a live follow grant chain, the height inside the window. The conclusion
names what a reader is: the envelope's follow grant chain is live to a founder's root in the
writer's World (`mayFollow`: revoking any link revokes the page), its key is the member's current
key there, and the member's signature under that key verifies over the envelope's message. -/
def Shown.onlyFollowers (S : System D) : Prop :=
  ∀ (w : World D) (f : Host.Frame) (d : Host.Deferred), S.handle w f = .defer d →
    ∃ e, Envelope.ofBytes S.X f.payload = some e ∧ Envelope.check S.X w e = .ok () ∧
      mayFollow S.X w e.member e.grant = true ∧ currentKey S.X.env w e.member = some e.key ∧
      S.X.verify e.key (Envelope.message S.X e.world e.member e.grant e.start e.notBefore e.validUntil)
        e.signature = true

end Nanodregg.Spec
/-
# Spec.Proofs.Law — B3's law-chain floor; B3 and C(ii)'s cancel inhabited

TOPLEVEL-SPEC §3.3. The claim `Integrity.law` (Claims: along an audited log an object's package never
changes and EVERY history of it in which a `NoRef` law is in force is a chain the law's reference
meaning admits) is proved of the deployed system by `top_integrity_law` (Deployed); its package
clause is refused by the raw writer (`floor_integrity_law`, Floor). This module:

* **Floor** `floor_integrity_lawChain`: the unjudged kernel (`Spec.Sim.Law.unjudged`, the program's
  `judge` admitting every step). The founder installs `Std.boundedPackage {n : nat} n 5` (the stdlib
  law `bounded`, `NoRef`), creates a data object under it with `n = 0` (re-derived from genesis by THE
  re-deriver), and writes `n := 9`, which the kernel refuses `lawDenied` and the unjudged kernel
  derives and admits. The write's own one-step history has the law in force, and `bounded_spec`
  admits no step to `n = 9`.
* **Inhabited** `inhabited_law`: on that object the deployed kernel derives and admits `n := 3`, a
  one-step history whose one judged step moves the state, the law in force in its view.
* **Inhabited** `inhabited_cancelOk` (C(ii), cancel): follow at the World holding the founder's
  recorded cancel steps the writer's tip page of `cancel CALL` and ends `done ok`.

Owed: the `NoRef` restriction (§11.6).
-/
import Spec.Proofs.Floor
import Spec.Sim.Law
import Lang.Proofs.Std
import Lang.Proofs.Receiver

namespace Nanodregg.Spec

open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Protocol Nanodregg.Codec

/-! ## The law's premises -/

theorem lPkg_body : lPkg.body = .record lFields := rfl
theorem lPkg_laws : "bounded" ∈ lPkg.laws := by simp [lPkg, Lang.Std.boundedPackage, Lang.Std.boundedPackageWith]
theorem lFields_find : Lang.Row.find? "bounded" lFields = some lLaw := by simp [lFields, Lang.Row.find?]
theorem lLaw_isLaw : Lang.IsLaw lLaw := Lang.isLaw_lawOf
theorem lLaw_noRef : Lang.NoRef lLaw := Lang.noRef_bounded _ _ _

/-- A write's request names its occasion `write`, a change. -/
theorem reqOf_write_occasion {X : Ctx Digest} {u : Unsigned Digest} {obj principal : Digest} :
    (Lang.reqData X.env.bytes (reqOf u obj principal .write)).field "occasion" =
      some (.inj "write" (.record [])) := by
  simp [Lang.reqData, Lang.Data.field, Lang.Row.find?, reqOf, Lang.occasionData]

/-! ## §3 INTEGRITY (B3), inhabited: a law judges a step -/

/-- **The judged run**: THE re-deriver accepts the install and the create from genesis; the object is
live, its state reads, the package's id is among its laws and reads as the package in the write's
view; the kernel derives the write `n := 3` (it passed `bounded`), which reads back as its event and
admits, and moves the state. -/
theorem run_law_judged :
    (match rederiveLog Xd wGenesis lLog with
     | .ok w =>
       match w.live Xd.env lObj with
       | some cell => decide (cell.kind = kindObject) &&
          (match Lang.readState Xd.digestOf (Lang.recordRow lPkg.state) (stateOf cell) with
           | .ok _ => true | .error _ => false) &&
          (match lawsOf Xd lObj cell with | .ok ls => decide (lId ∈ ls) | .error _ => false) &&
          (match Lang.readPackage (pinned Xd.env w (lWrite 3).unsigned.pins) lId with
           | .ok q => decide (q = lPkg) | .error _ => false) &&
          decide (applyEdits (stateOf cell) [(0, some (natBytes 3))] ≠ stateOf cell) &&
          match receive Xd w (lWrite 3) with
          | .ok t => decide (Xd.decodeCall t.event = some (lWrite 3)) &&
              (match World.admit Xd.env w t with | .ok _ => true | .error _ => false)
          | .error _ => false
       | none => false
     | .error _ => false) = true := by
  native_decide

/-- **INHABITED (B3).** From a genesis World, an audited log installs a `NoRef` law package and
creates a data object under it; on from there, an audited one-step log whose `ObjectHistory` has one
judged step, which moves the state, with the law in force in its view: the claim's chain clause
has a non-empty history to speak of. -/
theorem inhabited_law (d : ByteArray → ByteArray) (trusted : ByteArray) :
    ∃ (me : Command.Self Digest) (g w w' : World Digest) (l₀ l : List (Step Digest)) (obj law : Digest)
      (p : Lang.Package) (fs : List (Lang.Label × Lang.Term)) (ℓ : Lang.Label) (t : Lang.Term) (cell : Cell)
      (o : Lang.Data) (tr : List (Pinned Digest × Option Digest × List Digest × Req Digest × Slots × Slots ×
        List (Body Digest))),
      Start (deployed d) me trusted g ∧ Audited (deployed d) g l₀ w ∧
      p.body = .record fs ∧ ℓ ∈ p.laws ∧ Lang.Row.find? ℓ fs = some t ∧ Lang.IsLaw t ∧ Lang.NoRef t ∧
      Audited (deployed d) w l w' ∧ CellsCanon Xd.env w ∧ w.live Xd.env obj = some cell ∧
      cell.kind = kindObject ∧ Lang.readState Xd.digestOf (Lang.recordRow p.state) (stateOf cell) = .ok o ∧
      ObjectHistory Xd obj w w' tr ∧ tr ≠ [] ∧
      (∀ e ∈ tr, law ∈ e.2.1.toList ++ e.2.2.1 ∧ Lang.readPackage e.1 law = .ok p) ∧
      ∃ e ∈ tr, e.2.2.2.2.2.1 ≠ e.2.2.2.2.1 := by
  have hr := run_law_judged
  cases ho : rederiveLog Xd wGenesis lLog with
  | error e => rw [ho] at hr; cases hr
  | ok w =>
  rw [ho] at hr
  dsimp only at hr
  have hcan : CellsCanon Xd.env w := by
    have hs := (rederiveLog_sound ho).1
    unfold wGenesis at hs
    exact fold_cellsCanon (genesis_cellsCanon Xd _ _ _ _ _) hs
  have hfh := rederiveLog_sound ho
  have hst : Start (deployed d) sMe trusted wGenesis := .genesis _ _ _ _ _
  have hb : (lWrite 3).unsigned.body = .write lObj [(0, some (natBytes 3))] none := rfl
  revert hst
  revert hfh
  revert hr
  revert hb
  generalize lWrite 3 = c
  generalize natBytes 3 = v
  generalize lObj = obj
  generalize lId = lid
  generalize wGenesis = g
  generalize lLog = l₀
  generalize sMe = me
  intro hb hr hfh hst
  cases hl : w.live Xd.env obj with
  | none => rw [hl] at hr; cases hr
  | some cell =>
  rw [hl] at hr
  dsimp only at hr
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hr
  obtain ⟨⟨⟨⟨⟨hk, hro⟩, hlaws⟩, hpk⟩, hne⟩, hr⟩ := hr
  cases hs : Lang.readState Xd.digestOf (Lang.recordRow lPkg.state) (stateOf cell) with
  | error e => rw [hs] at hro; cases hro
  | ok o =>
  cases hL : lawsOf Xd obj cell with
  | error e => rw [hL] at hlaws; cases hlaws
  | ok ls =>
  rw [hL] at hlaws
  have hmem : lid ∈ ls := of_decide_eq_true hlaws
  cases hP : Lang.readPackage (pinned Xd.env w c.unsigned.pins) lid with
  | error e => rw [hP] at hpk; cases hpk
  | ok q =>
  rw [hP] at hpk
  have hq : q = lPkg := of_decide_eq_true hpk
  subst hq
  cases htw : receive Xd w c with
  | error e => rw [htw] at hr; cases hr
  | ok tw =>
  rw [htw] at hr
  dsimp only at hr
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hr
  obtain ⟨hd, hr⟩ := hr
  cases ha : World.admit Xd.env w tw with
  | error e => rw [ha] at hr; cases hr
  | ok w₂ =>
  obtain ⟨principal, laws, -, hau, hlw, -⟩ := write_next_slots htw ha hb hl (hcan _ _ hl)
  rw [hL] at hlw
  cases hlw
  have htr : ObjectHistory Xd obj w w₂ _ := .cons (.write htw ha hb hl (hcan _ _ hl) hau hL) (.nil w₂)
  have hsa : (deployed d).admit w tw = .ok w₂ := ha
  have haud : Audited (deployed d) w [.turn tw] w₂ :=
    ⟨by simp only [System.fold, System.step, hsa], ⟨c, hd, htw, fun _ _ => trivial⟩⟩
  refine ⟨me, g, w, w₂, l₀, [.turn tw], obj, lid, lPkg, lFields, "bounded", lLaw, cell, o, _, hst,
    audited_deployed.mpr hfh, lPkg_body, lPkg_laws, lFields_find, lLaw_isLaw, lLaw_noRef, haud, hcan, hl,
    hk, hs, htr, by simp, ?_, ⟨(pinned Xd.env w c.unsigned.pins, none, ls,
      reqOf c.unsigned obj principal .write, stateOf cell, applyEdits (stateOf cell) [(0, some v)], []), by simp, hne⟩⟩
  intro e he
  simp only [Option.toList_some, List.append_nil, List.mem_singleton] at he
  subst he
  exact ⟨by simpa using hmem, hP⟩

/-! ## §3 INTEGRITY (B3): the kernel no law judges -/

/-- **The unjudged run**: at the World of the judged run, the write `n := 9` (which the kernel
refuses `lawDenied`) is derived by the unjudged kernel, reads back as its event and admits; the
package is in force in its view; its new state reads with `n` above the bound. -/
theorem run_law_unjudged :
    (match rederiveLog Xd wGenesis lLog with
     | .ok w =>
       match w.live Xd.env lObj with
       | some cell => decide (cell.kind = kindObject) &&
          (match Lang.readState Xd.digestOf (Lang.recordRow lPkg.state) (stateOf cell) with
           | .ok _ => true | .error _ => false) &&
          (match Lang.readState Xd.digestOf (Lang.recordRow lPkg.state)
              (applyEdits (stateOf cell) [(0, some (natBytes 9))]) with
           | .ok dd => (match dd.field "n" with | some (.nat m) => decide (5 < m) | _ => false)
           | .error _ => false) &&
          (match lawsOf Xu lObj cell with | .ok ls => decide (lId ∈ ls) | .error _ => false) &&
          (match Lang.readPackage (pinned Xd.env w (lWrite 9).unsigned.pins) lId with
           | .ok q => decide (q = lPkg) | .error _ => false) &&
          match receive Xu w (lWrite 9) with
          | .ok t => decide (Xd.decodeCall t.event = some (lWrite 9)) &&
              (match World.admit Xd.env w t with | .ok _ => true | .error _ => false)
          | .error _ => false
       | none => false
     | .error _ => false) = true := by
  native_decide

/-- **FLOOR (B3, the law chain).** The claim refuses the kernel no law judges: from a canonical
World an audited one-step log writes `n := 9` to an object under `bounded n 5`; the write is a
history of the object with the law in force, and no `Std.Step` of `bounded` reaches `n = 9`
(`bounded_spec`). -/
theorem floor_integrity_lawChain (d : ByteArray → ByteArray) : ¬ Integrity.law (unjudged d) := by
  intro h
  have hr := run_law_unjudged
  cases ho : rederiveLog Xd wGenesis lLog with
  | error e => rw [ho] at hr; cases hr
  | ok w =>
  rw [ho] at hr
  dsimp only at hr
  have hcan : CellsCanon Xd.env w := by
    have hs := (rederiveLog_sound ho).1
    unfold wGenesis at hs
    exact fold_cellsCanon (genesis_cellsCanon Xd _ _ _ _ _) hs
  have hb : (lWrite 9).unsigned.body = .write lObj [(0, some (natBytes 9))] none := rfl
  revert hr
  revert hb
  generalize lWrite 9 = c
  generalize natBytes 9 = v
  generalize lObj = obj
  generalize lId = lid
  intro hb hr
  cases hl : w.live Xd.env obj with
  | none => rw [hl] at hr; cases hr
  | some cell =>
  rw [hl] at hr
  dsimp only at hr
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hr
  obtain ⟨⟨⟨⟨⟨hk, hro⟩, hrn⟩, hlaws⟩, hpk⟩, hr⟩ := hr
  cases hs : Lang.readState Xd.digestOf (Lang.recordRow lPkg.state) (stateOf cell) with
  | error e => rw [hs] at hro; cases hro
  | ok o =>
  cases hn : Lang.readState Xd.digestOf (Lang.recordRow lPkg.state) (applyEdits (stateOf cell) [(0, some v)]) with
  | error e => rw [hn] at hrn; cases hrn
  | ok dd =>
  rw [hn] at hrn
  dsimp only at hrn
  cases hf : dd.field "n" with
  | none => rw [hf] at hrn; cases hrn
  | some x =>
  rw [hf] at hrn
  cases x
  all_goals dsimp only at hrn
  all_goals first | (cases hrn; done) | skip
  rename_i m₀
  have hm₀ : 5 < m₀ := of_decide_eq_true hrn
  cases hL : lawsOf Xu obj cell with
  | error e => rw [hL] at hlaws; cases hlaws
  | ok ls =>
  rw [hL] at hlaws
  have hmem : lid ∈ ls := of_decide_eq_true hlaws
  cases hP : Lang.readPackage (pinned Xd.env w c.unsigned.pins) lid with
  | error e => rw [hP] at hpk; cases hpk
  | ok q =>
  rw [hP] at hpk
  have hq : q = lPkg := of_decide_eq_true hpk
  subst hq
  cases htw : receive Xu w c with
  | error e => rw [htw] at hr; cases hr
  | ok tw =>
  rw [htw] at hr
  dsimp only at hr
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hr
  obtain ⟨hd, hr⟩ := hr
  cases ha : World.admit Xd.env w tw with
  | error e => rw [ha] at hr; cases hr
  | ok w₂ =>
  have ha' : World.admit Xu.env w tw = .ok w₂ := ha
  have hl' : w.live Xu.env obj = some cell := hl
  obtain ⟨principal, laws, -, hau, hlw, -⟩ := write_next_slots htw ha' hb hl' (hcan _ _ hl)
  rw [hL] at hlw
  cases hlw
  have htr : ObjectHistory Xu obj w w₂ _ := .cons (.write htw ha' hb hl' (hcan _ _ hl) hau hL) (.nil w₂)
  have hsa : (unjudged d).admit w tw = .ok w₂ := ha
  have haud : Audited (unjudged d) w [.turn tw] w₂ :=
    ⟨by simp only [System.fold, System.step, hsa], ⟨c, hd, htw, fun _ _ => trivial⟩⟩
  obtain ⟨-, -, hall⟩ := h (obj := obj) (law := lid) (p := lPkg) (fs := lFields) (ℓ := "bounded") (t := lLaw)
    lPkg_body lPkg_laws lFields_find lLaw_isLaw lLaw_noRef haud hcan hl' hk
  have hin : ∀ e ∈ [(pinned Xu.env w c.unsigned.pins, (none : Option Digest), ls,
      reqOf c.unsigned obj principal .write, stateOf cell, applyEdits (stateOf cell) [(0, some v)],
      ([] : List (Body Digest)))], lid ∈ e.2.1.toList ++ e.2.2.1 ∧ Lang.readPackage e.1 lid = .ok lPkg := by
    intro e he
    simp only [List.mem_singleton] at he
    subst he
    exact ⟨by simpa using hmem, hP⟩
  obtain ⟨steps, hch, hmap⟩ := hall _ htr hin hs
  cases steps with
  | nil => simp at hmap
  | cons s rest =>
    obtain ⟨rq, n⟩ := s
    simp only [Option.toList_some, List.singleton_append, List.map_cons, List.map_nil, List.cons.injEq,
      Prod.mk.injEq] at hmap
    obtain ⟨⟨hreq, hn₂⟩, -⟩ := hmap
    have hn' : Lang.readState (unjudged d).X.digestOf (Lang.recordRow lPkg.state) (applyEdits (stateOf cell) [(0, some v)]) =
        .ok dd := hn
    rw [hn'] at hn₂
    cases hn₂
    cases hch with
    | cons hstep _ =>
      have hocc : rq.field "occasion" = some (.inj "write" (.record [])) := by
        rw [← hreq]; exact reqOf_write_occasion
      obtain ⟨m, hm, hle⟩ := Lang.Std.bounded_spec hstep.1 hocc (.inl (.inl ⟨_, rfl⟩))
      rw [hf] at hm
      cases hm
      omega

/-! ## §4 CONSENT (cancel), inhabited: a cancel that ends `ok` -/

/-- **The cancelled run**: the continuation parses as `cancel` of the founder's call, and follow,
holding the World THE re-deriver reaches on the cancel's log, steps the writer's page at its tip and
ends `done ok`. -/
theorem run_cancelled :
    ((match Command.State.ofBytes cKb with
      | some st => (match Command.parse (D := Digest) Xd.digestOf st.argv with
          | .ok (.cancel cb) => decide (cb = cCb)
          | _ => false)
      | none => false) &&
      match rederiveLog Xd wGenesis cancelLog with
      | .ok w => okDone ((deployed storeDigest).follow sMe ⟨w, none, none⟩ cKb cRes).2.2
      | .error _ => false) = true := by
  native_decide

/-- **INHABITED (C(ii), cancel).** The deployed follower, at a World an audited log from a genesis
World reaches (the founder's cancel recorded), ends a `cancel CALL` command `done ok`: the claim's
premise is reached. -/
theorem inhabited_cancelOk (trusted : ByteArray) :
    ∃ (me : Command.Self Digest) (g : World Digest) (f f' : Command.Follow Digest) (kb res o e : ByteArray)
      (p : Command.Persist Digest) (st : Command.State) (cb : ByteArray) (l : List (Step Digest)),
      Start (deployed storeDigest) me trusted g ∧ Audited (deployed storeDigest) g l f.world ∧
      Command.State.ofBytes kb = some st ∧
      Command.parse (deployed storeDigest).X.digestOf st.argv = .ok (Command.Cmd.cancel cb) ∧
      (deployed storeDigest).follow me f kb res = (f', p, .done CommandExit.ok.code.toUInt8 o e) := by
  have hr := run_cancelled
  simp only [Bool.and_eq_true] at hr
  obtain ⟨hk, hr⟩ := hr
  cases hs : Command.State.ofBytes cKb with
  | none => rw [hs] at hk; cases hk
  | some st =>
    rw [hs] at hk
    dsimp only at hk
    cases hp : Command.parse (D := Digest) Xd.digestOf st.argv with
    | error e => rw [hp] at hk; cases hk
    | ok cmd =>
      rw [hp] at hk
      cases cmd
      all_goals dsimp only at hk
      all_goals first | (cases hk; done) | skip
      rename_i cb
      cases hw : rederiveLog Xd wGenesis cancelLog with
      | error e => rw [hw] at hr; cases hr
      | ok w =>
        rw [hw] at hr
        dsimp only at hr
        have hfh := rederiveLog_sound hw
        have hst : Start (deployed storeDigest) sMe trusted wGenesis := .genesis _ _ _ _ _
        revert hst
        revert hfh
        revert hr
        revert hs
        generalize cKb = kb
        generalize cRes = res
        generalize wGenesis = g
        generalize cancelLog = l
        generalize sMe = me
        intro hs hr hfh hst
        cases hR : (deployed storeDigest).follow me ⟨w, none, none⟩ kb res with
        | mk f' rest =>
          obtain ⟨p, rp⟩ := rest
          rw [hR] at hr
          obtain ⟨o, e, hd⟩ := okDone_eq hr
          subst hd
          exact ⟨me, g, ⟨w, none, none⟩, f', kb, res, o, e, p, st, cb, l, hst, audited_deployed.mpr hfh,
            hs, hp, hR⟩

end Nanodregg.Spec
/-
# Lang.Journey.ContextualLaw — a hole filled under a CONTRACT on another object (DESIGN-CTX §2.5a, S2; LANG-84)

A candidate that links to another member's object may demand what that object IS, read off the
cell the kernel holds: `SupportPin.cellLaw g L` (the object `g` is live AND governed by the law
package `L`) and `SupportPin.cellPackage o P` (the object `o` is live AND runs package `P`). A
data object's laws can change (`law`, judged by the old regime and the new), so a contract by law
is DEFEASIBLE in exactly the slot's way: the `law g []` that drops `L` withdraws every
justification that cited it, and the next demand of the hole is refused `holeSupportDead 0
cellLaw:<g>:<L>` by name. A programmed object's package never changes today
(`audit_package_fixed`), so a contract by package is permanent until the package is a slot
(DESIGN-CTX §2.5c).

Rows LG0–LG8, through `Receive.submit` and `World.admit`: a law package `L` (one law, admits every
act) is installed; a data object `g` is created under `L` and an object `o` of `L`; a contextual ROM
with three candidates is installed — code 0 cites `cellLaw g L`, code 1 cites `cellPackage o L`,
code 2 cites `cellPackage o g` (a package `o` does not run) — and its hole object created; code 0
executes (value 7) while `g` is governed by `L`; A relaws `g` to no laws; the same execute is refused
`holeSupportDead 0 cellLaw:<g>:<L>`; code 1 executes; code 2 is refused `holeSupportDead 0
cellPackage:<o>:<g>`.
-/
import Lang.Journey
import Lang.Journey.Contextual

namespace Nanodregg.Lang.Journey.Law
open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Lang.Journey

/-- A law package with one law that admits every act: the contract `cellLaw g L` names it. -/
def openLaw : Package :=
  { imports := [], state := .record [], iface := .record [("open", lawTy (.record []))],
    body := .record [("open", Std.lawOf (.record []) (fun _ => Std.okT) (fun _ => Std.okT)
      (fun _ => Std.okT) (fun _ => Std.okT))],
    methods := [], laws := ["open"] }

/-- The ROM: context `[bool, nat]`, result `nat`, three candidates `var 1` (the nat argument), each
under one contract support; no hypothesis pins, no guard pin (the guard passes its `present`
through). -/
def declaration (g L o : ByteArray) : HoleROM :=
  { name := 0, ctx := [.bool, .nat], ty := .nat,
    code := [⟨.var 1, [.cellLaw g L]⟩, ⟨.var 1, [.cellPackage o L]⟩, ⟨.var 1, [.cellPackage o g]⟩],
    selectionRel := 0, selectionKey := .empty,
    hypotheses := [none, none], guardPin := none, guard := .var 0 }

def lawRows (r0 : Run) (a : Sim.Member) : Run := Id.run do
  let prog := langProgram
  let X := ctxWith prog
  let mut r := r0
  -- LG0 the law package and the two objects the contracts name
  let some lb := Wire.encodePackage openLaw | return note r "LG0 the law package has no bytes" false
  let (r0', v0, t0) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id]) (.install lb))
  let some L := t0.bind fun t => (createdIds t).head? | return note r0' s!"LG0 install the law package: {v0}" false
  r := note r0' s!"LG0 A installs the law package L ({lb.size} bytes, law open): {v0}" (v0 == "admitted")
  let (rg, vg, tg) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id, L]) (.create none [L] []))
  let some g := tg.bind fun t => (createdIds t).head? | return note rg s!"LG0 create g under L: {vg}" false
  r := note rg s!"LG0 A creates a data object g governed by L: {vg}" (vg == "admitted")
  let (ro, vo, to) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id, L]) (.create (some L) [] []))
  let some o := to.bind fun t => (createdIds t).head? | return note ro s!"LG0 create o of L: {vo}" false
  r := note ro s!"LG0 A creates an object o running L: {vo}" (vo == "admitted")
  let (gB, LB, oB) := (Sim.dc.bytes g, Sim.dc.bytes L, Sim.dc.bytes o)
  -- LG1 the contextual ROM: helpers, then the root citing g, L and o
  let bundle ← match Std.contextualHole .nat (declaration gB LB oB) [.bool true, .var 1] Contextual.clause with
    | .ok b => pure b
    | .error e => return note r s!"LG1 generate: {e}" false
  let mut ids : List D := []
  for lib in bundle.libraries do
    let some bytes := Wire.encodePackage lib | return note r "LG1 helper wire" false
    let (rr, verdict, turn) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id]) (.install bytes))
    r := note rr s!"LG1 install helper {bytes.size}: {verdict}" (verdict == "admitted")
    let some id := turn.bind fun t => (createdIds t).head? | return r
    ids := ids ++ [id]
  let p ← match bundle.linkContextual (ids.map Sim.dc.bytes) with
    | .ok p => pure p
    | .error e => return note r s!"LG1 link: {e}" false
  let some text := Print.package p | return note r "LG1 print" false
  let .ok back := Surface.readPackage text | return note r "LG1 read" false
  r := note r "LG1 the contract pins survive the resident text" (decide (back = p))
  let some bytes := Wire.encodePackage p | return note r "LG1 wire" false
  let (rr, verdict, turn) := go prog r (Sim.signed r.st a a.key
    (Sim.S.pinsFor r.st.host ([a.id, g, L, o] ++ ids)) (.install bytes))
  r := note rr s!"LG1 install the contextual ROM ({bytes.size} bytes; its supports name g, L and o): {verdict}" (verdict == "admitted")
  let some pkg := turn.bind fun t => (createdIds t).head? | return r
  let some seed := stateSlots (recordRow p.state)
    [("accepted", .bool false), ("acceptor", .digest (Sim.dc.bytes a.id)), ("cap", .nat 10),
     ("chooser", .digest (Sim.dc.bytes a.id)), ("closes", .nat 100000),
     ("selected", .inj "none" (.record []))] 0 | return note r "LG1 seed" false
  let (rr, verdict, turn) := go prog r (Sim.signed r.st a a.key
    (Sim.S.pinsFor r.st.host ([a.id, pkg] ++ ids)) (.create (some pkg) [] seed))
  r := note rr s!"LG1 create the hole object: {verdict}" (verdict == "admitted")
  let some obj := turn.bind fun t => (createdIds t).head? | return r
  let choiceKey := Data.record [("hole", .nat 0)]
  -- the rows an execute reads (the selection row and the computed row) and the cells the contracts name
  let rowPins (r : Run) :=
    hole_pinAt obj r.st.host 5 Std.codeSelection choiceKey ++
    hole_pinAt obj r.st.host 1 (Std.codeOutput .nat) choiceKey
  let call (r : Run) (method : Label) (args : ByteArray) :=
    signedAt r.st a (Sim.S.pinsFor r.st.host ([a.id, obj, pkg, g, L, o] ++ ids))
      (.invoke obj (p.methods.idxOf method) args 100000 none)
      r.st.host.height (r.st.host.height + 1024) (rowPins r)
  let exec (r : Run) := call r "execute" (argBytes .nat (.nat 7))
  let choose (r : Run) (i : Nat) := call r "choose_code"
    (argBytes (.record [("hole", .nat), ("index", .nat)])
      (.record [("hole", .nat 0), ("index", .nat i)]))
  let value (r : Run) := match storyRow r.st.host obj 1 (Std.codeOutput .nat) choiceKey with
    | some (.nat n) => some n | _ => none
  let lawsOfG (r : Run) : Option Nat := (r.st.host.live X.env g).map fun c => (lawSlotsOf c).length
  -- LG2 code 0, under `cellLaw g L`, executes while g is governed by L
  let (rr, v, _) := go prog r (choose r 0)
  r := note rr s!"LG2 A chooses code 0 (contract: g governed by L): {v}" (v == "admitted")
  let (rr, v, _) := go prog r (exec r)
  r := note rr s!"LG2 execute under the contract (g has {lawsOfG r} law): {v}; value {value rr}" (v == "admitted" && value rr == some 7)
  -- LG3 A relaws g to no laws (judged by L's law as relaw; nothing incoming): the contract is withdrawn
  let (rr, v, _) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id, g, L]) (.law g [] none))
  r := note rr s!"LG3 A relaws g to no laws: {v}; g now has {lawsOfG rr} law" (v == "admitted" && lawsOfG rr == some 0)
  let (_, v, _) := go prog r (exec r)
  r := note r s!"LG4 execute after the relaw: {v}"
    (refusedBy v "execute" s!"holeSupportDead 0 {(SupportPin.cellLaw gB LB).wire}")
  -- LG5 code 1, under `cellPackage o L`, executes: o runs L
  let (rr, v, _) := go prog r (choose r 1)
  r := note rr s!"LG5 A chooses code 1 (contract: o runs L): {v}" (v == "admitted")
  let (rr, v, _) := go prog r (exec r)
  r := note rr s!"LG5 execute under the package contract: {v}; value {value rr}" (v == "admitted" && value rr == some 7)
  -- LG6 code 2, under `cellPackage o g` (a package o does not run), is refused by name
  let (rr, v, _) := go prog r (choose r 2)
  r := note rr s!"LG6 A chooses code 2 (contract: o runs g, which it does not): {v}" (v == "admitted")
  let (_, v, _) := go prog r (exec r)
  r := note r s!"LG6 execute under a package contract the object does not meet: {v}"
    (refusedBy v "execute" s!"holeSupportDead 0 {(SupportPin.cellPackage oB gB).wire}")
  return r

def lawSession : Run :=
  let X := ctxWith langProgram
  let fk := [("lw-a".toUTF8, "lw-a-next".toUTF8)]
  match genesis X Sim.worldName (Sim.nonceOf 12) 100000000
      (fk.map fun (k, n) => (k, nextKeyDigest X n)) Authority.none with
  | .error e => note { st := { rng := ⟨1⟩, host := World.genesis X.env 0 0, members := [] } }
      s!"LG genesis: {e.name}" false
  | .ok g =>
    let ms := fk.zipIdx.map fun ((k, n), i) => (⟨founderId X g.origin i, k, n⟩ : Sim.Member)
    lawRows { st := { rng := ⟨1⟩, host := g, members := ms } } (ms.headD ⟨0, .empty, .empty⟩)

initialize register { name := "law", run := pure lawSession, contextual := true }

end Nanodregg.Lang.Journey.Law
/-
# Lang.Journey.Doc — the document: a section whose text is chosen among members' posts under a
justification the World can withdraw (DESIGN-CTX §4, S1; the charter's "documents" demonstration)

A SECTION is `Std.hole` at `V := bytes`: its candidates are texts POSTED by contributors (`propose`,
by anyone granted it), each justified by a support that names a kernel cell (the contributor's own
grant, read LIVE: LANG-75.1), chosen by the section's editor (`select`, the chooser), judged by the
clause (a text of at most 2000 bytes). A revoked contributor's text is withdrawn BY NAME on the next
judgment (`rejudge` records `suspended "support0 dead"`; a `select` of it is refused `support0 dead`),
and the editor selects another contributor's text: the document repairs, and nobody re-installs
anything. That is the slot of DESIGN-CTX §2.1 at its most legible, and the first contextual object
a member drives through `nd` (`client/tests/doc.rs`, over the SHIPPED texts).

The shipped texts (`world/doc/Section.lib0..2`, the helpers; `world/doc/Section`, the root linked by
the helpers' DEPLOYED ids, KERNEL's `romIdOf` under CODEC's deployed Env, what `nd install` prints)
are what this generator emits (`lang-journey --write world/doc`); row DC0 reads them from disk and
refuses a text that is not the generator's (one copy, as `world/resident/Bell`'s LB0). The Sim rows
DC1–DC9 run the section's life through `Receive.submit` on the generator's packages linked at the
Sim's ids (a Sim cell id is not a deployed digest, so the root text cannot install in the Sim; the
cargo row installs it for real).
-/
import Lang.Journey
import Lang.Resident

namespace Nanodregg.Lang.Journey.Doc
open Nanodregg.Kernel Nanodregg.Kernel.Receive Nanodregg.Lang.Journey

/-- A section's text is at most 2000 bytes (the Bell's bound on a ring's text). -/
def clause : Term := .lam Std.holeState (.lam .bytes (.prim .lenLe (.var 0) (.nat 2000)))

/-- The section generator: `Std.hole` at `bytes`. -/
def bundle : Except String Std.HoleBundle := (Std.hole .bytes clause).mapError (·.name)

/-- Where the shipped texts live, and their names in install order (the helpers, then the root). -/
def dir : System.FilePath := "world" / "doc"
def files : List String := ["Section.lib0", "Section.lib1", "Section.lib2", "Section"]

/-- The deployed id of a package's bytes: KERNEL's `romIdOf` under CODEC's deployed Env, the id
`nd install` prints and the root's `(imports …)` names (`Lang.Resident.checkPackageWith`'s). -/
def deployedId (bytes : ByteArray) :=
  romIdOf Codec.Deployed.env { kind := kindPackage, discipline := .rom, slots := [(0, bytes)] }

/-- The texts the generator emits, by file: each helper's, then the root's, linked by the helpers'
deployed ids. -/
def texts : Except String (List (String × String)) := do
  let b ← bundle
  let mut out : List (String × String) := []
  let mut ids : List ByteArray := []
  for (lib, i) in b.libraries.zipIdx do
    let some bytes := Wire.encodePackage lib | throw s!"helper {i} has no bytes"
    let some t := Print.package lib | throw s!"helper {i} is not printable"
    ids := ids ++ [(deployedId bytes).bytes]
    out := out ++ [(s!"Section.lib{i}", t)]
  let p ← (b.link ids).mapError (·.name)
  let some t := Print.package p | throw "the root is not printable"
  pure (out ++ [("Section", t)])

/-- `lang-journey --write DIR`: emit the texts (the one way `world/doc` is written). -/
def write (d : System.FilePath) : IO UInt32 := do
  match texts with
  | .error e => IO.eprintln s!"doc: {e}"; return 1
  | .ok ts =>
    IO.FS.createDirAll d
    for (f, t) in ts do
      IO.FS.writeFile (d / f) t
      IO.println s!"wrote {d / f} ({t.length} chars)"
    return 0

/-- The shipped texts, read from disk by name (`""` for a missing file, as the Bell's). -/
def readShipped : IO (List (String × String)) :=
  files.mapM fun (f : String) => do
    let t : String ← try IO.FS.readFile (dir / f) catch _ => pure ""
    pure (f, t)

/-! ## The section's life (DC rows) -/

def supportTy : Ty := Std.holeSupport
def proposeTy : Ty :=
  .record [("cand", .digest), ("s0", optTy supportTy), ("s1", optTy supportTy), ("value", .bytes)]

def supportOf (cell pin : ByteArray) : Data :=
  .inj "some" (.record [("cell", .digest cell), ("pin", .digest pin)])
def noSupport : Data := .inj "none" (.record [])

def proposeArg (cand : ByteArray) (s0 : Data) (text : String) : ByteArray :=
  argBytes proposeTy (.record [("cand", .digest cand), ("s0", s0), ("s1", noSupport), ("value", .bytes text.toUTF8)])
def candArg (cand : ByteArray) : ByteArray :=
  argBytes (.record [("cand", .digest)]) (.record [("cand", .digest cand)])
def postArg (cell pin : ByteArray) : ByteArray :=
  argBytes (.record [("cell", .digest), ("pin", .digest)]) (.record [("cell", .digest cell), ("pin", .digest pin)])

/-- The section's life through the receivers: install, create, a contributor's post selected, the
contributor revoked, the text withdrawn by name, another contributor's text selected. -/
def lifeRows (r0 : Run) (a b : Sim.Member) : Run := Id.run do
  let prog := langProgram
  let mut r := r0
  let bnd ← match bundle with
    | .ok x => pure x
    | .error e => return note r s!"DC1 generating the section: {e}" false
  -- DC1 the helpers, then the root linked at the Sim's ids
  let mut libIds : List D := []
  for lib in bnd.libraries do
    let some bytes := Wire.encodePackage lib | return note r "DC1 helper has no bytes" false
    let (rL, vL, tL) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id]) (.install bytes))
    r := note rL s!"DC1 A installs a section helper ({bytes.size} bytes): {vL}" (vL == "admitted")
    let some id := tL.bind fun t => (createdIds t).head? | return note r "DC1 no helper id" false
    libIds := libIds ++ [id]
  let p ← match bnd.link (libIds.map Sim.dc.bytes) with
    | .ok p => pure p
    | .error e => return note r s!"DC1 linking the section: {e.name}" false
  let some pb := Wire.encodePackage p | return note r "DC1 the section has no bytes" false
  let (r1, v1, t1) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host (a.id :: libIds)) (.install pb))
  r := note r1 s!"DC1 A installs the section ({pb.size} bytes; methods {p.methods}): {v1}" (v1 == "admitted")
  let some pkg := t1.bind fun t => (createdIds t).head? | return note r "DC1 no section package id" false
  let some dC := p.rels.lookup "candidates" | return note r "DC1 no candidates" false
  let some dF := p.rels.lookup "facts" | return note r "DC1 no facts" false
  let factsIndex := (p.rels.map (·.1)).idxOf "facts"
  -- DC2 A creates a section it edits (chooser and acceptor A; a text is at most 2000 bytes)
  let seedData : List (Label × Data) :=
    [("accepted", .bool false), ("acceptor", .digest (Sim.dc.bytes a.id)), ("cap", .nat 2000),
     ("chooser", .digest (Sim.dc.bytes a.id)), ("closes", .nat 100000), ("selected", .inj "none" (.record []))]
  let some seed := stateSlots (recordRow p.state) seedData 0 | return note r "DC2 seed has no bytes" false
  let (r2, v2, t2) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host ([a.id, pkg] ++ libIds)) (.create (some pkg) [] seed))
  let some obj := t2.bind fun t => (createdIds t).head? | return note r2 s!"DC2 no section: {v2}" false
  r := note r2 s!"DC2 A creates the section (editor A): {v2}" (v2 == "admitted")
  let factKey (cell : ByteArray) : Data := .record [("cell", .digest cell)]
  let candKey (cand : ByteArray) : Data := .record [("cand", .digest cand)]
  let pinFact (w : World D) (cell : ByteArray) := hole_pinAt obj w factsIndex dF (factKey cell)
  let pinCand (w : World D) (cand : ByteArray) := hole_pinAt obj w 0 dC (candKey cand)
  let status (w : World D) (cand : ByteArray) := hole_statusOf w obj dC cand
  let textOf (w : World D) (cand : ByteArray) : Option String :=
    match (storyRow w obj 0 dC (candKey cand)).bind (·.field "value") with
    | some (.bytes t) => some (String.fromUTF8! t)
    | _ => none
  -- a contributor's grant: post (its support fact) and propose (its text)
  let contribute (r : Run) : Run × String × Option D :=
    let (rg, vg, tg) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id, b.id, obj])
      (.grant obj b.id [.invoke (p.methods.idxOf "post"), .invoke (p.methods.idxOf "propose")] none))
    (rg, vg, tg.bind fun t => (createdIds t).head?)
  -- `cells`: the fact cells the call reads live (a support's grant, live or at its tombstone), pinned by the signer
  let call (r : Run) (m : Sim.Member) (via : Option D) (method : Label) (x : ByteArray)
      (rowPins : List (RowSlot D × D) := []) (cells : List D := []) : Call D :=
    signedAt r.st m (Sim.S.pinsFor r.st.host ([m.id, a.id, b.id, obj, pkg] ++ libIds ++ via.toList ++ cells))
      (.invoke obj (p.methods.idxOf method) x 100000 via) r.st.host.height (r.st.host.height + 1024) rowPins
  -- DC3 A grants B post and propose; B posts the fact of its grant and proposes its text under it
  let (r3, v3, g3) := contribute r
  let some gB := g3 | return note r3 s!"DC3 A grants B post and propose: {v3}" false
  r := note r3 s!"DC3 A grants B post and propose: {v3}" (v3 == "admitted")
  let gBb := Sim.dc.bytes gB
  let cB := Sim.dc.bytes b.id
  let (r4, v4, _) := go prog r (call r b (some gB) "post" (postArg gBb gBb))
  r := note r4 s!"DC4 B posts the fact of its grant (cell gB, pin gB): {v4}" (v4 == "admitted")
  let (r5, v5, _) := go prog r (call r b (some gB) "propose" (proposeArg cB (supportOf gBb gBb) "a light on the rock") (pinFact r.st.host gBb))
  r := note r5 s!"DC5 B proposes \"a light on the rock\" supported by its grant: {v5}; status {status r5.st.host cB}"
    (v5 == "admitted" && status r5.st.host cB == some "verified")
  -- DC6 A selects B's text: the section reads it
  let (r6, v6, _) := go prog r (call r a none "select" (candArg cB) (pinCand r.st.host cB ++ pinFact r.st.host gBb) [gB])
  r := note r6 s!"DC6 A selects B's text: {v6}; selected {hole_selectedOf Sim.env r6.st.host obj == some (some cB)}; text {textOf r6.st.host cB}"
    (v6 == "admitted" && hole_selectedOf Sim.env r6.st.host obj == some (some cB))
  -- DC7 A revokes B's grant: the justification is withdrawn; the next judgment says so by name
  let (r7, v7, _) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id, gB]) (.revoke gB))
  r := note r7 s!"DC7 A revokes B's grant: {v7}" (v7 == "admitted")
  let (r8, v8, _) := go prog r (call r a none "rejudge" (candArg cB) (pinCand r.st.host cB ++ pinFact r.st.host gBb) [gB])
  r := note r8 s!"DC8 A rejudges B's text: {v8}; status {status r8.st.host cB}"
    (v8 == "admitted" && status r8.st.host cB == some "suspended \"support0 dead\"")
  let (_, v8b, _) := go prog r (call r a none "select" (candArg cB) (pinCand r.st.host cB ++ pinFact r.st.host gBb) [gB])
  r := note r s!"DC8b A selects the withdrawn text again: {v8b}" (refusedBy v8b "select" "support0 dead")
  -- DC9 B contributes again under a new grant; A selects the new text: the document repaired
  let (r9, v9, g9) := contribute r
  let some gB2 := g9 | return note r9 s!"DC9 A grants B again: {v9}" false
  r := note r9 s!"DC9 A grants B again: {v9}" (v9 == "admitted")
  let gB2b := Sim.dc.bytes gB2
  let cB2 := Sim.dc.bytes gB2
  let (r9a, v9a, _) := go prog r (call r b (some gB2) "post" (postArg gB2b gB2b))
  r := note r9a s!"DC9a B posts the fact of its new grant: {v9a}" (v9a == "admitted")
  let (r9b, v9b, _) := go prog r (call r b (some gB2) "propose" (proposeArg cB2 (supportOf gB2b gB2b) "a ship in the fog") (pinFact r.st.host gB2b))
  r := note r9b s!"DC9b B proposes \"a ship in the fog\" under the new grant: {v9b}; status {status r9b.st.host cB2}"
    (v9b == "admitted" && status r9b.st.host cB2 == some "verified")
  let (r9c, v9c, _) := go prog r (call r a none "select" (candArg cB2) (pinCand r.st.host cB2 ++ pinFact r.st.host gB2b) [gB2])
  r := note r9c s!"DC9c A selects the new text: {v9c}; selected {hole_selectedOf Sim.env r9c.st.host obj == some (some cB2)}; text {textOf r9c.st.host cB2}"
    (v9c == "admitted" && hole_selectedOf Sim.env r9c.st.host obj == some (some cB2))
  return r

/-- DC0: every shipped text is the generator's; then the life. -/
def session (shipped : List (String × String)) : Run :=
  let X := ctxWith langProgram
  let empty : Run := { st := { rng := ⟨1⟩, host := World.genesis X.env 0 0, members := [] } }
  let r0 := match texts with
    | .error e => note empty s!"DC0 generating the section texts: {e}" false
    | .ok ts => ts.foldl (fun r (f, t) =>
        let got := (shipped.lookup f).getD ""
        note r s!"DC0 {dir / f} is the generator's text ({t.length} chars)" (got == t)) empty
  let fk := [("dc-a".toUTF8, "dc-a-next".toUTF8), ("dc-b".toUTF8, "dc-b-next".toUTF8)]
  match genesis X Sim.worldName (Sim.nonceOf 11) 100000000
      (fk.map fun (k, n) => (k, nextKeyDigest X n)) Authority.none with
  | .error e => note r0 s!"DC1 genesis: {e.name}" false
  | .ok g =>
    let ms := fk.zipIdx.map fun ((k, n), i) => (⟨founderId X g.origin i, k, n⟩ : Sim.Member)
    lifeRows { r0 with st := { rng := ⟨1⟩, host := g, members := ms } }
      (ms.headD ⟨0, .empty, .empty⟩) (ms.getD 1 ⟨0, .empty, .empty⟩)

initialize register { name := "doc", run := do pure (session (← readShipped)) }

end Nanodregg.Lang.Journey.Doc


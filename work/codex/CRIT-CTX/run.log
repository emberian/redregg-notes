131-    ("insert", guard (.prim .deq (.get (.get (.var 0) "key") "agent") (.get (.var 2) "agent")) "notYours" okT),
132:    ("retract", activityDequeue patience resumer names),
133-    ("upsert", refusedT "final")])))

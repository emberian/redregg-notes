/- Per-candidate verifying traces; a demonstration Mini can take. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.Trace

variable {D : CalculusData} {K V : Type}

/-- A guard can see only the declared projection, never the ambient environment.
Mokhov–Mitchell–Peyton Jones, ICFP 2018, §4.2.2, pp.79:14–15. -/
structure Guard (D : CalculusData) (K V : Type) where
  reads : D.Tm → List K
  run : D.Tm → List V → Bool

/-- Install the projected guard in the existing interface; other checks are unchanged.
Mokhov et al. 2018, §4.2.2, pp.79:14–15. -/
def Guard.install (g : Guard D K V) (I : Iface D (K → V)) : Iface D (K → V) :=
  { I with guard := fun e t => g.run t ((g.reads t).map e) }

/-- Exact values, not hashes: supports record missing tokens, blockers record live tokens.
Both lists are complete projections, including negative observations; no collision premise.
Mokhov et al. 2018, §4.2.2, pp.79:14–15. -/
structure Snapshot (V : Type) where
  env : List V
  missing : List Token
  blocked : List Token
deriving DecidableEq, Repr

/-- Observe every declared key, every effective support and every blocker.
Mokhov et al. 2018, §4.2.2, pp.79:14–15. -/
def observe (g : Guard D K V) (I : Iface D (K → V)) (w : World (K → V))
    (c : Candidate D) : Snapshot V :=
  ⟨(g.reads c.filling).map w.env,
   (effSupports I c).filter (fun t => !w.live t), c.blockers.filter w.live⟩

/-- The existing judgment factored through its complete finite observation.
Mokhov et al. 2018, Def.3.1 p.79:11 and §4.2.2 pp.79:14–15. -/
def evaluate (g : Guard D K V) (I : Iface D (K → V)) (c : Candidate D)
    (s : Snapshot V) : Status :=
  if D.check I.ctx c.filling I.ty = false then .conflict .illTyped
  else if g.run c.filling s.env = false then .conflict .guardFails
  else if s.blocked.isEmpty = false then .pruned s.blocked
  else if s.missing.isEmpty = false then .suspended s.missing
  else if c.cost ≤ I.budget then .verified else .uncovered c.cost I.budget

/-- Missing observation is not an observed absence. At the package boundary, a pinned-absent
row maps to `some false`, an omitted pin to `none`. Mokhov et al. 2018, §4.2.2 pp.79:14–15. -/
inductive Missing (K : Type) where
  | environment (key : K)
  | token (key : Token)
deriving DecidableEq, Repr

/-- Bounded complete collection; the first omitted read refuses by its key.
Mokhov et al. 2018, §4.2.2 pp.79:14–15. -/
def collect {A B R : Type} (missing : A → R) (read : A → Option B) :
    List A → Except R (List B)
  | [] => .ok []
  | k :: ks =>
    match read k with
    | none => .error (missing k)
    | some v => match collect missing read ks with
      | .error e => .error e
      | .ok vs => .ok (v :: vs)

/-- Coverage comes from the guard declaration and candidate, never from caller-chosen coverage.
All reads finish before any verdict, including on a failing guard.
Mokhov et al. 2018, §4.2.2 pp.79:14–15. -/
def capture (g : Guard D K V) (I : Iface D (K → V)) (c : Candidate D)
    (env : K → Option V) (live : Token → Option Bool) : Except (Missing K) (Snapshot V) := do
  let es ← collect Missing.environment env (g.reads c.filling)
  let ms ← collect Missing.token (fun t => (live t).map fun b => (t, !b)) (effSupports I c)
  let bs ← collect Missing.token (fun t => (live t).map fun b => (t, b)) c.blockers
  pure ⟨es, (ms.filter Prod.snd).map Prod.fst, (bs.filter Prod.snd).map Prod.fst⟩

/-- The package-facing entry point refuses incomplete observations before judging.
This is a checked adapter, not a claim that an existing package calls it.
Mokhov et al. 2018, §4.2.2 pp.79:14–15. -/
def checkedJudge (g : Guard D K V) (I : Iface D (K → V)) (c : Candidate D)
    (env : K → Option V) (live : Token → Option Bool) : Except (Missing K) Status :=
  (capture g I c env live).map (evaluate g I c)

/-- A trace belongs to its candidate. Changed candidate/interface/guard definitions require
reseeding. Mokhov et al. 2018, §4.2.2 pp.79:14–15 (fixed tasks). -/
structure Cached (D : CalculusData) (V : Type) where
  candidate : Candidate D
  trace : Snapshot V

/-- Initialize a coherent cache from the same observation used by its judgment.
Mokhov et al. 2018, §4.2.2 pp.79:14–15. -/
def seed (g : Guard D K V) (I : Iface D (K → V)) (w : World (K → V))
    (c : Candidate D) : Cached D V :=
  let s := observe g I w c
  ⟨{ c with status := evaluate g I c s }, s⟩

/-- Does the new world change this trace? Equal-valued writes do not dirty it.
Mokhov et al. 2018, Def.2.1 p.79:3, §4.2.2 pp.79:14–15. -/
def meets [DecidableEq V] (g : Guard D K V) (I : Iface D (K → V))
    (w : World (K → V)) (c : Cached D V) : Bool :=
  decide (c.trace ≠ observe g I w c.candidate)

/-- Re-evaluate once only in the dirty branch; update the trace even if the status is equal.
Mokhov et al. 2018, §4.2.2 pp.79:14–15. -/
def refresh [DecidableEq V] (g : Guard D K V) (I : Iface D (K → V))
    (w : World (K → V)) (c : Cached D V) : Cached D V :=
  if meets g I w c then seed g I w c.candidate else c

/-- Exact candidate indices inspected and the smaller set whose statuses changed.
Indices distinguish repeated fillings. Mokhov et al. 2018, Def.2.1 p.79:3, §4.2.2 pp.79:14–15. -/
structure Pass (D : CalculusData) (V : Type) where
  entries : List (Cached D V)
  rejudged : List Nat
  changed : List Nat

/-- Structural single traversal: at most one evaluation per retained candidate.
Mokhov et al. 2018, Def.2.1 p.79:3. -/
def repair [DecidableEq V] (g : Guard D K V) (I : Iface D (K → V))
    (w : World (K → V)) : List (Cached D V) → Nat → Pass D V
  | [], _ => ⟨[], [], []⟩
  | c :: cs, n =>
    let c' := refresh g I w c
    let rest := repair g I w cs (n + 1)
    ⟨c' :: rest.entries,
     if meets g I w c then n :: rest.rejudged else rest.rejudged,
     if c'.candidate.status ≠ c.candidate.status then n :: rest.changed else rest.changed⟩

/-- Only holes reading a changed selection status are dirtied. Other behavior needs its
own Boundary declaration. Mokhov et al. 2018, §2.3 p.79:5, §4.2.2 p.79:15. -/
def dirtyReaders (p : Pass D V) (readers : List (Nat × Nat)) : List Nat :=
  (readers.filter fun r => decide (r.2 ∈ p.changed)).map Prod.fst

end Nanodregg.Lang.Contextual.Trace
/- P9: finite dual-literal provenance, retaining environmental conditions.
Grädel–Tannen (2024), Def4 p9, §6 pp19–20; de Kleer (1986), pp144–145.
Candidates are Doyle (1979) IN/OUT justifications, not ATMS labels. The computed
polynomial is a label; its Boolean image forgets multiplicity, not conditions. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.P9

variable {D : CalculusData} {E : Type}

/-- Grädel–Tannen §6 pp19–20: keep the verdict's input until specialization.
The budget is a literal too, even though Iface fixes it across world edits. -/
inductive EnvLit (D : CalculusData) where
  | guard (filling : D.Tm)
  | budget (cost : Nat)
deriving DecidableEq

def EnvLit.eval (I : Iface D E) (env : E) : EnvLit D → Bool
  | .guard t => I.guard env t
  | .budget cost => decide (cost ≤ I.budget)

/-- Dual token literals plus unevaluated environmental literals (Grädel–Tannen p9, p19). -/
structure Monomial (D : CalculusData) where
  supports : List Token
  blockers : List Token
  envLits : List (EnvLit D)
deriving DecidableEq

def Monomial.envOK (I : Iface D E) (env : E) (m : Monomial D) : Bool :=
  m.envLits.all (EnvLit.eval I env)

def Monomial.eval (I : Iface D E) (w : World E) (m : Monomial D) : Bool :=
  m.envOK I w.env && m.supports.all w.live && m.blockers.all (fun t => !w.live t)

/-- A Candidate is Doyle (1979), an IN/OUT justification, not an ATMS label.
This translation produces one label environment (de Kleer 1986, pp144–145). -/
def monomial (I : Iface D E) (c : Candidate D) : Monomial D :=
  ⟨effSupports I c, c.blockers, [.guard c.filling, .budget c.cost]⟩

/-- Grädel–Tannen §6 p19: no environment argument, hence no erased guard branch.
Only the immutable typing problem is specialized. -/
def provenance (I : Iface D E) (cs : List (Candidate D)) : List (Monomial D) :=
  (cs.filter fun c => D.check I.ctx c.filling I.ty).map (monomial I)

/-- The original token polynomial recovered by evaluating precisely envLits (Prop15 p20). -/
def specialize (I : Iface D E) (env : E) (ms : List (Monomial D)) :
    List (List Token × List Token) :=
  (ms.filter (Monomial.envOK I env)).map fun m => (m.supports, m.blockers)

/-- p·p̄ = 0: a product containing both polarities contributes nothing (Def4 p9). -/
def Monomial.consistent (m : Monomial D) : Bool :=
  m.supports.all fun t => !decide (t ∈ m.blockers)

/-- de Kleer pp144–145: inclusion of ALL literals, including environmental obligations. -/
def Monomial.subsumes (a b : Monomial D) : Bool :=
  a.supports.all (fun t => decide (t ∈ b.supports)) &&
  a.blockers.all (fun t => decide (t ∈ b.blockers)) &&
  a.envLits.all (fun l => decide (l ∈ b.envLits))

/-- Absorption a + ab = a in PosBool[X,X̄], retaining a representative of equal products.
de Kleer p145: no surviving label environment strictly contains another. -/
def minimal : List (Monomial D) → List (Monomial D)
  | [] => []
  | m :: ms =>
    let rest := minimal ms
    if rest.any (fun n => n.subsumes m) then rest
    else m :: rest.filter (fun n => !m.subsumes n)

/-- A complete label: erase complementary products, then absorb supersets. -/
def label (I : Iface D E) (cs : List (Candidate D)) : List (Monomial D) :=
  minimal ((provenance I cs).filter Monomial.consistent)

end Nanodregg.Lang.Contextual.P9
/- First-class repair objects. P4; a demonstration Mini can take.
The indexed data lives here; correctness and equivalence laws live in Proofs.
The old five outcomes embed unchanged; transport adds the sixth case. -/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.RepairObjects

variable {D : CalculusData} {E : Type}

/-- An edit path with its source and destination in the type. -/
inductive Change (E : Type) : World E → World E → Type where
  | stay (w : World E) : Change E w w
  | edit (w : World E) (e : Edit E) : Change E w (e.apply w)
  | then {w v z : World E} : Change E w v → Change E v z → Change E w z

/-- A correspondence is data. The registry's Sound law certifies an equivalence on
checker-accepted fillings, including both inverses, not just a one-way replacement. -/
structure Correspondence (D : CalculusData) (E : Type) where
  source : Iface D E
  target : Iface D E
  forward : D.Tm → D.Tm
  backward : D.Tm → D.Tm

/-- Certificate identifiers resolve only through the supplied checked registry.
Its Sound predicate is in the proof module, just as CalculusData uses CalculusLaws. -/
abbrev Registry (D : CalculusData) (E : Type) := Nat → Option (Correspondence D E)

/-- Transport retains the original term and the certificate, so it is distinguishable
from an unrelated replacement even when their destination terms coincide. -/
structure TransportEvidence (D : CalculusData) (E : Type) where
  certificate : Nat
  correspondence : Correspondence D E
  original : Candidate D
  image : Candidate D

/-- Six semantic outcomes: the existing five, plus checked representation transport. -/
inductive Outcome (D : CalculusData) (E : Type) where
  | existing (outcome : Nanodregg.Lang.Contextual.Outcome D)
  | transported (evidence : TransportEvidence D E)

inductive OutcomeKind where
  | kept | replacement | strengthening | alternative | suspended | transported
deriving DecidableEq, Repr

def Outcome.kind : Outcome D E → OutcomeKind
  | .existing (.kept _) => .kept
  | .existing (.replacement _ _ _) => .replacement
  | .existing (.strengthening _ _ _) => .strengthening
  | .existing (.alternative _ _) => .alternative
  | .existing (.suspended _ _) => .suspended
  | .transported _ => .transported

inductive TransportRefusal where
  | unknownCertificate
  | sourceIllTyped
  | destination (status : Status)
deriving DecidableEq, Repr



/-- Data-only representation checker, not a claimed contextual language instance. -/
private def repData : CalculusData where
  Ty := Bool
  Ctx := Unit
  Tm := Nat × Bool
  tmEq := inferInstance
  msubst _ t := t
  check _ t ty := t.2 == ty
  uses _ _ := false
  drop _ _ := ()
  strengthen _ t := t
  weaken _ t := t
  var x := (x, false)
  lookup _ _ := none

private def source : Iface repData Unit :=
  ⟨0, (), false, [], by simp, fun _ _ => true, 10, 1, 2⟩
private def target : Iface repData Unit :=
  ⟨1, (), true, [], by simp, fun _ c => c.1 < 10, 10, 1, 2⟩
private def swap (t : Nat × Bool) : Nat × Bool := (t.1, !t.2)
private def q : Correspondence repData Unit := ⟨source, target, swap, swap⟩
private def registry : Registry repData Unit := fun n => if n = 17 then some q else none
private def original (n : Nat := 7) : Candidate repData :=
  ⟨(n, false), [token], [], 1, 3, .verified⟩

/-- This registry contains a checked two-sided equivalence on ALL payloads, not a lookup
table containing only the single filling exercised below. -/
theorem representation_equivalence : q.Checked := by
  constructor
  · intro t ht
    cases t with
    | mk n b => cases b <;> simp_all [repData, q, source, target, swap]
  · intro t ht
    cases t with
    | mk n b => cases b <;> simp_all [repData, q, source, target, swap]
  · intro t _
    cases t with
    | mk n b => cases b <;> rfl
  · intro t _
    cases t with
    | mk n b => cases b <;> rfl

theorem registry_checked : registry.Sound := by
  intro n q' h

/-- Both evidence forms deliver admission of their actual destination; the internal form
also carries an observable equality (Ringer p7; Viola pp1–2). -/
theorem internal_valid_destination {D : CalculusData} {E V : Type}
    {I : Iface D E} {w : World E} {value : D.Tm → V} {s t : Candidate D}
    (h : Valid I w value (.internal s t)) :
    value s.filling = value t.filling ∧ judge I w t = .verified := by
  cases h with
  | internal hv hj => exact ⟨hv, hj⟩

/-- Rechecking constructs the matching validity judgment (Ringer et al. p7). -/
theorem recheck_valid {D : CalculusData} {E V : Type} (value : D.Tm → V)
    {registry : RepairObjects.Registry D E} (hr : registry.Sound)
    {n : Nat} {w : World E} {c : Candidate D} {cost : Nat}
    {ev : RepairObjects.TransportEvidence D E}
    (h : recheck registry n w c cost = .ok (.rechecked ev)) :
    Valid ev.correspondence.target w value (.rechecked ev) :=
  .rechecked rfl (recheck_sound hr h)

end Nanodregg.Lang.Contextual.TransportKinds

/-- Which program the journey runs under. -/
inductive Mode
  | honest | skipJudge | eraseOccasion | erasePayload | dropCalls | rawInstall | bytesIds | skipLits
  | totalDigest | unlawfulCodec | dropRangeRow | foreignRow
  deriving DecidableEq

def Mode.program : Mode → Program D
  | .honest => langProgram
  | .skipJudge => Journey.skipJudge
  | .eraseOccasion => Journey.eraseOccasion
  | .erasePayload => Journey.erasePayload
  | .dropCalls => Journey.dropCalls
  | .rawInstall => Journey.rawInstall
  | .bytesIds => Journey.bytesIds
  | .skipLits => Journey.skipLits
  | .totalDigest => Journey.totalDigest
  -- its plant refuses the founder's own id, which `callRows` knows: it builds `unlawfulCodec a.id`
  | .unlawfulCodec => langProgram
  | .dropRangeRow => Journey.dropRangeRow
  | .foreignRow => Journey.foreignRow

/-- A method's refusal by name (LANG-51): `program "m: refused why"`. -/
def refusedBy (v m why : String) : Bool := v.startsWith "refused program" && (v.splitOn s!"{m}: refused {why}").length > 1

/-- A refusal by a law, with `why` in its reason. -/
def deniedWith (v why : String) : Bool := v.startsWith "refused lawDenied" && (v.splitOn why).length > 1

structure Run where
  st : Sim.State
  log : List String := []
  bad : Nat := 0

def note (r : Run) (line : String) (good : Bool) : Run :=
  { r with log := r.log ++ [s!"{if good then "ok  " else "FAIL"} {line}"], bad := r.bad + (if good then 0 else 1) }

/-- Submit on the Host path with program `prog`; the verdict's name. -/
def go (prog : Program D) (r : Run) (c : Call D) : Run × String × Option (Turn D) :=
  let X := ctxWith prog
  let st := r.st
  match Receive.submit X st.host c with
  | .error (.refused e) => ({ r with st }, s!"refused {Sim.nameOf e} {reprStr e}", none)
  | .error (.rejected e) => ({ r with st }, s!"rejected {Sim.nameOf e}", none)
  | .ok (t, w') => ({ r with st := { st with host := w', log := st.log ++ [.turn t] } }, "admitted", some t)

def totalOf (E : Kernel.Env D) (w : World D) (obj : D) : Option Nat :=
  match w.live E obj with
    r := quorumRows mode r a b
    r := windowedRows mode r a
  if mode = .honest then
    r := gateRows mode r a
  r := callRows mode r a
  -- L7 follower and auditor
  match World.fold Sim.env g r.st.log with
  | .ok w => r := note r s!"L7 follower reaches the Host's World ({r.st.log.length} turns)" (Sim.same w r.st.host)
  | .error (i, e) => r := note r s!"L7 follower refused at {i}: {Sim.nameOf e}" false
  match audit (ctxWith prog) g r.st.log with
  | .ok w => r := note r "L7 auditor reaches the Host's World" (Sim.same w r.st.host)
  | .error (i, e) => r := note r s!"L7 auditor refused at {i}: {reprStr e}" false
  return r

def runAll (args : List String) : IO UInt32 := do
  let some control := (match args with
      | [] => some false
      | ["--harness-control"] => some true
      | _ => none)
    | IO.eprintln s!"usage: lang-journey [--harness-control] (got {args})"; return 2
  let bell ← try IO.FS.readFile bellSourcePath catch _ => pure ""
  let bellCore ← try IO.FS.readFile bellCorePath catch _ => pure ""
  -- LB0 the Bell's surface source lowers to exactly the core shipped beside it; one flipped edit is caught
  let (l0, ok0) := match Surface.readPackage bell with
    | .ok want => Surface.shippedRow "LB0" bell bellCore want ("(limit 64)", "(limit 65)")
    | .error e => (s!"LB0 read {bellSourcePath}: {e.text bell}", false)
  IO.println s!"{if ok0 then "ok  " else "FAIL"} {l0}"
  -- LB0d (LANG-60) the Bell states its clock and tie rule in its own doc: one line, printed by the one
  -- printer, read back by the one reader as the same bytes; a doc past `docMax` is refused `badDoc`
  let (ld, okd) := match Surface.readPackage bell with
    | .ok p =>
      let t := Print.bytesText p.doc
      let back := match Read.parse t with
        | .ok y => (match Read.doc 0 [y] with | .ok d => d == p.doc | .error _ => false)
        | .error _ => false
      let says := (t.splitOn "1024").length > 1 && (t.splitOn "ringer digest").length > 1
      let oneLine := !t.contains '\n'
      let long := bell.replace "(doc \"" ("(doc \"" ++ String.ofList (List.replicate Bounds.docMax 'x'))
      let refused := match Surface.readPackage long with
        | .error (.read (.badDoc _)) => true
        | _ => false
      (s!"LB0d the Bell's doc ({p.doc.size} bytes) prints as one line and reads back: {back && oneLine}; it states the window and the tie: {says}; one past docMax refused badDoc: {refused}",
        !p.doc.isEmpty && back && oneLine && says && refused && long != bell)
    | .error e => (s!"LB0d read {bellSourcePath}: {e.text bell}", false)
  IO.println s!"{if okd then "ok  " else "FAIL"} {ld}"
  let runs := [Mode.honest, .skipJudge, .eraseOccasion, .erasePayload, .dropCalls, .rawInstall, .bytesIds,
    .skipLits, .totalDigest, .unlawfulCodec, .dropRangeRow, .foreignRow].map (journey bell)
  let runs := match control, runs with
    | true, r :: rest => note r "harness-control: GATES-15's known-red control, an expectation nothing meets (this run must read RED)" false :: rest
    | _, rs => rs
  for r in runs do for l in r.log do IO.println l
  let bad := (runs.map (·.bad)).foldl (· + ·) ((if ok0 then 0 else 1) + (if okd then 0 else 1))
  IO.println s!"lang-journey: {if bad = 0 then "GREEN" else s!"RED ({bad})"}"
  return if bad = 0 then 0 else 1

end Nanodregg.Lang.Journey
/-
# Kernel.Receive.Ledger — the value receivers: issue, account, transfer (LEDGER-3)

Value itself is the kernel's (`Kernel.Value`, `World.checkValue`): whatever these receivers
derive, `World.admit` refuses a turn that moves a balance sum (`notConserved`), takes a cell
below minus its floor (`belowFloor`), or sets a floor outside a denomination's birth. These
receivers decide only AUTHORITY: who may bear a denomination and its cap (anyone, for a fresh
one), who may hold (anyone, an account of their own), and who may move value out of an account
(its owner, or a grantee of a COUNTED right through a chain that reaches it: `transfer cap` for a
balance, `credit cap` for a well's floor, each use spending the grant's ledger, KERNEL-60; `mutate`
moves no value). There is no solvency
check here: `belowFloor` is the one name for an overdraft, as `stale` is for a stale read.

A denomination is the bytes of its WELL's id. The well is an ordinary account whose floor is the
cap; issuing is a transfer out of it and burning a transfer into it, so value is zero-sum per
denomination from its birth (`Kernel.Proofs.Value.admit_value`).
-/
import Kernel.Receive.Authority

namespace Nanodregg.Kernel.Receive

open Nanodregg.Kernel

variable {D : Type} [Ord D] [DecidableEq D]

/-- An account: a value cell (`Kernel.Value`'s keys) with its owner at `slotOwner`. -/
def kindAccount : Nat := 6

/-- The domain of a keyed account id. -/
def domAccount : String := "nanodregg/kernel/account/v1"

/-- The id of `owner`'s account of denomination `asset` (KERNEL-28 (d)): keyed, so there is one
per pair, and anyone (an object too) can name it without reading a cell. -/
def accountId (X : Ctx D) (owner asset : D) : D :=
  X.env.hash domAccount (X.env.bytes owner ++ X.env.bytes asset)

/-- What `accountId` hashes. -/
def accountPre (X : Ctx D) (owner asset : D) : String × ByteArray :=
  (domAccount, X.env.bytes owner ++ X.env.bytes asset)

/-- The id an account reference names. -/
def AcctRef.resolve (X : Ctx D) : AcctRef D → D
  | .well a => a
  | .of o a => accountId X o a

/-- The domain of a transfer's once-only nullifier. -/
def domOnce : String := "nanodregg/kernel/once/v1"

/-- The nullifier a `once` key spends: namespaced by the source account, so a signer spends
only keys in the namespace of a source it has authority over. -/
def onceNullifier (X : Ctx D) (src : D) (key : ByteArray) : D :=
  X.env.hash domOnce (X.env.bytes src ++ key)

/-- An account born for `owner`, of denomination `denom`, balance 0, floor `floor`. -/
def accountCell (X : Ctx D) (owner : D) (denom : ByteArray) (floor : Nat) : Cell :=
  { kind := kindAccount, discipline := .value,
    slots := slotsOf [(slotOwner, X.env.bytes owner), (Value.denomKey, denom),
      (Value.balanceKey, Value.balanceBytes 0), (Value.floorKey, Value.floorBytes floor)] }

/-- A pinned live account and the value it holds. -/
def readAccount (look : Pinned D) (c : D) : Except (Refusal D) (Cell × Value) := do
  let cell ← readKind look c kindAccount
  match Value.ofCell cell with
  | some v => pure (cell, v)
  | none => .error (.malformedCell c Value.balanceKey)

/-- The pinned live account a reference names, with its id; a `.well` reference must name a well
(its denomination is its own id's bytes), `notWell` otherwise. -/
def readRef (X : Ctx D) (look : Pinned D) (r : AcctRef D) : Except (Refusal D) (D × Cell × Value) := do
  let id := r.resolve X
  let (cell, v) ← readAccount look id
  match r with
  | .well a => req (decide (v.denom = X.env.bytes a)) (.notWell a)
  | .of _ _ => pure ()
  pure (id, cell, v)

/-- The largest cap: a well at minus its cap is still an `i64`. -/
def capMax : Nat := 2 ^ 63

/-- `issue cap`: the well, its id its fresh born id, its denomination that id's bytes. -/
def issue (X : Ctx D) (c : Call D) (a : At D) (cap : Nat) : Except (Refusal D) (Draft D) := do
  let well := cellIdOf X.env (txIdOf X c) a.base
  req (decide (cap ≤ capMax)) (.overflow well)
  pure ⟨bornAt X c a.base [accountCell X a.actor (X.env.bytes well) cap], [], [], []⟩

/-- `account asset owner`: the empty account of the asset's denomination owned by `owner`, at its
keyed id. Anyone may open anyone's (it is empty, floor 0, and only its owner can debit it); a
second open of the pair is `World.admit`'s `idTaken`. It does not read the well, so opening an
account never pins the hot cell. -/
def account (X : Ctx D) (asset owner : D) : Except (Refusal D) (Draft D) :=
  pure ⟨[(accountId X owner asset, accountCell X owner (X.env.bytes asset) 0)], [], [], []⟩

/-- The write setting an account's balance. -/
def setBalance (b : Int) : Act := .write [.set Value.balanceKey (Value.balanceBytes b)]

/-- `transfer src dst amount via once`: both referenced accounts pinned, live and of one
denomination; the signer has `src`'s owner's authority, directly or through `via`'s chain for
`transfer` (KERNEL-60), whose grant then spends `amount` of its cap (`transferSpent` past what is
left); both post balances are `i64`s. Two effects, the grant's ledger the third, and the once key's
nullifier. -/
def transfer (X : Ctx D) (look : Pinned D) (a : At D) (srcR dstR : AcctRef D) (amount : Nat)
    (via : Option D) (once : Option ByteArray) : Except (Refusal D) (Draft D) := do
  let (src, scell, sv) ← readRef X look srcR
  let (dst, _, dv) ← readRef X look dstR
  let _ ← ownerAuthority X look a.actor src scell (.transfer 0) via
  req (decide (src ≠ dst)) .sameAccount
  req (decide (0 < amount)) .zeroAmount
  req (decide (dv.denom = sv.denom)) (.assetMismatch dst)
  let sb := sv.balance - amount
  let db := dv.balance + amount
  req (Value.fits sb) (.overflow src)
  req (Value.fits db) (.overflow dst)
  let spend ← spendVia look transferBase via amount .transferSpent
  pure ⟨[], [(src, setBalance sb), (dst, setBalance db)] ++ spend.toList,
    (once.map (onceNullifier X src)).toList, []⟩

/-- The write setting an account's floor. -/
def setFloor (f : Nat) : Act := .write [.set Value.floorKey (Value.floorBytes f)]

/-- `credit well acct amount via` (LEDGER-4): a credit line is a floor transfer out of the well.
Extending credit IS issuing (minidregg FLOORS-LOG: setFloor's verb was mintAsset), so it is the
issuer's: the well's owner. The kernel conserves the denomination's floor sum, so a credit line
can only be carved from the well's unissued headroom: past it the well goes below its own floor,
`belowFloor`. Past the well's whole floor (a Nat cannot go negative), `overflow`. Through `via`, the
chain is for `credit` and its grant spends `amount` of its cap (`creditSpent`, KERNEL-60). -/
def credit (X : Ctx D) (look : Pinned D) (a : At D) (well : D) (acctR : AcctRef D) (amount : Nat)
    (via : Option D) : Except (Refusal D) (Draft D) := do
  let (wcell, wv) ← readAccount look well
  let (acct, _, av) ← readRef X look acctR
  let _ ← ownerAuthority X look a.actor well wcell (.credit 0) via
  req (decide (wv.denom = X.env.bytes well)) (.notWell well)
  req (decide (well ≠ acct)) .sameAccount
  req (decide (0 < amount)) .zeroAmount
  req (decide (av.denom = wv.denom)) (.assetMismatch acct)
  req (decide (amount ≤ wv.floor)) (.overflow well)
  req (decide (av.floor + amount ≤ capMax)) (.overflow acct)
  let spend ← spendVia look creditBase via amount .creditSpent
  pure ⟨[], [(well, setFloor (wv.floor - amount)), (acct, setFloor (av.floor + amount))] ++ spend.toList,
    [], []⟩

end Nanodregg.Kernel.Receive


/- Translation validation versus internal transport, Ringer et al. (2021) p7;
Viola–Fan–Ringer (2025) pp1–2. -/
import Lang.Contextual.RepairObjects

namespace Nanodregg.Lang.Contextual.TransportKinds

/-- Distinct data constructors record how a claim is justified; Valid is a separate Prop
(Ringer p7; Viola pp1–2). Merely constructing a claim is not evidence of validity. -/
inductive Claim (D : CalculusData) (E : Type) where
  | rechecked (evidence : RepairObjects.TransportEvidence D E)
  | internal (source target : Candidate D)

/-- Rechecked claims can be emitted only after the existing transport operation succeeds
(Ringer et al. p7). -/
def recheck {D : CalculusData} {E : Type} (registry : RepairObjects.Registry D E)
    (certificate : Nat) (w : World E) (c : Candidate D) (cost : Nat) :
    Except RepairObjects.TransportRefusal (Claim D E) :=
  match RepairObjects.transport registry certificate w c cost with
  | .error e => .error e
  | .ok (.transported ev) => .ok (.rechecked ev)
  | .ok (.existing _) => .error .unknownCertificate

/-- Quotient by the declared observable, permitting multiple concrete representatives
(Viola et al. p2). -/
abbrev Observed (A V : Type) (observe : A → V) :=
  Quot (fun a b : A => observe a = observe b)

/-- The quotient's observation is well-defined (Viola et al. pp1–2). -/
def observation {A V : Type} (observe : A → V) : Observed A V observe → V :=
  Quot.lift observe (fun _ _ h => h)

/-- Lift an observation-preserving representation map to quotients. The required proof is
kernel checked, not a Boolean recheck (Viola et al. p2). -/
def liftMap {A B V : Type} (a : A → V) (b : B → V) (f : A → B)
    (h : ∀ x, b (f x) = a x) : Observed A V a → Observed B V b :=
  Quot.lift (fun x => Quot.mk _ (f x)) (by
    intro x y he
    apply Quot.sound
    exact (h x).trans (he.trans (h y).symm))


/-- Consume the actual offered candidate from either evidence form; admission still goes
through the existing propose/select operations (Ringer p7; Viola pp1–2). -/
def Claim.destination {D : CalculusData} {E : Type} : Claim D E → Candidate D
  | .rechecked ev => ev.image
  | .internal _ target => target

end Nanodregg.Lang.Contextual.TransportKinds
/- Concrete CMTT trace sessions. All fixtures use the landed calculus, not a toy checker. -/
import Lang.Contextual.Trace
import Lang.Contextual.CoreCalculus

namespace Nanodregg.Lang.Contextual.Trace.Examples

/-- A guard reading exactly the filling's variable key; Mokhov et al. 2018, §4.2.2 p.79:14. -/
def guard : Guard cmttData Nat Nat where
  reads := fun t => match t with | .var i => [i] | _ => []
  run := fun _ vs => vs.all (fun n => n > 0)

/-- Two real context hypotheses, one token-backed; Mokhov et al. 2018, §4.2.2 p.79:14. -/
def iface : Iface cmttData (Nat → Nat) where
  name := 10
  ctx := [.base, .base]
  ty := .base
  hyps := [(0, ⟨2, 0⟩)]
  hyps_real := by intro h hh; simp at hh; subst h; rfl
  guard := fun _ _ => true
  budget := 3
  chooser := 0
  acceptor := 1

/-- Positive, negative, and implicit hypothesis dependencies; Mokhov et al. 2018, §4.2.2 p.79:14. -/
def candidate (i : Nat) : Candidate cmttData :=
  ⟨.var i, if i = 0 then [⟨1, 0⟩] else [], if i = 0 then [⟨3, 0⟩] else [],
   1, 0, .conflict .illTyped⟩

/-- A complete initial world; Mokhov et al. 2018, §4.2.2 p.79:14. -/
def world : World (Nat → Nat) := ⟨fun t => t.id == 1 || t.id == 2, fun _ => 1⟩

/-- Change one environment key; Mokhov et al. 2018, Def.2.1 p.79:3. -/
def envEdit (k v : Nat) : World (Nat → Nat) :=
  { world with env := fun j => if j = k then v else world.env j }

/-- Two initialized candidate traces; Mokhov et al. 2018, §4.2.2 p.79:15. -/
def cached : List (Cached cmttData Nat) :=
  [seed guard iface world (candidate 0), seed guard iface world (candidate 1)]

/-- One pass at a new world; Mokhov et al. 2018, Def.2.1 p.79:3. -/
def run (w : World (Nat → Nat)) : Pass cmttData Nat := repair guard iface w cached 0

end Nanodregg.Lang.Contextual.Trace.Examples
/-
# Lang.Proofs.Contextual.Negotiation — the integration experiment (lane PROTOCOL)

The proposal's document 3 first integration experiment: two parties negotiate a ONE-USE capability
with ALTERNATIVE providers, a DEADLINE and a CANCELLATION path. The open protocol
(`Negotiation.template`: reserve the deposit, then an `ours` provider hole) is judged once, under
hypotheses (`Γ₀`: both providers' authority, the deadline); each candidate (`plan p1`, `plan p2`,
`cancelPlan`) is a filling checked against the hole's interface; admission asks the CURRENT world.
The four changes, each forced to say which operation it is:

* an unrelated update: a reused derivation (`unrelated_update_keeps_plan`, by `admits_local`;
  `unrelated_update_repair_reuses`);
* a provider's authority withdrawn: that instantiation unavailable, the open protocol and the
  other candidates intact, the residual obligation explicit (`provider_revoked_unavailable`,
  `revocation_repair`);
* a representation change: transport along a checked (partial) correspondence, and a STALE
  representation refused (`representation_change_transports`, `stale_opening_refused`);
* a replayed or competing commitment: refused by durable consumption (`replay_refused`,
  `competing_commitments`), and the gap between internal at-most-once and external exactly-once
  (`internal_once_not_external_once`, `exactly_once_needs_reply_and_dedupe`, over the internal
  record READ OFF the histories `lost p`, `H₀`, `answeredH p b` by `Internal.ofHist`).

And the deadline (`deadline_expires`), the cancellation path (`cancel_path_refunds_obligation`),
the lost reply and the answered call (`lost_reply_keeps_obligation`, `lost_reply_blocks_replan`,
`answered_blocks_replan`, `guard_stricter_than_wf`, `guarded_replan_after_dispatch_is_noop`)
against the free re-plan before dispatch
(`replan_before_dispatch`).
-/
import Lang.Proofs.Contextual.Protocol

namespace Nanodregg.Lang.Contextual.Protocol.Negotiation

/-- THE DELIVERY MODEL (an assumption of this experiment; the proposal supplies none): an external
run CONSISTENT with an internal record. A spent nullifier means one dispatch, which the network may
deliver any number of times (including zero, if the reply is lost); an answered reply means at
least one delivery; an unspent nullifier means none. Under a lost reply this constrains NOTHING:
every external run is consistent with it, which is the point. -/
def Consistent (i : Internal) (e : External) : Prop :=
  (i.capSpent = false → e.deliveries = 0) ∧ (i.reply.isSome = true → 1 ≤ e.deliveries) ∧
    (i.reply.isSome = true → i.capSpent = true)

/-! ## The open protocol is judged; every candidate fills the hole -/

/-- The template is judged: `Ω; Γ₀; [cap] ⊢ template : Protocol(idle, True) ⊣ Φ₀`. -/
theorem template_hasProt : HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ template :=
  .call (S := sig) Op.reserve _ rfl (by simp [spec]) (by simp [spec, Φ₀])
    fun _ => .hole () iface rfl rfl (by simp [iface, Γ₀]) (SubBag.refl _) (fun _ _ _ => trivial)
      (by simp [iface, Φ₀])

/-- Each provider's plan satisfies the hole's interface (spends the capability once, uses that
provider's authority and the deadline, owes that provider's payment). -/
theorem plan_fills (p : Provider) : Fills spec Ω iface (plan p) := by
  refine ⟨.spend (S := sig) (Op.commit p) _ .cap rfl (by simp [iface]) ?_ ?_
    fun _ => .ret _ trivial, trivial⟩
  · cases p <;> simp [spec, iface]
  · cases p <;> simp [spec, iface]

/-- The cancellation path satisfies the hole's interface. -/
theorem cancel_fills : Fills spec Ω iface cancelPlan :=
  ⟨.call (S := sig) Op.cancel _ rfl (by simp [spec]) (by simp [spec, iface])
    fun _ => .ret _ trivial, trivial⟩

theorem choose_ok {f : P .reserved} (hf : Fills spec Ω iface f) : SubstOK spec Ω (choose f) := by
  intro i h g hs
  cases i with
  | idle => exact nomatch h
  | done => exact nomatch h
  | reserved =>
    cases h
    cases hs
    exact ⟨iface, rfl, rfl, hf⟩

/-- Family 1, instance: every candidate's instantiation is judged at the template's judgment. -/
theorem instantiations_hasProt :
    (∀ p, HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ (fill Ω (choose (plan p)) template)) ∧
      HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ (fill Ω (choose cancelPlan) template) :=
  ⟨fun p => fill_preserves_hasProt (choose_ok (plan_fills p)) template_hasProt,
    fill_preserves_hasProt (choose_ok cancel_fills) template_hasProt⟩

/-- Family 2, instance: running the instantiation against a delivering provider is running the
template with the choice in the environment; both compute the same outcome. -/
theorem interpret_instance :
    interpret (env true) (subst (choose (plan .p1)) template) 0 =
        interpretUnder (env true) (choose (plan .p1)) template 0 ∧
      (match interpret (env true) (subst (choose (plan .p1)) template) 0 with
        | .done j a n => decide (j = .done) && a && decide (n = 2)
        | .stuck _ _ _ => false) = true :=
  ⟨by rw [interpret_fill], rfl⟩

/-- The open protocol has exactly one hole, the provider; every instantiation has none. -/
theorem holes_instance :
    (holes finite template).length = 1 ∧ Occurs template .reserved () ∧
      (∀ p, holes finite (fill Ω (choose (plan p)) template) = []) ∧
      holes finite (fill Ω (choose cancelPlan) template) = [] := by
  refine ⟨rfl, (mem_holes_iff finite template .reserved ()).mp
      (by simp [holes, template, finite]; exact ⟨rfl, HEq.rfl⟩),
    fun p => ?_, rfl⟩
  cases p <;> rfl

/-! ## Change 1: an unrelated state update -/

/-- **An unrelated update keeps the plan**: an update to the unrelated store, or to the OTHER
provider's authority, leaves the plan's admission as it was: the keys its admission reads
(`opSupport`) are untouched, so `admits_local` reuses the verdict. -/
theorem unrelated_update_keeps_plan (w : World) (g : Nat → Nat) :
    admits spec ({ w with other := g }).view (plan .p1) = admits spec w.view (plan .p1) ∧
      admits spec (w.revoke .p2).view (plan .p1) = admits spec w.view (plan .p1) := by
  refine ⟨rfl, ?_⟩
  show admitOp spec (View.ofStore (w.revoke .p2).store) (S := sig) (Op.commit .p1) =
    admitOp spec (View.ofStore w.store) (S := sig) (Op.commit .p1)
  apply admits_local
  intro k hk
  simp [opSupport, spec] at hk
  rcases hk with rfl | rfl | rfl <;> rfl

/-- The same as selective repair: after a change to `auth p2` only `plan p2`'s fragment is
re-checked (the affected list), and the repaired verdicts are those of a full re-check. -/
theorem unrelated_update_repair_reuses :
    repair frags (fromScratch frags w0.store) [.inl (.auth .p2)] (w0.revoke .p2).store =
        fromScratch frags (w0.revoke .p2).store ∧
      repair frags (fromScratch frags w0.store) [.inl (.auth .p2)] (w0.revoke .p2).store =
        [true, false, true] ∧
      (frags.map fun f => f.affected [.inl (.auth .p2)]) = [false, true, false] := by
  refine ⟨repair_agrees_from_scratch frags ?_ ?_, rfl, rfl⟩
  · intro f hf
    simp only [frags, List.mem_cons, List.not_mem_nil, or_false] at hf
    rcases hf with rfl | rfl | rfl <;> exact admitFrag_readsOnly _ _ _
  · intro k hk
    rcases k with (⟨p⟩ | _) | ⟨⟩ <;> (try cases p) <;> simp_all [World.store, World.view, World.revoke, w0]

/-! ## Change 2: a provider's authority withdrawn -/

/-- **Provider revoked → that instantiation unavailable**: with `p1`'s authority withdrawn,
`plan p1` is still DERIVABLE (it fills the hole, its instantiation is judged) but not ADMISSIBLE
now; the open protocol stays judged and the other candidates stay available. -/
theorem provider_revoked_unavailable :
    available w0 = [1, 2, 3] ∧ available (w0.revoke .p1) = [2, 3] ∧
      Fills spec Ω iface (plan .p1) ∧ admits spec (w0.revoke .p1).view (plan .p1) = false ∧
      HasProt spec Ω Γ₀ (fun _ _ => True) Φ₀ Δ₀ template ∧
      admits spec (w0.revoke .p1).view (plan .p2) = true :=
  ⟨rfl, rfl, plan_fills .p1, rfl, template_hasProt, rfl⟩

/-- The revocation as selective repair: only `plan p1`'s fragment is affected; the repair agrees
with a full re-check; the explicit residual obligation names exactly that fragment. -/
theorem revocation_repair :
    repair frags (fromScratch frags w0.store) [.inl (.auth .p1)] (w0.revoke .p1).store =
        fromScratch frags (w0.revoke .p1).store ∧
      residual frags (repair frags (fromScratch frags w0.store) [.inl (.auth .p1)]
        (w0.revoke .p1).store) = [1] ∧
      (frags.map fun f => f.affected [.inl (.auth .p1)]) = [true, false, false] := by
  refine ⟨repair_agrees_from_scratch frags ?_ ?_, rfl, rfl⟩
  · intro f hf
    simp only [frags, List.mem_cons, List.not_mem_nil, or_false] at hf
    rcases hf with rfl | rfl | rfl <;> exact admitFrag_readsOnly _ _ _
  · intro k hk
    rcases k with (⟨p⟩ | _) | ⟨⟩ <;> (try cases p) <;> simp_all [World.store, World.view, World.revoke, w0]

/-! ## Change 3: a change of representation -/

/-- The correspondence back is a left inverse of the representation at the current epoch. -/
theorem current_at (E : Nat) (t : Tok) : ((t.at E).current E).getD .cap = t := by
  cases t; simp [Tok.at, Tok'.current]

/-- **Representation change transports**: re-issuing the capability's opening under epoch `E` (a
partial correspondence: only epoch-`E` openings name the token) carries the open protocol's
judgment over, and every effect is admissible against the world's epoch-`E` view exactly when it
was against the old view. -/
theorem representation_change_transports (E : Nat) :
    HasProt (spec.mapTok (Tok.at E)) (Ω.mapTok (Tok.at E)) Γ₀ (fun _ _ => True) Φ₀
        (Δ₀.map (Tok.at E)) template ∧
      ∀ (w : World) {i : Phase} (op : Op i),
        admitOp (spec.mapTok (Tok.at E)) (w.viewAt E) (S := sig) op =
          admitOp spec w.view (S := sig) op := by
  refine ⟨hasProt_mapTok (e' := fun t => (t.current E).getD .cap) (current_at E) template_hasProt, fun w _ op => ?_⟩
  cases op <;> simp [admitOp, Spec.mapTok, spec, World.viewAt, Tok.at, Tok'.current]

/-- **A stale opening is refused**: a commitment that presents the capability under an epoch other
than the current one is not admissible, whatever the providers' authority and the nullifier. -/
theorem stale_opening_refused (w : World) {E E' : Nat} (h : E' ≠ E) (p : Provider) :
    admitOp (spec.mapTok (Tok.at E')) (w.viewAt E) (S := sig) (Op.commit p) = false := by
  simp [admitOp, Spec.mapTok, spec, World.viewAt, Tok.at, Tok'.current, h]

/-! ## Change 4: replayed and competing commitments -/

/-- **Competing commitments**: after any successful commitment, no commitment (to either
provider) is admitted: the nullifier is durable. -/
theorem competing_commitments (w w' : World) (p q : Provider)
    (h : w.commit (Op.commit p) = some w') : w'.commit (Op.commit q) = none := by
  unfold World.commit at h
  split at h
  · simp only [spec, Option.some.injEq] at h
    subst h
    simp [World.commit, admitOp, World.view, spec]
  · cases h

/-- **Replay refused**: from day 0 the commitment to `p1` succeeds; replaying it, or committing to
`p2` instead, is refused; the cancellation (which spends nothing) is still admitted. -/
theorem replay_refused :
    (w0.commit (Op.commit .p1)).isSome = true ∧
      (∀ w', w0.commit (Op.commit .p1) = some w' →
        w'.commit (Op.commit .p1) = none ∧ w'.commit (Op.commit .p2) = none ∧
          (w'.commit Op.cancel).isSome = true) := by
  refine ⟨rfl, fun w' h => ⟨competing_commitments _ _ _ _ h, competing_commitments _ _ _ _ h, ?_⟩⟩
  simp only [World.commit] at h
  cases h
  rfl

/-- The internal records the histories leave. -/
theorem internal_of_histories (p : Provider) (b : Bool) :
    Internal.ofHist (lost p) = ⟨true, none⟩ ∧ Internal.ofHist H₀ = ⟨false, none⟩ ∧
      Internal.ofHist (answeredH p b) = ⟨true, some b⟩ := by
  cases p <;> cases b <;> exact ⟨rfl, rfl, rfl⟩

/-- **Internal once is not external once**: the history with the commitment to `p` in flight
(nullifier spent, reply lost) is consistent, under the delivery model, with the service performed
ZERO times and ONE time even by a deduplicating provider; the history with the reply answered is
consistent, without deduplication, with TWO executions. The internal at-most-once consumption alone
concludes neither exactly-once nor at-most-once outside. -/
theorem internal_once_not_external_once (p : Provider) :
    Consistent (Internal.ofHist (lost p)) ⟨0, true⟩ ∧ External.executions ⟨0, true⟩ = 0 ∧
      Consistent (Internal.ofHist (lost p)) ⟨1, true⟩ ∧ External.executions ⟨1, true⟩ = 1 ∧
      Consistent (Internal.ofHist (answeredH p true)) ⟨2, false⟩ ∧
        External.executions ⟨2, false⟩ = 2 ∧
      ¬ ∀ e, Consistent (Internal.ofHist (lost p)) e → e.dedupe = true → e.executions = 1 := by
  obtain ⟨hl, _, ha⟩ := internal_of_histories p true
  rw [hl, ha]
  refine ⟨by simp [Consistent], rfl, by simp [Consistent], rfl, by simp [Consistent], rfl, ?_⟩
  intro h
  have := h ⟨0, true⟩ (by simp [Consistent]) rfl
  simp [External.executions] at this

/-- **What the model CAN conclude, per history**: before dispatch (`H₀`) the service was not
performed; after an ANSWERED commitment, a deduplicating provider performed it exactly once. The
remaining fact (a deduplicating provider performs at most once, whatever the history) is the
provider's, not the history's: it needs no `Consistent` premise. -/
theorem exactly_once_needs_reply_and_dedupe (p : Provider) :
    (∀ e, Consistent (Internal.ofHist H₀) e → e.executions = 0) ∧
      (∀ b e, Consistent (Internal.ofHist (answeredH p b)) e → e.dedupe = true →
        e.executions = 1) ∧
      (∀ e : External, e.dedupe = true → e.executions ≤ 1) := by
  refine ⟨?_, ?_, ?_⟩
  · intro e h
    have := h.1 rfl
    simp [External.executions, this]
  · intro b e h hd
    rw [(internal_of_histories p b).2.2] at h
    have := h.2.1 rfl
    simp [External.executions, hd]
    omega
  · intro e hd
    simp only [External.executions, hd, if_true]
    exact Nat.min_le_right _ _

/-! ## The deadline and the cancellation path -/

/-- **The deadline expires**: once the clock reaches the deadline no commitment is admissible,
to either provider, whatever their authority; the cancellation path stays admissible. -/
theorem deadline_expires (w : World) (hd : w.deadline ≤ w.now) :
    (∀ p, admits spec w.view (plan p) = false) ∧ admits spec w.view cancelPlan = true ∧
      available { w0 with now := 10 } = [3] := by
  refine ⟨fun p => ?_, rfl, rfl⟩
  simp [admits, plan, admitOp, spec, World.view, Nat.not_lt.mpr hd]

/-- **The cancellation path refunds**: every complete run of the plan with the cancellation
chosen establishes exactly the deposit and its refund, and no payment. -/
theorem cancel_path_refunds_obligation {t : Trace sig} {j : Phase} {a : Res j}
    (h : Runs (fill Ω (choose cancelPlan) template) t j a) :
    established spec t = [.holdDeposit, .refund] := by
  change Runs (Prot.call (S := sig) Op.reserve fun _ => cancelPlan) t j a at h
  cases h with
  | call r h =>
    cases h with
    | call r' h =>
      cases h
      rfl

/-- The contrast: every complete run with `p` chosen establishes the deposit and `p`'s payment,
and no refund. -/
theorem commit_path_pays (p : Provider) {t : Trace sig} {j : Phase} {a : Res j}
    (h : Runs (fill Ω (choose (plan p)) template) t j a) :
    established spec t = [.holdDeposit, .pay p] := by
  change Runs (Prot.call (S := sig) Op.reserve fun _ => plan p) t j a at h
  cases h with
  | call r h =>
    cases h with
    | call r' h =>
      cases h
      rfl

/-! ## The lost reply -/

theorem reach_reserved (f : P .reserved) :
    Reach (fill Ω (choose f) template) [reserved] ⟨Phase.reserved, f⟩ :=
  Reach.call (S := sig) (op := Op.reserve) (k := fun _ => f) () (Reach.here _)

theorem reach_hole : Reach template [reserved] ⟨Phase.reserved, .hole ()⟩ :=
  Reach.call (S := sig) (op := Op.reserve)
    (k := fun _ => Prot.hole (S := sig) (Hole := HoleN) (A := Res) (i := Phase.reserved) ()) () (Reach.here _)

theorem started_lost (p : Provider) : Started (fill Ω (choose (plan p)) template) (lost p) :=
  Started.uncertain (S := sig) (k := fun ok => .ret ok) (reach_reserved (plan p))

theorem dispatched_lost (p : Provider) : Dispatched template (lost p) .reserved () :=
  ⟨[reserved], [], rfl, reach_hole, .inr rfl⟩

/-- **A lost reply keeps the dispatched call's obligation**: the history with the commitment to
`p` in flight is a history of the plan; it has established `p`'s payment (from dispatch); and the
provider hole counts as entered. -/
theorem lost_reply_keeps_obligation (p : Provider) :
    Started (fill Ω (choose (plan p)) template) (lost p) ∧
      (lost p).established spec = [.holdDeposit, .pay p] ∧
      Dispatched template (lost p) .reserved () ∧ (obj (plan p) (lost p)).WF spec :=
  ⟨started_lost p, rfl, dispatched_lost p,
    ⟨template_hasProt, choose_ok (plan_fills p), started_lost p⟩⟩

/-- With the commitment to `p1` in flight, neither the other provider's plan nor the cancellation
has that history. -/
theorem lost_reply_not_started :
    ¬ Started (fill Ω (choose (plan .p2)) template) (lost .p1) ∧
      ¬ Started (fill Ω (choose cancelPlan) template) (lost .p1) := by
  constructor
  · intro h
    obtain ⟨R, hr, hc⟩ := started_some_iff.mp h
    change Reach (Prot.call (S := sig) Op.reserve fun _ => plan .p2) [reserved] R at hr
    cases hr with
    | call r hr =>
      cases hr
      cases hc
  · intro h
    obtain ⟨R, hr, hc⟩ := started_some_iff.mp h
    change Reach (Prot.call (S := sig) Op.reserve fun _ => cancelPlan) [reserved] R at hr
    cases hr with
    | call r hr =>
      cases hr
      cases hc

/-- **Uncertain is not a license to re-plan**: with the commitment to `p1` in flight, the guard
`Replan` refuses switching to `p2` or to the cancellation, and dropping the guard would produce an
object that is not well-formed (its history is no history of the new protocol). The guard is
SUFFICIENT (`Open.resubst_wf`); it is also STRICTER than well-formedness needs
(`guard_stricter_than_wf`). -/
theorem lost_reply_blocks_replan :
    ¬ (obj (plan .p1) (lost .p1)).Replan (choose (plan .p2)) ∧
      ¬ ((obj (plan .p1) (lost .p1)).replan (choose (plan .p2))).WF spec ∧
      ¬ (obj (plan .p1) (lost .p1)).Replan (choose cancelPlan) ∧
      ¬ ((obj (plan .p1) (lost .p1)).replan (choose cancelPlan)).WF spec := by
  refine ⟨fun g => ?_, fun hw => lost_reply_not_started.1 hw.started,
    fun g => ?_, fun hw => lost_reply_not_started.2 hw.started⟩
  · have := g .reserved () (dispatched_lost .p1)
    simp [obj, Subst.ours, Ω, iface, choose, plan] at this
    obtain ⟨h, _⟩ := this
    injection h with h
    cases h
  · have := g .reserved () (dispatched_lost .p1)
    simp [obj, Subst.ours, Ω, iface, choose, plan, cancelPlan] at this

/-- The provider hole counts as entered once the commitment is ANSWERED too. -/
theorem dispatched_answered (p : Provider) (b : Bool) :
    Dispatched template (answeredH p b) .reserved () :=
  ⟨[reserved], [⟨.reserved, Op.commit p, b⟩], rfl, reach_hole, .inl (by simp)⟩

/-- **The answered half**: after the commitment to `p1` is answered (the history extends past the
hole by a performed call), the object is well-formed; the guard refuses switching to `p2`, and
dropping it fails well-formedness. -/
theorem answered_blocks_replan (b : Bool) :
    (obj (plan .p1) (answeredH .p1 b)).WF spec ∧
      ¬ (obj (plan .p1) (answeredH .p1 b)).Replan (choose (plan .p2)) ∧
      ¬ ((obj (plan .p1) (answeredH .p1 b)).replan (choose (plan .p2))).WF spec := by
  refine ⟨⟨template_hasProt, choose_ok (plan_fills .p1), ?_⟩, fun g => ?_, fun hw => ?_⟩
  · have h2 : Reach (plan .p1) [⟨.reserved, Op.commit .p1, b⟩] ⟨Phase.done, .ret b⟩ :=
      Reach.call (S := sig) (op := Op.commit .p1) (k := fun ok => Prot.ret (S := sig) (Hole := HoleN)
        (A := Res) (i := Phase.done) ok) b (Reach.here _)
    exact Started.settled (reach_append (reach_reserved (plan .p1)) h2)
  · have := g .reserved () (dispatched_answered .p1 b)
    simp [obj, Subst.ours, Ω, iface, choose, plan] at this
    obtain ⟨h, _⟩ := this
    injection h with h
    cases h
  · have h := hw.started
    change Started (Prot.call (S := sig) Op.reserve fun _ => plan .p2) (answeredH .p1 b) at h
    cases h with
    | settled hr =>
      cases hr with
      | call r hr => cases hr

theorem planFlip_fills (p : Provider) : Fills spec Ω iface (planFlip p) := by
  refine ⟨.spend (S := sig) (Op.commit p) _ .cap rfl (by simp [iface]) ?_ ?_
    fun _ => .ret _ trivial, trivial⟩
  · cases p <;> simp [spec, iface]
  · cases p <;> simp [spec, iface]

/-- **The guard is stricter than well-formedness**: re-planning the in-flight `p1` commitment to
`planFlip p1` (the SAME first call, a different continuation) yields a well-formed object (the
history is still a history of it), yet `Replan` refuses it, because the guard compares fillings,
not the parts the history has performed. -/
theorem guard_stricter_than_wf :
    ((obj (plan .p1) (lost .p1)).replan (choose (planFlip .p1))).WF spec ∧
      ¬ (obj (plan .p1) (lost .p1)).Replan (choose (planFlip .p1)) := by
  refine ⟨⟨template_hasProt, choose_ok (planFlip_fills .p1),
    Started.uncertain (S := sig) (k := fun ok => .ret (!ok)) (reach_reserved (planFlip .p1))⟩,
    fun g => ?_⟩
  have := g .reserved () (dispatched_lost .p1)
  simp [obj, Subst.ours, Ω, iface, choose, plan, planFlip] at this
  have := congrFun this true
  simp at this

/-- So every GUARDED re-plan after the dispatch leaves the current protocol exactly as it was. -/
theorem guarded_replan_after_dispatch_is_noop (p : Provider) (σ' : Subst sig HoleN Res)
    (g : (obj (plan p) (lost p)).Replan σ') :
    ((obj (plan p) (lost p)).replan σ').current = (obj (plan p) (lost p)).current := by
  have e : σ'.ours Ω Phase.reserved () = (choose (plan p)).ours Ω Phase.reserved () :=
    g .reserved () (dispatched_lost p)
  show Prot.call (S := sig) Op.reserve (fun _ => subst (σ'.ours Ω) (.hole (i := Phase.reserved) ())) =
    Prot.call (S := sig) Op.reserve (fun _ => subst ((choose (plan p)).ours Ω) (.hole (i := Phase.reserved) ()))
  congr 1
  funext x
  have e' : σ'.ours Ω (sig.next Op.reserve x) () =
      (choose (plan p)).ours Ω (sig.next Op.reserve x) () := e
  simp only [subst]
  rw [e']

/-- **Before dispatch, re-planning is a free substitution**: reserved but nothing dispatched, the
provider hole is not entered; the object re-planned from `p1` to `p2` (or to the cancellation) is
well-formed with the same history. -/
theorem replan_before_dispatch (f : P .reserved) (hf : Fills spec Ω iface f) :
    ¬ Dispatched template H₀ .reserved () ∧
      (obj (plan .p1) H₀).Replan (choose f) ∧ ((obj (plan .p1) H₀).replan (choose f)).WF spec ∧
        ((obj (plan .p1) H₀).replan (choose f)).hist = H₀ := by
  have hnd : ∀ j h, ¬ Dispatched template H₀ j h := by
    rintro j h ⟨t₁, t₂, ht, hr, hne⟩
    cases t₁ with
    | nil => cases hr
    | cons e t₁ =>
      simp only [H₀, List.cons_append, List.cons.injEq] at ht
      obtain ⟨rfl, ht⟩ := ht
      have h1 : t₁ = [] := (List.append_eq_nil_iff.mp ht.symm).1
      have h2 : t₂ = [] := (List.append_eq_nil_iff.mp ht.symm).2
      subst h1 h2
      rcases hne with hne | hne
      · exact hne rfl
      · cases hne
  have hwf : (obj (plan .p1) H₀).WF spec :=
    ⟨template_hasProt, choose_ok (plan_fills .p1), Started.settled (reach_reserved (plan .p1))⟩
  refine ⟨hnd _ _, fun j h hd => (hnd j h hd).elim, ?_⟩
  obtain ⟨hw, hh, _⟩ := Open.resubst_wf hwf (choose_ok hf) (fun j h hd => (hnd j h hd).elim)
  exact ⟨hw, hh⟩

/-! ## Shared parameters over substitutions (doc 2 section 4) -/

/-- The buyer's guard on a completion: the provider hole is filled with `p1`'s plan. -/
def BuyerGuard (θ : Subst sig HoleN Res) : Prop := θ .reserved () = some (plan .p1)

/-- The authority condition in world `w`: the filling of the provider hole is admissible now. -/
def AdmittedIn (w : World) (θ : Subst sig HoleN Res) : Prop :=
  ∃ f, θ .reserved () = some f ∧ admits spec w.view f = true

/-- **Separate witnesses are insufficient, over substitutions**: in the world where `p1`'s
authority is withdrawn, a typed completion satisfies the buyer's guard (`plan p1`) and a typed
completion is admitted (`plan p2`), but the completion space, ONE `θ` for typing, the guard,
authority and resources, is empty. -/
theorem separate_witnesses_over_substitutions :
    (∃ θ, SubstOK spec Ω θ ∧ BuyerGuard θ) ∧ (∃ θ, SubstOK spec Ω θ ∧ AdmittedIn (w0.revoke .p1) θ) ∧
      ¬ ∃ θ, Conds.space ⟨SubstOK spec Ω, BuyerGuard, AdmittedIn (w0.revoke .p1),
        fun θ => ∀ f, θ .reserved () = some f → Fills spec Ω iface f⟩ θ := by
  refine ⟨⟨choose (plan .p1), choose_ok (plan_fills .p1), rfl⟩,
    ⟨choose (plan .p2), choose_ok (plan_fills .p2), plan .p2, rfl, rfl⟩, ?_⟩
  rintro ⟨θ, _, hg, ⟨f, hf, ha⟩, _⟩
  rw [show θ .reserved () = some (plan .p1) from hg] at hf
  cases hf
  have hfalse : admits spec (w0.revoke .p1).view (plan .p1) = false := rfl
  rw [hfalse] at ha
  cases ha

end Nanodregg.Lang.Contextual.Protocol.Negotiation


import Lang.Journey
set_option maxHeartbeats 200000
open Nanodregg.Lang.Journey

def main (args : List String) : IO UInt32 := do
  let mode := args.headD "control"
  let src := match mode with
    | "deadline" => p8Text.replace "((<= req.validUntil state.closes) \"closed\")" ""
    | "support" => p8Text.replace "((deq v.pin s.pin) \"support0 moved\")" ""
    | "accepted" => p8Text.replace "((not state.accepted) \"accepted\")" ""
    | _ => p8Text
  let r := p8Session src
  for line in r.log do IO.println line
  IO.println s!"P8-{mode}: {if r.bad = 0 then "GREEN" else s!"RED ({r.bad})"}"
  return if r.bad = 0 then 0 else 1

  return r


/-! P8: one Store, one writer, one atomic turn across the hole and value cells.
The checked commitment re-executes the selected method; it never resumes a saved
effectful continuation. The grant is the kernel's counted Right.transfer 1.
Toy cryptographic parameters are those of the rest of this journey. -/

/-- Compose the generated checked select with one atomic transfer. The selected
row edit and accepted state remain in the same ordinary method result. -/
def p8CommitPackage (p : Package) : Except String Package := do
  let .record ts := p.iface | throw "P8 interface"
  let .record fs := p.body | throw "P8 root"
  let some select := Row.find? "select" fs | throw "P8 select"
  let some (.fn R (.fn _ (.fn _ (.fn _ SR)))) := Row.find? "select" ts | throw "P8 select type"
  let A := Ty.record [("asset", .digest), ("cand", .digest), ("grant", .digest)]
  let C := callOf ["transfer"]
  let RT := resultTy p.state [C] (editTy p.rels) 1
  let arg (l : Label) := Term.get (.var 2) l
  let transfer := Term.inj C "transfer" (.record [
    ("amount", .nat 1),
    ("dst", .inj acctRefTy "of" (.record [("asset", arg "asset"), ("owner", arg "cand")])),
    ("once", .inj (optTy .bytes) "none" (.record [])),
    ("src", .inj acctRefTy "well" (arg "asset")),
    ("via", .inj (optTy .digest) "some" (arg "grant"))])
  let finish := resultT (callsT [someCallT C transfer])
    (.extend (.get (.var 0) "state") [("accepted", .bool true)])
    (.get (.var 0) "edits")
  let selected := Std.activityApply select [.var 3, .var 2,
    .record [("cand", .get (.var 1) "cand")], .var 0]
  let body := Term.lam R (.lam p.state (.lam A (.lam reqTy
    (.ite (.prim .le (.get (.var 0) "validUntil") (.get (.var 2) "closes"))
      (.app (.lam SR finish) selected) (.refuse RT "closed".toUTF8)))))
  return { p with
    iface := .record (Row.sort (ts ++ [("commit", methodTy p.state A [C] R (editTy p.rels) 1)])),
    body := .record (Row.sort (fs ++ [("commit", body)])),
    methods := (Row.sort ((p.methods ++ ["commit"]).map (·, ()))).map (·.1) }

/-- Core source for the generated root plus atomic commitment. Placeholder
library identities are linked to actual installed helpers by p8Rows. -/
def p8Text : String :=
  match Std.generatedHoleBundle with
  | .error _ => ""
  | .ok b => match p8CommitPackage { b.layout with
        imports := b.libraries.map fun _ => ByteArray.mk (Array.replicate 32 (0 : UInt8)) } with
    | .error _ => ""
    | .ok p => (Print.package p).getD ""

/-- The provider index's old/new wire representation. This is a finite data schema,
not a substitute typechecker for Lang packages; the package is installed normally. -/
def p8Data : Contextual.CalculusData where
  Ty := Bool
  Ctx := Unit
  Tm := Nat × Bool
  tmEq := inferInstance
  msubst _ t := t
  check _ t ty := t.2 == ty
  uses _ _ := false
  drop _ _ := ()
  strengthen _ t := t
  weaken _ t := t
  var n := (n, false)
  lookup _ _ := none

def p8Guard : Contextual.Trace.Guard p8Data Nat Bool :=
  ⟨fun t => [t.1], fun _ vs => vs.all id⟩

def p8Iface (repr : Bool) : Contextual.Iface p8Data (Nat → Bool) :=
  p8Guard.install ⟨0, (), repr, [], by simp, fun _ _ => true, 1, 0, 1⟩

def p8Candidate (i : Nat) : Contextual.Candidate p8Data :=
  ⟨(i, false), [], [], 1, 0, .verified⟩

def p8Swap (t : Nat × Bool) : Nat × Bool := (t.1, !t.2)
def p8Correspondence : Contextual.RepairObjects.Correspondence p8Data (Nat → Bool) :=
  ⟨p8Iface false, p8Iface true, p8Swap, p8Swap⟩
def p8Registry : Contextual.RepairObjects.Registry p8Data (Nat → Bool) :=
  fun n => if n = 8 then some p8Correspondence else none

/-- Authority is read from the live kernel view, at the recorded version.
A tombstoned grant or a changed pin cannot specialize to true. -/
def p8World (w : World D) (supports : List (D × D)) : Contextual.World (Nat → Bool) :=
  ⟨fun _ => false, fun i => match supports[i]? with
    | none => false
    | some (g, pin) => (w.live Sim.env g).isSome && (pinOf Sim.env (w.entry Sim.env g) == pin)⟩

def p8Available (w : World D) (supports : List (D × D)) : List Bool :=
  (Contextual.P9.provenance (p8Iface false) [p8Candidate 0, p8Candidate 1]).map
    (fun m => m.eval (p8Iface false) (p8World w supports))

def p8Arg (asset cand grant : D) : ByteArray :=
  argBytes (.record [("asset", .digest), ("cand", .digest), ("grant", .digest)])
    (.record [("asset", .digest (Sim.dc.bytes asset)), ("cand", .digest (Sim.dc.bytes cand)),
      ("grant", .digest (Sim.dc.bytes grant))])

/-- Read the REAL grant ledger, not an auxiliary spent flag. -/
def p8Left (w : World D) (g : D) : Option Nat :=
  (w.live Sim.env g).bind fun c => match ledgerLeft transferBase g c with
    | .ok (_, n) => some n
    | .error _ => none

def p8Rows (r0 : Run) (a b : Sim.Member) (src : String := p8Text) : Run := Id.run do
  let mut r := r0
  let runs := match control, runs with
    | true, r :: rest => note r "harness-control: GATES-15's known-red control, an expectation nothing meets (this run must read RED)" false :: rest
    | _, rs => rs
  for r in runs do for l in r.log do IO.println l
  let bad := (runs.map (·.bad)).foldl (· + ·) ((if ok0 then 0 else 1) + (if okd then 0 else 1) + (if activityOk then 0 else 1))
  IO.println s!"lang-journey: {if bad = 0 then "GREEN" else s!"RED ({bad})"}"
  return if bad = 0 then 0 else 1

end Nanodregg.Lang.Journey

def main : IO UInt32 := do
  let r := Nanodregg.Lang.Journey.p8Session
  for l in r.log do IO.println l
  IO.println s!"P8 adapted: {if r.bad = 0 then "GREEN" else s!"RED ({r.bad})"}"
  return if r.bad = 0 then 0 else 1
/- A guarded hole: retained candidates, withdrawable facts and blocker reasons.
Acceptance dispatches the selected value as an ordinary activity. -/
import Lang.StdActivity

namespace Nanodregg.Lang.Std

def holeState : Ty := .record [("accepted", .bool), ("acceptor", .digest),
  ("cap", .nat), ("chooser", .digest), ("closes", .nat), ("selected", optTy .digest)]

def holeSupport : Ty := .record [("cell", .digest), ("pin", .digest)]

def holeStatus : Ty := .sum [("conflict", .bytes), ("pruned", .bytes),
  ("suspended", .bytes), ("verified", .record [])]

def holeCandidate (V : Ty) : Ty := .record [
  ("blocker", optTy holeSupport), ("by", .digest), ("reason", .bytes),
  ("s0", optTy holeSupport), ("s1", optTy holeSupport), ("status", holeStatus), ("value", V)]

def holeCandidates (V : Ty) : RelDecl :=
  ⟨[("cand", .digest)], holeCandidate V, 64, none, 0, false, some "proposed"⟩

def holeFacts : RelDecl := ⟨[("cell", .digest)],
  .record [("by", .digest), ("pin", .digest)], 64, none, 0, true, some "posted"⟩

/-- A read of at most three fact rows: two positive supports and one blocker.
Matching is by cell identity, never by the order in which the pins arrived. -/
def holeFactsView : Ty := readsTy [("facts", holeFacts)] [("facts", ⟨3, none⟩)]

/-- Internal judgment preserves each refusal name until it is rendered either
as a retained row status or a method refusal. -/
def holeVerdict : Ty := .sum [
  ("conflict", .record []), ("pruned", .record []),
  ("support0Moved", .record []), ("support0Withdrawn", .record []),
  ("support1Moved", .record []), ("support1Withdrawn", .record []),
  ("verified", .record [])]

private abbrev H := List Label → Term
private def hv (x : Label) : H := fun sc => .var (sc.idxOf x)
private def hc (t : Term) : H := fun _ => t
private def hg (t : H) (l : Label) : H := fun sc => .get (t sc) l
private def hr (fs : List (Label × H)) : H :=
  fun sc => .record (Row.sort (fs.map fun (l, t) => (l, t sc)))
private def hi (T : Ty) (l : Label) (t : H) : H := fun sc => .inj T l (t sc)
private def hl (x : Label) (T : Ty) (t : H) : H := fun sc => .lam T (t (x :: sc))
private def ha (f : H) (xs : List H) : H := fun sc => activityApply (f sc) (xs.map (· sc))
private def hf (t : H) (arms : List (Label × Label × H)) : H :=
  fun sc => .case (t sc) (Row.sort (arms.map fun (l, x, b) => (l, b (x :: sc))))
private def ht (c a b : H) : H := fun sc => .ite (c sc) (a sc) (b sc)
private def hp (p : Prim) (a b : H) : H := fun sc => .prim p (a sc) (b sc)
private def he (T : Ty) (a b : H) : H := fun sc => eqData T (a sc) (b sc)
private def hu (t : H) (fs : List (Label × H)) : H :=
  fun sc => .extend (t sc) (Row.sort (fs.map fun (l, b) => (l, b sc)))
private def hn : H := hr []
private def hb (b : Bool) : H := hc (.bool b)
private def hs (s : String) : H := hc (.bytes s.toUTF8)
private def hnone (T : Ty) : H := hi (optTy T) "none" hn
private def hsome (T : Ty) (t : H) : H := hi (optTy T) "some" t


private def hlet (name : Label) (T : Ty) (value body : H) : H :=
  ha (hl name T body) [value]

/-- One point's observation: absent 0, same token 1, moved version 2. -/
def holeProbePoint : Term :=
  (hl "s" holeSupport (hl "point" (pointTy holeFacts)
    (hf (hv "point") [
      ("none", "_", hc (.nat 0)),
      ("some", "p", ht (hp .deq (hg (hg (hv "p") "key") "cell") (hg (hv "s") "cell"))
        (hf (hg (hv "p") "val") [
          ("none", "_", hc (.nat 0)),
          ("some", "f", ht (hp .deq (hg (hv "f") "pin") (hg (hv "s") "pin"))
            (hc (.nat 1)) (hc (.nat 2)))])
        (hc (.nat 0)))]))) []

/-- Bounded lookup by identity. Bind the probe once; its syntax is not copied
into every continuation branch. Real row views have at most one point per key. -/
def holeSupportProbe : Term :=
  let pointTy := Ty.fn holeSupport (.fn (pointTy holeFacts) .nat)
  let probe (i : Label) := ha (hv "probe") [hv "s", hg (hg (hv "rows") "facts") i]
  let anyEq (n : Nat) := ht (hp .eq (hv "p0") (hc (.nat n))) (hb true)
    (ht (hp .eq (hv "p1") (hc (.nat n))) (hb true) (hp .eq (hv "p2") (hc (.nat n))))
  (hl "s" holeSupport (hl "rows" holeFactsView
    (hlet "probe" pointTy (hc holeProbePoint)
      (hlet "p0" .nat (probe "p0") (hlet "p1" .nat (probe "p1")
        (hlet "p2" .nat (probe "p2")
          (ht (anyEq 1) (hc (.nat 1)) (ht (anyEq 2) (hc (.nat 2)) (hc (.nat 0)))))))))) []

/-- Presence is independent of liveness: an observed absent row is covered,
but an omitted point is not. Keys are rows under self, never cell pins. -/
def holePointCovered : Term :=
  (hl "s" holeSupport (hl "point" (pointTy holeFacts)
    (hf (hv "point") [
      ("none", "_", hb false),
      ("some", "p", hp .deq (hg (hg (hv "p") "key") "cell") (hg (hv "s") "cell"))]))) []

/-- Complete observation of one declared support key in the bounded self view. -/
def holeSupportCovered : Term :=
  let P := Ty.fn holeSupport (.fn (pointTy holeFacts) .bool)
  let probe (i : Label) := ha (hv "present") [hv "s", hg (hg (hv "rows") "facts") i]
  (hl "s" holeSupport (hl "rows" holeFactsView
    (hlet "present" P (hc holePointCovered)
      (ht (probe "p0") (hb true) (ht (probe "p1") (hb true) (probe "p2")))))) []

/-- The emitted complete-observation adapter's finite collector. All declared
supports and blockers must be observed before any verdict, even a conflict.
Missing observations refuse by role; observed absence still reaches rejudge. -/
def holeCoverageCheck : Term :=
  (hl "s0" .bool (hl "s1" .bool (hl "blocker" .bool
    (ht (hv "s0")
      (ht (hv "s1")
        (ht (hv "blocker") (hb true) (hc (.refuse .bool "pruned".toUTF8)))
        (hc (.refuse .bool "support1 withdrawn".toUTF8)))
      (hc (.refuse .bool "support0 withdrawn".toUTF8)))))) []

/-- Coverage expressions use the candidate's declared keys, not a caller's
claimed read set. Missing optional dependencies need no observation. -/
def holeCoverageTerms : List Term :=
  let covered (name : Label) := hf (hg (hv "c") name)
    [("none", "_", hb true),
     ("some", "s", ha (hv "covered") [hv "s", hv "rows"])]
  (["s0", "s1", "blocker"].map covered).map (· ["covered", "rows", "c", "state"])

def holeVerdictLabel (allowed blocked : Bool) (s0 s1 : Nat) : Label :=
  if !allowed then "conflict" else if blocked then "pruned"
  else if s0 != 1 then (if s0 = 2 then "support0Moved" else "support0Withdrawn")
  else if s1 != 1 then (if s1 = 2 then "support1Moved" else "support1Withdrawn")
  else "verified"

/-- The fixed judgment truth table, as executable core code. -/
def holeDecision : Term :=
  let verdict (l : Label) := hi holeVerdict l hn
  (hl "allowed" .bool (hl "blocked" .bool (hl "s0" .nat (hl "s1" .nat
    (ht (hv "allowed")
      (ht (hv "blocked") (verdict "pruned")
        (ht (hp .eq (hv "s0") (hc (.nat 1)))
          (ht (hp .eq (hv "s1") (hc (.nat 1))) (verdict "verified")
            (ht (hp .eq (hv "s1") (hc (.nat 2)))
              (verdict "support1Moved") (verdict "support1Withdrawn")))
          (ht (hp .eq (hv "s0") (hc (.nat 2)))
            (verdict "support0Moved") (verdict "support0Withdrawn"))))
      (verdict "conflict")))))) []

/-- Observation expressions in scope probe, rows, candidate, state. Each term
reads the actual clause or a concrete optional support from the pinned view. -/
def holeObservationTerms (clause : Term) : List Term :=
  let probe (s : H) := ha (hv "probe") [s, hv "rows"]
  let support (name : Label) := hf (hg (hv "c") name)
    [("none", "_", hc (.nat 1)), ("some", "s", probe (hv "s"))]
  let blocked := hf (hg (hv "c") "blocker") [
    ("none", "_", hb false),
    ("some", "s", hp .eq (probe (hv "s")) (hc (.nat 1)))]
  ([ha (hc clause) [hv "state", hg (hv "c") "value"],
    blocked, support "s0", support "s1"] : List H).map (· ["probe", "rows", "c", "state"])

/-- The state clause, blocker and supports are recomputed from the pinned view.
The candidate's recorded status is never trusted. -/
def holeJudge (V : Ty) (clause : Term) : Term :=
  let probeTy := Ty.fn holeSupport (.fn holeFactsView .nat)
  .lam holeState (.lam (holeCandidate V) (.lam holeFactsView
    (.app (.lam probeTy (activityApply holeDecision (holeObservationTerms clause)))
      holeSupportProbe)))

/-- The receive-path judge first collects the complete declared observation.
This wrapper is shared by propose, fill, select, accept, prune and rejudge. -/
def holeCheckedJudge (V : Ty) (clause : Term) : Term :=
  let coveredTy := Ty.fn holeSupport (.fn holeFactsView .bool)
  .lam holeState (.lam (holeCandidate V) (.lam holeFactsView
    (.app (.lam coveredTy
      (.app (.lam .bool (activityApply (holeJudge V clause) [.var 4, .var 3, .var 2]))
        (activityApply holeCoverageCheck holeCoverageTerms)))
      holeSupportCovered)))

/-- Render judgment into the row while keeping the pruning reason separately
on the candidate even after its blocker is withdrawn. -/
def holeStatusOf : Term :=
  (hl "reason" .bytes (hl "verdict" holeVerdict
    (hf (hv "verdict") [
      ("conflict", "_", hi holeStatus "conflict" (hs "clause")),
      ("pruned", "_", hi holeStatus "pruned" (hv "reason")),
      ("support0Moved", "_", hi holeStatus "suspended" (hs "support0 moved")),
def p8Rows (r0 : Run) (a b : Sim.Member) (src : String := p8Text) : Run := Id.run do
  let mut r := r0
  let prog := langProgram
  let X := ctxWith prog
  let p ← match Surface.readPackage src with
    | .ok p => pure p
    | .error e => return note r s!"P8 read: {e.text src}" false
  let bundle ← match Std.generatedHoleBundle with
    | .error e => return note r s!"P8 generate helpers: {e.name}" false
    | .ok b => pure b
  let mut libraryIds : List D := []
  for lib in bundle.libraries do
    let some bytes := Wire.encodePackage lib | return note r "P8 helper bytes" false
    let (rL, vL, tL) := go prog r (Sim.signed r.st a a.key
      (Sim.S.pinsFor r.st.host [a.id]) (.install bytes))
    r := note rL s!"P8 install checked helper ({bytes.size} bytes): {vL}"
      (vL == "admitted" && bytes.size ≤ Lang.Bounds.bytesMax)
    let some id := tL.bind fun t => (createdIds t).head? | return note r "P8 helper id" false
    libraryIds := libraryIds ++ [id]
  let p := { p with imports := libraryIds.map Sim.dc.bytes }
  let some pb := Wire.encodePackage p | return note r "P8 no package bytes" false
  let some dc := p.rels.lookup "candidates" | return note r "P8 no candidates" false
  let some df := p.rels.lookup "facts" | return note r "P8 no facts" false
  let (r1, v1, t1) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host (a.id :: libraryIds)) (.install pb))
  r := note r1 s!"P8 install checked open artifact ({pb.size} bytes): {v1}" (v1 == "admitted")
  let some pkg := t1.bind fun t => (createdIds t).head? | return r
  let some seed := stateSlots (recordRow p.state)
    [("accepted", .bool false), ("acceptor", .digest (Sim.dc.bytes b.id)), ("cap", .nat 1),
     ("chooser", .digest (Sim.dc.bytes a.id)), ("closes", .nat 100000),
     ("selected", .inj "none" (.record []))] 0 | return note r "P8 seed" false
  let (r2, v2, t2) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host ([a.id, pkg] ++ libraryIds))
    (.create (some pkg) [] seed))
  r := note r2 s!"P8 requester cell: {v2}" (v2 == "admitted")
  let some obj := t2.bind fun t => (createdIds t).head? | return r
  let (r3, v3, t3) := go prog r (Sim.signed r.st b b.key (Sim.S.pinsFor r.st.host [b.id]) (.issue 10))
  r := note r3 s!"P8 B's value cell: {v3}" (v3 == "admitted")
  let some asset := t3.bind fun t => (createdIds t).head? | return r


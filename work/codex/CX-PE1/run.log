theorem journalPigeonhole (E : Env Bool) :
    ∃ a b : ByteArray, a ≠ b ∧ E.hash \"\" a = E.hash \"\" b := by
  let a := ByteArray.mk #[0]
  let b := ByteArray.mk #[1]

namespace Nanodregg.Lang.Contextual.Journal.Teeth

private def rev : Revision := ⟨"claim", "target", "ctx", "defs", "instance", "lean"⟩
private def receipt : Receipt := ⟨rev, "proof", "recipe", [("support", "v0")], .checked, true⟩
private def world : World Store := ⟨fun _ => true, fun k => if k = "support" then some "v0" else none⟩
private def c : Candidate calculus := candidate receipt [⟨1, 0⟩] [] 2

theorem verified_tooth : judge (iface 0 rev 3) world c = .verified := by decide

theorem revision_tooth : receiptCheck receipt { rev with target := "changed" } = false := by decide

theorem success_tooth : receiptCheck { receipt with result := .exhausted } rev = false := by decide

theorem coverage_tooth : receiptCheck { receipt with complete := false } rev = false := by decide

theorem input_tooth :
    judge (iface 0 rev 3) { world with env := fun _ => none } c = .conflict .guardFails := by decide

theorem withdrawal_tooth :
    judge (iface 0 rev 3) (world.set ⟨1, 0⟩ false) c = .suspended [⟨1, 0⟩] := by decide

theorem reissue_tooth :
    judge (iface 0 rev 3) (applyAll (reissue 1 0 1) world) c = .suspended [⟨1, 0⟩] := by decide

theorem cost_tooth : judge (iface 0 rev 1) world c = .uncovered 2 1 := by decide

theorem pruning_reopens_tooth :
    judge (iface 0 rev 3) world { c with blockers := [⟨9, 0⟩] } = .pruned [⟨9, 0⟩] ∧
    judge (iface 0 rev 3) (world.set ⟨9, 0⟩ false) { c with blockers := [⟨9, 0⟩] } = .verified := by decide

theorem alternative_survives_tooth :
    judge (iface 0 rev 3) (world.set ⟨1, 0⟩ false) c = .suspended [⟨1, 0⟩] ∧
    judge (iface 0 rev 3) (world.set ⟨1, 0⟩ false) { c with supports := [⟨2, 0⟩] } = .verified := by decide

end Nanodregg.Lang.Contextual.Journal.Teeth

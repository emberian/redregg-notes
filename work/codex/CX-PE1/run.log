/-
# Lang.Contextual.Closure — the guarded contextual closure `(P, Ω, σ, D, support, Φ, t)`

The object of ACTIVITIES-PROPOSAL doc 2 §9, over an ABSTRACT calculus (its data `CalculusData` here, its laws
`CalculusLaws` in the proof module), so the theory
does not wait on a particular CMTT core. Two instances exist: the toy of
`Lang.Proofs.Contextual.Experiments`, and the CMTT core's, `Lang/Proofs/Contextual/CoreInstance.lean`,
which lands as the second commit.

Limits, stated: fillings are typed in the EMPTY meta-context (`HasTy [] Ψ M A`: no hole inside a
hole's filling); supports are one level (tokens, never another hole's selection), so a support cycle
is not expressible here; an environment edit touches every candidate (dependency sets are
sufficient, not minimal).

* `P, Ω` — the retained `Template`: a term typed under an open interface of holes `u :: [Ψ ⊢ A]`,
  each with its guard, budget, hypothesis tokens and POLARITY (`chooser`, `acceptor`). Kept apart
  from every environment: resubstitution needs it.
* `σ` — `Closure.sigma`: the current partial meta-substitution, the selected filling per hole.
* `D` — the selected candidate per hole (`Slot.selected`): WHICH derivation stands behind `σ`. Two
  candidates with one filling and different supports are one `σ` and two `D`s (provenance `ab + c`).
* `support` — `Closure.support`: the tokens the selected candidates rely on (`effSupports`: the
  declared supports plus the hypothesis tokens of every context variable the filling USES).
* `Φ` — `Closure.Φ`: residual obligations (derived from the statuses) plus `owed` (established by
  the accepted history and never derived away).
* `t` — `Closure.hist`: the accepted interaction history, append-only.

A candidate's status is computed by ONE function, `judge`, from the hole's checker and guard, the
world's environment and the liveness of the candidate's dependencies; the status is never the
proposer's opinion. Assumption tokens are immutable and versioned (`Token`); a world says which are
live. Withdrawal is a liveness change: it can suspend, it never refutes (`conflict` is reachable
only from the checker and the guard, which read no token).
-/

namespace Nanodregg.Lang.Contextual

/-! ## The abstract calculus -/

/-- A hole declaration `u :: [Ψ ⊢ A]`: the hole's name, its local context, its type. -/
structure HoleDecl (Ctx Ty : Type) where
  name : Nat
  ctx : Ctx
  ty : Ty

/-- The DATA of a contextual calculus the closure theory uses (its laws, with the typing relation,
are `Lang.Proofs.Contextual.Closure.CalculusLaws`). -/
structure CalculusData where
  Ty : Type
  Ctx : Type
  Tm : Type
  tmEq : DecidableEq Tm
  /-- Simultaneous meta-substitution `⟦σ⟧P` for a PARTIAL `σ` (unfilled holes stay). -/
  msubst : (Nat → Option Tm) → Tm → Tm
  /-- The checker: a proposed filling acquires authority only through it. -/
  check : Ctx → Tm → Ty → Bool
  /-- `uses M x`: the filling mentions hypothesis `x` of its context (free-variable occurrence). -/
  uses : Tm → Nat → Bool
  /-- The context without hypothesis `x`. -/
  drop : Ctx → Nat → Ctx
  /-- Strengthening `t ≡ t₀[π]`: `strengthen x t` is `t₀`, `weaken x` is `π`. -/
  strengthen : Nat → Tm → Tm
  weaken : Nat → Tm → Tm
  /-- The variable term for hypothesis `x`. -/
  var : Nat → Tm
  /-- The type a context gives hypothesis `x`, if it has one. -/
  lookup : Ctx → Nat → Option Ty

instance (D : CalculusData) : DecidableEq D.Tm := D.tmEq

/-! ## Assumption tokens and worlds -/

/-- An immutable, versioned assumption. Re-using an id at a new version is a NEW token: the
proposition a token stands for never changes. -/
structure Token where
  id : Nat
  ver : Nat
deriving DecidableEq, Repr

/-- A world: which tokens are live, and the guard environment (dependent-context parameters). -/
structure World (E : Type) where
  live : Token → Bool
  env : E

variable {E : Type}

def World.set (w : World E) (t : Token) (b : Bool) : World E :=
  { w with live := fun t' => if t' = t then b else w.live t' }

/-- A primitive change of world. -/
inductive Edit (E : Type) where
  | withdraw (t : Token)
  | assert (t : Token)
  | setEnv (e : E)

def Edit.apply : Edit E → World E → World E
  | .withdraw t, w => w.set t false
  | .assert t, w => w.set t true
  | .setEnv e, w => { w with env := e }

/-- Re-issue an id at a new version: the old token is withdrawn and a fresh one asserted. -/
def reissue (id old new : Nat) : List (Edit E) := [.withdraw ⟨id, old⟩, .assert ⟨id, new⟩]

def applyAll : List (Edit E) → World E → World E
  | [], w => w
  | e :: es, w => applyAll es (e.apply w)

/-! ## Holes, candidates, statuses -/

abbrev Party := Nat

/-- A hole's interface: its declaration, the hypotheses of its context backed by tokens, its guard
(the hole's own admissibility condition: the CHECKER of a candidate belongs to the hole, never to the
candidate), its cost budget, and its polarity. -/
structure Iface (D : CalculusData) (E : Type) where
  name : Nat
  ctx : D.Ctx
  ty : D.Ty
  hyps : List (Nat × Token)
  /-- Every token-backed hypothesis is a real hypothesis of the hole's context. -/
  hyps_real : ∀ h ∈ hyps, (D.lookup ctx h.1).isSome = true
  guard : E → D.Tm → Bool
  budget : Nat
  chooser : Party
  acceptor : Party

def Iface.decl {D : CalculusData} (I : Iface D E) : HoleDecl D.Ctx D.Ty := ⟨I.name, I.ctx, I.ty⟩

/-- Checked contrary evidence about ONE candidate (never about the hole). -/
inductive Evidence where
  | illTyped
  | guardFails
deriving DecidableEq, Repr

inductive Status where
  | verified
  /-- the listed supports are not live: what would have to be re-established -/
  | suspended (missing : List Token)
  /-- the listed blockers are live: the retained exclusion argument -/
  | pruned (by_ : List Token)
  | conflict (ev : Evidence)
  /-- correct, but its declared cost exceeds the hole's budget -/
  | uncovered (cost budget : Nat)
deriving DecidableEq, Repr

inductive Obligation where
  /-- hole `u` needs a (new) verified filling -/
  | refill (u : Nat)
  /-- candidate `i` of hole `u` waits on token `t` -/
  | support (u i : Nat) (t : Token)
  /-- the executed selection `i` of hole `u` must be settled -/
  | settle (u i : Nat)
  /-- the executed selection `i` of hole `u` lost its justification after execution -/
  | reconcile (u i : Nat)
deriving DecidableEq, Repr

/-- A retained candidate filling. `status` is the RECORDED status (the last judgment). -/
structure Candidate (D : CalculusData) where
  filling : D.Tm
  supports : List Token
  blockers : List Token
  cost : Nat
/-
# Census.Axioms — one tree-wide axiom check

`#axiom_census "allow.tsv" Kernel Codec …` visits every constant declared in a module whose
name starts with one of the given roots and computes the axioms it depends on. Each one must
be `propext`, `Quot.sound` or `Classical.choice`, or appear in the allow file as
`<declaration>\t<axiom>\t<reason>`. Anything else, `sorryAx` included, is an error naming the
declaration and the axiom. An allow-file row that matches nothing is also an error, so the
list cannot outlive the declaration it excuses.

This replaces per-theorem `#assert_axioms` lines: one census sees every declaration, including
the ones nobody wrote a line for. Nothing outside `Census` may import this module
(`gates/closure.py`).
-/
import Lean

namespace Census.Axioms

open Lean Elab Command

/-- The axioms every declaration may use without an allow-file row. -/
def standardAxioms : List Name := [``propext, ``Quot.sound, ``Classical.choice]

/-- One allow-file row: this declaration may use this axiom. -/
structure Allowance where
  decl : Name
  axiomName : Name
  deriving BEq

/-- Parse `decl<TAB>axiom<TAB>reason` lines; `#` starts a comment line. A malformed line is an
error, never skipped. -/
def parseAllowances (text : String) : Except String (List Allowance) :=
  text.splitOn "\n" |>.foldlM (init := []) fun acc line =>
    let line := line.trimAsciiEnd.toString
    if line.isEmpty || line.startsWith "#" then
      pure acc
    else
      match line.splitOn "\t" with
      | decl :: ax :: reason :: _ =>
        if reason.trimAscii.toString.isEmpty then
          throw s!"allow row without a reason: {line}"
        else
          pure (acc ++ [⟨decl.toName, ax.toName⟩])
      | _ => throw s!"allow row is not decl<TAB>axiom<TAB>reason: {line}"

/-- The module that declared `c`, if it was imported. -/
def moduleOf (env : Environment) (c : Name) : Option Name :=
  env.getModuleIdxFor? c |>.bind fun idx => env.header.moduleNames[idx.toNat]?

/-- Whether a module belongs to one of the census roots. -/
def underRoots (roots : List Name) (m : Name) : Bool :=
  roots.any fun r => r.isPrefixOf m

syntax (name := axiomCensus) "#axiom_census " str ident+ : command

@[command_elab axiomCensus]
def elabAxiomCensus : CommandElab
  | `(#axiom_census $path:str $roots:ident*) => do
    let roots := roots.toList.map (·.getId)
    let text ← IO.FS.readFile path.getString
    let allowances ← match parseAllowances text with
      | .ok a => pure a
      | .error e => throwError e
    let env ← getEnv
    let mut checked := 0
    let mut bad : Array String := #[]
    let mut used : Array Allowance := #[]
    for (c, _) in env.constants.map₁.toList do
      let some m := moduleOf env c | continue
      unless underRoots roots m do continue
      checked := checked + 1
      let axioms ← liftCoreM (collectAxioms c)
      for ax in axioms do
        if standardAxioms.contains ax then continue
        let row : Allowance := ⟨c, ax⟩
        if allowances.contains row then
          used := used.push row
        else
          bad := bad.push s!"{c} ({m}) uses {ax}"
    for row in allowances do
      unless used.contains row do
        bad := bad.push s!"allow row matches nothing: {row.decl} {row.axiomName}"
    if bad.isEmpty then
      logInfo m!"AXIOM-CENSUS ok: {checked} declarations, {allowances.length} allowed rows"
    else
      throwError m!"AXIOM-CENSUS red ({bad.size}):\n{String.intercalate "\n" bad.toList}"
  | _ => throwUnsupportedSyntax

end Census.Axioms
/-
# nanodregg — the one build (owner: BUILD-GATES; every layer adds its own `lean_lib`).

The file is a table, not a program: gates/tree.py reads it with a strict grammar and refuses any
top-level form it does not know (closure C0). The forms are
  * `package nanodregg where leanOptions := …` — warnings are errors, no auto-bound implicits;
  * `@[default_target] lean_lib X where globs := #[.submodules `X]` — one per layer directory,
    every file in X/ built, no umbrella module, no orphan (C1);
  * `@[default_target] lean_exe «name» where root := `M` — M holds only `main` (C7);
  * `extern_lib «ndhost»` — every Host/c/*.c, cc -Wall -Wextra -Werror, into libndhost.a. The only
    C in the tree; built from source, never a prebuilt object (ROOT ruling 2026-10-16).
No packages: Lean core and Std only (decisions/gates.md GATES-1). A bare `lake build` builds
every target, so it can never succeed by building nothing.
-/
import Lake
open Lake DSL System

package nanodregg where
  leanOptions := #[⟨`autoImplicit, false⟩, ⟨`relaxedAutoImplicit, false⟩, ⟨`warningAsError, true⟩]

-- The axiom census command (Census.Axioms): build tooling, the only place `import Lean` is
-- allowed; nothing outside Census may import it (gates/closure.py C2, C5).
@[default_target] lean_lib Census where
  globs := #[.submodules `Census]

@[default_target] lean_lib Kernel where
  globs := #[.submodules `Kernel]

@[default_target] lean_lib Protocol where
  globs := #[.submodules `Protocol]

@[default_target] lean_lib Host where
  globs := #[.submodules `Host]

@[default_target] lean_lib Lang where
  globs := #[.submodules `Lang]

@[default_target] lean_lib Codec where
  globs := #[.submodules `Codec]

@[default_target] lean_lib Hosting where
  globs := #[.submodules `Hosting]

-- LEDGER: packages over the ledger receivers (the escrow), their proofs and their journey.
@[default_target] lean_lib Ledger where
  globs := #[.submodules `Ledger]

-- HOSTING's grain lifecycle through KERNEL's receivers, with its plants (standing's sim stage).
@[default_target] lean_exe «hosting-sim» where
  root := `Hosting.Sim.Main

-- HOSTING's controller: follows one Store (Host.Tail), writes Hosting.Wire actions to grain-launch.
@[default_target] lean_exe «hosting-controller» where
  root := `Hosting.Main

-- One Lean-planned launch for launcher/tests/isolation.rs (a stand-in controller without a Store).
@[default_target] lean_exe «hosting-drive» where
  root := `Hosting.DriveMain

-- HOSTING's provider-key broker decider: keybroker's child, every ask decided by Hosting.Broker.
@[default_target] lean_exe «hosting-broker» where
  root := `Hosting.BrokerMain

-- nd-members' decider (HOSTING-33): the World's resident grains, nothing else (no clock, no key slots).
@[default_target] lean_exe «hosting-residents» where
  root := `Hosting.ResidentsMain

-- THE BAR's hosted Hermes (HOSTING-27): a resident grain's program; answers its bell through its
-- member socket with what keybroker answers on its broker socket.
@[default_target] lean_exe «resident» where
  root := `Hosting.Resident.Main


-- The Rust copy of the protocol table (client/src/generated.rs). Imports Protocol; nothing imports it.
@[default_target] lean_lib Emit where
  globs := #[.submodules `Emit]

@[default_target] lean_exe «emit-rust» where
  root := `Emit.Main

-- The Rust copy of HOSTING frames (launcher/src/generated.rs). Imports Hosting.Wire; nothing imports it.
@[default_target] lean_exe «emit-hosting» where
  root := `Emit.HostingMain

-- The Rust copy of the broker frames (launcher/src/broker_generated.rs). Imports Hosting.BrokerWire.
@[default_target] lean_exe «emit-broker» where
  root := `Emit.BrokerMain

-- The provider leaf-key pins keybroker ships with (deploy/tls/pins, HOSTING-28). Imports Hosting.Pins.
@[default_target] lean_exe «emit-pins» where
  root := `Emit.PinsMain

-- The codec vectors (gates/codec-vectors.tsv, CODEC-28): a change of meaning under the same tag is red.
@[default_target] lean_exe «codec-vectors» where
  root := `Emit.VectorsMain

-- KERNEL's seeded simulation: `kernel-sim SEED…` (or `--seeds N`), ends `ALL PASS` (standing.sh).
@[default_target] lean_exe «kernel-sim» where
  root := `Kernel.Sim.Main

-- LEDGER's escrow through KERNEL's receivers, with its plants (standing's sim stage); --write-text
-- rewrites world/escrow/Escrow.
@[default_target] lean_exe «ledger-sim» where
  root := `Ledger.Sim.Main

-- LANG's first law end to end: install → create → invoke through KERNEL's receivers.
@[default_target] lean_exe «lang-journey» where
  root := `Lang.Journey.Main

-- LANG's resident check: `ob FORM` reads, checks, prints bytes and id, evaluates, runs a law;
-- no admission (Lang.Resident).
@[default_target] lean_exe «ob» where
  root := `Lang.Resident.Main

-- PROTOCOL's conformance rows: `rows [NAME…]` (rows/run, standing's rows stage), ends `ALL PASS`.
@[default_target] lean_exe «rows» where
  root := `Protocol.Rows.Main

-- Host/c/*.c: the Store's physical IO (Host.File's externs) and a Unix socket's client end (Host.Sock's). Sorted, so the archive is reproducible.
extern_lib «ndhost» pkg := do
  let dir := pkg.dir / "Host" / "c"
  let srcs := (← dir.readDir).filter (·.path.extension == some "c") |>.map (·.path)
    |>.qsort (·.toString < ·.toString)
  let leanInc := (← getLeanIncludeDir).toString
  let objs ← srcs.mapM fun src => do
    let o := pkg.buildDir / "c" / ((src.withExtension "o").fileName.getD "x.o")
    buildO o (← inputTextFile src) #["-I", leanInc] #["-fPIC", "-O2", "-Wall", "-Wextra", "-Werror"]
      "cc" getLeanTrace
  buildStaticLib (pkg.staticLibDir / nameToStaticLib "ndhost") objs

-- The Host's loop end to end over the in-memory disk, with the crash plants (standing: seeds 1 2 3).
@[default_target] lean_exe «host-sim» where
  root := `Host.Sim.Main

-- The deployed Host: `host genesis|serve|follow STORE …` (Host.Cli); the client runs the binary.
@[default_target] lean_exe «host» where
  root := `Host.Main


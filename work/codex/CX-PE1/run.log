\"\"\"Disable each added finite-receipt check in a lane scratch; replay the real kernel teeth.\"\"\"
import argparse
from pathlib import Path
import json
from journal_pilot import HERE, lean, write
from journal import canonical

def main():
    p=argparse.ArgumentParser()
    p.add_argument(\"--out\",type=Path,required=True)
    a=p.parse_args()
    a.out.mkdir(parents=True,exist_ok=False)
    source=(HERE/\"Lang/Contextual/Journal.lean\").read_text()
    changes={
        \"revision\": (\"decide (r.revision = rev)\", \"true\"),
        \"successful\": (\"decide (r.result = .checked)\", \"true\"),
        \"complete\": (\"&& r.complete\", \"&& true\"),
        \"inputs\": (\"r.inputs.all fun p => decide (w p.1 = some p.2)\", \"true\"),
    }
    receipts=[]
    teeth=HERE/\"Lang/Proofs/Contextual/JournalTeeth.lean\"
    control=lean(teeth,a.out/\"control.log\",[HERE/\".lake/build/lib/lean\"])
    assert control[\"exit\"]==0, \"unmutated teeth must pass\"
    for name,(old,new) in changes.items():
        folder=a.out/name
        rel=Path(\"Lang/Contextual/Journal.lean\")
        assert source.count(old)==1
        path=folder/rel
        write(path,source.replace(old,new))
        search=[folder/\"lib\",HERE/\".lake/build/lib/lean\"]
        built=lean(path,folder/\"build.log\",search,folder/\"lib\"/rel.with_suffix(\".olean\"))
        assert built[\"exit\"]==0, built
        tooth=lean(teeth,folder/\"tooth.log\",search)
        output=Path(tooth[\"output\"]).read_text()
        assert tooth[\"exit\"]"'!=0 and not tooth["harness_errors"], tooth
        # Expected diagnostics originate in this real compiler invocation, never a fake print.
        lines=[dict(line=i,text=s) for i,s in enumerate(output.splitlines(),1) if "error:" in s]
        assert lines, output
        receipt=dict(check=name,build=built,tooth=tooth,real_expected_lines=lines)
        receipts.append(receipt)
        print(canonical(receipt),flush=True)
    write(a.out/"receipts.json",canonical(receipts)+"'"\\n\")
    print(\"FOUR RECEIPT-CHECK PLANTS GREEN\",flush=True)

if __name__==\"__main__\":
    main()

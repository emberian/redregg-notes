/-- **Follower soundness.** Two logs of one length that reach one chain from one start are one
log with one roots digest after every step, or two of the inputs the two chains compare collide
(`chainPres` of both logs: each step's link and step digest), provided every step of both logs is
bounded (an admitted or recorded step always is: `fold_bounded`). With `fold_chain` and
`fold_steps`: a follower holding a trusted `(steps, chain)` holds the only log that produces it. -/
theorem chain_binds [Ord D] {E : Env D} {n : Nat} (hE : E.Lawful n) {c : D} :
    ∀ (k : Nat) (l₁ l₂ : List (Step D × D)), l₁.length = k → l₂.length = k →
      (∀ p ∈ l₁, p.1.Bounded) → (∀ p ∈ l₂, p.1.Bounded) →
      chainOf E c l₁ = chainOf E c l₂ → l₁ = l₂ ∨ CollidesAmong E.hash (chainPres E c l₁ ++ chainPres E c l₂)
  | 0, l₁, l₂, h₁, h₂, _, _, _ => by
      rw [List.length_eq_zero_iff] at h₁ h₂; subst h₁; subst h₂; exact Or.inl rfl
  | k + 1, l₁, l₂, h₁, h₂, hl₁, hl₂, h => by
      rcases List.eq_nil_or_concat l₁ with rfl | ⟨a₁, ⟨t₁, r₁⟩, rfl⟩
      · simp at h₁
      rcases List.eq_nil_or_concat l₂ with rfl | ⟨a₂, ⟨t₂, r₂⟩, rfl⟩
      · simp at h₂
      simp only [List.concat_eq_append] at h h₁ h₂ hl₁ hl₂ ⊢
      rw [chainOf_concat, chainOf_concat] at h
      rw [chainPres_concat, chainPres_concat]
      rcases stepLink_inj hE (hl₁ _ (List.mem_append_right _ (List.mem_singleton_self _)))
          (hl₂ _ (List.mem_append_right _ (List.mem_singleton_self _))) h with ⟨hc, rfl, rfl⟩ | hcol
      · simp only [List.length_append, List.length_singleton, Nat.add_right_cancel_iff] at h₁ h₂
        rcases chain_binds hE k a₁ a₂ h₁ h₂ (fun p hp => hl₁ p (List.mem_append_left _ hp))
            (fun p hp => hl₂ p (List.mem_append_left _ hp)) hc with rfl | hcol
        · exact Or.inl rfl
        · refine Or.inr (CollidesAmong.mono (fun x hx => ?_) hcol)
          simp only [List.mem_append] at hx ⊢
          rcases hx with hx | hx <;> simp [hx]
      · refine Or.inr (CollidesAmong.mono (fun x hx => ?_) hcol)
        simp only [List.mem_append] at hx ⊢
        rcases hx with hx | hx <;> simp [hx]

/-- TOOTH (`headLink_inj`): under a hash that separates the two links' inputs, one link is one
(predecessor, kind, digest, roots digest). -/
theorem headLink_inj_sep [Ord D] {E : Env D} {n : Nat} (hE : E.Lawful n)
    {c₁ c₂ d₁ d₂ r₁ r₂ : D} {g₁ g₂ : UInt8}
    (hs : Separates E.hash [linkPre E c₁ g₁ d₁ r₁, linkPre E c₂ g₂ d₂ r₂])
    (h : headLink E c₁ g₁ d₁ r₁ = headLink E c₂ g₂ d₂ r₂) : c₁ = c₂ ∧ g₁ = g₂ ∧ d₁ = d₂ ∧ r₁ = r₂ :=
  hs.elim (headLink_inj hE h)

/-- TOOTH (`refusedDigest_inj`). -/
theorem refusedDigest_inj_sep [Ord D] {E : Env D} {n : Nat} (hE : E.Lawful n) {r₁ r₂ : Refused D}
    (hb₁ : checkRefusedBounds r₁ = .ok ()) (hb₂ : checkRefusedBounds r₂ = .ok ())
    (hs : Separates E.hash [refusedPre E r₁, refusedPre E r₂])
    (h : refusedDigest E r₁ = refusedDigest E r₂) : r₁ = r₂ :=
  hs.elim (refusedDigest_inj hE hb₁ hb₂ h)

/-- TOOTH (`stepLink_inj`): under a hash that separates the two steps' inputs, one link is one step. -/
theorem stepLink_inj_sep [Ord D] {E : Env D} {n : Nat} (hE : E.Lawful n)
    {c₁ c₂ : D} {r₁ r₂ : D} {s₁ s₂ : Step D} (hb₁ : s₁.Bounded) (hb₂ : s₂.Bounded)
    (hs : Separates E.hash (stepPres E c₁ s₁ r₁ ++ stepPres E c₂ s₂ r₂))
    (h : stepLink E c₁ s₁ r₁ = stepLink E c₂ s₂ r₂) : c₁ = c₂ ∧ s₁ = s₂ ∧ r₁ = r₂ :=
  hs.elim (stepLink_inj hE hb₁ hb₂ h)

/-- TOOTH (`chain_binds`): under a hash that separates the inputs both chains compare, one chain is
one log. -/
theorem chain_binds_sep [Ord D] {E : Env D} {n : Nat} (hE : E.Lawful n) {c : D}
    {l₁ l₂ : List (Step D × D)} (hl : l₁.length = l₂.length)
    (hb₁ : ∀ p ∈ l₁, p.1.Bounded) (hb₂ : ∀ p ∈ l₂, p.1.Bounded)
    (hs : Separates E.hash (chainPres E c l₁ ++ chainPres E c l₂))
    (h : chainOf E c l₁ = chainOf E c l₂) : l₁ = l₂ :=
  hs.elim (chain_binds hE l₁.length l₁ l₂ rfl hl.symm hb₁ hb₂ h)

end Chain

variable {D : Type} [Ord D] [DecidableEq D]

theorem fold_cons_ok {E : Env D} {w w'' : World D} {t : Step D} {rest : List (Step D)} :
    World.fold E w (t :: rest) = .ok w'' ↔
      ∃ w', World.step E w t = .ok w' ∧ World.fold E w' rest = .ok w'' := by
  conv => lhs; unfold World.fold
  cases ha : World.step E w t with
          · exact .inl he
          · exact .inr (CollAmong.tails S c)
        · simp only [climbPres, pathPres, hk]
          exact .inr (CollAmong.heads S h hx)
      · simp only [hk] at h
        by_cases hx : nodePre S b' s (climb S k rest (termHash S term)) = nodePre S b (l.hashOf S) (r.hashOf S)
        · obtain ⟨rfl, hxy⟩ := node_bytes l2 l1 (tagged_inj hx).2
          simp only [proveAt, climbPres, pathPres, hk]
          rcases climb_sound k (b' + 1) r rest term hwr ha (hN _ _ _ _ hxy).2 with he | c
          · exact .inl he
          · exact .inr (CollAmong.tails S c)
        · simp only [climbPres, pathPres, hk]
          exact .inr (CollAmong.heads S h hx)

variable [DecidableEq D]

/-- **Inclusion is sound.** A proof that verifies against a well-formed, routed trie's root shows
the digest of the value the trie holds at the key, or two of the byte strings the read compares
collide (`readPres`: the proof's against the trie's path). -/
theorem inclusion_sound {t : T K V D} {k : K} {dig : D} {p : Proof K D} (hw : WF S t)
    (hr : Routed S 0 t) (hv : verifyInclusion S (t.hashOf S) k dig p = true) :
    (∃ v, t.get S k = some v ∧ S.vdigest v = dig) ∨ CollAmong S (readPres S k p t) := by
  unfold verifyInclusion at hv
  cases ht : p.term with
  | none => simp [ht] at hv
  | some kds =>
      simp only [ht, Bool.and_eq_true, decide_eq_true_eq] at hv
      rcases climb_sound S hL hN k 0 t p.sibs p.term hw hv.1 (by rw [ht]; exact hv.2.2) with he | c
      · rw [ht] at he
        exact .inl (proveAt_some_getAt S k 0 t kds dig hr he.symm hv.2.1)
      · exact .inr c

/-- **Exclusion is sound.** A proof of absence that verifies against a well-formed trie's root
means the trie holds nothing at the key, or two of the byte strings the read compares collide. -/
theorem exclusion_sound {t : T K V D} {k : K} {p : Proof K D} (hw : WF S t)
    (hv : verifyExclusion S (t.hashOf S) k p = true) : t.get S k = none ∨ CollAmong S (readPres S k p t) := by
  unfold verifyExclusion at hv
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hv
  rcases climb_sound S hL hN k 0 t p.sibs p.term hw hv.1.1 hv.2 with he | c
  · left
    cases hg : t.get S k with
    | none => rfl
    | some v =>
        obtain ⟨kds, hk, hf⟩ := getAt_some_proveAt S k 0 t v hg
        have hn := hv.1.2
        rw [he, hk] at hn
        simp [hf] at hn
  · exact .inr c

omit hL hN

/-! ## Every trie the operations build is well formed, shallow, and proves what it holds -/

/-- Every node at depth `d` branches at a bit in `[d, depth)`: a proof path's bits ascend below
`depth`. -/
def Shallow : Nat → T K V D → Prop
  | _, .empty => True
  | _, .leaf _ _ => True
  | d, .node _ b _ l r => d ≤ b ∧ b < S.depth ∧ Shallow (b + 1) l ∧ Shallow (b + 1) r

omit [DecidableEq K] [DecidableEq D] in
theorem wf_mkLeaf (kvs : List (K × V)) : WF S (mkLeaf S kvs) := rfl

omit [DecidableEq K] [DecidableEq D] in
/-
# Kernel.Proofs.Receive — what a derived Turn guarantees before `World.admit` sees it
-/
import Kernel.Receive.Submit
import Kernel.Proofs.Check

namespace Nanodregg.Kernel.Receive

open Nanodregg.Kernel

variable {D : Type} [Ord D] [DecidableEq D]

omit [Ord D] [DecidableEq D] in
/-- Distinct constructors have distinct wire names (law 7): equal names, same constructor. -/
theorem Refusal.name_injective (a b : Refusal D) (h : a.name = b.name) : a.ctorIdx = b.ctorIdx := by
  cases a <;> cases b <;> simp_all [Refusal.name] <;> rfl

/-- **The World binding (KERNEL-24).** A call that names another World is refused `wrongWorld`,
before its signature, its key or any pinned read is looked at. -/
theorem receive_wrongWorld {X : Ctx D} {w : World D} {c : Call D} (h : c.unsigned.world ≠ w.origin) :
    receive X w c = .error .wrongWorld := by
  simp [receive, req, h, bind, Except.bind]

/-- A derived call named this World, and is the derivation through its pins and its rows. -/
theorem receive_ok_with {X : Ctx D} {w : World D} {c : Call D} {t : Turn D}
    (h : receive X w c = .ok t) :
    c.unsigned.world = w.origin ∧
      receiveWith X (pinned X.env w c.unsigned.pins) (rowView X.env w c.unsigned) c = .ok t := by
  unfold receive at h
  simp only [except_bind_ok] at h
  obtain ⟨⟨⟩, hw, h⟩ := h
  rw [req_ok, decide_eq_true_eq] at hw
  exact ⟨hw, h⟩

/-- **Consent determinism.** A derivation depends only on the World's identity, the cells the
caller pinned and the rows it observed: two Worlds that agree there derive the same Turn (or the
same refusal) from the same call. -/
theorem receive_congr {X : Ctx D} {w₁ w₂ : World D} {c : Call D} (ho : w₁.origin = w₂.origin)
    (agree : ∀ p ∈ c.unsigned.pins, w₁.live X.env p.1 = w₂.live X.env p.1)
    (rows : rowView X.env w₁ c.unsigned = rowView X.env w₂ c.unsigned) :
    receive X w₁ c = receive X w₂ c := by
  have hv : pinned X.env w₁ c.unsigned.pins = pinned X.env w₂ c.unsigned.pins := by
    funext x
    unfold pinned
    by_cases hx : c.unsigned.pins.any (fun p => p.1 = x) = true
    · obtain ⟨p, hp, hpx⟩ := List.any_eq_true.mp hx
      have hpx' : p.1 = x := of_decide_eq_true hpx
      simp only [hx, if_true]
      rw [← hpx', agree p hp]
    · simp only [hx]; rfl
  unfold receive; rw [hv, ho, rows]

/-- A sealed Turn pays exactly its weight, within the signed ceiling, and carries the caller's
pins as its touches, its window, its call and the receiver's nullifiers; every effect is on a
pinned cell. -/
theorem sealTurn_ok {X : Ctx D} {c : Call D} {cr : List (D × Cell)} {efs : List (D × Act)}
    {ns : List D} {rs : List (RowSlot D × RowAct)} {t : Turn D} (h : sealTurn X c cr efs ns rs = .ok t) :
    t.charge = t.weight ∧ t.charge ≤ c.unsigned.maxCharge ∧
      t.touches = touchesOf c.unsigned.pins efs ∧
      t.event = X.callBytes c ∧ t.txId = txIdOf X c ∧ t.notBefore = c.unsigned.notBefore ∧
      t.validUntil = c.unsigned.validUntil ∧ t.creates = cr ∧ t.nullifiers = ns ∧
      (∀ e ∈ efs, ∃ p ∈ c.unsigned.pins, p.1 = e.1) := by
  unfold sealTurn at h
  simp only [except_bind_ok] at h
  obtain ⟨⟨⟩, hp, _, _, h⟩ := h
namespace Nanodregg.Kernel.Receive

open Nanodregg.Kernel

variable {D : Type} [Ord D] [DecidableEq D]

/-- **What a call may write** at the World `w` it is derived against: a cell it pinned, an id `w`
has not taken (live or tombstoned), a nullifier `w` has not spent. -/
inductive CallFoot (X : Ctx D) (c : Call D) (w : World D) : Slot D → Prop
  | pinned {p : D × D} (hp : p ∈ c.unsigned.pins) : CallFoot X c w (.cell p.1)
  | born {i : D} (hi : w.taken X.env i = false) : CallFoot X c w (.cell i)
  | spent {n : D} (hn : w.isSpent X.env n = false) : CallFoot X c w (.nullifier n)

/-- `{P} c {Q}`: every run of `c` from a `P`-World that `receive` derives and `World.admit` admits
lands in `Q` (of the World before, the Turn, the World after). -/
def Triple (X : Ctx D) (P : World D → Prop) (c : Call D) (Q : World D → Turn D → World D → Prop) : Prop :=
  ∀ w t w', P w → receive X w c = .ok t → World.admit X.env w t = .ok w' → Q w t w'

/-- `R` reads nothing a run of `c` may write: any World agreeing with a `R`-World `w` outside the
call's footprint at `w` is an `R`-World. -/
def Indep (X : Ctx D) (c : Call D) (R : World D → Prop) : Prop :=
  ∀ w w', (∀ s, ¬ CallFoot X c w s → w'.trie.get (trieSpec X.env) s = w.trie.get (trieSpec X.env) s) →
    R w → R w'

/-- **The contract, as a triple.** From any World, a derived and admitted run's Turn is `Derived`
of its call. -/
theorem submit_derived {X : Ctx D} {c : Call D} : Triple X (fun _ => True) c (fun _ t _ => Derived X c t) :=
  fun _ _ _ _ hr _ => receive_derived hr

/-- **The Turn's footprint is inside the call's.** A touch is a pin, a birth is an id the World had
not taken, a spent nullifier was unspent. -/
theorem callFoot_of_turn {X : Ctx D} {w w' : World D} {c : Call D} {t : Turn D}
    (hr : receive X w c = .ok t) (ha : World.admit X.env w t = .ok w') {s : Slot D}
    (h : CellFoot t s) : CallFoot X c w s := by
  cases h with
  | @touched x hx _ =>
      have hp : (x.cell, x.seen) ∈ c.unsigned.pins := by
        rw [← (receive_derived hr).pinned]
        exact List.mem_map_of_mem hx
      exact .pinned hp
  | @born i hi =>
      refine .born ?_
      obtain ⟨posts, hk, -⟩ := admit_ok ha
      have hcr := hk.creates
      unfold checkCreates at hcr
      simp only [except_bind_ok] at hcr
      obtain ⟨⟨⟩, _, ⟨⟩, _, ⟨⟩, _, hf⟩ := hcr
      have := (forEx_ok.mp hf) i hi
      rw [req_ok] at this
      simpa using this
  | @spent n hn => exact .spent ((admit_nullifiers ha).1 n hn).1

/-- **The call-level frame, as reads.** Outside the call's footprint every cells-trie slot reads as
before; no premise beyond the run. -/
theorem call_frame {X : Ctx D} {w w' : World D} {c : Call D} {t : Turn D}
    (hr : receive X w c = .ok t) (ha : World.admit X.env w t = .ok w') :
    ∀ s, ¬ CallFoot X c w s → w'.trie.get (trieSpec X.env) s = w.trie.get (trieSpec X.env) s :=
  fun s hs => (admit_Frame ha).cells s fun hf => hs (callFoot_of_turn hr ha hf)

/-- **The frame rule.** An assertion independent of a call's footprint rides along any triple of
that call. -/
theorem submit_frame {X : Ctx D} {c : Call D} {P R : World D → Prop}
    {Q : World D → Turn D → World D → Prop} (h : Triple X P c Q) (hR : Indep X c R) :
    Triple X (fun w => P w ∧ R w) c (fun w t w' => Q w t w' ∧ R w') :=
  fun w t w' hpr hr ha => ⟨h w t w' hpr.1 hr ha, hR w w' (call_frame hr ha) hpr.2⟩

/-- **At a live cell the footprint is the pins.** A live cell is taken, so it is never born: it is
outside the call's footprint exactly when no pin names it. -/
theorem not_callFoot_live {X : Ctx D} {w : World D} {c : Call D} {obj : D} {cell : Cell}
    (hl : w.live X.env obj = some cell) :
    ¬ CallFoot X c w (.cell obj) ↔ ∀ p ∈ c.unsigned.pins, p.1 ≠ obj := by
  constructor
  · intro h p hp hpo
    exact h (hpo ▸ .pinned hp)
  · intro h hf
    cases hf with
    | pinned hp => exact h _ hp rfl
    | born hi => rw [live_taken hl] at hi; cases hi



import Lean

/- Exact structural interchange for retained kernel expressions. No pretty-printer parsing,
hash-as-equality, or loss of numeric name components. Metadata is intentionally erased:
kernel checking ignores it. Local metavariables/free variables are incomplete exports. -/
namespace Census.JournalExpr
open Lean

inductive N where
  | anonymous
  | str (parent : N) (s : String)
  | num (parent : N) (n : Nat)
deriving ToJson, FromJson

def N.ofName : Name → N
  | .anonymous => .anonymous
  | .str p s => .str (ofName p) s
  | .num p n => .num (ofName p) n

def N.toName : N → Name
  | .anonymous => .anonymous
  | .str p s => .str p.toName s
  | .num p n => .num p.toName n

inductive L where
  | zero
  | succ (l : L)
  | max (a b : L)
  | imax (a b : L)
  | param (name : N)
deriving ToJson, FromJson

def L.ofLevel : Level → Except String L
  | .zero => pure .zero
  | .succ l => return .succ (← ofLevel l)
  | .max a b => return .max (← ofLevel a) (← ofLevel b)
  | .imax a b => return .imax (← ofLevel a) (← ofLevel b)
  | .param n => pure (.param (.ofName n))
  | .mvar _ => .error "INCOMPLETE COVERAGE: universe metavariable"

def L.toLevel : L → Level
  | .zero => .zero
  | .succ l => .succ l.toLevel
  | .max a b => .max a.toLevel b.toLevel
  | .imax a b => .imax a.toLevel b.toLevel
  | .param n => .param n.toName

inductive Node where
  | bvar (i : Nat)
  | sort (l : L)
  | const (name : N) (levels : List L)
  | app (f a : Nat)
  | lam (n : N) (ty body : Nat) (binder : Nat)
  | forallE (n : N) (ty body : Nat) (binder : Nat)
  | letE (n : N) (ty value body : Nat) (nondep : Bool)
  | natLit (n : Nat)
  | strLit (s : String)
  | proj (name : N) (idx : Nat) (value : Nat)
  | metadata (value : Nat)
deriving ToJson, FromJson

def binderCode : BinderInfo → Nat
  | .default => 0
  | .implicit => 1
  | .strictImplicit => 2
  | .instImplicit => 3

def binderOf : Nat → Except String BinderInfo
  | 0 => pure .default
  | 1 => pure .implicit
  | 2 => pure .strictImplicit
  | 3 => pure .instImplicit
  | _ => .error "INCOMPLETE COVERAGE: invalid binder"

structure Table where
  ids : Std.HashMap Expr Nat := {}
  exprs : Array Expr := #[]

def Table.add (t : IO.Ref Table) (e : Expr) : IO Nat := do
  e.forEach fun x => t.modify fun s =>
    if s.ids.contains x then s else
      { ids := s.ids.insert x s.exprs.size, exprs := s.exprs.push x }
  return (← t.get).ids[e]!

def node (t : Table) (e : Expr) : Except String Node := do
  let id (x : Expr) : Except String Nat :=
    match t.ids[x]? with
    | some n => .ok n
    | none => .error "INCOMPLETE COVERAGE: missing expression child"
  match e with
  | .bvar i => pure (.bvar i)
  | .sort l => return .sort (← L.ofLevel l)
  | .const n ls => return .const (.ofName n) (← ls.mapM L.ofLevel)
  | .app f a => return .app (← id f) (← id a)
  | .lam n ty b bi => return .lam (.ofName n) (← id ty) (← id b) (binderCode bi)
  | .forallE n ty b bi => return .forallE (.ofName n) (← id ty) (← id b) (binderCode bi)
  | .letE n ty v b nd => return .letE (.ofName n) (← id ty) (← id v) (← id b) nd
  | .lit (.natVal n) => pure (.natLit n)
  | .lit (.strVal s) => pure (.strLit s)
  | .proj n i v => return .proj (.ofName n) i (← id v)
  | .mdata _ b => return .metadata (← id b)
  | .mvar _ => .error "INCOMPLETE COVERAGE: metavariable"
  | .fvar _ => .error "INCOMPLETE COVERAGE: free variable"

abbrev Decode := StateT (Std.HashMap Nat Expr) (Except String)

/-- Fuel detects malformed cycles; memoization preserves the expression DAG. -/
def decode (nodes : Array Node) : Nat → Nat → Decode Expr
  | 0, _ => throw "INCOMPLETE COVERAGE: expression cycle/depth"
  | fuel + 1, i => do
    if let some e := (← get)[i]? then return e
    let some n := nodes[i]? | throw "INCOMPLETE COVERAGE: missing expression"
    let d := decode nodes fuel
    let e ← match n with
      | .bvar j => pure (.bvar j)
      | .sort l => pure (.sort l.toLevel)
      | .const n ls => pure (.const n.toName (ls.map L.toLevel))
      | .app f a => return .app (← d f) (← d a)
      | .lam n t b bi => return .lam n.toName (← d t) (← d b) (← binderOf bi)
      | .forallE n t b bi => return .forallE n.toName (← d t) (← d b) (← binderOf bi)
      | .letE n t v b nd => return .letE n.toName (← d t) (← d v) (← d b) nd
      | .natLit j => pure (.lit (.natVal j))
      | .strLit s => pure (.lit (.strVal s))
      | .proj n j v => return .proj n.toName j (← d v)
      | .metadata v => d v
    modify (·.insert i e)
    return e

structure Saved where
  name : N
  levels : List N
  type : Nat
  value : Nat
deriving ToJson, FromJson

end Census.JournalExpr
import Census.JournalExpr
import Census.Statements

namespace Census.Journal
open Lean Elab Command Meta JournalExpr

/-- Projection names are dependencies too (Expr.getUsedConstants alone misses them).
The returned list also records local premise applications, including instantiated arguments. -/
def expressionEdges (e : Expr) : IO (Array Name × Array Expr) := do
  let names ← IO.mkRef ({} : NameSet)
  let apps ← IO.mkRef (#[] : Array Expr)
  e.forEach fun x => do
    match x with
    | .const n _ => names.modify (·.insert n)
    | .proj n _ _ => names.modify (·.insert n)
    | .app .. =>
      if x.getAppFn.isBVar then apps.modify (·.push x)
    | _ => pure ()
  return ((← names.get).toArray.qsort (fun a b => a.toString < b.toString), ← apps.get)

def shapeEdges : ConstantInfo → List Name
  | .inductInfo i => i.ctors ++ i.all
  | .ctorInfo i => [i.induct]
  | .recInfo i => i.all ++ i.rules.map (·.ctor)
  | _ => []

def shapeData (table : IO.Ref Table) (ci : ConstantInfo) : CommandElabM Json := do
  match ci with
  | .inductInfo i => pure <| Json.mkObj [("params", toJson i.numParams), ("indices", toJson i.numIndices),
      ("nested", toJson i.numNested), ("recursive", toJson i.isRec), ("reflexive", toJson i.isReflexive)]
  | .ctorInfo i => pure <| toJson (i.cidx, i.numParams, i.numFields)
  | .recInfo i =>
      let mut rules : Array Json := #[]
      for r in i.rules do
        let rhs := toJson (← Table.add table r.rhs)
        rules := rules.push (Json.mkObj [("ctor", toJson r.ctor.toString),
          ("fields", toJson r.nfields), ("rhs", rhs)])
      pure <| Json.mkObj [("params", toJson i.numParams), ("indices", toJson i.numIndices),
        ("motives", toJson i.numMotives), ("minors", toJson i.numMinors), ("k", toJson i.k), ("rules", toJson rules)]
  | .defnInfo i => pure <| toJson (match i.hints with
      | .abbrev => "abbrev"
      | .opaque => "opaque"
      | .regular n => s!"regular:{n}")
  | _ => pure Json.null

def kind : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .thmInfo _ => "theorem"
  | .defnInfo _ => "definition"
  | .opaqueInfo _ => "opaque"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"
  | .quotInfo _ => "quotient"

def savedTheorem (table : IO.Ref Table) (ci : ConstantInfo) : CommandElabM Saved := do
  let .thmInfo t := ci | throwError "INCOMPLETE COVERAGE: requested root is not a theorem"
  return ⟨.ofName t.name, t.levelParams.map N.ofName, ← Table.add table t.type, ← Table.add table t.value⟩

syntax (name := journalExport) "#journal_export " str ident+ : command

@[command_elab journalExport]
def elabExport : CommandElab
  | `(#journal_export $path:str $roots:ident*) => do
    let env ← getEnv
    let table ← IO.mkRef ({} : Table)
    let roots := roots.toList.map (·.getId)
    let mut todo := roots
    let mut seen : NameSet := {}
    let mut queued : NameSet := roots.foldl (fun s n => s.insert n) {}
    let mut rows : Array Json := #[]
    let mut saved : Array Saved := #[]
    for n in roots do
      let some ci := env.find? n | throwError "INCOMPLETE COVERAGE: missing root {n}"
      saved := saved.push (← savedTheorem table ci)
    -- Finite frontier budget: exhaustion is incomplete, never a smaller successful slice.
    for _ in [:100000] do
      if todo.isEmpty then break
      let n := todo.head!
      todo := todo.tail
      if seen.contains n then continue
      seen := seen.insert n
      let some ci := env.find? n | throwError "INCOMPLETE COVERAGE: missing dependency {n}"
      if !roots.contains n && ci.isTheorem then
        saved := saved.push (← savedTheorem table ci)
      let (typeDeps, _) ← expressionEdges ci.type
      let (valueDeps, applications) ← match ci.value? (allowOpaque := true) with
        | some v => expressionEdges v
        | none => pure (#[], #[])
      let shape := shapeEdges ci
      let mut recDeps : Array Name := #[]
      if let .recInfo ri := ci then
        for rule in ri.rules do
          recDeps := recDeps ++ (← expressionEdges rule.rhs).1
      for dep in typeDeps.toList ++ valueDeps.toList ++ recDeps.toList ++ shape do
        unless queued.contains dep do
          queued := queued.insert dep
          todo := dep :: todo
      let axioms ← liftCoreM (collectAxioms n)
      let value : Json ← match ci.value? (allowOpaque := true) with
        | some v => toJson <$> (Table.add table v)
        | none => pure Json.null
      let type := toJson (← Table.add table ci.type)
      let module := (Statements.moduleOf env n).map toString |>.getD "<current>"
      let applicationIds ← liftIO <| applications.mapM (Table.add table)
      rows := rows.push (Json.mkObj [
        ("name", toJson n.toString), ("kind", toJson (kind ci)),
        ("module", toJson module), ("levels", toJson (ci.levelParams.map N.ofName)),
        ("type", type), ("value", value), ("shape", ← shapeData table ci),
        ("typeDeps", toJson (typeDeps.map toString)), ("valueDeps", toJson (valueDeps.map toString)),
        ("shapeDeps", toJson ((shape ++ recDeps.toList).map toString)), ("axioms", toJson (axioms.map toString)),
        ("localApplications", toJson applicationIds)])
    unless todo.isEmpty do throwError "INCOMPLETE COVERAGE: export frontier exhausted"
    let tbl ← table.get
    let nodes ← match tbl.exprs.mapM (node tbl) with
      | .ok ns => pure ns
      | .error msg => throwError msg
    let out := Json.mkObj [("schema", toJson (1 : Nat)), ("complete", toJson true),
      ("roots", toJson (roots.map toString)), ("declarations", toJson rows), ("saved", toJson saved), ("nodes", toJson nodes)]
    IO.FS.writeFile path.getString (out.compress ++ "\n")
    logInfo m!"JOURNAL EXPORT complete: {rows.size} declarations; {roots.length} roots"
  | _ => throwUnsupportedSyntax

syntax (name := journalRecheck) "#journal_recheck " str str num : command

/-- Recheck the saved proof expression against the CURRENT root's type, under the CURRENT
environment. A fresh kernel name prevents a declaration cache from answering for this check.
The original expression is never freshly elaborated here. -/
@[command_elab journalRecheck]
def elabRecheck : CommandElab
  | `(#journal_recheck $input:str $output:str $budget:num) => do
    let txt ← IO.FS.readFile input.getString
    let js ← match Json.parse txt with
      | .ok j => pure j
      | .error msg => throwError "INCOMPLETE COVERAGE: {msg}"
    let saved ← match js.getObjValAs? (Array Saved) "saved" with
      | .ok x => pure x
      | .error msg => throwError "INCOMPLETE COVERAGE: {msg}"
    let nodes ← match js.getObjValAs? (Array Node) "nodes" with
      | .ok x => pure x
      | .error msg => throwError "INCOMPLETE COVERAGE: {msg}"
    let env ← getEnv
    let roots ← match js.getObjValAs? (Array String) "roots" with
      | .ok x => pure x
      | .error msg => throwError "INCOMPLETE COVERAGE: {msg}"
    for root in roots do
      unless (env.find? root.toName).isSome do
        throwError "INCOMPLETE COVERAGE: missing import/root {root}"
import Lang.Contextual.Closure
import Lang.Contextual.Protocol

/- Receipt-first adapter: finite data, never an invocation of Lean in CalculusData.check.
The revision names target, telescope, definition closure, deployment claim and toolchain.
Input values are immutable version identities, not declaration names alone. -/
namespace Nanodregg.Lang.Contextual.Journal

structure Revision where
  claim : String
  target : String
  context : String
  definitions : String
  instanceId : String
  toolchain : String
deriving DecidableEq, Repr

inductive CheckResult where
  | checked
  | rejected
  | exhausted
  | incomplete
deriving DecidableEq, Repr

structure Receipt where
  revision : Revision
  artifact : String
  recipe : String
  inputs : List (String × String)
  result : CheckResult
  complete : Bool
deriving DecidableEq, Repr

abbrev Store := String → Option String

def inputsMatch (r : Receipt) (w : Store) : Bool :=
  r.inputs.all fun p => decide (w p.1 = some p.2)

def receiptCheck (r : Receipt) (rev : Revision) : Bool :=
  decide (r.revision = rev) && decide (r.result = .checked) && r.complete

def calculus : CalculusData where
  Ty := Revision
  Ctx := Unit
  Tm := Receipt
  tmEq := inferInstance
  msubst := fun _ r => r
  check := fun _ r rev => receiptCheck r rev
  uses := fun _ _ => false
  drop := fun _ _ => ()
  strengthen := fun _ r => r
  weaken := fun _ r => r
  var := fun _ => ⟨⟨"", "", "", "", "", ""⟩, "", "", [], .incomplete, false⟩
  lookup := fun _ _ => none

def iface (name : Nat) (rev : Revision) (budget : Nat) : Iface calculus Store where
  name := name
  ctx := ()
  ty := rev
  hyps := []
  hyps_real := by simp
  guard := fun w r => inputsMatch r w
  budget := budget
  chooser := 0
  acceptor := 0

/-- Tokens include check availability, audit coverage and cost evidence. A missing successful
receipt is a missing support, not a claim that Lean's proposition is false. -/
def candidate (r : Receipt) (supports blockers : List Token) (cost : Nat) : Candidate calculus :=
  ⟨r, supports, blockers, cost, 0, .suspended supports⟩

def fragment (id : String) (rev : Revision) (r : Receipt) : Protocol.Frag String String (Option String) :=
  ⟨id, r.inputs.map Prod.fst, fun w => receiptCheck r rev && inputsMatch r w⟩

structure Entry where
  id : String
  revision : Revision
  candidates : List Receipt
deriving DecidableEq, Repr

inductive Event where
  | seeded (entry : Entry)
  | checked (id : String) (receipt : Receipt)
  | withdrawn (key version : String)
  | revised (before after : Revision)
deriving DecidableEq, Repr

/-- The immutable journal is the recovery source; indexes are derived views. -/
structure Log where
  events : List Event
deriving DecidableEq, Repr

def Log.append (log : Log) (ev : Event) : Log := ⟨log.events ++ [ev]⟩

/-- The list reference is intentionally retained as the inverted index oracle. -/
def affected (fs : List (Protocol.Frag String String (Option String))) (keys : List String) : List String :=
  (fs.filter fun f => f.affected keys).map (·.name)

end Nanodregg.Lang.Contextual.Journal


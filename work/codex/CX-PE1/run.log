        term = body.removeprefix(\":=\").strip()
        if case == \"support-proof\":
            new = sig + \":= id (\" + term + \")\\n\"
            changed[TRIPLE] = sources[TRIPLE].replace(old, new)
        else:
            helper = \"\"\"structure JournalWrapper (P : Prop) : Prop where
  evidence : P
\"\"\"
            new = sig + \":= JournalWrapper.evidence ⟨(\" + term + \")⟩\\n\"

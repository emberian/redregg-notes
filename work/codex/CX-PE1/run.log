import Lean

/- Exact structural interchange for retained kernel expressions. No pretty-printer parsing,
hash-as-equality, or loss of numeric name components. Metadata is intentionally erased:
kernel checking ignores it. Local metavariables/free variables are incomplete exports. -/
namespace Census.JournalExpr
open Lean

inductive N where
  | anonymous
  | str (parent : N) (s : String)
  | num (parent : N) (n : Nat)
deriving ToJson, FromJson

def N.ofName : Name → N
  | .anonymous => .anonymous
  | .str p s => .str (ofName p) s
  | .num p n => .num (ofName p) n

def N.toName : N → Name
  | .anonymous => .anonymous
  | .str p s => .str p.toName s
  | .num p n => .num p.toName n

inductive L where
  | zero
  | succ (l : L)
  | max (a b : L)
  | imax (a b : L)
  | param (name : N)
deriving ToJson, FromJson

def L.ofLevel : Level → Except String L
  | .zero => pure .zero
  | .succ l => return .succ (← ofLevel l)
  | .max a b => return .max (← ofLevel a) (← ofLevel b)
  | .imax a b => return .imax (← ofLevel a) (← ofLevel b)
  | .param n => pure (.param (.ofName n))
  | .mvar _ => .error \"INCOMPLETE COVERAGE: universe metavariable\"

def L.toLevel : L → Level
  | .zero => .zero
  | .succ l => .succ l.toLevel
  | .max a b => .max a.toLevel b.toLevel
  | .imax a b => .imax a.toLevel b.toLevel
  | .param n => .param n.toName

inductive E where
  | bvar (i : Nat)
  | sort (l : L)
  | const (name : N) (levels : List L)
  | app (f a : E)
  | lam (n : N) (ty body : E) (binder : Nat)
  | forallE (n : N) (ty body : E) (binder : Nat)
  | letE (n : N) (ty value body : E) (nondep : Bool)
  | natLit (n : Nat)
  | strLit (s : String)
  | proj (name : N) (idx : Nat) (value : E)
deriving ToJson, FromJson

def binderCode : BinderInfo → Nat
  | .default => 0
  | .implicit => 1
  | .strictImplicit => 2
  | .instImplicit => 3

def binderOf : Nat → Except String BinderInfo
  | 0 => pure .default
  | 1 => pure .implicit
  | 2 => pure .strictImplicit
  | 3 => pure .instImplicit
  | _ => .error \"INCOMPLETE COVERAGE: invalid binder\"

def E.ofExpr : Expr → Except String E
  | .bvar i => pure (.bvar i)
  | .sort l => return .sort (← L.ofLevel l)
  | .const n ls => return .const (.ofName n) (← ls.mapM L.ofLevel)
  | .app f a => return .app (← ofExpr f) (← ofExpr a)
  | .lam n t b bi => return .lam (.ofName n) (← ofExpr t) (← ofExpr b) (binderCode bi)
  | .forallE n t b bi => return .forallE (.ofName n) (← ofExpr t) (← ofExpr b) (binderCode bi)
  | .letE n t v b nd => return .letE (.ofName n) (← ofExpr t) (← ofExpr v) (← ofExpr b) nd
  | .lit (.natVal n) => pure (.natLit n)
  | .lit (.strVal s) => pure (.strLit s)
  | .proj n i v => return .proj (.ofName n) i (← ofExpr v)
  | .mdata _ b => ofExpr b
  | .mvar _ => .error \"INCOMPLETE COVERAGE: metavariable\"
  | .fvar _ => .error \"INCOMPLETE COVERAGE: free variable\"

def E.toExpr : E → Except String Expr
  | .bvar i => pure (.bvar i)
  | .sort l => pure (.sort l.toLevel)
  | .const n ls => pure (.const n.toName (ls.map L.toLevel))
  | .app f a => return .app (← toExpr f) (← toExpr a)
  | .lam n t b bi => return .lam n.toName (← toExpr t) (← toExpr b) (← binderOf bi)
  | .forallE n t b bi => return .forallE n.toName (← toExpr t) (← toExpr b) (← binderOf bi)
  | .letE n t v b nd => return .letE n.toName (← toExpr t) (← toExpr v) (← toExpr b) nd
  | .natLit n => pure (.lit (.natVal n))
  | .strLit s => pure (.lit (.strVal s))
  | .proj n i v => return .proj n.toName i (← toExpr v)

structure Saved where
  name : N
  levels : List N
  type : E
  value : E
deriving ToJson, FromJson

end Census.JournalExpr

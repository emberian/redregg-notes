/-- The template types at its closed type under the open interface of its holes. -/
def Template.Typed (tpl : Template D E)
    (HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop) : Prop :=
  HasTy (tpl.Ω.map Iface.decl) tpl.Γ tpl.P tpl.T

/-- A monomial holds in a world: its positive literals live, its negative literals dead. -/
def Monomial.holds (w : World E) (m : List Token × List Token) : Prop :=
  (∀ t ∈ m.1, w.live t = true) ∧ (∀ b ∈ m.2, w.live b = false)

/-- DERIVABILITY: the template with the selected fillings types at its closed type, under the
meta-context of the holes still unfilled. -/
def Derivable (HasTy : List (HoleDecl D.Ctx D.Ty) → D.Ctx → D.Tm → D.Ty → Prop) (cl : Closure D E) :
    Prop :=
  HasTy ((cl.tpl.Ω.map Iface.decl).filter fun d => (cl.sigma d.name).isNone)
    cl.tpl.Γ (D.msubst cl.sigma cl.tpl.P) cl.tpl.T

  have hlt : n < holeBound Ω := hn ▸ lt_holeBound hd
  simp [ΔOf, hlt, h]

theorem ΔOf_nil : ΔOf [] = [] := rfl

/-! ## The typing judgment of the instance -/

/-- Every `ref` the term uses is a declared hole. -/
def RefsDeclared (Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)) (t : Term) : Prop :=
  ∀ n, Term.usesRef n t = true → (tyOf Ω n).isSome = true

/-- `Ω; Γ ⊢ t : T` for `Lang.Term`: every hole's context empty (a `ref` is a closed package
reference: it has no local context to substitute), every ref declared, and `t` typed by
`Lang.HasType` with the holes as the package types. -/
def LangHasTy (Ω : List (HoleDecl (List Lang.Ty) Lang.Ty)) (Γ : List Lang.Ty) (t : Term)
    (T : Lang.Ty) : Prop :=
  (∀ d ∈ Ω, d.ctx = []) ∧ RefsDeclared Ω t ∧ HasType (ΔOf Ω) Γ t T

/-- A term typed in the empty meta-context uses no ref. -/
theorem refsDeclared_nil {t : Term} (h : RefsDeclared [] t) (n : Nat) : Term.usesRef n t = false := by
  cases hn : Term.usesRef n t with
  | false => rfl

/- The generated methods pass the supplied response to the author's continuation. -/
import Lang.Proofs.StdActivity

namespace Nanodregg.Lang.Std

set_option maxHeartbeats 800000

/-- Once the start precondition succeeds, selecting the generated method's
result state evaluates the author's start function at the original inputs. -/
theorem activity_start_state
    (S : Ty) (rels : List (Label × RelDecl)) (cursor log : Label)
    (cd ld : RelDecl) (plans : List ActivityPlan) (p : ActivityPlan)
    (lib : List Term) (env : Env) (req arg state rows result : Val)
    (hpre : BigStep lib (req :: arg :: state :: rows :: req :: arg :: state :: rows :: env)
      (activityApply p.precondition [.var 2, .var 1, .var 0]) (.ok (.bool true)))
    (hstart : BigStep lib (req :: arg :: state :: rows :: req :: arg :: state :: rows :: env)
      (activityApply p.start [.var 2, .var 1, .var 0]) (.ok result)) :
    BigStep lib (req :: arg :: state :: rows :: env)
      (.get (activityApply (activityStartMethod S rels cursor log cd ld plans p)
        [.var 3, .var 2, .var 1, .var 0]) "state") (.ok result) := by
  apply BigStep.get
  · unfold activityApply activityStartMethod activityMethod
    simp only [List.foldl]
    apply BigStep.app
      (BigStep.app (BigStep.app (BigStep.app .lam (.var rfl) .lam) (.var rfl) .lam) (.var rfl) .lam)
      (.var rfl)
    exact .iteT hpre .record
  · exact .field rfl hstart

private def resumeArg (agent : ByteArray) (nb : Nat) (response : Data) : Data :=
  .record [("agent", .digest agent), ("notBefore", .nat nb), ("response", response)]

private def resumeOld (name : Label) (captured answered : Data) : Data :=
  .record [("answered", answered), ("captured", .inj name captured)]

private def resumePoint (agent : ByteArray) (nb : Nat) (old : Data) : Data :=
  .record [("key", .record [("agent", .digest agent), ("notBefore", .nat nb)]),
    ("val", .inj "some" old)]

private def resumeRows (log : Label) (point : Data) : Data :=
  .record [(log, .record [("p0", .inj "some" point)])]

private def resumeEnv (log name : Label) (agent : ByteArray) (nb : Nat)
    (captured answered response : Data) (req state : Val) (env : Env) : Env :=
  let arg := (resumeArg agent nb response).toVal
  let rows := (resumeRows log (resumePoint agent nb (resumeOld name captured answered))).toVal
  req :: arg :: state :: rows :: req :: arg :: state :: rows :: env

private theorem find_plan {names : List (Label × Unit)} {l : Label}
    (hf : Row.find? l names = some ()) (f : Label → Term) :
    Row.find? l (names.map fun p => (p.1, f p.1)) = some (f l) := by
  induction names with
  | nil => simp [Row.find?] at hf
  | cons p ps ih =>
    rcases p with ⟨k, _⟩
    simp only [Row.find?, List.map_cons] at hf ⊢
    split at hf
    · rename_i h; subst h; simp
    · rename_i h; simp only [h, ↓reduceIte]; exact ih hf

/-- The generated method's successful path reaches the author's continuation
with the captured payload and this call's response. The resumer and keyed-read
checks are actual evaluations, not assumed package admission. Row guards still
judge the emitted edits separately, including replay and immutable capture. -/
theorem activity_resume_state
    (S : Ty) (rels : List (Label × RelDecl)) (cursor log : Label)
    (cd ld : RelDecl) (resumer : Term) (plans : List ActivityPlan) (p : ActivityPlan)
    (lib : List Term) (env : Env) (agent : ByteArray) (nb : Nat)
    (captured answered response : Data) (req state result : Val)
    (hp : Row.find? p.name (Row.sort (plans.map fun q => (q.name, ()))) = some ())
    (hres : BigStep lib (resumeEnv log p.name agent nb captured answered response req state env)
      (activityApply resumer [.var 2, .var 0]) (.ok (.bool true)))
    (hkey : BigStep lib
      ((resumeOld p.name captured answered).toVal ::
        (resumePoint agent nb (resumeOld p.name captured answered)).toVal ::
        resumeEnv log p.name agent nb captured answered response req state env)
      (eqData (keyTy ld) (.get (.var 1) "key")
        (activityKeyTerm (.get (.var 3) "agent") (.get (.var 3) "notBefore")))
      (.ok (.bool true)))
    (hresume : BigStep lib
      (captured.toVal :: (resumeOld p.name captured answered).toVal ::
        (resumePoint agent nb (resumeOld p.name captured answered)).toVal ::
        resumeEnv log p.name agent nb captured answered response req state env)
      (activityApply p.resume [.var 5, .var 0, .get (.var 4) "response", .var 3]) (.ok result)) :
    BigStep lib
      (req :: (resumeArg agent nb response).toVal :: state ::
        (resumeRows log (resumePoint agent nb (resumeOld p.name captured answered))).toVal :: env)
      (.get (activityApply (activityResumeMethod S rels cursor log cd ld resumer plans p)
        [.var 3, .var 2, .var 1, .var 0]) "state") (.ok result) := by
  let old := resumeOld p.name captured answered
  let point := resumePoint agent nb old
  let e := resumeEnv log p.name agent nb captured answered response req state env
  apply BigStep.get
  · unfold activityApply activityResumeMethod activityMethod
    simp only [List.foldl]
    apply BigStep.app
      (BigStep.app (BigStep.app (BigStep.app .lam (.var rfl) .lam) (.var rfl) .lam) (.var rfl) .lam)
      (.var rfl)
    apply BigStep.iteT hres
    refine BigStep.case (ℓ := "some") (w := point.toVal) ?_ rfl ?_
    · exact .get (.get (.var rfl) (.field (t := .var 0) (env := [(Data.record [("p0", .inj "some" point)]).toVal])
          (by simp [Data.rowToVal, Row.find?, point, old]) (.var rfl)))
        (.field rfl (.var rfl))
    refine BigStep.case (ℓ := "some") (w := old.toVal) ?_ rfl ?_
    · exact .get (.var rfl) (.field rfl (.var rfl))
    apply BigStep.iteT hkey
    apply BigStep.case (ℓ := p.name) (w := captured.toVal)
      (body := activityResumeResult rels cursor log cd ld plans p)
    · exact .get (.var rfl) (.field rfl (.var rfl))
    · simpa only [↓reduceIte] using find_plan hp (fun l =>
        if l = p.name then activityResumeResult rels cursor log cd ld plans p
        else .refuse (resultTy S [] (editTy rels) 2) "wrongPlan".toUTF8)
    · exact .record
  · exact .field rfl hresume

end Nanodregg.Lang.Std
/- Meaning of the generated activity's continuation retirement guard. -/
import Lang.StdActivity
import Lang.Proofs.Std

namespace Nanodregg.Lang.Std


private theorem app3_vars_inv
    {lib : List Term} {env : Env} {A B C : Ty} {body : Term} {i q s v : Val}
    (h : BigStep lib (i :: q :: s :: env)
      (activityApply (.lam A (.lam B (.lam C body))) [.var 2, .var 1, .var 0]) (.ok v)) :
    BigStep lib (i :: q :: s :: i :: q :: s :: env) body (.ok v) := by
  obtain ⟨b3, e3, z, hf3, hz, hb3⟩ := bigStep_app_ok h
  obtain ⟨b2, e2, y, hf2, hy, hb2⟩ := bigStep_app_ok hf3
  obtain ⟨b1, e1, x, hf1, hx, hb1⟩ := bigStep_app_ok hf2
  cases hf1
  cases hb1
  cases hb2
  have hx' : x = s := by simpa using (bigStep_var_ok hx).symm
  have hy' : y = q := by simpa using (bigStep_var_ok hy).symm
  have hz' : z = i := by simpa using (bigStep_var_ok hz).symm
  subst x; subst y; subst z
  exact hb3

private theorem case_known
    {lib : List Term} {env : Env} {t : Term} {arms : List (Label × Term)}
    {l : Label} {w v : Val} {body : Term}
    (ht : BigStep lib env t (.ok (.inj l w)))
    (hf : Row.find? l arms = some body)
    (h : BigStep lib env (.case t arms) (.ok v)) :
    BigStep lib (w :: env) body (.ok v) := by
  obtain ⟨l', w', b, ht', hf', hb⟩ := bigStep_case_ok h
  have he := bigStep_deterministic ht ht'
  cases he
  rw [hf] at hf'
  cases hf'
  exact hb

private def retirementInput (key old : Data) : Data :=
  .record [("edit", .inj "retract" (.record [("key", key)])), ("old", old)]

/-- Retirement of an answered continuation succeeds for every requester and
state. The old row comes from the kernel at the edited key; authorisation to
answer is checked on the separate upsert transition. -/
theorem activity_retire_some_meaning
    (S : Ty) (plans : List ActivityPlan) (d : RelDecl) (resumer : Term)
    (key captured answer : Data) (lib : List Term) (env : Env) (state req : Val) :
    BigStep lib
      ((retirementInput key (.inj "some" (.record [
        ("answered", .inj "some" answer), ("captured", captured)]))).toVal :: req :: state :: env)
      (activityApply (activityWaiting S plans d resumer) [.var 2, .var 1, .var 0])
      (.ok (.inj "ok" (.record []))) := by
  unfold activityApply activityWaiting
  simp only [List.foldl]
  apply BigStep.app (BigStep.app (BigStep.app .lam (.var rfl) .lam) (.var rfl) .lam) (.var rfl)
  refine BigStep.case (ℓ := "retract") (w := (Data.record [("key", key)]).toVal) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  refine BigStep.case (ℓ := "some") (w := (Data.record [("answered", .inj "some" answer), ("captured", captured)]).toVal) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  refine BigStep.case (ℓ := "some") (w := answer.toVal) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  exact .inj .record

/-- An unanswered continuation cannot be retired: the guard returns the named
refusal for arbitrary state, request, capture and key. -/
theorem activity_retire_none_meaning
    (S : Ty) (plans : List ActivityPlan) (d : RelDecl) (resumer : Term)
    (key captured : Data) (lib : List Term) (env : Env) (state req : Val) :
    BigStep lib
      ((retirementInput key (.inj "some" (.record [
        ("answered", .inj "none" (.record [])), ("captured", captured)]))).toVal :: req :: state :: env)
      (activityApply (activityWaiting S plans d resumer) [.var 2, .var 1, .var 0])
      (.ok (.inj "refused" (.bytes "unanswered".toUTF8))) := by
  unfold activityApply activityWaiting
  simp only [List.foldl]
  apply BigStep.app (BigStep.app (BigStep.app .lam (.var rfl) .lam) (.var rfl) .lam) (.var rfl)
  refine BigStep.case (ℓ := "retract") (w := (Data.record [("key", key)]).toVal) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  refine BigStep.case (ℓ := "some") (w := (Data.record [("answered", .inj "none" (.record [])), ("captured", captured)]).toVal) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  refine BigStep.case (ℓ := "none") (w := .record []) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  exact .inj .bytes


/-- Retirement admits exactly answered rows, independently of who requests
cleanup. This is an iff about the generated guard's actual semantics. -/
theorem waiting_retract_iff
    (S : Ty) (plans : List ActivityPlan) (d : RelDecl) (resumer : Term)
    (key captured : Data) (answer : Option Data) (lib : List Term)
    (env : Env) (state req : Val) :
    (∃ w, BigStep lib
      ((retirementInput key (.inj "some" (.record [
        ("answered", match answer with | none => .inj "none" (.record []) | some a => .inj "some" a),
        ("captured", captured)]))).toVal :: req :: state :: env)
      (activityApply (activityWaiting S plans d resumer) [.var 2, .var 1, .var 0])
      (.ok (.inj "ok" w))) ↔ answer.isSome = true := by
  cases answer with
  | none =>
    constructor
/-
# Lang.Contextual.Closure — the guarded contextual closure `(P, Ω, σ, D, support, Φ, t)`

The object of ACTIVITIES-PROPOSAL doc 2 §9, over an ABSTRACT calculus (its data `CalculusData` here, its laws
`CalculusLaws` in the proof module), so the theory
does not wait on a particular CMTT core. Two instances exist: the toy of
`Lang.Proofs.Contextual.Experiments`, and the CMTT core's, `Lang/Proofs/Contextual/CoreInstance.lean`,
which lands as the second commit.

Limits, stated: fillings are typed in the EMPTY meta-context (`HasTy [] Ψ M A`: no hole inside a
hole's filling); supports are one level (tokens, never another hole's selection), so a support cycle
is not expressible here; an environment edit touches every candidate (dependency sets are
sufficient, not minimal).

* `P, Ω` — the retained `Template`: a term typed under an open interface of holes `u :: [Ψ ⊢ A]`,
  each with its guard, budget, hypothesis tokens and POLARITY (`chooser`, `acceptor`). Kept apart
  from every environment: resubstitution needs it.
* `σ` — `Closure.sigma`: the current partial meta-substitution, the selected filling per hole.
* `D` — the selected candidate per hole (`Slot.selected`): WHICH derivation stands behind `σ`. Two
  candidates with one filling and different supports are one `σ` and two `D`s (provenance `ab + c`).
* `support` — `Closure.support`: the tokens the selected candidates rely on (`effSupports`: the
  declared supports plus the hypothesis tokens of every context variable the filling USES).
* `Φ` — `Closure.Φ`: residual obligations (derived from the statuses) plus `owed` (established by
  the accepted history and never derived away).
* `t` — `Closure.hist`: the accepted interaction history, append-only.

A candidate's status is computed by ONE function, `judge`, from the hole's checker and guard, the
world's environment and the liveness of the candidate's dependencies; the status is never the
proposer's opinion. Assumption tokens are immutable and versioned (`Token`); a world says which are
live. Withdrawal is a liveness change: it can suspend, it never refutes (`conflict` is reachable
only from the checker and the guard, which read no token).
-/

namespace Nanodregg.Lang.Contextual

/-! ## The abstract calculus -/

/-- A hole declaration `u :: [Ψ ⊢ A]`: the hole's name, its local context, its type. -/
structure HoleDecl (Ctx Ty : Type) where
  name : Nat
  ctx : Ctx
  ty : Ty

/-- The DATA of a contextual calculus the closure theory uses (its laws, with the typing relation,
are `Lang.Proofs.Contextual.Closure.CalculusLaws`). -/
structure CalculusData where
  Ty : Type
  Ctx : Type
  Tm : Type
  tmEq : DecidableEq Tm
  /-- Simultaneous meta-substitution `⟦σ⟧P` for a PARTIAL `σ` (unfilled holes stay). -/
  msubst : (Nat → Option Tm) → Tm → Tm
  /-- The checker: a proposed filling acquires authority only through it. -/
  check : Ctx → Tm → Ty → Bool
  /-- `uses M x`: the filling mentions hypothesis `x` of its context (free-variable occurrence). -/
  uses : Tm → Nat → Bool
  /-- The context without hypothesis `x`. -/
  drop : Ctx → Nat → Ctx
  /-- Strengthening `t ≡ t₀[π]`: `strengthen x t` is `t₀`, `weaken x` is `π`. -/
  strengthen : Nat → Tm → Tm
  weaken : Nat → Tm → Tm
  /-- The variable term for hypothesis `x`. -/
  var : Nat → Tm
  /-- The type a context gives hypothesis `x`, if it has one. -/
  lookup : Ctx → Nat → Option Ty

instance (D : CalculusData) : DecidableEq D.Tm := D.tmEq

/-! ## Assumption tokens and worlds -/

/-- An immutable, versioned assumption. Re-using an id at a new version is a NEW token: the
proposition a token stands for never changes. -/
structure Token where
  id : Nat
  ver : Nat
deriving DecidableEq, Repr

/-- A world: which tokens are live, and the guard environment (dependent-context parameters). -/
structure World (E : Type) where
  live : Token → Bool
  env : E

variable {E : Type}

def World.set (w : World E) (t : Token) (b : Bool) : World E :=
  { w with live := fun t' => if t' = t then b else w.live t' }

/-- A primitive change of world. -/
inductive Edit (E : Type) where
  | withdraw (t : Token)
  | assert (t : Token)
  | setEnv (e : E)

def Edit.apply : Edit E → World E → World E
  | .withdraw t, w => w.set t false
        (hcheck T (hp .deq (hg (hg (hv "point") "key") "cand") id) "unknown" rest))
  let fresh := hr [("blocker", hnone holeSupport), ("by", hg (hv "req") "agent"),
    ("reason", hs ""), ("s0", hg (hv "arg") "s0"), ("s1", hg (hv "arg") "s1"),
    ("status", hi holeStatus "verified" hn), ("value", hg (hv "arg") "value")]
  let insert := edit "candidates" (holeCandidates V) "insert" key
    (hu fresh [("status", status fresh)])
  let update (c : H) := edit "candidates" (holeCandidates V) "upsert"
    (hg (hv "point") "key") (hu c [("status", status c)])
  let R1 := resultTy holeState [] E 1
  let R2 := resultTy holeState [] E 2
  let proposalBody := hcheck R1
    (hp .le (hg (hv "req") "validUntil") (hg (hv "state") "closes")) "closed"
    (done (hv "state") [insert])
  let fillBody := canChoose R1 (hcheck R1
    (hp .le (hg (hv "req") "validUntil") (hg (hv "state") "closes")) "closed"
    (hadmit R1 (judge fresh) (done chosen [insert])))
  let selectBody := canChoose R1 (readCandidate R1 (hg (hv "arg") "cand")
    (hadmit R1 (judge (hv "c")) (done chosen [update (hv "c")])))
  let rejudgeBody := readCandidate R1 (hg (hv "arg") "cand")
    (done (hv "state") [update (hv "c")])
  let pruned := hu (hv "c") [
    ("blocker", hsome holeSupport (hg (hv "arg") "blocker")), ("reason", hg (hv "arg") "why")]
  let pruneBody := canChoose R1 (readCandidate R1 (hg (hv "arg") "cand")
    (done (hv "state") [update pruned]))
  let cd := activityCursor [p] 64 "pending_queued"
  let ld := activityLog [p] 1024 "fills_waiting"
  let acceptBody := hcheck R2
    (hp .deq (hg (hv "req") "agent") (hg (hv "state") "acceptor")) "notAcceptor"
    (hcheck R2 (ht (hg (hv "state") "accepted") (hb false) (hb true)) "accepted"
      (hlet "selected" .digest (hunwrap .digest (hg (hv "state") "selected") "unselected")
        (readCandidate R2 (hv "selected")
          (hadmit R2 (judge (hv "c"))
            (ha (hc (activityStartMethod holeState rels "pending" "fills" cd ld [p] p))
              [hn, hv "state", hg (hv "c") "value", hv "req"])))))
  let factKey := hr [("cell", hg (hv "arg") "cell")]
  let factVal := hr [("by", hg (hv "req") "agent"), ("pin", hg (hv "arg") "pin")]
  let method (A R : Ty) (b : H) : Term :=
    (hl "rows" R (hl "state" holeState (hl "arg" A (hl "req" reqTy b)))) ["holeJudge"]
  let methods : List (Label × Ty × Ty × Nat × H) := [
    ("accept", .record [], readBoth, 2, acceptBody),
    ("fill", proposal, readFacts, 1, fillBody),
    ("post", factArg, .record [], 1, done (hv "state") [edit "facts" holeFacts "insert" factKey factVal]),
    ("propose", proposal, readFacts, 1, proposalBody),
    ("prune", pruneArg, readBoth, 1, pruneBody),
    ("rejudge", candArg, readBoth, 1, rejudgeBody),
    ("repin", factArg, .record [], 1, done (hv "state") [edit "facts" holeFacts "upsert" factKey factVal]),
    ("select", candArg, readBoth, 1, selectBody),
    ("unpost", .record [("cell", .digest)], .record [], 1,
      done (hv "state") [edit "facts" holeFacts "retract" factKey hn])]
  let frozen := [("acceptor", Ty.digest), ("cap", .nat), ("chooser", .digest), ("closes", .nat)]
  let shape : H := fun sc => allOf (frozen.map fun (f, T) =>
    (eqData T ((hg (hv "old") f) sc) ((hg (hv "new") f) sc), f))
  let law := (hl "old" holeState (hl "new" holeState (hl "req" reqTy shape))) []
  let extras : List (Label × Ty × Term) :=
    [("posted", guardTy holeState holeFacts, holePosted),
      ("proposed", guardTy holeState (holeCandidates V), holeProposed V clause),
      ("shape", lawTy holeState, law)] ++
    methods.map (fun (n, A, R, es, b) => (n, methodTy holeState A [] R E es, method A R b))
  let .record oldTypes := base.iface | return base
  let .record oldTerms := base.body | return base
  let types := (oldTypes.filter (·.1 != "start_fill")) ++ extras.map fun (n, T, _) => (n, T)
  let terms := (oldTerms.filter (·.1 != "start_fill")) ++ extras.map fun (n, _, t) => (n, t)
  return { base with
    iface := .record (Row.sort types), body := .app (.lam (.fn holeState (.fn (holeCandidate V) (.fn holeFactsView holeVerdict)))
      (.record (Row.sort terms))) (holeJudge V clause),
    methods := (Row.sort (((base.methods.filter (· != "start_fill")) ++
      methods.map (·.1)).map (·, ()))).map (·.1), laws := ["shape"] }


inductive HoleRefusal
  | check (why : CheckError)
  | layout
  | fieldTooLarge (name : Label)
  | imports
  | rootTooLarge

def HoleRefusal.name : HoleRefusal → String
  | .check e => e.text
  | .layout => "holeLayout"
  | .fieldTooLarge n => "holeFieldTooLarge " ++ n
  | .imports => "holeImports"
  | .rootTooLarge => "holeRootTooLarge"

/-- Ordinary ROM packages plus an unlinked root layout. link supplies the
installed library IDs; only its checked result is installable. -/
structure HoleBundle where
  libraries : List Package
  layout : Package

def HoleBundle.link (b : HoleBundle) (ids : List ByteArray) : Except HoleRefusal Package := do
  if ids.length != b.libraries.length then throw .imports
  let p := { b.layout with imports := ids }
  match p.checkWith (b.libraries.map (·.iface)) with
  | .error e => throw (.check e)
  | .ok () => pure ()
  let some bytes := Wire.encodePackage p | throw .rootTooLarge
  if bytes.size > Bounds.bytesMax then throw .rootTooLarge
  pure p

/-- Emit a bounded import bundle. Helpers are ordinary checked ROMs; the root
contains only field selections from them. No bound or wire format changes. -/
def hole (V : Ty) (clause : Term) : Except HoleRefusal HoleBundle := do
  let p := holePackage V clause
  match p.checkWith [] with
  | .error e => throw (.check e)
  | .ok () => pure ()
  let .record ts := p.iface | throw .layout
  let .app (.lam JT (.record fs)) judge := p.body | throw .layout
  let fields ← fs.mapM fun (n, t) => do
    let some T := Row.find? n ts | throw .layout
    pure (n, T, t)
  let library (group : List (Label × Ty × Term)) : Package := {
    imports := [], state := .record [],
    iface := .record (group.map fun (n, T, _) => (n, T)),
    body := .app (.lam JT (.record (group.map fun (n, _, t) => (n, t)))) judge,
    methods := [], laws := [], rels := [] }
  let fits (group : List (Label × Ty × Term)) : Bool :=
    match Wire.encodePackage (library group) with
    | none => false
    | some bytes => bytes.size ≤ Bounds.bytesMax
  let mut groups : List (List (Label × Ty × Term)) := []
  let mut current := []
  for f in fields do
    if fits (current ++ [f]) then current := current ++ [f]
    else
      if current.isEmpty || !fits [f] then throw (.fieldTooLarge f.1)
      groups := groups ++ [current]
      current := [f]
  if !current.isEmpty then groups := groups ++ [current]
  let libraries := groups.map library
  for lib in libraries do
    match lib.checkWith [] with
    | .error e => throw (.check e)
    | .ok () => pure ()
  let rootFields := groups.zipIdx.flatMap fun (group, i) =>
    group.map fun (n, _, _) => (n, Term.get (.ref i) n)
  pure ⟨libraries, { p with body := .record (Row.sort rootFields) }⟩

end Nanodregg.Lang.Std
/-
# Lang.Contextual.LangCalculus — the DEPLOYED term language as a `CalculusData` (ACTIVITIES-2)

The data half of an instance of CLOSURE's abstract calculus (`Lang.Contextual.Closure`) over
`Lang.Term`: a template's holes are its `ref`s (`ref n` is the hole named `n`; fillings are
CLOSED terms, so filling shifts nothing), a hole's local context is a `List Ty` of ordinary
variables, strengthening and weakening are variable renamings at a position (CMTT-CORE's
`lowerIdx`/`liftIdx`). The laws are `Lang.Proofs.Contextual.LangInstance.langLaws`, over
`LangHasTy`, which requires every hole's context to be EMPTY: the measurement this instance makes
is what that costs (`langHasTy_closed_holes`).

Binders: `lam` binds one variable, every `case` arm binds its payload at index 0; record and
extend fields bind nothing.
-/
import Lang.Check
import Lang.Contextual.Core
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual

/-! ## Decidable equality of terms -/

mutual
/-- Decide equality of terms: structural, every verdict carrying its proof (no `deriving` for
the nested rows in v4.30.0). -/
def Term.decEq : (a b : Term) → Decidable (a = b)
  | .var a0, .var b0 =>
    match _root_.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0; exact h0 e0)
    | isTrue h0 =>
      isTrue (by subst h0; rfl)
  | .lam a0 a1, .lam b0 b1 =>
    match _root_.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0 e1; exact h0 e0)
    | isTrue h0 =>
      match Term.decEq a1 b1 with
      | isFalse h1 => isFalse (by intro e; injection e with e0 e1; exact h1 e1)
      | isTrue h1 =>
        isTrue (by subst h0; subst h1; rfl)
  | .app a0 a1, .app b0 b1 =>
    match Term.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0 e1; exact h0 e0)
    | isTrue h0 =>
      match Term.decEq a1 b1 with
      | isFalse h1 => isFalse (by intro e; injection e with e0 e1; exact h1 e1)
      | isTrue h1 =>
        isTrue (by subst h0; subst h1; rfl)
  | .fix a0, .fix b0 =>
    match Term.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0; exact h0 e0)
    | isTrue h0 =>
      isTrue (by subst h0; rfl)
  | .nat a0, .nat b0 =>
    match _root_.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0; exact h0 e0)
    | isTrue h0 =>
      isTrue (by subst h0; rfl)
  | .bool a0, .bool b0 =>
    match _root_.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0; exact h0 e0)
    | isTrue h0 =>
      isTrue (by subst h0; rfl)
  | .bytes a0, .bytes b0 =>
    match _root_.decEq a0 b0 with
    | isFalse h0 => isFalse (by intro e; injection e with e0; exact h0 e0)

exec
/bin/zsh -lc "ssh -n hbox 'python3 -c '\\''from pathlib import Path
p=Path('\\''\\'\\'''\\''/tank/dregg-build/claude-lanes/activities/Lang/StdHole.lean'\\''\\'\\'''\\'')
s=p.read_text()
start=s.index('\\''\\'\\'''\\''private def hadmit'\\''\\'\\'''\\'')
end=s.index('\\''\\'\\'''\\''\\nprivate def hcheck'\\''\\'\\'''\\'',start)
old=s[start:end]

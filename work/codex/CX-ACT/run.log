      r.1.owed = cl.owed ∧ r.1.hist = cl.hist ++ [.proposed u (cl.slot u).cands.length] ∧
      r.1.slot = cl.update u ⟨(cl.slot u).cands ++ [{ c with status := judge I w c }],

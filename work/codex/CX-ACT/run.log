  let terms := (oldTerms.filter (·.1 != "start_fill")) ++ extras.map fun (n, _, t) => (n, t)
  return { base with
    iface := .record (Row.sort types), body := .record (Row.sort terms),
    methods := (Row.sort (((base.methods.filter (· != "start_fill")) ++
      methods.map (·.1)).map (·, ()))).map (·.1), laws := ["shape"] }

/-- Checked generator; clause is closed state → value → bool. -/
def hole (V : Ty) (clause : Term) : Except CheckError Package := do
  let p := holePackage V clause
  p.checkWith []
  pure p

end Nanodregg.Lang.Std

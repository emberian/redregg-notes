theorem update_at {cl : Closure D E} {u v : Nat} {s : Slot D} :
    cl.update u s v = if v = u then s else cl.slot v := rfl

theorem propose_ok {w : World E} {u : Nat} {c : Candidate D} {cl : Closure D E}

            (done state (upsert candidates p.key (extend c (status (Status pruned arg.why))))))))))))
  ; the chooser selects a verified candidate whose recorded facts are, now, what it was verified under
  (method select (reads (candidates (points 1)) (facts (points 2))) (arg (rec (cand digest)))
    (check ((deq req.agent state.chooser) "notChooser") ((not state.accepted) "accepted")
      (case rows.candidates.p0 (none _ (refuse "unknown"))
        (some p (case p.val (none _ (refuse "unknown"))
          (some c (check ((deq p.key.cand arg.cand) "unknown")
            (case c.status (pruned _ (refuse "pruned")) (suspended _ (refuse "suspended"))
              (verified _
                (case c.s0
                  (none _
                    (case c.s1
                      (none _ (done (with state (selected (some digest arg.cand)))))
                      (some t (case rows.facts.p0 (none _ (refuse "support1 withdrawn"))
                        (some f (case f.val (none _ (refuse "support1 withdrawn"))
                          (some v (check ((deq f.key.cell t.cell) "support1") ((deq v.pin t.pin) "support1 moved")
                            (done (with state (selected (some digest arg.cand))))))))))))
                  (some s
                    (case rows.facts.p0 (none _ (refuse "support0 withdrawn"))
                      (some f (case f.val (none _ (refuse "support0 withdrawn"))
                        (some v (check ((deq f.key.cell s.cell) "support0") ((deq v.pin s.pin) "support0 moved")
                          (case c.s1
                            (none _ (done (with state (selected (some digest arg.cand)))))
                            (some t (case rows.facts.p1 (none _ (refuse "support1 withdrawn"))
                              (some g (case g.val (none _ (refuse "support1 withdrawn"))
                                (some u (check ((deq g.key.cell t.cell) "support1") ((deq u.pin t.pin) "support1 moved")
                                  (done (with state (selected (some digest arg.cand)))))))))))))))))))))))))))
  ; the acceptor takes the selected candidate; after that the choice is an executed prefix
  (method accept
    (check ((deq req.agent state.acceptor) "notAcceptor") ((not state.accepted) "accepted")
      (case state.selected (none _ (refuse "unselected"))
        (some _ (done (with state (accepted true)))))))
  ; a candidate's status agrees with the clause; only the chooser prunes; a candidate's value and author never change
  (guard proposed (case edit
    (insert x (check ((deq x.val.by req.agent) "notYours")
      (case x.val.status
        (pruned _ (refuse "prunedAtBirth"))
        (suspended _ (if (<= x.val.value state.cap) (refuse "status") ok))
        (verified _ (if (<= x.val.value state.cap) ok (refuse "status"))))))
    (upsert x (case old (none _ (refuse "unknown"))
      (some o (check ((== x.val.value o.value) "value") ((deq x.val.by o.by) "by")
        (case x.val.status
          (pruned _ (if (deq req.agent state.chooser) ok (refuse "notChooser")))
          (suspended _ (if (<= x.val.value state.cap) (refuse "status") ok))
          (verified _ (if (<= x.val.value state.cap) ok (refuse "status"))))))))))
  ; a fact is its poster's
  (guard posted (case edit
    (insert x (if (deq x.val.by req.agent) ok (refuse "notYours")))
    (upsert x (case old (none _ (refuse "unknown"))
      (some o (check ((deq o.by req.agent) "notYours") ((deq x.val.by req.agent) "notYours") ok))))
    (retract x (case old (none _ (refuse "unknown"))
      (some o (if (deq o.by req.agent) ok (refuse "notYours")))))))
  ; the shape never moves on an invoke
  (law shape (on invoke m (all ((== new.cap old.cap) "cap") ((deq new.chooser old.chooser) "chooser")
    ((deq new.acceptor old.acceptor) "acceptor") ((== new.closes old.closes) "closes"))) (else ok)))
/- Meaning of generated structural equality over canonical first-order data. -/
import Lang.StdData
import Lang.Proofs.Meaning
import Lang.Proofs.Data
import Lang.Proofs.Canon

namespace Nanodregg.Lang.Std

private theorem eqData_apply {lib : List Term} {env : Env} {T : Ty}
    {x y : Term} {d e : Data} {b : Bool}
    (hx : BigStep lib env x (.ok d.toVal))
    (hy : BigStep lib env y (.ok e.toVal))
    (hb : BigStep lib (e.toVal :: d.toVal :: env) (eqDataBody T) (.ok (.bool b))) :
    BigStep lib env (eqData T x y) (.ok (.bool b)) :=
  .app (.app .lam hx .lam) hy hb

private theorem data_get {lib : List Term} {env : Env} {i : Nat}
    {ds : List (Label × Data)} {l : Label} {d : Data}
    (hi : env[i]? = some (Data.record ds).toVal) (hf : Row.find? l ds = some d) :
    BigStep lib env (.get (.var i) l) (.ok d.toVal) := by
  apply BigStep.get (.var hi)
  apply Sel.field (t := .var 0) (env := [d.toVal]) _ (.var rfl)
  clear hi
  induction ds with
  | nil => simp [Row.find?] at hf
  | cons p ds ih =>
    rcases p with ⟨k, e⟩
    simp only [Data.rowToVal, Row.find?] at hf ⊢
    split at hf <;> simp_all

private theorem conform_find {ds : List (Label × Data)} {r : List (Label × Ty)}
    (hd : RowConforms ds r) {l : Label} {T : Ty} (hf : Row.find? l r = some T) :
    ∃ d, Row.find? l ds = some d ∧ Conforms d T := by
  induction r generalizing ds with
  | nil => simp [Row.find?] at hf
  | cons p r ih =>
    rcases p with ⟨k, A⟩
    cases hd with
    | cons h hr =>
      simp only [Row.find?] at hf ⊢
      split at hf
      · rename_i he; cases hf; exact ⟨_, by simp [he], h⟩
      · rename_i he; simpa [he] using ih hr hf
  
private theorem canon_find {r : List (Label × Ty)} (ha : Row.ascending r = true)
    {l : Label} {T : Ty} (hm : (l, T) ∈ r) : Row.find? l r = some T := by
  induction r with
  | nil => cases hm
  | cons p r ih =>
    rcases p with ⟨k, A⟩
    obtain ⟨hlt, ht⟩ := Row.ascending_cons_iff.mp ha
    rcases List.mem_cons.mp hm with he | htail
    · cases he; simp [Row.find?]
    · have hn : l ≠ k := by
        intro he; subst he
        exact (String.lt_irrefl _ (hlt (l, T) htail))
      simpa [Row.find?, hn] using ih ht htail

private theorem conform_ext {ds es : List (Label × Data)} {r : List (Label × Ty)}
    (hd : RowConforms ds r) (he : RowConforms es r) (ha : Row.ascending r = true)
    (hh : ∀ l T, (l, T) ∈ r → Row.find? l ds = Row.find? l es) : ds = es := by
  induction r generalizing ds es with
  | nil => cases hd; cases he; rfl
  | cons p r ih =>
    rcases p with ⟨k, A⟩
    cases hd with
    | cons hd hr =>
     cases he with
     | cons he hs =>
        have hhead := hh k A (by simp)
        simp only [Row.find?, if_true, Option.some.injEq] at hhead
        subst hhead
        have ht := Row.ascending_cons_iff.mp ha
        have htail := ih hr hs ht.2 (by
          intro l T hm
          have hn : l ≠ k := by
            intro h; subst h; exact String.lt_irrefl _ (ht.1 (l, T) hm)
          simpa [Row.find?, hn] using hh l T (List.mem_cons_of_mem _ hm))
        rw [htail]
  
private theorem find_map {α β : Type} (f : Label → α → β) {l : Label} :
    ∀ {r : List (Label × α)} {a : α}, Row.find? l r = some a →
      Row.find? l (r.map fun p => (p.1, f p.1 p.2)) = some (f l a)
  | [], _, h => by simp [Row.find?] at h
  | (k, t) :: r, a, h => by
    simp only [Row.find?, List.map_cons] at h ⊢
    split at h
    · rename_i he; subst he; cases h; simp
    · rename_i he; simpa [he] using find_map f h

private theorem find_mem {α : Type} {l : Label} {a : α} :
    ∀ {r : List (Label × α)}, Row.find? l r = some a → (l, a) ∈ r
  | [], h => by simp [Row.find?] at h
  | (k, t) :: r, h => by
    simp only [Row.find?] at h
    split at h
    · rename_i he; subst he; cases h; simp
    · exact List.mem_cons_of_mem _ (find_mem h)

private theorem fields_meaning {lib : List Term} {env : Env}
    {ds es : List (Label × Data)} :
    ∀ r : List (Label × Ty),
      (∀ l T, (l, T) ∈ r → ∃ d e b,
        Row.find? l ds = some d ∧ Row.find? l es = some e ∧
        BigStep lib (e.toVal :: d.toVal :: (Data.record es).toVal :: (Data.record ds).toVal :: env)
          (eqDataBody T) (.ok (.bool b)) ∧ (b = true ↔ d = e)) →
      ∃ b, BigStep lib ((Data.record es).toVal :: (Data.record ds).toVal :: env)
        (eqDataFields r) (.ok (.bool b)) ∧
        (b = true ↔ ∀ l T, (l, T) ∈ r → Row.find? l ds = Row.find? l es)
  | [], _ => ⟨true, by rw [eqDataFields]; exact .bool, by simp⟩
  | (l, T) :: r, hh => by
    obtain ⟨d, e, b, hd, he, hb, hi⟩ := hh l T (by simp)
    obtain ⟨c, hc, hj⟩ := fields_meaning r (fun k U hm => hh k U (List.mem_cons_of_mem _ hm))
    have hcomp := eqData_apply (data_get (i := 1) rfl hd) (data_get (i := 0) rfl he) hb
    refine ⟨b && c, ?_, ?_⟩
    · rw [eqDataFields]
      cases b
      · exact .iteF hcomp .bool
      · exact .iteT hcomp hc
    · simp only [Bool.and_eq_true, hi, hj]
      constructor
      · rintro ⟨hde, ht⟩ k U hm
        rcases List.mem_cons.mp hm with h | hm
        · cases h; simpa [hd, he] using congrArg some hde
        · exact ht k U hm
      · intro h
        refine ⟨?_, fun k U hm => h k U (List.mem_cons_of_mem _ hm)⟩
        have hh := h l T (by simp)
        simpa [hd, he] using hh

  let plans ← rest.mapM fun x => do
    match x with
    | .list q (.atom _ "plan" :: .atom _ name ::
        .list _ [.atom _ "arg", K] :: .list _ [.atom _ "resp", R] :: bodies) =>
      let K ← ty c Read.depthMax K
      let R ← ty c Read.depthMax R
      let (pre, bodies) := match bodies with
        | .list _ [.atom _ "pre", pre] :: bs => (pre, bs)
        | bs => (A q "true", bs)
      match bodies with
      | [.list _ [.atom _ "start", start], .list _ [.atom _ "resume", resume]] =>
        pure ({
          name, captured := K, response := R,
          precondition := ← activityFunction c q [("state", c.state), ("arg", K), ("req", reqTy)] pre,
          start := ← activityFunction c q [("state", c.state), ("arg", K), ("req", reqTy)] start,
          resume := ← activityFunction c q
            [("state", c.state), ("captured", K), ("response", R), ("req", reqTy)] resume } : Std.ActivityPlan)
      | _ => throw (.badClause q)
    | _ => throw (.badClause x.pos)
  match Std.activity c.state cursor log cursorLimit logLimit resumer plans with
  | .ok pkg => pure (if extraRels.isEmpty then pkg else
      Std.activityPackage c.state cursor log cursorLimit logLimit resumer plans extraRels)
  | .error why => throw (.std p why.name)

/-- Each field the layer adds: never a law of the super (`overridesLaw`), and a field the super
has only at the super's own type (`retypedOverride`). -/
def checkAdds (posOf : Label → Nat) (sup : Package) : List (Label × Ty × Term) → P Unit
  | [] => .ok ()
  | (ℓ, T, _) :: rest =>
    if sup.laws.contains ℓ then .error (.overridesLaw (posOf ℓ) ℓ)
    else if sup.rels.any (·.2.guard = some ℓ) then .error (.overridesGuard (posOf ℓ) ℓ)
    else match Row.find? ℓ (recRow sup.iface) with
      | some T' => if T' = T then checkAdds posOf sup rest else .error (.retypedOverride (posOf ℓ) ℓ)
      | none => checkAdds posOf sup rest

/-- The layer over `sup` (id `sid`): its own fields added to the super's by `extend (ref 0)`;
a law of the super is never overridden and is kept (`Lang.Proofs.Surface.layer_keeps_laws`). -/
def layerOf (posOf : Label → Nat) (sid : ByteArray) (sup : Package) (adds : List (Label × Ty × Term))
    (addLaws addMethods : List Label) : P Package := do
  checkAdds posOf sup adds
  pure { imports := [sid], state := sup.state, rels := sup.rels,
         iface := .record (Row.merge (recRow sup.iface) (Row.sort (adds.map fun (ℓ, T, _) => (ℓ, T)))),
         body := .extend (.ref 0) (Row.sort (adds.map fun (ℓ, _, t) => (ℓ, t))),
         methods := sup.methods ++ addMethods.filter (!sup.methods.contains ·),
         laws := (Row.sort ((sup.laws ++ addLaws).map (·, ()))).map (·.1) }

/-- Lower a surface package's declarations (`supers`: the packages a layer may name, by id). -/
def lower (supers : List (ByteArray × Package)) (p : Nat) (ds : List SExp) : P Lowered := do
  let d ← declsOf {} ds
  -- the doc, as `Read.doc` reads one (LANG-60): never empty when written, `Bounds.docOk`
  let doc ← match d.doc with
    | none => pure ByteArray.empty
    | some (q, t) => liftR (Read.doc q [.str q t])
  -- type names, in order; a bounded form is kept as written (argument types only)
  let mut c : Ctx := {}
  for (q, n, t) in d.types do
    if reservedName c n || (c.boundNames.find? (·.1 = n)).isSome then throw (.duplicate q n)
    match t with
    | .list _ [.atom _ "nat", _, _] | .list _ [.atom _ "bytes", _, _] => c := { c with boundNames := (n, t) :: c.boundNames }
    | _ => c := { c with names := (n, ← ty c Read.depthMax t) :: c.names }
  -- the layer's super, if any
  let sup ← match d.layer with
    | none => pure none
    | some (q, n) =>
      match d.imports.find? (·.2.1 = n) with
      | none => throw (.noSuper q n)
      | some (_, _, h) =>
        match Read.unhex .empty h.toList with
        | none => throw (.read (.badImport q))
        | some b =>
          match supers.find? (·.1 = b) with
          | some (_, P) => pure (some (b, P))
          | none => throw (.noSuper q n)
  if sup.isSome && (d.state.isSome || !d.rels.isEmpty || !d.machines.isEmpty || !d.activities.isEmpty || d.imports.length != 1) then
    throw (.layerShape p)
  let S ← match d.state, sup with
    | some (_, t), _ => ty c Read.depthMax t
    | none, some (_, P) => pure P.state
    | none, none => throw (.noState p)
  let activities ← d.activities.mapM fun (q, cursor, log, xs) => do
    pure (q, ← activityDecl { c with state := S } q cursor log xs)
  let activityMethods := activities.flatMap (·.2.methods)
  let rels ← match sup with
    | some (_, P) => pure P.rels
    | none => do
      let rs ← d.rels.mapM fun (q, ℓ, xs) => do pure (ℓ, ← relDecl { c with state := S } q xs)
      let rs := rs ++ activities.flatMap (·.2.rels)
      unique p [] (rs.map (·.1))
      pure (Row.sort rs)
  let activityParts ← d.activities.mapM fun (q, cursor, log, xs) => do
    let extra := rels.filter fun r => r.1 != cursor && r.1 != log
    pure (q, ← activityDecl { c with state := S } q cursor log xs extra)
  -- a machine names the methods it steps; its edges may name only those (`unknownMethod`)
  let machineMethods ← d.machines.flatMapM fun (_, _, _, ms, _) => labelsOf ms
  let declared := d.methods.map (·.2.1)
  let sorted (ls : List Label) : List Label := ((Row.sort (ls.map (·, ()))).map (·.1)).eraseDups
  -- a layer keeps its super's method indices: the super's methods first, in its order, then the new
  let allMethods := match sup with
    | some (_, P) => P.methods ++ sorted (declared.filter (!P.methods.contains ·))
    | none => sorted (declared ++ machineMethods ++ activityMethods)
  unique p [] (declared ++ machineMethods ++ d.laws.map (·.2.1) ++ d.guards.map (·.2.1) ++ d.machines.map (·.2.1) ++
    activities.flatMap (fun (_, P) => (recRow P.iface).map (·.1)))
  c := { c with state := S, rels, methods := allMethods, layered := sup.isSome }
  -- methods
  let ms ← d.methods.mapM fun (q, ℓ, xs) => do
    let (T, sx, res, bs) ← methodSx c q xs
    pure (ℓ, T, sx, res, bs)
  -- machines: the law, and a step method for each method label it names that is not declared
  let mut mlaws : List (Label × SExp × Term) := []
  let mut mmethods : List (Label × Ty × SExp × Term) := []
  for (q, f, init, ms, es) in d.machines do
    let states := match Row.find? f (recRow S) with | some (.sum r) => r.map (·.1) | _ => []
    let edges ← es.mapM fun
      | .list _ [.atom _ x, .atom _ m, .atom _ y] => pure (x, m, y)
      | e => throw (.badClause e.pos)
    let law ← stdErr q (Std.machine S f states init allMethods edges)
    mlaws := mlaws ++ [(f, ← termAt q law, law)]
    for m in ← labelsOf ms do
      unless declared.contains m do
        let t ← stdErr q (Std.stepTo S f states allMethods m edges)
        mmethods := mmethods ++ [(m, methodTy S (.record []), ← termAt q t, t)]
  -- laws and guards
  let ls ← d.laws.mapM fun (q, ℓ, xs) => do pure (ℓ, ← lawTerm c q ℓ xs)
  let gs ← d.guards.mapM fun (q, g, b) => do
    match rels.find? (·.2.guard = some g) with
    | none => throw (.noRel q g)
    | some (_, rd) =>
      let cg := { c with place := .guard }
      -- a guard binds `state req edit old` (LANG-59): its third argument is the guard input
      -- record, bound as `edit` long enough to name its two fields
      let b' ← term cg Read.depthMax ["edit", "old", "req", "state"] b
      pure (g, guardTy S rd, L q [A q "lam", A q "state", ← tyAt q S, L q [A q "lam", A q "req", ← tyAt q reqTy,
        L q [A q "lam", A q "edit", ← tyAt q (guardInTy rd),
          L q [A q "let", A q "old", ← tyAt q (optTy rd.val), L q [A q ".", A q "edit", A q "old"],
            L q [A q "let", A q "edit", ← tyAt q (relEditTy rd), L q [A q ".", A q "edit", A q "edit"], b']]]]])
  -- read every field's core text with the one reader
  let mut fields : List (Label × Ty × Term) := []
  let mut sxs : List (Label × SExp × Nat) := []
  for (ℓ, T, sx, res, bs) in ms do
    fields := fields ++ [(ℓ, T, ← wrapMethod sx.pos res bs (← readTermAt sx))]; sxs := sxs ++ [(ℓ, sx, bs.length)]
  for (ℓ, T, sx, t) in mmethods do
    fields := fields ++ [(ℓ, T, t)]; sxs := sxs ++ [(ℓ, sx, 0)]
  for (ℓ, sx, t) in mlaws do
    fields := fields ++ [(ℓ, lawTy S, t)]; sxs := sxs ++ [(ℓ, sx, 0)]
  for (ℓ, sx) in ls do
    fields := fields ++ [(ℓ, lawTy S, ← readTermAt sx)]; sxs := sxs ++ [(ℓ, sx, 0)]
  for (g, T, sx) in gs do
    fields := fields ++ [(g, T, ← readTermAt sx)]; sxs := sxs ++ [(g, sx, 0)]
  for (q, P) in activityParts do
    match P.iface, P.body with
    | .record ts, .record bs =>
      for (l, T) in ts do
        match Row.find? l bs with
        | some t =>
          fields := fields ++ [(l, T, t)]
          sxs := sxs ++ [(l, ← termAt q t, 0)]
        | none => throw (.badShape q)
    | _, _ => throw (.badShape q)
  let lawLabels := d.laws.map (·.2.1) ++ mlaws.map (·.1)
  match sup with
  | some (sid, P) =>
    -- a layer's doc is its own (the super's is the super's)
    pure ⟨{ ← layerOf (fun ℓ => ((Row.find? ℓ sxs).map (·.1.pos)).getD p) sid P fields lawLabels
      (allMethods.drop P.methods.length) with doc }, sxs⟩
  | none =>
    let imports ← d.imports.mapM fun (q, _, h) =>
      match Read.unhex .empty h.toList with
      | some b => pure b
      | none => throw (.read (.badImport q))
    pure ⟨{ imports, state := S, rels,
            iface := .record (Row.sort (fields.map fun (ℓ, T, _) => (ℓ, T))),
            body := .record (Row.sort (fields.map fun (ℓ, _, t) => (ℓ, t))),
            methods := allMethods,
            laws := (Row.sort (lawLabels.map (·, ()))).map (·.1), doc }, sxs⟩

/-- A core package text: `(package (imports …) …)`. -/
def isCore : SExp → Bool
  | .list _ (.atom _ "package" :: .list _ (.atom _ "imports" :: _) :: _) => true
  | _ => false

/-- The package a text means, with each field's core s-expression (empty for a core text). The
surface's package is printed and read again by the one reader; a core text is read as it is. -/
def readSExpWith (supers : List (ByteArray × Package)) (x : SExp) : P Lowered :=
  if isCore x then do pure ⟨← liftR (Read.package x), []⟩
  else match x with
    | .list p (.atom _ "package" :: ds) => do
      let l ← lower supers p ds
      match Print.package l.pkg with
      | some t => do pure ⟨← liftR (Read.readPackage t), l.fields⟩
      | none => throw (.unprintable p)
    | y => .error (.notSurface y.pos)

    .get (.var rfl) (.field rfl (.var rfl))
  have ho := case_known hold rfl hr
  have hans : BigStep lib (old.toVal :: payload.toVal :: e) (.get (.var 0) "answered") (.ok (.inj "some" answer.toVal)) :=
    .get (.var rfl) (.field rfl (.var rfl))
  exact refusedT_not_ok (case_known hans rfl ho)



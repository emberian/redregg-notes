    ∃ I, cl.find u = some I ∧ p = I.chooser ∧ (cl.slot u).accepted = false ∧
      cl'.tpl = cl.tpl ∧ cl'.owed = cl.owed ∧ cl'.hist = cl.hist ++ [.deselected u] ∧

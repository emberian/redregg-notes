      cl'.slot = cl.update u ⟨(cl.slot u).cands.set i { c with status := .verified },
        some i, (cl.slot u).accepted⟩ := by
  unfold select at h
  dsimp only at h
  split at h
  · simp at h
  rename_i I hf
  split at h
  · simp at h
  rename_i hp
  split at h
  · simp at h
  rename_i hacc
  split at h
  · simp at h
  rename_i c hc
  split at h
  · rename_i hv

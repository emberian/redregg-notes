/-
Alternative worlds for the contextual rule model (CARD P3).
A demonstration Mini can take, not a second kernel World or an admission path.
Default absence is tested against ONE proposed world. A reduct uses the landed
positive Rule/lfpIter machinery. Exhausted iteration is unfinished, never false.
-/
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.Worlds

/-- A normal rule, with immutable external premise tokens. An absent atom is a
default test, not evidence for its explicit contrary. -/
structure NormalRule where
  head : Nat
  body : List Nat
  absent : List Nat
  supports : List Token
deriving DecidableEq, Repr

abbrev Program := List NormalRule
abbrev Alternative := List Nat

/-- Freeze default tests at the proposed world; only positive bodies remain. -/
def reduct {E : Type} (P : Program) (w : World E) (v : Alternative) : List Rule :=
  (P.filter fun r => r.supports.all w.live &&
    r.absent.all (fun a => !v.contains a)).map fun r => ⟨r.head, r.body⟩

/-- No external facts enter secretly: a fact is a rule with an empty body,
optionally backed by external premise tokens. -/
def ground (R : List Rule) (rounds : Nat) : Nat → Bool :=
  lfpIter R (fun _ => false) rounds

/-- Closure under every rule is checked, rather than inferred from the fuel. -/
def closed (R : List Rule) (v : Nat → Bool) : Bool :=
  R.all fun r => !(r.body.all v) || v r.head

/-- The finite universe of possible conclusions. Body-only atoms cannot be derived. -/
def heads (P : Program) : List Nat := (P.map NormalRule.head).eraseDups

def subsets : List Nat → List Alternative
  | [] => [[]]
  | a :: as => subsets as ++ (subsets as).map (a :: ·)

/-- None means the reduct has not stabilized. Some false is a completed rejection.
Comparison covers both directions and arbitrary proposed lists (order irrelevant). -/
def check {E : Type} (rounds : Nat) (P : Program) (w : World E)
    (v : Alternative) : Option Bool :=
  let R := reduct P w v
  let g := ground R rounds
  if closed R g then
    some (v.all g && (heads P).all (fun a => !g a || v.contains a))
  else none

/-- Complete finite search, retaining worlds separately. A pending reduct makes
the whole answer pending: a partially scanned list cannot justify absence. -/
def collect {E : Type} (rounds : Nat) (P : Program) (w : World E) :
    List Alternative → Option (List Alternative)
  | [] => some []
  | v :: vs => do
    let ok ← check rounds P w v
    let rest ← collect rounds P w vs
    pure (if ok then v :: rest else rest)

def analyze {E : Type} (rounds : Nat) (P : Program) (w : World E) :
    Option (List Alternative) :=
  collect rounds P w (subsets (heads P))

/-- The four requested distinctions plus the ordinary supported case and the
separate case of a completed search with no admissible world. A query names two
incompatible evidence atoms; it does not identify absence with explicit negation. -/
inductive Report where
  | noJustification
  | alternatives (left right : Alternative)
  | conflictingEvidence (proposed : Alternative)
  | unfinished
  | supported (worlds : List Alternative)
  | noWorld
deriving DecidableEq, Repr

/-- Diagnose a proposed evidence world and a pair of opposed observations.
Conflicting evidence is reported about the proposal, never asserted admissible.
Alternatives are witnesses from the completed admissible-world search. -/
def report {E : Type} (rounds : Nat) (P : Program) (w : World E)
    (positive negative : Nat) (proposed : Alternative) : Report :=
  match analyze rounds P w with
/-
Stable alternatives, completed-search reports and world-indexed grounding.
Every Prop statement lives here. The definition module exports only data.
-/
import Lang.Contextual.Worlds
import Lang.Proofs.Contextual.Stability

namespace Nanodregg.Lang.Contextual.Worlds

/-- Stable-model semantics: exactly the well-founded consequences of this world's
positive reduct. No union of alternative worlds appears in this judgment. -/
def Stable {E : Type} (P : Program) (w : World E) (v : Alternative) : Prop :=
  ∀ x, x ∈ v ↔ Derives (reduct P w v) (fun _ => false) x

theorem derives_head {E : Type} {P : Program} {w : World E} {v : Alternative} {x : Nat}
    (h : Derives (reduct P w v) (fun _ => false) x) : x ∈ heads P := by
  cases h with
  | fact h => cases h
  | @rule r hr _ =>
    obtain ⟨n, hn, he⟩ := List.mem_map.1 hr
    have hnP := (List.mem_filter.1 hn).1
    cases he
    simp only [heads, List.mem_eraseDups, List.mem_map]
    exact ⟨n, hnP, rfl⟩

/-- Checked saturation turns finite iteration into the full inductive semantics,
even when the supplied fuel was smaller than a general worst-case bound. -/
theorem closed_complete {R : List Rule} {n : Nat}
structure AlternatingSimulation {SI SS I O : Type} (impl : Machine SI I O)
    (spec : Machine SS I O) (R : SI → SS → Prop) : Prop where
  inputs : ∀ si ss, R si ss → ∀ i ss', spec.receive ss i = some ss' →
    ∃ si', impl.receive si i = some si' ∧ R si' ss'
  outputs : ∀ si ss, R si ss → ∀ o si', (o, si') ∈ impl.emit si →
    ∃ ss', (o, ss') ∈ spec.emit ss ∧ R si' ss'

def Refines {SI SS I O : Type} (impl : Machine SI I O) (si : SI)
    (spec : Machine SS I O) (ss : SS) : Prop :=
  ∃ R, R si ss ∧ AlternatingSimulation impl spec R

theorem refines_refl {S I O : Type} (m : Machine S I O) (s : S) : Refines m s m s := by
  refine ⟨Eq, rfl, ?_⟩
  constructor
  · intro si ss h i ss' hi
    | input i => cases hp
    | output o => exact hsim.outputs si ss hr o si' h

/-- Bounded compatibility with an adversarial peer. At either side's output choice the
receiver must accept, and the successor pair owes the remaining safety horizon.
This is absence of refused interactions, not a deadlock-freedom or liveness claim. -/
def SafeFor {S P I O : Type} (m : Machine S I O) (peer : Machine P O I) :
    Nat → S → P → Prop
  | 0, _, _ => True
  | n + 1, s, p =>
    (∀ i p', (i, p') ∈ peer.emit p →
      ∃ s', m.receive s i = some s' ∧ SafeFor m peer n s' p') ∧
    (∀ o s', (o, s') ∈ m.emit s →
      ∃ p', peer.receive p o = some p' ∧ SafeFor m peer n s' p')

/-- Alternating simulation preserves compatibility for arbitrarily long mixed sessions,
including successors after both input and output transitions. -/
theorem simulation_preserves_safety {SI SS P I O : Type} {impl : Machine SI I O}
    {spec : Machine SS I O} {R : SI → SS → Prop}
    (hsim : AlternatingSimulation impl spec R) (peer : Machine P O I)
    (n : Nat) {si : SI} {ss : SS} {p : P} (hr : R si ss)
    (hsafe : SafeFor spec peer n ss p) : SafeFor impl peer n si p := by
  induction n generalizing si ss p with
  | zero => trivial
  | succ n ih =>
    constructor
    · intro i p' hp
      obtain ⟨ss', hs', hrest⟩ := hsafe.1 i p' hp
      obtain ⟨si', hi', hr'⟩ := hsim.inputs si ss hr i ss' hs'
      exact ⟨si', hi', ih hr' hrest⟩
    · intro o si' hi
      obtain ⟨ss', hs', hr'⟩ := hsim.outputs si ss hr o si' hi
      obtain ⟨p', hp', hrest⟩ := hsafe.2 o ss' hs'
      exact ⟨p', hp', ih hr' hrest⟩

/-- More accepted prices and fewer possible replies are a genuine stateful refinement. -/
theorem price_refines {small large : Nat} (hcap : small ≤ large) {outs outs' : List Bool}
    (hout : ∀ b ∈ outs', b ∈ outs) (s : Bool) :
    Refines (priceReceiver large outs') s (priceReceiver small outs) s := by
  refine ⟨Eq, rfl, ?_⟩
  constructor
  · intro si ss he i ss' hi
    subst he
    simp only [priceReceiver] at hi ⊢
    split at hi
    · rename_i hg
      have hg' : si = false ∧ i ≤ large := ⟨hg.1, Nat.le_trans hg.2 hcap⟩
      cases hi
      exact ⟨true, if_pos hg', rfl⟩
    · cases hi
  · intro si ss he o si' ho
theorem withdraw_pruning_reason :
    obs s3 = some [[.pruned [tK]]] ∧
    refusal s3sel = some (.notVerified (.pruned [tK])) ∧
    obs s3w = some [[.verified]] ∧ sel 0 s3w = some (some 0) ∧
    obs s3dead = some [[.verified]] := by
  decide

/-- Only the pruning chooser may prune. -/
theorem prune_needs_chooser :
    refusal (Session.run [.propose 0 (cand (.lit 7) []), .prune 2 0 0 tK] (w0, start tpl0 w0)) =
      some .notChooser := by

/bin/zsh -lc "ssh -n hbox 'cd /tank/dregg-build/nanodregg/wt/CX-P11a && cat Lang/Proofs/Contextual/WorldsField.lean Lang/Contextual/Interfaces.lean Lang/Proofs/Contextual/Interfaces.lean' " in /Users/ember/dev/redregg/work/codex/CX-READER-P11a

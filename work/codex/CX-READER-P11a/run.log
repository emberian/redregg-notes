/-
P11a: certified provenance-game draws. Köhler–Ludäscher–Zinn (2013),
First-Order Provenance Games, PDF pp3–4. Infinite play is a draw, while a
position is drawn only if neither player can force a win. Budget exhaustion
alone does not establish either fact. This is a sufficient finite trap certificate.
-/
import Lang.Contextual.P5

namespace Nanodregg.Lang.Contextual.P5.Games

/-- Köhler et al., PDF pp3–4: a finite recorded trap is evidence for indefinite
play. Existing operational limits retain their own constructor and semantics. -/
inductive OutsideReason where
  | drawn (region : List Nat)
  | procedureLimit (limit : Limit)
deriving DecidableEq, Repr

/-- Köhler et al., PDF pp3–4: this stronger-than-necessary draw certificate records
a nonempty successor set at every node and forbids every exit. The root must occur.
It does not purport to find all game draws; failing it leaves the problem open. -/
def checkDraw (moves : Nat → List Nat) (root : Nat) (region : List Nat) : Bool :=
  region.contains root && region.all (fun x =>
    !(moves x).isEmpty && (moves x).all region.contains)

/-- Köhler et al., PDF p4: only a checked semantic draw is tagged drawn.
A failed certificate is an open obligation, not a loss or proof of impossibility. -/
def judgeDraw (moves : Nat → List Nat) (root : Nat) (region : List Nat) :
    LogicalStatus Nat (List Nat) Need OutsideReason :=
  if checkDraw moves root region then .outsideThisProcedure (.drawn region)
  else .open .invalidRefutation []

/-- Köhler et al., PDF p3: the simplest infinite-play arena; its sole move is a
self-loop. Acyclic FO provenance games (PDF p2) have no such drawn positions. -/
def loopMoves (x : Nat) : List Nat := [x]

end Nanodregg.Lang.Contextual.P5.Games
/-
P11a: independent winning/losing derivations and sound draw certificates.
Köhler–Ludäscher–Zinn, First-Order Provenance Games (2013), PDF pp3–4.
No claim that arbitrary outsideThisProcedure limits imply a semantic draw.
-/
import Lang.Contextual.Games

namespace Nanodregg.Lang.Contextual.P5.Games

/-- Köhler et al., PDF p4, backward induction: win by moving to a loss; lose if
every successor is won. The latter includes sinks. These finite derivations are
independent of checkDraw and may be used in any finitely branching arena. -/
inductive Solved {V : Type} (moves : V → List V) : Bool → V → Prop where
  | win {x y} : y ∈ moves x → Solved moves false y → Solved moves true x
  | lose {x} : (∀ y ∈ moves x, Solved moves true y) → Solved moves false x

/-- Köhler et al., PDF p4: draw means neither won nor lost, rather than an empty
search result or an operational timeout. -/
def Draw {V : Type} (moves : V → List V) (x : V) : Prop :=
  ¬ Solved moves true x ∧ ¬ Solved moves false x

/-- Köhler et al., PDF p4: winning and losing evidence are incompatible, by
induction on their independent backward-induction derivations. -/
theorem solved_exclusive {V : Type} {moves : V → List V} {b : Bool} {x : V}
    (h : Solved moves b x) : ¬ Solved moves (!b) x := by
  induction h with
  | win hm _ ih =>
    intro hl
    cases hl with
    | lose hs => exact ih (hs _ hm)
  | lose _ ih =>
    intro hw
    cases hw with
    | win hm hl => exact ih _ hm hl

/-- Köhler et al., PDF pp3–4: a closed region without sinks has no finite
winning or losing derivation. Both certificate checks are needed in the induction. -/
theorem trap_unsolved {V : Type} {moves : V → List V} {region : List V}
    (hstep : ∀ x ∈ region, ∃ y, y ∈ moves x)
    (hclosed : ∀ x ∈ region, ∀ y ∈ moves x, y ∈ region)
    {b : Bool} {x : V} (hx : x ∈ region) : ¬ Solved moves b x := by
  intro hs
  induction hs with
  | win hm _ ih => exact ih (hclosed _ hx _ hm)
  | lose _ ih =>
    obtain ⟨y, hy⟩ := hstep _ hx
    exact ih y hy (hclosed _ hx y hy)

/-- Köhler et al., PDF p4: a checked finite trap proves a semantic draw.
Nonemptiness, successor closure and root coverage are replayed, not assumed. -/
theorem checkDraw_sound {moves : Nat → List Nat} {root : Nat} {region : List Nat}
    (h : checkDraw moves root region = true) : Draw moves root := by
  simp only [checkDraw, Bool.and_eq_true, List.contains_iff_mem, List.all_eq_true,
    Bool.not_eq_true'] at h
  have hstep : ∀ x ∈ region, ∃ y, y ∈ moves x := by
    intro x hx
    have hn : moves x ≠ [] := by
      intro he
      have := (h.2 x hx).1
      simp [he] at this
    exact List.exists_mem_of_ne_nil _ hn
  have hclosed : ∀ x ∈ region, ∀ y ∈ moves x, y ∈ region := by
    intro x hx y hy
    simpa using (h.2 x hx).2 y hy
  exact ⟨trap_unsolved hstep hclosed h.1, trap_unsolved hstep hclosed h.1⟩

/-- Köhler et al., PDF p4: returned outside/drawn carries a replayed certificate
and proves neither win nor loss; unlike a procedureLimit it is semantic evidence. -/
theorem outside_draw_sound {moves : Nat → List Nat} {root : Nat}
    {region reported : List Nat}
    (h : judgeDraw moves root region = .outsideThisProcedure (.drawn reported)) :
    reported = region ∧ checkDraw moves root region = true ∧ Draw moves root := by
  unfold judgeDraw at h
  split at h
  · rename_i hc
    cases h
    exact ⟨rfl, hc, checkDraw_sound hc⟩
  · cases h

/-- Köhler et al., PDF p3: a self-loop certifies indefinite play; the result is
produced by the checker and has the independent neither-won-nor-lost meaning. -/
theorem loop_is_draw :
    judgeDraw loopMoves 0 [0] = .outsideThisProcedure (.drawn [0]) ∧ Draw loopMoves 0 :=
  ⟨by decide, checkDraw_sound (region := [0]) (by decide)⟩

/-- Köhler et al., PDF p3: a sink is a genuine loss and must never certify draw. -/
theorem sink_is_not_draw :
    judgeDraw (fun _ => []) 0 [0] = .open .invalidRefutation [] ∧
      Solved (fun _ => []) false 0 := by
  refine ⟨by decide, .lose ?_⟩
  intro y hy
  cases hy

/-- Köhler et al., PDF p4: a loop with an escape to a losing sink is won, not drawn.
Dropping successor closure from the certificate makes this real case fail. -/
theorem escape_is_not_draw :
    judgeDraw (fun x => if x = 0 then [0, 1] else []) 0 [0] =
      .open .invalidRefutation [] ∧
    Solved (fun x => if x = 0 then [0, 1] else []) true 0 := by
  refine ⟨by decide, .win (y := 1) (by simp) (.lose ?_)⟩
  intro y hy
  simp at hy

/-- Köhler et al., PDF p4: a valid trap elsewhere says nothing about a losing
root. Dropping root coverage would falsely turn this sink into a draw. -/
theorem unrelated_loop_is_not_draw :
    judgeDraw (fun x => if x = 1 then [1] else []) 0 [1] =
      .open .invalidRefutation [] ∧
    Solved (fun x => if x = 1 then [1] else []) false 0 := by
  refine ⟨by decide, .lose ?_⟩
  intro y hy
  simp at hy

end Nanodregg.Lang.Contextual.P5.Games
/-
P11a: finite completion games with recorded nogood explanations.
Köhler et al. (2013), PDF pp3–4; de Kleer (1986), printed pp144–145.
The generic interface accepts the same token-list nogoods as contextual labels.
It replays the current acceptance test as well as each recorded explanation.
-/
import Lang.Contextual.Games
import Lang.Contextual.Closure

namespace Nanodregg.Lang.Contextual.P5.NogoodGames

/-- Köhler et al., PDF pp3–4: a finite completion question alternates between
choosing a candidate and challenging it. A rejected candidate leads to a sink
for the challenger; an accepted candidate itself is a losing challenger position. -/
inductive Position (A : Type) where
  | question
  | candidate (value : A)
  | terminal
deriving DecidableEq, Repr

/-- Köhler et al., PDF p2: this finite acyclic question is draw-free.
Separate cyclic arenas use Games.judgeDraw; budget limits imply no game value. -/
def moves {A : Type} (p : Problem A) : Position A → List (Position A)
  | .question => p.domain.map Position.candidate
  | .candidate a => if p.accepts a then [] else [.terminal]
  | .terminal => []

/-- de Kleer, printed p145: each excluded candidate names an actual recorded
nogood contained in its assumptions. This data is checked, never trusted by its type. -/
abbrev Certificate (A : Type) := List (A × List Token)

/-- de Kleer, printed pp144–145: record membership and subset explain exclusion;
P5's acceptance function is replayed too, so stale or misapplied records cannot refute
a currently acceptable candidate. Coverage is over the question's declared domain. -/
def checkCertificate {A : Type} [DecidableEq A] (p : Problem A)
    (supports : A → List Token) (nogoods : List (List Token)) (c : Certificate A) : Bool :=
  p.domain.all (fun a => c.any (fun row => row.1 == a)) &&
    c.all (fun row => decide (row.2 ∈ nogoods) &&
      row.2.all (fun t => decide (t ∈ supports row.1)) && !p.accepts row.1)

/-- Köhler et al., PDF p4; de Kleer, printed p145: refuted means lost with a
replayed, recorded nogood for every member of the finite domain. The landed
judge still chooses witnesses and handles operational limits without alteration. -/
def judge {A : Type} [DecidableEq A] (p : Problem A) (retained : List A)
    (supports : A → List Token) (nogoods : List (List Token))
    (certificate : Option (Certificate A)) (limit : Option Limit := none) :
    LogicalStatus A (Certificate A) Need Limit :=
  match P5.judge p retained none limit with
  | .witnessed a => .witnessed a
  | .outsideThisProcedure why => .outsideThisProcedure why
  | _ =>
    match certificate with
    | none => .open .searchRemaining []
    | some c =>
      if checkCertificate p supports nogoods c then .refuted c
      else .open .invalidRefutation []

end Nanodregg.Lang.Contextual.P5.NogoodGames
/-
P11a: a refuted completion game is lost with recorded nogoods.
Köhler et al. (2013), PDF pp3–4; de Kleer (1986), printed pp144–145.
-/
import Lang.Contextual.NogoodGames
import Lang.Proofs.Contextual.Games
import Lang.Proofs.Contextual.P5

namespace Nanodregg.Lang.Contextual.P5.NogoodGames
open Games

/-- Köhler et al., PDF p4: a successful candidate is a winning move in the
question game, independently of any search list or certificate. -/
theorem accepted_wins {A : Type} {p : Problem A} {a : A}
    (ha : a ∈ p.domain) (hyes : p.accepts a = true) :
    Solved (moves p) true .question := by
  refine .win (y := .candidate a) ?_ (.lose ?_)
  · exact List.mem_map.mpr ⟨a, ha, rfl⟩
  · intro y hy
    simp [moves, hyes] at hy

/-- Köhler et al., PDF p4: exhausting the DECLARED question by checked exclusions
is losing. Exhausting a retained search list alone supplies no such derivation. -/
theorem excluded_loses {A : Type} {p : Problem A}
    (hno : ∀ a ∈ p.domain, p.accepts a = false) :
    Solved (moves p) false .question := by
  apply Solved.lose
  intro y hy
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hy
  refine .win (y := .terminal) ?_ (.lose ?_)
  · simp [moves, hno a ha]
  · intro y hy
    cases hy

/-- de Kleer, printed p145: every covered candidate has a recorded nogood
subset of its actual assumptions, and is rejected by the current question. -/
theorem checkCertificate_sound {A : Type} [DecidableEq A] {p : Problem A}
    {supports : A → List Token} {nogoods : List (List Token)} {c : Certificate A}
    (h : checkCertificate p supports nogoods c = true) :
    ∀ a ∈ p.domain, ∃ n, (a, n) ∈ c ∧ n ∈ nogoods ∧
      (∀ t ∈ n, t ∈ supports a) ∧ p.accepts a = false := by
  simp only [checkCertificate, Bool.and_eq_true, List.all_eq_true, List.any_eq_true,
    beq_iff_eq, decide_eq_true_eq, Bool.not_eq_true'] at h
  intro a ha
  obtain ⟨⟨a', n⟩, hrow, he⟩ := h.1 a ha
  dsimp at he
  subst a'
  have hc := h.2 (a, n) hrow
  exact ⟨n, hrow, hc.1.1, hc.1.2, hc.2⟩

/-- de Kleer, printed p145; Köhler et al., PDF p4: a refuted result identifies
the submitted certificate and replays coverage, record identity, assumptions and rejection. -/
theorem refuted_recorded {A : Type} [DecidableEq A] {p : Problem A}
    {retained : List A} {supports : A → List Token} {nogoods : List (List Token)}
    {certificate : Option (Certificate A)} {limit : Option Limit} {c : Certificate A}
    (h : judge p retained supports nogoods certificate limit = .refuted c) :
    certificate = some c ∧ ∀ a ∈ p.domain, ∃ n, (a, n) ∈ c ∧ n ∈ nogoods ∧
      (∀ t ∈ n, t ∈ supports a) ∧ p.accepts a = false := by
  unfold judge at h
  split at h
  · cases h
  · cases h
  · split at h
    · cases h
    · split at h
      · rename_i hc
        cases h
        exact ⟨rfl, checkCertificate_sound hc⟩
      · cases h

/-- Köhler et al., PDF p4; de Kleer, printed p145: the actual refuted status
implies loss in the independent game semantics, together with recorded explanations.
Loss is derived from replayed coverage, not used as a premise or stored proof field. -/
theorem refuted_is_lost {A : Type} [DecidableEq A] {p : Problem A}
    {retained : List A} {supports : A → List Token} {nogoods : List (List Token)}
    {certificate : Option (Certificate A)} {limit : Option Limit} {c : Certificate A}
    (h : judge p retained supports nogoods certificate limit = .refuted c) :
    Solved (moves p) false .question ∧
      ∀ a ∈ p.domain, ∃ n ∈ nogoods, (a, n) ∈ c ∧ ∀ t ∈ n, t ∈ supports a := by
  have hc := (refuted_recorded h).2
  constructor
  · apply excluded_loses
    intro a ha
    obtain ⟨_, _, _, _, hn⟩ := hc a ha
    exact hn
  · intro a ha
    obtain ⟨n, hm, hn, hs, _⟩ := hc a ha
    exact ⟨n, hn, hm, hs⟩

/-- Köhler et al., PDF p4: the wrapper preserves the landed judge's positive
soundness; nogood records cannot override a checked witness. -/
theorem witnessed_is_won {A : Type} [DecidableEq A] {p : Problem A}
    {retained : List A} {supports : A → List Token} {nogoods : List (List Token)}
    {certificate : Option (Certificate A)} {limit : Option Limit} {a : A}
    (h : judge p retained supports nogoods certificate limit = .witnessed a) :
    a ∈ p.domain ∧ p.accepts a = true ∧ Solved (moves p) true .question := by
  unfold judge at h
  split at h
  · rename_i b hb
    cases h
    have hw := P5.witnessed_sound hb
    exact ⟨hw.1, hw.2, accepted_wins hw.1 hw.2⟩
  · cases h
  · split at h
    · cases h
    · split at h <;> cases h

/-- de Kleer, printed p145: a nonempty question can be refuted by a named,
recorded nogood. This inhabits the generic coverage and replay premises. -/
theorem recorded_loss_example :
    judge (⟨[0], fun _ => false⟩ : Problem Nat) [] (fun _ => [⟨1, 0⟩])
      [[⟨1, 0⟩]] (some [(0, [⟨1, 0⟩])]) = .refuted [(0, [⟨1, 0⟩])] := by decide

/-- de Kleer, printed p145: an unrecorded explanation never refutes. -/
theorem unrecorded_refused :
    judge (⟨[0], fun _ => false⟩ : Problem Nat) [] (fun _ => [⟨1, 0⟩])
      [] (some [(0, [⟨1, 0⟩])]) = .open .invalidRefutation [] := by decide

/-- de Kleer, printed p145: a record about assumptions the candidate does not
use cannot refute it, even if the independent acceptance test currently fails. -/
theorem unrelated_record_refused :
    judge (⟨[0], fun _ => false⟩ : Problem Nat) [] (fun _ => [⟨2, 0⟩])
      [[⟨1, 0⟩]] (some [(0, [⟨1, 0⟩])]) = .open .invalidRefutation [] := by decide

/-- de Kleer, printed pp144–145: incomplete records leave the full question open. -/
theorem uncovered_candidate_refused :
    judge (⟨[0, 1], fun _ => false⟩ : Problem Nat) [] (fun _ => [⟨1, 0⟩])
      [[⟨1, 0⟩]] (some [(0, [⟨1, 0⟩])]) = .open .invalidRefutation [] := by decide

/-- Köhler et al., PDF p4; de Kleer, printed p145: stale or erroneous recorded
nogoods cannot refute a currently accepted but unretained candidate. -/
theorem stale_record_refused :
    judge (⟨[0], fun _ => true⟩ : Problem Nat) [] (fun _ => [⟨1, 0⟩])
      [[⟨1, 0⟩]] (some [(0, [⟨1, 0⟩])]) = .open .invalidRefutation [] := by decide

end Nanodregg.Lang.Contextual.P5.NogoodGames
/-
P11a/P9 integration: actual recorded contextual nogoods produce losing completion
games. de Kleer (1986), printed pp144–145; Köhler et al. (2013), PDF pp3–4.
P9 owns the imported policy. P11a adds no premise to a landed theorem.
-/
import Lang.Proofs.Contextual.Nogoods
import Lang.Proofs.Contextual.NogoodGames

namespace Nanodregg.Lang.Contextual.P5.NogoodGames

/-- de Kleer, printed p145; Köhler et al., PDF p4: P9's actual refuted candidate
is a losing singleton completion game, with its recorded inconsistent assumption set.
This is a question about this candidate, not all possible fillings of a hole. -/
theorem recorded_candidate_is_lost {D : CalculusData} {E : Type}
    {cl : P9.RecordedClosure D E} {I : Iface D E} {w : World E}
    {c : Candidate D} {ng : List Token}
    (h : P9.classifyRecorded cl I w c = .refuted ng) :
    ng ∈ cl.nogoods ∧ (∀ t ∈ ng, t ∈ effSupports I c) ∧
      Games.Solved
        (moves (⟨[()], fun _ => decide ((P9.judgeRecorded cl I w c).status = .verified)⟩ :
          Problem Unit)) false .question := by
  obtain ⟨hm, hs, hn⟩ := P9.recorded_refuted h
  refine ⟨hm, hs, excluded_loses ?_⟩
  intro a _
  exact decide_eq_false (hn w)

/-- de Kleer, printed p145; Köhler et al., PDF p4: P9's replayed nogood constructs
a real refutation through the new checker. Record membership, support inclusion and
current rejection are rechecked, rather than a LogicalStatus constructor being trusted. -/
theorem recorded_candidate_constructs_refutation {D : CalculusData} {E : Type}
    {cl : P9.RecordedClosure D E} {I : Iface D E} {w : World E}
    {c : Candidate D} {ng : List Token}
    (h : P9.classifyRecorded cl I w c = .refuted ng) :
    judge (⟨[()], fun _ => decide ((P9.judgeRecorded cl I w c).status = .verified)⟩ :
      Problem Unit) [] (fun _ => effSupports I c) cl.nogoods (some [((), ng)]) =
        .refuted [((), ng)] := by
  obtain ⟨hm, hs, hn⟩ := P9.recorded_refuted h
  have hsub : (ng.all fun t => decide (t ∈ effSupports I c)) = true := by
    simpa [List.all_eq_true] using hs
  simp [judge, P5.judge, checkCertificate, hm, hsub, hn w]

end Nanodregg.Lang.Contextual.P5.NogoodGames


  refine BigStep.case (ℓ := "some") (w := (Data.record [("answered", .inj "none" (.record [])), ("captured", captured)]).toVal) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))
  refine BigStep.case (ℓ := "none") (w := .record []) ?_ rfl ?_
  · exact .get (.var rfl) (.field rfl (.var rfl))

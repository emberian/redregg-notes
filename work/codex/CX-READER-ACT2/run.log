    .get (.get (.var rfl) (.field rfl (.var rfl))) (.field rfl (.var rfl))
  have hy : BigStep lib (.record [] :: old.toVal :: payload.toVal :: e)
      (.get (.var 1) "captured") (.ok before.toVal) :=
    .get (.var rfl) (.field rfl (.var rfl))

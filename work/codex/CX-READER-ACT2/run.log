    (key captured answer : Data) (lib : List Term) (env : Env) (state req : Val) :
    BigStep lib
      ((retirementInput key (.inj "some" (.record [
        ("answered", .inj "some" answer), ("captured", captured)]))).toVal :: req :: state :: env)

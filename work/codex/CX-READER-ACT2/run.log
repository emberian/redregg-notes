    out: dict[str, tuple[list[list[str]] | None, str, list[str] | str | None]] = {}
    p = os.path.join(root, RUNS)
    if not os.path.isfile(p):
        return out
    for n, line in enumerate(open(p, encoding="utf-8"), 1):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.rstrip("\n").split("\t")
        if len(f) != 4 or not all(x.strip() for x in f):
            raise ValueError(f"{RUNS}:{n}: need exe<TAB>runs<TAB>pass<TAB>control: {line.rstrip()!r}")
        if f[0] in out or f[0].removeprefix(STANDING) in out or STANDING + f[0] in out:
            raise ValueError(f"{RUNS}:{n}: second row for {f[0].removeprefix(STANDING)}")
        if f[0].startswith(CARGO):
            if len(f[0].split(":")) != 3 or f[2] != "exit 0" or f[3] not in NOBIN:
                raise ValueError(f"{RUNS}:{n}: a cargo row is cargo:CRATE:TEST<TAB>EXE,…<TAB>exit 0<TAB>nobin RED|nobin ok: {line.rstrip()!r}")
            out[f[0]] = ([[x.strip() for x in f[1].split(",") if x.strip()]], f[2], f[3])
            continue
        if f[1].strip() == "-":
            if f[0].startswith(STANDING):
                raise ValueError(f"{RUNS}:{n}: a standing row is a verdict run (runs, pass, a --{CONTROL} control), never `-`: {line.rstrip()!r}")
            if f[3].strip() != "-":
                raise ValueError(f"{RUNS}:{n}: a `-` row has control `-`: {line.rstrip()!r}")
            out[f[0]] = (None, f[2], None)
            continue
        if f"--{CONTROL}" not in f[3].split():
            raise ValueError(f"{RUNS}:{n}: verdict row {f[0]} needs a known-red control, an argument list with "
                             f"--{CONTROL} (GATES-15): {line.rstrip()!r}")
        runs = [[] if r.strip() == "(none)" else r.split() for r in f[1].split(" ; ")]
        out[f[0]] = (runs, f[2], f[3].split())
    return out


def check(t: tree.Tree) -> list[str]:
    """The table classifies exactly the lakefile's exes."""
    try:
        rows = table(t.root)
    except ValueError as e:
        return [str(e)]
    exes = set(t.exes)
    cargo = {k for k in rows if k.startswith(CARGO)}
    script = {k for k in rows if k.startswith("script:")}
    standing = {k for k in rows if k.startswith(STANDING)}
    named = (set(rows) - standing) | {k.removeprefix(STANDING) for k in standing}
    red = ([f"lean_exe {e} has no row in {RUNS} (a verdict run, or `-` with why it is not one)" for e in sorted(exes - named)]
           + [f"{RUNS} row {e} names no lean_exe" for e in sorted(set(rows) - exes - cargo - script - standing)]
           + [f"{RUNS} row {k} names no lean_exe" for k in sorted(standing) if k.removeprefix(STANDING) not in exes]
           + [f"{RUNS} row {k}: no executable {k[len('script:'):]}" for k in sorted(script)
              if not os.access(os.path.join(t.root, k[len("script:"):]), os.X_OK)]
           + [f"{RUNS} row {k}: a script row is a verdict run (runs, pass, a --{CONTROL} control), never `-`"
              for k in sorted(script) if rows[k][0] is None])
    for k in sorted(cargo):
        _, crate, test = k.split(":")
@[default_target] lean_exe «emit-rust» where
  root := `Emit.Main

-- The Rust copy of HOSTING frames (launcher/src/generated.rs). Imports Hosting.Wire; nothing imports it.
@[default_target] lean_exe «emit-hosting» where
  root := `Emit.HostingMain

-- The Rust copy of the broker frames (launcher/src/broker_generated.rs). Imports Hosting.BrokerWire.
@[default_target] lean_exe «emit-broker» where
  root := `Emit.BrokerMain

-- The provider leaf-key pins keybroker ships with (deploy/tls/pins, HOSTING-28). Imports Hosting.Pins.
@[default_target] lean_exe «emit-pins» where
  root := `Emit.PinsMain

-- The codec vectors (gates/codec-vectors.tsv, CODEC-28): a change of meaning under the same tag is red.
@[default_target] lean_exe «codec-vectors» where
  root := `Emit.VectorsMain

-- KERNEL's seeded simulation: `kernel-sim SEED…` (or `--seeds N`), ends `ALL PASS` (standing.sh).
@[default_target] lean_exe «kernel-sim» where
  root := `Kernel.Sim.Main

-- LEDGER's escrow through KERNEL's receivers, with its plants (standing's sim stage); --write-text
-- rewrites world/escrow/Escrow.
@[default_target] lean_exe «ledger-sim» where
  root := `Ledger.Sim.Main

-- LANG's first law end to end: install → create → invoke through KERNEL's receivers.
@[default_target] lean_exe «lang-journey» where
  root := `Lang.Journey.Main

-- LANG's resident check: `ob FORM` reads, checks, prints bytes and id, evaluates, runs a law;
-- no admission (Lang.Resident).
@[default_target] lean_exe «ob» where
  root := `Lang.Resident.Main

-- PROTOCOL's conformance rows: `rows [NAME…]` (rows/run, standing's rows stage), ends `ALL PASS`.
@[default_target] lean_exe «rows» where
  root := `Protocol.Rows.Main

-- Host/c/*.c: the Store's physical IO (Host.File's externs) and a Unix socket's client end (Host.Sock's). Sorted, so the archive is reproducible.
extern_lib «ndhost» pkg := do
  let dir := pkg.dir / "Host" / "c"
  let srcs := (← dir.readDir).filter (·.path.extension == some "c") |>.map (·.path)
    |>.qsort (·.toString < ·.toString)
  let leanInc := (← getLeanIncludeDir).toString
  let objs ← srcs.mapM fun src => do
    let o := pkg.buildDir / "c" / ((src.withExtension "o").fileName.getD "x.o")
    buildO o (← inputTextFile src) #["-I", leanInc] #["-fPIC", "-O2", "-Wall", "-Wextra", "-Werror"]
      "cc" getLeanTrace
  buildStaticLib (pkg.staticLibDir / nameToStaticLib "ndhost") objs

-- The Host's loop end to end over the in-memory disk, with the crash plants (standing: seeds 1 2 3).
@[default_target] lean_exe «host-sim» where
  root := `Host.Sim.Main

-- The deployed Host: `host genesis|serve|follow STORE …` (Host.Cli); the client runs the binary.
@[default_target] lean_exe «host» where
  root := `Host.Main

-- PERF: tools over a real Store the deployed host wrote (tooling; nothing imports Bench).
@[default_target] lean_lib Bench where
  globs := #[.submodules `Bench]

-- THE BAR's work at deployed parameters: `bench-count STORE SCRATCH [--harness-control]` (PERF-3; scripts/bar.sh runs it).
@[default_target] lean_exe «bench-count» where
  root := `Bench.CountMain

-- THE BAR's reopen at the tailMax worst cut, one sized bench row per tail shape:
-- `bench-worstcut-<shape> SCRATCH [--harness-control]` (PERF-5, PERF-12; the shared harness is Bench.WorstCut).
@[default_target] lean_exe «bench-worstcut-writes» where
  root := `Bench.WorstCutWritesMain

@[default_target] lean_exe «bench-worstcut-births» where
  root := `Bench.WorstCutBirthsMain

@[default_target] lean_exe «bench-worstcut-retires» where
  root := `Bench.WorstCutRetiresMain

@[default_target] lean_exe «bench-worstcut-rows» where
  root := `Bench.WorstCutRowsMain

-- THE BAR's reopen at the worst World, the reader's bound: `bench-worstworld SCRATCH synthetic N | honest [STATE_BYTES]` (PERF-8).
@[default_target] lean_exe «bench-worstworld» where
  root := `Bench.WorstWorldMain

-- OPS: renderers and drivers over the real `host` (nothing imports Ops).
@[default_target] lean_lib Ops where
  globs := #[.submodules `Ops]

-- The service-manager units and EXITS.md, rendered from Host.Status and Protocol.SupervisorExit: `emit-units [--check] deploy/units`.
@[default_target] lean_exe «emit-units» where
  root := `Ops.Main

-- Backup/restore plants against the real `host`: `store-plants HOST_EXE DIR`, ends `ALL PASS`.
@[default_target] lean_exe «store-plants» where
  root := `Ops.PlantsMain

-- The live harness's calls (deploy/live/): `live-calls DIR N`, the test founder's genesis args and N payloads.
@[default_target] lean_exe «live-calls» where
  root := `Ops.LiveCallsMain

-- The loop over a real Store directory (Host.Store + Host/c/file.c): lock, torn-file truncation.
@[default_target] lean_exe «host-file-sim» where
  root := `Host.Sim.FileMain

-- Host.Sock's contracts (Host/c/sock.c), driven by launcher/tests/sock.rs, which holds the peer.
@[default_target] lean_exe «host-sock-probe» where
  root := `Host.Sim.SockMain
import Lang.Journey
namespace Nanodregg.Lang.Journey.ReaderAct2
open Nanodregg.Kernel Nanodregg.Kernel.Receive
def reviewedHoleRows (mode : Mode) (r0 : Run) (a b : Sim.Member) : Run := Id.run do
  let prog := mode.program
  let mut r := r0
  for (name, want, got) in Std.holeCheckRows do
    r := note r s!"LH-prefix {name}: {got}" (got == want)
  let bundle ← match Std.generatedHoleBundle with
    | .ok b => pure b
    | .error e => return note r s!"LH0 generating the hole: {e.name}" false
  let mut libraryIds : List D := []
  for lib in bundle.libraries do
    let some bytes := Wire.encodePackage lib | return note r "LH0 library has no bytes" false
    let (rL, vL, tL) := go prog r (Sim.signed r.st a a.key
      (Sim.S.pinsFor r.st.host [a.id]) (.install bytes))
    r := note rL s!"LH0 installing helper ROM ({bytes.size} bytes): {vL}"
      (vL == "admitted" && bytes.size ≤ Lang.Bounds.bytesMax)
    let some id := tL.bind fun t => (createdIds t).head? | return note r "LH0 no helper ROM id" false
    libraryIds := libraryIds ++ [id]
  let generated ← match bundle.link (libraryIds.map Sim.dc.bytes) with
    | .ok p => pure p
    | .error e => return note r s!"LH0 linking the hole: {e.name}" false
  let some src := Print.package generated | return note r "LH0 hole is not printable" false
  let p ← match Surface.readPackage src with
    | .ok p => pure p
    | .error e => return note r s!"LH0 read the generated hole: {e.text src}" false
  r := note r s!"LH0 generated hole reads ({src.length} chars): methods {p.methods}, laws {p.laws}, relations {p.rels.map (·.1)}"
    (p.methods == ["accept", "fill", "post", "propose", "prune", "rejudge", "repin", "resume_fill", "retire", "select", "unpost"] &&
      p.laws == ["shape"] && p.rels.map (·.1) == ["candidates", "facts", "fills", "pending"])
  let some pb := Wire.encodePackage p | return note r "LH0 no bytes" false
  let some dC := p.rels.lookup "candidates" | return note r "LH0 no candidates" false
  let some dF := p.rels.lookup "facts" | return note r "LH0 no facts" false
  -- LH1 install
  let (r1, v1, t1) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host (a.id :: libraryIds)) (.install pb))
  r := note r1 s!"LH1 A installs the hole ({pb.size} package bytes): {v1}" (v1 == "admitted")
  let some pkg := t1.bind fun t => (createdIds t).head? | return note r "LH1 no package id" false
  -- LH2 create: cap 10, chooser A, acceptor B, closes far off, nothing selected
  let seedData : List (Label × Data) :=
    [("accepted", .bool false), ("acceptor", .digest (Sim.dc.bytes b.id)), ("cap", .nat 10),
     ("chooser", .digest (Sim.dc.bytes a.id)), ("closes", .nat 100000), ("selected", .inj "none" (.record []))]
  let some seed := stateSlots (recordRow p.state) seedData 0 | return note r "LH2 seed has no bytes" false
  let (r2, v2, t2) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host ([a.id, pkg] ++ libraryIds)) (.create (some pkg) [] seed))
  let some obj := t2.bind fun t => (createdIds t).head? | return note r2 s!"LH2 no hole: {v2}" false
  r := note r2 s!"LH2 A creates the hole (cap 10, chooser A, acceptor B): {v2}; all four relations born empty"
    (v2 == "admitted" && [0, 1, 2, 3].all fun i => headCount r2.st.host obj i == some 0)
  -- LH3 A grants B accept (0), post (1), repin (4), unpost (6)
  let (r3, v3, t3) := go prog r (Sim.signed r.st a a.key (Sim.S.pinsFor r.st.host [a.id, b.id, obj])
    (.grant obj b.id [.invoke (p.methods.idxOf "accept"), .invoke (p.methods.idxOf "post"), .invoke (p.methods.idxOf "repin"), .invoke (p.methods.idxOf "unpost"), .invoke (p.methods.idxOf "resume_fill")] none))
  r := note r3 s!"LH3 A grants B accept, post, repin, unpost: {v3}" (v3 == "admitted")
  let some gr := t3.bind fun t => (createdIds t).head? | return note r "LH3 no grant id" false
  let pinsOf (r : Run) (m : Sim.Member) := Sim.S.pinsFor r.st.host ([m.id, obj, pkg] ++ libraryIds ++ if m.id == b.id then [gr] else [])
  let viaOf (m : Sim.Member) : Option D := if m.id == b.id then some gr else none
  let call (r : Run) (m : Sim.Member) (method : Label) (x : ByteArray) (rowPins : List (RowSlot D × D) := []) : Call D :=
    signedAt r.st m (pinsOf r m) (.invoke obj (p.methods.idxOf method) x 100000 (viaOf m)) r.st.host.height (r.st.host.height + 1024) rowPins
  let cost (c : Call D) (w : World D) : String :=
    s!"required steps / ticks {match measure w c with | .ok (q, k) => s!"{q} / {k}" | .error e => e}"
  -- the two facts: cells f1, f2 (any Sim digests), pins p1, p2
  let f1 := Sim.dc.bytes a.id
  let f2 := Sim.dc.bytes b.id
  let p1 := Sim.dc.bytes pkg
  let p2 := Sim.dc.bytes obj
  let p1' := Sim.dc.bytes gr
  let factKey (cell : ByteArray) : Data := .record [("cell", .digest cell)]
  let candKey (cand : ByteArray) : Data := .record [("cand", .digest cand)]
  let pinFact (w : World D) (cell : ByteArray) := hole_pinAt obj w 1 dF (factKey cell)
  let pinCand (w : World D) (cand : ByteArray) := hole_pinAt obj w 0 dC (candKey cand)
  let factPin (w : World D) (cell : ByteArray) : Option ByteArray :=
    match (storyRow w obj 1 dF (factKey cell)).bind (·.field "pin") with
    | some (.digest d) => some d
    | _ => none
  -- LH4 B posts f1@p1 and f2@p2
  let (r4a, v4a, _) := go prog r (call r b "post" (hole_postArg f1 p1))
  r := note r4a s!"LH4a B posts fact f1 at pin p1: {v4a}" (v4a == "admitted" && factPin r4a.st.host f1 == some p1)
  let (r4b, v4b, _) := go prog r (call r b "post" (hole_postArg f2 p2))
  r := note r4b s!"LH4b B posts fact f2 at pin p2: {v4b}" (v4b == "admitted" && headCount r4b.st.host obj 1 == some 2)
  let (_, v4c, _) := go prog r (call r a "post" (hole_postArg f1 p1))
  r := note r s!"LH4c A posts f1 again (B's token): {v4c}" (v4c.startsWith "rejected keyTaken")
  -- LH5 candidates: c1 over f1@p1, f2@p2; c2 over f2@p2; c3 past the cap
  let c1 := Sim.dc.bytes (founderId (ctxWith prog) r.st.host.origin 7)
  let c2 := Sim.dc.bytes (founderId (ctxWith prog) r.st.host.origin 8)
  let c3 := Sim.dc.bytes (founderId (ctxWith prog) r.st.host.origin 9)
  let (r5a, v5a, _) := go prog r (call r a "propose" (hole_proposeArg c1 (hole_supportData f1 p1) (hole_supportData f2 p2) 5) (pinFact r.st.host f1 ++ pinFact r.st.host f2))
  r := note r5a s!"LH5a A proposes c1 (value 5, facts f1@p1 f2@p2): {v5a}; status {hole_statusOf r5a.st.host obj dC c1}"
    (v5a == "admitted" && hole_statusOf r5a.st.host obj dC c1 == some "verified")
  let (r5b, v5b, _) := go prog r (call r a "propose" (hole_proposeArg c2 (hole_supportData f2 p2) hole_noSupport 7) (pinFact r.st.host f2))
  r := note r5b s!"LH5b A proposes c2 (value 7, fact f2@p2): {v5b}; status {hole_statusOf r5b.st.host obj dC c2}"
    (v5b == "admitted" && hole_statusOf r5b.st.host obj dC c2 == some "verified")
  let (r5c, v5c, _) := go prog r (call r a "propose" (hole_proposeArg c3 hole_noSupport hole_noSupport 50))
  r := note r5c s!"LH5c A proposes c3 (value 50, past the cap): {v5c}; retained with its reason: {hole_statusOf r5c.st.host obj dC c3}"
    (v5c == "admitted" && hole_statusOf r5c.st.host obj dC c3 == some "conflict \"clause\"")
  -- LH5d a candidate filed verified past the cap: the guard refuses it (the status is the clause's, not the author's)
  let (_, v5d, _) := go prog r (call r a "propose" (hole_proposeArg c3 hole_noSupport hole_noSupport 50))
  r := note r s!"LH5d A proposes c3 again (its key is taken): {v5d}" (v5d.startsWith "rejected keyTaken")
  let c4 := Sim.dc.bytes (founderId (ctxWith prog) r.st.host.origin 10)
  let (rf, vf, _) := go prog r (call r a "fill"
    (hole_proposeArg c4 (hole_supportData f1 p1) hole_noSupport 4) (pinFact r.st.host f1))
  r := note r s!"LH5f (scratch) fill a supported candidate atomically: {vf}"
    (vf == "admitted" && hole_selectedOf Sim.env rf.st.host obj == some (some c4) &&
      hole_statusOf rf.st.host obj dC c4 == some "verified")
      hole_statusOf r11.st.host obj dC c2 == some "verified" && headCount r11.st.host obj 0 == some 3)
  -- LH11b B prunes (not the chooser): the guard refuses it
  let (_, v11b, _) := go prog r (call r b "prune" (hole_pruneArg c2 f1 p1' "mine") (pinCand r.st.host c2))
  r := note r s!"LH11b B prunes c2: {v11b}" (v11b.startsWith "refused grantRight" || refusedBy v11b "prune" "notChooser")

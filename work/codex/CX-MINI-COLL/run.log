import Theory.ObjectiveBendDigest
import Verify.ScopedCollision
namespace Minidregg.Verify.CollisionDigestTeeth
open Minidregg.Theory Minidregg.Theory.HashBytes Minidregg.Theory.ObjectiveBendDigest
set_option maxHeartbeats 1000000

/-- A fixed 32-byte hash; it separates the actual inner/outer model inputs but collides elsewhere. -/
def modelHash (input : List UInt8) : List UInt8 :=
  be 32 (if input = preimage 0 0 then 1 else 2)

theorem model_width (input : List UInt8) : (modelHash input).length = 32 := by
  simp [modelHash]

theorem model_collision_elsewhere :
    CollidesAmong (fun p => ofBE (modelHash p)) [preimage 0 1, preimage 0 2] :=
  CollidesAmong.pair (by decide) (by decide)

theorem binds_or_collides_nonvacuous :
    Admissible 0 ∧ digestWith modelHash 0 0 = digestWith modelHash 0 0 ∧
      ¬ CollidesAmong (fun p => ofBE (modelHash p)) [preimage 0 0, preimage 0 0] := by
  refine ⟨admissible_zero, rfl, ?_⟩
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false, or_self] at ha hb
  exact ne (ha.trans hb.symm)

theorem model_inner : digestWith modelHash 0 0 = 1 := by decide

/-- The sealed theorem's four-input construction at an inhabited, fixed-width hash.
This does not assert that modelHash is the deployed cSHAKE function. -/
theorem sealed_binds_or_collides_nonvacuous :
    ¬ CollidesAmong (fun p => ofBE (modelHash p))
      ([preimage 0 0, preimage 0 0] ++
        [preimage (digestWith modelHash 0 0) 0, preimage (digestWith modelHash 0 0) 0]) := by
  rw [model_inner]
  rintro ⟨a, ha, b, hb, ne, eq⟩
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, or_self] at ha hb
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
  · exact ne rfl
  · revert eq; decide
  · revert eq; decide
  · exact ne rfl

#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.binds_or_collides
#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.sealed_binds_or_collides
#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.lengthHash_collides
#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.hiding_at_equality_is_a_collision
end Minidregg.Verify.CollisionDigestTeeth

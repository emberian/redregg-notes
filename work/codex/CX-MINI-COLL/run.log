(root/\"Theory/CollidesAmong.lean\").write_text(\"/- Explicit finite inputs for binding reductions. Init only. -/\\nnamespace Minidregg.Theory\\n\\nset_option autoImplicit false\\nset_option maxHeartbeats 1000000\\n\\n/-- A collision among the inputs compared by this particular operation. -/\\ndef CollidesAmong {A B : Type} (hash : A → B) (inputs : List A) : Prop :=\\n  ∃ a ∈ inputs, ∃ b ∈ inputs, a ≠ b ∧ hash a = hash b\\n\\nnamespace CollidesAmong\\nvariable {A B : Type} {hash : A → B} {xs ys : List A}\\n\\ntheorem pair {a b : A} (hne : a ≠ b) (heq : hash a = hash b) :\\n    CollidesAmong hash [a, b] :=\\n  ⟨a, (List.mem_cons_self ..), b, List.mem_cons_of_mem _ (List.mem_cons_self ..), hne, heq⟩\\n\\ntheorem mono (h : CollidesAmong hash xs) (sub : ∀ x ∈ xs, x ∈ ys) :\\n    CollidesAmong hash ys := by\\n  obtain ⟨a, ha, b, hb, ne, eq⟩ := h\\n  exact ⟨a, sub a ha, b, sub b hb, ne, eq⟩\\n\\ntheorem append_left (h : CollidesAmong hash xs) (ys : List A) :\\n    CollidesAmong hash (xs ++ ys) :=\\n  h.mono (fun _ hx => List.mem_append_left _ hx)\\n\\ntheorem append_right (xs : List A) (h : CollidesAmong hash ys) :\\n    CollidesAmong hash (xs ++ ys) :=\\n  h.mono (fun _ hx => List.mem_append_right _ hx)\\n\\ntheorem not_singleton (hash : A → B) (a : A) : ¬ CollidesAmong hash [a] := by\\n  rintro ⟨x, hx, y, hy, ne, _⟩\\n  simp only [List.mem_singleton] at hx hy\\n  exact ne (hx.trans hy.symm)\\n\\ntheorem eliminate {P : Prop} (h : P ∨ CollidesAmong hash xs)\\n    (separates : ¬ CollidesAmong hash xs) : P :=\\n  h.resolve_right separates\\n\\nend CollidesAmong\\nend Minidregg.Theory\\n\")
(root/\"Verify/ScopedCollision.lean\").write_text(\"import Lean\\nimport Theory.CollidesAmong\\n\\nopen Lean Meta Elab Command\\nnamespace Minidregg.Verify.ScopedCollision\\nset_option autoImplicit false\\nset_option maxHeartbeats 1000000\\n\\n/-- Deliberately erase list membership, only for the rejected mutation test. -/\\ndef dropList {A B : Type} {hash : A → B} {xs : List A} :\\n    Theory.CollidesAmong hash xs → ∃ a b, a ≠ b ∧ hash a = hash b\\n  | ⟨a, _, b, _, ne, eq⟩ => ⟨a, b, ne, eq⟩\\n\\ndef occurrences : Expr → Nat\\n  | .const n _ => if n == "'`Minidregg.Theory.CollidesAmong then 1 else 0'"\\n  | .app f a => occurrences f + occurrences a\\n  | .lam _ t b _ | .forallE _ t b _ => occurrences t + occurrences b\\n  | .letE _ t v b _ => occurrences t + occurrences v + occurrences b\\n  | .mdata _ e | .proj _ _ e => occurrences e\\n  | _ => 0\\n\\ndef check (n : Name) : MetaM Unit := do\\n  let ci ← getConstInfo n\\n  if occurrences ci.type == 0 then\\n    throwError \\\"SCOPED-COLLISION RED {n}: explicit finite input list missing\\\"\\n  logInfo m"'!'"\\\"SCOPED-COLLISION PASS {n}\\\"\\n\\n/-- The mutation is a proved weakening of the actual theorem, not a fabricated error. -/\\ndef weaken : Nat → Expr → MetaM Expr\\n  | 0, _ => throwError \\\"scoped-collision: mutation recursion limit\\\"\\n  | fuel + 1, proof => do\\n      let t ← inferType proof\\n      if t.isAppOf "'`Minidregg.Theory.CollidesAmong then'"\\n        return ← mkAppM "'`Minidregg.Verify.ScopedCollision.dropList #[proof]'"\\n      else if t.isAppOfArity "'`Or 2 then'"\\n        let a := t.getArg"'! 0'"\\n        let b := t.getArg"'! 1'"\\n        let fa ← withLocalDeclD "'`ha a fun ha => do mkLambdaFVars #[ha] (← weaken fuel ha)'"\\n        let fb ← withLocalDeclD "'`hb b fun hb => do mkLambdaFVars #[hb] (← weaken fuel hb)'"\\n        return ← mkAppM "'`Or.imp #[fa, fb, proof]'"\\n      else\\n        return proof\\n\\nelab \\\"#assert_scoped_collision \\\" n:ident : command => liftTermElabM do\\n  let name ← resolveGlobalConstNoOverload n\\n  check name\\n\\nelab \\\"#plant_unbounded_collision \\\" n:ident : command => liftTermElabM do\\n  let name ← resolveGlobalConstNoOverload n\\n  let ci ← getConstInfo name\\n  let value ← forallTelescope ci.type fun xs _ => do\\n    let proof := mkAppN (mkConst name (ci.levelParams.map Level.param)) xs\\n    mkLambdaFVars xs (← weaken 256 proof)\\n  let type ← inferType value\\n  let mutant := name ++ "'`listDroppedMutant'"\\n  if occurrences type "'!= 0 then throwError '"\\\"scoped-collision: mutation did not drop every list at {name}\\\"\\n  addDecl (.thmDecl { name := mutant, levelParams := ci.levelParams, type, value })\\n  check mutant\\nend Minidregg.Verify.ScopedCollision\\n\")

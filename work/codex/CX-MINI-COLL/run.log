                    roots = [int(r) for r in p[6].split()]
                    self.consts[p[1]] = [p[2] == "I", p[3], p[4], p[5], roots, p[7:]]
                elif t == "R":
                    raw_rows.append(line.split("\t", 6))
                elif t == "a":
                    _, i, j = line.split(" ")
                    nodes.append(H("a", nodes[int(i)], nodes[int(j)]))
                    raw.append(("a", "", (int(i), int(j))))
                elif t in ("l", "f"):
                    _, bi, i, j = line.split(" ")

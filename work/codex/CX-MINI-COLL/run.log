import Pred.HashEq
import Verify.ScopedCollision

namespace Minidregg.Verify.CollisionPredicateTeeth
open Theory Pred Pred.HashEqDigest
set_option autoImplicit false
set_option maxHeartbeats 1000000

def opening : Opening := ⟨0, ["v"], "b", "c", [0], 0⟩
def state : State := ⟨[("request/target", 0), ("v", 0), ("b", 0),
  ("c", digestWith deployed opening)]⟩

theorem admissible : opening.Admissible := opening_vbc_admissible 0 (by decide) (by decide)

theorem accepted : eval (.hashEq ["v"] "b" "c") state state = true :=
  hashEq_admits opening admissible state state rfl rfl rfl rfl

theorem opens : hashEqOpening state ["v"] "b" "c" = some opening :=
  hashEqOpening_eq_some.mpr ⟨rfl, rfl, rfl, rfl, rfl, rfl, admissible⟩

/-- Accepted at the deployed fixed-width hash, and its actual collision disjunct is false. -/
theorem nonvacuous :
    eval (.hashEq ["v"] "b" "c") state state = true ∧
    ¬ CollidesAmong (fun x => HashBytes.ofBE (deployed x))
      (hashEqInputs state ["v"] "b" "c" ++ hashEqInputs state ["v"] "b" "c") := by
  refine ⟨accepted, ?_⟩
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [hashEqInputs, opens] at ha hb
  exact ne (ha.trans hb.symm)

#assert_scoped_collision Pred.HashEqDigest.binds_or_collides
#assert_scoped_collision Pred.HashEqDigest.lengthHash_collides
#assert_scoped_collision Pred.hashEq_binds_or_collides
#assert_scoped_collision Pred.hashEq_reveal_binds
#assert_scoped_collision Pred.hashEq_reveal_binds_each
#assert_scoped_collision Pred.hashEq_context_bound
#assert_scoped_collision Pred.hiding_at_equality_is_a_collision
end Minidregg.Verify.CollisionPredicateTeeth
import Compiler.DurableIndex
import Compiler.DurableHistory
import Compiler.PredCompile
import Compiler.ReceiptContinuityIO
import Kernel.SealedMarket
import Verify.ScopedCollision
import Verify.CollisionTreeTeeth
import Verify.CollisionWorldTeeth

namespace Minidregg.Verify.CollisionConsumerTeeth
open Theory
set_option autoImplicit false
set_option maxHeartbeats 1000000

/-- Empty canonical index: an honest absence read has only the empty input,
even at the deployed digest shape and hash. -/
theorem index_nonvacuous (k : Compiler.DurableIndex.IndexKey) :
    ¬ CollidesAmong (Compiler.Sp800185Cshake256.hash Compiler.DurableIndex.nodeCustomization)
      ((AuthTrie.readInputs Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf 520 []
        k ⟨[], .empty⟩).map Compiler.DurableIndex.nodeBytes) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [AuthTrie.readInputs, AuthTrie.climbInputs, AuthTrie.Terminal.input,
    AuthTrie.treeInputs, AuthTrie.entries] at ha hb
  exact ne (ha.trans hb.symm)

/-- A nonempty deployed index also has an accepted opening with a false collision escape. -/
theorem index_present_nonvacuous (k : Compiler.DurableIndex.IndexKey) (value : List UInt8) :
    AuthTrie.verify Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf
      (Compiler.DurableIndex.rootOf [(k, value)]) k (some value) ⟨[], .leaf k value⟩ = true ∧
    ¬ CollidesAmong (Compiler.Sp800185Cshake256.hash Compiler.DurableIndex.nodeCustomization)
      ((AuthTrie.readInputs Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf 520 [(k, value)]
        k ⟨[], .leaf k value⟩).map Compiler.DurableIndex.nodeBytes) := by
  constructor
  · simp [AuthTrie.verify, AuthTrie.climb, AuthTrie.Terminal.input,
      Compiler.DurableIndex.rootOf, AuthTrie.entries, AuthTrie.tree]
  · rintro ⟨a, ha, b, hb, ne, _⟩
    simp [AuthTrie.readInputs, AuthTrie.climbInputs, AuthTrie.Terminal.input,
      AuthTrie.treeInputs, AuthTrie.entries] at ha hb
    exact ne (ha.trans hb.symm)

/-- The deployed index-path collision escape is false on a real one-slot list. -/
theorem deployed_paths_nonvacuous :
    ¬ CollidesAmong Kernel.WorldRoot.deployedHash
      (Kernel.WorldRoot.keyInputs [(.system, ⟨0⟩)]) := CollidesAmong.not_singleton _ _

/-- The full range of an empty index compares only repeated empty nodes. -/
theorem index_range_nonvacuous :
    ¬ CollidesAmong (Compiler.Sp800185Cshake256.hash Compiler.DurableIndex.nodeCustomization)
      ((AuthTrie.revealInputs Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf 520 []
        [] ⟨[], []⟩).map Compiler.DurableIndex.nodeBytes) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [AuthTrie.revealInputs, AuthTrie.climbInputs, AuthTrie.treeInputs,
    AuthTrie.entries, AuthTrie.Reveal.entriesBelow, AuthTrie.select] at ha hb
  exact ne (ha.trans hb.symm)

/-- Empty world entry lists make the deployed root's collision disjunct false. -/
theorem deployed_root_nonvacuous (k : Kernel.WorldRoot.Key) :
    ¬ CollidesAmong Kernel.WorldRoot.deployedHash
      ((Kernel.WorldRoot.keyInputs [] ++ Kernel.WorldRoot.keyInputs []) ++
        (AuthTrie.readInputs Kernel.WorldRoot.worldDig Kernel.WorldRoot.deployedIx 256
          (AuthTrie.canon []) k
          ((AuthTrie.Cache.build (dig := Kernel.WorldRoot.worldDig)
            Kernel.WorldRoot.deployedIx_length []).opening k)).map Kernel.WorldRoot.nodeBytes) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  have inputs : AuthTrie.readInputs Kernel.WorldRoot.worldDig Kernel.WorldRoot.deployedIx 256
      (AuthTrie.canon []) k
      ((AuthTrie.Cache.build (dig := Kernel.WorldRoot.worldDig)
        Kernel.WorldRoot.deployedIx_length []).opening k) = [.empty, .empty] := by
    rfl
  simp [inputs, Kernel.WorldRoot.keyInputs] at ha hb
  exact ne (ha.trans hb.symm)

/-- A one-leaf deployed history read compares no internal-node inputs. -/
theorem history_nonvacuous (record : List UInt8)
    (chain root : Theory.TypedAuthorization.Digest) :
    let claimed := Compiler.DurableHistory.leafDigest 1 record chain root
    LogAccumulator.verify Compiler.DurableHistory.nodeDigest [(0, claimed)] 1 1 claimed
      (Compiler.DurableHistory.lookupNode []) = true ∧
    ¬ CollidesAmong (fun p : Theory.TypedAuthorization.Digest ×
        Theory.TypedAuthorization.Digest => Compiler.DurableHistory.nodeDigest p.1 p.2)
      (LogAccumulator.readInputs Compiler.DurableHistory.nodeDigest (fun _ => claimed)
        1 1 [(0, claimed)] claimed (Compiler.DurableHistory.lookupNode [])) := by
  dsimp only
  simp [LogAccumulator.verify, LogAccumulator.locate, LogAccumulator.rootOfPath,
    LogAccumulator.readInputs, LogAccumulator.pathInputs, CollidesAmong]

#assert_scoped_collision Theory.AuthTrie.Cache.root_lastVal_eq
#assert_scoped_collision Compiler.DurableIndex.collision_is_cshake
#assert_scoped_collision Compiler.DurableIndex.lookup_sound
#assert_scoped_collision Compiler.DurableIndex.reveal_sound
#assert_scoped_collision Compiler.DurableIndex.Answer.sound
#assert_scoped_collision Compiler.DurableHistory.verifyAt_sound
#assert_scoped_collision Compiler.lower_hashEq_binds
#assert_scoped_collision Kernel.SealedMarket.market_reveal_binds
#assert_scoped_collision Kernel.WorldRoot.rootOf_eq_exhibits_collision
#assert_scoped_collision Kernel.WorldRoot.worldDig_collision
#assert_scoped_collision Kernel.WorldRoot.deployed_paths
#assert_scoped_collision Kernel.WorldRoot.deployedRoot_binds
#assert_scoped_collision Kernel.ReceiptContinuity.opens_sound
#assert_scoped_collision Compiler.ReceiptContinuityIO.systemSiblings_open
end Minidregg.Verify.CollisionConsumerTeeth

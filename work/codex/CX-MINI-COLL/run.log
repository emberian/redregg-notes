  levels=[]; commas=[]; i=a+1
  pairs={\"(\":\")\",\"[\":\"]\",\"{\":\"}\",\"⟨\":\"⟩\"}
  while i<len(part):
   c=part[i]
   if c in pairs: levels.append(pairs[c])
   elif levels and c==levels[-1]: levels.pop()
   elif c==\"⟩\" and not levels: break
   elif c==\",\" and not levels: commas.append(i)
   i+=1
  if len(commas)"'!=3: continue
  fields=[]; prev=a+1
  for j in commas+[i]: fields.append(part[prev:j]);prev=j+1

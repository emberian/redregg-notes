# "still running" (COORD-AUDIT C5): .done is written only by the last line below.
trap '[ -f "$G/logs/gate-$TAG.done" ] || echo "ABORTED $(date -Is) rc=$? at ${BASH_COMMAND:0:80}" > "$G/logs/gate-$TAG.aborted"' EXIT

def main():
    os.chdir(ROOT)
    OUT.mkdir(parents=True, exist_ok=True)
    failed = False
    receipts = []
    groups = tuple(sys.argv[1:]) or GROUPS
    if any(group not in GROUPS for group in groups):
        raise SystemExit("unknown scoped-collision site group")
    catalog = {group: [] for group in GROUPS}
    for line in (ROOT / "scripts/gates/scoped-collision-sites.tsv").read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        group, name = line.split("\t")
        catalog[group].append(name)
    for group in groups:
        module = "Verify.Collision" + group + "Teeth"
        source = (ROOT / (module.replace(".", "/") + ".lean")).read_text()
        names = re.findall(r"^#assert_scoped_collision (\S+)", source, re.M)
        # The commands sit inside namespace Minidregg.Verify.*; fully qualify here.
        names = [n if n.startswith("Minidregg.") else "Minidregg." + n for n in names]
        if names != catalog[group]:
            print("SCOPED-COLLISION FAIL: source checks differ from reviewed sites in " + group)
            failed = True
            continue
        if not names:
            print("SCOPED-COLLISION FAIL: empty site group " + group)
            failed = True
            continue
        for checked in (False, True):
            mode = "checked" if checked else "derived"
            command = "#plant_unbounded_collision" if checked else "#derive_unbounded_collision"
            path = OUT / (group.lower() + "-" + mode + ".lean")
            path.write_text("import " + module + "\nset_option maxHeartbeats 1000000\n" +
                            "".join(command + " " + n + "\n" for n in names))
            run = subprocess.run(["lake", "env", "lean", str(path)], text=True,
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            log = OUT / (group.lower() + "-" + mode + ".log")
            log.write_text(run.stdout)
            print(run.stdout, end="")

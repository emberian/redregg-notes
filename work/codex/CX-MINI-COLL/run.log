#!/usr/bin/env python3
"""Exercise smoke's real cleanup and a disabled survivor-check mutant."""
from pathlib import Path
import os
import signal
import subprocess
import tempfile

HERE = Path(__file__).resolve().parent


def main():
    source = (HERE / "smoke-artifacts").read_text()
    start = source.index("\ncleanup() {") + 1
    end = source.index("\ntrap cleanup EXIT", start) + len("\ntrap cleanup EXIT")
    cleanup = source[start:end]
    guard = 'if kill -0 "$pid" 2>/dev/null; then'
    assert cleanup.count(guard) == 1
    with tempfile.TemporaryDirectory(prefix="cx-mini-coll-smoke-") as directory:
        root = Path(directory)
        pidfile = root / "probe.pid"
        child = subprocess.Popen(["sleep", "120"])
        pidfile.write_text(str(child.pid) + "\n")

        def case(name, pid=None, status=0, mutated=False):
            scratch = root / name
            scratch.mkdir()
            if pid is not None:
                path = scratch / "j/world/public/server.pid"
                path.parent.mkdir(parents=True)
                path.write_text(pid + "\n")
            body = cleanup.replace(guard, "if false; then") if mutated else cleanup
            run = subprocess.run(
                ["bash", "-c", 'pipeline_log() { printf "%s\\n" "$*"; }\n'
                 + body + "\nexit " + str(status)],
                env={**os.environ, "R": str(scratch)}, text=True,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            )
            print(name, "rc=" + str(run.returncode),
                  "scratch_preserved=" + str(scratch.exists()))
            print(run.stdout, end="")
            return run.returncode, scratch.exists()

        try:
            assert case("no-server") == (0, False)
            assert case("preserve-original-failure", status=7) == (7, False)
            assert case("invalid-pid", pid="not-a-pid") == (1, True)
            assert case("live-recorded-server", pid=pidfile.read_text().strip()) == (1, True)
            assert child.poll() is None
            rc, preserved = case(
                "disabled-survivor-check", pid=pidfile.read_text().strip(), mutated=True,
            )
            assert rc == 0 and not preserved and child.poll() is None
            print("SMOKE-CLEANUP PLANT RED: cleanup deleted scratch while recorded server was alive")
        finally:
            pid = int(pidfile.read_text())
            assert pid == child.pid
            if child.poll() is None:
                os.kill(pid, signal.SIGTERM)
            child.wait(timeout=10)
    print("smoke-cleanup: PASS (status preserved; invalid/live PID refused; disabled check caught)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

def readInputs (bitsOf : K → List Bool) (L : Nat) (kvs : List (K × V))
    (k : K) (opening : Opening K V D) : List (NodeIn K V D) :=
  climbInputs dig ((bitsOf k).take opening.siblings.length) opening.siblings
      (dig opening.terminal.input) ++
    opening.terminal.input :: treeInputs dig L (entries bitsOf kvs)


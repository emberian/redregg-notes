  awk -v l="$load" -v m="${PIPELINE_GATE_MAX_LOAD:-20}" 'BEGIN {exit !(l <= m)}' && break
  pipeline_log "load $load > ${PIPELINE_GATE_MAX_LOAD:-20}: gate waits"; sleep 120
done
pipeline_log "gate $tag: $T/run-gate-burst.sh $L $base_tip $tag"

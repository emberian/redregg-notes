+# journey.sh owns its server and stops it through its recorded PID. Never signal
+# processes by command-line pattern here. Preserve the scratch evidence if its
+# recorded server is still alive instead of deleting the only ownership record.
+cleanup() {
+  local status=$? pid_file="$R/j/world/public/server.pid" pid
+  if [ -f "$pid_file" ]; then
+    IFS= read -r pid < "$pid_file" || pid=""
+    if ! [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
+      pipeline_log "SMOKE RED: invalid server PID file; scratch preserved at $R"
+      exit 1
+    fi
+    if kill -0 "$pid" 2>/dev/null; then
+      pipeline_log "SMOKE RED: recorded server $pid survived journey cleanup; scratch preserved at $R"
+      exit 1
+    fi
+  fi
+  rm -rf "$R"
+  exit "$status"
+}
+trap cleanup EXIT

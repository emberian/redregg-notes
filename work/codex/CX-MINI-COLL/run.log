/-- **Satisfiable at every hash:** a world against itself meets the carrier
whenever its own keys do not collide in the index. -/
theorem rootBinding_self (lengths : ∀ k, (ix k).length = L) (w : World R TxId D)
    (hix : IndexInjective ix w) : RootBinding cellRoot sysRoot dig ix L lengths w w where
  openings := fun _ _ => rfl
  index' := hix
  cells := fun _ _ _ ha hb _ => Option.some.inj (ha.symm.trans hb)
  system := fun _ => rfl

/-- The carrier holds when no two node inputs share a digest and neither
world's keys collide in the index. -/
theorem rootBinding_of_noCollision (lengths : ∀ k, (ix k).length = L) {w w' : World R TxId D}
    (nodes : ¬ AuthTrie.Collision dig) (hix : IndexInjective ix w) (hix' : IndexInjective ix w')
    (cells : ∀ c a b, w.cells c = some a → w'.cells c = some b → cellRoot a = cellRoot b → a = b)
    (system : sysRoot w.system = sysRoot w'.system → w.system = w'.system) :
    RootBinding cellRoot sysRoot dig ix L lengths w w' where
  openings := fun k accepted => by
    rcases AuthTrie.verify_sound dig ix L lengths _
        (AuthTrie.Cache.wf_canon lengths (pathsInjective cellRoot sysRoot ix hix)) k _ _ accepted with
      read | collision
    · rwa [AuthTrie.Cache.lookup_canon] at read
    · exact absurd collision nodes
  index' := hix'
  cells := cells
  system := system

/-- **The reduction, with no premise.**  Different worlds with one root exhibit
one of: two distinct node inputs with one digest; two keys of one world at one
index path; two different cells at one id with one cell root; two different
system cells with one system root. -/
theorem rootOf_eq_exhibits_collision (lengths : ∀ k, (ix k).length = L) {w w' : World R TxId D}
    (hr : rootOf cellRoot sysRoot dig ix L w = rootOf cellRoot sysRoot dig ix L w') (hne : w ≠ w') :
    AuthTrie.Collision dig ∨ ¬ IndexInjective ix w ∨ ¬ IndexInjective ix w' ∨
      (∃ c a b, w.cells c = some a ∧ w'.cells c = some b ∧ a ≠ b ∧ cellRoot a = cellRoot b) ∨
      (w.system ≠ w'.system ∧ sysRoot w.system = sysRoot w'.system) := by
  by_contra hno
  simp only [not_or, not_exists, not_and, not_not] at hno
  obtain ⟨hH, hix, hix', hcells, hsys⟩ := hno
  exact hne (rootOf_binds cellRoot sysRoot dig ix L lengths
    (rootBinding_of_noCollision cellRoot sysRoot dig ix L lengths hH hix hix'
      (fun c a b ha hb he => by_contra fun hab => hcells c a b ha hb hab he)
      (fun he => by_contra fun hs => hsys hs he)) hr)

/-- **Checkpoint soundness at the world root (§4.4).**  `Kernel.World.resume_sound`
with the root supplied and its `binds` premise discharged by the carrier. -/
theorem resume_sound_rootOf {Ev : Type} (H : History R TxId Ev D) (lengths : ∀ k, (ix k).length = L)
    (g W_h : World R TxId D) (log : List (Turn R TxId Ev D)) (c : Checkpoint R TxId D Dg)
    (prefixed : fold H g (log.take c.height) = some W_h)
    (honestRoot : c.root = rootOf cellRoot sysRoot dig ix L W_h)
    (carrier : RootBinding cellRoot sysRoot dig ix L lengths c.world W_h)
    (checks : c.check (rootOf cellRoot sysRoot dig ix L) = true) :
    c.resume H (rootOf cellRoot sysRoot dig ix L) (log.drop c.height) = fold H g log :=
  resume_sound H (rootOf cellRoot sysRoot dig ix L) g W_h log c prefixed honestRoot
    (rootOf_binds cellRoot sysRoot dig ix L lengths carrier) checks

end WorldRoot

/-! ## The deployed root -/

section Deployed

open Minidregg.Compiler.Sp800185Cshake256

/-- The registered world-root tag (`PersistedCodecTags.world_root_v2`): it enters the persisted
codec corpus, so the Store epoch's schema component moves with it and a Store of the v1 root
refuses to open naming `schema-refs`. -/
def worldCustomization : List UInt8 := Minidregg.Compiler.PersistedCodecTags.world_root_v2.toUTF8.toList

/-- The deployed hash: cSHAKE256 under the world-root customization. -/
#!/usr/bin/env bash
# scripts/pipeline/with-lean-slot CMD... -- run a Lean build holding one of this box's N Lean slots, in FIFO order.
#
# THE ONE COPY. It replaces the hand-installed $PIPELINE_ROOT/slots/with-lean-slot (hbox, 2026-10-14
# 23:04, FIFO since 10-15 03:05Z) and interoperates with it while both exist: same slot locks
# (SLOTS/lean-K.lock), same queue (SLOTS/waiters/<pid>.pid, ordered by mtime, dead pids pruned).
#
# FIFO: a waiter takes a slot only when its ticket is the OLDEST live ticket, so a 3-hour waiter is
# never passed by a 5-minute one. The ticket is ALWAYS SLOTS/waiters/<own pid>.pid. The installed copy
# used $WITH_LEAN_SLOT_PIDFILE as the ticket itself, so a waiter whose PID file lived elsewhere never
# entered the queue and never got a slot (CONSENT-3 b1, 10-15); that path is now only the PID file to
# stop the waiter by. The lock fd is held by this wrapper only (the build and its children never
# inherit it).
#
# Env (box.env or the caller):
#   PIPELINE_LEAN_SLOT_DIR   SLOTS (default $PIPELINE_ROOT/slots)
#   PIPELINE_LEAN_SLOTS      N (default 3: hbox's count)
#   PIPELINE_LEAN_SLOT_THREADS  LEAN_NUM_THREADS of the build (default 4); exported as THREADS too
#   PIPELINE_LEAN_SLOT_NICE  nice level of the build (default 0; a host that is not ours, e.g. persvati, sets 15)
#   WITH_LEAN_SLOT_PIDFILE   also write this wrapper's PID here (stop the waiter by it)
#   WITH_LEAN_SLOT_PRIORITY=1  queue ahead of every ordinary ticket (the tip service / integrator); a
#                            priority ticket is backdated one day, so among priority tickets FIFO holds
#   PIPELINE_LEAN_SLOT_POLL_S  seconds between polls (default 1: a slot kept for an older waiter idles at most this long)
#   WITH_LEAN_SLOT_DEADLINE_S  give up after this many seconds without a slot (default 14400; exit 75)
# Every grant is measured: SLOTS/waits.tsv gets one line per run
#   pid  enqueued  granted  released  slot  rc  command   (epoch seconds; the CYCLE-TIME F5 instrument)
# Before the build: the shared Lake cache's guard, from THIS tree (lib.sh pipeline_cache_audit).
set -uo pipefail
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PIPELINE_PROG=with-lean-slot
. "$here/lib.sh"
[ $# -ge 1 ] || pipeline_die "usage: with-lean-slot CMD..."
SLOTS=${PIPELINE_LEAN_SLOT_DIR:-$PIPELINE_ROOT/slots}
N=${PIPELINE_LEAN_SLOTS:-3}
case "$N" in [1-9]|[1-9][0-9]) ;; *) pipeline_die "PIPELINE_LEAN_SLOTS must be a positive integer" ;; esac
W=$SLOTS/waiters
mkdir -p "$W" || pipeline_die "cannot create $W"
ticket=$W/$$.pid
echo $$ > "$ticket"
enq=$(date +%s)
if [ "${WITH_LEAN_SLOT_PRIORITY:-0}" = 1 ]; then touch -d "@$(( enq - 86400 ))" "$ticket"; else touch -d "@$enq" "$ticket"; fi
[ -n "${WITH_LEAN_SLOT_PIDFILE:-}" ] && [ "$WITH_LEAN_SLOT_PIDFILE" != "$ticket" ] && echo $$ > "$WITH_LEAN_SLOT_PIDFILE"
trap 'rm -f "$ticket"; [ -n "${WITH_LEAN_SLOT_PIDFILE:-}" ] && rm -f "$WITH_LEAN_SLOT_PIDFILE"' EXIT
deadline=$(( enq + ${WITH_LEAN_SLOT_DEADLINE_S:-14400} ))
cmd="$*"; cmd=${cmd:0:200}
# the live tickets, oldest first (priority tickets are backdated a day); a dead PID's ticket is pruned
live_in_order() {
  local f p
  for f in $(ls -tr "$W"/*.pid 2>/dev/null); do
    p=$(cat "$f" 2>/dev/null)
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then echo "$p"; else rm -f "$f"; fi
  done
}
pipeline_cache_audit || pipeline_die "the shared Lake cache is unguarded (lake-cache-audit failed): not building on it"
told=0
poll=${PIPELINE_LEAN_SLOT_POLL_S:-1}
# One poll, under SLOTS/queue.lock (so two waiters never count the same free slot): count the live tickets AHEAD of
# this one and the slots free right now. This waiter takes a slot iff ahead < free: every older waiter still has a
# free slot left for it, so FIFO and priority hold, and no slot idles while any waiter could use it (the old rule,
# "only the single oldest ticket may try", left a second free slot idle for a whole poll and let a later priority
# ticket pass a waiter that had a slot available: test-with-lean-slot.sh, burst5 10-17).
while :; do
  exec {q}>"$SLOTS/queue.lock"
  if flock -w 30 "$q"; then
    ahead=0 mine=0
    for p in $(live_in_order); do [ "$p" = "$$" ] && { mine=1; break; }; ahead=$((ahead + 1)); done
    [ "$mine" = 1 ] || { echo $$ > "$ticket"; touch -d "@$enq" "$ticket"; }   # a pruned ticket (never ours to lose) re-enters at its own time
    fds=() slots=()
    for s in $(seq 1 "$N"); do
      exec {t}>"$SLOTS/lean-$s.lock"
      if flock -n "$t"; then fds+=("$t"); slots+=("$s"); else exec {t}>&-; fi
    done
    if [ "$mine" = 1 ] && [ "$ahead" -lt "${#fds[@]}" ]; then
      fd=${fds[0]} s=${slots[0]}
      for t in "${fds[@]:1}"; do exec {t}>&-; done
      rm -f "$ticket"; exec {q}>&-
      granted=$(date +%s)
      export LEAN_NUM_THREADS=${PIPELINE_LEAN_SLOT_THREADS:-4}
      export THREADS=$LEAN_NUM_THREADS
      ( exec {fd}>&-; exec nice -n "${PIPELINE_LEAN_SLOT_NICE:-0}" "$@" ); rc=$?
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$$" "$enq" "$granted" "$(date +%s)" "$s" "$rc" "$cmd" >> "$SLOTS/waits.tsv"
      exit "$rc"
    fi
    for t in "${fds[@]}"; do exec {t}>&-; done
  fi
  exec {q}>&-
  if [ "$(date +%s)" -ge "$deadline" ]; then
    printf '%s\t%s\t-\t%s\t-\t75\t%s\n' "$$" "$enq" "$(date +%s)" "$cmd" >> "$SLOTS/waits.tsv"
    pipeline_log "no Lean slot in $(( deadline - enq )) s" >&2
    exit 75
  fi
  if [ "$told" = 0 ]; then told=1; pipeline_log "queued for one of $N Lean slots under $SLOTS (ticket $ticket)" >&2; fi
  sleep "$poll"
done

import Lean
import Theory.CollidesAmong

open Lean Meta Elab Command
namespace Minidregg.Verify.ScopedCollision
set_option autoImplicit false
set_option maxHeartbeats 1000000

/-- Deliberately erase list membership, only for the rejected mutation test. -/
def dropList {A B : Type} {hash : A → B} {xs : List A} :
    Theory.CollidesAmong hash xs → ∃ a b, a ≠ b ∧ hash a = hash b
  | ⟨a, _, b, _, ne, eq⟩ => ⟨a, b, ne, eq⟩

def occurrences : Expr → Nat
  | .const n _ => if n == `Minidregg.Theory.CollidesAmong then 1 else 0
  | .app f a => occurrences f + occurrences a
  | .lam _ t b _ | .forallE _ t b _ => occurrences t + occurrences b
  | .letE _ t v b _ => occurrences t + occurrences v + occurrences b
  | .mdata _ e | .proj _ _ e => occurrences e
  | _ => 0

def check (n : Name) : MetaM Unit := do
  let ci ← getConstInfo n
  let count ← forallTelescope ci.type fun _ result => pure (occurrences result)
  if count == 0 then
    throwError "SCOPED-COLLISION RED {n}: explicit finite input list missing"
  logInfo m!"SCOPED-COLLISION PASS {n}"

/-- The mutation is a proved weakening of the actual theorem, not a fabricated error. -/
def weaken : Nat → Expr → MetaM Expr
  | 0, _ => throwError "scoped-collision: mutation recursion limit"
  | fuel + 1, proof => do
      let t ← inferType proof
      if t.isAppOf `Minidregg.Theory.CollidesAmong then
        return ← mkAppM `Minidregg.Verify.ScopedCollision.dropList #[proof]
      else if t.isAppOfArity `Or 2 then
        let a := t.getArg! 0
        let b := t.getArg! 1
        let fa ← withLocalDeclD `ha a fun ha => do mkLambdaFVars #[ha] (← weaken fuel ha)
        let fb ← withLocalDeclD `hb b fun hb => do mkLambdaFVars #[hb] (← weaken fuel hb)
        return ← mkAppM `Or.imp #[fa, fb, proof]
      else
        return proof

elab "#assert_scoped_collision " n:ident : command => liftTermElabM do
  let name ← resolveGlobalConstNoOverload n
  check name

def plant (name : Name) (checked : Bool) : MetaM Unit := do
  let ci ← getConstInfo name
  let value ← forallTelescope ci.type fun xs _ => do
    let proof := mkAppN (mkConst name (ci.levelParams.map Level.param)) xs
    mkLambdaFVars xs (← weaken 256 proof)
  let type ← inferType value
  let mutant := name ++ `listDroppedMutant
  let count ← forallTelescope type fun _ result => pure (occurrences result)
  if count != 0 then throwError "scoped-collision: mutation did not drop every list at {name}"
  addDecl (.thmDecl { name := mutant, levelParams := ci.levelParams, type, value })
  if checked then check mutant
  else logInfo m!"SCOPED-COLLISION MUTANT DERIVED {mutant}"

elab "#plant_unbounded_collision " n:ident : command => liftTermElabM do
  plant (← resolveGlobalConstNoOverload n) true

elab "#derive_unbounded_collision " n:ident : command => liftTermElabM do
  plant (← resolveGlobalConstNoOverload n) false

def checkPremise (name : Name) : MetaM Unit := do
  let ci ← getConstInfo name
  if occurrences ci.type == 0 then
    throwError "SCOPED-COLLISION RED {name}: explicit finite input list missing"
  logInfo m!"SCOPED-COLLISION PASS {name}"

/-- Mutate the scoped separation premise contravariantly: global separation implies
local separation. The resulting theorem is valid but has an impossible finite-hash premise. -/
def plantPremise (name : Name) (checked : Bool) : MetaM Unit := do
  let ci ← getConstInfo name
  let value ← forallTelescope ci.type fun xs _ => do
    let mut found : Option Nat := none
    for i in [:xs.size] do
      let t ← inferType xs[i]!
      if t.isAppOfArity `Not 1 && (t.getArg! 0).isAppOf `Minidregg.Theory.CollidesAmong then
        found := some i
    let some i := found | throwError "scoped-collision: no separation premise at {name}"
    let scopedType := (← inferType xs[i]!).getArg! 0
    let unbounded ← withLocalDeclD `collision scopedType fun c => do
      inferType (← mkAppM `Minidregg.Verify.ScopedCollision.dropList #[c])
    withLocalDeclD `globalSeparation (mkApp (mkConst `Not) unbounded) fun global => do
      let localProof ← withLocalDeclD `collision scopedType fun c => do
        mkLambdaFVars #[c] (mkApp global (← mkAppM `Minidregg.Verify.ScopedCollision.dropList #[c]))
      let args := xs.set! i localProof
      let binders := xs.set! i global
      mkLambdaFVars binders (mkAppN (mkConst name (ci.levelParams.map Level.param)) args)
  let type ← inferType value
  if occurrences type != 0 then throwError "scoped-collision: premise mutation left a finite list at {name}"
  let mutant := name ++ `listDroppedMutant
  addDecl (.thmDecl { name := mutant, levelParams := ci.levelParams, type, value })
  if checked then checkPremise mutant
  else logInfo m!"SCOPED-COLLISION MUTANT DERIVED {mutant}"

elab "#assert_scoped_collision_premise " n:ident : command => liftTermElabM do
  checkPremise (← resolveGlobalConstNoOverload n)

elab "#plant_unbounded_collision_premise " n:ident : command => liftTermElabM do
  plantPremise (← resolveGlobalConstNoOverload n) true

elab "#derive_unbounded_collision_premise " n:ident : command => liftTermElabM do
  plantPremise (← resolveGlobalConstNoOverload n) false

end Minidregg.Verify.ScopedCollision
import Theory.ObjectiveBendDigest
import Verify.ScopedCollision
namespace Minidregg.Verify.CollisionDigestTeeth
open Minidregg.Theory Minidregg.Theory.HashBytes Minidregg.Theory.ObjectiveBendDigest
set_option maxHeartbeats 1000000

/-- A fixed 32-byte hash; it separates the actual inner/outer model inputs but collides elsewhere. -/
def modelHash (input : List UInt8) : List UInt8 :=
  be 32 (if input = preimage 0 0 then 1 else 2)

theorem model_width (input : List UInt8) : (modelHash input).length = 32 := by
  simp [modelHash]

theorem model_collision_elsewhere :
    CollidesAmong (fun p => ofBE (modelHash p)) [preimage 0 1, preimage 0 2] :=
  CollidesAmong.pair (by decide) (by decide)

theorem binds_or_collides_nonvacuous :
    Admissible 0 ∧ digestWith modelHash 0 0 = digestWith modelHash 0 0 ∧
      ¬ CollidesAmong (fun p => ofBE (modelHash p)) [preimage 0 0, preimage 0 0] := by
  refine ⟨admissible_zero, rfl, ?_⟩
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false, or_self] at ha hb
  exact ne (ha.trans hb.symm)

theorem model_inner : digestWith modelHash 0 0 = 1 := by decide

/-- The sealed theorem's four-input construction at an inhabited, fixed-width hash.
This does not assert that modelHash is the deployed cSHAKE function. -/
theorem sealed_binds_or_collides_nonvacuous :
    ¬ CollidesAmong (fun p => ofBE (modelHash p))
      ([preimage 0 0, preimage 0 0] ++
        [preimage (digestWith modelHash 0 0) 0, preimage (digestWith modelHash 0 0) 0]) := by
  rw [model_inner]
  rintro ⟨a, ha, b, hb, ne, eq⟩
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, or_self] at ha hb
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
  · exact ne rfl
  · revert eq; decide
  · revert eq; decide
  · exact ne rfl

#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.binds_or_collides
#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.sealed_binds_or_collides
#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.lengthHash_collides
#assert_scoped_collision Minidregg.Theory.ObjectiveBendDigest.hiding_at_equality_is_a_collision
end Minidregg.Verify.CollisionDigestTeeth
import Verify.CollisionWorldTeeth
import Verify.ScopedCollision
namespace Minidregg.Verify.CollisionPremiseTeeth
open Theory CollisionWorldTeeth
set_option maxHeartbeats 1000000

/-- Local separation is inhabited at the finite hash while global separation is false. -/
theorem separation_premise_nonvacuous :
    ¬ CollidesAmong nodeHash
      (Kernel.WorldRoot.comparisonInputs cellHash systemHash nodeHash bits 0 lengths
        Kernel.World.Example.g Kernel.World.Example.g) ∧
    ∃ a b, a ≠ b ∧ nodeHash a = nodeHash b :=
  ⟨world_nonvacuous, ScopedCollision.dropList collision_elsewhere⟩

theorem scoped_carrier :
    Kernel.WorldRoot.RootBinding cellHash systemHash nodeHash bits 0 lengths
      Kernel.World.Example.g Kernel.World.Example.g := by
  have index : Kernel.WorldRoot.IndexInjective bits Kernel.World.Example.g := by
    change ∀ k ∈ [Kernel.WorldRoot.Key.system], ∀ k' ∈ [Kernel.WorldRoot.Key.system],
      bits k = bits k' → k = k'
    intro k hk k' hk' _
    simp only [List.mem_singleton] at hk hk'
    exact hk.trans hk'.symm
  exact Kernel.WorldRoot.rootBinding_of_noCollision cellHash systemHash nodeHash bits 0 lengths
    world_nonvacuous index index
    (fun _ _ _ ha hb _ => Option.some.inj (ha.symm.trans hb)) (fun _ => rfl)

#assert_scoped_collision_premise Kernel.WorldRoot.rootBinding_of_noCollision
end Minidregg.Verify.CollisionPremiseTeeth
import Compiler.DurableIndex
import Compiler.DurableHistory
import Compiler.ReceiptContinuityIO
import Verify.ScopedCollision
import Verify.CollisionTreeTeeth
import Verify.CollisionWorldTeeth

namespace Minidregg.Verify.CollisionConsumerTeeth
open Theory
set_option autoImplicit false
set_option maxHeartbeats 1000000

/-- Empty canonical index: an honest absence read has only the empty input,
even at the deployed digest shape and hash. -/
theorem index_nonvacuous (k : Compiler.DurableIndex.IndexKey) :
    ¬ CollidesAmong (Compiler.Sp800185Cshake256.hash Compiler.DurableIndex.nodeCustomization)
      ((AuthTrie.readInputs Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf 520 []
        k ⟨[], .empty⟩).map Compiler.DurableIndex.nodeBytes) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [AuthTrie.readInputs, AuthTrie.climbInputs, AuthTrie.Terminal.input,
    AuthTrie.treeInputs, AuthTrie.entries] at ha hb
  exact ne (ha.trans hb.symm)

/-- A nonempty deployed index also has an accepted opening with a false collision escape. -/
theorem index_present_nonvacuous (k : Compiler.DurableIndex.IndexKey) (value : List UInt8) :
    AuthTrie.verify Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf
      (Compiler.DurableIndex.rootOf [(k, value)]) k (some value) ⟨[], .leaf k value⟩ = true ∧
    ¬ CollidesAmong (Compiler.Sp800185Cshake256.hash Compiler.DurableIndex.nodeCustomization)
      ((AuthTrie.readInputs Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf 520 [(k, value)]
        k ⟨[], .leaf k value⟩).map Compiler.DurableIndex.nodeBytes) := by
  constructor
  · simp [AuthTrie.verify, AuthTrie.climb, AuthTrie.Terminal.input,
      Compiler.DurableIndex.rootOf, AuthTrie.entries, AuthTrie.tree]
  · rintro ⟨a, ha, b, hb, ne, _⟩
    simp [AuthTrie.readInputs, AuthTrie.climbInputs, AuthTrie.Terminal.input,
      AuthTrie.treeInputs, AuthTrie.entries] at ha hb
    exact ne (ha.trans hb.symm)

/-- The deployed index-path collision escape is false on a real one-slot list. -/
theorem deployed_paths_nonvacuous :
    ¬ CollidesAmong Kernel.WorldRoot.deployedHash
      (Kernel.WorldRoot.keyInputs [(.system, ⟨0⟩)]) := CollidesAmong.not_singleton _ _

/-- The full range of an empty index compares only repeated empty nodes. -/
theorem index_range_nonvacuous :
    ¬ CollidesAmong (Compiler.Sp800185Cshake256.hash Compiler.DurableIndex.nodeCustomization)
      ((AuthTrie.revealInputs Compiler.DurableIndex.dig Compiler.DurableIndex.bitsOf 520 []
        [] ⟨[], []⟩).map Compiler.DurableIndex.nodeBytes) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [AuthTrie.revealInputs, AuthTrie.climbInputs, AuthTrie.treeInputs,
    AuthTrie.entries, AuthTrie.Reveal.entriesBelow, AuthTrie.select] at ha hb
  exact ne (ha.trans hb.symm)

/-- Empty world entry lists make the deployed root's collision disjunct false. -/
theorem deployed_root_nonvacuous (k : Kernel.WorldRoot.Key) :
    ¬ CollidesAmong Kernel.WorldRoot.deployedHash
      ((Kernel.WorldRoot.keyInputs [] ++ Kernel.WorldRoot.keyInputs []) ++
        (AuthTrie.readInputs Kernel.WorldRoot.worldDig Kernel.WorldRoot.deployedIx 256
          (AuthTrie.canon []) k
          ((AuthTrie.Cache.build (dig := Kernel.WorldRoot.worldDig)
            Kernel.WorldRoot.deployedIx_length []).opening k)).map Kernel.WorldRoot.nodeBytes) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  have inputs : AuthTrie.readInputs Kernel.WorldRoot.worldDig Kernel.WorldRoot.deployedIx 256
      (AuthTrie.canon []) k
      ((AuthTrie.Cache.build (dig := Kernel.WorldRoot.worldDig)
        Kernel.WorldRoot.deployedIx_length []).opening k) = [.empty, .empty] := by
    rfl
  simp [inputs, Kernel.WorldRoot.keyInputs] at ha hb
  exact ne (ha.trans hb.symm)

/-- A one-leaf deployed history read compares no internal-node inputs. -/
theorem history_nonvacuous (record : List UInt8)
    (chain root : Theory.TypedAuthorization.Digest) :
    let claimed := Compiler.DurableHistory.leafDigest 1 record chain root
    LogAccumulator.verify Compiler.DurableHistory.nodeDigest [(0, claimed)] 1 1 claimed
      (Compiler.DurableHistory.lookupNode []) = true ∧
    ¬ CollidesAmong (fun p : Theory.TypedAuthorization.Digest ×
        Theory.TypedAuthorization.Digest => Compiler.DurableHistory.nodeDigest p.1 p.2)
      (LogAccumulator.readInputs Compiler.DurableHistory.nodeDigest (fun _ => claimed)
        1 1 [(0, claimed)] claimed (Compiler.DurableHistory.lookupNode [])) := by
  dsimp only
  simp [LogAccumulator.verify, LogAccumulator.locate, LogAccumulator.rootOfPath,
    LogAccumulator.readInputs, LogAccumulator.pathInputs, CollidesAmong]

#assert_scoped_collision Theory.AuthTrie.Cache.root_lastVal_eq
#assert_scoped_collision Compiler.DurableIndex.collision_is_cshake
#assert_scoped_collision Compiler.DurableIndex.lookup_sound
#assert_scoped_collision Compiler.DurableIndex.reveal_sound
#assert_scoped_collision Compiler.DurableIndex.Answer.sound
#assert_scoped_collision Compiler.DurableHistory.verifyAt_sound
#assert_scoped_collision Kernel.WorldRoot.rootOf_eq_exhibits_collision
#assert_scoped_collision Kernel.WorldRoot.worldDig_collision
#assert_scoped_collision Kernel.WorldRoot.deployed_paths
#assert_scoped_collision Kernel.WorldRoot.deployedRoot_binds
#assert_scoped_collision Kernel.ReceiptContinuity.opens_sound
#assert_scoped_collision Compiler.ReceiptContinuityIO.systemSiblings_open
end Minidregg.Verify.CollisionConsumerTeeth


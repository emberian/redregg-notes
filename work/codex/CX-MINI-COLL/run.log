namespace Minidregg.Verify.CollisionTreeTeeth
open Theory
set_option autoImplicit false
set_option maxHeartbeats 1000000

/-- Exactly 256 bits of range; no infinite injective hash assumption. -/
abbrev Digest := Fin (2 ^ 256)
def hash : AuthTrie.NodeIn Unit Unit Digest → Digest
  | .empty => 0
  | .leaf .. => 1
  | .branch .. => 2
def bits (_ : Unit) : List Bool := []
def rows : List (Unit × Unit) := [((), ())]
def opening : AuthTrie.Opening Unit Unit Digest := ⟨[], .leaf () ()⟩

theorem collision_elsewhere :
    CollidesAmong hash [.branch 0 0, .branch 1 0] :=
  CollidesAmong.pair (by decide) rfl

/-- The actual read input builder has no collision at an accepted finite-digest instance. -/
theorem read_nonvacuous :
    AuthTrie.verify hash bits (AuthTrie.tree hash 0 (AuthTrie.entries bits rows))
      () (some ()) opening = true ∧
    ¬ CollidesAmong hash (AuthTrie.readInputs hash bits 0 rows () opening) := by
  constructor
  · decide
  · rintro ⟨a, ha, b, hb, ne, _⟩
    simp [AuthTrie.readInputs, AuthTrie.climbInputs, opening, bits, rows,
      AuthTrie.entries, AuthTrie.treeInputs, AuthTrie.Terminal.input] at ha hb
    exact ne (ha.trans hb.symm)

theorem tree_nonvacuous :
    ¬ CollidesAmong hash (AuthTrie.treeInputs hash 0 (AuthTrie.entries bits rows) ++
      AuthTrie.treeInputs hash 0 (AuthTrie.entries bits rows)) := by
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [AuthTrie.treeInputs, AuthTrie.entries, bits, rows] at ha hb
  exact ne (ha.trans hb.symm)

/-- The actual full-range verifier accepts the singleton at the same finite hash. -/
theorem range_nonvacuous :
    AuthTrie.revealVerify hash bits 0 (AuthTrie.tree hash 0 (AuthTrie.entries bits rows))
      [] ⟨[], rows⟩ = true ∧
    ¬ CollidesAmong hash (AuthTrie.revealInputs hash bits 0 rows [] ⟨[], rows⟩) := by
  constructor
  · decide
  · rintro ⟨a, ha, b, hb, ne, _⟩
    simp [AuthTrie.revealInputs, AuthTrie.climbInputs, rows, bits, AuthTrie.entries,
      AuthTrie.treeInputs, AuthTrie.Reveal.entriesBelow, AuthTrie.select] at ha hb
    exact ne (ha.trans hb.symm)

def node (_ _ : Digest) : Digest := 0
def leaf (_ : Nat) : Digest := 0
def nodes (_ _ : Nat) : Option Digest := some 0

theorem log_collision_elsewhere : CollidesAmong (fun p : Digest × Digest => node p.1 p.2)
    [(0, 0), (1, 0)] := CollidesAmong.pair (by decide) rfl

theorem log_nonvacuous :
    LogAccumulator.Honest node leaf 2 [(1, 0)] ∧
    LogAccumulator.verify node [(1, 0)] 2 1 0 nodes = true ∧
    ¬ CollidesAmong (fun p : Digest × Digest => node p.1 p.2)
      (LogAccumulator.readInputs node leaf 2 1 [(1, 0)] 0 nodes) := by
  refine ⟨by simp [LogAccumulator.Honest, LogAccumulator.block, node, leaf], by decide, ?_⟩
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp [LogAccumulator.readInputs, LogAccumulator.locate, LogAccumulator.pathInputs,
    LogAccumulator.block, LogAccumulator.rootOfPath, node, leaf, nodes] at ha hb
  exact ne (ha.trans hb.symm)

#assert_scoped_collision Theory.AuthTrie.tree_dig_terminal
#assert_scoped_collision Theory.AuthTrie.climb_sound
#assert_scoped_collision Theory.AuthTrie.verify_sound
#assert_scoped_collision Theory.AuthTrie.tree_injective
#assert_scoped_collision Theory.AuthTrie.climb_digest_sound
#assert_scoped_collision Theory.AuthTrie.reveal_sound
#assert_scoped_collision Theory.LogAccumulator.rootOfPath_sound
#assert_scoped_collision Theory.LogAccumulator.verify_sound
end Minidregg.Verify.CollisionTreeTeeth

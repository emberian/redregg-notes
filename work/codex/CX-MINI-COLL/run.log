theorem worldDig_eq : ∀ n : Node, worldDig n = deployedHash (nodeBytes n)
  | .empty => rfl
  | .leaf .. => rfl
  | .branch .. => rfl

/-- A node collision is a collision of the deployed hash on two distinct inputs. -/
theorem worldDig_collision (h : AuthTrie.Collision worldDig) :
    ∃ x y, x ≠ y ∧ deployedHash x = deployedHash y := by
  obtain ⟨a, b, hne, heq⟩ := h
  exact ⟨nodeBytes a, nodeBytes b, fun e => hne (nodeBytes_injective e), by
    rwa [worldDig_eq, worldDig_eq] at heq⟩

/-- A3's Q2 index: the 256 bits of the hash of the tagged key bytes. -/
def deployedIx (k : Key) : List Bool := bytesBits (cshake256Bytes worldCustomization (3 :: keyBytes k))

theorem deployedIx_length (k : Key) : (deployedIx k).length = 256 := by
  simp [deployedIx, bytesBits_length]

/-- An index collision of two distinct keys is a collision of the deployed hash
on two distinct inputs. -/
theorem deployedIx_collision {k k' : Key} (hne : k ≠ k') (h : deployedIx k = deployedIx k') :
    (3 :: keyBytes k) ≠ (3 :: keyBytes k') ∧
      deployedHash (3 :: keyBytes k) = deployedHash (3 :: keyBytes k') := by
  refine ⟨fun e => hne (keyBytes_prefixFree.injective (List.cons.inj e).2), ?_⟩
  have hb := bytesBits_injective h
  show digestOfBytesLE (cshake256Bytes worldCustomization (3 :: keyBytes k)) =
    digestOfBytesLE (cshake256Bytes worldCustomization (3 :: keyBytes k'))
  rw [hb]

/-- **The deployed root** of an entry list of slot roots: the compressed trie
over each key's last value. -/
def deployedRoot (es : List (Key × Digest)) : Digest := AuthTrie.root worldDig deployedIx 256 es

/-- The deployed root depends only on each key's last value. -/
theorem deployedRoot_congr {es es' : List (Key × Digest)}
    (same : ∀ k, AuthTrie.lastVal es k = AuthTrie.lastVal es' k) : deployedRoot es = deployedRoot es' :=
  AuthTrie.root_congr worldDig deployedIx 256 same

/-- Distinct keys of any list have distinct paths, up to a deployed-hash collision. -/
theorem deployed_paths (es : List (Key × Digest)) :
    AuthTrie.Cache.PathsInjective deployedIx es ∨ ∃ x y, x ≠ y ∧ deployedHash x = deployedHash y := by
  by_cases h : AuthTrie.Cache.PathsInjective deployedIx es
  · exact Or.inl h
  · right
    simp only [AuthTrie.Cache.PathsInjective, not_forall] at h
    obtain ⟨k, k', _, _, same, hne⟩ := h
    exact ⟨_, _, deployedIx_collision hne same⟩

/-- **Binding of the deployed root, premise-free.**  Two lists with one deployed
root give every key the same last value, or the deployed hash collides. -/
theorem deployedRoot_binds {es es' : List (Key × Digest)} (hr : deployedRoot es = deployedRoot es')
    (k : Key) :
    AuthTrie.lastVal es' k = AuthTrie.lastVal es k ∨ ∃ x y, x ≠ y ∧ deployedHash x = deployedHash y := by
  rcases deployed_paths es with inj | c
  · rcases deployed_paths es' with inj' | c
    · rcases AuthTrie.Cache.root_lastVal_eq deployedIx_length inj inj' hr k with same | c
      · exact Or.inl same
      · exact Or.inr (worldDig_collision c)
    · exact Or.inr c
  · exact Or.inr c

end Deployed

/-! ## The turn digest and the log chain -/

section History

open Minidregg.Compiler.Sp800185Cshake256

def turnCustomization : List UInt8 := "DREGG.TURN/v1".toUTF8.toList
def logCustomization : List UInt8 := "DREGG.LOG/v1".toUTF8.toList

/-- The digest of a turn's canonical bytes. -/
def turnDigestOfBytes (bytes : List UInt8) : Digest := (hash turnCustomization bytes).digest
  startChain : Digest
  endChain : Digest
  fromSiblings : List Digest
  toSiblings : List Digest
  suffix : List Digest
  complete : Bool
  deriving DecidableEq, Repr

def Query.start (query : Query) : Point := query.anchor.getD query.target

def chainAfterDigests (start : Digest) (suffix : List Digest) : Digest :=
  suffix.foldl chainDigest start

/-- The public digest suffix is the same chain operation as durable replay. -/
theorem chainAfterDigests_records (start : Digest)
    (records : List DurableReceiver.IntentRecord) :
    chainAfterDigests start (records.map DurableCheckpointCodec.recordDigest) =
      DurableCheckpointCodec.chainAfter start records := by
  simp only [chainAfterDigests, DurableCheckpointCodec.chainAfter, List.foldl_map]
  rfl

/-- Membership (not absence) of the committed `(height, chain)` system slot:
the walk ends at the system slot's own leaf. An opening carries at most one
sibling per index bit (256; the compressed trie usually needs about log₂ of
the number of slots). -/
def opens (point : Point) (chain : Digest) (siblings : List Digest) : Bool :=
  Theory.AuthTrie.verify worldDig deployedIx point.worldRoot .system
    (some (DurableCheckpointCodec.systemLeaf point.height chain))
    ⟨siblings, .leaf .system (DurableCheckpointCodec.systemLeaf point.height chain)⟩

/-- **An accepted opening is the actual system slot** of the world named by the
receipt — the last value the world's slot list gives the system key — or the
deployed hash collides. Increasing heights are not a substitute for it. -/
theorem opens_sound (point : Point) (chain : Digest) (siblings : List Digest)
    (es : List (Key × Digest)) (root : point.worldRoot = deployedRoot es)
    (checked : opens point chain siblings = true) :
    some (DurableCheckpointCodec.systemLeaf point.height chain) = Theory.AuthTrie.lastVal es .system ∨
      ∃ x y, x ≠ y ∧ deployedHash x = deployedHash y := by
  rcases deployed_paths es with inj | collision
  · have accepted : Theory.AuthTrie.verify worldDig deployedIx
        (deployedRoot es)
        .system (some (DurableCheckpointCodec.systemLeaf point.height chain))
        ⟨siblings, .leaf .system (DurableCheckpointCodec.systemLeaf point.height chain)⟩ = true := by
      rw [← root]; exact checked
    rcases Theory.AuthTrie.verify_sound worldDig deployedIx 256 deployedIx_length _
        (Theory.AuthTrie.Cache.wf_canon deployedIx_length inj) _ _ _ accepted with read | nodes
    · exact Or.inl (by rwa [Theory.AuthTrie.Cache.lookup_canon] at read)
    · exact Or.inr (worldDig_collision nodes)
  · exact Or.inr collision

/-- All client-verifiable continuity conditions. New roots cannot be accepted
merely because their heights increase, and a same-height fork is never an advance.
Historical queries orient their proof from the older receipt to the retained head. -/
def Valid (query : Query) (extension : Extension) : Prop :=
  extension.identity = query.identity ∧
  extension.startPoint = query.start ∧
  query.start.height ≤ query.target.height ∧
  extension.endPoint.height = min (query.start.height + maxSuffix) query.target.height ∧
  extension.suffix.length = extension.endPoint.height - extension.startPoint.height ∧
  extension.suffix.length ≤ maxSuffix ∧
  (extension.complete = decide (extension.endPoint.height = query.target.height)) ∧
  (extension.endPoint.height = query.target.height → extension.endPoint.worldRoot = query.target.worldRoot) ∧
  (extension.startPoint.height = extension.endPoint.height → extension.startPoint = extension.endPoint) ∧
  chainAfterDigests extension.startChain extension.suffix = extension.endChain ∧
  opens extension.startPoint extension.startChain extension.fromSiblings = true ∧
  opens extension.endPoint extension.endChain extension.toSiblings = true

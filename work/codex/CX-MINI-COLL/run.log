  new="⟨"+fields[0]+","+mem+","+fields[1]+","+mem+","+fields[2]+","+fields[3]+"⟩"
  changes.append((a,i+1,new))
 for a,b,new in reversed(changes): part=part[:a]+new+part[b:]
 return part

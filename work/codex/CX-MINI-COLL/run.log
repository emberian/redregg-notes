/- Explicit finite inputs for binding reductions. Init only. -/
namespace Minidregg.Theory

set_option autoImplicit false
set_option maxHeartbeats 1000000

/-- A collision among the inputs compared by this particular operation. -/
def CollidesAmong {A B : Type} (hash : A → B) (inputs : List A) : Prop :=
  ∃ a ∈ inputs, ∃ b ∈ inputs, a ≠ b ∧ hash a = hash b

namespace CollidesAmong
variable {A B : Type} {hash : A → B} {xs ys : List A}

theorem pair {a b : A} (hne : a ≠ b) (heq : hash a = hash b) :
    CollidesAmong hash [a, b] :=
  ⟨a, (List.mem_cons_self ..), b, List.mem_cons_of_mem _ (List.mem_cons_self ..), hne, heq⟩

theorem mono (h : CollidesAmong hash xs) (sub : ∀ x ∈ xs, x ∈ ys) :
    CollidesAmong hash ys := by
  obtain ⟨a, ha, b, hb, ne, eq⟩ := h
  exact ⟨a, sub a ha, b, sub b hb, ne, eq⟩

theorem append_left (h : CollidesAmong hash xs) (ys : List A) :
    CollidesAmong hash (xs ++ ys) :=
  h.mono (fun _ hx => List.mem_append_left _ hx)

theorem append_right (xs : List A) (h : CollidesAmong hash ys) :
    CollidesAmong hash (xs ++ ys) :=
  h.mono (fun _ hx => List.mem_append_right _ hx)

theorem not_singleton (hash : A → B) (a : A) : ¬ CollidesAmong hash [a] := by
  rintro ⟨x, hx, y, hy, ne, _⟩
  simp only [List.mem_singleton] at hx hy
  exact ne (hx.trans hy.symm)

theorem eliminate {P : Prop} (h : P ∨ CollidesAmong hash xs)
    (separates : ¬ CollidesAmong hash xs) : P :=
  h.resolve_right separates

end CollidesAmong
end Minidregg.Theory

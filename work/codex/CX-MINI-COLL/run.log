import Kernel.WorldRoot
import Verify.CollisionTreeTeeth

namespace Minidregg.Verify.CollisionWorldTeeth
open Theory Kernel.WorldRoot Kernel.World Kernel.World.Example
set_option autoImplicit false
set_option maxHeartbeats 1000000
abbrev Digest := CollisionTreeTeeth.Digest
def nodeHash (_ : AuthTrie.NodeIn Key Unit Digest) : Digest := 0
def cellHash (_ : Cell toyR) : Unit := ()
def systemHash (_ : Store.Store (sysLayout Nat Nat)) : Unit := ()
def bits (_ : Key) : List Bool := []
theorem lengths (k : Key) : (bits k).length = 0 := rfl

/-- Even a constant finite hash has no collision on the actual one-slot comparison.
The unrelated global collision exists, but cannot satisfy this node escape. -/
theorem world_nonvacuous :
    ¬ CollidesAmong nodeHash (comparisonInputs cellHash systemHash nodeHash bits 0 lengths g g) := by
  have trace : comparisonInputs cellHash systemHash nodeHash bits 0 lengths g g =
      [.leaf .system (), .leaf .system (), .leaf .system (), .leaf .system ()] := by rfl
  rw [trace]
  rintro ⟨a, ha, b, hb, ne, _⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false, or_self] at ha hb
  exact ne (ha.trans hb.symm)

def other : ToyWorld := genesis { toyH with logRoot0 := 2 } 0

/-- The reduction's equal-root and unequal-world premises are inhabited, while its
node-collision escape is false. Here the system-root collision is the real explanation. -/
theorem world_reduction_nonvacuous :
    rootOf cellHash systemHash nodeHash bits 0 g = rootOf cellHash systemHash nodeHash bits 0 other ∧
    g ≠ other ∧
    ¬ CollidesAmong nodeHash (comparisonInputs cellHash systemHash nodeHash bits 0 lengths g other) := by
  refine ⟨rfl, ?_, ?_⟩
  · intro same
    have heads := congrArg (fun w : ToyWorld => w.head) same
    change (some ((0 : Nat), (1 : Nat)) : Option (Nat × Nat)) = some (0, 2) at heads
    cases heads
  · have trace : comparisonInputs cellHash systemHash nodeHash bits 0 lengths g other =
        [.leaf .system (), .leaf .system (), .leaf .system (), .leaf .system ()] := by rfl
    rw [trace]
    rintro ⟨a, ha, b, hb, ne, _⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false, or_self] at ha hb
    exact ne (ha.trans hb.symm)

theorem collision_elsewhere : CollidesAmong nodeHash [.empty, .branch 0 0] :=
  CollidesAmong.pair (by decide) rfl

/-- A finite-width model at the deployed byte framing. It separates the tagged
key from its leaf, while deliberately colliding on other byte strings. -/
def byteDigest (input : List UInt8) : TypedAuthorization.Digest :=
  ⟨if input = 3 :: keyBytes .system then 0 else 1⟩
def receiptNode (n : Node) : TypedAuthorization.Digest := byteDigest (nodeBytes n)
def receiptRows : List (Key × TypedAuthorization.Digest) := [(.system, ⟨0⟩)]

theorem byteDigest_width (input : List UInt8) : (byteDigest input).value < 256 ^ 32 := by
  simp only [byteDigest]
  split <;> decide

theorem receipt_model_nonvacuous :
    AuthTrie.verify receiptNode bits (AuthTrie.tree receiptNode 0 (AuthTrie.entries bits receiptRows))
      .system (some ⟨0⟩) ⟨[], .leaf .system ⟨0⟩⟩ = true ∧
    ¬ CollidesAmong byteDigest
      (keyInputs receiptRows ++
        (AuthTrie.readInputs receiptNode bits 0 receiptRows .system
          ⟨[], .leaf .system ⟨0⟩⟩).map nodeBytes) := by
  constructor
  · decide
  · rintro ⟨a, ha, b, hb, ne, eq⟩
    simp [receiptRows, keyInputs, AuthTrie.readInputs, AuthTrie.climbInputs,
      AuthTrie.Terminal.input, AuthTrie.treeInputs, AuthTrie.entries, bits] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · exact ne rfl
    · simp [byteDigest, nodeBytes, keyBytes] at eq
    · simp [byteDigest, nodeBytes, keyBytes] at eq
    · exact ne rfl

theorem receipt_model_collision_elsewhere : CollidesAmong byteDigest [[9], [10]] :=
  CollidesAmong.pair (by decide) (by decide)

end Minidregg.Verify.CollisionWorldTeeth

mk=$GL/src/scripts/pipeline/mk-lane.sh
[ -f "$mk" ] && grep -q 'MK_LANE_PROBE' "$mk" || { echo "advance: REFUSED, $mk is missing or predates MK_LANE_PROBE (the probe would be refused and the base left NOT-READY)"; exit 9; }

    ¬ CollidesAmong nodeHash
      (Kernel.WorldRoot.comparisonInputs cellHash systemHash nodeHash bits 0 lengths
        Kernel.World.Example.g Kernel.World.Example.g) ∧
    ∃ a b, a ≠ b ∧ nodeHash a = nodeHash b :=
  ⟨world_nonvacuous, ScopedCollision.dropList collision_elsewhere⟩

theorem scoped_carrier :
    Kernel.WorldRoot.RootBinding cellHash systemHash nodeHash bits 0 lengths
      Kernel.World.Example.g Kernel.World.Example.g := by
  have index : Kernel.WorldRoot.IndexInjective bits Kernel.World.Example.g := by
    change ∀ k ∈ [Kernel.WorldRoot.Key.system], ∀ k' ∈ [Kernel.WorldRoot.Key.system],
      bits k = bits k' → k = k'
    intro k hk k' hk' _
    simp only [List.mem_singleton] at hk hk'
    exact hk.trans hk'.symm
  exact Kernel.WorldRoot.rootBinding_of_noCollision cellHash systemHash nodeHash bits 0 lengths
    world_nonvacuous index index
    (fun _ _ _ ha hb _ => Option.some.inj (ha.symm.trans hb)) (fun _ => rfl)

#assert_scoped_collision_premise Kernel.WorldRoot.rootBinding_of_noCollision
end Minidregg.Verify.CollisionPremiseTeeth

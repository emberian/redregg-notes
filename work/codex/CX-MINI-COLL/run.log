KINDS = ("added", "removed", "restated", "redefined", "axioms")
HEX64 = re.compile(r"^[0-9a-f]{64}$")


def H(*parts):
    h = hashlib.sha256()
    for p in parts:
        if isinstance(p, str):
            p = p.encode()
        h.update(len(p).to_bytes(4, "big"))
        h.update(p)
    return h.digest()



open Theory.HashBytes (ofBE)
open Compiler.Sp800185Cshake256 (cshake256Bytes)
open Theory.Channel (fillCell)
set_option autoImplicit false
set_option maxHeartbeats 1000000

theorem repeated {A B : Type} (hash : A → B) (a : A) : ¬ CollidesAmong hash [a,a] := by
  rintro ⟨x, hx, y, hy, ne, _⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false, or_self] at hx hy
  exact ne (hx.trans hy.symm)

def vector := sched.assemble prf 1 3 (rx 3)

theorem opened : Opens (sealEpoch sched prf 1 e1 rx zero32) 3 vector :=
  sealEpoch_root sched prf 1 e1 rx zero32 (by decide)

theorem shaped : Shaped sched 1 3 vector := assemble_shaped sched prf 1 3 (rx 3)

/-- All three collision escapes of omission are false on the honest concrete vector.
The tick hash is the deployed cSHAKE, not an infinite injective stand-in. -/
theorem omission_nonvacuous :
    mine ∉ vector ∧
    ¬ CollidesAmong (fun x => ofBE (cshake256Bytes absentTag x))
      [(epochOpening sched prf e1 rx zero32).encode, (epochOpening sched prf e1 rx zero32).encode] ∧
    ¬ CollidesAmong (fun x => ofBE (cshake256Bytes tickTag x))
      (tickInputs vector vector) ∧
    ¬ CollidesAmong (fun x => ofBE (cshake256Bytes cellTag x))
      (if mine ∈ vector then [mine.encode,
        (fillCell sched.profile prf (sched.headerAt 1 3 0)).encode] else []) := by
  have absent : mine ∉ vector := by decide +kernel
  refine ⟨absent, repeated _ _, repeated _ _, ?_⟩
  simp [absent, CollidesAmong]

def oneCell := fillCell sched.profile prf (sched.headerAt 1 3 0)
def oneRecord : EpochRecord := { record 1 1 with tickRoots := [vectorRoot [oneCell]] }
def oneVector (_ : Nat) := [oneCell]

theorem agreement_nonvacuous :
    (∀ t < oneRecord.tickRoots.length, Opens oneRecord t (oneVector t)) ∧
    ¬ CollidesAmong (fun x => ofBE (cshake256Bytes tickTag x))
      (epochTickInputs oneRecord oneVector oneVector) ∧
    ¬ CollidesAmong (fun x => ofBE (cshake256Bytes cellTag x))
      (epochCellInputs oneRecord oneVector oneVector) := by
  refine ⟨?_, ?_, ?_⟩
  · intro t ht
    have : t = 0 := by simpa [oneRecord] using ht
    subst t
    rfl
  · exact repeated _ _
  · exact repeated _ _

#assert_scoped_collision Kernel.DomainEpoch.collision_of
#assert_scoped_collision Kernel.DomainEpoch.opening_binds_with
#assert_scoped_collision Kernel.DomainEpoch.opening_binds
#assert_scoped_collision Kernel.DomainEpoch.cell_binds
#assert_scoped_collision Kernel.DomainEpoch.tick_binds

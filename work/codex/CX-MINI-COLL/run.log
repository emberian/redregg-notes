import Lean
import Theory.CollidesAmong

open Lean Meta Elab Command
namespace Minidregg.Verify.ScopedCollision
set_option autoImplicit false
set_option maxHeartbeats 1000000

/-- Deliberately erase list membership, only for the rejected mutation test. -/
def dropList {A B : Type} {hash : A → B} {xs : List A} :
    Theory.CollidesAmong hash xs → ∃ a b, a ≠ b ∧ hash a = hash b
  | ⟨a, _, b, _, ne, eq⟩ => ⟨a, b, ne, eq⟩

def occurrences : Expr → Nat
  | .const n _ => if n == `Minidregg.Theory.CollidesAmong then 1 else 0
  | .app f a => occurrences f + occurrences a
  | .lam _ t b _ | .forallE _ t b _ => occurrences t + occurrences b
  | .letE _ t v b _ => occurrences t + occurrences v + occurrences b
  | .mdata _ e | .proj _ _ e => occurrences e
  | _ => 0

def check (n : Name) : MetaM Unit := do
  let ci ← getConstInfo n
  let count ← forallTelescope ci.type fun _ result => pure (occurrences result)
  if count == 0 then
    throwError "SCOPED-COLLISION RED {n}: explicit finite input list missing"
  logInfo m!"SCOPED-COLLISION PASS {n}"

/-- The mutation is a proved weakening of the actual theorem, not a fabricated error. -/
def weaken : Nat → Expr → MetaM Expr
  | 0, _ => throwError "scoped-collision: mutation recursion limit"
  | fuel + 1, proof => do
      let t ← inferType proof
      if t.isAppOf `Minidregg.Theory.CollidesAmong then
        return ← mkAppM `Minidregg.Verify.ScopedCollision.dropList #[proof]
      else if t.isAppOfArity `Or 2 then
        let a := t.getArg! 0
        let b := t.getArg! 1
        let fa ← withLocalDeclD `ha a fun ha => do mkLambdaFVars #[ha] (← weaken fuel ha)
        let fb ← withLocalDeclD `hb b fun hb => do mkLambdaFVars #[hb] (← weaken fuel hb)
        return ← mkAppM `Or.imp #[fa, fb, proof]
      else
        return proof

elab "#assert_scoped_collision " n:ident : command => liftTermElabM do
  let name ← resolveGlobalConstNoOverload n
  check name

def plant (name : Name) (checked : Bool) : MetaM Unit := do
  let ci ← getConstInfo name
  let value ← forallTelescope ci.type fun xs _ => do
    let proof := mkAppN (mkConst name (ci.levelParams.map Level.param)) xs
    mkLambdaFVars xs (← weaken 256 proof)
  let type ← inferType value
  let mutant := name ++ `listDroppedMutant
  let count ← forallTelescope type fun _ result => pure (occurrences result)
  if count != 0 then throwError "scoped-collision: mutation did not drop every list at {name}"
  addDecl (.thmDecl { name := mutant, levelParams := ci.levelParams, type, value })
  if checked then check mutant
  else logInfo m!"SCOPED-COLLISION MUTANT DERIVED {mutant}"

elab "#plant_unbounded_collision " n:ident : command => liftTermElabM do
  plant (← resolveGlobalConstNoOverload n) true

elab "#derive_unbounded_collision " n:ident : command => liftTermElabM do
  plant (← resolveGlobalConstNoOverload n) false

def checkPremise (name : Name) : MetaM Unit := do
  let ci ← getConstInfo name
  if occurrences ci.type == 0 then
    throwError "SCOPED-COLLISION RED {name}: explicit finite input list missing"
  logInfo m!"SCOPED-COLLISION PASS {name}"

/-- Mutate the scoped separation premise contravariantly: global separation implies
local separation. The resulting theorem is valid but has an impossible finite-hash premise. -/
def plantPremise (name : Name) (checked : Bool) : MetaM Unit := do
  let ci ← getConstInfo name
  let value ← forallTelescope ci.type fun xs _ => do
    let mut found : Option Nat := none
    for i in [:xs.size] do
      let t ← inferType xs[i]!
      if t.isAppOfArity `Not 1 && (t.getArg! 0).isAppOf `Minidregg.Theory.CollidesAmong then
        found := some i
    let some i := found | throwError "scoped-collision: no separation premise at {name}"
    let scopedType := (← inferType xs[i]!).getArg! 0
    let unbounded ← withLocalDeclD `collision scopedType fun c => do
      inferType (← mkAppM `Minidregg.Verify.ScopedCollision.dropList #[c])
    withLocalDeclD `globalSeparation (mkApp (mkConst `Not) unbounded) fun global => do
      let localProof ← withLocalDeclD `collision scopedType fun c => do
        mkLambdaFVars #[c] (mkApp global (← mkAppM `Minidregg.Verify.ScopedCollision.dropList #[c]))
      let args := xs.set! i localProof
      let binders := xs.set! i global
      mkLambdaFVars binders (mkAppN (mkConst name (ci.levelParams.map Level.param)) args)
  let type ← inferType value
  if occurrences type != 0 then throwError "scoped-collision: premise mutation left a finite list at {name}"
  let mutant := name ++ `listDroppedMutant
  addDecl (.thmDecl { name := mutant, levelParams := ci.levelParams, type, value })
  if checked then checkPremise mutant
  else logInfo m!"SCOPED-COLLISION MUTANT DERIVED {mutant}"

elab "#assert_scoped_collision_premise " n:ident : command => liftTermElabM do
  checkPremise (← resolveGlobalConstNoOverload n)

elab "#plant_unbounded_collision_premise " n:ident : command => liftTermElabM do
  plantPremise (← resolveGlobalConstNoOverload n) true

elab "#derive_unbounded_collision_premise " n:ident : command => liftTermElabM do
  plantPremise (← resolveGlobalConstNoOverload n) false

end Minidregg.Verify.ScopedCollision


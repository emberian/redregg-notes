/-- **The canonical root determines the key/value pairs** (or exhibits a
node collision). -/
theorem tree_injective : ∀ (n : Nat) (es₁ es₂ : List (Entry K V)),
    WF n es₁ → WF n es₂ → tree dig n es₁ = tree dig n es₂ → SameKV es₁ es₂ ∨ Collision dig

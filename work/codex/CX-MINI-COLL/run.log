#!/usr/bin/env bash
# slot-mk.sh CMD... : the merge keeper's reserved gate slot ($PIPELINE_GATE_SLOT, default
# /srv/build-slot-mk; never taken by lanes). Where the box has no gate slot, a lane slot via slot.sh.
# The wait is BOUNDED (PIPELINE_GATE_SLOT_WAIT_S, default 3 h): a gate stuck behind its own previous
# run fails loudly with flock's conflict code 75 instead of parking forever.
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PIPELINE_ROOT=${PIPELINE_ROOT:-/srv/pipeline}
[ -f "$PIPELINE_ROOT/box.env" ] && . "$PIPELINE_ROOT/box.env"
slot=${PIPELINE_GATE_SLOT:-/srv/build-slot-mk}
[ -e "$slot" ] || exec "$here/slot.sh" "$@"
exec flock -w "${PIPELINE_GATE_SLOT_WAIT_S:-10800}" -E 75 "$slot" "$@"
#!/usr/bin/env bash
# scripts/pipeline/with-lean-slot CMD... -- run a Lean build holding one of this box's N Lean slots, in FIFO order.
#
# THE ONE COPY. It replaces the hand-installed $PIPELINE_ROOT/slots/with-lean-slot (hbox, 2026-10-14
# 23:04, FIFO since 10-15 03:05Z) and interoperates with it while both exist: same slot locks
# (SLOTS/lean-K.lock), same queue (SLOTS/waiters/<pid>.pid, ordered by mtime, dead pids pruned).
#
# FIFO: a waiter takes a slot only when its ticket is the OLDEST live ticket, so a 3-hour waiter is
# never passed by a 5-minute one. The ticket is ALWAYS SLOTS/waiters/<own pid>.pid. The installed copy
# used $WITH_LEAN_SLOT_PIDFILE as the ticket itself, so a waiter whose PID file lived elsewhere never
# entered the queue and never got a slot (CONSENT-3 b1, 10-15); that path is now only the PID file to
# stop the waiter by. The lock fd is held by this wrapper only (the build and its children never
# inherit it).
#
# Env (box.env or the caller):
#   PIPELINE_LEAN_SLOT_DIR   SLOTS (default $PIPELINE_ROOT/slots)
#   PIPELINE_LEAN_SLOTS      N (default 3: hbox's count)
#   PIPELINE_LEAN_SLOT_THREADS  LEAN_NUM_THREADS of the build (default 4); exported as THREADS too
#   PIPELINE_LEAN_SLOT_NICE  nice level of the build (default 0; a host that is not ours, e.g. persvati, sets 15)
#   WITH_LEAN_SLOT_PIDFILE   also write this wrapper's PID here (stop the waiter by it)
#   WITH_LEAN_SLOT_PRIORITY=1  queue ahead of every ordinary ticket (the tip service / integrator); a
#                            priority ticket is backdated one day, so among priority tickets FIFO holds
#   PIPELINE_LEAN_SLOT_POLL_S  seconds between polls (default 1: a slot kept for an older waiter idles at most this long)
#   WITH_LEAN_SLOT_DEADLINE_S  give up after this many seconds without a slot (default 14400; exit 75)
# Every grant is measured: SLOTS/waits.tsv gets one line per run
#   pid  enqueued  granted  released  slot  rc  command   (epoch seconds; the CYCLE-TIME F5 instrument)
# Before the build: the shared Lake cache's guard, from THIS tree (lib.sh pipeline_cache_audit).
set -uo pipefail
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
PIPELINE_PROG=with-lean-slot
. "$here/lib.sh"
[ $# -ge 1 ] || pipeline_die "usage: with-lean-slot CMD..."
SLOTS=${PIPELINE_LEAN_SLOT_DIR:-$PIPELINE_ROOT/slots}
N=${PIPELINE_LEAN_SLOTS:-3}
case "$N" in [1-9]|[1-9][0-9]) ;; *) pipeline_die "PIPELINE_LEAN_SLOTS must be a positive integer" ;; esac
W=$SLOTS/waiters
mkdir -p "$W" || pipeline_die "cannot create $W"
ticket=$W/$$.pid
echo $$ > "$ticket"
enq=$(date +%s)
if [ "${WITH_LEAN_SLOT_PRIORITY:-0}" = 1 ]; then touch -d "@$(( enq - 86400 ))" "$ticket"; else touch -d "@$enq" "$ticket"; fi
[ -n "${WITH_LEAN_SLOT_PIDFILE:-}" ] && [ "$WITH_LEAN_SLOT_PIDFILE" != "$ticket" ] && echo $$ > "$WITH_LEAN_SLOT_PIDFILE"
trap 'rm -f "$ticket"; [ -n "${WITH_LEAN_SLOT_PIDFILE:-}" ] && rm -f "$WITH_LEAN_SLOT_PIDFILE"' EXIT
deadline=$(( enq + ${WITH_LEAN_SLOT_DEADLINE_S:-14400} ))
cmd="$*"; cmd=${cmd:0:200}
# the live tickets, oldest first (priority tickets are backdated a day); a dead PID's ticket is pruned
live_in_order() {
  local f p
  for f in $(ls -tr "$W"/*.pid 2>/dev/null); do
    p=$(cat "$f" 2>/dev/null)
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then echo "$p"; else rm -f "$f"; fi
  done
}
pipeline_cache_audit || pipeline_die "the shared Lake cache is unguarded (lake-cache-audit failed): not building on it"
told=0
poll=${PIPELINE_LEAN_SLOT_POLL_S:-1}
# One poll, under SLOTS/queue.lock (so two waiters never count the same free slot): count the live tickets AHEAD of
# this one and the slots free right now. This waiter takes a slot iff ahead < free: every older waiter still has a
# free slot left for it, so FIFO and priority hold, and no slot idles while any waiter could use it (the old rule,
# "only the single oldest ticket may try", left a second free slot idle for a whole poll and let a later priority
# ticket pass a waiter that had a slot available: test-with-lean-slot.sh, burst5 10-17).
while :; do
  exec {q}>"$SLOTS/queue.lock"
  if flock -w 30 "$q"; then
    ahead=0 mine=0
    for p in $(live_in_order); do [ "$p" = "$$" ] && { mine=1; break; }; ahead=$((ahead + 1)); done
    [ "$mine" = 1 ] || { echo $$ > "$ticket"; touch -d "@$enq" "$ticket"; }   # a pruned ticket (never ours to lose) re-enters at its own time
    fds=() slots=()
    for s in $(seq 1 "$N"); do
      exec {t}>"$SLOTS/lean-$s.lock"
      if flock -n "$t"; then fds+=("$t"); slots+=("$s"); else exec {t}>&-; fi
    done
    if [ "$mine" = 1 ] && [ "$ahead" -lt "${#fds[@]}" ]; then
      fd=${fds[0]} s=${slots[0]}
      for t in "${fds[@]:1}"; do exec {t}>&-; done
      rm -f "$ticket"; exec {q}>&-
      granted=$(date +%s)
      export LEAN_NUM_THREADS=${PIPELINE_LEAN_SLOT_THREADS:-4}
      export THREADS=$LEAN_NUM_THREADS
      ( exec {fd}>&-; exec nice -n "${PIPELINE_LEAN_SLOT_NICE:-0}" "$@" ); rc=$?
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$$" "$enq" "$granted" "$(date +%s)" "$s" "$rc" "$cmd" >> "$SLOTS/waits.tsv"
      exit "$rc"
    fi
    for t in "${fds[@]}"; do exec {t}>&-; done
  fi
  exec {q}>&-
  if [ "$(date +%s)" -ge "$deadline" ]; then
    printf '%s\t%s\t-\t%s\t-\t75\t%s\n' "$$" "$enq" "$(date +%s)" "$cmd" >> "$SLOTS/waits.tsv"
    pipeline_log "no Lean slot in $(( deadline - enq )) s" >&2
    exit 75
4. Kick `pipeline-journeys.service` and wait for `journeys/TIP/DONE`. A refusal or a timeout exits 12.
5. Print the verdict. It opens with two greppable lines from the service's dispatch record
   (`journeys/.trees/TIP.dispatch`). `RUN-TREE` gives the tree, the runner path and sha256, and the
   source.tar sha256. `SELF-CHECK PASS|FAIL` says whether the executed runner is byte-identical to
   `git show TIP:scripts/pipeline/journey-runner` from the shared repo; FAIL exits 12. If the plant marker
   exists, a `STALE-COPY EXECUTED` line follows. Then the verdict body: `awk -F'\t' '$2!="PASS"' results.tsv` and the row count. Then check every id in
   `required-rows`, read from the **baseline's own tree** (`journeys/.trees/<artifacts/main>`, the tree main's standing run executed) so a lane cannot drop its own required rows or add its own known-red lines; never from the warm base, which is a build cache. No baseline tree: `NO POLICY`, exit 13. Each must be
   PASS, or UNCONFIGURED with a detail that matches that row's declaration in `absent-inputs.tsv`. A required id
   with no line in results.tsv is MISSING. Exit 0 only if every required id passes this check; otherwise exit 13.
   The verdict is also written to `LANE/logs/landing-TIP.txt`.

`landing.sh --check TIP` runs only step 5, against a finished run. landing.sh never pushes; the root pushes main
from the results.tsv it has read.

### required-rows

The ids come from MATURATION-MAP-20261009 §3. A row id covers its sub-rows. A parent that is UNCONFIGURED only
because of declared sub-rows is accepted. Two rows on the map do not exist yet: HERMES-LIVE and jcertify. They are
`pending` lines: printed on every landing, not counted. The first time a row of that name appears in results.tsv, it
is required automatically (ROOT, 2026-10-14).

`births` (THE BAR) exists and runs on every landing, but its line is `pending births when-green-at-main …`: it
becomes required only once main's own baseline run has it PASS. Until then landing.sh prints
`pending   births (when green at main; main's baseline: …; candidate: …)` and does not count it. Rule (b) below
still applies to it, so once main is PASS a candidate that turns it red is a NEW RED.

## The bar per landing: `births`; the soak: the nightly

THE BAR (cv 01a0f9c0-521b) is on CREATES: write p99 <= 5 s, cold reopen <= 60 s. The standing run judges it with
`births` (journey-rows `row_births`): `scripts/perf/workload.py --births-only` on a fresh native Store: genesis,
setup, `PERF_BIRTHS_N` births (default **64**), then the Host stopped by its PID file and restarted on the same
Store, timed to the first answered read. PASS iff all N resource writes and N `create` turns completed, each
op's p99 <= 5 s, and the reopen <= 60 s; FAIL names the op and the bound. The detail carries create p50/p99/max,
resource p99, reopen, cells and records at the end, the Store size, and the 1-min loadavg at start and end: a loaded
box is recorded, never a reason to skip (the row has no UNCONFIGURED-for-load path, unlike `perf`). Sub-rows
`births/create`, `births/resource`, `births/reopen`. Plant: `JOURNEY_PLANT_BIRTHS=bar-1ms`
judges the same run against a 0.001 s write bar and must FAIL naming `births/create p99 … > 1 ms bar`.

`growth` (1000 records through journey.sh; 2,436–5,401 s; it measures UPDATES on existing cells and flipped PASS/FAIL
on the same bar with box load, FOLLIES-20261014 F1) is **not** in a landing's standing run: journey-rows appends it
to `JOURNEY_ROWS` only when `PIPELINE_NIGHTLY=1`.

### Nightly

The nightly is the 1000-create run plus the full growth soak, against the `main` set, into its own results root
(never `$JOURNEY_ROOT`: run_tip moves an existing `TIP/` aside, which would hide the standing run from landing.sh).
With `PIPELINE_NIGHTLY=1`, `births` defaults to N=1000 (`PERF_BIRTHS_N` overrides) and `growth` is in the row set:

```
cd /tank/dregg-build/pipeline && T=$(readlink artifacts/main) && tree=journeys/.trees/$T && \
  PIPELINE_ROOT=$PWD PIPELINE_NIGHTLY=1 PIPELINE_ROW_TIMEOUT_S=7200 setsid nohup bash $tree/scripts/pipeline/journey-runner \
    --tip $T --row births --results-root $PWD/nightly > logs/nightly-births-$T.log 2>&1 < /dev/null & echo $! > logs/nightly-births.pid
# then the same with --row growth (logs/nightly-growth-$T.log, logs/nightly-growth.pid), after births has finished
```

Results: `nightly/<tip>/{results.tsv,table.txt,rows/}`. The nightly blocks nothing; it is the measurement a Store


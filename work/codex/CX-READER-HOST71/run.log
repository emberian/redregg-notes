/-- Keep the writer's lock to here: the lock's handle lives as long as a later use of it. -/
def Writer.hold (wr : Writer W) : IO Unit := do
  let _ ← wr.lock.tryLock

/-- Unlink every Store file outside what the base keeps: segment files before `retainedFrom`, index
files other than `indexFrom`'s, and stale `seg.tmp` / `index.tmp`. Only a writer with a finite
retention runs it (only a drop leaves such files: a crash between the base install and the unlinks). -/
def removeSurplus (dir : System.FilePath) (rf k0 : Nat) : IO Unit := do
  for e in ← dir.readDir do
    let n := e.fileName
    let surplus : Bool :=
      n == "seg.tmp" || n == "index.tmp" ||
      (match n.splitOn "." with
        | ["seg", x, "log"] => match x.toNat? with | some v => decide (v < rf) | none => false
        | ["index", x, "log"] => match x.toNat? with | some v => v != k0 | none => false
        | _ => false)
    if surplus then IO.FS.removeFile e.path
  syncDir dir.toString

/-- Open the Store as its one writer: lock the key, open, truncate the torn tail (in the newest file)
and any orphan index entries (bytes past the entries the base counts: never a byte of one it counts,
`Opening.orphan`), sync. A stale `base.tmp` (a crash mid-seal) is never read; the next seal replaces
it. Every file the open reads is checked present first (`missing`), and the append mode never creates
one: the writer writes only into files genesis, a rotation or a drop made (HOST-35). -/
def openWriter (dir : System.FilePath) (keys : Keys) (c : Cadence) (world : Stream W)
    (mark : W → Nat × ByteArray) (origin : W → ByteArray) (step : W → ByteArray → Except F W)
    (retain : Retain := none) : IO (Except (StoreFault F) (Writer W)) := do
  if let some f ← missingOf dir [.key, .base] then return .error f
  let lock ← File.open (keyPath dir) .read
  unless ← lock.tryLock do return .error .locked

/-- The header check of a base's own file (HOST-64): the header must verify (`checkpointCorrupt`),
state the base World's origin (`foreignOrigin`, HOST-25's identity, which the origin frame at offset 0
carried before files could be dropped), and state the base's own position: its offset, its tag, its
World's step count and chain, and the entries it counts (`foreignSegment`: the file is not the one
this base was sealed at). -/
def headerFault (keys : Keys) (b : ByteArray) (origin : ByteArray) (offset : Nat) (tag : Digest)
    (mark : Nat × ByteArray) (indexCount : Nat) : Option BaseFault :=
  match Header.read keys b with
  | none => some .checkpointCorrupt
  | some h =>
    if h.origin ≠ origin then some .foreignOrigin
    else if h.start = offset ∧ h.tag = tag ∧ h.steps = mark.1 ∧ h.chain = mark.2 ∧ h.indexCount = indexCount
      then none
    else some .foreignSegment

/-- The offset, retained offset and first index entry a base file names, read from the fixed-width
fields at its end (`Base.codec` ends u64 offset ‖ tag ‖ u64 count ‖ last ‖ u64 retainedFrom ‖ u64
indexFrom, then the frame's tag). Unauthenticated here: they only choose which files the open
reads, and `openWith` then verifies the base and requires the header of `seg.<offset>.log` to state
the base's own position (`foreignSegment`), and every index entry to read back at its position. -/
def Base.peek (file : ByteArray) : Option (Nat × Nat × Nat) :=
  let e := file.size
  if e < 128 then none else
  match Stream.nat64.decode (file.extract (e - 128) (e - 120)),
      Stream.nat64.decode (file.extract (e - 48) (e - 40)),
    let current := mine.filter (·.tag == s.tag.toHex)
    let moved := if current.isEmpty then
        [s!"{s.name}: no vector under its current tag {s.tag.toHex} (tag moved or new site): " ++
          "run `lake exe codec-vectors --write gates/codec-vectors.tsv`, and say in the commit what re-geneses"]
      else []
    let stale := (mine.filter (·.tag != s.tag.toHex)).map fun r =>
      s!"{s.name} vector {r.index}: stale tag {r.tag}: run --write"
    let meaning := current.filterMap fun r =>
      match unhex r.bytes with
      | none => some s!"{s.name} vector {r.index}: bytes are not hex"
      | some b =>
        let now := s.print b
        if now == r.text then none
        else some (s!"{s.name} vector {r.index}: MEANING CHANGED under the same tag {r.tag}: the same bytes " ++
          s!"decoded to `{r.text}` and now decode to `{now}`: rename the refinement (its tag moves, every " ++
          "stamp with it); --write never re-pins a row whose tag did not move")
    moved ++ stale ++ meaning
  let orphans := (rows.filter fun r => !(sites.any (·.name == r.site))).map fun r =>
    s!"{r.site} vector {r.index}: no such site"
  perSite ++ orphans

def run (args : List String) : IO UInt32 := do
  match args with
  | ["--write", path] =>
    let old ← if ← System.FilePath.pathExists path then
        match parse (← IO.FS.readFile path) with
        | .ok r => pure r
        | .error e => IO.eprintln e; return 1
      else pure []
    let rows := write old
    IO.FS.writeFile path (header ++ String.join (rows.map (·.line ++ "\n")))
    IO.println s!"codec-vectors: wrote {rows.length} vectors of {sites.length} sites"
    return 0
  | ["--check", path] =>
    match parse (← IO.FS.readFile path) with
    | .error e => IO.eprintln e; return 1
    | .ok rows =>
      match check rows with
      | [] => IO.println s!"codec-vectors: ok ({rows.length} vectors of {sites.length} sites)"; return 0
      | bad => for b in bad do IO.eprintln b
               IO.eprintln s!"codec-vectors: RED ({bad.length})"; return 1
  | _ => IO.eprintln "usage: codec-vectors (--write | --check) PATH"; return 2


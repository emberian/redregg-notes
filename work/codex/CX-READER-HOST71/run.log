+  match ← serveDir dst keys wide 2 [submitFrame 99 (.turn (mkTurn 99999 0 1024 [99999]))] with
+  | .error e => check s!"adopt append {e}" false failures
+  | .ok (r, _) =>
+    match ← openAt dst keys wide world recorder.mark originChain foldStep with

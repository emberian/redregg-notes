 ('live-tail','Host/Tail.lean',lambda s:replace(s,'  if let .error e ← seg.current then return .error e\n','')),
 ('old-shape','Host/Physical.lean',lambda s:replace(s,'if stored ≠ keys.shapes.bytes then','if stored ≠ keys.shapes.bytes ∧ False then')),
 ('retained-start','Host/Store.lean',lambda s:replace(s,'      ⟨pos.offset, 0⟩ with','      ⟨rf, 0⟩ with')),

(r/'\\''\\'\\'''\\''Census/CertificateData.lean'\\''\\'\\'''\\'').write_text(\"/- Checked-Environment projection for certificates. Encoding and reference collection use a\\nshared-node DAG: expanding proof sharing with Repr can require gigabytes. The exact trust\\nboundary is stated in Census.Proofs.Certificate and decisions/lang.md. -/\\nimport Lean\\nimport Lang.Contextual.Certificate\\n\\nnamespace Census.Certificate\\n\\nopen Lean\\n\\nderiving instance Repr for ReducibilityHints, QuotKind\\n\\nstructure Expression where\\n  encoded : String\\n  constants : List Name\\n  deriving DecidableEq, Repr\\n\\nstructure Encoding where\\n  seen : Std.HashMap ExprStructEq Nat := {}\\n  nodes : Array Json := #[]\\n  constants : List Name := []\\n\\n/-- Structural cache equality includes binder names/metadata; hash equality alone never suffices.\\nThis executable traversal, Lean.Expr.equal and serialization are named trusted read-offs. -/\\ndef encodeExpr (e : Expr) : StateM Encoding Nat := do\\n  if let some i := (← get).seen[⟨e⟩]? then return i\\n  let row ← match e with\\n    | .bvar i => pure #[toJson \\\"bvar\\\", toJson i]\\n    | .fvar i => pure #[toJson \\\"fvar\\\", toJson (reprStr i)]\\n    | .mvar i => pure #[toJson \\\"mvar\\\", toJson (reprStr i)]\\n    | .sort l => pure #[toJson \\\"sort\\\", toJson (reprStr l)]\\n    | .const n ls => do\\n      modify fun s => {s with constants := n :: s.constants}\\n      pure #[toJson \\\"const\\\", toJson (reprStr n), toJson (reprStr ls)]\\n    | .app f a => do\\n      let fi ← encodeExpr f\\n      let ai ← encodeExpr a\\n      pure #[toJson \\\"app\\\", toJson fi, toJson ai]\\n    | .lam n t b bi | .forallE n t b bi => do\\n      let ti ← encodeExpr t\\n      let bi'\\''\\'\\'''\\'' ← encodeExpr b\\n      pure #[toJson (if e.isLambda then \\\"lam\\\" else \\\"forall\\\"),\\n        toJson (reprStr n), toJson ti, toJson bi'\\''\\'\\'''\\'', toJson (reprStr bi)]\\n    | .letE n t v b nd => do\\n      let ti ← encodeExpr t\\n      let vi ← encodeExpr v\\n      let bi ← encodeExpr b\\n      pure #[toJson \\\"let\\\", toJson (reprStr n), toJson ti, toJson vi, toJson bi, toJson nd]\\n    | .lit l => pure #[toJson \\\"lit\\\", toJson (reprStr l)]\\n    | .mdata md b => do\\n      let bi ← encodeExpr b\\n      pure #[toJson \\\"mdata\\\", toJson (reprStr md), toJson bi]\\n    | .proj n i b => do\\n      modify fun s => {s with constants := n :: s.constants}\\n      let bi ← encodeExpr b\\n      pure #[toJson \\\"proj\\\", toJson (reprStr n), toJson i, toJson bi]\\n  let i := (← get).nodes.size\\n  modify fun s => {s with seen := s.seen.insert ⟨e⟩ i, nodes := s.nodes.push (.arr row)}\\n  return i\\ntermination_by e\\n\\ndef expression (e : Expr) : Expression :=\\n  let (root, s) := (encodeExpr e).run {}\\n  ⟨(Json.mkObj [(\\\"root\\\", toJson root), (\\\"nodes\\\", .arr s.nodes)]).compress,\\n    s.constants.eraseDups⟩\\n\\nstructure Declaration where\\n  type : Expression\\n  payload : String\\n  dependencies : List Name\\n  axiomKind : Bool\\n  theoremKind : Bool\\n  deriving DecidableEq, Repr\\n\\n/-- Every ConstantInfo variant retains its constructor fields. Type and values are encoded\\nDAGs; constructor/inductive/recursor shape edges close the context conservatively. -/\\ndef declaration (ci : ConstantInfo) : Declaration :=\\n  let ty := expression ci.type\\n  let values := (ci.value? true).toList.map expression\\n  let rules := match ci with\\n    | .recInfo v => v.rules.map (fun r => (r, expression r.rhs))\\n    | _ => []\\n  let (tag, shape, edges) : String × Json × List Name := match ci with\\n    | .axiomInfo v => (\\\"axiom\\\", toJson v.isUnsafe, [])\\n    | .defnInfo v => (\\\"definition\\\", toJson [reprStr v.hints, reprStr v.safety, reprStr v.all], [])\\n    | .thmInfo v => (\\\"theorem\\\", toJson (reprStr v.all), [])\\n    | .opaqueInfo v => (\\\"opaque\\\", toJson [reprStr v.isUnsafe, reprStr v.all], [])\\n    | .quotInfo v => (\\\"quotient\\\", toJson (reprStr v.kind), [])\\n    | .inductInfo v => (\\\"inductive\\\",\\n        toJson [reprStr v.numParams, reprStr v.numIndices, reprStr v.all, reprStr v.ctors,\\n          reprStr v.numNested, reprStr v.isRec, reprStr v.isUnsafe, reprStr v.isReflexive],\\n        v.all ++ v.ctors)\\n    | .ctorInfo v => (\\\"constructor\\\",\\n        toJson [reprStr v.induct, reprStr v.cidx, reprStr v.numParams, reprStr v.numFields,\\n          reprStr v.isUnsafe], [v.induct])\\n    | .recInfo v => (\\\"recursor\\\",\\n        Json.mkObj [(\\\"shape\\\", toJson [reprStr v.all, reprStr v.numParams, reprStr v.numIndices,\\n          reprStr v.numMotives, reprStr v.numMinors, reprStr v.k, reprStr v.isUnsafe]),\\n          (\\\"rules\\\", toJson (rules.map fun (r, e) =>\\n            toJson [reprStr r.ctor, reprStr r.nfields, e.encoded]))],\\n        v.all ++ rules.flatMap (fun (r, e) => r.ctor :: e.constants))\\n  let payload := (Json.mkObj [(\\\"kind\\\", toJson tag), (\\\"name\\\", toJson (reprStr ci.name)),\\n    (\\\"levels\\\", toJson (reprStr ci.levelParams)), (\\\"type\\\", toJson ty.encoded),\\n    (\\\"values\\\", toJson (values.map Expression.encoded)), (\\\"shape\\\", shape)]).compress\\n  ⟨ty, payload, (values.flatMap Expression.constants ++ edges).eraseDups,\\n    ci.isAxiom, ci.isTheorem⟩\\n\\n/-- Compiler identity is Lean'\\''\\'\\'''\\''s own githash; context content supplies theory identity.\\nImports are the actual direct imports of the environment, not producer-supplied labels. -/\\ndef checker (env : Environment) : Nanodregg.Lang.Contextual.Certificate.Checker :=\\n  ⟨\\\"Lean kernel / Census.Certificate v1\\\", Lean.versionString, Lean.githash,\\n    env.header.imports.toList.map (fun i => i.module.toString)⟩\\n\\n/-- Like collectAxioms, use the checked kernel environment, not pending elaborator data. -/\\ndef reader (env : Environment) : Nanodregg.Lang.Contextual.Certificate.Reader Name Expression Declaration where\\n  lookup := fun n => (env.checked.get.find? n).map declaration\\n  typeOf := Declaration.type\\n  references := Expression.constants\\n  dependencies := Declaration.dependencies\\n  isAxiom := Declaration.axiomKind\\n  isTheorem := Declaration.theoremKind\\n  checker := checker env\\n\\ndef namesJson (ns : List Name) : Json := toJson (ns.map Name.toString)\\n\\ndef certificateJson (c : Nanodregg.Lang.Contextual.Certificate.Certificate Name Expression Declaration)\\n    (kernelAxioms : List Name) (prettyStatement : String) : Json :=\\n  Json.mkObj [\\n    (\\\"target\\\", toJson c.target.toString),\\n    (\\\"statement\\\", toJson c.statement.encoded),\\n    (\\\"statementPretty\\\", toJson prettyStatement),\\n    (\\\"statementConstants\\\", namesJson c.statement.constants),\\n    (\\\"checker\\\", Json.mkObj [(\\\"name\\\", toJson c.checker.logic),\\n      (\\\"toolchain\\\", toJson c.checker.toolchain), (\\\"revision\\\", toJson c.checker.revision),\\n      (\\\"imports\\\", toJson c.checker.imports)]),\\n    (\\\"axioms\\\", namesJson kernelAxioms),\\n    (\\\"contextAxioms\\\", namesJson c.assumptions),\\n    (\\\"context\\\", toJson (c.context.map fun e => Json.mkObj [\\n      (\\\"name\\\", toJson e.name.toString), (\\\"declaration\\\", toJson e.body.payload),\\n      (\\\"type\\\", toJson e.body.type.encoded),\\n      (\\\"reads\\\", namesJson (e.body.type.constants ++ e.body.dependencies)),\\n      (\\\"axiom\\\", toJson e.body.axiomKind), (\\\"theorem\\\", toJson e.body.theoremKind)]))]\\n\\nend Census.Certificate\\n\")

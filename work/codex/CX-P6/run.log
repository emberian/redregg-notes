def references : Expr → List Name
  | .const n _ => [n]
  | .proj n _ e => n :: references e
  | .app f a => references f ++ references a
  | .lam _ t b _ | .forallE _ t b _ => references t ++ references b
  | .letE _ t v b _ => references t ++ references v ++ references b
  | .mdata _ e => references e
  | _ => []


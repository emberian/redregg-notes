@[match_pattern, expose] def mkNatLit (n : Nat) : Expr :=
  mkNatLitCore (mkRawNatLit n)

/-- Return the string literal `.lit (.strVal s)` -/
@[match_pattern, expose] def mkStrLit (s : String) : Expr :=

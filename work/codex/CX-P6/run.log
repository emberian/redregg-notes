#!/usr/bin/env python3
"""Re-emit the real theorem certificate and compare the entire pinned object.
The gzip vector is lossless JSON, not a digest. Run under swarm-build on hbox.
No normal verdict run rewrites the vector. --emit-vector is explicit authoring only.
"""
import argparse
import gzip
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
TARGET = "Nanodregg.Ledger.Proofs.grant_moves_le_cap"
VECTOR = ROOT / "gates/certificate-grant.json.gz"


def compare(expected, actual, label="certificate-vector"):
    problems = []
    for field in ("target", "statement", "statementPretty", "statementConstants",
                  "checker", "axioms", "contextAxioms"):
        if expected.get(field) != actual.get(field):
            problems.append(field)
    before = {e["name"]: e for e in expected["context"]}
    after = {e["name"]: e for e in actual["context"]}
    if before.keys() != after.keys():
        added, removed = sorted(after.keys() - before.keys()), sorted(before.keys() - after.keys())
        problems.append(f"unfolded constants: added {len(added)} {added[:8]!r}; "
                        f"removed {len(removed)} {removed[:8]!r}")
    changed = sorted(n for n in before.keys() & after.keys() if before[n] != after[n])
    if changed:
        problems.append(f"declarations ({len(changed)}): " + ", ".join(changed[:12]))
    # Exact object comparison also catches extra fields, duplicates, and list order.
    if expected != actual and not problems:
        problems.append("certificate structure/order")
    if problems:
        print(label + ": RED " + "; ".join(problems))
        return 1
    print(label + ": GREEN")
    return 0


def emit(scratch, extra="", target=TARGET):
    scratch.mkdir(parents=True, exist_ok=True)
    output = scratch / "certificate.json"
    source = scratch / "CertificateRun.lean"
    source.write_text("import Census.Certificate\nimport Ledger.Proofs.GrantCap\n"
                      + extra + "\n#certificate_census " + json.dumps(str(output))
                      + " " + target + "\n")
    result = subprocess.run(["lake", "env", "lean", "-DmaxHeartbeats=200000", str(source)],
                            cwd=ROOT, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    (scratch / "extract.log").write_text(result.stdout)
    print(result.stdout, end="", flush=True)
    if result.returncode or "CERTIFICATE ok:" not in result.stdout:
        raise RuntimeError("certificate extraction failed; see " + str(scratch / "extract.log"))
    return json.loads(output.read_text())


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("scratch", type=Path)
    ap.add_argument("--harness-control", action="store_true")
    ap.add_argument("--emit-vector", type=Path)
    ap.add_argument("--check-json", nargs=2, type=Path)
    args = ap.parse_args()
    if args.check_json:
        return compare(*(json.loads(p.read_text()) for p in args.check_json))
    actual = emit(args.scratch)
    if args.emit_vector:
        args.emit_vector.write_bytes(gzip.compress(
            (json.dumps(actual, ensure_ascii=False, separators=(",", ":")) + "\n").encode(),
            mtime=0))
        print("certificate-vector: emitted " + str(args.emit_vector))
        return 0
    expected = json.loads(gzip.decompress(VECTOR.read_bytes()))
    if args.harness_control:
        # An impossible axiom inventory, passed through the actual comparison.
        expected["axioms"] = expected["axioms"] + ["CX_P6_harness_control"]
    return compare(expected, actual, "certificate-vector harness-control"
                   if args.harness_control else "certificate-vector")


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Real Environment plants for the P6 certificate vector (hbox, under swarm-build).
Only lane scratch files are written; no theorem, gate, or compiled module is overwritten.
"""
import copy
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
LOGS = Path("/tank/dregg-build/nanodregg/logs")
SCRATCH = LOGS / "CX-P6-environment-plants"
SCRATCH.mkdir(exist_ok=True)
(LOGS / "CX-P6-environment-plants.pid").write_text(str(os.getpid()) + "\n")
spec = importlib.util.spec_from_file_location("certificate", ROOT / "gates/certificate.py")
gate = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gate)


def save(path, obj):
    path.write_text(json.dumps(obj, ensure_ascii=False))


def compare_run(label, before, after, want, script=None):
    where = SCRATCH / label
    where.mkdir(exist_ok=True)
    save(where / "before.json", before)
    save(where / "after.json", after)
    result = subprocess.run(
        [sys.executable, str(script or ROOT / "gates/certificate.py"), str(where),
         "--check-json", str(where / "before.json"), str(where / "after.json")],
        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    path = LOGS / ("CX-P6-env-" + label + ".log")
    path.write_text(result.stdout)
    print(str(path) + ": exit " + str(result.returncode), flush=True)
    print(result.stdout, end="", flush=True)
    if re.search(r"error:|unbound|No such file|Traceback", result.stdout, re.I):
        raise RuntimeError("unexpected diagnostic in whole output: " + str(path))
    if result.returncode != want:
        raise RuntimeError("wrong verdict: " + str(path))
    return result.stdout


def twin(extra_axiom):
    # The type is the actual landed theorem's type, read from this Environment.
    declaration = """
open Lean Elab Command in
elab "#make_p6_twin" : command => do
  let .thmInfo v ← getConstInfo `Nanodregg.Ledger.Proofs.grant_moves_le_cap
    | throwError "expected a theorem"
"""
    if extra_axiom:
        declaration += """
  liftCoreM <| addDecl (.axiomDecl {
    name := `CX_P6_extra, levelParams := v.levelParams, type := v.type, isUnsafe := false })
"""
    body = "CX_P6_extra" if extra_axiom else gate.TARGET
    return declaration + """
  liftCoreM <| addDecl (.thmDecl { v with
    name := `CX_P6_twin, value := mkConst `""" + body + """ (v.levelParams.map Level.param) })
#make_p6_twin
"""


normal = gate.emit(SCRATCH / "twin-original", twin(False), "CX_P6_twin")
mutant = gate.emit(SCRATCH / "twin-axiom", twin(True), "CX_P6_twin")
if "CX_P6_extra" not in mutant["axioms"] or "CX_P6_extra" in normal["axioms"]:
    raise RuntimeError("the real collectAxioms read did not observe the planted axiom")
out = compare_run("extra-axiom", normal, mutant, 1)
if "RED" not in out or "axioms" not in out:
    raise RuntimeError("extra axiom was not refused by name")

base_source = """
def CX_P6_dependency : Nat := Nat.zero
theorem CX_P6_small : CX_P6_dependency = Nat.zero := rfl
"""
base = gate.emit(SCRATCH / "constant-original", base_source, "CX_P6_small")
changed = gate.emit(SCRATCH / "constant-changed",
                    base_source.replace(":= Nat.zero", ":= Nat.add Nat.zero Nat.zero"),
                    "CX_P6_small")
if base["statement"] != changed["statement"] or base["axioms"] != changed["axioms"]:
    raise RuntimeError("constant plant changed the statement or axiom set")
out = compare_run("unfolded-constant", base, changed, 1)
if "RED" not in out or "CX_P6_dependency" not in out:
    raise RuntimeError("definition change was not refused by name")

# The same real mutated Environment outputs expose a disabled vector comparison.
disabled = SCRATCH / "disabled-comparison.py"
source = (ROOT / "gates/certificate.py").read_text()
if source.count("if problems:") != 1:
    raise RuntimeError("ambiguous comparison plant")
disabled.write_text(source.replace("if problems:", "if False:"))
out = compare_run("disabled-check", normal, mutant, 0, disabled)
if "certificate-vector: GREEN" not in out:
    raise RuntimeError("disabled comparator did not exhibit false acceptance")
print("FAIL certificate-plant: disabled comparison accepted the real extra-axiom twin", flush=True)
compare_run("unchanged", normal, copy.deepcopy(normal), 0)
print("certificate-environment-plants: GREEN", flush=True)


-      cl'.tpl = cl.tpl ∧ cl'.owed = cl.owed ++ [.settle u i] ∧
-      cl'.hist = cl.hist ++ [.accepted u i] ∧
-      cl'.slot = cl.update u ⟨(cl.slot u).cands, (cl.slot u).selected, true⟩ := by
-  unfold accept at h
-  dsimp only at h
-  split at h
-  · simp at h
-  rename_i I hf
-  split at h
-  · simp at h
-  rename_i hp
-  split at h
-  · simp at h
-  rename_i hacc
-  split at h
-  · simp at h

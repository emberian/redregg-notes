+      rcases List.mem_cons.mp hm with rfl | hm'
+      · rw [foldRows_get_out rest _ rr hc1 h2 fun x hx _ =>
+          ⟨fun e => hn.1 (by rw [hs, e]; exact List.mem_map_of_mem hx), fun _ _ e => by cases e⟩]

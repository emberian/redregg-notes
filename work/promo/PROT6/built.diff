+theorem rowDigests_mem {b : ByteArray} : ∀ {fs : List (Label × Data)},
+    b ∈ Data.rowDigests fs → ∃ y ∈ fs, b ∈ y.2.digests
+  | [], h => by simp [Data.rowDigests] at h
+  | y :: fs, h => by

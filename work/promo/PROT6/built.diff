+  rw [rowsRun_eq] at hrun
+  simp only [except_bind_ok] at hrun
+  obtain ⟨⟨⟩, -, ⟨⟩, -, hrun⟩ := hrun
+  split at hrun
+  · simp at hrun
+  · rename_i hfind
+    rw [except_bind_ok] at hrun
+    obtain ⟨acc, hf, he⟩ := hrun

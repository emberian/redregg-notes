+        (offerTakeBody theta roles rels od sd)) [.var 3, .var 2, .var 1, .var 0])
+      (.error (.refused "offerUnpinned".toUTF8)) :=
+  method_app (rows := takeRows (optD none) peer) body_offerUnpinned

+      exact ⟨z, by simp [hz], hb⟩
+
+theorem rowDigests_of_mem {b : ByteArray} : ∀ {fs : List (Label × Data)} {y : Label × Data},
+    y ∈ fs → b ∈ y.2.digests → b ∈ Data.rowDigests fs

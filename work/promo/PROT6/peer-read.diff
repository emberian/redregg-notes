+/-- The peer reads method `ℓ` of `p` declares (PROT-6; `[]`: none). -/
+def Package.peerReads (p : Package) (ℓ : Label) : List (Label × RelRead) :=
+  match Row.find? ℓ (recordRow p.iface) with
+  | some t => methodPeer p.rels t
+  | none => []
